; Reference (oracle) Godot 4.3 project for area3d_layered_gravity_fields.
; This project implements the exact scene specification from the task and is
; used only by the verifier to compute the ground-truth trajectory. It is NOT
; visible to the solver.

config_version=5

[application]

config/name="gravity_sim_reference"
run/main_scene="res://main.tscn"
config/features=PackedStringArray("4.3")

[physics]

common/physics_ticks_per_second=60
3d/default_gravity=0.0
3d/default_gravity_vector=Vector3(0, -1, 0)
