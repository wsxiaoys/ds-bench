datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id           Int           @id @default(autoincrement())
  transactions Transaction[]
}

model Transaction {
  id          Int      @id @default(autoincrement())
  date        DateTime
  amount      Float
  type        String
  category    String
  description String
  user        User     @relation(fields: [userId], references: [id])
  userId      Int
}
