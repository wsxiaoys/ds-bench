app customMiddleware {
  wasp: {
    version: "^0.21.1"
  },
  title: "custom-middleware",
  head: [
    "<link rel='icon' href='/favicon.ico' />",
  ],
  server: {
    middlewareConfigFn: import { serverMiddlewareFn } from "@src/middleware"
  }
}

route RootRoute { path: "/", to: MainPage }
page MainPage {
  component: import { MainPage } from "@src/MainPage"
}

apiNamespace apiNamespace {
  middlewareConfigFn: import { apiNamespaceMiddlewareFn } from "@src/middleware",
  path: "/api"
}

api statusApi {
  fn: import { statusHandler } from "@src/apis",
  httpRoute: (GET, "/api/status")
}

api echoApi {
  fn: import { echoHandler } from "@src/apis",
  middlewareConfigFn: import { echoMiddlewareFn } from "@src/middleware",
  httpRoute: (POST, "/api/echo")
}
