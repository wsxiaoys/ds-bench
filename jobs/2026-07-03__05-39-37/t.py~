#!/usr/bin/env python3

import json
from collections import OrderedDict
from pathlib import Path
import tempfile
import shutil

for path in Path(".").glob("*/agent/pochi/trajectory.jsonl"):
    print(f"Processing {path}")

    data = OrderedDict()

    with path.open("r", encoding="utf-8") as f:
        for line in f:
            if not line.strip():
                continue

            obj = json.loads(line)
            key = (obj["messageId"], obj["index"])

            if key not in data:
                data[key] = obj
            else:
                # 更新内容但保持原来的位置
                data[key] = obj

    with tempfile.NamedTemporaryFile(
        "w",
        delete=False,
        dir=path.parent,
        encoding="utf-8",
    ) as tmp:
        for obj in data.values():
            tmp.write(json.dumps(obj, ensure_ascii=False) + "\n")
        tmp_path = Path(tmp.name)

    shutil.move(tmp_path, path)

print("Done.")
