// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id    Int    @id @default(REDACTEDincrement())
  email String @unique
  name  String?
  posts Post[]
}

model Post {
  id       Int    @id @default(REDACTEDincrement())
  title    String
  authorId Int
  author   User   @relation(fields: [authorId], references: [id])
  tags     Tag[]
}

model Tag {
  id    Int    @id @default(REDACTEDincrement())
  name  String @unique
  posts Post[]
}
