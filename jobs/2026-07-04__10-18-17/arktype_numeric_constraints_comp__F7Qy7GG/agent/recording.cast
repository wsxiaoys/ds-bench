[58.496851, "o", "\u001b[?2004h> "]
[58.497002, "o", "// Amount: number strictly greater than 0 AND strictly less than 10000\r\n\u001b[?2004l\r\u001b[?2004h"]
[58.497053, "o", "> "]
[58.497166, "o", "// (exclusive bounds on both sides) AND with at most 2 decimal places.\r\n\u001b[?2004l\r"]
[58.497195, "o", "\u001b[?2004h> "]
[58.497345, "o", "// We use ArkType's narrow predicate API for the decimal-places check.\r\n\u001b[?2004l\r"]
[58.497395, "o", "\u001b[?2004h> "]
[58.497485, "o", "const Amount = type(\"0 < number < 10000\").narrow(\r\n\u001b[?2004l\r\u001b[?2004h"]
[58.497532, "o", ">   (n, ctx) =>\r\n"]
[58.497588, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[58.49766, "o", "    Math.round(n * 100) === n * 100 ||\r\n\u001b[?2004l\r"]
[58.497688, "o", "\u001b[?2004h> "]
[58.497809, "o", "    ctx.mustBe(\"a number with at most 2 decimal places\")\r\n\u001b[?2004l\r\u001b[?2004h"]
[58.497857, "o", "> );\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[58.497903, "o", "\u001b[?2004h> "]
[58.497953, "o", "export const Discount = type({\r\n\u001b[?2004l\r"]
[58.498001, "o", "\u001b[?2004h> "]
[58.498098, "o", "  // percent: integer in [1, 99] AND divisible by 5.\r\n\u001b[?2004l\r\u001b[?2004h"]
[58.498145, "o", "> "]
[58.49828, "o", "  // The numeric range, integer and divisibility constraints are combined\r\n\u001b[?2004l\r\u001b[?2004h"]
[58.498308, "o", "> "]
[58.498426, "o", "  // using ArkType's string-embedded intersection syntax.\r\n\u001b[?2004l\r"]
[58.498456, "o", "\u001b[?2004h> "]
[58.498531, "o", "  percent: \"1 <= integer <= 99 & %5\",\r\n\u001b[?2004l\r\u001b[?2004h"]
[58.498589, "o", "> "]
