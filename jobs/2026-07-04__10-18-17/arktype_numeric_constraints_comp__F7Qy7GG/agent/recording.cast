[191.855619, "o", "drwxr-xr-x  1 root root    43 Jul  4 10:21 \u001b[0m\u001b[01;34m.\u001b[0m\r\ndrwxr-xr-x  1 root root    31 Jul  3 14:47 \u001b[01;34m..\u001b[0m\r\n-rw-r--r--  1 root root   945 Jul  4 10:19 cli.ts\r\ndrwxr-xr-x 14 root root  4096 Jul  3 14:47 \u001b[01;34mnode_modules\u001b[0m\r\n-rw-r--r--  1 root root 18019 Jul  3 14:47 package-lock.json\r\n-rw-r--r--  1 root root   258 Jul  3 14:47 package.json\r\ndrwxr-xr-x  2 root root    34 Jul  4 10:19 \u001b[01;34msrc\u001b[0m\r\n-rw-r--r--  1 root root   331 Jul  3 14:47 tsconfig.json\r\n"]
