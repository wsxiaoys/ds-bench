[143.066493, "i", "cat > /home/user/myproject/test1.ts << 'EOF'\nimport { type } from \"arktype\";\n\n// Try with explicit divisor\nconst T1 = type(\"1 <= number%1 <= 99 & number%5\");\nfunction check(val: number) {\n  const r = T1(val);\n  if (r instanceof type.errors) {\n    console.log(`T1(${val}): ERROR - ${r.summary}`);\n  } else {\n    console.log(`T1(${val}): OK`);\n  }\n}\ncheck(25);\ncheck(7);\ncheck(100);\ncheck(99);\ncheck(95);\ncheck(0);\ncheck(1);\ncheck(5);\nEOF\nnpx tsx test1.ts 2>&1\n"]
