[58.499053, "o", "\u001b[?2004h> "]
[58.499097, "o", "  // appliesTo: literal union\r\n\u001b[?2004l\r"]
[58.499144, "o", "\u001b[?2004h> "]
[58.499209, "o", "  appliesTo: \"'cart' | 'shipping' | 'item'\"\r\n\u001b[?2004l\r"]
[58.499238, "o", "\u001b[?2004h> "]
[58.499268, "o", "});\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[58.4993, "o", "\u001b[?2004h> "]
[58.499397, "o", "export type Discount = typeof Discount.infer;\r\n\u001b[?2004l\r"]
[58.499445, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[58.499615, "o", "export function validateDiscount(input: unknown): Discount | { errors: string } {\r\n\u001b[?2004l\r"]
[58.499643, "o", "\u001b[?2004h> "]
[58.499718, "o", "  const out = Discount(input);\r\n\u001b[?2004l\r"]
[58.499765, "o", "\u001b[?2004h> "]
[58.499817, "o", "  if (out instanceof type.errors) {\r\n\u001b[?2004l\r"]
[58.499863, "o", "\u001b[?2004h> "]
[58.499925, "o", "    return { errors: out.summary };\r\n\u001b[?2004l\r"]
[58.499971, "o", "\u001b[?2004h>   }\r\n\u001b[?2004l\r\u001b[?2004h"]
[58.500017, "o", "> "]
[58.500061, "o", "  return out as Discount;\r\n\u001b[?2004l\r\u001b[?2004h> "]
[58.500107, "o", "}\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[58.500153, "o", "> "]
[58.500203, "o", "export default Discount;\r\n\u001b[?2004l\r\u001b[?2004h> "]
[58.500249, "o", "EOF\r\n\u001b[?2004l\r"]
