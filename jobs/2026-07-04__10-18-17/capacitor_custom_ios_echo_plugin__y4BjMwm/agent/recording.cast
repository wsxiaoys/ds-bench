[163.262935, "o", "\r\n=== src/echo.ts ===\r\n"]
[163.264403, "o", "import { registerPlugin } from '@capacitor/core';\r\n\r\nconst Echo = registerPlugin<{\r\n  echo(options: { value: string }): Promise<{ value: string }>;\r\n}>('Echo');\r\n\r\nexport * from '@capacitor/core';\r\nexport { Echo };\r\n"]
