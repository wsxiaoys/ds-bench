datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model Product {
  id         String      @id @default(uuid())
  name       String
  price      Float
  inventory  Int
  orderItems OrderItem[]
}

model Coupon {
  id    String @id @default(uuid())
  code  String @unique
  type  String // "PERCENT" or "FLAT"
  value Float
}

model Order {
  id         String      @id @default(uuid())
  createdAt  DateTime    @default(now())
  couponCode String?
  subtotal   Float
  discount   Float
  total      Float
  orderItems OrderItem[]
}

model OrderItem {
  id        String  @id @default(uuid())
  orderId   String
  order     Order   @relation(fields: [orderId], references: [id])
  productId String
  product   Product @relation(fields: [productId], references: [id])
  quantity  Int
  price     Float
}
