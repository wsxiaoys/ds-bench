module default {
    type Warehouse {
        required code: str {
            constraint exclusive;
        }
        required region: str;
    }

    type Sku {
        required code: str {
            constraint exclusive;
        }
        required label: str;
    }

    type ShelfCount {
        required warehouse: Warehouse;
        required sku: Sku;
        required quantity: int64;
        required tag: str;
    }

    type LedgerLine {
        required warehouse: Warehouse;
        required sku: Sku;
        required quantity: int64;
        required tag: str;
    }
}
