#!/usr/bin/env python
# SConstruct for the FastVectorMath GDExtension.
#
# This reuses the godot-cpp build scaffolding (which generates the C++ bindings
# and builds the static godot-cpp library) and then compiles our own sources
# into a shared library placed under bin/.

import os

env = SConscript("godot-cpp/SConstruct")

# Make our src/ directory visible to the compiler.
env.Append(CPPPATH=["src/"])
sources = Glob("src/*.cpp")

# Produce a shared library. The resulting file name follows the godot-cpp
# convention: <name><suffix><shlibsuffix>, e.g.
#   bin/libfast_vector_math.linux.template_release.x86_64.so
library = env.SharedLibrary(
    "bin/libfast_vector_math{}{}".format(env["suffix"], env["SHLIBSUFFIX"]),
    source=sources,
)

env.NoCache(library)
Default(library)