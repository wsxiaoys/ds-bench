app nestedComments {
  wasp: {
    version: "^0.16.8"
  },
  title: "nested-comments",
  db: {
    seeds: [
      import { devSeed } from "@src/server/seeds.js"
    ]
  }
}

route RootRoute { path: "/", to: MainPage }
page MainPage {
  component: import { MainPage } from "@src/MainPage.jsx"
}

route PostRoute { path: "/post/:postId", to: PostPage }
page PostPage {
  component: import { PostPage } from "@src/PostPage.jsx"
}

query getPosts {
  fn: import { getPosts } from "@src/server/queries.js",
  entities: [Post]
}

query getCommentTree {
  fn: import { getCommentTree } from "@src/server/queries.js",
  entities: [Comment, Post, User]
}

action createComment {
  fn: import { createComment } from "@src/server/actions.js",
  entities: [Comment, Post, User]
}

action deleteComment {
  fn: import { deleteComment } from "@src/server/actions.js",
  entities: [Comment]
}
