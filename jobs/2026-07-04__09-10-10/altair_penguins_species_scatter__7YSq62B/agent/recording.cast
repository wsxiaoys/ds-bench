[68.643075, "o", "# Build the scatter plot using the Palmer Penguins dataset URL.\r\n\u001b[?2004l\r\u001b[?2004h"]
[68.643128, "o", "> "]
[68.643375, "o", "# Because the data is loaded from a URL, types must be declared explicitly\r\n\u001b[?2004l\r\u001b[?2004h> "]
[68.643563, "o", "# using the Altair shorthand (e.g. :Q, :N).\r\n\u001b[?2004l\r\u001b[?2004h> "]
[68.643615, "o", "chart = (\r\n\u001b[?2004l\r\u001b[?2004h> "]
[68.643754, "o", "    alt.Chart(data.penguins.url)\r\n\u001b[?2004l\r\u001b[?2004h"]
[68.643806, "o", "> "]
[68.643912, "o", "    .mark_point(filled=True, size=80)\r\n\u001b[?2004l\r\u001b[?2004h"]
[68.643963, "o", ">     .encode(\r\n\u001b[?2004l\r"]
[68.644052, "o", "\u001b[?2004h> "]
[68.644223, "o", "        x=alt.X(\"Flipper Length (mm):Q\").scale(zero=False),\r\n\u001b[?2004l\r\u001b[?2004h> "]
[68.644432, "o", "        y=alt.Y(\"Body Mass (g):Q\").scale(zero=False),\r\n\u001b[?2004l\r\u001b[?2004h"]
[68.644483, "o", "> "]
[68.644591, "o", "        color=alt.Color(\"Species:N\"),\r\n\u001b[?2004l\r\u001b[?2004h"]
[68.644642, "o", "> "]
[68.644734, "o", "        shape=alt.Shape(\"Sex:N\"),\r\n\u001b[?2004l\r\u001b[?2004h"]
[68.644785, "o", "> "]
[68.644881, "o", "        tooltip=[\r\n\u001b[?2004l\r\u001b[?2004h> "]
[68.644968, "o", "            \"Species\",\r\n\u001b[?2004l\r\u001b[?2004h> "]
[68.645043, "o", "            \"Island\",\r\n\u001b[?2004l\r\u001b[?2004h"]
[68.645095, "o", "> "]
[68.645199, "o", "            \"Flipper Length (mm)\",\r\n\u001b[?2004l\r\u001b[?2004h"]
[68.645256, "o", "> "]
[68.645367, "o", "            \"Body Mass (g)\",\r\n\u001b[?2004l\r\u001b[?2004h>         ],\r\n\u001b[?2004l\r"]
[68.645417, "o", "\u001b[?2004h>     )\r\n"]
[68.645506, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[68.645572, "o", "    .interactive()\r\n\u001b[?2004l\r\u001b[?2004h> )\r\n\u001b[?2004l\r\u001b[?2004h"]
[68.645624, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[68.645831, "o", "# Save the chart as a single self-contained HTML file.\r\n\u001b[?2004l\r\u001b[?2004h"]
[68.645901, "o", "> "]
[68.646019, "o", "chart.save(\"/home/user/myproject/chart.html\")\r\n\u001b[?2004l\r\u001b[?2004h"]
[68.646092, "o", "> "]
[68.64624, "o", "print(\"Saved chart to /home/user/myproject/chart.html\")\r\n\u001b[?2004l\r\u001b[?2004h"]
[68.64631, "o", "> EOF\r\n\u001b[?2004l\r"]
[68.647591, "o", "\u001b[?2004hroot@c15896a3-783f-4de8-a6c9-ea5b5f70c6bb:/home/user/myproject# "]
