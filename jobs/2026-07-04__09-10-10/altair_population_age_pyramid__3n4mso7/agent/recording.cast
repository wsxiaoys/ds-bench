[57.1758, "o", "<!DOCTYPE html>\r\n<html>\r\n<head>\r\n  <meta charset=\"UTF-8\">\r\n  <style>\r\n    #vis.vega-embed {\r\n      width: 100%;\r\n      display: flex;\r\n    }\r\n\r\n    #vis.vega-embed details,\r\n    #vis.vega-embed details summary {\r\n      position: relative;\r\n    }\r\n  </style>\r\n  <script type=\"text/javascript\" src=\"https://cdn.jsdelivr.net/npm/vega@6\"></script>\r\n  <script type=\"text/javascript\" src=\"https://cdn.jsdelivr.net/npm/vega-lite@6.4.1\"></script>\r\n  <script type=\"text/javascript\" src=\"https://cdn.jsdelivr.net/npm/vega-embed@7\"></script>\r\n</head>\r\n<body>\r\n  <div id=\"vis\"></div>\r\n  <script>\r\n    (function(vegaEmbed) {\r\n      var spec = {\"config\": {\"view\": {\"continuousWidth\": 300, \"continuousHeight\": 300}}, \"data\": {\"url\": \"https://cdn.jsdelivr.net/npm/vega-datasets@v3.2.1/data/population.json\"}, \"mark\": {\"type\": \"bar\"}, \"encoding\": {\"color\": {\"field\": \"sex\", \"legend\": {\"labelExpr\": \"datum.value === 1 ? 'Male' : 'Female'\", \"title\": \"Sex\"}, \"scale\": {\"domain\": [1, 2], \"range\": [\"steelblue\", \"salmon\"]}, \"type\": \"nominal\"}, \"x\": {\"axis\": {\"format\": \"s\", \"labelExpr\": \"abs(datum.value)\", \"title\": \"Population\"}, \"field\": \"signed\", \"type\": \"quantitative\"}, \"y\": {\"axis\": {\"title\": \"Age\"}, \"field\": \"age\", \"sort\": \"descending\", \"type\": \"ordinal\"}}, \"height\": 300, \"params\": [{\"name\": \"year\", \"bind\": {\"input\": \"select\", \"options\": [1850, 1860, 1870, 1880, 1890, 1900, 1910, 1920, 1930, 1940, 1950, 1960, 1970, 1980, 1990, 2000], \"name\": \"Year: \"}, \"value\": 1980}], \"title\": \"US Population Age Pyramid\", \"transform\": [{\"calculate\": \"datum.sex === 1 ? -datum.people : datum.people\", \"as\": \"signed\"}, {\"filter\": \"datum.year === year\"}], \"width\": 400, \"$schema\": \"https://vega.github.io/schema/vega-lite/v6.4.1.json\"};\r\n      var embedOpt = {\"mode\": \"vega-lite\"};\r\n\r\n      function showError(el, error){\r\n          el.innerHTML = ('<div style=\"color:red;\">'\r\n                          + '<p>JavaScript Error: ' + error.message + '</p>'\r\n                          + \"<p>This usually means there's a typo in your chart specification. \"\r\n"]
