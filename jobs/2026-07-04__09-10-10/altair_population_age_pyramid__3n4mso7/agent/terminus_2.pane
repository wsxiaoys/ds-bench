[?2004hroot@8e52c046-3983-41bd-bfe4-7392fe97e317:/home/user# cat > /home/user/myproject/build_pyramid.py << 'PYEOF'
[?2004l[?2004h> """Build a back-to-back population age pyramid using Vega-Altair.
[?2004l[?2004h> 
[?2004l[?2004h> Loads the canonical `data.population.url` dataset via Altair's
[?2004l[?2004h> URL-based data shorthand (no pre-loaded DataFrame), creates a
[?2004l[?2004h> transform_calculate step that signs `people` negatively for males,
[?2004l[?2004h> filters the data to a single year selected by an Altair
[?2004l[?2004h> `binding_select` dropdown bound to an `alt.param`, and emits the
[?2004l[?2004h> resulting chart to `pyramid.html` and `pyramid_spec.json`.
[?2004l[?2004h> """
[?2004l[?2004h> 
[?2004l[?2004h> from __future__ import annotations
[?2004l[?2004h> 
[?2004l[?2004h> import json
[?2004l[?2004h> from pathlib import Path
[?2004l[?2004h> 
[?2004l[?2004h> import altair as alt
[?2004l[?2004h> from altair.datasets import data
[?2004l[?2004h> 
[?2004l[?2004h> 
[?2004l[?2004h> OUTPUT_DIR = Path("/home/user/myproject")
[?2004l[?2004h> HTML_PATH = OUTPUT_DIR / "pyramid.html"
[?2004l[?2004h> SPEC_PATH = OUTPUT_DIR / "pyramid_spec.json"
[?2004l[?2004h> 
[?2004l[?2004h> 
[?2004l[?2004h> def build_chart() -> alt.Chart:
[?2004l[?2004h>     """Construct the back-to-back population age pyramid chart."""
[?2004l[?2004h>     # The selected year, controlled by a binding_select dropdown widget.
[?2004l[?2004h>     year_param = alt.param(
[?2004l[?2004h>         name="year",
[?2004l[?2004h>         value=1980,
[?2004l[?2004h>         bind=alt.binding_select(
[?2004l[?2004h>             options=[1850, 1860, 1870, 1880, 1890, 1900, 1910, 1920,
[?2004l[?2004h>                      1930, 1940, 1950, 1960, 1970, 1980, 1990, 2000],
[?2004l[?2004h>             name="Year: ",
[?2004l[?2004h>         ),
[?2004l[?2004h>     )
[?2004l[?2004h> 
[?2004l[?2004h>     chart = (
[?2004l[?2004h>         alt.Chart(data.population.url)
[?2004l[?2004h>         .transform_calculate(
[?2004l[?2004h>             signed="datum.sex === 1 ? -datum.people : datum.people"
[?2004l[?2004h>         )
[?2004l[?2004h>         .transform_filter("datum.year === year")
[?2004l[?2004h>         .mark_bar()
[?2004l[?2004h>         .encode(
[?2004l[?2004h>             x=alt.X(
[?2004l[?2004h>                 "signed:Q",
[?2004l[?2004h>                 axis=alt.Axis(
[?2004l[?2004h>                     title="Population",
[?2004l[?2004h>                     format="s",
[?2004l[?2004h>                     labelExpr="abs(datum.value)",
[?2004l[?2004h>                 ),
[?2004l[?2004h>             ),
[?2004l[?2004h>             y=alt.Y(
[?2004l[?2004h>                 "age:O",
[?2004l[?2004h>                 sort="descending",
[?2004l[?2004h>                 axis=alt.Axis(title="Age"),
[?2004l[?2004h>             ),
[?2004l[?2004h>             color=alt.Color(
[?2004l[?2004h>                 "sex:N",
[?2004l[?2004h>                 scale=alt.Scale(
[?2004l[?2004h>                     domain=[1, 2],
[?2004l[?2004h>                     range=["steelblue", "salmon"],
[?2004l[?2004h>                 ),
[?2004l[?2004h>                 legend=alt.Legend(
[?2004l[?2004h>                     title="Sex",
[?2004l[?2004h>                     labelExpr="datum.value === 1 ? 'Male' : 'Female'",
[?2004l[?2004h>                 ),
[?2004l[?2004h>             ),
[?2004l[?2004h>         )
[?2004l[?2004h>         .add_params(year_param)
[?2004l[?2004h>         .properties(
[?2004l[?2004h>             title="US Population Age Pyramid",
[?2004l[?2004h>             width=400,
[?2004l[?2004h>             height=300,
[?2004l[?2004h>         )
[?2004l[?2004h>     )
[?2004l[?2004h> 
[?2004l[?2004h>     return chart
[?2004l[?2004h> 
[?2004l[?2004h> 
[?2004l[?2004h> def main() -> None:
[?2004l[?2004h>     chart = build_chart()
[?2004l[?2004h> 
[?2004l[?2004h>     # Persist the rendered chart as a standalone HTML document.
[?2004l[?2004h>     chart.save(str(HTML_PATH))
[?2004l[?2004h> 
[?2004l[?2004h>     # Persist the underlying Vega-Lite spec as JSON for inspection.
[?2004l[?2004h>     spec = chart.to_dict()
[?2004l[?2004h>     with SPEC_PATH.open("w", encoding="utf-8") as f:
[?2004l[?2004h>         json.dump(spec, f, indent=2)
[?2004l[?2004h> 
[?2004l[?2004h>     print(f"Saved HTML  -> {HTML_PATH}")
[?2004l[?2004h>     print(f"Saved spec  -> {SPEC_PATH}")
[?2004l[?2004h> 
[?2004l[?2004h> 
[?2004l[?2004h> if __name__ == "__main__":
[?2004l[?2004h>     main()
