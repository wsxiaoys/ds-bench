{
  "name": "capacitor-stringkit",
  "version": "1.0.0",
  "description": "A standalone Capacitor v8 web plugin providing string manipulation utilities (echo, reverse, slugify).",
  "main": "dist/plugin.cjs.js",
  "module": "dist/esm/index.js",
  "types": "dist/esm/index.d.ts",
  "files": [
    "dist/",
    "src/",
    "README.md"
  ],
  "scripts": {
    "build": "npm run clean && npm run build:esm && npm run build:cjs",
    "build:esm": "tsc",
    "build:cjs": "rollup -c rollup.config.mjs",
    "clean": "rimraf dist"
  },
  "keywords": [
    "capacitor",
    "plugin",
    "web",
    "string",
    "stringkit"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@capacitor/core": "^8.0.0"
  },
  "devDependencies": {
    "@capacitor/core": "^8.4.0",
    "@rollup/plugin-node-resolve": "^15.3.0",
    "@rollup/plugin-typescript": "^12.1.0",
    "rimraf": "^5.0.10",
    "rollup": "^4.24.0",
    "tslib": "^2.7.0",
    "typescript": "^5.5.0"
  }
}
