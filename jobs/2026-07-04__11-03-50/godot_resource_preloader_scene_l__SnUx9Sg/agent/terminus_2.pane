extends SceneTree

func _initialize() -> void:
	var ps = load("res://scenes/HugeLevel.tscn")
	print("Load result: ", ps, " is PackedScene: ", ps is PackedScene)
	if ps is PackedScene:
		var inst = ps.instantiate()
		print("Instantiated: ", inst)
		var c = 0
		_count(inst, c)
		print("Node2D descendants: ", c)
	quit(0)

func _count(n: Node, c: int) -> int:
	if n is Node2D:
		c += 1
	for child in n.get_children():
		c = _count(child, c)
	return c
