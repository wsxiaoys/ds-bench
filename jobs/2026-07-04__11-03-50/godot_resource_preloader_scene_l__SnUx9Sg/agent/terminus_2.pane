extends Node$
class_name SceneLoader$
$
signal progress_updated(fraction)$
signal load_completed(scene)$
signal load_failed(reason)$
$
var _state: int = 0$
var _polling_timer: Timer = null$
var _thread_path: String = ""$
var _thread_progress_array: Array = []$
$
func start_load(path: String) -> bool:$
^Iif _state == 1:$
^I^Ireturn false$
^I_thread_path = path$
^I_thread_progress_array = [0.0]$
^Ivar err: int = ResourceLoader.load_threaded_request(path)$
^Iif err != OK:$
^I^I_state = 0$
^I^Iload_failed.emit("ResourceLoader error: %d" % err)$
^I^Ireturn true$
^I_state = 1$
^Iif _polling_timer == null:$
^I^I_polling_timer = Timer.new()$
^I^I_polling_timer.wait_time = 0.05$
^I^I_polling_timer.one_shot = false$
^I^Iadd_child(_polling_timer)$
^I^I_polling_timer.timeout.connect(_poll)$
^I_polling_timer.start()$
^Ireturn true$
$
func _poll() -> void:$
^Iif _state != 1:$
^I^Ireturn$
^Ivar status: int = ResourceLoader.load_threaded_get_status(_thread_path, _thread_progress_array)$
^Ivar fraction: float = float(_thread_progress_array[0])$
^Ifraction = clamp(fraction, 0.0, 1.0)$
^Iprogress_updated.emit(fraction)$
^Iif status == ResourceLoader.THREAD_LOAD_LOADED:$
^I^I_polling_timer.stop()$
^I^Ivar res: Resource = ResourceLoader.load_threaded_get(_thread_path)$
^I^I_state = 2$
^I^Iload_completed.emit(res)$
^Ielif status == ResourceLoader.THREAD_LOAD_FAILED or status == ResourceLoader.THREAD_LOAD_INVALID_RESOURCE:$
^I^I_polling_timer.stop()$
^I^I_state = 0$
^I^Iload_failed.emit("Thread load failed: %d" % status)$
$
func cancel() -> void:$
^Iif _state == 1:$
^I^Iif _polling_timer != null:$
^I^I^I_polling_timer.stop()$
^I^I_state = 0$
^I^I_thread_path = ""$
$
func is_loading() -> bool:$
^Ireturn _state == 1$
