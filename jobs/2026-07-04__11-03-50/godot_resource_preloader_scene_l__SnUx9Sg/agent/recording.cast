_run() -> void:\\n' + T + 'var loader: Node = root.get_node_or_null(\"SceneLoader\")\\n' + T + 'if loader == null:\\n' + T + T + '_fail(\"SceneLoader REDACTEDload missing\")\\n' + T + T + 'quit(1)\\n' + T + T + 'return\\n' + T + 'if not loader.has_method(\"start_load\"):\\n' + T + T + '_fail(\"start_load method missing\")\\n' + T + 'if not loader.has_method(\"cancel\"):\\n' + T + T + '_fail(\"cancel method missing\")\\n' + T + 'if not loader.has_method(\"is_loading\"):\\n' + T + T + '_fail(\"is_loading method missing\")\\n' + T + 'for s in [\"progress_updated\", \"load_completed\", \"load_failed\"]:\\n' + T + T + 'if not loader.has_signal(s):\\n' + T + T + T + '_fail(\"signal missing: \" + s)\\n' + T + 'loader.connect(\"progress_updated\", _on_progress)\\n' + T + 'loader.connect(\"load_completed\", _on_completed)\\n' + T + 'loader.connect(\"load_failed\", _on_failed)\\n\\n' + T + '# Test 1: valid path returns true\\n' + T + 'var ok1: bool = loader.call(\"start_load\", HUGE_LEVEL_PATH)\\n' + T + 'if not ok1:\\n' + T + T + '_fail(\"start_load on valid path returned false\")\\n\\n' + T + '# Test 2: second call returns false\\n' + T + 'var ok2: bool = loader.call(\"start_load\", HUGE_LEVEL_PATH)\\n' + T + 'if ok2:\\n' + T + T + '_fail(\"second start_load should return false while loading\")\\n\\n' + T + '# Wait for completion\\n' + T + 'var elapsed: int = 0\\n' + T + 'while elapsed < 5000 and not _signal_fired(\"load_completed\"):\\n' + T + T + 'await create_timer(0.05).timeout\\n' + T + T + 'elapsed += 50\\n\\n' + T + 'if not _signal_fired(\"load_completed\"):\\n' + T + T + '_fail(\"load_completed did not fire within 5s\")\\n' + T + 'else:\\n' + T + T + '# After completion, is_loading should be false\\n' + T + T + 'if loader.call(\"is_loading\"):\\n' + T + T + T + '_fail(\"is_loading true after completion\")\\n\\n' + T + 'var prog_count: int = _signal_count(\"progress_updated\")\\n' + T + 'if prog_count < 1:\\n' + T + T + '_fail(\"progress_updated did not fire at least once\")\\n\\n' + T + '# Test 3: invalid path -> load_failed within 1s\\n' + T + 'signals_log.clear()\\n' + T + 'var ok3: bool = loader.call(\"start_load\", BAD_PATH)\\n' + T + 'if not ok3:\\n' + T + T + '_fail(\"start_load on invalid path returned false (expected true to trigger failure flow)\")\\n' + T + 'v"]
