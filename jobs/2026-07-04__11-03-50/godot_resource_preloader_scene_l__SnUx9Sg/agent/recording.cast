[37.390652, "i", "cat REDACTEDloads/SceneLoader.gd | head -30\n"]
[37.391258, "o", "cat REDACTEDloads/SceneLoader.gd | head -30\r\n\u001b[?2004l\r"]
[37.393219, "o", "extends Node\r\nclass_name SceneLoader\r\n\r\nsignal progress_updated(fraction)\r\nsignal load_completed(scene)\r\nsignal load_failed(reason)\r\n\r\nvar _state: int = 0  # 0=idle, 1=loading, 2=loaded, 3=failed\r\nvar _current_loader = null  # ResourceLoader.Loader in background mode (not all builds expose)\r\nvar _polling_timer: Timer = null\r\nvar _thread: Thread = null\r\nvar _thread_path: String = \"\"\r\nvar _thread_progress: float = 0.0\r\nvar _thread_result: Resource = null\r\nvar _thread_error: String = \"\"\r\nvar _thread_mutex: Mutex = Mutex.new()\r\nvar _load_steps: int = 0\r\n\r\nfunc start_load(path: String) -> bool:\r\nif _state == 1:\r\n"]
[37.393294, "o", "return false\r\n# Use ResourceLoader.load_threaded_request which works in standard Godot.\r\n_thread_path = path\r\n_thread_progress = 0.0\r\n_thread_result = null\r\n_thread_error = \"\"\r\nvar err: int = ResourceLoader.load_threaded_request(path)\r\nif err != OK:\r\n_state = 3\r\n_thread_error = \"ResourceLoader.load_threaded_request failed: %d\" % err\r\n"]
[37.393809, "o", "\u001b[?2004hroot@2ddb40e7-6539-4978-8014-bd0c7e500423:/home/user/myproject# "]
[44.841429, "i", "python3 << 'PYEOF'\ncontent = '''extends Node\nclass_name SceneLoader\n\nsignal progress_updated(fraction)\nsignal load_completed(scene)\nsignal load_failed(reason)\n\nvar _state: int = 0  # 0=idle, 1=loading\nvar _polling_timer: Timer = null\nvar _thread_path: String = \"\"\nvar _thread_progress_array: Array = []\n\nfunc start_load(path: String) -> bool:\n\tif _state == 1:\n\t\treturn false\n\t_thread_path = path\n\t_thread_progress_array = [0.0]\n\tvar err: int = ResourceLoader.load_threaded_request(path)\n\tif err != OK:\n\t\t_state = 0\n\t\tload_failed.emit(\"ResourceLoader.load_threaded_request failed: %d\" % err)\n\t\treturn true\n\t_state = 1\n\tif _polling_timer == null:\n\t\t_polling_timer = Timer.new()\n\t\t_polling_timer.wait_time = 0.05\n\t\t_polling_timer.one_shot = false\n\t\tadd_child(_polling_timer)\n\t\t_polling_timer.timeout.connect(_poll)\n\t_polling_timer.start()\n\treturn true\n\nfunc _poll() -> void:\n\tif _state != 1:\n\t\treturn\n\tvar status: int = ResourceLoader.load_threaded_get_status(_thread_path, _thread_progress_array)\n\tvar fraction: float = float(_thread_progress_array[0])\n\tfraction = clamp(fraction, 0.0, 1.0)\n\tprogress_updated.emit(fraction)\n\tif status == ResourceLoader.THREAD_LOAD_LOADED:\n\t\t_polling_timer.stop()\n\t\tvar res: Resource = ResourceLoader.load_threaded_get(_thread_path)\n\t\t_state = 2\n\t\tload_completed.emit(res)\n\telif status == ResourceLoader.THREAD_LOAD_FAILED or status == ResourceLoader.THREAD_LOAD_INVALID_RESOURCE:\n\t\t_polling_timer.stop()\n\t\t_state = 0\n\t\tload_failed.emit(\"Thread load failed with status: %d\" % status)\n\nfunc cancel() -> void:\n\tif _state == 1:\n\t\tif _polling_timer != null:\n\t\t\t_polling_timer.stop()\n\t\t_state = 0\n\t\t_thread_path = \"\"\n\t\t_thread_progress_array = []\n\nfunc is_loading() -> bool:\n\treturn _state == 1\n'''\nwith open('REDACTEDloads/SceneLoader.gd', 'w') as f:\n    f.write(content)\nprint('Wrote SceneLoader.gd')\nPYEOF\n"]
[44.841969, "o", "python3 << 'PYEOF'\r\n\u001b[?2004l\r"]
