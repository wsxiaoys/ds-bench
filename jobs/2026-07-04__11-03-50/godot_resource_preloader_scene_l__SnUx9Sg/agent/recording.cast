[89.889494, "i", "python3 << 'PYEOF'\nT = '\\t'\ncontent = 'extends Node\\nclass_name SceneLoader\\n\\nsignal progress_updated(fraction)\\nsignal load_completed(scene)\\nsignal load_failed(reason)\\n\\nvar _state: int = 0\\nvar _polling_timer: Timer = null\\nvar _thread_path: String = \"\"\\nvar _thread_progress_array: Array = []\\n\\n' + \\\n'func start_load(path: String) -> bool:\\n' + T + 'if _state == 1:\\n' + T + T + 'return false\\n' + T + '_thread_path = path\\n' + T + '_thread_progress_array = [0.0]\\n' + T + 'var err: int = ResourceLoader.load_threaded_request(path)\\n' + T + 'if err != OK:\\n' + T + T + '_state = 0\\n' + T + T + 'load_failed.emit(\"ResourceLoader error: %d\" % err)\\n' + T + T + 'return true\\n' + T + '_state = 1\\n' + T + 'if _polling_timer == null:\\n' + T + T + '_polling_timer = Timer.new()\\n' + T + T + '_polling_timer.wait_time = 0.05\\n' + T + T + '_polling_timer.one_shot = false\\n' + T + T + 'add_child(_polling_timer)\\n' + T + T + '_polling_timer.timeout.connect(_poll)\\n' + T + '_polling_timer.start()\\n' + T + 'return true\\n\\nfunc _poll() -> void:\\n' + T + 'if _state != 1:\\n' + T + T + 'return\\n' + T + 'var status: int = ResourceLoader.load_threaded_get_status(_thread_path, _thread_progress_array)\\n' + T + 'var fraction: float = float(_thread_progress_array[0])\\n' + T + 'fraction = clamp(fraction, 0.0, 1.0)\\n' + T + 'progress_updated.emit(fraction)\\n' + T + 'if status == ResourceLoader.THREAD_LOAD_LOADED:\\n' + T + T + '_polling_timer.stop()\\n' + T + T + 'var res: Resource = ResourceLoader.load_threaded_get(_thread_path)\\n' + T + T + '_state = 2\\n' + T + T + 'load_completed.emit(res)\\n' + T + 'elif status == ResourceLoader.THREAD_LOAD_FAILED or status == ResourceLoader.THREAD_LOAD_INVALID_RESOURCE:\\n' + T + T + '_polling_timer.stop()\\n' + T + T + '_state = 0\\n' + T + T + 'load_failed.emit(\"Thread load failed: %d\" % status)\\n\\nfunc cancel() -> void:\\n' + T + 'if _state == 1:\\n' + T + T + 'if _polling_timer != null:\\n' + T + T + T + '_polling_timer.stop()\\n' + T + T + '_state = 0\\n' + T + T + '_thread_path = \"\"\\n\\nfunc is_loading() -> bool:\\n' + T + 'return _state == 1\\n'\nopen('REDACTEDloads/SceneLoader.gd','w').write(content)\nprint('Wrote', len(content), 'bytes')\nPYEOF\n"]
