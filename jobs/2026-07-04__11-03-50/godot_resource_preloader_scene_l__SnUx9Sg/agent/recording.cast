[110.552938, "i", "python3 << 'PYEOF'\nT = '\\t'\nscript = 'extends Control\\n\\n@onready var progress_bar: ProgressBar = $ProgressBar\\n@onready var label: Label = $Label\\n\\nfunc _ready() -> void:\\n' + T + 'var loader = Engine.get_singleton(\"SceneLoader\") if Engine.has_singleton(\"SceneLoader\") else null\\n' + T + 'if loader == null:\\n' + T + T + 'loader = get_node_or_null(\"/root/SceneLoader\")\\n' + T + 'if loader != null:\\n' + T + T + 'loader.progress_updated.connect(_on_progress_updated)\\n' + T + T + 'loader.load_completed.connect(_on_load_completed)\\n' + T + T + 'loader.load_failed.connect(_on_load_failed)\\n' + T + 'progress_bar.value = 0.0\\n' + T + 'label.text = \"Loading...\"\\n\\nfunc _on_progress_updated(fraction: float) -> void:\\n' + T + 'progress_bar.value = fraction\\n\\nfunc _on_load_completed(_scene) -> void:\\n' + T + 'label.text = \"Done!\"\\n' + T + 'progress_bar.value = 1.0\\n\\nfunc _on_load_failed(reason) -> void:\\n' + T + 'label.text = \"Failed: \" + str(reason)\\n'\nopen('scripts/LoadingScreen.gd','w').write(script)\nprint('Wrote LoadingScreen.gd')\nPYEOF\n"]
