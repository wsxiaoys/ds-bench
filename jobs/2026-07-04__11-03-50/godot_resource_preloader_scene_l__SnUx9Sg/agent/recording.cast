[34.130663, "i", "cat > REDACTEDloads/SceneLoader.gd << 'GDEOF'\nextends Node\nclass_name SceneLoader\n\nsignal progress_updated(fraction)\nsignal load_completed(scene)\nsignal load_failed(reason)\n\nvar _state: int = 0  # 0=idle, 1=loading, 2=loaded, 3=failed\nvar _current_loader = null  # ResourceLoader.Loader in background mode (not all builds expose)\nvar _polling_timer: Timer = null\nvar _thread: Thread = null\nvar _thread_path: String = \"\"\nvar _thread_progress: float = 0.0\nvar _thread_result: Resource = null\nvar _thread_error: String = \"\"\nvar _thread_mutex: Mutex = Mutex.new()\nvar _load_steps: int = 0\n\nfunc start_load(path: String) -> bool:\n\tif _state == 1:\n\t\treturn false\n\t# Use ResourceLoader.load_threaded_request which works in standard Godot.\n\t_thread_path = path\n\t_thread_progress = 0.0\n\t_thread_result = null\n\t_thread_error = \"\"\n\tvar err: int = ResourceLoader.load_threaded_request(path)\n\tif err != OK:\n\t\t_state = 3\n\t\t_thread_error = \"ResourceLoader.load_threaded_request failed: %d\" % err\n\t\tload_failed.emit(_thread_error)\n\t\t_state = 0\n\t\treturn true\n\t_state = 1\n\t_load_steps = ResourceLoader.load_threaded_get_load_steps(path)\n\tif _polling_timer == null:\n\t\t_polling_timer = Timer.new()\n\t\t_polling_timer.wait_time = 0.05\n\t\t_polling_timer.one_shot = false\n\t\tadd_child(_polling_timer)\n\t\t_polling_timer.timeout.connect(_poll)\n\t\t_polling_timer.start()\n\telse:\n\t\t_polling_timer.start()\n\treturn true\n\nfunc _poll() -> void:\n\tif _state != 1:\n\t\treturn\n\tvar err_progress = ResourceLoader.load_threaded_get_status(_thread_path, _thread_progress)\n\t# _thread_progress here is actually an array in some signatures; ensure we handle both.\n\t# In Godot 4, the signature is: load_threaded_get_status(path, progress_array)\n\t# progress_array is a 1-element Array. We pass it by ref via a temp var.\n\t_progress_emit(err_progress)\n\tif err_progress == ResourceLoader.THREAD_LOAD_LOADED:\n\t\t_polling_timer.stop()\n\t\tvar res: Resource = ResourceLoader.load_threaded_get(_thread_path)\n\t\t_state = 2\n\t\tload_completed.emit(res)\n\telif err_progress == ResourceLoader.THREAD_LOAD_FAILED or err_progress == ResourceLoader.THREAD_LOAD_INVALID_RESOURCE:\n\t\t_polling_timer.stop()\n\t\t_state = 3\n\t\t_thread_error = \"Thread load failed with status: %d\" % err_progress\n\t\tload_failed.emit(_thread_error)\n\t\t_state = 0\n\nfunc _progress_emit(status: int) -> void:\n\t# _thread_progress holds an Array with one float; clamp and emit.\n\tvar fraction: float = 0.0\n\tif _thread_progress is Array:\n\t\tfraction = float(_thread_progress[0])\n\telse:\n\t\tfraction = float(_thread_progress)\n\tfraction = clamp(fraction, 0.0, 1.0)\n\tprogress_updated.emit(fraction)\n\nfunc cancel() -> void:\n\tif _state == 1:\n\t\tif _polling_timer != null:\n\t\t\t_polling_timer.stop()\n\t\t_state = 0\n\t\t_thread_path = \"\"\n\t\t_thread_progress = 0.0\n\nfunc is_loading() -> bool:\n\treturn _state == 1\nGDEOF\n"]
