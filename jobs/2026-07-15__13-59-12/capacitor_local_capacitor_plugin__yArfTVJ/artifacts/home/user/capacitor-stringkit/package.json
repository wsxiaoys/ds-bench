{
  "name": "capacitor-stringkit",
  "version": "0.1.0",
  "description": "A Capacitor v8 plugin providing string utilities (echo, reverse, slugify) for the web.",
  "main": "dist/plugin.cjs.js",
  "module": "dist/esm/index.js",
  "types": "dist/esm/index.d.ts",
  "files": [
    "dist/"
  ],
  "scripts": {
    "build": "npm run clean && npm run tsc && npm run rollup",
    "tsc": "tsc",
    "rollup": "rollup -c rollup.config.mjs",
    "clean": "rimraf dist"
  },
  "keywords": [
    "capacitor",
    "plugin",
    "web",
    "string",
    "slugify",
    "reverse"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@capacitor/core": "^8.0.0"
  },
  "devDependencies": {
    "@capacitor/core": "^8.0.0",
    "rimraf": "^5.0.5",
    "rollup": "^4.0.0",
    "@rollup/plugin-node-resolve": "^15.2.3",
    "@rollup/plugin-commonjs": "^25.0.7",
    "typescript": "^5.4.0"
  }
}