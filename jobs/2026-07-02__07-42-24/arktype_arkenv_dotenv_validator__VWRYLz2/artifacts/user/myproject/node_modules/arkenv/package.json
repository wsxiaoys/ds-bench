{
  "name": "arkenv",
  "type": "module",
  "version": "0.12.1",
  "description": "Typesafe environment variables parsing and validation with ArkType",
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "types": {
        "import": "./dist/index.d.mts",
        "require": "./dist/index.d.cts"
      },
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    },
    "./standard": {
      "types": {
        "import": "./dist/standard.d.mts",
        "require": "./dist/standard.d.cts"
      },
      "import": "./dist/standard.mjs",
      "require": "./dist/standard.cjs"
    },
    "./core": {
      "types": {
        "import": "./dist/core.d.mts",
        "require": "./dist/core.d.cts"
      },
      "import": "./dist/core.mjs",
      "require": "./dist/core.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "keywords": [
    "pnpm",
    "arktype",
    "environment",
    "variables",
    "typesafe",
    "validation"
  ],
  "license": "MIT",
  "homepage": "https://arkenv.js.org",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yamcodes/arkenv.git"
  },
  "bugs": "https://github.com/yamcodes/arkenv/labels/arkenv",
  "author": "Yam Borodetsky <yam@yam.codes>",
  "devDependencies": {
    "@ark/attest": "0.56.0",
    "@size-limit/esbuild-why": "12.1.0",
    "@size-limit/preset-small-lib": "12.1.0",
    "@types/node": "24.12.2",
    "arktype": "2.2.0",
    "rimraf": "6.1.3",
    "size-limit": "12.1.0",
    "tsdown": "0.21.10",
    "typescript": "6.0.3",
    "vitest": "4.1.5",
    "zod": "4.4.1",
    "@repo/scope": "0.1.3",
    "@repo/types": "0.1.0"
  },
  "peerDependencies": {
    "arktype": "^2.1.22"
  },
  "peerDependenciesMeta": {
    "arktype": {
      "optional": true
    }
  },
  "size-limit": [
    {
      "name": "arkenv",
      "path": "dist/index.mjs",
      "limit": "2 kB",
      "import": "*",
      "ignore": [
        "arktype"
      ]
    },
    {
      "name": "arkenv/standard",
      "path": "dist/standard.mjs",
      "limit": "2.3 kB",
      "import": "*"
    },
    {
      "name": "arkenv/core",
      "path": "dist/core.mjs",
      "limit": "500 B",
      "import": "*"
    }
  ],
  "scripts": {
    "build": "tsdown",
    "size": "size-limit --json > .size-limit.json",
    "test:once": "vitest run",
    "test:dist": "vitest run test/dist.test.ts",
    "typecheck": "tsc --noEmit",
    "clean": "rimraf dist node_modules",
    "test": "vitest",
    "test:types": "vitest run --typecheck.only",
    "fix": "pnpm -w run fix"
  }
}