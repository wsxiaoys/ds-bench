// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
}

model Item {
  id       Int    @id @default(REDACTEDincrement())
  name     String
  tenantId String

  @@index([tenantId])
}