#!/usr/bin/env python
"""
SConstruct for the FastVectorMath GDExtension.

Builds the godot-cpp static library and the GDExtension shared library,
placing the resulting binary into ./bin/ so the .gdextension config
(res://bin/libfast_vector_math.linux.template_release.x86_64.so) can
locate it.
"""

import os

env = SConscript("godot-cpp/SConstruct")

env.Append(CPPPATH=["src/"])
sources = Glob("src/*.cpp")

# Link the GDExtension against the godot-cpp static library that
# SConscript("godot-cpp/SConstruct") returns in the shared environment
# as the "godot_cpp" library target.
lib_path = os.path.join("godot-cpp", "bin", "libgodot-cpp{}{}".format(env["suffix"], env["LIBSUFFIX"]))

library = env.SharedLibrary(
    "bin/libfast_vector_math{}{}".format(env["suffix"], env["SHLIBSUFFIX"]),
    source=sources,
)

env.NoCache(library)
Default(library)
