[gd_resource type="Resource" script_class="DialogTree" load_steps=20 format=3]

[ext_resource type="Script" path="res://scripts/DialogTree.gd" id="1_tree"]
[ext_resource type="Script" path="res://scripts/DialogNode.gd" id="2_node"]
[ext_resource type="Script" path="res://scripts/DialogChoice.gd" id="3_choice"]

[sub_resource type="Resource" id="Resource_choice_tavern"]
script = ExtResource("3_choice")
label = "Step into the tavern"
next_id = &"tavern"
condition_flag = &""

[sub_resource type="Resource" id="Resource_choice_blacksmith"]
script = ExtResource("3_choice")
label = "Visit the blacksmith"
next_id = &"blacksmith"
condition_flag = &""

[sub_resource type="Resource" id="Resource_choice_secret"]
script = ExtResource("3_choice")
label = "Follow the hidden path"
next_id = &"secret"
condition_flag = &"knows_secret"

[sub_resource type="Resource" id="Resource_node_start"]
script = ExtResource("2_node")
id = &"start"
speaker = "Narrator"
text = "You stand at the gates of Willowbrook. Smoke curls from a tavern chimney and a hammer rings from a nearby forge."
choices = Array[Resource]([SubResource("Resource_choice_tavern"), SubResource("Resource_choice_blacksmith"), SubResource("Resource_choice_secret")])
next_id = &""

[sub_resource type="Resource" id="Resource_node_tavern"]
script = ExtResource("2_node")
id = &"tavern"
speaker = "Tavern Keeper"
text = "Welcome, traveller! A mug of ale and a warm bed are yours for a few coins."
choices = Array[Resource]([])
next_id = &"ending"

[sub_resource type="Resource" id="Resource_node_blacksmith"]
script = ExtResource("2_node")
id = &"blacksmith"
speaker = "Blacksmith"
text = "Need a blade sharpened or a new tool forged? I am the best in the region."
choices = Array[Resource]([])
next_id = &"ending"

[sub_resource type="Resource" id="Resource_node_secret"]
script = ExtResource("2_node")
id = &"secret"
speaker = "Village Elder"
text = "You found the hidden glade. Few outsiders ever learn of this place."
choices = Array[Resource]([])
next_id = &"ending"

[sub_resource type="Resource" id="Resource_node_ending"]
script = ExtResource("2_node")
id = &"ending"
speaker = "Narrator"
text = "The sun sets over Willowbrook and you carry its stories with you."
choices = Array[Resource]([])
next_id = &""

[resource]
script = ExtResource("1_tree")
nodes = Array[Resource]([SubResource("Resource_node_start"), SubResource("Resource_node_tavern"), SubResource("Resource_node_blacksmith"), SubResource("Resource_node_secret"), SubResource("Resource_node_ending")])
start_id = &"start"
