app taskboard {
  wasp: {
    version: "^0.16.7"
  },
  title: "taskboard",
  db: {
    seeds: [
      import { devSeed } from "@src/dbSeeds.js"
    ]
  }
}

route RootRoute { path: "/", to: MainPage }
page MainPage {
  component: import { MainPage } from "@src/MainPage"
}

query getTasks {
  fn: import { getTasks } from "@src/queries.js",
  entities: [Task]
}

// Intentionally declared with only the Project entity so that Wasp's
// automatic, entity-based cache invalidation does NOT refresh it when a
// Task action runs. The client keeps it up to date manually.
query getProjectStats {
  fn: import { getProjectStats } from "@src/queries.js",
  entities: [Project]
}

action addTask {
  fn: import { addTask } from "@src/actions.js",
  entities: [Task]
}

action toggleTask {
  fn: import { toggleTask } from "@src/actions.js",
  entities: [Task]
}