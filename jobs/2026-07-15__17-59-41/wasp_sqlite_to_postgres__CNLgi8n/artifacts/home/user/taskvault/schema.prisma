datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model Task {
  id          Int     @id @default(autoincrement())
  description String
  isDone      Boolean @default(false)
}

model EventLog {
  id        Int      @id @default(autoincrement())
  message   String
  createdAt DateTime @default(now())
}