app bankapp {
  wasp: {
    version: "^0.16.0"
  },
  title: "bankapp",
  db: {
    seeds: [
      import { devSeed } from "@src/dbSeeds"
    ]
  }
}

action transferFunds {
  fn: import { transferFunds } from "@src/transferFunds.js",
  entities: [Account, LedgerEntry]
}

route RootRoute { path: "/", to: MainPage }
page MainPage {
  component: import { MainPage } from "@src/MainPage"
}
