[141.922266, "o", "{\r\n  \"invoice_number\": \"INV-2026-00042\",\r\n  \"issue_date\": \"2026-03-14\",\r\n  \"due_date\": \"2026-04-13\",\r\n  \"vendor\": {\r\n    \"name\": \"Acme Cloud Services, Inc.\",\r\n    \"address\": \"123 Market Street, San Francisco, CA 94103\",\r\n    \"email\": \"billing@acmecloud.example\"\r\n  },\r\n  \"bill_to\": {\r\n    \"name\": \"Globex Corporation\",\r\n    \"address\": \"456 Industrial Way, Springfield, IL 62701\"\r\n  },\r\n  \"line_items\": [\r\n    {\r\n      \"description\": \"LlamaParse Enterprise license (monthly)\",\r\n      \"quantity\": 1.0,\r\n      \"unit_price\": 1200.0,\r\n"]
[141.922292, "o", "      \"amount\": 1200.0\r\n    },\r\n    {\r\n      \"description\": \"Extract API credits (50,000 docs)\",\r\n      \"quantity\": 1.0,\r\n      \"unit_price\": 750.0,\r\n      \"amount\": 750.0\r\n    },\r\n    {\r\n      \"description\": \"Premium support hours\",\r\n      \"quantity\": 5.0,\r\n      \"unit_price\": 150.0,\r\n      \"amount\": 750.0\r\n    }\r\n  ],\r\n  \"subtotal\": 2700.0,\r\n  \"tax\": {\r\n    \"rate\": 8.875,\r\n    \"amount\": 239.63\r\n  },\r\n  \"grand_total\": 2939.63\r\n}"]
