[141.544413, "o", "echo \"=== schema.json ===\" && cat /home/user/extract_task/schema.json\r\n\u001b[?2004l\r"]
[141.544515, "o", "=== schema.json ===\r\n"]
[141.545495, "o", "{\r\n  \"description\": \"Schema for extracting key information from an invoice document.\",\r\n  \"type\": \"object\",\r\n  \"properties\": {\r\n    \"invoice_number\": {\r\n      \"description\": \"Unique identifier for the invoice.\",\r\n      \"type\": \"string\"\r\n    },\r\n    \"issue_date\": {\r\n      \"description\": \"The date the invoice was issued, in YYYY-MM-DD format.\",\r\n      \"type\": \"string\"\r\n    },\r\n    \"due_date\": {\r\n      \"description\": \"The date the invoice payment is due, in YYYY-MM-DD format.\",\r\n      \"type\": \"string\"\r\n    },\r\n    \"vendor\": {\r\n      \"description\": \"Information about the vendor or seller.\",\r\n      \"type\": \"object\",\r\n      \"properties\": {\r\n        \"name\": {\r\n          \"description\": \"Name of the vendor or seller.\",\r\n          \"type\": \"string\"\r\n        },\r\n        \"address\": {\r\n          \"description\": \"Full address of the vendor or seller.\",\r\n          \"type\": \"string\"\r\n        },\r\n        \"email\": {\r\n          \"description\": \"Contact email for the vendor or seller.\",\r\n          \"type\": \"string\"\r\n        }\r\n      },\r\n      \"required\": [\r\n        \"name\",\r\n        \"address\"\r\n      ],\r\n      \"additionalProperties\": false\r\n    },\r\n    \"bill_to\": {\r\n      \"description\": \"Information about the customer being billed.\",\r\n      \"type\": \"object\",\r\n      \"properties\": {\r\n        \"name\": {\r\n          \"description\": \"Name of the customer.\",\r\n          \"type\": \"string\"\r\n        },\r\n        \"address\": {\r\n          \"description\": \"Full billing address of the customer.\",\r\n          \"type\": \"string\"\r\n        }\r\n      },\r\n      \"required\": [\r\n        \"name\",\r\n        \"address\"\r\n      ],\r\n      \"additionalProperties\": false\r\n    },\r\n    \"line_items\": {\r\n      \"description\": \"List of individual items or services billed.\",\r\n      \"type\": \"array\",\r\n      \"items\": {\r\n        \"type\": \"object\",\r\n        \"properties\": {\r\n          \"description\": {\r\n            \"description\": \"Description of the item or service.\",\r\n            \"type\": \"string\"\r\n          },\r\n          \"quantity\": {\r\n            \"description\": \"Quantity of the item or service.\",\r\n            \"type\": \"number\"\r\n          },\r\n          \"unit_price\": {\r\n            \"description\": \"Price per unit of the item or service.\",\r\n            \"type\": \"number\"\r\n          },\r\n          \"amount\": {\r\n            \"description\": \"Total amount for the line item (quantity * unit price).\",\r\n            \"type\": \"number\"\r\n          }\r\n        },\r\n        \"required\": [\r\n          \"description\",\r\n          \"quantity\",\r\n          \"unit_price\",\r\n          \"amount\"\r\n        ],\r\n        \"additionalProperties\": false\r\n      }\r\n    },\r\n    \"subtotal\": {\r\n      \"description\": \"Sum of all line item amounts before taxes and discounts.\",\r\n      \"type\": \"number\"\r\n"]
[141.545588, "o", "    },\r\n    \"tax\": {\r\n      \"description\": \"Details about the tax applied to the invoice.\",\r\n      \"type\": \"object\",\r\n      \"properties\": {\r\n        \"rate\": {\r\n          \"description\": \"Tax rate as a percentage (e.g., 8.875 for 8.875%).\",\r\n          \"type\": \"number\"\r\n        },\r\n        \"amount\": {\r\n          \"description\": \"Total amount of tax applied.\",\r\n          \"type\": \"number\"\r\n        }\r\n      },\r\n      \"required\": [\r\n        \"rate\",\r\n        \"amount\"\r\n      ],\r\n      \"additionalProperties\": false\r\n    },\r\n    \"grand_total\": {\r\n      \"description\": \"The total amount due for the invoice, including subtotal and taxes.\",\r\n      \"type\": \"number\"\r\n    }\r\n  },\r\n  \"required\": [\r\n    \"invoice_number\",\r\n    \"issue_date\",\r\n    \"due_date\",\r\n    \"vendor\",\r\n    \"bill_to\",\r\n    \"line_items\",\r\n    \"subtotal\",\r\n    \"tax\",\r\n    \"grand_total\"\r\n  ],\r\n  \"additionalProperties\": false\r\n}"]
