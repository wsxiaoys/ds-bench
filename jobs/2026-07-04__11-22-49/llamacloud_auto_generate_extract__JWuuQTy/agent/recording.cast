l[\"agentic\", \"cost_effective\"]] = None\r\n    \"\"\"Extract tier: cost_effective (5 credits/page) or agentic (15 credits/page)\"\"\"\r\n\r\n    version: Optional[str] = None\r\n    \"\"\"\r\n    Use 'latest' for the latest release for the selected tier or a date string\r\n"]
