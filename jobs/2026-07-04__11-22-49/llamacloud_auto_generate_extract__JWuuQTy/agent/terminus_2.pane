{
  "description": "Schema for extracting key information from an invoice document.",
  "type": "object",
  "properties": {
    "invoice_number": {
      "description": "Unique identifier for the invoice.",
      "type": "string"
    },
    "issue_date": {
      "description": "The date the invoice was issued, in YYYY-MM-DD format.",
      "type": "string"
    },
    "due_date": {
      "description": "The date the invoice payment is due, in YYYY-MM-DD format.",
      "type": "string"
    },
    "vendor": {
      "description": "Information about the vendor or seller.",
      "type": "object",
      "properties": {
        "name": {
          "description": "Name of the vendor or seller.",
          "type": "string"
        },
        "address": {
          "description": "Full address of the vendor or seller.",
          "type": "string"
        },
        "email": {
          "description": "Contact email for the vendor or seller.",
          "type": "string"
        }
      },
      "required": [
        "name",
        "address"
      ],
      "additionalProperties": false
    },
    "bill_to": {
      "description": "Information about the customer being billed.",
      "type": "object",
      "properties": {
        "name": {
          "description": "Name of the customer.",
          "type": "string"
        },
        "address": {
          "description": "Full billing address of the customer.",
          "type": "string"
        }
      },
      "required": [
        "name",
        "address"
      ],
      "additionalProperties": false
    },
    "line_items": {
      "description": "List of individual items or services billed.",
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "description": {
            "description": "Description of the item or service.",
            "type": "string"
          },
          "quantity": {
            "description": "Quantity of the item or service.",
            "type": "number"
          },
          "unit_price": {
            "description": "Price per unit of the item or service.",
            "type": "number"
          },
          "amount": {
            "description": "Total amount for the line item (quantity * unit price).",
            "type": "number"
          }
        },
        "required": [
          "description",
          "quantity",
          "unit_price",
          "amount"
        ],
        "additionalProperties": false
      }
    },
    "subtotal": {
      "description": "Sum of all line item amounts before taxes and discounts.",
      "type": "number"
    },
    "tax": {
      "description": "Details about the tax applied to the invoice.",
      "type": "object",
