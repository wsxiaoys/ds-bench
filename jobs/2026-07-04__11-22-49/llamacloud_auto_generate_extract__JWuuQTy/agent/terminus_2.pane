        },
        "amount": {
          "description": "Total amount of tax applied.",
          "type": "number"
        }
      },
      "required": [
        "rate",
        "amount"
      ],
      "additionalProperties": false
    },
    "grand_total": {
      "description": "The total amount due for the invoice, including subtotal and taxes.",
      "type": "number"
    }
  },
  "required": [
    "invoice_number",
    "issue_date",
    "due_date",
    "vendor",
    "bill_to",
    "line_items",
    "subtotal",
    "tax",
    "grand_total"
  ],
