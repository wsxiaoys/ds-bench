{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "metrics-dashboard-app",
  "main": "src/worker.tsx",
  "compatibility_date": "2025-08-21",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "binding": "ASSETS"
  },
  "observability": {
    "enabled": true
  },
  "vars": {},
  "durable_objects": {
    "bindings": [
      {
        "name": "METRICS",
        "class_name": "MetricsDurableObject"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_classes": ["MetricsDurableObject"]
    }
  ]
}
