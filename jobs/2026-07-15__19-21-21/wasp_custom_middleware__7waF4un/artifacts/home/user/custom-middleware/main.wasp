app customMiddleware {
  wasp: {
    version: "^0.21.1"
  },
  title: "custom-middleware",
  head: [
    "<link rel='icon' href='/favicon.ico' />",
  ],
  server: {
    middlewareConfigFn: import { serverMiddlewareFn } from "@src/serverSetup"
  }
}

route RootRoute { path: "/", to: MainPage }
page MainPage {
  component: import { MainPage } from "@src/MainPage"
}

apiNamespace apiNamespaceV1 {
  middlewareConfigFn: import { apiNamespaceMiddlewareFn } from "@src/apis",
  path: "/api"
}

api apiStatus {
  fn: import { apiStatus } from "@src/apis",
  httpRoute: (GET, "/api/status"),
  auth: false
}

api apiEcho {
  fn: import { apiEcho } from "@src/apis",
  middlewareConfigFn: import { apiEchoMiddlewareFn } from "@src/apis",
  httpRoute: (POST, "/api/echo"),
  auth: false
}
