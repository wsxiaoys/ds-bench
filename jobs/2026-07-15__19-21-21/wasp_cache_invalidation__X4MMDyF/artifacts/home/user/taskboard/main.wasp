app taskboard {
  wasp: {
    version: "^0.16.7"
  },
  title: "taskboard",
  db: {
    seeds: [
      import { devSeed } from "@src/seed"
    ]
  }
}

route RootRoute { path: "/", to: MainPage }
page MainPage {
  component: import { MainPage } from "@src/MainPage"
}

query getTasks {
  fn: import { getTasks } from "@src/queries",
  entities: [Task]
}

// Intentionally decoupled: this computed/aggregate query only declares
// Project as its entity, even though it derives data from Task rows via
// the Project -> Task relation. Because of this, Wasp's automatic,
// entity-based cache invalidation will NOT refresh this query when the
// addTask/toggleTask Actions run (they only declare Task). The client is
// responsible for manually invalidating this query's cache after those
// actions succeed.
query getProjectStats {
  fn: import { getProjectStats } from "@src/queries",
  entities: [Project]
}

action addTask {
  fn: import { addTask } from "@src/actions",
  entities: [Task]
}

action toggleTask {
  fn: import { toggleTask } from "@src/actions",
  entities: [Task]
}
