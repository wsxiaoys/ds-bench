[?2004l[?2004h> 
[?2004l[?2004h>   const url = process.env.PB_URL || 'http://127.0.0.1:8090';
[?2004l[?2004h>   const email = process.env.PB_ADMIN_EMAIL;
[?2004l[?2004h>   const password = process.env.PB_ADMIN_PASSWORD;
[?2004l[?2004h> 
[?2004l[?2004h>   if (!email || !password) {
