[?2004l[?2004h>     process.exit(2);
[?2004l[?2004h>   }
[?2004l[?2004h> 
[?2004l[?2004h>   const pb = new PocketBase(url);
[?2004l[?2004h> 
[?2004l[?2004h>   // Disable REDACTED-cancellation so we can control the lifecycle explicitly.
[?2004l[?2004h>   pb.REDACTEDCancellation(false);
[?2004l[?2004h> 
[?2004l[?2004h>   let shuttingDown = false;
