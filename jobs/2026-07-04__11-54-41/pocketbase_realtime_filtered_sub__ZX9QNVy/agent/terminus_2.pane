[?2004l[?2004h>         }
[?2004l[?2004h>       }
[?2004l[?2004h>     } finally {
[?2004l[?2004h>       process.exit(typeof code === 'number' ? code : 0);
[?2004l[?2004h>     }
[?2004l[?2004h>   };
[?2004l[?2004h> 
[?2004l[?2004h>   // Graceful shutdown on SIGTERM/SIGINT.
