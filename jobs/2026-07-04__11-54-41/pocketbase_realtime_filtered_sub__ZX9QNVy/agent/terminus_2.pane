#!/usr/bin/env node
'use strict';

// Node.js doesn't ship a global EventSource, but PocketBase's realtime
// (SSE) client expects one. Polyfill it via the `eventsource` package.
{
  const { EventSource } = require('eventsource');
  if (typeof globalThis.EventSource === 'undefined') {
    globalThis.EventSource = EventSource;
  }
}

// pocketbase >=0.21 ships as ESM by default; the subpath `pocketbase/cjs`
// exposes a CommonJS build that exports the default `Client` class under
// `module.exports`, which we rename to `PocketBase` for clarity.
const PocketBase = require('pocketbase/cjs');

function parseArgs(argv) {
  const args = {};
  for (let i = 0; i < argv.length; i++) {
    const a = argv[i];
    if (a === '--chat' || a === '-c') {
      args.chat = argv[++i];
    } else if (a.startsWith('--chat=')) {
      args.chat = a.substring('--chat='.length);
    }
  }
  return args;
}

