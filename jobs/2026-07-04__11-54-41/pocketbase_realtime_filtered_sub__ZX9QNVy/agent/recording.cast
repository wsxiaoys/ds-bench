[131.007671, "o", "\u001b[?2004h> "]
[131.007992, "o", "  const args = parseArgs(process.argv.slice(2));\r\n\u001b[?2004l\r"]
[131.008032, "o", "\u001b[?2004h> "]
[131.008171, "o", "  if (!args.chat) {\r\n\u001b[?2004l\r"]
[131.00821, "o", "\u001b[?2004h> "]
[131.008667, "o", "    process.stderr.write('Usage: node subscribe.js --chat <chatId>\\n');\r\n\u001b[?2004l\r"]
[131.008707, "o", "\u001b[?2004h> "]
[131.008853, "o", "    process.exit(2);\r\n\u001b[?2004l\r"]
[131.008893, "o", "\u001b[?2004h> "]
[131.008963, "o", "  }\r\n\u001b[?2004l\r\u001b[?2004h"]
[131.009016, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[131.009409, "o", "  const url = process.env.PB_URL || 'http://127.0.0.1:8090';\r\n\u001b[?2004l\r"]
[131.009449, "o", "\u001b[?2004h"]
[131.009526, "o", "> "]
[131.009747, "o", "  const email = process.env.PB_ADMIN_EMAIL;\r\n\u001b[?2004l\r"]
[131.009783, "o", "\u001b[?2004h> "]
[131.010113, "o", "  const password = process.env.PB_ADMIN_PASSWORD;\r\n\u001b[?2004l\r"]
[131.010149, "o", "\u001b[?2004h> "]
[131.01022, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[131.010433, "o", "  if (!email || !password) {\r\n\u001b[?2004l\r"]
[131.010473, "o", "\u001b[?2004h> "]
[131.010992, "o", "    process.stderr.write('Missing PB_ADMIN_EMAIL or PB_ADMIN_PASSWORD env vars\\n');\r\n\u001b[?2004l\r"]
[131.011051, "o", "\u001b[?2004h> "]
[131.011201, "o", "    process.exit(2);\r\n\u001b[?2004l\r"]
[131.01124, "o", "\u001b[?2004h> "]
[131.011321, "o", "  }\r\n\u001b[?2004l\r\u001b[?2004h"]
[131.011361, "o", "> \r\n\u001b[?2004l\r"]
[131.011429, "o", "\u001b[?2004h> "]
[131.011629, "o", "  const pb = new PocketBase(url);\r\n\u001b[?2004l\r"]
[131.011665, "o", "\u001b[?2004h> "]
[131.011737, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[131.012203, "o", "  // Disable REDACTED-cancellation so we can control the lifecycle explicitly.\r\n\u001b[?2004l\r"]
[131.012242, "o", "\u001b[?2004h> "]
[131.012471, "o", "  pb.REDACTEDCancellation(false);\r\n\u001b[?2004l\r"]
[131.01251, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[131.012576, "o", "\u001b[?2004h> "]
[131.012766, "o", "  let shuttingDown = false;\r\n\u001b[?2004l\r"]
[131.012802, "o", "\u001b[?2004h> "]
[131.012985, "o", "  let unsubscribe = null;\r\n\u001b[?2004l\r"]
[131.013023, "o", "\u001b[?2004h> "]
[131.013096, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[131.013334, "o", "  const shutdown = async (code) => {\r\n\u001b[?2004l\r"]
[131.013373, "o", "\u001b[?2004h> "]
[131.013569, "o", "    if (shuttingDown) return;\r\n\u001b[?2004l\r"]
[131.013607, "o", "\u001b[?2004h> "]
[131.013791, "o", "    shuttingDown = true;\r\n\u001b[?2004l\r"]
[131.013858, "o", "\u001b[?2004h> "]
[131.013896, "o", "    try {\r\n\u001b[?2004l\r"]
[131.013971, "o", "\u001b[?2004h> "]
[131.014243, "o", "      if (typeof unsubscribe === 'function') {\r\n\u001b[?2004l\r"]
[131.014296, "o", "\u001b[?2004h> "]
[131.014396, "o", "        try {\r\n\u001b[?2004l\r"]
[131.014436, "o", "\u001b[?2004h> "]
[131.014601, "o", "          unsubscribe();\r\n\u001b[?2004l\r"]
[131.014641, "o", "\u001b[?2004h> "]
[131.014795, "o", "        } catch (e) {\r\n\u001b[?2004l\r"]
[131.014836, "o", "\u001b[?2004h> "]
[131.015447, "o", "          process.stderr.write('unsubscribe error: ' + (e && e.message ? e.message : e) + '\\n');\r\n\u001b[?2004l\r"]
[131.015487, "o", "\u001b[?2004h> "]
[131.015564, "o", "        }\r\n\u001b[?2004l\r"]
[131.015602, "o", "\u001b[?2004h> "]
[131.015667, "o", "      }\r\n\u001b[?2004l\r"]
[131.015706, "o", "\u001b[?2004h> "]
[131.015821, "o", "    } finally {\r\n\u001b[?2004l\r"]
[131.015861, "o", "\u001b[?2004h> "]
[131.016217, "o", "      process.exit(typeof code === 'number' ? code : 0);\r\n\u001b[?2004l\r"]
[131.016272, "o", "\u001b[?2004h> "]
[131.016345, "o", "    }\r\n\u001b[?2004l\r\u001b[?2004h"]
[131.016399, "o", ">   };\r\n\u001b[?2004l\r"]
[131.016473, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[131.016512, "o", "\u001b[?2004h> "]
[131.01682, "o", "  // Enforce a hard 3-second shutdown deadline.\r\n\u001b[?2004l\r"]
[131.016862, "o", "\u001b[?2004h> "]
[131.017297, "o", "  process.on('SIGTERM', () => { shutdown(0); });\r\n\u001b[?2004l\r\u001b[?2004h> "]
[131.017598, "o", "  process.on('SIGINT', () => { shutdown(0); });\r\n\u001b[?2004l\r"]
[131.017653, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[131.017756, "o", "\u001b[?2004h> "]
[131.018286, "o", "  // Belt-and-braces: never let unhandled errors/rejections kill the process silently.\r\n\u001b[?2004l\r"]
[131.01833, "o", "\u001b[?2004h> "]
[131.018641, "o", "  process.on('uncaughtException', (err) => {\r\n\u001b[?2004l\r"]
[131.018684, "o", "\u001b[?2004h> "]
[131.019326, "o", "    process.stderr.write('uncaughtException: ' + (err && err.stack ? err.stack : err) + '\\n');\r\n\u001b[?2004l\r"]
[131.019372, "o", "\u001b[?2004h> "]
[131.019496, "o", "    shutdown(1);\r\n\u001b[?2004l\r"]
[131.019536, "o", "\u001b[?2004h> "]
[131.019634, "o", "  });\r\n\u001b[?2004l\r\u001b[?2004h"]
[131.019674, "o", "> "]
[131.019978, "o", "  process.on('unhandledRejection', (reason) => {\r\n\u001b[?2004l\r"]
[131.020018, "o", "\u001b[?2004h> "]
[131.020748, "o", "    process.stderr.write('unhandledRejection: ' + (reason && reason.stack ? reason.stack : reason) + '\\n');\r\n\u001b[?2004l\r"]
[131.020789, "o", "\u001b[?2004h> "]
[131.020883, "o", "  });\r\n\u001b[?2004l\r\u001b[?2004h"]
[131.020924, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h"]
[131.021018, "o", ">   try {\r\n\u001b[?2004l\r"]
[131.021064, "o", "\u001b[?2004h> "]
[131.021458, "o", "    await pb.admins.authWithPassword(email, password);\r\n\u001b[?2004l\r"]
[131.021503, "o", "\u001b[?2004h> "]
[131.02163, "o", "  } catch (err) {\r\n\u001b[?2004l\r"]
[131.02167, "o", "\u001b[?2004h> "]
[131.022303, "o", "    process.stderr.write('Auth failed: ' + (err && err.message ? err.message : err) + '\\n');\r\n\u001b[?2004l\r"]
[131.022402, "o", "\u001b[?2004h> "]
[131.022502, "o", "    process.exit(1);\r\n\u001b[?2004l\r"]
[131.022545, "o", "\u001b[?2004h> "]
[131.022761, "o", "  }\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[131.023168, "o", "  // Server-side filter so we only get events for the requested chat.\r\n\u001b[?2004l\r"]
[131.023208, "o", "\u001b[?2004h> "]
[131.023745, "o", "  // Escape single quotes in the chat id so a malicious value can't break out\r\n\u001b[?2004l\r"]
[131.023784, "o", "\u001b[?2004h> "]
[131.024032, "o", "  // of the filter string literal.\r\n\u001b[?2004l\r"]
[131.024075, "o", "\u001b[?2004h> "]
[131.024486, "o", "  const safeChat = String(args.chat).replace(/'/g, \"\\\\'\");\r\n\u001b[?2004l\r"]
[131.024526, "o", "\u001b[?2004h> "]
[131.024814, "o", "  const filter = `chat = '${safeChat}'`;\r\n\u001b[?2004l\r"]
[131.024857, "o", "\u001b[?2004h> "]
[131.02495, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[131.024998, "o", "  try {\r\n\u001b[?2004l\r"]
[131.025088, "o", "\u001b[?2004h> "]
[131.025572, "o", "    unsubscribe = await pb.collection('messages').subscribe('*', (event) => {\r\n\u001b[?2004l\r"]
[131.025613, "o", "\u001b[?2004h> "]
[131.026051, "o", "      // event.action is one of 'create' | 'update' | 'delete'.\r\n\u001b[?2004l\r"]
[131.026091, "o", "\u001b[?2004h> "]
[131.026454, "o", "      // event.record contains the record fields.\r\n\u001b[?2004l\r"]
[131.026497, "o", "\u001b[?2004h> "]
[131.026665, "o", "      const payload = {\r\n\u001b[?2004l\r"]
[131.026706, "o", "\u001b[?2004h> "]
[131.02692, "o", "        action: event.action,\r\n\u001b[?2004l\r"]
[131.02696, "o", "\u001b[?2004h> "]
[131.027175, "o", "        record: event.record,\r\n\u001b[?2004l\r"]
[131.027216, "o", "\u001b[?2004h> "]
[131.027314, "o", "      };\r\n\u001b[?2004l\r"]
[131.027357, "o", "\u001b[?2004h> "]
[131.027841, "o", "      // Write a single JSON line and flush immediately so consumers can\r\n\u001b[?2004l\r"]
[131.027881, "o", "\u001b[?2004h> "]
[131.028095, "o", "      // react in real-time.\r\n\u001b[?2004l\r"]
[131.028135, "o", "\u001b[?2004h> "]
[131.028554, "o", "      process.stdout.write(JSON.stringify(payload) + '\\n');\r\n\u001b[?2004l\r"]
[131.028594, "o", "\u001b[?2004h> "]
[131.02869, "o", "    }, {\r\n\u001b[?2004l\r"]
[131.02878, "o", "\u001b[?2004h> "]
[131.028877, "o", "      filter: filter,\r\n\u001b[?2004l\r"]
[131.028917, "o", "\u001b[?2004h> "]
[131.029455, "o", "      // Expand the chat field (already part of the record) just to be safe.\r\n\u001b[?2004l\r"]
[131.0295, "o", "\u001b[?2004h> "]
[131.029707, "o", "      fields: 'id,chat,body',\r\n\u001b[?2004l\r"]
[131.029754, "o", "\u001b[?2004h> "]
[131.029866, "o", "    });\r\n\u001b[?2004l\r\u001b[?2004h> "]
[131.030007, "o", "  } catch (err) {\r\n\u001b[?2004l\r"]
[131.030051, "o", "\u001b[?2004h> "]
[131.030714, "o", "    process.stderr.write('Subscribe failed: ' + (err && err.message ? err.message : err) + '\\n');\r\n\u001b[?2004l\r"]
[131.030759, "o", "\u001b[?2004h> "]
[131.030915, "o", "    process.exit(1);\r\n\u001b[?2004l\r"]
[131.030961, "o", "\u001b[?2004h> "]
[131.031043, "o", "  }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[131.031084, "o", "\r\n\u001b[?2004l\r\u001b[?2004h"]
[131.031163, "o", "> "]
[131.031319, "o", "  // Keep the process alive.\r\n\u001b[?2004l\r"]
[131.031358, "o", "\u001b[?2004h> "]
[131.031437, "o", "}\r\n\u001b[?2004l\r\u001b[?2004h"]
[131.03148, "o", "> \r\n\u001b[?2004l\r"]
[131.031561, "o", "\u001b[?2004h> "]
[131.031702, "o", "main().catch((err) => {\r\n\u001b[?2004l\r"]
[131.031741, "o", "\u001b[?2004h> "]
[131.032335, "o", "  process.stderr.write('Fatal: ' + (err && err.stack ? err.stack : err) + '\\n');\r\n\u001b[?2004l\r"]
[131.032375, "o", "\u001b[?2004h> "]
[131.032536, "o", "  process.exit(1);\r\n\u001b[?2004l\r"]
[131.032577, "o", "\u001b[?2004h> "]
[131.03266, "o", "});\r\n\u001b[?2004l\r\u001b[?2004h"]
[131.032701, "o", "> EOF\r\n\u001b[?2004l\r"]
