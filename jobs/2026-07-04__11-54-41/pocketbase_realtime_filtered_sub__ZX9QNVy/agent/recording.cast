[338.407893, "o", "drwxr-xr-x 5 root root  115 Jul  4 11:57 \u001b[01;34mnode_modules\u001b[0m\r\n-rw-r--r-- 1 root root 1381 Jul  4 11:57 package-lock.json\r\n-rw-r--r-- 1 root root  327 Jul  4 11:57 package.json\r\n-rw-r--r-- 1 root root 4149 Jul  4 11:58 subscribe.js\r\n"]
[338.408055, "o", "---\r\n"]
[338.410557, "o", "#!/usr/bin/env node\r\n'use strict';\r\n\r\n// Node.js doesn't ship a global EventSource, but PocketBase's realtime\r\n// (SSE) client expects one. Polyfill it via the `eventsource` package.\r\n{\r\n  const { EventSource } = require('eventsource');\r\n  if (typeof globalThis.EventSource === 'undefined') {\r\n    globalThis.EventSource = EventSource;\r\n  }\r\n}\r\n\r\n// pocketbase >=0.21 ships as ESM by default; the subpath `pocketbase/cjs`\r\n// exposes a CommonJS build that exports the default `Client` class under\r\n// `module.exports`, which we rename to `PocketBase` for clarity.\r\nconst PocketBase = require('pocketbase/cjs');\r\n\r\nfunction parseArgs(argv) {\r\n  const args = {};\r\n  for (let i = 0; i < argv.length; i++) {\r\n    const a = argv[i];\r\n    if (a === '--chat' || a === '-c') {\r\n      args.chat = argv[++i];\r\n    } else if (a.startsWith('--chat=')) {\r\n      args.chat = a.substring('--chat='.length);\r\n    }\r\n  }\r\n  return args;\r\n}\r\n\r\n"]
[338.41093, "o", "\u001b[?2004h"]
