[165.600764, "i", "cat > /home/user/myproject/subscribe.js <<'EOF'\n#!/usr/bin/env node\n'use strict';\n\n// pocketbase >=0.21 ships as ESM by default; the subpath `pocketbase/cjs`\n// exposes a CommonJS build that exports the default `Client` class under\n// `module.exports`, which we rename to `PocketBase` for clarity.\nconst PocketBase = require('pocketbase/cjs');\n\nfunction parseArgs(argv) {\n  const args = {};\n  for (let i = 0; i < argv.length; i++) {\n    const a = argv[i];\n    if (a === '--chat' || a === '-c') {\n      args.chat = argv[++i];\n    } else if (a.startsWith('--chat=')) {\n      args.chat = a.substring('--chat='.length);\n    }\n  }\n  return args;\n}\n\nasync function main() {\n  const args = parseArgs(process.argv.slice(2));\n  if (!args.chat) {\n    process.stderr.write('Usage: node subscribe.js --chat <chatId>\\n');\n    process.exit(2);\n  }\n\n  const url = process.env.PB_URL || 'http://127.0.0.1:8090';\n  const email = process.env.PB_ADMIN_EMAIL;\n  const password = process.env.PB_ADMIN_PASSWORD;\n\n  if (!email || !password) {\n    process.stderr.write('Missing PB_ADMIN_EMAIL or PB_ADMIN_PASSWORD env vars\\n');\n    process.exit(2);\n  }\n\n  const pb = new PocketBase(url);\n\n  // Disable REDACTED-cancellation so we can control the lifecycle explicitly.\n  pb.REDACTEDCancellation(false);\n\n  let shuttingDown = false;\n  let unsubscribe = null;\n  let shutdownTimer = null;\n\n  const shutdown = async (code) => {\n    if (shuttingDown) return;\n    shuttingDown = true;\n\n    // Hard 3s deadline: even if cleanup hangs, still exit.\n    if (!shutdownTimer) {\n      shutdownTimer = setTimeout(() => {\n        process.exit(typeof code === 'number' ? code : 0);\n      }, 3000);\n      // don't keep the loop alive just for this timer\n      if (shutdownTimer.unref) shutdownTimer.unref();\n    }\n\n    try {\n      if (typeof unsubscribe === 'function') {\n        try {\n          unsubscribe();\n        } catch (e) {\n          process.stderr.write('unsubscribe error: ' + (e && e.message ? e.message : e) + '\\n');\n        }\n      }\n    } finally {\n      process.exit(typeof code === 'number' ? code : 0);\n    }\n  };\n\n  // Enforce a hard 3-second shutdown deadline on SIGTERM/SIGINT.\n  process.on('SIGTERM', () => { shutdown(0); });\n  process.on('SIGINT', () => { shutdown(0); });\n\n  // Don't let unhandled errors/rejections kill the process silently.\n  process.on('uncaughtException', (err) => {\n    process.stderr.write('uncaughtException: ' + (err && err.stack ? err.stack : err) + '\\n');\n    shutdown(1);\n  });\n  process.on('unhandledRejection', (reason) => {\n    process.stderr.write('unhandledRejection: ' + (reason && reason.stack ? reason.stack : reason) + '\\n');\n  });\n\n  try {\n    await pb.admins.authWithPassword(email, password);\n  } catch (err) {\n    process.stderr.write('Auth failed: ' + (err && err.message ? err.message : err) + '\\n');\n    process.exit(1);\n  }\n\n  // Server-side filter so we only get events for the requested chat.\n  // Escape single quotes in the chat id so a malicious value can't break\n  // out of the filter string literal.\n  const safeChat = String(args.chat).replace(/'/g, \"\\\\'\");\n  const filter = `chat = '${safeChat}'`;\n\n  try {\n    unsubscribe = await pb.collection('messages').subscribe('*', (event) => {\n      // event.action is one of 'create' | 'update' | 'delete'.\n      // event.record contains the record fields (id, chat, body, ...).\n      const payload = {\n        action: event.action,\n        record: event.record,\n      };\n      // Write a single JSON line and flush immediately so consumers can\n      // react in real-time.\n      process.stdout.write(JSON.stringify(payload) + '\\n');\n    }, {\n      filter: filter,\n      // Expand the chat field (already part of the record) just to be safe.\n      fields: 'id,chat,body',\n    });\n  } catch (err) {\n    process.stderr.write('Subscribe failed: ' + (err && err.message ? err.message : err) + '\\n');\n    process.exit(1);\n  }\n\n  // Keep the process alive.\n}\n\nmain().catch((err) => {\n  process.stderr.write('Fatal: ' + (err && err.stack ? err.stack : err) + '\\n');\n  process.exit(1);\n});\nEOF\n"]
