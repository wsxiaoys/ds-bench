[288.182725, "i", "TOKEN=$(cat /tmp/token)\n# Create chat-1 record\necho \"--- CREATE chat-1 ---\"\nR1=$(curl -s -X POST http://127.0.0.1:8090/api/collections/messages/records -H \"Authorization: $TOKEN\" -H 'Content-Type: application/json' -d '{\"chat\":\"chat-1\",\"body\":\"Test1\"}')\necho \"$R1\"\nID1=$(echo $R1 | python3 -c 'import sys,json;print(json.load(sys.stdin)[\"id\"])')\necho \"ID1=$ID1\"\n\nsleep 1\n\n# Create chat-2 record - should NOT show up\necho \"--- CREATE chat-2 ---\"\nR2=$(curl -s -X POST http://127.0.0.1:8090/api/collections/messages/records -H \"Authorization: $TOKEN\" -H 'Content-Type: application/json' -d '{\"chat\":\"chat-2\",\"body\":\"ShouldNotShow\"}')\necho \"$R2\"\nID2=$(echo $R2 | python3 -c 'import sys,json;print(json.load(sys.stdin)[\"id\"])')\necho \"ID2=$ID2\"\n\nsleep 1\n\n# Update chat-1\necho \"--- UPDATE chat-1 ---\"\ncurl -s -X PATCH http://127.0.0.1:8090/api/collections/messages/records/$ID1 -H \"Authorization: $TOKEN\" -H 'Content-Type: application/json' -d '{\"body\":\"Updated1\"}'\necho\n\nsleep 1\n\n# Delete chat-1\necho \"--- DELETE chat-1 ---\"\ncurl -s -X DELETE http://127.0.0.1:8090/api/collections/messages/records/$ID1 -H \"Authorization: $TOKEN\"\necho\n\nsleep 2\necho \"--- OUTPUT ---\"\ncat /tmp/sub1.out\n"]
