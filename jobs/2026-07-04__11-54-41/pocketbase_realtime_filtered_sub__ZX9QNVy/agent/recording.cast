[311.335168, "i", "rm -f /tmp/sub2.out /tmp/sub2.err\ncd /home/user/myproject && node subscribe.js --chat chat-X > /tmp/sub2.out 2> /tmp/sub2.err &\nNODEPID=$(pgrep -f 'node subscribe.js')\necho \"NODEPID=$NODEPID\"\nsleep 3\n\nTOKEN=$(cat /tmp/token)\n# Test that records for OTHER chats don't appear\nfor i in 1 2 3; do\n  curl -s -X POST http://127.0.0.1:8090/api/collections/messages/records -H \"Authorization: $TOKEN\" -H 'Content-Type: application/json' -d \"{\\\"chat\\\":\\\"chat-$i\\\",\\\"body\\\":\\\"Hello $i\\\"}\" > /dev/null\ndone\n# Now create one for chat-X (should appear)\nRX=$(curl -s -X POST http://127.0.0.1:8090/api/collections/messages/records -H \"Authorization: $TOKEN\" -H 'Content-Type: application/json' -d '{\"chat\":\"chat-X\",\"body\":\"Expected\"}')\necho \"RX=$RX\"\nIDX=$(echo $RX | python3 -c 'import sys,json;print(json.load(sys.stdin)[\"id\"])')\n\nsleep 2\n\n# Delete it\ncurl -s -X DELETE http://127.0.0.1:8090/api/collections/messages/records/$IDX -H \"Authorization: $TOKEN\" > /dev/null\n\nsleep 2\necho \"--- OUTPUT (should ONLY contain chat-X events) ---\"\ncat /tmp/sub2.out\necho \"--- STDERR ---\"\ncat /tmp/sub2.err\n"]
[311.335408, "o", "\u001b[?2004l\r\r\n"]
