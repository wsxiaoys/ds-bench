[203.134884, "o", "    process.stderr.write('uncaughtException: ' + (err && err.stack ? err.stack : err) + '\\n');\r\n\u001b[?2004l\r"]
[203.134951, "o", "\u001b[?2004h> "]
[203.135083, "o", "    shutdown(1);\r\n\u001b[?2004l\r"]
[203.135149, "o", "\u001b[?2004h> "]
[203.13528, "o", "  });\r\n\u001b[?2004l\r\u001b[?2004h> "]
[203.135603, "o", "  process.on('unhandledRejection', (reason) => {\r\n\u001b[?2004l\r"]
[203.135655, "o", "\u001b[?2004h> "]
[203.136394, "o", "    process.stderr.write('unhandledRejection: ' + (reason && reason.stack ? reason.stack : reason) + '\\n');\r\n\u001b[?2004l\r"]
[203.136464, "o", "\u001b[?2004h> "]
[203.136588, "o", "  });\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[203.136664, "o", "  try {\r\n\u001b[?2004l\r"]
[203.136731, "o", "\u001b[?2004h> "]
[203.137107, "o", "    await pb.admins.authWithPassword(email, password);\r\n\u001b[?2004l\r"]
[203.137158, "o", "\u001b[?2004h> "]
[203.137299, "o", "  } catch (err) {\r\n\u001b[?2004l\r"]
[203.137354, "o", "\u001b[?2004h> "]
[203.137965, "o", "    process.stderr.write('Auth failed: ' + (err && err.message ? err.message : err) + '\\n');\r\n\u001b[?2004l\r"]
[203.138017, "o", "\u001b[?2004h> "]
[203.138181, "o", "    process.exit(1);\r\n\u001b[?2004l\r"]
[203.138235, "o", "\u001b[?2004h>   }\r\n"]
[203.138362, "o", "\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[203.138425, "o", "> "]
[203.138861, "o", "  // Server-side filter so we only get events for the requested chat.\r\n\u001b[?2004l\r"]
[203.138922, "o", "\u001b[?2004h> "]
[203.139408, "o", "  // Escape single quotes in the chat id so a malicious value can't break\r\n\u001b[?2004l\r"]
[203.139473, "o", "\u001b[?2004h> "]
[203.139746, "o", "  // out of the filter string literal.\r\n\u001b[?2004l\r"]
[203.139809, "o", "\u001b[?2004h> "]
[203.1402, "o", "  const safeChat = String(args.chat).replace(/'/g, \"\\\\'\");\r\n\u001b[?2004l\r"]
[203.140251, "o", "\u001b[?2004h> "]
[203.140567, "o", "  const filter = `chat = '${safeChat}'`;\r\n\u001b[?2004l\r"]
[203.140634, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[203.140751, "o", "\u001b[?2004h>   try {\r\n\u001b[?2004l\r"]
[203.140819, "o", "\u001b[?2004h> "]
[203.14137, "o", "    unsubscribe = await pb.collection('messages').subscribe('*', (event) => {\r\n\u001b[?2004l\r"]
[203.141436, "o", "\u001b[?2004h> "]
[203.141864, "o", "      // event.action is one of 'create' | 'update' | 'delete'.\r\n\u001b[?2004l\r\u001b[?2004h"]
[203.141982, "o", "> "]
[203.142395, "o", "      // event.record contains the record fields (id, chat, body, ...).\r\n\u001b[?2004l\r\u001b[?2004h"]
[203.142504, "o", "> "]
[203.14263, "o", "      const payload = {\r\n\u001b[?2004l\r"]
[203.142741, "o", "\u001b[?2004h> "]
[203.142908, "o", "        action: event.action,\r\n\u001b[?2004l\r"]
[203.143009, "o", "\u001b[?2004h> "]
[203.143161, "o", "        record: event.record,\r\n\u001b[?2004l\r"]
[203.143213, "o", "\u001b[?2004h> "]
[203.143367, "o", "      };\r\n\u001b[?2004l\r\u001b[?2004h> "]
[203.143839, "o", "      // Write a single JSON line and flush immediately so consumers can\r\n\u001b[?2004l\r"]
[203.143948, "o", "\u001b[?2004h> "]
[203.144107, "o", "      // react in real-time.\r\n\u001b[?2004l\r"]
[203.144175, "o", "\u001b[?2004h> "]
[203.144599, "o", "      process.stdout.write(JSON.stringify(payload) + '\\n');\r\n\u001b[?2004l\r"]
[203.144656, "o", "\u001b[?2004h> "]
[203.14478, "o", "    }, {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[203.144939, "o", "      filter: filter,\r\n\u001b[?2004l\r"]
[203.145046, "o", "\u001b[?2004h> "]
[203.145213, "o", "      fields: 'id,chat,body',\r\n\u001b[?2004l\r"]
[203.145331, "o", "\u001b[?2004h>     });\r\n\u001b[?2004l\r"]
[203.145448, "o", "\u001b[?2004h> "]
[203.14556, "o", "  } catch (err) {\r\n\u001b[?2004l\r\u001b[?2004h"]
[203.145628, "o", "> "]
[203.146296, "o", "    process.stderr.write('Subscribe failed: ' + (err && err.message ? err.message : err) + '\\n');\r\n\u001b[?2004l\r\u001b[?2004h"]
[203.146433, "o", "> "]
[203.146546, "o", "    process.exit(1);\r\n\u001b[?2004l\r\u001b[?2004h>   }\r\n\u001b[?2004l\r"]
[203.146654, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[203.146893, "o", "  // Keep the process alive.\r\n\u001b[?2004l\r\u001b[?2004h"]
[203.146995, "o", "> }\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[203.147111, "o", "\u001b[?2004h> "]
[203.147243, "o", "main().catch((err) => {\r\n\u001b[?2004l\r"]
[203.147346, "o", "\u001b[?2004h> "]
[203.147854, "o", "  process.stderr.write('Fatal: ' + (err && err.stack ? err.stack : err) + '\\n');\r\n\u001b[?2004l\r"]
[203.147922, "o", "\u001b[?2004h> "]
[203.148051, "o", "  process.exit(1);\r\n\u001b[?2004l\r"]
[203.148099, "o", "\u001b[?2004h> "]
[203.148217, "o", "});\r\n\u001b[?2004l\r\u001b[?2004h> EOF\r\n\u001b[?2004l\r"]
