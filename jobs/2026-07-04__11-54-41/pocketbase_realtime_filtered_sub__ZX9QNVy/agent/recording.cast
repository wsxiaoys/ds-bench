[327.959062, "i", "NODEPID=$(pgrep -f 'node subscribe.js')\necho \"NODEPID=$NODEPID\"\nT_START=$(date +%s%N)\nkill -TERM $NODEPID\nwhile kill -0 $NODEPID 2>/dev/null; do sleep 0.05; done\nT_END=$(date +%s%N)\necho \"Exit time ms: $(( (T_END - T_START) / 1000000 ))\"\n"]
