[41.207482, "o", "\u001b[32m\u001b[K26\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\u001b[01;31m\u001b[KCollectionTypeView\u001b[m\u001b[K = \"view\"\r\n"]
[41.207561, "o", "\u001b[32m\u001b[K27\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K)\r\n\u001b[32m\u001b[K28\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\r\n\u001b[32m\u001b[K29\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[Kconst systemHookIdCollection = \"__pbCollectionSystemHook__\"\r\n\u001b[32m\u001b[K30\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\r\n\u001b[32m\u001b[K31\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[Kconst defaultLowercaseRecordIdPattern = \"^[a-z0-9]+$\"\r\n\u001b[36m\u001b[K--\u001b[m\u001b[K\r\n\u001b[32m\u001b[K395\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\tcase \u001b[01;31m\u001b[KCollectionTypeView\u001b[m\u001b[K:\r\n"]
[41.207642, "o", "\u001b[32m\u001b[K396\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\treturn \u001b[01;31m\u001b[KNewViewCollection\u001b[m\u001b[K(name, optId...)\r\n\u001b[32m\u001b[K397\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\tdefault:\r\n\u001b[32m\u001b[K398\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\t\treturn NewBaseCollection(name, optId...)\r\n"]
[41.207725, "o", "\u001b[32m\u001b[K399\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\t}\r\n\u001b[32m\u001b[K400\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K}\r\n\u001b[32m\u001b[K401\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\r\n\u001b[36m\u001b[K--\u001b[m\u001b[K\r\n\u001b[32m\u001b[K422\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K// \u001b[01;31m\u001b[KNewViewCollection\u001b[m\u001b[K initializes and returns a new \"view\" Collection model.\r\n\u001b[32m\u001b[K423\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K//\r\n\u001b[32m\u001b[K424\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K// It also loads the minimal default configuration for the collection\r\n\u001b[32m\u001b[K425\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K// (eg. system fields, indexes, type specific options, etc.).\r\n\u001b[32m\u001b[K426\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[Kfunc \u001b[01;31m\u001b[KNewViewCollection\u001b[m\u001b[K(name string, optId ...string) *Collection {\r\n\u001b[32m\u001b[K427\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\tm := &Collection{}\r\n\u001b[32m\u001b[K428\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\tm.Name = name\r\n\u001b[32m\u001b[K429\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\tm.Type = \u001b[01;31m\u001b[KCollectionTypeView\u001b[m\u001b[K\r\n"]
[41.207786, "o", "\u001b[32m\u001b[K430\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\r\n\u001b[32m\u001b[K431\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\t// @todo consider removing once inferred composite literals are supported\r\n\u001b[32m\u001b[K432\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\tif len(optId) > 0 {\r\n\u001b[32m\u001b[K433\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\t\tm.Id = optId[0]\r\n\u001b[32m\u001b[K434\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\t}\r\n\u001b[36m\u001b[K--\u001b[m\u001b[K\r\n\u001b[32m\u001b[K485\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\treturn m.Type == \u001b[01;31m\u001b[KCollectionTypeView\u001b[m\u001b[K\r\n\u001b[32m\u001b[K486\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K}\r\n\u001b[32m\u001b[K487\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\r\n\u001b[32m\u001b[K488\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K// IntegrityChecks toggles the current collection integrity checks (ex. checking references on delete).\r\n\u001b[32m\u001b[K489\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[Kfunc (m *Collection) IntegrityChecks(enable bool) {\r\n\u001b[32m\u001b[K490\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\tm.disableIntegrityChecks = !enable\r\n\u001b[36m\u001b[K--\u001b[m\u001b[K\r\n\u001b[32m\u001b[K510\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\tcase \u001b[01;31m\u001b[KCollectionTypeView\u001b[m\u001b[K:\r\n\u001b[32m\u001b[K511\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\t\treturn json.Unmarshal(raw, &m.collectionViewOptions)\r\n\u001b[32m\u001b[K512\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\tcase CollectionTypeAuth:\r\n\u001b[32m\u001b[K513\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\t\treturn json.Unmarshal(raw, &m.collectionAuthOptions)\r\n\u001b[32m\u001b[K514\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\t}\r\n\u001b[32m\u001b[K515\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\r\n\u001b[36m\u001b[K--\u001b[m\u001b[K\r\n"]
[41.207842, "o", "\u001b[32m\u001b[K551\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\tcase \u001b[01;31m\u001b[KCollectionTypeView\u001b[m\u001b[K:\r\n\u001b[32m\u001b[K552\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\t\treturn json.Marshal(struct {\r\n\u001b[32m\u001b[K553\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\t\t\tbaseCollection\r\n\u001b[32m\u001b[K554\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\t\t\tcollectionViewOptions\r\n\u001b[32m\u001b[K555\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\t\t}{m.baseCollection, m.collectionViewOptions})\r\n\u001b[32m\u001b[K556\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\tcase CollectionTypeAuth:\r\n\u001b[36m\u001b[K--\u001b[m\u001b[K\r\n\u001b[32m\u001b[K609\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\tcase \u001b[01;31m\u001b[KCollectionTypeView\u001b[m\u001b[K:\r\n"]
[41.207897, "o", "\u001b[32m\u001b[K610\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\t\tif raw, err := types.ParseJSONRaw(m.collectionViewOptions); err == nil {\r\n\u001b[32m\u001b[K611\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\t\t\tresult[\"options\"] = raw\r\n\u001b[32m\u001b[K612\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\t\t} else {\r\n\u001b[32m\u001b[K613\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\t\t\treturn nil, err\r\n\u001b[32m\u001b[K614\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\t\t}\r\n\u001b[36m\u001b[K--\u001b[m\u001b[K\r\n\u001b[32m\u001b[K918\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\tcase \u001b[01;31m\u001b[KCollectionTypeView\u001b[m\u001b[K:\r\n\u001b[32m\u001b[K919\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\t\t// view fields are REDACTEDgenerated\r\n"]
[41.207948, "o", "\u001b[32m\u001b[K920\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\t}\r\n\u001b[32m\u001b[K921\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K}\r\n\u001b[32m\u001b[K922\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\r\n\u001b[32m\u001b[K923\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[Kfunc (c *Collection) initIdField() {\r\n"]
