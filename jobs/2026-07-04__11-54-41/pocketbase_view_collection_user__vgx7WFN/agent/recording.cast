[560.050724, "i", "rm -rf pb_data && cat > /tmp/setup_db.go << 'EOF'\npackage main\n\nimport (\n\t\"fmt\"\n\t\"os\"\n\n\t\"github.com/pocketbase/pocketbase/core\"\n\t\"github.com/pocketbase/pocketbase/plugins/migratecmd\"\n\n\t_ \"myapp/migrations\"\n)\n\nfunc main() {\n\tapp := core.NewBaseApp(core.BaseAppConfig{\n\t\tDataDir: \"pb_data\",\n\t})\n\n\tif err := app.Bootstrap(); err != nil {\n\t\tfmt.Println(\"Bootstrap error:\", err)\n\t\tos.Exit(1)\n\t}\n\n\tmigratecmd.MustRegister(app, app.RootCmd, migratecmd.Config{})\n\n\t// Create users manually\n\tusers := core.NewAuthCollection(\"users\", \"_pb_users_auth_\")\n\tif err := app.Save(users); err != nil {\n\t\tfmt.Println(\"Save users error:\", err)\n\t\tos.Exit(1)\n\t}\n\n\t// Create posts manually\n\tposts := core.NewBaseCollection(\"posts\")\n\tposts.Fields.Add(\n\t\t&core.TextField{Name: \"title\", Required: true, Max: 200},\n\t\t&core.RelationField{\n\t\t\tName:         \"author\",\n\t\t\tRequired:     true,\n\t\t\tMaxSelect:    1,\n\t\t\tCollectionId: users.Id,\n\t\t},\n\t\t&core.AutodateField{Name: \"created\", OnCreate: true},\n\t\t&core.AutodateField{Name: \"updated\", OnCreate: true, OnUpdate: true},\n\t)\n\tif err := app.Save(posts); err != nil {\n\t\tfmt.Println(\"Save posts error:\", err)\n\t\tos.Exit(1)\n\t}\n\n\t// Mark 1700000000_init.go as applied\n\t_, err := app.DB().NewQuery(\"INSERT INTO _migrations (file, applied) VALUES ('1700000000_init.go', 1234567890)\").Execute()\n\tif err != nil {\n\t\tfmt.Println(\"Mark migration error:\", err)\n\t\tos.Exit(1)\n\t}\n\n\t// Now run our migration by manually executing the view creation\n\trunNewMigration(app)\n}\n\nfunc runNewMigration(app core.App) {\n\t// Just call the view creation directly\n\tview := core.NewViewCollection(\"user_post_stats\")\n\tview.ViewQuery = `\n\t\tSELECT\n\t\t\tusers.id   AS id,\n\t\t\tusers.id   AS user,\n\t\t\tusers.email AS email,\n\t\t\tCOUNT(posts.id) AS post_count,\n\t\t\tCOALESCE(MAX(posts.created), '') AS last_post_at\n\t\tFROM users\n\t\tLEFT JOIN posts ON posts.author = users.id\n\t\tGROUP BY users.id, users.email\n\t`\n\tif err := app.Save(view); err != nil {\n\t\tfmt.Println(\"Save view error:\", err)\n\t\tos.Exit(1)\n\t}\n\tfmt.Println(\"View created successfully!\")\n}\nEOF\nls /tmp/setup_db.go\n"]
