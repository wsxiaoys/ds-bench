[306.171563, "o", "/root/go/pkg/mod/github.com/pocketbase/pocketbase@v0.31.0/core/app.go:135:\t// RunSystemMigrations applies all new migrations registered in the [core.SystemMigrations] list.\r\n/root/go/pkg/mod/github.com/pocketbase/pocketbase@v0.31.0/core/app.go:136:\tRunSystemMigrations() error\r\n/root/go/pkg/mod/github.com/pocketbase/pocketbase@v0.31.0/core/app.go:142:\t// (aka. from both [core.SystemMigrations] and [core.AppMigrations]).\r\n/root/go/pkg/mod/github.com/pocketbase/pocketbase@v0.31.0/core/base.go:417:\t\tif err := app.RunSystemMigrations(); err != nil {\r\n/root/go/pkg/mod/github.com/pocketbase/pocketbase@v0.31.0/core/base.go:782:// RunSystemMigrations applies all new migrations registered in the [core.SystemMigrations] list.\r\n/root/go/pkg/mod/github.com/pocketbase/pocketbase@v0.31.0/core/base.go:783:func (app *BaseApp) RunSystemMigrations() error {\r\n/root/go/pkg/mod/github.com/pocketbase/pocketbase@v0.31.0/core/base.go:784:\t_, err := NewMigrationsRunner(app, SystemMigrations).Up()\r\n/root/go/pkg/mod/github.com/pocketbase/pocketbase@v0.31.0/core/base.go:795:// (aka. from both [core.SystemMigrations] and [core.AppMigrations]).\r\n/root/go/pkg/mod/github.com/pocketbase/pocketbase@v0.31.0/core/base.go:798:\tlist.Copy(SystemMigrations)\r\n/root/go/pkg/mod/github.com/pocketbase/pocketbase@v0.31.0/core/migrations_runner.go:15:var SystemMigrations MigrationsList\r\n"]
