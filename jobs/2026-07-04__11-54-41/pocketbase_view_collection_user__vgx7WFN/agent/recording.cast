[340.04368, "o", "\t\t\t\t\treturn err\r\n\t\t\t\t}\r\n\t\t\t}\r\n\r\n\t\t\treturn nil\r\n\t\t},\r\n\t}\r\n\r\n\treturn command\r\n}\r\n\r\nfunc (p *plugin) migrateCreateHandler(template string, args []string, interactive bool) (string, error) {\r\n\tif len(args) < 1 {\r\n\t\treturn \"\", errors.New(\"missing migration file name\")\r\n\t}\r\n\r\n"]
