[62.154667, "o", "\u001b[35m\u001b[K/root/go/pkg/mod/github.com/pocketbase/pocketbase@v0.31.0/core/view.go\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K108\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\t\t\tfield = \u001b[01;31m\u001b[KdefaultViewField\u001b[m\u001b[K(row.Name)\r\n\u001b[35m\u001b[K/root/go/pkg/mod/github.com/pocketbase/pocketbase@v0.31.0/core/view.go\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K211\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[Kfunc \u001b[01;31m\u001b[KdefaultViewField\u001b[m\u001b[K(name string) Field {\r\n\u001b[35m\u001b[K/root/go/pkg/mod/github.com/pocketbase/pocketbase@v0.31.0/core/view.go\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K311\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\t\t\tfield: \u001b[01;31m\u001b[KdefaultViewField\u001b[m\u001b[K(col.alias),\r\n\u001b[35m\u001b[K/root/go/pkg/mod/github.com/pocketbase/pocketbase@v0.31.0/core/view.go\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K332\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\t\t\tfield:      \u001b[01;31m\u001b[KdefaultViewField\u001b[m\u001b[K(col.alias),\r\n"]
