e@v0.31.0/core/collection_model_view_options_test.go:30:\t\t\t\tc.ViewQuery = \"invalid\"\r\n/root/go/pkg/mod/github.com/pocketbase/pocketbase@v0.31.0/core/collection_model_view_options_test.go:39:\t\t\t\tc.ViewQuery = \"select 1\"\r\n/root/go/pkg/mod/github.com/pocketbase/pocketbase@v0.31.0/core/collection_model_view_options_test.go:48:\t\t\t\tc.ViewQuery = \"select demo1.id, text as example from demo1\"\r\n/root/go/pkg/mod/github.com/pocketbase/pocketbase@v0.31.0/core/collection_model_view_options_test.go:57:\t\t\t\tc.ViewQuery = \"select demo1.id, text as example from demo1\"\r\n/root/go/pkg/mod/github.com/pocketbase/pocketbase@v0.31.0/core/collection_query.go:267:\t\tquery := newCollection.ViewQuery\r\n/root/go/pkg/mod/github.com/pocketbase/pocketbase@v0.31.0/core/collection_query.go:283:\t\tquery, err = normalizeViewQueryId(txApp, query)\r\n"]
