cess.exit(typeof code === \'number\' ? code : 0);\n      }, 3000);\n      if (shutdownTimer.unref) shutdownTimer.unref();\n    }\n\n    try {\n      if (typeof unsubscribe === \'function\') {\n        try {\n          unsubscribe();\n        } catch (e) {\n          process.stderr.write(\'unsubscribe error: \' + (e && e.message ? e.message : e) + \'\\n\');\n        }\n      }\n    } finally {\n      process.exit(typeof code === \'number\' ? code : 0);\n    }\n  };\n\n  // Graceful shutdown on SIGTERM/SIGINT.\n  process.on(\'SIGTERM\', () => { shutdown(0); });\n  process.on(\'SIGINT\', () => { shutdown(0); });\n\n  // Don\'t let unhandled errors/rejections kill the process silently.\n  process.on(\'uncaughtException\', (err) => {\n    process.stderr.write(\'uncaughtException: \' + (err && err.stack ? err.stack : err) + \'\\n\');\n    shutdown(1);\n  });\n  process.on(\'unhandledRejection\', (reason) => {\n    process.stderr.write(\'unhandledRejection: \' + (reason && reason.stack ? reason.stack : reason) + \'\\n\');\n  });\n\n  try {\n    await pb.admins.authWithPassword(email, password);\n  } catch (err) {\n    process.stderr.write(\'Auth failed: \' + (err && err.message ? err.message : err) + \'\\n\');\n    process.exit(1);\n  }\n\n  // Server-side filter so we only get events for the requested chat.\n  // Escape single quotes in the chat id so a malicious value can\'t break\n  // out of the filter string literal.\n  const safeChat = String(args.chat).replace(/\'/g, "\\\\\'");\n  const filter = `chat = \'${safeChat}\'`;\n\n  try {\n    unsubscribe = await pb.collection(\'messages\').subscribe(\'*\', (event) => {\n      // event.action is one of \'create\' | \'update\' | \'delete\'.\n      // event.record contains the record fields (id, chat, body, ...).\n      const payload = {\n        action: event.action,\n        record: event.record,\n      };\n      // Write a single JSON line and flush immediately so consumers can\n      // react in real-time.\n      process.stdout.write(JSON.stringify(payload) + \'\\n\');\n    }, {\n      filter: filter,\n      fields: \'id,chat,body\',\n    });\n  } catch (err) {\n    process.stderr.write(\'Subscribe failed: \' + (err && err.message ? err.message : err) + \'\\n\');\n    process.exit(1);\n  }\n\n  // Keep the process alive.\n}\n\nmain().catch((err) => {\n  process.stderr.write(\'Fatal: \' + (err && err.stack ? err.stack : err) + \'\\n\');\n  process.exit(1);\n});\nEOF\n'] min_timeout_sec: 0.2 max_timeout_sec: 180.0
