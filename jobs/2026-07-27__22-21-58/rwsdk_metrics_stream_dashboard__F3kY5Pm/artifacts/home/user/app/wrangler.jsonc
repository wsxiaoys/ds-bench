{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "metrics-dashboard-app",
  "main": "src/worker.tsx",
  "compatibility_date": "2025-08-21",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "binding": "ASSETS"
  },
  "observability": {
    "enabled": true
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "METRICS_DO",
        "class_name": "MetricsDO"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["MetricsDO"]
    }
  ],
  "vars": {}
}
