module util {
  function money_round(amount: decimal) -> decimal
    using (round(amount, 2));

  function money_round(amount: decimal, places: int64) -> decimal
    using (round(amount, places));

  function total_of(variadic amounts: decimal) -> decimal
    using (round(sum(array_unpack(amounts)), 2));

  function apply_discount(amount: decimal, pct: decimal, floor_amount: optional decimal) -> decimal
    using (
      with
        d := round(amount * (1.0n - pct / 100.0n), 2)
      select
        if exists floor_amount then
          (if d > assert_exists(floor_amount) then d else assert_exists(floor_amount))
        else
          d
    );

  function gross_with_tax(net: decimal, named only tax_pct: decimal = 0) -> decimal
    using (round(net * (1.0n + tax_pct / 100.0n), 2));

  function installments(total: decimal, count: int64) -> set of decimal
    using (
      if count < 1 then
        <decimal>{}
      else
        (
          with
            each_installment := round(total / (if count < 1 then 1 else count), 2),
            i := range_unpack(range(1, if count < 1 then 1 else count + 1))
          select
            if i < count then
              each_installment
            else
              total - (count - 1) * each_installment
        )
    );
}
