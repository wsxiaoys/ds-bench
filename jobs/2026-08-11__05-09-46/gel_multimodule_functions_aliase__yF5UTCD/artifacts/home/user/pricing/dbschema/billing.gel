module billing {
  type Customer {
    required name: str {
      constraint exclusive;
    }
    required discount_pct: decimal {
      default := 0n;
    }
  }

  type LineItem {
    required invoice: Invoice;
    required description: str;
    required qty: int64;
    required unit_price: decimal {
      constraint expression on (__subject__ = util::money_round(__subject__));
    }
    required line_total := util::money_round(<decimal>.qty * .unit_price);
  }

  type Invoice {
    required code: str {
      constraint exclusive;
    }
    required customer: Customer;
    required paid: bool {
      default := false;
    }
    minimum_charge: decimal;
    required installment_count: int64 {
      default := 1;
    }
    
    multi lines := .<invoice[is LineItem];
    
    required subtotal := util::money_round(sum(.lines.line_total));
    
    required total_due := util::apply_discount(.subtotal, .customer.discount_pct, .minimum_charge);
  }

  function customer_outstanding(customer_name: str) -> decimal {
    using (
      util::money_round(
        sum(
          (
            select Invoice
            filter .customer.name = customer_name and not .paid
          ).total_due
        )
      )
    );
    volatility := 'Stable';
  }
}
