<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Storefront Search</title>
  <style>
    body {
      font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
      background-color: #f9fafb;
      color: #374151;
      margin: 0;
      padding: 0;
    }
    .container {
      max-width: 800px;
      margin: 40px auto;
      padding: 20px;
      background: #ffffff;
      border-radius: 8px;
      box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.1), 0 2px 4px -1px rgba(0, 0, 0, 0.06);
    }
    h1 {
      font-size: 24px;
      font-weight: 700;
      color: #111827;
      margin-bottom: 24px;
      text-align: center;
    }
    .search-form {
      display: flex;
      gap: 12px;
      margin-bottom: 32px;
    }
    .search-input {
      flex: 1;
      padding: 12px 16px;
      font-size: 16px;
      border: 1px solid #d1d5db;
      border-radius: 6px;
      outline: none;
      transition: border-color 0.15s ease;
    }
    .search-input:focus {
      border-color: #3b82f6;
      box-shadow: 0 0 0 3px rgba(59, 130, 246, 0.15);
    }
    .search-button {
      padding: 12px 24px;
      font-size: 16px;
      font-weight: 600;
      color: #ffffff;
      background-color: #3b82f6;
      border: none;
      border-radius: 6px;
      cursor: pointer;
      transition: background-color 0.15s ease;
    }
    .search-button:hover {
      background-color: #2563eb;
    }
    .brand-groups {
      display: flex;
      flex-direction: column;
      gap: 24px;
    }
    .brand-group {
      border: 1px solid #e5e7eb;
      border-radius: 8px;
      background-color: #ffffff;
      overflow: hidden;
    }
    .brand-group-header {
      background-color: #f3f4f6;
      padding: 16px 20px;
      border-bottom: 1px solid #e5e7eb;
      display: flex;
      justify-content: space-between;
      align-items: center;
    }
    .brand-title {
      font-size: 18px;
      font-weight: 600;
      color: #1f2937;
      margin: 0;
    }
    .brand-total {
      font-size: 14px;
      font-weight: 500;
      color: #6b7280;
      background-color: #e5e7eb;
      padding: 4px 10px;
      border-radius: 12px;
    }
    .items-container {
      padding: 12px 20px;
      display: flex;
      flex-direction: column;
      gap: 12px;
    }
    .product-item {
      padding: 12px 16px;
      background-color: #f9fafb;
      border: 1px solid #f3f4f6;
      border-radius: 6px;
      display: flex;
      justify-content: space-between;
      align-items: center;
    }
    .product-info {
      display: flex;
      flex-direction: column;
      gap: 4px;
    }
    .product-name {
      font-size: 16px;
      font-weight: 500;
      color: #111827;
    }
    .product-meta {
      font-size: 12px;
      color: #6b7280;
    }
    .product-price {
      font-size: 16px;
      font-weight: 600;
      color: #059669;
    }
    .show-more-container {
      padding: 12px 20px;
      border-top: 1px dashed #e5e7eb;
      text-align: center;
    }
    .show-more-btn {
      background: none;
      border: none;
      color: #3b82f6;
      font-size: 14px;
      font-weight: 600;
      cursor: pointer;
      padding: 8px 16px;
      border-radius: 4px;
      transition: background-color 0.15s ease;
    }
    .show-more-btn:hover {
      background-color: #eff6ff;
      text-decoration: underline;
    }
    .pagination {
      display: flex;
      justify-content: center;
      align-items: center;
      gap: 16px;
      margin-top: 40px;
      padding-top: 20px;
      border-top: 1px solid #e5e7eb;
    }
    .pagination-btn {
      padding: 8px 16px;
      font-size: 14px;
      font-weight: 500;
      color: #374151;
      background-color: #ffffff;
      border: 1px solid #d1d5db;
      border-radius: 6px;
      text-decoration: none;
      transition: all 0.15s ease;
    }
    .pagination-btn:hover:not(.disabled) {
      background-color: #f3f4f6;
      border-color: #9ca3af;
    }
    .pagination-btn.disabled {
      color: #9ca3af;
      background-color: #f3f4f6;
      border-color: #e5e7eb;
      cursor: not-allowed;
      pointer-events: none;
    }
    .page-indicator {
      font-size: 14px;
      font-weight: 600;
      color: #374151;
    }
    .no-results {
      text-align: center;
      padding: 40px 20px;
      color: #6b7280;
      font-size: 16px;
    }
  </style>
</head>
<body>
  <div class="container">
    <h1>Product Storefront</h1>
    
    <form class="search-form" action="/" method="GET">
      <input 
        type="text" 
        name="q" 
        value="<%= q %>" 
        data-testid="search-input" 
        class="search-input" 
        placeholder="Search products by name..."
      >
      <button type="submit" class="search-button">Search</button>
    </form>

    <div class="brand-groups">
      <% if (groupedHits.length === 0) { %>
        <div class="no-results">
          No products matched your search.
        </div>
      <% } else { %>
        <% groupedHits.forEach(group => { %>
          <% 
            const brand = group.group_key[0];
            const total = group.found;
            const initialItems = group.hits.slice(0, 3);
            const remainingItems = group.hits.slice(3);
          %>
          <div 
            class="brand-group" 
            data-testid="group" 
            data-brand="<%= brand %>" 
            data-total="<%= total %>"
          >
            <div class="brand-group-header">
              <h2 class="brand-title"><%= brand %></h2>
              <span class="brand-total"><%= total %> products matched</span>
            </div>
            
            <div class="items-container">
              <% initialItems.forEach(hit => { %>
                <div 
                  class="product-item" 
                  data-testid="item" 
                  data-id="<%= hit.document.id %>"
                >
                  <div class="product-info">
                    <span class="product-name"><%= hit.document.name %></span>
                    <span class="product-meta">Popularity: <%= hit.document.popularity %></span>
                  </div>
                  <span class="product-price">$<%= hit.document.price.toFixed(2) %></span>
                </div>
              <% }) %>
            </div>

            <% if (total > 3) { %>
              <div class="show-more-container">
                <button 
                  class="show-more-btn" 
                  data-testid="show-more" 
                  onclick="showMore('<%= brand.replace(/'/g, "\\'") %>', this)"
                >
                  Show more
                </button>
              </div>
              <script type="application/json" class="remaining-items-json">
                <%- JSON.stringify(remainingItems.map(hit => hit.document)) %>
              </script>
            <% } %>
          </div>
        <% }) %>
      <% } %>
    </div>

    <div class="pagination">
      <% if (currentPage > 1) { %>
        <a 
          href="/?q=<%= encodeURIComponent(q) %>&page=<%= currentPage - 1 %>" 
          data-testid="prev-page" 
          class="pagination-btn"
        >Previous</a>
      <% } else { %>
        <span 
          data-testid="prev-page" 
          class="pagination-btn disabled"
        >Previous</span>
      <% } %>

      <span data-testid="page-indicator" class="page-indicator">
        Page <%= currentPage %>
      </span>

      <% if (currentPage < totalPages) { %>
        <a 
          href="/?q=<%= encodeURIComponent(q) %>&page=<%= currentPage + 1 %>" 
          data-testid="next-page" 
          class="pagination-btn"
        >Next</a>
      <% } else { %>
        <span 
          data-testid="next-page" 
          class="pagination-btn disabled"
        >Next</span>
      <% } %>
    </div>
  </div>

  <script>
    function showMore(brand, button) {
      const groupEl = button.closest('[data-testid="group"]');
      const itemsContainer = groupEl.querySelector('.items-container');
      const scriptEl = groupEl.querySelector('.remaining-items-json');
      
      if (!scriptEl) return;
      
      try {
        const items = JSON.parse(scriptEl.textContent);
        items.forEach(item => {
          const itemEl = document.createElement('div');
          itemEl.setAttribute('data-testid', 'item');
          itemEl.setAttribute('data-id', item.id);
          itemEl.className = 'product-item';
          itemEl.innerHTML = `
            <div class="product-info">
              <span class="product-name">\${escapeHTML(item.name)}</span>
              <span class="product-meta">Popularity: \${item.popularity}</span>
            </div>
            <span class="product-price">$\${item.price.toFixed(2)}</span>
          `;
          itemsContainer.appendChild(itemEl);
        });
        
        // Remove the show-more container
        const container = button.closest('.show-more-container');
        if (container) {
          container.remove();
        } else {
          button.remove();
        }
      } catch (err) {
        console.error('Failed to parse remaining items:', err);
      }
    }

    function escapeHTML(str) {
      return str.replace(/[&<>'"]/g, 
        tag => ({
          '&': '&amp;',
          '<': '&lt;',
          '>': '&gt;',
          "'": '&#39;',
          '"': '&quot;'
        }[tag] || tag)
      );
    }
  </script>
</body>
</html>
