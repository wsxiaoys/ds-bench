datasource db {
  provider = "sqlite"
  // Wasp requires that the url is set to the DATABASE_URL environment variable.
  url      = env("DATABASE_URL")
}

// Wasp requires the `prisma-client-js` generator to be present.
generator client {
  provider = "prisma-client-js"
}

model User {
  id       Int    @id @default(autoincrement())
  username String @unique
  password String @default("")
  role     String @default("CUSTOMER")

  createdTickets  Ticket[] @relation("CreatorTickets")
  assignedTickets Ticket[] @relation("AssigneeTickets")
}

model Ticket {
  id          Int      @id @default(autoincrement())
  title       String
  description String
  priority    String
  status      String   @default("OPEN")
  createdAt   DateTime @default(now())
  slaDeadline DateTime
  isEscalated Boolean  @default(false)

  assignee   User? @relation("AssigneeTickets", fields: [assigneeId], references: [id])
  assigneeId Int?

  creator   User @relation("CreatorTickets", fields: [creatorId], references: [id])
  creatorId Int
}
