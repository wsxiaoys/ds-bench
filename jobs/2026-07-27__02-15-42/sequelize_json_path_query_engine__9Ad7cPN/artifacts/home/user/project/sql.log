DROP TABLE IF EXISTS `Products`;
CREATE TABLE IF NOT EXISTS `Products` (`id` INTEGER PRIMARY KEY AUTOINCREMENT, `name` VARCHAR(255) NOT NULL, `attributes` JSON NOT NULL);
PRAGMA INDEX_LIST(`Products`)
INSERT INTO `Products` (`id`,`name`,`attributes`) VALUES (NULL,'Gaming Laptop','{"specs":{"ram":16,"cpu":"i7","storageGB":512},"tags":["gaming","laptop"],"dimensions":{"w":30,"h":2,"d":21},"price":1200}'),(NULL,'Server Machine','{"specs":{"ram":128,"cpu":"xeon","storageGB":4096},"tags":["server","enterprise"],"dimensions":{"w":43,"h":4,"d":60},"price":5000}'),(NULL,'Office PC','{"specs":{"ram":8,"cpu":"i3","storageGB":256},"tags":["office","desktop"],"dimensions":{"w":10,"h":30,"d":30},"price":400}');
SELECT `id`, `name`, `attributes` FROM `Products` AS `Product` WHERE json_type(attributes, '$.specs.ram') IN ('integer', 'real') AND CAST(json_extract(attributes, '$.specs.ram') AS NUMERIC) > 16 ORDER BY `Product`.`id` ASC;
SELECT `id`, `name`, `attributes` FROM `Products` AS `Product` WHERE json_type(attributes, '$.specs.ram') IN ('integer', 'real') AND CAST(json_extract(attributes, '$.specs.ram') AS NUMERIC) <= 16 ORDER BY `Product`.`id` ASC;
SELECT `id`, `name`, `attributes` FROM `Products` AS `Product` WHERE json_type(attributes, '$.specs.cpu') = 'text' AND json_extract(attributes, '$.specs.cpu') = 'i7' ORDER BY `Product`.`id` ASC;
SELECT `id`, `name`, `attributes` FROM `Products` AS `Product` WHERE json_type(attributes, '$.tags') = 'array' AND EXISTS (SELECT 1 FROM json_each(attributes, '$.tags') WHERE value = 'gaming') ORDER BY `Product`.`id` ASC;
SELECT `id`, `name`, `attributes` FROM `Products` AS `Product` WHERE `Product`.`id` = 1;
UPDATE Products SET attributes = json_set(attributes, '$.specs.ram', json('32')) WHERE id = 1
SELECT `id`, `name`, `attributes` FROM `Products` AS `Product` WHERE `Product`.`id` = 1;
