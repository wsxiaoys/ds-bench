{"type":"message-part","messageId":"df29c261-92e3-4205-a41c-c3e109b14879","role":"assistant","index":20,"part":{"type":"tool-applyDiff","toolCallId":"call_0RdNRBVf9qpPVmFj58WQAuIk","state":"output-available","input":{"path":"/home/user/project/app/components/PostList.tsx","searchContent":"'use client';\n\nimport { trpc } from '../../trpc/client';\nimport React from 'react';\n\nexport function PostList() {\n  // Use trpc.posts.list.useSuspenseInfiniteQuery here\n  return (\n    <div>\n      <h2>Posts</h2>\n      {/* Render posts and Load More button here */}\n    </div>\n  );\n}\n","replaceContent":"'use client';\n\nimport { trpc } from '../../trpc/client';\nimport React from 'react';\n\nexport function PostList() {\n  const [data, query] = trpc.posts.list.useSuspenseInfiniteQuery(\n    { limit: 5 },\n    {\n      initialCursor: 0,\n      getNextPageParam: (lastPage) => lastPage.nextCursor,\n    },\n  );\n\n  const posts = data.pages.flatMap((page) => page.items);\n  const { fetchNextPage, hasNextPage, isFetchingNextPage } = query;\n\n  return (\n    <div>\n      <h2>Posts</h2>\n      <ul>\n        {posts.map((post) => (\n          <li key={post.id}>{post.title}</li>\n        ))}\n      </ul>\n      <button\n        type=\"button\"\n        onClick={() => fetchNextPage()}\n        disabled={!hasNextPage || isFetchingNextPage}\n      >\n        Load More\n      </button>\n    </div>\n  );\n}\n"},"output":{"success":true}}}
