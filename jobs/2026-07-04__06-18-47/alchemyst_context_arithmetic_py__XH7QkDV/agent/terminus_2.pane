[?2004l[?2004h>             )
[?2004l[?2004h>         except Exception as exc:  # noqa: BLE001
[?2004l[?2004h>             print(f"[search] attempt {attempt + 1} failed: {exc}", file=sys.stderr)
[?2004l[?2004h>             time.sleep(1.5)
[?2004l[?2004h>             continue
[?2004l[?2004h> 
[?2004l[?2004h>         last_response = response
[?2004l[?2004h>         contexts = getattr(response, "contexts", None) or []
[?2004l[?2004h>         run_contexts = [
