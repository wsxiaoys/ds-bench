[?2004l[?2004h> #!/usr/bin/env python3
[?2004l[?2004h> """
[?2004l[?2004h> Context Arithmetic (Intersection) demo CLI using Alchemyst AI Python SDK.
[?2004l[?2004h> 
[?2004l[?2004h> On every invocation this CLI:
[?2004l[?2004h> 1. Reads the per-run id from /logs/artifacts/run-id.
[?2004l[?2004h> 2. Removes any documents previously ingested under that run id (idempotent reruns).
[?2004l[?2004h> 3. Ingests 3 documents whose `group_name` arrays overlap so the intersection
[?2004l[?2004h>    semantics of Context Arithmetic can be verified.
[?2004l[?2004h> 4. Performs `client.v1.context.search(...)` filtered by
[?2004l[?2004h>    `body_metadata={"group_name": [<groups from --groups>]}` and prints the
[?2004l[?2004h>    matching documents as a single JSON array to stdout.
[?2004l[?2004h> """
[?2004l[?2004h> 
[?2004l[?2004h> from __future__ import annotations
[?2004l[?2004h> 
[?2004l[?2004h> import argparse
[?2004l[?2004h> import datetime as _dt
[?2004l[?2004h> import json
[?2004l[?2004h> import os
[?2004l[?2004h> import sys
[?2004l[?2004h> import time
[?2004l[?2004h> from pathlib import Path
[?2004l[?2004h> from typing import Any, Dict, List
[?2004l[?2004h> 
[?2004l[?2004h> from alchemyst_ai import AlchemystAI
[?2004l[?2004h> 
[?2004l[?2004h> RUN_ID_FILE = Path("/logs/artifacts/run-id")
[?2004l[?2004h> 
[?2004l[?2004h> 
[?2004l[?2004h> def read_run_id() -> str:
[?2004l[?2004h>     return RUN_ID_FILE.read_text().strip()
[?2004l[?2004h> 
[?2004l[?2004h> 
[?2004l[?2004h> def parse_args() -> List[str]:
[?2004l[?2004h>     parser = argparse.ArgumentParser(
[?2004l[?2004h>         description="Demonstrate Context Arithmetic (group_name intersection)."
[?2004l[?2004h>     )
[?2004l[?2004h>     parser.add_argument(
[?2004l[?2004h>         "--groups",
[?2004l[?2004h>         nargs="+",
[?2004l[?2004h>         required=True,
[?2004l[?2004h>         help="One or more group names to AND-filter on (intersection semantics).",
[?2004l[?2004h>     )
[?2004l[?2004h>     return list(parser.parse_args().groups)
[?2004l[?2004h> 
[?2004l[?2004h> 
[?2004l[?2004h> def make_client() -> AlchemystAI:
[?2004l[?2004h>     api_key = os.environ.get("ALCHEMYST_AI_API_KEY")
[?2004l[?2004h>     if not api_key:
[?2004l[?2004h>         print(
[?2004l[?2004h>             "ERROR: ALCHEMYST_AI_API_KEY environment variable is not set.",
[?2004l[?2004h>             file=sys.stderr,
[?2004l[?2004h>         )
[?2004l[?2004h>         sys.exit(1)
[?2004l[?2004h>     return AlchemystAI(api_key=api_key)
[?2004l[?2004h> 
[?2004l[?2004h> 
[?2004l[?2004h> def build_documents(run_id: str, last_modified: str) -> List[Dict[str, Any]]:
[?2004l[?2004h>     """Build the three overlapping documents."""
[?2004l[?2004h>     docs = [
[?2004l[?2004h>         {
[?2004l[?2004h>             "content": (
[?2004l[?2004h>                 f"# Document A ({run_id})\n\n"
[?2004l[?2004h>                 "Engineering v1 release notes: new deployment pipeline, "
[?2004l[?2004h>                 "observability dashboards, and on-call rotations for the "
[?2004l[?2004h>                 "platform team. Marker: docA."
[?2004l[?2004h>             ),
[?2004l[?2004h>             "metadata": {
[?2004l[?2004h>                 "file_name": f"docA-{run_id}.md",
[?2004l[?2004h>                 "file_size": 1.0,
[?2004l[?2004h>                 "file_type": "text/markdown",
[?2004l[?2004h>                 "last_modified": last_modified,
[?2004l[?2004h>                 "group_name": ["eng", "v1"],
[?2004l[?2004h>             },
[?2004l[?2004h>         },
[?2004l[?2004h>         {
[?2004l[?2004h>             "content": (
[?2004l[?2004h>                 f"# Document B ({run_id})\n\n"
[?2004l[?2004h>                 "Engineering v2 changelog: refactored auth, switched to the new "
[?2004l[?2004h>                 "build system, upgraded the database driver. Marker: docB."
[?2004l[?2004h>             ),
[?2004l[?2004h>             "metadata": {
[?2004l[?2004h>                 "file_name": f"docB-{run_id}.md",
[?2004l[?2004h>                 "file_size": 1.0,
[?2004l[?2004h>                 "file_type": "text/markdown",
[?2004l[?2004h>                 "last_modified": last_modified,
[?2004l[?2004h>                 "group_name": ["eng", "v2"],
[?2004l[?2004h>             },
[?2004l[?2004h>         },
[?2004l[?2004h>         {
[?2004l[?2004h>             "content": (
[?2004l[?2004h>                 f"# Document C ({run_id})\n\n"
[?2004l[?2004h>                 "Public-facing docs v1: user guide, installation, and FAQ for "
[?2004l[?2004h>                 "the initial GA release. Marker: docC."
[?2004l[?2004h>             ),
[?2004l[?2004h>             "metadata": {
[?2004l[?2004h>                 "file_name": f"docC-{run_id}.md",
[?2004l[?2004h>                 "file_size": 1.0,
[?2004l[?2004h>                 "file_type": "text/markdown",
[?2004l[?2004h>                 "last_modified": last_modified,
[?2004l[?2004h>                 "group_name": ["docs", "v1"],
[?2004l[?2004h>             },
[?2004l[?2004h>         },
[?2004l[?2004h>     ]
[?2004l[?2004h>     return docs
[?2004l[?2004h> 
[?2004l[?2004h> 
[?2004l[?2004h> def ingest_documents(client: AlchemystAI, run_id: str, source: str) -> None:
[?2004l[?2004h>     """Delete any previously-ingested docs for this run, then add the three docs."""
[?2004l[?2004h>     last_modified = _dt.datetime.utcnow().isoformat() + "Z"
[?2004l[?2004h> 
[?2004l[?2004h>     # Best-effort cleanup so reruns with the same run-id don't 409.
[?2004l[?2004h>     for fname in (
[?2004l[?2004h>         f"docA-{run_id}.md",
[?2004l[?2004h>         f"docB-{run_id}.md",
[?2004l[?2004h>         f"docC-{run_id}.md",
[?2004l[?2004h>     ):
[?2004l[?2004h>         try:
[?2004l[?2004h>             client.v1.context.delete(
[?2004l[?2004h>                 organization_id="default",
[?2004l[?2004h>                 source=source,
[?2004l[?2004h>                 by_doc=True,
[?2004l[?2004h>                 user_id=fname,
[?2004l[?2004h>             )
[?2004l[?2004h>         except Exception as exc:  # noqa: BLE001
[?2004l[?2004h>             print(f"[cleanup] delete {fname}: {exc}", file=sys.stderr)
[?2004l[?2004h> 
[?2004l[?2004h>     documents = build_documents(run_id, last_modified)
[?2004l[?2004h> 
[?2004l[?2004h>     # Try batch add first; if any failure, fall back to per-doc ingestion.
[?2004l[?2004h>     batch_meta = {
[?2004l[?2004h>         "file_name": f"batch-{run_id}.md",
[?2004l[?2004h>         "file_size": 1.0,
[?2004l[?2004h>         "file_type": "text/markdown",
[?2004l[?2004h>         "last_modified": last_modified,
[?2004l[?2004h>         "group_name": ["eng", "v1", "v2", "docs"],
[?2004l[?2004h>     }
[?2004l[?2004h>     try:
[?2004l[?2004h>         client.v1.context.add(
[?2004l[?2004h>             context_type="resource",
[?2004l[?2004h>             documents=documents,
[?2004l[?2004h>             scope="internal",
[?2004l[?2004h>             source=source,
[?2004l[?2004h>             metadata=batch_meta,
[?2004l[?2004h>         )
[?2004l[?2004h>         print(f"[ingest] batch add ok ({len(documents)} docs)", file=sys.stderr)
[?2004l[?2004h>     except Exception as exc:  # noqa: BLE001
[?2004l[?2004h>         print(
[?2004l[?2004h>             f"[ingest] batch add failed ({exc}); falling back to per-doc",
[?2004l[?2004h>             file=sys.stderr,
[?2004l[?2004h>         )
[?2004l[?2004h>         for doc in documents:
[?2004l[?2004h>             try:
[?2004l[?2004h>                 client.v1.context.add(
[?2004l[?2004h>                     context_type="resource",
[?2004l[?2004h>                     documents=[doc],
[?2004l[?2004h>                     scope="internal",
[?2004l[?2004h>                     source=source,
[?2004l[?2004h>                     metadata=doc["metadata"],
[?2004l[?2004h>                 )
[?2004l[?2004h>             except Exception as inner_exc:  # noqa: BLE001
[?2004l[?2004h>                 print(
[?2004l[?2004h>                     f"[ingest] per-doc add failed for "
[?2004l[?2004h>                     f"{doc['metadata'].get('file_name')}: {inner_exc}",
[?2004l[?2004h>                     file=sys.stderr,
[?2004l[?2004h>                 )
[?2004l[?2004h> 
[?2004l[?2004h> 
[?2004l[?2004h> def run_search(
[?2004l[?2004h>     client: AlchemystAI, groups: List[str], source: str, run_id: str
[?2004l[?2004h> ) -> List[Dict[str, Any]]:
[?2004l[?2004h>     """Perform the filtered search and return deduplicated matches."""
[?2004l[?2004h>     query = (
[?2004l[?2004h>         "engineering platform deployment release notes and public "
[?2004l[?2004h>         "documentation user guide"
[?2004l[?2004h>     )
[?2004l[?2004h> 
[?2004l[?2004h>     expected_files = {
[?2004l[?2004h>         f"docA-{run_id}.md",
[?2004l[?2004h>         f"docB-{run_id}.md",
[?2004l[?2004h>         f"docC-{run_id}.md",
[?2004l[?2004h>     }
[?2004l[?2004h> 
[?2004l[?2004h>     matches: List[Dict[str, Any]] = []
[?2004l[?2004h>     seen: set[str] = set()
[?2004l[?2004h>     last_response: Any = None
[?2004l[?2004h> 
[?2004l[?2004h>     # Short bounded retry loop: vector indexing can take a moment to settle.
[?2004l[?2004h>     for attempt in range(8):
[?2004l[?2004h>         try:
[?2004l[?2004h>             response = client.v1.context.search(
[?2004l[?2004h>                 query=query,
[?2004l[?2004h>                 minimum_similarity_threshold=0.1,
[?2004l[?2004h>                 similarity_threshold=0.99,
[?2004l[?2004h>                 metadata="true",
[?2004l[?2004h>                 body_metadata={"group_name": groups},
[?2004l[?2004h>                 scope="internal",
[?2004l[?2004h>                 user_id=source,
[?2004l[?2004h>             )
[?2004l[?2004h>         except Exception as exc:  # noqa: BLE001
[?2004l[?2004h>             print(f"[search] attempt {attempt + 1} failed: {exc}", file=sys.stderr)
[?2004l[?2004h>             time.sleep(1.5)
[?2004l[?2004h>             continue
[?2004l[?2004h> 
[?2004l[?2004h>         last_response = response
[?2004l[?2004h>         contexts = getattr(response, "contexts", None) or []
[?2004l[?2004h>         # Filter to only documents that belong to this run id (namespace safety).
[?2004l[?2004h>         run_contexts = [
[?2004l[?2004h>             c for c in contexts
[?2004l[?2004h>             if _ctx_file_name(c) in expected_files
[?2004l[?2004h>         ]
[?2004l[?2004h>         if run_contexts:
[?2004l[?2004h>             break
[?2004l[?2004h>         time.sleep(1.5)
[?2004l[?2004h> 
[?2004l[?2004h>     if last_response is not None:
[?2004l[?2004h>         contexts = getattr(last_response, "contexts", None) or []
[?2004l[?2004h>         for ctx in contexts:
[?2004l[?2004h>             fn = _ctx_file_name(ctx)
[?2004l[?2004h>             if fn in expected_files and fn not in seen:
[?2004l[?2004h>                 seen.add(fn)
[?2004l[?2004h>                 matches.append({"file_name": fn})
[?2004l[?2004h> 
[?2004l[?2004h>     return matches
[?2004l[?2004h> 
[?2004l[?2004h> 
[?2004l[?2004h> def _ctx_file_name(ctx: Any) -> str:
[?2004l[?2004h>     meta = getattr(ctx, "metadata", None)
[?2004l[?2004h>     if meta is None:
[?2004l[?2004h>         return ""
[?2004l[?2004h>     if hasattr(meta, "model_dump"):
[?2004l[?2004h>         meta = meta.model_dump()
[?2004l[?2004h>     elif hasattr(meta, "dict"):
[?2004l[?2004h>         meta = meta.dict()
[?2004l[?2004h>     if not isinstance(meta, dict):
[?2004l[?2004h>         return ""
[?2004l[?2004h>     return meta.get("file_name") or meta.get("fileName") or ""
[?2004l[?2004h> 
[?2004l[?2004h> 
[?2004l[?2004h> def main() -> int:
[?2004l[?2004h>     groups = parse_args()
[?2004l[?2004h>     run_id = read_run_id()
[?2004l[?2004h>     source = f"docs-{run_id}"
[?2004l[?2004h> 
[?2004l[?2004h>     print(f"[start] run_id={run_id} groups={groups} source={source}", file=sys.stderr)
[?2004l[?2004h> 
[?2004l[?2004h>     client = make_client()
[?2004l[?2004h>     ingest_documents(client, run_id=run_id, source=source)
[?2004l[?2004h>     matches = run_search(client, groups=groups, source=source, run_id=run_id)
[?2004l[?2004h> 
[?2004l[?2004h>     # Final JSON array on the last line of stdout.
[?2004l[?2004h>     sys.stdout.write(json.dumps(matches, indent=2))
[?2004l[?2004h>     sys.stdout.write("\n")
[?2004l[?2004h>     return 0
[?2004l[?2004h> 
[?2004l[?2004h> 
[?2004l[?2004h> if __name__ == "__main__":
[?2004l[?2004h>     raise SystemExit(main())
