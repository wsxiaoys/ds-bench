[?2004l[?2004h> def run_search(
[?2004l[?2004h>     client: AlchemystAI, groups: List[str], source: str, run_id: str
[?2004l[?2004h> ) -> List[Dict[str, Any]]:
[?2004l[?2004h>     """Perform the filtered search and return deduplicated matches."""
[?2004l[?2004h>     query = (
[?2004l[?2004h>         "engineering v1 v2 deployment pipeline observability platform team "
[?2004l[?2004h>         "docs user guide installation FAQ changelog"
[?2004l[?2004h>     )
[?2004l[?2004h> 
[?2004l[?2004h>     expected_files = {
