[?2004l[?2004h>             )
[?2004l[?2004h>         except Exception as exc:  # noqa: BLE001
[?2004l[?2004h>             print(f"[cleanup] delete {fname}: {exc}", file=sys.stderr)
[?2004l[?2004h> 
[?2004l[?2004h>     documents = build_documents(run_id, last_modified)
[?2004l[?2004h> 
[?2004l[?2004h>     # Add each document INDIVIDUALLY so each keeps its own per-document
[?2004l[?2004h>     # metadata (file_name + group_name). Batching collapses them onto the
