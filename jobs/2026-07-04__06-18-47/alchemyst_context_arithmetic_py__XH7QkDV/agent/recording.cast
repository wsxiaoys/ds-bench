[351.42819, "i", "cd /home/user/myproject && python3 -c \"\nimport os\nfrom alchemyst_ai import AlchemystAI\nc = AlchemystAI(api_key=os.environ['ALCHEMYST_AI_API_KEY'])\n# Search for docA-specific content\nr = c.v1.context.search(\n    query='Marker: docA. observability dashboards on-call rotations',\n    minimum_similarity_threshold=0.0,\n    similarity_threshold=1.0,\n    metadata='true',\n    scope='internal',\n    user_id='docs-zrthdq6dz6',\n)\nprint('contexts:', len(r.contexts or []))\nfor ctx in (r.contexts or [])[:5]:\n    print('---')\n    print('file_name:', ctx.metadata.get('file_name') if ctx.metadata else None)\n    print('group_name:', ctx.metadata.get('group_name') if ctx.metadata else None)\n    print('content:', (ctx.content or '')[:200])\n    print('score:', ctx.score)\n\" 2>&1 | tail -30\n"]
