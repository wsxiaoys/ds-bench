[392.880258, "i", "cat > /home/user/myproject/main.py << 'PYEOF'\n#!/usr/bin/env python3\n\"\"\"\nContext Arithmetic (Intersection) demo CLI using Alchemyst AI Python SDK.\n\nOn every invocation this CLI:\n1. Reads the per-run id from /logs/artifacts/run-id.\n2. Removes any documents previously ingested under that run id (idempotent reruns).\n3. Ingests 3 documents whose `group_name` arrays overlap so the intersection\n   semantics of Context Arithmetic can be verified.\n4. Performs `client.v1.context.search(...)` filtered by\n   `body_metadata={\"group_name\": [<groups from --groups>]}` and prints the\n   matching documents as a single JSON array to stdout.\n\"\"\"\n\nfrom __future__ import annotations\n\nimport argparse\nimport datetime as _dt\nimport json\nimport os\nimport sys\nimport time\nfrom pathlib import Path\nfrom typing import Any, Dict, List\n\nfrom alchemyst_ai import AlchemystAI\n\nRUN_ID_FILE = Path(\"/logs/artifacts/run-id\")\n\n\ndef read_run_id() -> str:\n    return RUN_ID_FILE.read_text().strip()\n\n\ndef parse_args() -> List[str]:\n    parser = argparse.ArgumentParser(\n        description=\"Demonstrate Context Arithmetic (group_name intersection).\"\n    )\n    parser.add_argument(\n        \"--groups\",\n        nargs=\"+\",\n        required=True,\n        help=\"One or more group names to AND-filter on (intersection semantics).\",\n    )\n    return list(parser.parse_args().groups)\n\n\ndef make_client() -> AlchemystAI:\n    api_key = os.environ.get(\"ALCHEMYST_AI_API_KEY\")\n    if not api_key:\n        print(\n            \"ERROR: ALCHEMYST_AI_API_KEY environment variable is not set.\",\n            file=sys.stderr,\n        )\n        sys.exit(1)\n    return AlchemystAI(api_key=api_key)\n\n\ndef build_documents(run_id: str, last_modified: str) -> List[Dict[str, Any]]:\n    \"\"\"Build the three overlapping documents.\"\"\"\n    docs = [\n        {\n            \"content\": (\n                f\"# Document A ({run_id})\\n\\n\"\n                \"Engineering v1 release notes: new deployment pipeline, \"\n                \"observability dashboards, and on-call rotations for the \"\n                \"platform team. Marker: docA.\"\n            ),\n            \"metadata\": {\n                \"file_name\": f\"docA-{run_id}.md\",\n                \"file_size\": 1.0,\n                \"file_type\": \"text/markdown\",\n                \"last_modified\": last_modified,\n                \"group_name\": [\"eng\", \"v1\"],\n            },\n        },\n        {\n            \"content\": (\n                f\"# Document B ({run_id})\\n\\n\"\n                \"Engineering v2 changelog: refactored auth, switched to the new \"\n                \"build system, upgraded the database driver. Marker: docB.\"\n            ),\n            \"metadata\": {\n                \"file_name\": f\"docB-{run_id}.md\",\n                \"file_size\": 1.0,\n                \"file_type\": \"text/markdown\",\n                \"last_modified\": last_modified,\n                \"group_name\": [\"eng\", \"v2\"],\n            },\n        },\n        {\n            \"content\": (\n                f\"# Document C ({run_id})\\n\\n\"\n                \"Public-facing docs v1: user guide, installation, and FAQ for \"\n                \"the initial GA release. Marker: docC.\"\n            ),\n            \"metadata\": {\n                \"file_name\": f\"docC-{run_id}.md\",\n                \"file_size\": 1.0,\n                \"file_type\": \"text/markdown\",\n                \"last_modified\": last_modified,\n                \"group_name\": [\"docs\", \"v1\"],\n            },\n        },\n    ]\n    return docs\n\n\ndef ingest_documents(client: AlchemystAI, run_id: str, source: str) -> None:\n    \"\"\"Delete any previously-ingested docs for this run, then add the three docs.\"\"\"\n    last_modified = (\n        _dt.datetime.now(_dt.timezone.utc).isoformat().replace(\"+00:00\", \"Z\")\n    )\n\n    # Clean up previous run's docs (including the stale batch envelope).\n    cleanup_targets = [\n        f\"docA-{run_id}.md\",\n        f\"docB-{run_id}.md\",\n        f\"docC-{run_id}.md\",\n        f\"batch-{run_id}.md\",\n    ]\n    for fname in cleanup_targets:\n        try:\n            client.v1.context.delete(\n                organization_id=\"default\",\n                source=source,\n                by_doc=True"]
[392.880448, "i", ",\n                user_id=fname,\n            )\n        except Exception as exc:  # noqa: BLE001\n            print(f\"[cleanup] delete {fname}: {exc}\", file=sys.stderr)\n\n    documents = build_documents(run_id, last_modified)\n\n    # Add each document INDIVIDUALLY so each keeps its own per-document\n    # metadata (file_name + group_name). Batching collapses them onto the\n    # top-level metadata envelope.\n    for doc in documents:\n        ok = False\n        for attempt in range(3):\n            try:\n                client.v1.context.add(\n                    context_type=\"resource\",\n                    documents=[doc],\n                    scope=\"internal\",\n                    source=source,\n                    metadata=doc[\"metadata\"],\n                )\n                ok = True\n                break\n            except Exception as exc:  # noqa: BLE001\n                print(\n                    f\"[ingest] {doc['metadata']['file_name']} attempt \"\n                    f\"{attempt + 1} failed: {exc}\",\n                    file=sys.stderr,\n                )\n                # 409 conflict: try deleting and re-adding.\n                try:\n                    client.v1.context.delete(\n                        organization_id=\"default\",\n                        source=source,\n                        by_doc=True,\n                        user_id=doc[\"metadata\"][\"file_name\"],\n                    )\n                except Exception:  # noqa: BLE001\n                    pass\n                time.sleep(1.0)\n        if ok:\n            print(f\"[ingest] added {doc['metadata']['file_name']}\", file=sys.stderr)\n\n\ndef run_search(\n    client: AlchemystAI, groups: List[str], source: str, run_id: str\n) -> List[Dict[str, Any]]:\n    \"\"\"Perform the filtered search and return deduplicated matches.\"\"\"\n    query = (\n        \"engineering v1 v2 deployment pipeline observability platform team \"\n        \"docs user guide installation FAQ changelog\"\n    )\n\n    expected_files = {\n        f\"docA-{run_id}.md\",\n        f\"docB-{run_id}.md\",\n        f\"docC-{run_id}.md\",\n    }\n\n    matches: List[Dict[str, Any]] = []\n    seen: set[str] = set()\n    last_response: Any = None\n\n    # Short bounded retry loop: vector indexing can take a moment to settle.\n    for attempt in range(8):\n        try:\n            response = client.v1.context.search(\n                query=query,\n                minimum_similarity_threshold=0.0,\n                similarity_threshold=1.0,\n                metadata=\"true\",\n                body_metadata={\"group_name\": groups},\n                scope=\"internal\",\n                user_id=source,\n            )\n        except Exception as exc:  # noqa: BLE001\n            print(f\"[search] attempt {attempt + 1} failed: {exc}\", file=sys.stderr)\n            time.sleep(1.5)\n            continue\n\n        last_response = response\n        contexts = getattr(response, \"contexts\", None) or []\n        run_contexts = [\n            c for c in contexts if _ctx_file_name(c) in expected_files\n        ]\n        if run_contexts:\n            break\n        time.sleep(1.5)\n\n    if last_response is not None:\n        contexts = getattr(last_response, \"contexts\", None) or []\n        for ctx in contexts:\n            fn = _ctx_file_name(ctx)\n            if fn in expected_files and fn not in seen:\n                seen.add(fn)\n                matches.append({\"file_name\": fn})\n\n    return matches\n\n\ndef _ctx_file_name(ctx: Any) -> str:\n    meta = getattr(ctx, \"metadata\", None)\n    if meta is None:\n        return \"\"\n    if hasattr(meta, \"model_dump\"):\n        meta = meta.model_dump()\n    elif hasattr(meta, \"dict\"):\n        meta = meta.dict()\n    if not isinstance(meta, dict):\n        return \"\"\n    return meta.get(\"file_name\") or meta.get(\"fileName\") or \"\"\n\n\ndef main() -> int:\n    groups = parse_args()\n    run_id = read_run_id()\n    source = f\"docs-{run_id}\"\n\n    print(f\"[start] run_id={run_id} groups={groups} source={source}\", file=sys.stderr)\n\n    client = make_client()\n    ingest_documents(client, run_id=run_id, source=source)\n    matches = run_search(client, groups=groups, source=source, run_i"]
[392.88053, "i", "d=run_id)\n\n    # Final JSON array on the last line of stdout.\n    sys.stdout.write(json.dumps(matches, indent=2))\n    sys.stdout.write(\"\\n\")\n    return 0\n\n\nif __name__ == \"__main__\":\n    raise SystemExit(main())\nPYEOF\n"]
