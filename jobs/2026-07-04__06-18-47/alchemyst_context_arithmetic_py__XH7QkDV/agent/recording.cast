[392.889218, "o", "\u001b[?2004h> "]
[392.889371, "o", "                \"file_type\": \"text/markdown\",\r\n\u001b[?2004l\r"]
[392.889419, "o", "\u001b[?2004h> "]
[392.889567, "o", "                \"last_modified\": last_modified,\r\n\u001b[?2004l\r"]
[392.889611, "o", "\u001b[?2004h> "]
[392.889757, "o", "                \"group_name\": [\"eng\", \"v2\"],\r\n\u001b[?2004l\r\u001b[?2004h"]
[392.889811, "o", ">             },\r\n\u001b[?2004l\r"]
[392.889853, "o", "\u001b[?2004h> "]
[392.889897, "o", "        },\r\n\u001b[?2004l\r\u001b[?2004h> "]
[392.889939, "o", "        {\r\n\u001b[?2004l\r"]
[392.889984, "o", "\u001b[?2004h> "]
[392.890063, "o", "            \"content\": (\r\n\u001b[?2004l\r"]
[392.890111, "o", "\u001b[?2004h> "]
[392.890237, "o", "                f\"# Document C ({run_id})\\n\\n\"\r\n\u001b[?2004l\r"]
[392.890289, "o", "\u001b[?2004h> "]
[392.890546, "o", "                \"Public-facing docs v1: user guide, installation, and FAQ for \"\r\n\u001b[?2004l\r"]
[392.890598, "o", "\u001b[?2004h> "]
[392.890772, "o", "                \"the initial GA release. Marker: docC.\"\r\n\u001b[?2004l\r"]
[392.890822, "o", "\u001b[?2004h> "]
[392.890872, "o", "            ),\r\n\u001b[?2004l\r\u001b[?2004h> "]
[392.890958, "o", "            \"metadata\": {\r\n\u001b[?2004l\r"]
[392.891002, "o", "\u001b[?2004h> "]
[392.89118, "o", "                \"file_name\": f\"docC-{run_id}.md\",\r\n\u001b[?2004l\r"]
[392.891232, "o", "\u001b[?2004h> "]
[392.8913, "o", "                \"file_size\": 1.0,\r\n\u001b[?2004l\r"]
[392.891344, "o", "\u001b[?2004h> "]
[392.891499, "o", "                \"file_type\": \"text/markdown\",\r\n\u001b[?2004l\r"]
[392.891548, "o", "\u001b[?2004h> "]
[392.891677, "o", "                \"last_modified\": last_modified,\r\n\u001b[?2004l\r"]
[392.891721, "o", "\u001b[?2004h> "]
[392.891869, "o", "                \"group_name\": [\"docs\", \"v1\"],\r\n\u001b[?2004l\r"]
[392.891916, "o", "\u001b[?2004h> "]
[392.891961, "o", "            },\r\n\u001b[?2004l\r\u001b[?2004h> "]
[392.892013, "o", "        },\r\n\u001b[?2004l\r"]
[392.892058, "o", "\u001b[?2004h>     ]\r\n\u001b[?2004l\r"]
[392.892102, "o", "\u001b[?2004h> "]
[392.892151, "o", "    return docs\r\n\u001b[?2004l\r"]
[392.892191, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[392.892235, "o", "\u001b[?2004h> "]
[392.892517, "o", "def ingest_documents(client: AlchemystAI, run_id: str, source: str) -> None:\r\n\u001b[?2004l\r"]
[392.892594, "o", "\u001b[?2004h> "]
[392.892834, "o", "    \"\"\"Delete any previously-ingested docs for this run, then add the three docs.\"\"\"\r\n\u001b[?2004l\r"]
[392.892873, "o", "\u001b[?2004h> "]
[392.892915, "o", "    last_modified = (\r\n\u001b[?2004l\r"]
[392.892947, "o", "\u001b[?2004h> "]
[392.893142, "o", "        _dt.datetime.now(_dt.timezone.utc).isoformat().replace(\"+00:00\", \"Z\")\r\n\u001b[?2004l\r"]
[392.893176, "o", "\u001b[?2004h>     )\r\n\u001b[?2004l\r"]
[392.893195, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r "]
[392.893214, "o", "\u001b[?2004h> "]
[392.893485, "o", "    # Clean up previous run's docs (including the stale batch envelope).\r\n\u001b[?2004l\r"]
[392.893519, "o", "\u001b[?2004h> "]
[392.893585, "o", "    cleanup_targets = [\r\n\u001b[?2004l\r"]
[392.893602, "o", "\u001b[?2004h> "]
[392.89372, "o", "        f\"docA-{run_id}.md\",\r\n\u001b[?2004l\r"]
[392.893738, "o", "\u001b[?2004h> "]
[392.893832, "o", "        f\"docB-{run_id}.md\",\r\n\u001b[?2004l\r"]
[392.893862, "o", "\u001b[?2004h> "]
[392.893966, "o", "        f\"docC-{run_id}.md\",\r\n\u001b[?2004l\r"]
[392.893995, "o", "\u001b[?2004h> "]
[392.894095, "o", "        f\"batch-{run_id}.md\",\r\n\u001b[?2004l\r"]
[392.894125, "o", "\u001b[?2004h> "]
[392.894144, "o", "    ]\r\n\u001b[?2004l\r\u001b[?2004h"]
[392.89416, "o", "> "]
[392.894249, "o", "    for fname in cleanup_targets:\r\n\u001b[?2004l\r"]
[392.894279, "o", "\u001b[?2004h> "]
[392.894299, "o", "        try:\r\n\u001b[?2004l\r"]
[392.894313, "o", "\u001b[?2004h> "]
[392.89442, "o", "            client.v1.context.delete(\r\n\u001b[?2004l\r\u001b[?2004h"]
[392.894439, "o", "> "]
[392.894575, "o", "                organization_id=\"default\",\r\n\u001b[?2004l\r"]
[392.894606, "o", "\u001b[?2004h> "]
[392.89471, "o", "                source=source,\r\n\u001b[?2004l\r"]
[392.89474, "o", "\u001b[?2004h> "]
[392.894846, "o", "                by_doc=True,\r\n\u001b[?2004l\r"]
[392.894876, "o", "\u001b[?2004h> "]
[392.894987, "o", "                user_id=fname,\r\n\u001b[?2004l\r"]
[392.895016, "o", "\u001b[?2004h> "]
[392.895063, "o", "            )\r\n\u001b[?2004l\r"]
[392.895092, "o", "\u001b[?2004h> "]
[392.895294, "o", "        except Exception as exc:  # noqa: BLE001\r\n\u001b[?2004l\r"]
[392.895313, "o", "\u001b[?2004h> "]
[392.895622, "o", "            print(f\"[cleanup] delete {fname}: {exc}\", file=sys.stderr)\r\n\u001b[?2004l\r"]
[392.895641, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[392.895659, "o", "\u001b[?2004h> "]
[392.895856, "o", "    documents = build_documents(run_id, last_modified)\r\n\u001b[?2004l\r"]
[392.895877, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[392.89608, "o", "> "]
[392.896119, "o", "    # Add each document INDIVIDUALLY so each keeps its own per-document\r\n\u001b[?2004l\r\u001b[?2004h> "]
[392.896298, "o", "    # metadata (file_name + group_name). Batching collapses them onto the\r\n\u001b[?2004l\r\u001b[?2004h"]
[392.896336, "o", "> "]
[392.896452, "o", "    # top-level metadata envelope.\r\n\u001b[?2004l\r\u001b[?2004h> "]
[392.896527, "o", "    for doc in documents:\r\n\u001b[?2004l\r"]
[392.896576, "o", "\u001b[?2004h> "]
[392.896625, "o", "        ok = False\r\n\u001b[?2004l\r\u001b[?2004h> "]
[392.896747, "o", "        for attempt in range(3):\r\n\u001b[?2004l\r"]
[392.896792, "o", "\u001b[?2004h> "]
[392.896835, "o", "            try:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[392.896899, "o", "                client.v1.context.add(\r\n\u001b[?2004l\r\u001b[?2004h> "]
[392.896972, "o", "                    context_type=\"resource\",\r\n\u001b[?2004l\r\u001b[?2004h> "]
[392.897031, "o", "                    documents=[doc],\r\n\u001b[?2004l\r\u001b[?2004h> "]
[392.897093, "o", "                    scope=\"internal\",\r\n\u001b[?2004l\r\u001b[?2004h> "]
[392.897141, "o", "                    source=source,\r\n\u001b[?2004l\r\u001b[?2004h"]
[392.897197, "o", "> "]
[392.897213, "o", "                    metadata=doc[\"metadata\"],\r\n\u001b[?2004l\r"]
[392.897259, "o", "\u001b[?2004h>                 )\r\n\u001b[?2004l\r"]
[392.897286, "o", "\u001b[?2004h> "]
[392.897316, "o", "                ok = True\r\n\u001b[?2004l\r"]
[392.897342, "o", "\u001b[?2004h> "]
[392.897364, "o", "                break\r\n\u001b[?2004l\r\u001b[?2004h> "]
[392.897462, "o", "            except Exception as exc:  # noqa: BLE001\r\n\u001b[?2004l\r\u001b[?2004h> "]
[392.897514, "o", "                print(\r\n\u001b[?2004l\r\u001b[?2004h"]
[392.897551, "o", "> "]
[392.897584, "o", "                    f\"[ingest] {doc['metadata']['file_name']} attempt \"\r\n\u001b[?2004l\r\u001b[?2004h> "]
[392.897644, "o", "                    f\"{attempt + 1} failed: {exc}\",\r\n\u001b[?2004l\r"]
[392.897675, "o", "\u001b[?2004h> "]
[392.897711, "o", "                    file=sys.stderr,\r\n\u001b[?2004l\r\u001b[?2004h> "]
[392.897746, "o", "                )\r\n\u001b[?2004l\r\u001b[?2004h"]
[392.897756, "o", "> "]
[392.897821, "o", "                # 409 conflict: try deleting and re-adding.\r\n\u001b[?2004l\r"]
[392.897847, "o", "\u001b[?2004h> "]
[392.897887, "o", "                try:\r\n\u001b[?2004l\r\u001b[?2004h"]
[392.8979, "o", "> "]
[392.897952, "o", "                    client.v1.context.delete(\r\n\u001b[?2004l\r\u001b[?2004h> "]
[392.897994, "o", "                        organization_id=\"default\",\r\n\u001b[?2004l\r"]
[392.898025, "o", "\u001b[?2004h> "]
[392.898063, "o", "                        source=source,\r\n\u001b[?2004l\r\u001b[?2004h"]
[392.898076, "o", "> "]
[392.898128, "o", "                        by_doc=True,\r\n\u001b[?2004l\r\u001b[?2004h> "]
[392.898208, "o", "                        user_id=doc[\"metadata\"][\"file_name\"],\r\n\u001b[?2004l\r\u001b[?2004h"]
[392.898221, "o", "> "]
[392.898258, "o", "                    )\r\n\u001b[?2004l\r\u001b[?2004h> "]
[392.89832, "o", "                except Exception:  # noqa: BLE001\r\n\u001b[?2004l\r"]
[392.898332, "o", "\u001b[?2004h> "]
[392.898374, "o", "                    pass\r\n\u001b[?2004l\r"]
[392.898416, "o", "\u001b[?2004h> "]
[392.898428, "o", "                time.sleep(1.0)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[392.898497, "o", "        if ok:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[392.898593, "o", "            print(f\"[ingest] added {doc['metadata']['file_name']}\", file=sys.stderr)\r\n\u001b[?2004l\r"]
[392.898609, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[392.898625, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[392.898682, "o", "def run_search(\r\n\u001b[?2004l\r\u001b[?2004h> "]
[392.89875, "o", "    client: AlchemystAI, groups: List[str], source: str, run_id: str\r\n\u001b[?2004l\r"]
[392.898763, "o", "\u001b[?2004h> "]
[392.898819, "o", ") -> List[Dict[str, Any]]:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[392.898903, "o", "    \"\"\"Perform the filtered search and return deduplicated matches.\"\"\"\r\n\u001b[?2004l\r"]
[392.898939, "o", "\u001b[?2004h> "]
[392.898953, "o", "    query = (\r\n\u001b[?2004l\r\u001b[?2004h> "]
[392.89904, "o", "        \"engineering v1 v2 deployment pipeline observability platform team \"\r\n\u001b[?2004l\r\u001b[?2004h"]
[392.899054, "o", "> "]
[392.899113, "o", "        \"docs user guide installation FAQ changelog\"\r\n\u001b[?2004l\r"]
[392.899146, "o", "\u001b[?2004h>     )\r\n\u001b[?2004l\r"]
[392.899175, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[392.89921, "o", "    expected_files = {\r\n\u001b[?2004l\r"]
[392.899228, "o", "\u001b[?2004h> "]
[392.899244, "o", "        f\"docA-{run_id}.md\",\r\n\u001b[?2004l\r"]
[392.899295, "o", "\u001b[?2004h> "]
[392.899325, "o", "        f\"docB-{run_id}.md\",\r\n\u001b[?2004l\r\u001b[?2004h> "]
[392.899365, "o", "        f\"docC-{run_id}.md\",\r\n\u001b[?2004l\r\u001b[?2004h> "]
[392.899399, "o", "    }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[392.899412, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[392.899463, "o", "    matches: List[Dict[str, Any]] = []\r\n\u001b[?2004l\r\u001b[?2004h"]
[392.899478, "o", "> "]
[392.899517, "o", "    seen: set[str] = set()\r\n\u001b[?2004l\r\u001b[?2004h"]
[392.89953, "o", "> "]
[392.899574, "o", "    last_response: Any = None\r\n\u001b[?2004l\r\u001b[?2004h> "]
[392.899601, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[392.899687, "o", "    # Short bounded retry loop: vector indexing can take a moment to settle.\r\n\u001b[?2004l\r\u001b[?2004h"]
[392.899699, "o", "> "]
[392.899742, "o", "    for attempt in range(8):\r\n\u001b[?2004l\r"]
[392.899772, "o", "\u001b[?2004h> "]
[392.899796, "o", "        try:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[392.899849, "o", "            response = client.v1.context.search(\r\n\u001b[?2004l\r\u001b[?2004h"]
[392.899876, "o", "> "]
[392.899905, "o", "                query=query,\r\n\u001b[?2004l\r"]
[392.899917, "o", "\u001b[?2004h> "]
[392.899981, "o", "                minimum_similarity_threshold=0.0,\r\n\u001b[?2004l\r\u001b[?2004h"]
[392.899994, "o", "> "]
[392.900051, "o", "                similarity_threshold=1.0,\r\n\u001b[?2004l\r\u001b[?2004h"]
[392.900063, "o", "> "]
[392.90011, "o", "                metadata=\"true\",\r\n\u001b[?2004l\r\u001b[?2004h> "]
[392.900181, "o", "                body_metadata={\"group_name\": groups},\r\n\u001b[?2004l\r"]
[392.900196, "o", "\u001b[?2004h> "]
[392.900252, "o", "                scope=\"internal\",\r\n\u001b[?2004l\r\u001b[?2004h> "]
[392.90029, "o", "                user_id=source,\r\n\u001b[?2004l\r\u001b[?2004h"]
[392.900303, "o", "> "]
[392.900357, "o", "            )\r\n\u001b[?2004l\r\u001b[?2004h> "]
[392.900391, "o", "        except Exception as exc:  # noqa: BLE001\r\n\u001b[?2004l\r\u001b[?2004h"]
[392.900401, "o", "> "]
[392.900497, "o", "            print(f\"[search] attempt {attempt + 1} failed: {exc}\", file=sys.stderr)\r\n\u001b[?2004l\r"]
[392.900508, "o", "\u001b[?2004h> "]
[392.900538, "o", "            time.sleep(1.5)\r\n\u001b[?2004l\r"]
[392.900551, "o", "\u001b[?2004h"]
[392.900563, "o", "> "]
[392.900583, "o", "            continue\r\n\u001b[?2004l\r"]
[392.900593, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[392.900604, "o", "\u001b[?2004h> "]
[392.900649, "o", "        last_response = response\r\n\u001b[?2004l\r"]
[392.900659, "o", "\u001b[?2004h> "]
[392.900892, "o", "        contexts = getattr(response, \"contexts\", None) or []\r\n\u001b[?2004l\r\u001b[?2004h>         run_contexts = [\r\n\u001b[?2004l\r\u001b[?2004h>             c for c in contexts if _ctx_file_name(c) in expected_files\r\n\u001b[?2004l\r\u001b[?2004h> "]
[392.900945, "o", "        ]\r\n\u001b[?2004l\r\u001b[?2004h> "]
[392.900993, "o", "        if run_contexts:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[392.901022, "o", "            break\r\n\u001b[?2004l\r\u001b[?2004h> "]
[392.901054, "o", "        time.sleep(1.5)\r\n\u001b[?2004l\r\u001b[?2004h"]
[392.901084, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[392.90114, "o", "    if last_response is not None:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[392.901224, "o", "        contexts = getattr(last_response, \"contexts\", None) or []\r\n\u001b[?2004l\r\u001b[?2004h"]
[392.901243, "o", "> "]
[392.901304, "o", "        for ctx in contexts:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[392.901347, "o", "            fn = _ctx_file_name(ctx)\r\n\u001b[?2004l\r\u001b[?2004h"]
[392.901367, "o", "> "]
[392.901484, "o", "            if fn in expected_files and fn not in seen:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[392.901553, "o", "                seen.add(fn)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[392.901634, "o", "                matches.append({\"file_name\": fn})\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[392.901674, "o", "    return matches\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[392.901762, "o", "def _ctx_file_name(ctx: Any) -> str:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[392.901813, "o", "    meta = getattr(ctx, \"metadata\", None)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[392.901829, "o", "    if meta is None:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[392.901861, "o", "        return \"\"\r\n\u001b[?2004l\r\u001b[?2004h> "]
[392.901909, "o", "    if hasattr(meta, \"model_dump\"):\r\n\u001b[?2004l\r"]
[392.90195, "o", "\u001b[?2004h> "]
[392.90198, "o", "        meta = meta.model_dump()\r\n\u001b[?2004l\r"]
[392.901995, "o", "\u001b[?2004h> "]
[392.902038, "o", "    elif hasattr(meta, \"dict\"):\r\n\u001b[?2004l\r"]
[392.902049, "o", "\u001b[?2004h> "]
[392.902092, "o", "        meta = meta.dict()\r\n\u001b[?2004l\r"]
[392.902104, "o", "\u001b[?2004h> "]
[392.902159, "o", "    if not isinstance(meta, dict):\r\n\u001b[?2004l\r"]
[392.902172, "o", "\u001b[?2004h> "]
[392.902209, "o", "        return \"\"\r\n\u001b[?2004l\r\u001b[?2004h> "]
[392.902286, "o", "    return meta.get(\"file_name\") or meta.get(\"fileName\") or \"\"\r\n\u001b[?2004l\r\u001b[?2004h"]
[392.902299, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[392.902311, "o", "\r\n\u001b[?2004l\r\u001b[?2004h"]
[392.902358, "o", "> def main() -> int:\r\n\u001b[?2004l\r"]
[392.902387, "o", "\u001b[?2004h> "]
[392.902421, "o", "    groups = parse_args()\r\n\u001b[?2004l\r"]
[392.902433, "o", "\u001b[?2004h> "]
[392.902504, "o", "    run_id = read_run_id()\r\n\u001b[?2004l\r\u001b[?2004h> "]
[392.902599, "o", "    source = f\"docs-{run_id}\"\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[392.902697, "o", "    print(f\"[start] run_id={run_id} groups={groups} source={source}\", file=sys.stderr)\r\n\u001b[?2004l\r\u001b[?2004h"]
[392.902734, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[392.902766, "o", "    client = make_client()\r\n\u001b[?2004l\r\u001b[?2004h"]
[392.9028, "o", "> "]
[392.90287, "o", "    ingest_documents(client, run_id=run_id, source=source)\r\n\u001b[?2004l\r\u001b[?2004h"]
[392.902903, "o", "> "]
[392.902982, "o", "    matches = run_search(client, groups=groups, source=source, run_id=run_id)\r\n\u001b[?2004l\r"]
[392.902999, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[392.90309, "o", "    # Final JSON array on the last line of stdout.\r\n\u001b[?2004l\r\u001b[?2004h"]
[392.903108, "o", "> "]
[392.903187, "o", "    sys.stdout.write(json.dumps(matches, indent=2))\r\n\u001b[?2004l\r\u001b[?2004h"]
[392.903204, "o", "> "]
[392.903246, "o", "    sys.stdout.write(\"\\n\")\r\n\u001b[?2004l\r\u001b[?2004h> "]
[392.903276, "o", "    return 0\r\n\u001b[?2004l\r"]
[392.903291, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[392.903336, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h"]
[392.90337, "o", "> if __name__ == \"__main__\":\r\n\u001b[?2004l\r"]
[392.903398, "o", "\u001b[?2004h> "]
[392.903432, "o", "    raise SystemExit(main())\r\n\u001b[?2004l\r\u001b[?2004h"]
[392.903445, "o", "> PYEOF\r\n\u001b[?2004l\r"]
