[549.260854, "i", "cd /home/user/myproject && python3 -c \"\nimport os\nfrom alchemyst_ai import AlchemystAI\nc = AlchemystAI(api_key=os.environ['ALCHEMYST_AI_API_KEY'])\n\nprint('=== Filter with nonexistent group ===')\nr = c.v1.context.search(\n    query='engineering deployment observability',\n    minimum_similarity_threshold=0.0,\n    similarity_threshold=1.0,\n    metadata='true',\n    body_metadata={'group_name': ['nonexistent_group_xyz123']},\n    scope='internal',\n    user_id='docs-zrthdq6dz6',\n)\nprint('count:', len(r.contexts or []))\nfor i, ctx in enumerate((r.contexts or [])[:5]):\n    fn = ctx.metadata.get('file_name') if ctx.metadata else None\n    gn = ctx.metadata.get('group_name') if ctx.metadata else None\n    print(f'  [{i}] fn={fn} gn={gn}')\n\nprint()\nprint('=== Filter with eng AND v1 (intersection) ===')\nr = c.v1.context.search(\n    query='engineering deployment observability',\n    minimum_similarity_threshold=0.0,\n    similarity_threshold=1.0,\n    metadata='true',\n    body_metadata={'group_name': ['eng', 'v1']},\n    scope='internal',\n    user_id='docs-zrthdq6dz6',\n)\nprint('count:', len(r.contexts or []))\nfor i, ctx in enumerate((r.contexts or [])[:10]):\n    fn = ctx.metadata.get('file_name') if ctx.metadata else None\n    gn = ctx.metadata.get('group_name') if ctx.metadata else None\n    print(f'  [{i}] fn={fn} gn={gn}')\n\" 2>&1 | tail -30\n"]
