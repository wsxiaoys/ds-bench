[268.220128, "o", "                )\r\n\u001b[?2004l\r"]
[268.220144, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[268.220191, "o", "\u001b[?2004h> def run_search(\r\n\u001b[?2004l\r\u001b[?2004h> "]
[268.220219, "o", "    client: AlchemystAI, groups: List[str], source: str, run_id: str\r\n\u001b[?2004l\r\u001b[?2004h> "]
[268.220248, "o", ") -> List[Dict[str, Any]]:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[268.220297, "o", "    \"\"\"Perform the filtered search and return deduplicated matches.\"\"\"\r\n\u001b[?2004l\r\u001b[?2004h> "]
[268.220329, "o", "    query = (\r\n\u001b[?2004l\r\u001b[?2004h> "]
[268.220364, "o", "        \"engineering platform deployment release notes and public \"\r\n\u001b[?2004l\r\u001b[?2004h> "]
[268.220397, "o", "        \"documentation user guide\"\r\n\u001b[?2004l\r\u001b[?2004h"]
[268.220414, "o", ">     )\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[268.220454, "o", ">     expected_files = {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[268.220483, "o", "        f\"docA-{run_id}.md\",\r\n\u001b[?2004l\r\u001b[?2004h> "]
[268.220501, "o", "        f\"docB-{run_id}.md\",\r\n\u001b[?2004l\r\u001b[?2004h> "]
[268.220545, "o", "        f\"docC-{run_id}.md\",\r\n\u001b[?2004l\r\u001b[?2004h>     }\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[268.220578, "o", "    matches: List[Dict[str, Any]] = []\r\n\u001b[?2004l\r\u001b[?2004h> "]
[268.220603, "o", "    seen: set[str] = set()\r\n\u001b[?2004l\r\u001b[?2004h> "]
[268.220633, "o", "    last_response: Any = None\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[268.220659, "o", "\u001b[?2004h> "]
[268.220698, "o", "    # Short bounded retry loop: vector indexing can take a moment to settle.\r\n\u001b[?2004l\r\u001b[?2004h> "]
[268.220727, "o", "    for attempt in range(8):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[268.220745, "o", "        try:\r\n\u001b[?2004l\r"]
[268.22076, "o", "\u001b[?2004h> "]
[268.220805, "o", "            response = client.v1.context.search(\r\n\u001b[?2004l\r\u001b[?2004h> "]
[268.220835, "o", "                query=query,\r\n\u001b[?2004l\r\u001b[?2004h> "]
[268.220867, "o", "                minimum_similarity_threshold=0.1,\r\n\u001b[?2004l\r\u001b[?2004h> "]
[268.220897, "o", "                similarity_threshold=0.99,\r\n\u001b[?2004l\r\u001b[?2004h> "]
[268.220926, "o", "                metadata=\"true\",\r\n\u001b[?2004l\r\u001b[?2004h> "]
[268.220965, "o", "                body_metadata={\"group_name\": groups},\r\n\u001b[?2004l\r\u001b[?2004h> "]
[268.220997, "o", "                scope=\"internal\",\r\n\u001b[?2004l\r\u001b[?2004h> "]
[268.221027, "o", "                user_id=source,\r\n\u001b[?2004l\r\u001b[?2004h> "]
[268.221044, "o", "            )\r\n\u001b[?2004l\r\u001b[?2004h"]
[268.22106, "o", "> "]
[268.221091, "o", "        except Exception as exc:  # noqa: BLE001\r\n\u001b[?2004l\r\u001b[?2004h> "]
[268.221155, "o", "            print(f\"[search] attempt {attempt + 1} failed: {exc}\", file=sys.stderr)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[268.221172, "o", "            time.sleep(1.5)\r\n\u001b[?2004l\r"]
[268.221208, "o", "\u001b[?2004h>             continue\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[268.221236, "o", "        last_response = response\r\n\u001b[?2004l\r\u001b[?2004h> "]
[268.221287, "o", "        contexts = getattr(response, \"contexts\", None) or []\r\n\u001b[?2004l\r\u001b[?2004h> "]
[268.221346, "o", "        # Filter to only documents that belong to this run id (namespace safety).\r\n\u001b[?2004l\r\u001b[?2004h"]
[268.221364, "o", "> "]
[268.221402, "o", "        run_contexts = [\r\n\u001b[?2004l\r\u001b[?2004h>             c for c in contexts\r\n\u001b[?2004l\r\u001b[?2004h"]
[268.221431, "o", "> "]
[268.221461, "o", "            if _ctx_file_name(c) in expected_files\r\n\u001b[?2004l\r\u001b[?2004h>         ]\r\n\u001b[?2004l\r\u001b[?2004h> "]
[268.221481, "o", "        if run_contexts:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[268.22152, "o", "            break\r\n\u001b[?2004l\r\u001b[?2004h>         time.sleep(1.5)\r\n\u001b[?2004l\r\u001b[?2004h"]
[268.22155, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[268.221567, "o", "    if last_response is not None:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[268.221619, "o", "        contexts = getattr(last_response, \"contexts\", None) or []\r\n\u001b[?2004l\r\u001b[?2004h> "]
[268.221636, "o", "        for ctx in contexts:\r\n\u001b[?2004l\r\u001b[?2004h"]
[268.221649, "o", "> "]
[268.221698, "o", "            fn = _ctx_file_name(ctx)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[268.221728, "o", "            if fn in expected_files and fn not in seen:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[268.221756, "o", "                seen.add(fn)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[268.221791, "o", "                matches.append({\"file_name\": fn})\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[268.221809, "o", "    return matches\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[268.221823, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[268.221872, "o", "def _ctx_file_name(ctx: Any) -> str:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[268.2219, "o", "    meta = getattr(ctx, \"metadata\", None)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[268.221917, "o", "    if meta is None:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[268.221931, "o", "        return \"\"\r\n\u001b[?2004l\r"]
[268.221975, "o", "\u001b[?2004h>     if hasattr(meta, \"model_dump\"):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[268.222004, "o", "        meta = meta.model_dump()\r\n\u001b[?2004l\r\u001b[?2004h> "]
[268.222037, "o", "    elif hasattr(meta, \"dict\"):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[268.222067, "o", "        meta = meta.dict()\r\n\u001b[?2004l\r\u001b[?2004h> "]
[268.222096, "o", "    if not isinstance(meta, dict):\r\n\u001b[?2004l\r\u001b[?2004h>         return \"\"\r\n"]
[268.222122, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[268.222154, "o", "    return meta.get(\"file_name\") or meta.get(\"fileName\") or \"\"\r\n\u001b[?2004l\r\u001b[?2004h> "]
[268.222186, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[268.222218, "o", "def main() -> int:\r\n\u001b[?2004l\r\u001b[?2004h>     groups = parse_args()\r\n\u001b[?2004l\r"]
[268.222236, "o", "\u001b[?2004h> "]
[268.222273, "o", "    run_id = read_run_id()\r\n\u001b[?2004l\r\u001b[?2004h>     source = f\"docs-{run_id}\"\r\n\u001b[?2004l\r\u001b[?2004h"]
[268.222302, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[268.222348, "o", "    print(f\"[start] run_id={run_id} groups={groups} source={source}\", file=sys.stderr)\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[268.222375, "o", "\u001b[?2004h>     client = make_client()\r\n\u001b[?2004l\r"]
[268.222404, "o", "\u001b[?2004h> "]
[268.222436, "o", "    ingest_documents(client, run_id=run_id, source=source)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[268.22249, "o", "    matches = run_search(client, groups=groups, source=source, run_id=run_id)\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[268.222517, "o", "\u001b[?2004h> "]
[268.222544, "o", "    # Final JSON array on the last line of stdout.\r\n\u001b[?2004l\r"]
[268.222574, "o", "\u001b[?2004h>     sys.stdout.write(json.dumps(matches, indent=2))\r\n\u001b[?2004l\r"]
[268.222603, "o", "\u001b[?2004h>     sys.stdout.write(\"\\n\")\r\n\u001b[?2004l\r\u001b[?2004h"]
[268.22263, "o", ">     return 0\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[268.222661, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> if __name__ == \"__main__\":\r\n\u001b[?2004l\r"]
[268.222678, "o", "\u001b[?2004h> "]
[268.222715, "o", "    raise SystemExit(main())\r\n\u001b[?2004l\r\u001b[?2004h> PYEOF\r\n\u001b[?2004l\r"]
