[392.88725, "o", "\u001b[?2004h> "]
[392.887393, "o", "                \"last_modified\": last_modified,\r\n\u001b[?2004l\r"]
[392.88744, "o", "\u001b[?2004h> "]
[392.887578, "o", "                \"group_name\": [\"eng\", \"v1\"],\r\n\u001b[?2004l\r\u001b[?2004h"]
[392.887626, "o", ">             },\r\n\u001b[?2004l\r"]
[392.887675, "o", "\u001b[?2004h>         },\r\n\u001b[?2004l\r"]
[392.887727, "o", "\u001b[?2004h> "]
[392.887792, "o", "        {\r\n\u001b[?2004l\r\u001b[?2004h>             \"content\": (\r\n\u001b[?2004l\r  m"]
[392.887838, "o", "inimum_similarity_thre\u001b[?2004h> "]
[392.887989, "o", "                f\"# Document B ({run_id})\\n\\n\"\r\n\u001b[?2004l\r"]
[392.88804, "o", "\u001b[?2004h> "]
[392.888308, "o", "                \"Engineering v2 changelog: refactored auth, switched to the new \"\r\n\u001b[?2004l\r"]
[392.888359, "o", "\u001b[?2004h> "]
