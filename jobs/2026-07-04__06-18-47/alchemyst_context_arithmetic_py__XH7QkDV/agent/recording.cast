[248.65918, "o", "# File generated from our OpenAPI spec by Stainless. See CONTRIBUTING.md for details.\r\n\r\nfrom __future__ import annotations\r\n\r\nfrom typing import Dict, Union, Iterable\r\nfrom typing_extensions import Literal, Required, Annotated, TypeAlias, TypedDict\r\n\r\nfrom ..._types import SequenceNotStr\r\nfrom ..._utils import PropertyInfo\r\n\r\n__all__ = [\"ContextAddParams\", \"Document\", \"Metadata\"]\r\n\r\n\r\nclass ContextAddParams(TypedDict, total=False):\r\n    context_type: Required[Literal[\"resource\", \"conversation\", \"instruction\"]]\r\n    \"\"\"Type of context being added\"\"\"\r\n\r\n    documents: Required[Iterable[Document]]\r\n    \"\"\"Array of documents with content and additional metadata\"\"\"\r\n\r\n    scope: Required[Literal[\"internal\", \"external\"]]\r\n    \"\"\"Scope of the context\"\"\"\r\n\r\n    source: Required[str]\r\n    \"\"\"The source of the context data\"\"\"\r\n\r\n    metadata: Metadata\r\n    \"\"\"Additional metadata for the context\"\"\"\r\n\r\n\r\nclass DocumentTyped(TypedDict, total=False):\r\n    content: str\r\n    \"\"\"The content of the document\"\"\"\r\n\r\n\r\nDocument: TypeAlias = Union[DocumentTyped, Dict[str, str]]\r\n\r\n\r\nclass Metadata(TypedDict, total=False):\r\n    \"\"\"Additional metadata for the context\"\"\"\r\n\r\n    file_name: Annotated[str, PropertyInfo(alias=\"fileName\")]\r\n    \"\"\"Name of the file\"\"\"\r\n\r\n    file_size: Annotated[float, PropertyInfo(alias=\"fileSize\")]\r\n    \"\"\"Size of the file in bytes\"\"\"\r\n\r\n    file_type: Annotated[str, PropertyInfo(alias=\"fileType\")]\r\n    \"\"\"Type/MIME of the file\"\"\"\r\n\r\n    group_name: Annotated[SequenceNotStr[str], PropertyInfo(alias=\"groupName\")]\r\n    \"\"\"Array of Group Name to which the file belongs to\"\"\"\r\n\r\n    last_modified: Annotated[str, PropertyInfo(alias=\"lastModified\")]\r\n    \"\"\"Last modified timestamp\"\"\"\r\n"]
[248.659316, "o", "\u001b[?2004hroot@64f400a2-f29a-498e-bb39-278b36d691ec:/home/user/myproject# "]
[268.21475, "i", "cat > /home/user/myproject/main.py << 'PYEOF'\n#!/usr/bin/env python3\n\"\"\"\nContext Arithmetic (Intersection) demo CLI using Alchemyst AI Python SDK.\n\nOn every invocation this CLI:\n1. Reads the per-run id from /logs/artifacts/run-id.\n2. Removes any documents previously ingested under that run id (idempotent reruns).\n3. Ingests 3 documents whose `group_name` arrays overlap so the intersection\n   semantics of Context Arithmetic can be verified.\n4. Performs `client.v1.context.search(...)` filtered by\n   `body_metadata={\"group_name\": [<groups from --groups>]}` and prints the\n   matching documents as a single JSON array to stdout.\n\"\"\"\n\nfrom __future__ import annotations\n\nimport argparse\nimport datetime as _dt\nimport json\nimport os\nimport sys\nimport time\nfrom pathlib import Path\nfrom typing import Any, Dict, List\n\nfrom alchemyst_ai import AlchemystAI\n\nRUN_ID_FILE = Path(\"/logs/artifacts/run-id\")\n\n\ndef read_run_id() -> str:\n    return RUN_ID_FILE.read_text().strip()\n\n\ndef parse_args() -> List[str]:\n    parser = argparse.ArgumentParser(\n        description=\"Demonstrate Context Arithmetic (group_name intersection).\"\n    )\n    parser.add_argument(\n        \"--groups\",\n        nargs=\"+\",\n        required=True,\n        help=\"One or more group names to AND-filter on (intersection semantics).\",\n    )\n    return list(parser.parse_args().groups)\n\n\ndef make_client() -> AlchemystAI:\n    api_key = os.environ.get(\"ALCHEMYST_AI_API_KEY\")\n    if not api_key:\n        print(\n            \"ERROR: ALCHEMYST_AI_API_KEY environment variable is not set.\",\n            file=sys.stderr,\n        )\n        sys.exit(1)\n    return AlchemystAI(api_key=api_key)\n\n\ndef build_documents(run_id: str, last_modified: str) -> List[Dict[str, Any]]:\n    \"\"\"Build the three overlapping documents.\"\"\"\n    docs = [\n        {\n            \"content\": (\n                f\"# Document A ({run_id})\\n\\n\"\n                \"Engineering v1 release notes: new deployment pipeline, \"\n                \"observability dashboards, and on-call rotations for the \"\n                \"platform team. Marker: docA.\"\n            ),\n            \"metadata\": {\n                \"file_name\": f\"docA-{run_id}.md\",\n                \"file_size\": 1.0,\n                \"file_type\": \"text/markdown\",\n                \"last_modified\": last_modified,\n                \"group_name\": [\"eng\", \"v1\"],\n            },\n        },\n        {\n            \"content\": (\n                f\"# Document B ({run_id})\\n\\n\"\n                \"Engineering v2 changelog: refactored auth, switched to the new \"\n                \"build system, upgraded the database driver. Marker: docB.\"\n            ),\n            \"metadata\": {\n                \"file_name\": f\"docB-{run_id}.md\",\n                \"file_size\": 1.0,\n                \"file_type\": \"text/markdown\",\n                \"last_modified\": last_modified,\n                \"group_name\": [\"eng\", \"v2\"],\n            },\n        },\n        {\n            \"content\": (\n                f\"# Document C ({run_id})\\n\\n\"\n                \"Public-facing docs v1: user guide, installation, and FAQ for \"\n                \"the initial GA release. Marker: docC.\"\n            ),\n            \"metadata\": {\n                \"file_name\": f\"docC-{run_id}.md\",\n                \"file_size\": 1.0,\n                \"file_type\": \"text/markdown\",\n                \"last_modified\": last_modified,\n                \"group_name\": [\"docs\", \"v1\"],\n            },\n        },\n    ]\n    return docs\n\n\ndef ingest_documents(client: AlchemystAI, run_id: str, source: str) -> None:\n    \"\"\"Delete any previously-ingested docs for this run, then add the three docs.\"\"\"\n    last_modified = _dt.datetime.utcnow().isoformat() + \"Z\"\n\n    # Best-effort cleanup so reruns with the same run-id don't 409.\n    for fname in (\n        f\"docA-{run_id}.md\",\n        f\"docB-{run_id}.md\",\n        f\"docC-{run_id}.md\",\n    ):\n        try:\n            client.v1.context.delete(\n                organization_id=\"default\",\n                source=source,\n                by_doc=True,\n                user_id=fname,\n            )\n        except Exception as exc:  # noqa: BLE001\n            print(f\"[cl"]
[268.21489, "i", "eanup] delete {fname}: {exc}\", file=sys.stderr)\n\n    documents = build_documents(run_id, last_modified)\n\n    # Try batch add first; if any failure, fall back to per-doc ingestion.\n    batch_meta = {\n        \"file_name\": f\"batch-{run_id}.md\",\n        \"file_size\": 1.0,\n        \"file_type\": \"text/markdown\",\n        \"last_modified\": last_modified,\n        \"group_name\": [\"eng\", \"v1\", \"v2\", \"docs\"],\n    }\n    try:\n        client.v1.context.add(\n            context_type=\"resource\",\n            documents=documents,\n            scope=\"internal\",\n            source=source,\n            metadata=batch_meta,\n        )\n        print(f\"[ingest] batch add ok ({len(documents)} docs)\", file=sys.stderr)\n    except Exception as exc:  # noqa: BLE001\n        print(\n            f\"[ingest] batch add failed ({exc}); falling back to per-doc\",\n            file=sys.stderr,\n        )\n        for doc in documents:\n            try:\n                client.v1.context.add(\n                    context_type=\"resource\",\n                    documents=[doc],\n                    scope=\"internal\",\n                    source=source,\n                    metadata=doc[\"metadata\"],\n                )\n            except Exception as inner_exc:  # noqa: BLE001\n                print(\n                    f\"[ingest] per-doc add failed for \"\n                    f\"{doc['metadata'].get('file_name')}: {inner_exc}\",\n                    file=sys.stderr,\n                )\n\n\ndef run_search(\n    client: AlchemystAI, groups: List[str], source: str, run_id: str\n) -> List[Dict[str, Any]]:\n    \"\"\"Perform the filtered search and return deduplicated matches.\"\"\"\n    query = (\n        \"engineering platform deployment release notes and public \"\n        \"documentation user guide\"\n    )\n\n    expected_files = {\n        f\"docA-{run_id}.md\",\n        f\"docB-{run_id}.md\",\n        f\"docC-{run_id}.md\",\n    }\n\n    matches: List[Dict[str, Any]] = []\n    seen: set[str] = set()\n    last_response: Any = None\n\n    # Short bounded retry loop: vector indexing can take a moment to settle.\n    for attempt in range(8):\n        try:\n            response = client.v1.context.search(\n                query=query,\n                minimum_similarity_threshold=0.1,\n                similarity_threshold=0.99,\n                metadata=\"true\",\n                body_metadata={\"group_name\": groups},\n                scope=\"internal\",\n                user_id=source,\n            )\n        except Exception as exc:  # noqa: BLE001\n            print(f\"[search] attempt {attempt + 1} failed: {exc}\", file=sys.stderr)\n            time.sleep(1.5)\n            continue\n\n        last_response = response\n        contexts = getattr(response, \"contexts\", None) or []\n        # Filter to only documents that belong to this run id (namespace safety).\n        run_contexts = [\n            c for c in contexts\n            if _ctx_file_name(c) in expected_files\n        ]\n        if run_contexts:\n            break\n        time.sleep(1.5)\n\n    if last_response is not None:\n        contexts = getattr(last_response, \"contexts\", None) or []\n        for ctx in contexts:\n            fn = _ctx_file_name(ctx)\n            if fn in expected_files and fn not in seen:\n                seen.add(fn)\n                matches.append({\"file_name\": fn})\n\n    return matches\n\n\ndef _ctx_file_name(ctx: Any) -> str:\n    meta = getattr(ctx, \"metadata\", None)\n    if meta is None:\n        return \"\"\n    if hasattr(meta, \"model_dump\"):\n        meta = meta.model_dump()\n    elif hasattr(meta, \"dict\"):\n        meta = meta.dict()\n    if not isinstance(meta, dict):\n        return \"\"\n    return meta.get(\"file_name\") or meta.get(\"fileName\") or \"\"\n\n\ndef main() -> int:\n    groups = parse_args()\n    run_id = read_run_id()\n    source = f\"docs-{run_id}\"\n\n    print(f\"[start] run_id={run_id} groups={groups} source={source}\", file=sys.stderr)\n\n    client = make_client()\n    ingest_documents(client, run_id=run_id, source=source)\n    matches = run_search(client, groups=groups, source=source, run_id=run_id)\n\n    # Final JSON array on the last line of stdout.\n    sys.stdout.write(json.dumps(matche"]
[268.214948, "i", "s, indent=2))\n    sys.stdout.write(\"\\n\")\n    return 0\n\n\nif __name__ == \"__main__\":\n    raise SystemExit(main())\nPYEOF\n"]
[268.217826, "o", "cat > /home/user/myproject/main.py << 'PYEOF'\r\n\u001b[?2004l\r\u001b[?2004h> #!/usr/bin/env python3\r\n\u001b[?2004l\r\u001b[?2004h> \"\"\"\r\n\u001b[?2004l\r\u001b[?2004h> Context Arithmetic (Intersection) demo CLI using Alchemyst AI Python SDK.\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> On every invocation this CLI:\r\n\u001b[?2004l\r\u001b[?2004h> 1. Reads the per-run id from /logs/artifacts/run-id.\r\n\u001b[?2004l\r\u001b[?2004h> 2. Removes any documents previously ingested under that run id (idempotent reruns).\r\n\u001b[?2004l\r\u001b[?2004h> 3. Ingests 3 documents whose `group_name` arrays overlap so the intersection\r\n\u001b[?2004l\r\u001b[?2004h>    semantics of Context Arithmetic can be verified.\r\n\u001b[?2004l\r\u001b[?2004h> 4. Performs `client.v1.context.search(...)` filtered by\r\n\u001b[?2004l\r\u001b[?2004h>    `body_metadata={\"group_name\": [<groups from --groups>]}` and prints the\r\n\u001b[?2004l\r\u001b[?2004h>    matching documents as a single JSON array to stdout.\r\n\u001b[?2004l\r\u001b[?2004h> \"\"\"\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> from __future__ import annotations\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> import argparse\r\n\u001b[?2004l\r\u001b[?2004h> import datetime as _dt\r\n\u001b[?2004l\r\u001b[?2004h> import json\r\n\u001b[?2004l\r\u001b[?2004h> import os\r\n\u001b[?2004l\r\u001b[?2004h> import sys\r\n\u001b[?2004l\r\u001b[?2004h> import time\r\n\u001b[?2004l\r\u001b[?2004h> from pathlib import Path\r\n\u001b[?2004l\r\u001b[?2004h> from typing import Any, Dict, List\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> from alchemyst_ai import AlchemystAI\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> RUN_ID_FILE = Path(\"/logs/artifacts/run-id\")\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> def read_run_id() -> str:\r\n\u001b[?2004l\r\u001b[?2004h>     return RUN_ID_FILE.read_text().strip()\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> def parse_args() -> List[str]:\r\n\u001b[?2004l\r\u001b[?2004h>     parser = argparse.ArgumentParser(\r\n\u001b[?2004l\r\u001b[?2004h>         description=\"Demonstrate Context Arithmetic (group_name intersection).\"\r\n\u001b[?2004l\r\u001b[?2004h>     )\r\n\u001b[?2004l\r\u001b[?2004h>     parser.add_argument(\r\n\u001b[?2004l\r\u001b[?2004h>         \"--groups\",\r\n\u001b[?2004l\r\u001b[?2004h>         nargs=\"+\",\r\n\u001b[?2004l\r\u001b[?2004h>         required=True,\r\n\u001b[?2004l\r\u001b[?2004h>         help=\"One or more group names to AND-filter on (intersection semantics).\",\r\n\u001b[?2004l\r\u001b[?2004h>     )\r\n\u001b[?2004l\r\u001b[?2004h>     return list(parser.parse_args().groups)\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> def make_client() -> AlchemystAI:\r\n\u001b[?2004l\r\u001b[?2004h>     api_key = os.environ.get(\"ALCHEMYST_AI_API_KEY\")\r\n\u001b[?2004l\r\u001b[?2004h>     if not api_key:\r\n\u001b[?2004l\r\u001b[?2004h>         print(\r\n\u001b[?2004l\r\u001b[?2004h>             \"ERROR: ALCHEMYST_AI_API_KEY environment variable is not set.\",\r\n\u001b[?2004l\r\u001b[?2004h>             file=sys.stderr,\r\n\u001b[?2004l\r\u001b[?2004h>         )\r\n\u001b[?2004l\r\u001b[?2004h>         sys.exit(1)\r\n\u001b[?2004l\r\u001b[?2004h>     return AlchemystAI(api_key=api_key)\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> def build_documents(run_id: str, last_modified: str) -> List[Dict[str, Any]]:\r\n\u001b[?2004l\r\u001b[?2004h>     \"\"\"Build the three overlapping documents.\"\"\"\r\n\u001b[?2004l\r\u001b[?2004h>     docs = [\r\n\u001b[?2004l\r\u001b[?2004h>         {\r\n\u001b[?2004l\r\u001b[?2004h>             \"content\": (\r\n\u001b[?2004l\r\u001b[?2004h>                 f\"# Document A ({run_id})\\n\\n\"\r\n\u001b[?2004l\r\u001b[?2004h>                 \"Engineering v1 release notes: new deployment pipeline, \"\r\n\u001b[?2004l\r\u001b[?2004h>                 \"observability dashboards, and on-call rotations for the \"\r\n\u001b[?2004l\r\u001b[?2004h>                 \"platform team. Marker: docA.\"\r\n\u001b[?2004l\r\u001b[?2004h>             ),\r\n\u001b[?2004l\r\u001b[?2004h>             \"metadata\": {\r\n\u001b[?2004l\r\u001b[?2004h>                 \"file_name\": f\"docA-{run_id}.md\",\r\n\u001b[?2004l\r\u001b[?2004h>                 \"file_size\": 1.0,\r\n\u001b[?2004l\r\u001b[?2004h>                 \"file_type\": \"text/markdown\",\r\n\u001b[?2004l\r\u001b[?2004h>                 \"last_modified\": last_modified,\r\n\u001b[?2004l\r\u001b[?2004h>                 \"group_name\": [\"eng\", \"v1\"],\r\n\u001b[?2004l\r\u001b[?2004h>             },\r\n\u001b[?2004l\r\u001b[?2004h>         },\r\n\u001b[?2004l\r\u001b[?2004h>         {\r\n\u001b[?2004l\r\u001b[?2004h>             \"content\": (\r\n\u001b[?2004l\r\u001b[?2004h>                 f\"# Document B ({run_id})\\n\\n\"\r\n\u001b[?2004l\r\u001b[?2004h>                 \"Engineering v2 changelog: refactored au"]
