[?2004l[?2004h> function buildArticles(runId: string): Article[] {
[?2004l[?2004h>   return [
[?2004l[?2004h>     {
[?2004l[?2004h>       file_name: `b2b_article_ai_agents_${runId}.md`,
[?2004l[?2004h>       content:
[?2004l[?2004h>         'AI agents are REDACTEDnomous software systems built on top of large language models (LLMs). They plan multi-step workflows, call external tools, and reflect on their own outputs. Modern agentic systems combine planning, tool use, memory, and orchestration to REDACTEDmate knowledge work. Keywords: REDACTEDnomous, agentic, planning, tool use, orchestration.',
[?2004l[?2004h>     },
[?2004l[?2004h>     {
[?2004l[?2004h>       file_name: `b2b_article_rag_${runId}.md`,
[?2004l[?2004h>       content:
[?2004l[?2004h>         'Retrieval-Augmented Generation (RAG) augments LLM prompts with snippets retrieved from a vector store. Documents are chunked, embedded, and indexed; at query time a semantic search returns the most relevant chunks and the LLM grounds its answer in that retrieved context.',
[?2004l[?2004h>     },
[?2004l[?2004h>     {
[?2004l[?2004h>       file_name: `b2b_article_vector_db_${runId}.md`,
[?2004l[?2004h>       content:
[?2004l[?2004h>         'Vector databases such as Pinecone, Weaviate, and pgvector store high-dimensional embeddings and support approximate nearest neighbor search. They power semantic retrieval over unstructured text, images, and code by mapping content into a shared embedding space.',
[?2004l[?2004h>     },
[?2004l[?2004h>     {
[?2004l[?2004h>       file_name: `b2b_article_prompt_engineering_${runId}.md`,
[?2004l[?2004h>       content:
[?2004l[?2004h>         'Prompt engineering is the practice of designing effective instructions for large language models. Common techniques include few-shot examples, chain-of-thought reasoning, role prompts, and structured output formats such as JSON. Good prompts reduce hallucinations and improve task performance.',
[?2004l[?2004h>     },
[?2004l[?2004h>     {
[?2004l[?2004h>       file_name: `b2b_article_devops_${runId}.md`,
[?2004l[?2004h>       content:
[?2004l[?2004h>         'DevOps practices accelerate software delivery through continuous integration, continuous deployment, infrastructure-as-code, and observability. Tools such as Kubernetes, Terraform, and GitHub Actions REDACTEDmate provisioning, deployment, and monitoring of production systems.',
[?2004l[?2004h>     },
[?2004l[?2004h>   ];
[?2004l[?2004h> }
[?2004l[?2004h> 
[?2004l[?2004h> async function seedArticles(client: AlchemystAI, articles: Article[]): Promise<void> {
[?2004l[?2004h>   const documents = articles.map((a) => ({
[?2004l[?2004h>     content: a.content,
[?2004l[?2004h>     metadata: {
[?2004l[?2004h>       file_name: a.file_name,
[?2004l[?2004h>       context_type: 'resource',
[?2004l[?2004h>       scope: 'internal',
[?2004l[?2004h>     },
[?2004l[?2004h>   }));
[?2004l[?2004h>   // The SDK exposes v1.context.add. It is safe to call repeatedly as long as
[?2004l[?2004h>   // file_name values are unique per run (we namespace with run-id).
[?2004l[?2004h>   // Use a no-similarity-grouping strategy so we don't require an existing group.
[?2004l[?2004h>   // eslint-disable-next-line @typescript-eslint/no-explicit-any
[?2004l[?2004h>   await (client as any).v1.context.add({
[?2004l[?2004h>     documents,
[?2004l[?2004h>     context_type: 'resource',
[?2004l[?2004h>     scope: 'internal',
[?2004l[?2004h>   });
[?2004l[?2004h> }
[?2004l[?2004h> 
[?2004l[?2004h> async function searchContext(client: AlchemystAI, topic: string): Promise<{ content: string }[]> {
[?2004l[?2004h>   // eslint-disable-next-line @typescript-eslint/no-explicit-any
[?2004l[?2004h>   const result: any = await (client as any).v1.context.search({
[?2004l[?2004h>     query: topic,
[?2004l[?2004h>     context_type: 'resource',
[?2004l[?2004h>     scope: 'internal',
[?2004l[?2004h>     // Retrieve enough snippets to ground the newsletter
[?2004l[?2004h>     top_k: 5,
[?2004l[?2004h>   });
[?2004l[?2004h> 
[?2004l[?2004h>   // The SDK may return either { contexts: [...] } or { data: [...] } depending on version.
[?2004l[?2004h>   const contexts: any[] =
[?2004l[?2004h>     (Array.isArray(result?.contexts) && result.contexts) ||
[?2004l[?2004h>     (Array.isArray(result?.data) && result.data) ||
[?2004l[?2004h>     (Array.isArray(result?.results) && result.results) ||
[?2004l[?2004h>     (Array.isArray(result) && result) ||
[?2004l[?2004h>     [];
[?2004l[?2004h> 
[?2004l[?2004h>   return contexts.map((c: any) => ({ content: String(c.content ?? c.text ?? '') }));
[?2004l[?2004h> }
[?2004l[?2004h> 
[?2004l[?2004h> async function generateNewsletter(topic: string, grounding: string): Promise<string> {
[?2004l[?2004h>   const openai = new OpenAI({ apiKey: process.env.OPENAI_API_KEY });
[?2004l[?2004h> 
[?2004l[?2004h>   const systemPrompt =
[?2004l[?2004h>     'You are a B2B newsletter writer. Produce concise, professional newsletters grounded in the supplied research context. Always output valid Markdown.';
[?2004l[?2004h> 
[?2004l[?2004h>   const userPrompt = `Write a short B2B newsletter on the topic: "${topic}".
[?2004l[?2004h> 
[?2004l[?2004h> Use only the following research context as factual grounding. Do not invent facts beyond what is provided.
[?2004l[?2004h> 
[?2004l[?2004h> === RESEARCH CONTEXT ===
[?2004l[?2004h> ${grounding}
[?2004l[?2004h> === END CONTEXT ===
[?2004l[?2004h> 
[?2004l[?2004h> Requirements:
[?2004l[?2004h> - Output MUST be valid Markdown.
[?2004l[?2004h> - The newsletter MUST contain at least three sections, each introduced by a Markdown heading line (starting with #, ##, or ###).
[?2004l[?2004h> - Include at least these three sections (you may add more):
[?2004l[?2004h>   ## Why it matters
[?2004l[?2004h>   ## What\'s new
[?2004l[?2004h>   ## What to do next
[?2004l[?2004h> - Keep it concise (roughly 250-500 words total).
[?2004l[?2004h> - Address a B2B audience (decision-makers, engineering leaders).
[?2004l[?2004h> - Reference concrete details drawn from the research context.`;
[?2004l[?2004h> 
[?2004l[?2004h>   const completion = await openai.chat.completions.create({
[?2004l[?2004h>     model: 'gpt-4o-mini',
[?2004l[?2004h>     messages: [
[?2004l[?2004h>       { role: 'system', content: systemPrompt },
[?2004l[?2004h>       { role: 'user', content: userPrompt },
[?2004l[?2004h>     ],
[?2004l[?2004h>     temperature: 0.7,
[?2004l[?2004h>   });
[?2004l[?2004h> 
[?2004l[?2004h>   const text = completion.choices?.[0]?.message?.content ?? '';
[?2004l[?2004h>   return text;
[?2004l[?2004h> }
[?2004l[?2004h> 
[?2004l[?2004h> async function main(): Promise<void> {
[?2004l[?2004h>   const argv = minimist(process.argv.slice(2));
[?2004l[?2004h>   const topic = argv.topic || argv.t;
[?2004l[?2004h>   if (!topic || typeof topic !== 'string') {
[?2004l[?2004h>     console.error('Usage: node dist/main.js --topic "<topic>"');
[?2004l[?2004h>     process.exit(1);
[?2004l[?2004h>   }
[?2004l[?2004h> 
[?2004l[?2004h>   const alchemystKey = process.env.ALCHEMYST_AI_API_KEY;
[?2004l[?2004h>   const openaiKey = process.env.OPENAI_API_KEY;
[?2004l[?2004h>   if (!alchemystKey) {
[?2004l[?2004h>     console.error('Missing ALCHEMYST_AI_API_KEY environment variable.');
[?2004l[?2004h>     process.exit(1);
[?2004l[?2004h>   }
[?2004l[?2004h>   if (!openaiKey) {
[?2004l[?2004h>     console.error('Missing OPENAI_API_KEY environment variable.');
[?2004l[?2004h>     process.exit(1);
[?2004l[?2004h>   }
[?2004l[?2004h> 
[?2004l[?2004h>   const runId = getRunId();
[?2004l[?2004h>   console.log(`[newsletter] Using run-id: ${runId}`);
[?2004l[?2004h>   console.log(`[newsletter] Topic: ${topic}`);
[?2004l[?2004h> 
[?2004l[?2004h>   const alchemyst = new AlchemystAI({ apiKey: alchemystKey });
[?2004l[?2004h> 
[?2004l[?2004h>   // 1) Seed articles
[?2004l[?2004h>   const articles = buildArticles(runId);
[?2004l[?2004h>   console.log(`[newsletter] Seeding ${articles.length} articles into context engine...`);
[?2004l[?2004h>   try {
[?2004l[?2004h>     await seedArticles(alchemyst, articles);
[?2004l[?2004h>     console.log('[newsletter] Seeding complete.');
[?2004l[?2004h>   } catch (err: any) {
[?2004l[?2004h>     console.error(`[newsletter] Failed to seed articles: ${err.message}`);
[?2004l[?2004h>     throw err;
[?2004l[?2004h>   }
[?2004l[?2004h> 
[?2004l[?2004h>   // 2) Search context
[?2004l[?2004h>   console.log('[newsletter] Searching context engine...');
[?2004l[?2004h>   const contexts = await searchContext(alchemyst, topic);
[?2004l[?2004h>   console.log(`[newsletter] Retrieved ${contexts.length} context snippet(s).`);
[?2004l[?2004h> 
[?2004l[?2004h>   const grounding = contexts.map((c) => c.content).join('\n\n');
[?2004l[?2004h>   if (!grounding.trim()) {
[?2004l[?2004h>     console.warn('[newsletter] Warning: no grounding context was retrieved; continuing anyway.');
[?2004l[?2004h>   }
[?2004l[?2004h> 
[?2004l[?2004h>   // 3) Generate newsletter
[?2004l[?2004h>   console.log('[newsletter] Generating newsletter with OpenAI...');
[?2004l[?2004h>   const newsletter = await generateNewsletter(topic, grounding);
[?2004l[?2004h>   if (!newsletter.trim()) {
[?2004l[?2004h>     throw new Error('OpenAI returned empty content.');
[?2004l[?2004h>   }
[?2004l[?2004h> 
[?2004l[?2004h>   // 4) Persist
[?2004l[?2004h>   fs.mkdirSync(OUTPUT_DIR, { recursive: true });
