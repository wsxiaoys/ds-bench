[51.592812, "o", "  file_name: string;\r\n\u001b[?2004l\r"]
[51.592854, "o", "\u001b[?2004h> "]
[51.592908, "o", "  content: string;\r\n\u001b[?2004l\r"]
[51.592949, "o", "\u001b[?2004h> }\r\n\u001b[?2004l\r"]
[51.592991, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[51.593032, "o", "> "]
[51.593115, "o", "function getRunId(): string {\r\n\u001b[?2004l\r"]
[51.593157, "o", "\u001b[?2004h> "]
[51.593199, "o", "  try {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[51.593438, "o", "    const runId = fs.readFileSync(RUN_ID_PATH, 'utf8').trim();\r\n\u001b[?2004l\r"]
[51.593462, "o", "\u001b[?2004h> "]
[51.593535, "o", "    if (!runId) {\r\n\u001b[?2004l\r"]
[51.593576, "o", "\u001b[?2004h> "]
[51.593709, "o", "      throw new Error('run-id is empty');\r\n\u001b[?2004l\r"]
[51.593732, "o", "\u001b[?2004h> "]
[51.593754, "o", "    }\r\n\u001b[?2004l\r"]
[51.593777, "o", "\u001b[?2004h> "]
[51.593861, "o", "    return runId;\r\n\u001b[?2004l\r\u001b[?2004h"]
[51.593902, "o", "> "]
[51.593962, "o", "  } catch (err: any) {\r\n\u001b[?2004l\r"]
[51.593985, "o", "\u001b[?2004h> "]
[51.59429, "o", "    throw new Error(`Failed to read run-id from ${RUN_ID_PATH}: ${err.message}`);\r\n\u001b[?2004l\r"]
[51.594314, "o", "\u001b[?2004h> "]
[51.594369, "o", "  }\r\n\u001b[?2004l\r\u001b[?2004h"]
[51.594415, "o", "> }\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[51.594458, "o", "\u001b[?2004h> "]
[51.594624, "o", "function buildArticles(runId: string): Article[] {\r\n\u001b[?2004l\r"]
[51.594664, "o", "\u001b[?2004h> "]
[51.594705, "o", "  return [\r\n\u001b[?2004l\r\u001b[?2004h"]
[51.594745, "o", ">     {\r\n\u001b[?2004l\r"]
[51.594786, "o", "\u001b[?2004h> "]
[51.595017, "o", "      file_name: `b2b_article_ai_agents_${runId}.md`,\r\n\u001b[?2004l\r"]
[51.59504, "o", "\u001b[?2004h> "]
[51.595123, "o", "      content:\r\n\u001b[?2004l\r"]
[51.595164, "o", "\u001b[?2004h> "]
[51.596806, "o", "        'AI agents are REDACTEDnomous software systems built on top of large language models (LLMs). They plan multi-step workflows, call external tools, and reflect on their own outputs. Modern agentic systems combine planning, tool use, memory, and orchestration to REDACTEDmate knowledge work. Keywords: REDACTEDnomous, agentic, planning, tool use, orchestration.',\r\n\u001b[?2004l\r"]
[51.596859, "o", "\u001b[?2004h>     },"]
[51.596902, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[51.596949, "o", "    {\r\n\u001b[?2004l\r\u001b[?2004h"]
[51.596991, "o", "> "]
[51.597171, "o", "      file_name: `b2b_article_rag_${runId}.md`,\r\n\u001b[?2004l\r"]
[51.597213, "o", "\u001b[?2004h> "]
[51.59727, "o", "      content:\r\n\u001b[?2004l\r"]
[51.597291, "o", "\u001b[?2004h> "]
[51.598577, "o", "        'Retrieval-Augmented Generation (RAG) augments LLM prompts with snippets retrieved from a vector store. Documents are chunked, embedded, and indexed; at query time a semantic search returns the most relevant chunks and the LLM grounds its answer in that retrieved context.',\r\n\u001b[?2004l\r"]
[51.598602, "o", "\u001b[?2004h> "]
[51.598626, "o", "    },\r\n\u001b[?2004l\r"]
[51.598708, "o", "\u001b[?2004h>     {\r\n\u001b[?2004l\r"]
[51.598752, "o", "\u001b[?2004h> "]
[51.598955, "o", "      file_name: `b2b_article_vector_db_${runId}.md`,\r\n\u001b[?2004l\r"]
[51.598996, "o", "\u001b[?2004h> "]
[51.599054, "o", "      content:\r\n\u001b[?2004l\r"]
[51.599076, "o", "\u001b[?2004h> "]
[51.600331, "o", "        'Vector databases such as Pinecone, Weaviate, and pgvector store high-dimensional embeddings and support approximate nearest neighbor search. They power semantic retrieval over unstructured text, images, and code by mapping content into a shared embedding space.',\r\n\u001b[?2004l\r"]
[51.600381, "o", "\u001b[?2004h>     },\r\n\u001b[?2004l\r"]
[51.600419, "o", "\u001b[?2004h>     {"]
[51.600452, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[51.600749, "o", "      file_name: `b2b_article_prompt_engineering_${runId}.md`,\r\n\u001b[?2004l\r"]
[51.60077, "o", "\u001b[?2004h> "]
[51.600846, "o", "      content:\r\n\u001b[?2004l\r"]
[51.600866, "o", "\u001b[?2004h> "]
[51.602232, "o", "        'Prompt engineering is the practice of designing effective instructions for large language models. Common techniques include few-shot examples, chain-of-thought reasoning, role prompts, and structured output formats such as JSON. Good prompts reduce hallucinations and improve task performance.',\r\n\u001b[?2004l\r"]
[51.602254, "o", "\u001b[?2004h> "]
[51.602311, "o", "    },\r\n\u001b[?2004l\r\u001b[?2004h"]
[51.602355, "o", "> "]
[51.602388, "o", "    {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[51.602578, "o", "      file_name: `b2b_article_devops_${runId}.md`,\r\n\u001b[?2004l\r"]
[51.6026, "o", "\u001b[?2004h> "]
[51.602679, "o", "      content:\r\n\u001b[?2004l\r"]
[51.602701, "o", "\u001b[?2004h> "]
[51.603786, "o", "        'DevOps practices accelerate software delivery through continuous integration, continuous deployment, infrastructure-as-code, and observability. Tools such as Kubernetes, Terraform, and GitHub Actions REDACTEDmate provisioning, deployment, and monitoring of production systems.',\r\n\u001b[?2004l\r"]
[51.603809, "o", "\u001b[?2004h> "]
[51.603854, "o", "    },\r\n\u001b[?2004l\r"]
[51.603876, "o", "\u001b[?2004h> "]
[51.603916, "o", "  ];\r\n\u001b[?2004l\r\u001b[?2004h"]
[51.603938, "o", "> }\r\n\u001b[?2004l\r"]
[51.603959, "o", "\u001b[?2004h"]
[51.603983, "o", "> \r\n\u001b[?2004l\r"]
[51.604007, "o", "\u001b[?2004h> "]
[51.604409, "o", "async function seedArticles(client: AlchemystAI, articles: Article[]): Promise<void> {\r\n\u001b[?2004l\r"]
[51.604432, "o", "\u001b[?2004h> "]
[51.604628, "o", "  const documents = articles.map((a) => ({\r\n\u001b[?2004l\r"]
[51.60465, "o", "\u001b[?2004h> "]
[51.604751, "o", "    content: a.content,\r\n\u001b[?2004l\r"]
[51.604772, "o", "\u001b[?2004h> "]
[51.604848, "o", "    metadata: {\r\n\u001b[?2004l\r"]
[51.604869, "o", "\u001b[?2004h> "]
[51.605011, "o", "      file_name: a.file_name,\r\n\u001b[?2004l\r"]
[51.605032, "o", "\u001b[?2004h> "]
[51.605164, "o", "      context_type: 'resource',\r\n\u001b[?2004l\r"]
[51.605185, "o", "\u001b[?2004h> "]
[51.605282, "o", "      scope: 'internal',\r\n\u001b[?2004l\r"]
[51.605304, "o", "\u001b[?2004h"]
[51.60535, "o", ">     },\r\n\u001b[?2004l\r"]
[51.605371, "o", "\u001b[?2004h"]
[51.605393, "o", "> "]
[51.605414, "o", "  }));\r\n\u001b[?2004l\r"]
[51.605471, "o", "\u001b[?2004h> "]
[51.605805, "o", "  // The SDK exposes v1.context.add. It is safe to call repeatedly as long as\r\n\u001b[?2004l\r"]
[51.605827, "o", "\u001b[?2004h> "]
[51.606152, "o", "  // file_name values are unique per run (we namespace with run-id).\r\n\u001b[?2004l\r"]
[51.606175, "o", "\u001b[?2004h> "]
[51.606524, "o", "  // Use a no-similarity-grouping strategy so we don't require an existing group.\r\n\u001b[?2004l\r"]
[51.606549, "o", "\u001b[?2004h> "]
[51.606869, "o", "  // eslint-disable-next-line @typescript-eslint/no-explicit-any\r\n\u001b[?2004l\r\u001b[?2004h"]
[51.606905, "o", "> "]
[51.607071, "o", "  await (client as any).v1.context.add({\r\n\u001b[?2004l\r"]
[51.607116, "o", "\u001b[?2004h> "]
[51.607156, "o", "    documents,\r\n\u001b[?2004l\r"]
[51.607213, "o", "\u001b[?2004h> "]
[51.607336, "o", "    context_type: 'resource',\r\n\u001b[?2004l\r"]
[51.607361, "o", "\u001b[?2004h> "]
[51.60745, "o", "    scope: 'internal',\r\n\u001b[?2004l\r"]
[51.607474, "o", "\u001b[?2004h> "]
[51.607522, "o", "  });\r\n\u001b[?2004l\r\u001b[?2004h"]
[51.60756, "o", "> }\r\n\u001b[?2004l\r\u001b[?2004h"]
[51.607599, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h"]
[51.607636, "o", "> "]
[51.607998, "o", "async function searchContext(client: AlchemystAI, topic: string): Promise<{ content: string }[]> {\r\n\u001b[?2004l\r"]
[51.608022, "o", "\u001b[?2004h> "]
[51.608329, "o", "  // eslint-disable-next-line @typescript-eslint/no-explicit-any\r\n\u001b[?2004l\r"]
[51.608353, "o", "\u001b[?2004h> "]
[51.608605, "o", "  const result: any = await (client as any).v1.context.search({\r\n\u001b[?2004l\r"]
[51.608628, "o", "\u001b[?2004h"]
[51.608667, "o", "> "]
[51.6087, "o", "    query: topic,\r\n\u001b[?2004l\r"]
[51.608722, "o", "\u001b[?2004h"]
[51.608745, "o", "> "]
[51.608835, "o", "    context_type: 'resource',\r\n\u001b[?2004l\r"]
[51.608856, "o", "\u001b[?2004h> "]
[51.608941, "o", "    scope: 'internal',\r\n\u001b[?2004l\r"]
[51.608962, "o", "\u001b[?2004h> "]
[51.609149, "o", "    // Retrieve enough snippets to ground the newsletter\r\n\u001b[?2004l\r"]
[51.609171, "o", "\u001b[?2004h> "]
[51.609224, "o", "    top_k: 5,\r\n\u001b[?2004l\r"]
[51.609245, "o", "\u001b[?2004h> "]
[51.609284, "o", "  });\r\n\u001b[?2004l\r\u001b[?2004h"]
[51.609305, "o", "> \r\n\u001b[?2004l\r"]
[51.609344, "o", "\u001b[?2004h> "]
[51.609629, "o", "  // The SDK may return either { contexts: [...] } or { data: [...] } depending on version.\r\n\u001b[?2004l\r"]
[51.60965, "o", "\u001b[?2004h> "]
[51.60974, "o", "  const contexts: any[] =\r\n\u001b[?2004l\r"]
[51.60976, "o", "\u001b[?2004h> "]
[51.609949, "o", "    (Array.isArray(result?.contexts) && result.contexts) ||\r\n\u001b[?2004l\r"]
[51.60997, "o", "\u001b[?2004h> "]
[51.610136, "o", "    (Array.isArray(result?.data) && result.data) ||\r\n\u001b[?2004l\r"]
[51.610157, "o", "\u001b[?2004h> "]
[51.610352, "o", "    (Array.isArray(result?.results) && result.results) ||\r\n\u001b[?2004l\r"]
[51.610375, "o", "\u001b[?2004h> "]
[51.610502, "o", "    (Array.isArray(result) && result) ||\r\n\u001b[?2004l\r"]
[51.610523, "o", "\u001b[?2004h> "]
[51.610558, "o", "    [];\r\n\u001b[?2004l\r"]
[51.610578, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[51.61061, "o", "\u001b[?2004h> "]
[51.610882, "o", "  return contexts.map((c: any) => ({ content: String(c.content ?? c.text ?? '') }));\r\n\u001b[?2004l\r"]
[51.610905, "o", "\u001b[?2004h> }\r\n"]
[51.610926, "o", "\u001b[?2004l\r\u001b[?2004h"]
[51.610975, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[51.611244, "o", "async function generateNewsletter(topic: string, grounding: string): Promise<string> {\r\n\u001b[?2004l\r"]
[51.611267, "o", "\u001b[?2004h> "]
[51.611495, "o", "  const openai = new OpenAI({ apiKey: process.env.OPENAI_API_KEY });\r\n\u001b[?2004l\r"]
[51.611519, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[51.611559, "o", "\u001b[?2004h> "]
[51.611631, "o", "  const systemPrompt =\r\n\u001b[?2004l\r"]
[51.611652, "o", "\u001b[?2004h> "]
[51.612139, "o", "    'You are a B2B newsletter writer. Produce concise, professional newsletters grounded in the supplied research context. Always output valid Markdown.';\r\n\u001b[?2004l\r"]
[51.612163, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[51.612185, "o", "\u001b[?2004h"]
[51.612208, "o", "> "]
[51.612442, "o", "  const userPrompt = `Write a short B2B newsletter on the topic: \"${topic}\".\r\n\u001b[?2004l\r"]
[51.612463, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[51.612511, "o", "\u001b[?2004h> "]
[51.612833, "o", "Use only the following research context as factual grounding. Do not invent facts beyond what is provided.\r\n\u001b[?2004l\r\u001b[?2004h"]
[51.612883, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[51.612966, "o", "=== RESEARCH CONTEXT ===\r\n\u001b[?2004l\r"]
[51.612995, "o", "\u001b[?2004h> "]
[51.613069, "o", "${grounding}\r\n\u001b[?2004l\r\u001b[?2004h> "]
[51.613135, "o", "=== END CONTEXT ===\r\n\u001b[?2004l\r"]
[51.613158, "o", "\u001b[?2004h> "]
[51.613207, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[51.613243, "o", "Requirements:\r\n\u001b[?2004l\r"]
[51.613266, "o", "\u001b[?2004h> "]
[51.613381, "o", "- Output MUST be valid Markdown.\r\n\u001b[?2004l\r"]
[51.613404, "o", "\u001b[?2004h> "]
[51.613804, "o", "- The newsletter MUST contain at least three sections, each introduced by a Markdown heading line (starting with #, ##, or ###).\r\n\u001b[?2004l\r"]
[51.613826, "o", "\u001b[?2004h> "]
[51.614018, "o", "- Include at least these three sections (you may add more):\r\n\u001b[?2004l\r"]
[51.614041, "o", "\u001b[?2004h> "]
[51.61411, "o", "  ## Why it matters\r\n\u001b[?2004l\r"]
[51.614133, "o", "\u001b[?2004h> "]
[51.61419, "o", "  ## What\\'s new\r\n\u001b[?2004l\r"]
[51.614214, "o", "\u001b[?2004h> "]
[51.614284, "o", "  ## What to do next\r\n\u001b[?2004l\r"]
[51.614308, "o", "\u001b[?2004h> "]
[51.614471, "o", "- Keep it concise (roughly 250-500 words total).\r\n\u001b[?2004l\r"]
[51.614496, "o", "\u001b[?2004h> "]
[51.6147, "o", "- Address a B2B audience (decision-makers, engineering leaders).\r\n\u001b[?2004l\r"]
[51.614723, "o", "\u001b[?2004h> "]
[51.614925, "o", "- Reference concrete details drawn from the research context.`;\r\n\u001b[?2004l\r"]
[51.614949, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[51.614975, "o", "\u001b[?2004h> "]
[51.615171, "o", "  const completion = await openai.chat.completions.create({\r\n\u001b[?2004l\r"]
[51.615193, "o", "\u001b[?2004h> "]
[51.615285, "o", "    model: 'gpt-4o-mini',\r\n\u001b[?2004l\r"]
[51.615309, "o", "\u001b[?2004h> "]
[51.615384, "o", "    messages: [\r\n\u001b[?2004l\r\u001b[?2004h"]
[51.615423, "o", "> "]
[51.615556, "o", "      { role: 'system', content: systemPrompt },\r\n\u001b[?2004l\r"]
[51.615579, "o", "\u001b[?2004h> "]
[51.615727, "o", "      { role: 'user', content: userPrompt },\r\n\u001b[?2004l\r"]
[51.615747, "o", "\u001b[?2004h> "]
[51.61578, "o", "    ],\r\n\u001b[?2004l\r"]
[51.61582, "o", "\u001b[?2004h> "]
[51.615875, "o", "    temperature: 0.7,\r\n\u001b[?2004l\r"]
[51.615896, "o", "\u001b[?2004h> "]
[51.615938, "o", "  });\r\n\u001b[?2004l\r\u001b[?2004h"]
[51.615959, "o", "> \r\n\u001b[?2004l\r"]
[51.615997, "o", "\u001b[?2004h> "]
[51.616178, "o", "  const text = completion.choices?.[0]?.message?.content ?? '';\r\n\u001b[?2004l\r"]
[51.6162, "o", "\u001b[?2004h> "]
[51.61626, "o", "  return text;\r\n\u001b[?2004l\r"]
[51.616281, "o", "\u001b[?2004h> "]
[51.616304, "o", "}\r\n\u001b[?2004l\r"]
[51.616359, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[51.616489, "o", "async function main(): Promise<void> {\r\n\u001b[?2004l\r"]
[51.61651, "o", "\u001b[?2004h> "]
[51.616663, "o", "  const argv = minimist(process.argv.slice(2));\r\n\u001b[?2004l\r"]
[51.616685, "o", "\u001b[?2004h> "]
[51.616807, "o", "  const topic = argv.topic || argv.t;\r\n\u001b[?2004l\r"]
[51.61683, "o", "\u001b[?2004h> "]
[51.616978, "o", "  if (!topic || typeof topic !== 'string') {\r\n\u001b[?2004l\r"]
[51.617001, "o", "\u001b[?2004h> "]
[51.617279, "o", "    console.error('Usage: node dist/main.js --topic \"<topic>\"');\r\n\u001b[?2004l\r"]
[51.617315, "o", "\u001b[?2004h> "]
[51.617389, "o", "    process.exit(1);\r\n\u001b[?2004l\r"]
[51.617426, "o", "\u001b[?2004h>   }\r\n\u001b[?2004l\r"]
[51.617461, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[51.617495, "o", "\u001b[?2004h> "]
[51.617669, "o", "  const alchemystKey = process.env.ALCHEMYST_AI_API_KEY;\r\n\u001b[?2004l\r"]
[51.617691, "o", "\u001b[?2004h> "]
[51.617844, "o", "  const openaiKey = process.env.OPENAI_API_KEY;\r\n\u001b[?2004l\r"]
[51.617867, "o", "\u001b[?2004h> "]
[51.617945, "o", "  if (!alchemystKey) {\r\n\u001b[?2004l\r"]
[51.617967, "o", "\u001b[?2004h> "]
[51.618198, "o", "    console.error('Missing ALCHEMYST_AI_API_KEY environment variable.');\r\n\u001b[?2004l\r"]
[51.618229, "o", "\u001b[?2004h> "]
[51.618289, "o", "    process.exit(1);\r\n\u001b[?2004l\r"]
[51.618332, "o", "\u001b[?2004h>   }\r\n\u001b[?2004l\r"]
[51.618363, "o", "\u001b[?2004h> "]
[51.618424, "o", "  if (!openaiKey) {\r\n\u001b[?2004l\r"]
[51.618448, "o", "\u001b[?2004h> "]
[51.618674, "o", "    console.error('Missing OPENAI_API_KEY environment variable.');\r\n\u001b[?2004l\r"]
[51.618696, "o", "\u001b[?2004h> "]
[51.618762, "o", "    process.exit(1);\r\n\u001b[?2004l\r"]
[51.618783, "o", "\u001b[?2004h> "]
[51.618806, "o", "  }\r\n\u001b[?2004l\r"]
[51.618829, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[51.618851, "o", "\u001b[?2004h> "]
[51.618948, "o", "  const runId = getRunId();\r\n\u001b[?2004l\r"]
[51.618969, "o", "\u001b[?2004h> "]
[51.619168, "o", "  console.log(`[newsletter] Using run-id: ${runId}`);\r\n\u001b[?2004l\r"]
[51.619201, "o", "\u001b[?2004h> "]
[51.61936, "o", "  console.log(`[newsletter] Topic: ${topic}`);\r\n\u001b[?2004l\r"]
[51.619381, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[51.619423, "o", "\u001b[?2004h> "]
[51.619607, "o", "  const alchemyst = new AlchemystAI({ apiKey: alchemystKey });\r\n\u001b[?2004l\r"]
[51.61963, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[51.619656, "o", "\u001b[?2004h> "]
[51.619737, "o", "  // 1) Seed articles\r\n\u001b[?2004l\r"]
[51.619768, "o", "\u001b[?2004h> "]
[51.619885, "o", "  const articles = buildArticles(runId);\r\n\u001b[?2004l\r"]
[51.619908, "o", "\u001b[?2004h> "]
[51.620189, "o", "  console.log(`[newsletter] Seeding ${articles.length} articles into context engine...`);\r\n\u001b[?2004l\r"]
[51.620211, "o", "\u001b[?2004h> "]
[51.620241, "o", "  try {\r\n\u001b[?2004l\r"]
[51.620272, "o", "\u001b[?2004h> "]
[51.620412, "o", "    await seedArticles(alchemyst, articles);\r\n\u001b[?2004l\r"]
[51.620434, "o", "\u001b[?2004h> "]
[51.620592, "o", "    console.log('[newsletter] Seeding complete.');\r\n\u001b[?2004l\r"]
[51.620623, "o", "\u001b[?2004h> "]
[51.620688, "o", "  } catch (err: any) {\r\n\u001b[?2004l\r"]
[51.620708, "o", "\u001b[?2004h> "]
[51.620948, "o", "    console.error(`[newsletter] Failed to seed articles: ${err.message}`);\r\n\u001b[?2004l\r"]
[51.620979, "o", "\u001b[?2004h> "]
[51.621021, "o", "    throw err;\r\n\u001b[?2004l\r"]
[51.621054, "o", "\u001b[?2004h> "]
[51.621081, "o", "  }\r\n\u001b[?2004l\r\u001b[?2004h"]
[51.621102, "o", "> \r\n\u001b[?2004l\r"]
[51.621127, "o", "\u001b[?2004h> "]
[51.62123, "o", "  // 2) Search context\r\n\u001b[?2004l\r"]
[51.621275, "o", "\u001b[?2004h> "]
[51.621449, "o", "  console.log('[newsletter] Searching context engine...');\r\n\u001b[?2004l\r"]
[51.621476, "o", "\u001b[?2004h> "]
[51.621652, "o", "  const contexts = await searchContext(alchemyst, topic);\r\n\u001b[?2004l\r"]
[51.621694, "o", "\u001b[?2004h> "]
[51.621922, "o", "  console.log(`[newsletter] Retrieved ${contexts.length} context snippet(s).`);\r\n\u001b[?2004l\r"]
[51.621948, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[51.621996, "o", "\u001b[?2004h> "]
[51.622177, "o", "  const grounding = contexts.map((c) => c.content).join('\\n\\n');\r\n\u001b[?2004l\r"]
[51.622218, "o", "\u001b[?2004h> "]
[51.622287, "o", "  if (!grounding.trim()) {\r\n\u001b[?2004l\r"]
[51.622333, "o", "\u001b[?2004h> "]
[51.622616, "o", "    console.warn('[newsletter] Warning: no grounding context was retrieved; continuing anyway.');\r\n\u001b[?2004l\r"]
[51.622643, "o", "\u001b[?2004h> "]
[51.62267, "o", "  }\r\n\u001b[?2004l\r\u001b[?2004h"]
[51.622734, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[51.6228, "o", "  // 3) Generate newsletter\r\n\u001b[?2004l\r"]
[51.622837, "o", "\u001b[?2004h> "]
[51.623033, "o", "  console.log('[newsletter] Generating newsletter with OpenAI...');\r\n\u001b[?2004l\r"]
[51.623059, "o", "\u001b[?2004h> "]
[51.623263, "o", "  const newsletter = await generateNewsletter(topic, grounding);\r\n\u001b[?2004l\r"]
[51.623289, "o", "\u001b[?2004h> "]
[51.623382, "o", "  if (!newsletter.trim()) {\r\n\u001b[?2004l\r"]
[51.623405, "o", "\u001b[?2004h> "]
[51.623575, "o", "    throw new Error('OpenAI returned empty content.');\r\n\u001b[?2004l\r"]
[51.623598, "o", "\u001b[?2004h> "]
[51.623644, "o", "  }\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[51.623668, "o", "\u001b[?2004h> "]
[51.623727, "o", "  // 4) Persist\r\n\u001b[?2004l\r"]
[51.623763, "o", "\u001b[?2004h> "]
[51.623899, "o", "  fs.mkdirSync(OUTPUT_DIR, { recursive: true });\r\n\u001b[?2004l\r"]
[51.62392, "o", "\u001b[?2004h> "]
[51.624088, "o", "  fs.writeFileSync(OUTPUT_PATH, newsletter, 'utf8');\r\n\u001b[?2004l\r"]
[51.624109, "o", "\u001b[?2004h> "]
[51.624323, "o", "  console.log(`[newsletter] Wrote newsletter to ${OUTPUT_PATH}`);\r\n\u001b[?2004l\r"]
[51.624347, "o", "\u001b[?2004h"]
[51.624372, "o", "> }\r\n\u001b[?2004l\r"]
[51.624399, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[51.624423, "o", "\u001b[?2004h> "]
[51.624513, "o", "main().catch((err) => {\r\n\u001b[?2004l\r"]
[51.624557, "o", "\u001b[?2004h> "]
[51.624694, "o", "  console.error('[newsletter] Fatal error:', err);\r\n\u001b[?2004l\r"]
[51.624716, "o", "\u001b[?2004h> "]
[51.624783, "o", "  process.exit(1);\r\n\u001b[?2004l\r"]
[51.624805, "o", "\u001b[?2004h> "]
[51.624851, "o", "});\r\n\u001b[?2004l\r\u001b[?2004h> "]
[51.62489, "o", "TSEOF\r\n\u001b[?2004l\r"]
