[331.093803, "o", "async function searchContext(client: any, topic: string): Promise<string[]> {\r\n\u001b[?2004l\r"]
[331.093854, "o", "\u001b[?2004h> "]
[331.09429, "o", "  const result: any = await client.v1.context.search({\r\n\u001b[?2004l\r"]
[331.094377, "o", "\u001b[?2004h> "]
[331.094499, "o", "    query: topic,\r\n\u001b[?2004l\r"]
[331.094572, "o", "\u001b[?2004h> "]
[331.094755, "o", "    scope: 'internal',\r\n\u001b[?2004l\r"]
[331.094806, "o", "\u001b[?2004h"]
[331.094896, "o", "> "]
[331.095086, "o", "    similarity_threshold: 0.8,\r\n\u001b[?2004l\r"]
[331.095138, "o", "\u001b[?2004h> "]
[331.095457, "o", "    minimum_similarity_threshold: 0.0,\r\n\u001b[?2004l\r"]
[331.09553, "o", "\u001b[?2004h> "]
[331.09571, "o", "    mode: 'standard',\r\n\u001b[?2004l\r"]
[331.095785, "o", "\u001b[?2004h> "]
[331.095855, "o", "  });\r\n\u001b[?2004l\r"]
[331.095911, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[331.095969, "o", "\u001b[?2004h> "]
[331.09619, "o", "  const contexts: any[] =\r\n\u001b[?2004l\r"]
[331.096264, "o", "\u001b[?2004h> "]
[331.096739, "o", "    (Array.isArray(result?.contexts) && result.contexts) ||\r\n\u001b[?2004l\r"]
[331.096789, "o", "\u001b[?2004h> "]
[331.097215, "o", "    (Array.isArray(result?.data) && result.data) ||\r\n\u001b[?2004l\r"]
[331.097286, "o", "\u001b[?2004h> "]
[331.097736, "o", "    (Array.isArray(result?.results) && result.results) ||\r\n\u001b[?2004l\r"]
[331.097814, "o", "\u001b[?2004h> "]
[331.097887, "o", "    [];\r\n\u001b[?2004l\r"]
