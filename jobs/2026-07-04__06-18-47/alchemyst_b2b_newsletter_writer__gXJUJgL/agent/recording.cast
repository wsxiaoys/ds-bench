[270.280965, "o", "\u001b[?2004h> "]
[270.281054, "o", "  const contexts: any[] =\r\n\u001b[?2004l\r"]
[270.281091, "o", "\u001b[?2004h> "]
[270.281266, "o", "    (Array.isArray(result?.contexts) && result.contexts) ||\r\n\u001b[?2004l\r\u001b[?2004h"]
[270.281302, "o", "> "]
[270.281455, "o", "    (Array.isArray(result?.data) && result.data) ||\r\n\u001b[?2004l\r\u001b[?2004h"]
[270.281492, "o", "> "]
