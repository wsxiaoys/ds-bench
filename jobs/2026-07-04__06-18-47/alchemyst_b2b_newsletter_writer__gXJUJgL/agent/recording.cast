[331.100025, "o", "async function generateNewsletter(topic: string, grounding: string): Promise<string> {\r\n\u001b[?2004l\r"]
[331.100073, "o", "\u001b[?2004h> "]
[331.100607, "o", "  const openai = new OpenAI({ apiKey: process.env.OPENAI_API_KEY });\r\n\u001b[?2004l\r"]
[331.100657, "o", "\u001b[?2004h> \r\n"]
[331.100707, "o", "\u001b[?2004l\r\u001b[?2004h"]
[331.100758, "o", "> "]
[331.100931, "o", "  const systemPrompt =\r\n\u001b[?2004l\r"]
[331.100984, "o", "\u001b[?2004h> "]
[331.102149, "o", "    'You are a B2B newsletter writer. Produce concise, professional newsletters grounded in the supplied research context. Always output valid Markdown.';\r\n\u001b[?2004l\r"]
[331.102199, "o", "\u001b[?2004h> \r\n"]
[331.102249, "o", "\u001b[?2004l\r\u001b[?2004h"]
[331.1023, "o", "> "]
[331.102459, "o", "  const userPrompt =\r\n\u001b[?2004l\r"]
[331.10251, "o", "\u001b[?2004h> "]
[331.10306, "o", "    'Write a short B2B newsletter on the topic: \"' + topic + '\".\\n\\n' +\r\n\u001b[?2004l\r"]
[331.10311, "o", "\u001b[?2004h> "]
[331.104047, "o", "    'Use only the following research context as factual grounding. Do not invent facts beyond what is provided.\\n\\n' +\r\n\u001b[?2004l\r"]
[331.104144, "o", "\u001b[?2004h> "]
[331.104687, "o", "    '=== RESEARCH CONTEXT ===\\n' + grounding + '\\n=== END CONTEXT ===\\n\\n' +\r\n\u001b[?2004l\r"]
[331.10476, "o", "\u001b[?2004h> "]
[331.104934, "o", "    'Requirements:\\n' +\r\n\u001b[?2004l\r"]
[331.104993, "o", "\u001b[?2004h> "]
[331.105333, "o", "    '- Output MUST be valid Markdown.\\n' +\r\n\u001b[?2004l\r"]
[331.105415, "o", "\u001b[?2004h> "]
[331.106444, "o", "    '- The newsletter MUST contain at least three sections, each introduced by a Markdown heading line (starting with #, ##, or ###).\\n' +\r\n\u001b[?2004l\r"]
[331.106521, "o", "\u001b[?2004h> "]
[331.107022, "o", "    '- Include at least these three sections (you may add more):\\n' +\r\n\u001b[?2004l\r"]
[331.107086, "o", "\u001b[?2004h> "]
[331.107315, "o", "    '  ## Why it matters\\n' +\r\n\u001b[?2004l\r"]
[331.107395, "o", "\u001b[?2004h> "]
[331.107582, "o", "    \"  ## What's new\\n\" +\r\n\u001b[?2004l\r"]
[331.107654, "o", "\u001b[?2004h> "]
[331.107882, "o", "    '  ## What to do next\\n' +\r\n\u001b[?2004l\r"]
[331.107951, "o", "\u001b[?2004h> "]
[331.108429, "o", "    '- Keep it concise (roughly 250-500 words total).\\n' +\r\n\u001b[?2004l\r\u001b[?2004h"]
[331.108503, "o", "> "]
[331.109018, "o", "    '- Address a B2B audience (decision-makers, engineering leaders).\\n' +\r\n\u001b[?2004l\r"]
[331.109085, "o", "\u001b[?2004h> "]
[331.109624, "o", "    '- Reference concrete details drawn from the research context.';\r\n\u001b[?2004l\r"]
[331.109688, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[331.10976, "o", "\u001b[?2004h> "]
[331.110227, "o", "  const completion = await openai.chat.completions.create({\r\n\u001b[?2004l\r"]
[331.110291, "o", "\u001b[?2004h> "]
[331.110503, "o", "    model: 'gpt-4o-mini',\r\n\u001b[?2004l\r"]
[331.110573, "o", "\u001b[?2004h> "]
[331.11069, "o", "    messages: [\r\n\u001b[?2004l\r"]
[331.110756, "o", "\u001b[?2004h> "]
[331.11112, "o", "      { role: 'system', content: systemPrompt },\r\n\u001b[?2004l\r"]
[331.11119, "o", "\u001b[?2004h> "]
[331.111531, "o", "      { role: 'user', content: userPrompt },\r\n\u001b[?2004l\r"]
[331.111597, "o", "\u001b[?2004h> "]
[331.111666, "o", "    ],\r\n\u001b[?2004l\r"]
[331.111723, "o", "\u001b[?2004h> "]
[331.111915, "o", "    temperature: 0.7,\r\n\u001b[?2004l\r"]
[331.111984, "o", "\u001b[?2004h> "]
[331.11205, "o", "  });\r\n\u001b[?2004l\r"]
[331.112116, "o", "\u001b[?2004h> "]
[331.112182, "o", "\r\n\u001b[?2004l\r\u001b[?2004h"]
[331.112247, "o", "> "]
[331.112711, "o", "  const text = completion.choices?.[0]?.message?.content ?? '';\r\n\u001b[?2004l\r"]
[331.112772, "o", "\u001b[?2004h> "]
[331.112916, "o", "  return text;\r\n\u001b[?2004l\r"]
[331.112986, "o", "\u001b[?2004h> "]
[331.113055, "o", "}\r\n\u001b[?2004l\r\u001b[?2004h"]
[331.113121, "o", "> ''')\r\n\u001b[?2004l\r"]
