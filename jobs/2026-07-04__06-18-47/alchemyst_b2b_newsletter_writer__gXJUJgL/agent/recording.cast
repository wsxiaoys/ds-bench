[270.282545, "o", "async function generateNewsletter(topic: string, grounding: string): Promise<string> {\r\n\u001b[?2004l\r\u001b[?2004h"]
[270.282584, "o", "> "]
[270.282777, "o", "  const openai = new OpenAI({ apiKey: process.env.OPENAI_API_KEY });\r\n\u001b[?2004l\r\u001b[?2004h"]
[270.282807, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h"]
[270.282896, "o", "> "]
[270.282945, "o", "  const systemPrompt =\r\n\u001b[?2004l\r\u001b[?2004h> "]
[270.283428, "o", "    'You are a B2B newsletter writer. Produce concise, professional newsletters grounded in the supplied research context. Always output valid Markdown.';\r\n\u001b[?2004l\r\u001b[?2004h"]
[270.283458, "o", "> \r\n\u001b[?2004l\r"]
[270.283483, "o", "\u001b[?2004h> "]
[270.283564, "o", "  const userPrompt =\r\n\u001b[?2004l\r"]
[270.283586, "o", "\u001b[?2004h> "]
[270.283816, "o", "    'Write a short B2B newsletter on the topic: \"' + topic + '\".\\n\\n' +\r\n\u001b[?2004l\r"]
[270.283838, "o", "\u001b[?2004h> "]
[270.284211, "o", "    'Use only the following research context as factual grounding. Do not invent facts beyond what is provided.\\n\\n' +\r\n\u001b[?2004l\r"]
[270.284236, "o", "\u001b[?2004h> "]
[270.284478, "o", "    '=== RESEARCH CONTEXT ===\\n' + grounding + '\\n=== END CONTEXT ===\\n\\n' +\r\n\u001b[?2004l\r"]
[270.284504, "o", "\u001b[?2004h> "]
[270.284576, "o", "    'Requirements:\\n' +\r\n\u001b[?2004l\r"]
[270.284602, "o", "\u001b[?2004h> "]
[270.284729, "o", "    '- Output MUST be valid Markdown.\\n' +\r\n\u001b[?2004l\r"]
[270.284756, "o", "\u001b[?2004h> "]
[270.285171, "o", "    '- The newsletter MUST contain at least three sections, each introduced by a Markdown heading line (starting with #, ##, or ###).\\n' +\r\n\u001b[?2004l\r"]
[270.285198, "o", "\u001b[?2004h> "]
[270.285423, "o", "    '- Include at least these three sections (you may add more):\\n' +\r\n\u001b[?2004l\r"]
[270.285451, "o", "\u001b[?2004h> "]
[270.285586, "o", "    '  ## Why it matters\\n' +\r\n\u001b[?2004l\r"]
[270.285713, "o", "\u001b[?2004h> "]
[270.285942, "o", "    '  ## What\\'s new\\n' +\r\n\u001b[?2004l\r\u001b[?2004h>     '  ## What to do next\\n' +\r\n\u001b[?2004l\r\u001b[?2004h"]
[270.286111, "o", "> "]
[270.286217, "o", "    '- Keep it concise (roughly 250-500 words total).\\n' +\r\n\u001b[?2004l\r\u001b[?2004h> "]
[270.286539, "o", "    '- Address a B2B audience (decision-makers, engineering leaders).\\n' +\r\n\u001b[?2004l\r"]
[270.286584, "o", "\u001b[?2004h> "]
[270.286873, "o", "    '- Reference concrete details drawn from the research context.';\r\n\u001b[?2004l\r"]
[270.286998, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[270.287052, "o", "\u001b[?2004h> "]
[270.287214, "o", "  const completion = await openai.chat.completions.create({\r\n\u001b[?2004l\r"]
[270.287253, "o", "\u001b[?2004h> "]
[270.287364, "o", "    model: 'gpt-4o-mini',\r\n\u001b[?2004l\r"]
[270.287397, "o", "\u001b[?2004h> "]
[270.287492, "o", "    messages: [\r\n\u001b[?2004l\r"]
[270.287553, "o", "\u001b[?2004h> "]
[270.287714, "o", "      { role: 'system', content: systemPrompt },\r\n\u001b[?2004l\r"]
[270.287738, "o", "\u001b[?2004h"]
[270.287862, "o", "> "]
[270.28798, "o", "      { role: 'user', content: userPrompt },\r\n\u001b[?2004l\r"]
[270.288133, "o", "\u001b[?2004h>     ],\r\n\u001b[?2004l\r\u001b[?2004h"]
[270.28824, "o", ">     temperature: 0.7,\r\n\u001b[?2004l\r\u001b[?2004h>   });\r\n\u001b[?2004l\r"]
[270.288278, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[270.288317, "o", "\u001b[?2004h> "]
[270.288615, "o", "  const text = completion.choices?.[0]?.message?.content ?? '';\r\n\u001b[?2004l\r"]
[270.288649, "o", "\u001b[?2004h> "]
[270.28872, "o", "  return text;\r\n\u001b[?2004l\r"]
[270.288778, "o", "\u001b[?2004h> "]
[270.289128, "o", "}\r\n\u001b[?2004l\r\u001b[?2004h> '''\r\n\u001b[?2004l\r\u001b[?2004h> with open('/home/user/myproject/src/main.ts', 'a') as f:\r\n\u001b[?2004l\r"]
[270.289158, "o", "\u001b[?2004h> "]
[270.289274, "o", "    f.write(content)\r\n\u001b[?2004l\r"]
[270.28934, "o", "\u001b[?2004h> "]
[270.289447, "o", "print('Part 2 written')\r\n\u001b[?2004l\r\u001b[?2004h"]
