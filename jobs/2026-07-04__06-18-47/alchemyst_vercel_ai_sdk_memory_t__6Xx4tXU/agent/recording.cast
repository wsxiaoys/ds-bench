[45.571802, "o", "\r\nadded 484 packages, and audited 686 packages in 28s\r\n⠹"]
[45.57182, "o", "\u001b[1G\u001b[0K\r\n⠹\u001b[1G\u001b[0K50 packages are looking for funding\r\n⠹"]
[45.57188, "o", "\u001b[1G\u001b[0K  run `npm fund` for details\r\n⠹"]
[45.609528, "o", "\u001b[1G\u001b[0K\r\n\u001b[31m\u001b[1m40\u001b[22m\u001b[39m vulnerabilities (1 \u001b[1mlow\u001b[22m, 15 \u001b[33m\u001b[1mmoderate\u001b[22m\u001b[39m, 16 \u001b[31m\u001b[1mhigh\u001b[22m\u001b[39m, 8 \u001b[35m\u001b[1mcritical\u001b[22m\u001b[39m)\r\n\r\nTo address issues that do not require attention, run:\r\n  npm audit fix\r\n\r\nTo address all issues (including breaking changes), run:\r\n  npm audit fix --force\r\n\r\nRun `npm audit` for details.\r\n⠸"]
[45.610102, "o", "\u001b[1G\u001b[0K\u001b[1mnpm\u001b[22m \u001b[33mwarn\u001b[39m \u001b[94mallow-scripts\u001b[39m 2 packages have install scripts not yet covered by allowScripts:\r\n\u001b[1mnpm\u001b[22m \u001b[33mwarn\u001b[39m \u001b[94mallow-scripts\u001b[39m   core-js@2.6.12 (postinstall: node -e \"try{require('./postinstall')}catch(e){}\")\r\n\u001b[1mnpm\u001b[22m \u001b[33mwarn\u001b[39m \u001b[94mallow-scripts\u001b[39m   unrs-resolver@1.12.2 (postinstall: node postinstall.js)\r\n\u001b[1mnpm\u001b[22m \u001b[33mwarn\u001b[39m \u001b[94mallow-scripts\u001b[39m\r\n\u001b[1mnpm\u001b[22m \u001b[33mwarn\u001b[39m \u001b[94mallow-scripts\u001b[39m Run `npm approve-scripts --allow-scripts-pending` to review, or `npm approve-scripts <pkg>` to allow.\r\n⠸"]
