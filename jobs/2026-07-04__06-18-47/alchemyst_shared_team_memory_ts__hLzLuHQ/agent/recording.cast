[289.679747, "i", "cat > /home/user/myproject/test_search2.cjs << 'EOF'\nconst { AlchemystAI } = require('@alchemystai/sdk');\nconst fs = require('fs');\n\nasync function main() {\n  const apiKey = process.env.ALCHEMYST_AI_API_KEY;\n  const runId = fs.readFileSync('/logs/artifacts/run-id', 'utf-8').trim();\n  const sessionId = `team-standup-${runId}`;\n  \n  const client = new AlchemystAI({ apiKey });\n  \n  try {\n    const result = await client.v1.context.search({\n      query: 'auth module',\n      similarity_threshold: 0.8,\n      minimum_similarity_threshold: 0.1,\n      user_id: 'alice',\n      sessionId: sessionId,\n    });\n    console.log('SUCCESS:', JSON.stringify(result, null, 2));\n  } catch (err) {\n    console.error('ERROR:', err?.message || err);\n  }\n}\nmain();\nEOF\nnode /home/user/myproject/test_search2.cjs 2>&1\n"]
