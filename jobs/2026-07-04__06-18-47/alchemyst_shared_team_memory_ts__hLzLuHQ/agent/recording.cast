[390.591296, "o", "\u001b[?2004hroot@d1851b5d-5199-4e75-afc1-4295f13b4f05:/home/user/myproject# "]
[393.766211, "i", "cat /home/user/myproject/package.json\n"]
[393.766673, "o", "cat /home/user/myproject/package.json\r\n\u001b[?2004l\r"]
[393.767568, "o", "{\r\n  \"name\": \"shared-team-memory-cli\",\r\n  \"version\": \"1.0.0\",\r\n  \"description\": \"Shared team memory CLI with Alchemyst AI\",\r\n  \"type\": \"module\",\r\n  \"main\": \"dist/main.js\",\r\n  \"scripts\": {\r\n    \"build\": \"tsc\"\r\n  },\r\n  \"dependencies\": {\r\n    \"@alchemystai/sdk\": \"latest\"\r\n  },\r\n  \"devDependencies\": {\r\n    \"@types/node\": \"^26.1.0\",\r\n    \"typescript\": \"^5.0.0\"\r\n  }\r\n}\r\n"]
[393.767828, "o", "\u001b[?2004hroot@d1851b5d-5199-4e75-afc1-4295f13b4f05:/home/user/myproject# "]
[394.148669, "i", "cat /home/user/myproject/tsconfig.json\n"]
[394.148922, "o", "cat /home/user/myproject/tsconfig.json\r\n\u001b[?2004l\r"]
[394.149842, "o", "{\r\n  \"compilerOptions\": {\r\n    \"target\": \"ES2022\",\r\n    \"module\": \"ESNext\",\r\n    \"moduleResolution\": \"Bundler\",\r\n    \"esModuleInterop\": true,\r\n    \"allowSyntheticDefaultImports\": true,\r\n    \"strict\": true,\r\n    \"skipLibCheck\": true,\r\n    \"resolveJsonModule\": true,\r\n    \"outDir\": \"./dist\",\r\n    \"rootDir\": \"./src\",\r\n    \"declaration\": false,\r\n    \"sourceMap\": false\r\n  },\r\n  \"include\": [\"src/**/*\"],\r\n  \"exclude\": [\"node_modules\", \"dist\"]\r\n}\r\n"]
[394.150017, "o", "\u001b[?2004hroot@d1851b5d-5199-4e75-afc1-4295f13b4f05:/home/user/myproject# "]
[394.462137, "i", "cat /home/user/myproject/src/main.ts\n"]
[394.462575, "o", "cat /home/user/myproject/src/main.ts\r\n\u001b[?2004l\r"]
[394.464015, "o", "import { AlchemystAI } from '@alchemystai/sdk';\r\nimport * as fs from 'fs';\r\nimport { randomUUID } from 'crypto';\r\n\r\ninterface CliArgs {\r\n  userId?: string;\r\n  add?: string;\r\n  query?: string;\r\n}\r\n\r\nfunction parseArgs(argv: string[]): CliArgs {\r\n  const args: CliArgs = {};\r\n  for (let i = 0; i < argv.length; i++) {\r\n    const arg = argv[i];\r\n    if (arg === '--user-id') {\r\n      args.userId = argv[++i];\r\n    } else if (arg.startsWith('--user-id=')) {\r\n      args.userId = arg.substring('--user-id='.length);\r\n    } else if (arg === '--add') {\r\n      args.add = argv[++i];\r\n    } else if (arg.startsWith('--add=')) {\r\n      args.add = arg.substring('--add='.length);\r\n    } else if (arg === '--query') {\r\n      args.query = argv[++i];\r\n    } else if (arg.startsWith('--query=')) {\r\n      args.query = arg.substring('--query='.length);\r\n    }\r\n  }\r\n  return args;\r\n}\r\n\r\nfunction getSessionId(): string {\r\n  const runIdPath = '/logs/artifacts/run-id';\r\n  const runId = fs.readFileSync(runIdPath, 'utf-8').trim();\r\n  return `team-standup-${runId}`;\r\n}\r\n\r\nasync function main() {\r\n  const args = parseArgs(process.argv.slice(2));\r\n\r\n  if (!args.userId) {\r\n    console.error('Error: --user-id is required. MISSING_PARAMETERS: both userId and sessionId are mandatory for memory operations.');\r\n    process.exit(1);\r\n  }\r\n\r\n  if (!args.add && !args.query) {\r\n    console.error('Error: must provide either --add or --query.');\r\n    process.exit(1);\r\n  }\r\n\r\n  if (args.add && args.query) {\r\n    console.error('Error: provide only one of --add or --query.');\r\n    process.exit(1);\r\n  }\r\n\r\n  const sessionId = getSessionId();\r\n  const apiKey = process.env.ALCHEMYST_AI_API_KEY;\r\n  if (!apiKey) {\r\n    console.error('Error: ALCHEMYST_AI_API_KEY environment variable is required.');\r\n    process.exit(1);\r\n  }\r\n\r\n  const client = new AlchemystAI({ apiKey });\r\n\r\n  try {\r\n    if (args.add) {\r\n      await client.v1.context.memory.add({\r\n        sessionId: sessionId,\r\n        contents: [\r\n          {\r\n            content: args.add,\r\n            metadata: {\r\n              messageId: randomUUID(),\r\n              userId: args.userId,\r\n            },\r\n          },"]
[394.464095, "o", "\r\n        ],\r\n      } as any);\r\n      console.log(`ADDED: ${args.add}`);\r\n    } else if (args.query) {\r\n      const result = await client.v1.context.search({\r\n        query: args.query,\r\n        similarity_threshold: 0.8,\r\n        minimum_similarity_threshold: 0.1,\r\n        user_id: args.userId,\r\n        sessionId: sessionId,\r\n      } as any);\r\n\r\n      const contexts = (result as any).contexts || [];\r\n      for (const ctx of contexts) {\r\n        const content = typeof ctx === 'string' ? ctx : (ctx.content || ctx.text || JSON.stringify(ctx));\r\n        console.log(`MEMORY: ${content}`);\r\n      }\r\n    }\r\n  } catch (err: any) {\r\n    console.error('Error:', err?.message || err);\r\n    process.exit(1);\r\n  }\r\n}\r\n\r\nmain();\r\n"]
