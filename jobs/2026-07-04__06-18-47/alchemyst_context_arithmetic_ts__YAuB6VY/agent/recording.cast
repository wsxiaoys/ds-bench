[120.028966, "o", "\u001b[?2004h>   key: string;\r\n\u001b[?2004l\r\u001b[?2004h>   content?: string;\r\n\u001b[?2004l\r\u001b[?2004h>   file_name?: string;\r\n\u001b[?2004l\r\u001b[?2004h>   score?: number;\r\n\u001b[?2004l\r\u001b[?2004h>   [k: string]: unknown;\r\n\u001b[?2004l\r\u001b[?2004h> }\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> // ----- CLI parsing -----\r\n\u001b[?2004l\r\u001b[?2004h> function parseArgs(argv: string[]): string[] {\r\n\u001b[?2004l\r\u001b[?2004h>   // Accept: --groups g1 g2 ...  (groups are positional values after --groups, until end / next flag)\r\n\u001b[?2004l\r\u001b[?2004h>   const groups: string[] = [];\r\n\u001b[?2004l\r\u001b[?2004h>   let i = 0;\r\n\u001b[?2004l\r\u001b[?2004h>   while (i < argv.length) {\r\n\u001b[?2004l\r\u001b[?2004h>     const a = argv[i];\r\n\u001b[?2004l\r\u001b[?2004h>     if (a === '--groups' || a === '--group') {\r\n\u001b[?2004l\r\u001b[?2004h>       i++;\r\n\u001b[?2004l\r\u001b[?2004h>       while (i < argv.length && !argv[i].startsWith('--')) {\r\n\u001b[?2004l\r\u001b[?2004h>         groups.push(argv[i]);\r\n\u001b[?2004l\r\u001b[?2004h>         i++;\r\n\u001b[?2004l\r\u001b[?2004h>       }\r\n\u001b[?2004l\r\u001b[?2004h>     } else {\r\n\u001b[?2004l\r\u001b[?2004h>       i++;\r\n\u001b[?2004l\r\u001b[?2004h>     }\r\n\u001b[?2004l\r\u001b[?2004h>   }\r\n\u001b[?2004l\r\u001b[?2004h>   return groups;\r\n\u001b[?2004l\r\u001b[?2004h> }\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> // ----- Read run-id -----\r\n\u001b[?2004l\r\u001b[?2004h> function readRunId(): string {\r\n\u001b[?2004l\r\u001b[?2004h>   // Per task, the run-id lives at /logs/artifacts/run-id\r\n\u001b[?2004l\r\u001b[?2004h>   const p = '/logs/artifacts/run-id';\r\n\u001b[?2004l\r\u001b[?2004h>   try {\r\n\u001b[?2004l\r\u001b[?2004h>     return fs.readFileSync(p, 'utf8').trim();\r\n\u001b[?2004l\r\u001b[?2004h>   } catch {\r\n\u001b[?2004l\r\u001b[?2004h>     // Fallback: a random id so the build/run still works in dev environments\r\n\u001b[?2004l\r\u001b[?2004h>     return Math.random().toString(36).slice(2, 12);\r\n\u001b[?2004l\r\u001b[?2004h>   }\r\n\u001b[?2004l\r\u001b[?2004h> }\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> // ----- Seed corpus -----\r\n\u001b[?2004l\r\u001b[?2004h> function buildSeedDocs(): SeedDoc[] {\r\n\u001b[?2004l\r\u001b[?2004h>   return [\r\n\u001b[?2004l\r\u001b[?2004h>     {\r\n\u001b[?2004l\r\u001b[?2004h>       key: 'ENG_V1_DOC',\r\n\u001b[?2004l\r\u001b[?2004h>       groups: ['eng', 'v1'],\r\n\u001b[?2004l\r\u001b[?2004h>       content:\r\n\u001b[?2004l\r\u001b[?2004h>         'ENG_V1_DOC Engineering notes for API version 1. ' +\r\n\u001b[?2004l\r\u001b[?2004h>         'This document summarises the v1 endpoint contracts, deprecated fields, and the legacy auth flow ' +\r\n\u001b[?2004l\r\u001b[?2004h>         'used by first-generation mobile clients. Topics: REST API version 1, basic auth, simple rate limits.',\r\n\u001b[?2004l\r\u001b[?2004h>     },\r\n\u001b[?2004l\r\u001b[?2004h>     {\r\n\u001b[?2004l\r\u001b[?2004h>       key: 'ENG_V2_DOC',\r\n\u001b[?2004l\r\u001b[?2004h>       groups: ['eng', 'v2'],\r\n\u001b[?2004l\r\u001b[?2004h>       content:\r\n\u001b[?2004l\r\u001b[?2004h>         'ENG_V2_DOC Engineering notes for API version 2. ' +\r\n\u001b[?2004l\r\u001b[?2004h>         'This document summarises the v2 endpoint contracts, OAuth2 scopes, refreshed pagination model, ' +\r\n\u001b[?2004l\r\u001b[?2004h>         'and the newer streaming response format used by modern clients. Topics: REST API version 2, OAuth2.',\r\n\u001b[?2004l\r\u001b[?2004h>     },\r\n\u001b[?2004l\r\u001b[?2004h>     {\r\n\u001b[?2004l\r\u001b[?2004h>       key: 'PRODUCT_V1_DOC',\r\n\u001b[?2004l\r\u001b[?2004h>       groups: ['product', 'v1'],\r\n\u001b[?2004l\r\u001b[?2004h>       content:\r\n\u001b[?2004l\r\u001b[?2004h>         'PRODUCT_V1_DOC Product notes for release version 1. ' +\r\n\u001b[?2004l\r\u001b[?2004h>         'This document outlines the GTM plan, positioning, pricing tiers, and customer success KPIs ' +\r\n\u001b[?2004l\r\u001b[?2004h>         'for the initial public launch of release version 1. Topics: launch, pricing, positioning.',\r\n\u001b[?2004l\r\u001b[?2004h>     },\r\n\u001b[?2004l\r\u001b[?2004h>     {\r\n\u001b[?2004l\r\u001b[?2004h>       key: 'PRODUCT_V2_DOC',\r\n\u001b[?2004l\r\u001b[?2004h>       groups: ['product', 'v2'],\r\n\u001b[?2004l\r\u001b[?2004h>       content:\r\n\u001b[?2004l\r\u001b[?2004h>         'PRODUCT_V2_DOC Product notes for release version 2. ' +\r\n\u001b[?2004l\r\u001b[?2004h>         'This document outlines feature flags, the multi-region expansion, enterprise tier packaging, ' +\r\n\u001b[?2004l\r\u001b[?2004h>         'and adoption metrics for release version 2. Topics: enterprise, regions, adoption.',\r\n\u001b[?2004l\r\u001b[?2004h>     },\r\n\u001b[?2004l\r\u001b[?2004h>   ];\r\n\u001b[?2004l\r\u001b[?2004h> }\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> // ----- Ingest -----\r\n\u001b[?2004l\r\u001b[?2004h> async function ingest(\r\n"]
