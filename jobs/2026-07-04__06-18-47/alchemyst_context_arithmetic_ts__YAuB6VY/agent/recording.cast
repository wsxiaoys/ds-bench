l\r\u001b[?2004h>   -H \"Authorization: Bearer $KEY\" \\\r\n\u001b[?2004l\r\u001b[?2004h>   -H 'Content-Type: application/json' \\\r\n\u001b[?2004l\r\u001b[?2004h> "]
