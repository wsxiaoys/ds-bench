[120.042001, "o", "    'ENG_V1_DOC',"]
[120.042073, "o", "\r\n\u001b[?2004l\r\u001b[?2004h"]
[120.042137, "o", ">     'ENG_V2_DOC',\r\n\u001b[?2004l\r"]
[120.042154, "o", "\u001b[?2004h>     'PRODUCT_V1_DOC',"]
[120.042245, "o", "\r\n\u001b[?2004l\r\u001b[?2004h"]
[120.042287, "o", "> "]
[120.04235, "o", "    'PRODUCT_V2_DOC',"]
[120.042398, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[120.042442, "o", "  ];\r\n\u001b[?2004l\r"]
[120.042506, "o", "\u001b[?2004h> "]
[120.042548, "o", "  for (const k of known) {"]
[120.042587, "o", "\r\n\u001b[?2004l\r"]
[120.042634, "o", "\u001b[?2004h"]
[120.042658, "o", ">     if (content.includes(k)) return k;"]
[120.04273, "o", "\r\n\u001b[?2004l\r"]
[120.042829, "o", "\u001b[?2004h>   }"]
[120.04286, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[120.042905, "o", "  return null;"]
[120.042943, "o", "\r\n\u001b[?2004l\r"]
[120.043005, "o", "\u001b[?2004h> "]
[120.043048, "o", "}\r\n\u001b[?2004l\r\u001b[?2004h> "]
