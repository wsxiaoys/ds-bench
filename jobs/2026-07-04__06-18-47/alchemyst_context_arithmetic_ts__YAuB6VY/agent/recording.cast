[13.357968, "o", "\r\n@alchemystai/sdk@0.11.1 | Apache-2.0 | deps: none | versions: 13\r\nThe official TypeScript library for the Alchemyst AI API\r\n\r\ndist\r\n.tarball: https://registry.npmjs.org/@alchemystai/sdk/-/sdk-0.11.1.tgz\r\n.shasum: b7399e5a3d61432dfbfa710c9fe8cd0f75912041\r\n.integrity: sha512-rku29c3VkaMwybPiIFmDN2d3+22QO6YhfGqZ/b2GbVbRBhJJYP5X/slQwZHIyI/B8xGPZWZprFl5CldAgMTwFQ==\r\n.unpackedSize: 692.7 kB\r\n\r\nmaintainers:\r\n- anuran-roy <anuranroy02@gmail.com>\r\n\r\ndist-tags:\r\nlatest: 0.11.1\r\n\r\npublished 5 months ago by anuran-roy <anuranroy02@gmail.com>\r\n"]
