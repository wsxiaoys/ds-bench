[120.041282, "o", "> "]
[120.041352, "o", "function extractKey(content: string): string | null {"]
[120.041452, "o", "\r\n\u001b[?2004l\r\u001b[?2004h"]
[120.04146, "o", ">   // Each seed doc embeds its key literally at the start, e.g. \"ENG_V1_DOC Engineering notes ...\"."]
[120.041593, "o", "\r\n\u001b[?2004l\r"]
[120.041672, "o", "\u001b[?2004h> "]
[120.041678, "o", "  // After chunking the key may be anywhere in the chunk, so scan for any known key."]
[120.041757, "o", "\r\n"]
[120.041813, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[120.041851, "o", "  const known = ["]
