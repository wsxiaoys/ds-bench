[?2004l[?2004h> import * as fs from 'fs';
[?2004l[?2004h> import AlchemystAI from '@alchemystai/sdk';
[?2004l[?2004h> 
[?2004l[?2004h> // Parse --group argument
[?2004l[?2004h> function parseGroup(): string {
[?2004l[?2004h>   const args = process.argv.slice(2);
[?2004l[?2004h>   const idx = args.indexOf('--group');
[?2004l[?2004h>   if (idx === -1 || idx + 1 >= args.length) {
[?2004l[?2004h>     throw new Error('Missing required --group <group_name> argument');
[?2004l[?2004h>   }
[?2004l[?2004h>   const group = args[idx + 1];
[?2004l[?2004h>   if (!group || typeof group !== 'string') {
[?2004l[?2004h>     throw new Error('Invalid --group argument');
[?2004l[?2004h>   }
[?2004l[?2004h>   return group;
[?2004l[?2004h> }
[?2004l[?2004h> 
[?2004l[?2004h> async function main() {
[?2004l[?2004h>   const apiKey = process.env.ALCHEMYST_AI_API_KEY;
[?2004l[?2004h>   if (!apiKey) {
[?2004l[?2004h>     throw new Error('ALCHEMYST_AI_API_KEY environment variable not set');
[?2004l[?2004h>   }
[?2004l[?2004h> 
[?2004l[?2004h>   const runId = fs.readFileSync('/logs/artifacts/run-id', 'utf8').trim();
[?2004l[?2004h>   const group = parseGroup();
[?2004l[?2004h> 
[?2004l[?2004h>   const client = new AlchemystAI({ apiKey });
[?2004l[?2004h> 
[?2004l[?2004h>   // Four resource documents. Each carries its file_name and group_name
[?2004l[?2004h>   // under its metadata (snake_case keys), suffixed with run-id to keep them
[?2004l[?2004h>   // unique across concurrent runs.
[?2004l[?2004h>   const docs: Array<Record<string, unknown>> = [
[?2004l[?2004h>     {
[?2004l[?2004h>       content:
[?2004l[?2004h>         'Support runbook one: This is the first customer support document ' +
[?2004l[?2004h>         'describing how to triage billing disputes, verify invoices, and issue ' +
[?2004l[?2004h>         'refunds or credits inside the support queue.',
[?2004l[?2004h>       file_name: `support-1-${runId}.txt`,
[?2004l[?2004h>       group_name: ['support'],
[?2004l[?2004h>     },
[?2004l[?2004h>     {
[?2004l[?2004h>       content:
[?2004l[?2004h>         'Support runbook two: This is the second customer support document ' +
[?2004l[?2004h>         'covering account recovery, password resets, and how support agents ' +
[?2004l[?2004h>         'should escalate issues that require engineering intervention.',
[?2004l[?2004h>       file_name: `support-2-${runId}.txt`,
[?2004l[?2004h>       group_name: ['support'],
[?2004l[?2004h>     },
[?2004l[?2004h>     {
[?2004l[?2004h>       content:
[?2004l[?2004h>         'Engineering design one: This is the first engineering document ' +
[?2004l[?2004h>         'describing the production service architecture, including how ' +
[?2004l[?2004h>         'requests flow through the API gateway and the workers that handle ' +
[?2004l[?2004h>         'context ingestion.',
[?2004l[?2004h>       file_name: `engineering-1-${runId}.txt`,
[?2004l[?2004h>       group_name: ['engineering'],
[?2004l[?2004h>     },
[?2004l[?2004h>     {
[?2004l[?2004h>       content:
[?2004l[?2004h>         'Engineering design two: This is the second engineering document ' +
[?2004l[?2004h>         'explaining how the semantic search index is built, how similarity ' +
[?2004l[?2004h>         'scores are computed, and how group-based metadata filtering is ' +
[?2004l[?2004h>         'applied at query time.',
[?2004l[?2004h>       file_name: `engineering-2-${runId}.txt`,
[?2004l[?2004h>       group_name: ['engineering'],
[?2004l[?2004h>     },
[?2004l[?2004h>   ];
[?2004l[?2004h> 
[?2004l[?2004h>   // Idempotent seeding. Adding the same file_name twice returns 409, so we
[?2004l[?2004h>   // catch that error and continue without crashing on re-runs.
[?2004l[?2004h>   for (const doc of docs) {
[?2004l[?2004h>     try {
[?2004l[?2004h>       const resp = await client.v1.context.add({
[?2004l[?2004h>         documents: [doc as any],
[?2004l[?2004h>         context_type: 'resource',
[?2004l[?2004h>         source: 'docs',
[?2004l[?2004h>         scope: 'internal',
[?2004l[?2004h>       } as any);
[?2004l[?2004h>       // eslint-disable-next-line no-console
[?2004l[?2004h>       console.error(`[seed] added ${doc.file_name}: ${JSON.stringify(resp)}`);
[?2004l[?2004h>     } catch (err: any) {
[?2004l[?2004h>       const status = err?.status ?? err?.statusCode ?? err?.response?.status;
[?2004l[?2004h>       const msg = err?.message ?? String(err);
[?2004l[?2004h>       if (status === 409 || /409|conflict|already/i.test(msg)) {
[?2004l[?2004h>         // eslint-disable-next-line no-console
[?2004l[?2004h>         console.error(`[seed] ${doc.file_name} already exists, skipping`);
[?2004l[?2004h>         continue;
[?2004l[?2004h>       }
[?2004l[?2004h>       throw err;
[?2004l[?2004h>     }
[?2004l[?2004h>   }
[?2004l[?2004h> 
[?2004l[?2004h>   // Give the indexing pipeline a brief moment so newly added docs are
[?2004l[?2004h>   // queryable on the very next request.
[?2004l[?2004h>   await new Promise((r) => setTimeout(r, 3000));
[?2004l[?2004h> 
[?2004l[?2004h>   // Metadata-filtered search using camelCase groupName (the asymmetry!).
[?2004l[?2004h>   // The SDK uses `body_metadata` for the request body field and `metadata`
[?2004l[?2004h>   // as a query string parameter controlling whether metadata is returned.
[?2004l[?2004h>   const searchResp: any = await client.v1.context.search({
[?2004l[?2004h>     query: 'documents',
[?2004l[?2004h>     scope: 'internal',
[?2004l[?2004h>     similarity_threshold: 0.0,
[?2004l[?2004h>     minimum_similarity_threshold: 0.0,
[?2004l[?2004h>     metadata: 'true',
[?2004l[?2004h>     body_metadata: { groupName: [group] },
[?2004l[?2004h>   } as any);
[?2004l[?2004h> 
[?2004l[?2004h>   const contexts: any[] = Array.isArray(searchResp?.contexts)
[?2004l[?2004h>     ? searchResp.contexts
[?2004l[?2004h>     : [];
[?2004l[?2004h> 
[?2004l[?2004h>   const fileNames = new Set<string>();
[?2004l[?2004h>   for (const c of contexts) {
[?2004l[?2004h>     const candidates: unknown[] = [];
[?2004l[?2004h>     const meta = c?.metadata;
[?2004l[?2004h>     if (meta && typeof meta === 'object') {
[?2004l[?2004h>       candidates.push((meta as any).file_name, (meta as any).fileName);
[?2004l[?2004h>     } else if (typeof meta === 'string') {
[?2004l[?2004h>       try {
[?2004l[?2004h>         const parsed = JSON.parse(meta);
[?2004l[?2004h>         candidates.push(parsed?.file_name, parsed?.fileName);
[?2004l[?2004h>       } catch {
[?2004l[?2004h>         /* ignore */
[?2004l[?2004h>       }
[?2004l[?2004h>     }
[?2004l[?2004h>     for (const candidate of candidates) {
[?2004l[?2004h>       if (typeof candidate === 'string' && candidate.length > 0) {
[?2004l[?2004h>         fileNames.add(candidate);
[?2004l[?2004h>       }
[?2004l[?2004h>     }
[?2004l[?2004h>   }
[?2004l[?2004h> 
[?2004l[?2004h>   process.stdout.write(JSON.stringify([...fileNames]) + '\n');
[?2004l[?2004h> }
[?2004l[?2004h> 
[?2004l[?2004h> main().catch((err) => {
[?2004l[?2004h>   // eslint-disable-next-line no-console
[?2004l[?2004h>   console.error(err?.stack ?? err?.message ?? String(err));
[?2004l[?2004h>   process.exit(1);
[?2004l[?2004h> });
