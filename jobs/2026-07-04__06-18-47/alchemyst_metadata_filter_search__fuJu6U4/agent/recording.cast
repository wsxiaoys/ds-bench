[252.791164, "o", "status: \u001b[33m200\u001b[39m\r\n{\"statusText\":\"OK\",\"contexts\":[{\"content\":\"{\\\"---\\\":\\\"This is a test document for context arithmetic. It contains text about engineering and version 1.\\\"}\"},{\"content\":\"{\\\"---\\\":\\\"This is a test document for context arithmetic. It contains text about docs and version 1.\\\"}\"},{\"content\":\"{\\\"---\\\":\\\"This is a test document for context arithmetic. It contains text about engineering and version 2.\\\"}\"},{\"content\":\"This is a test support document for troubleshooting.\"},{\"content\":\"Engineering document 1: Deploying to Kubernetes. We use Helm charts to deploy our microservices to Kubernetes clusters in production.\"},{\"content\":\"This document explains quantum supremacy. Quantum computers achieve it by using qubits to perform calculations classical computers cannot do.\"},{\"content\":\"Support document 1: How to reset your password. To reset your password, click on the forgot password link on the login page.\"},{\"content\":\"{\\\"File: docC-zr1c3edzrb.md\\\":\\\"Documentation for v1 onboarding. New users follow the v1 quickstart guide to set up their account.\\\"}\"},{\"content\":\"Support document 2: Billing policy details. We bill on a monthly subscription basis. You can cancel your subscription at any time.\"},{\"content\":\"Engineering notes for API version 1. This document describes the engineering design decisions, internal endpoint behaviour, and platform-level implementation details for the v1 REST API surface. ENG_V1_DOC\"},{\"content\":\"Engineering notes for API version 2. This document describes the engineering design decisions, internal endpoint behaviour, and platform-level implementation details for the v2 REST API surface with backwards-compatible semantics. ENG_V2_DOC\"},{\"content\":\"Product notes for release version 1. This document captures product positioning, launch readiness, feature-set scope, customer-facing messaging, and market rollout plan for the v1 product release. PRODUCT_V1_DOC\"},{\"content\":\"Product notes for release version 2. This document captures product positioning, launch readiness, feature-set scope, customer-facing messaging, and market rollout plan for the v2 product release. PRODUCT_V2_DOC\"},{\"content\":\"Engineering document 2: Database migration guide. Run npm run db:migrate to apply the latest migrations to your PostgreSQL database.\"},{\"content\":\"Retrieval-Augmented Generation (RAG) augments LLM prompts with snippets retrieved from a vector store. Documents are chunked, embedded, and indexed; at query time a semantic search returns the most relevant chunks and the LLM grounds its answer in that retrieved context.\"}]}\r\n"]
[252.832363, "o", "\u001b[?2004hroot@a00704b1-2693-408e-8898-160d4774452b:/home/user/myproject# "]
[273.193097, "i", "cat > /tmp/test_raw.js << 'EOF'\nconst apiKey = process.env.ALCHEMYST_AI_API_KEY;\n\n(async () => {\n  const resp = await fetch('https://platform-backend.getalchemystai.com/api/v1/context/search?metadata=true', {\n    method: 'POST',\n    headers: {\n      'Authorization': 'Bearer ' + apiKey,\n      'Content-Type': 'application/json'\n    },\n    body: JSON.stringify({\n      query: 'documents',\n      scope: 'internal',\n      similarity_threshold: 0.0,\n      minimum_similarity_threshold: 0.0,\n      metadata: { groupName: ['support'] }\n    })\n  });\n  const text = await resp.text();\n  console.log('status:', resp.status);\n  const json = JSON.parse(text);\n  console.log(JSON.stringify(json, null, 2).substring(0, 3000));\n})();\nEOF\nnode /tmp/test_raw.js\n"]
