[98.061076, "o", "        'Engineering doc 2: A second engineering document explaining how the ' +\r\n\u001b[?2004l\r"]
[98.061107, "o", "\u001b[?2004h> "]
[98.061364, "o", "        'semantic search index is built, how similarity scores are computed, ' +\r\n\u001b[?2004l\r\u001b[?2004h"]
[98.061398, "o", "> "]
[98.061594, "o", "        'and how group-based metadata filtering is applied at query time.',\r\n\u001b[?2004l\r\u001b[?2004h"]
[98.061628, "o", "> "]
[98.061771, "o", "      file_name: `engineering-2-${runId}.txt`,\r\n\u001b[?2004l\r\u001b[?2004h"]
[98.061802, "o", "> "]
[98.0619, "o", "      group_name: ['engineering'],\r\n\u001b[?2004l\r"]
[98.06193, "o", "\u001b[?2004h>     },\r\n"]
[98.061955, "o", "\u001b[?2004l\r\u001b[?2004h"]
[98.06204, "o", ">   ];\r\n\u001b[?2004l\r"]
[98.062085, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[98.062259, "o", "  // Idempotent seeding. Adding the same file_name twice returns 409, so we\r\n\u001b[?2004l\r"]
[98.062291, "o", "\u001b[?2004h> "]
[98.062466, "o", "  // catch that error and continue without crashing on re-runs.\r\n\u001b[?2004l\r"]
[98.062496, "o", "\u001b[?2004h> "]
[98.062595, "o", "  for (const doc of docs) {\r\n\u001b[?2004l\r"]
[98.06263, "o", "\u001b[?2004h> "]
[98.062663, "o", "    try {\r\n\u001b[?2004l\r\u001b[?2004h"]
[98.062776, "o", "> "]
[98.062863, "o", "      const resp = await client.v1.context.add({\r\n\u001b[?2004l\r"]
[98.062896, "o", "\u001b[?2004h> "]
[98.062976, "o", "        documents: [doc as any],\r\n\u001b[?2004l\r"]
[98.063001, "o", "\u001b[?2004h> "]
[98.0631, "o", "        context_type: 'resource',\r\n\u001b[?2004l\r"]
[98.063121, "o", "\u001b[?2004h> "]
[98.063276, "o", "        source: 'docs',\r\n\u001b[?2004l\r\u001b[?2004h> "]
[98.063306, "o", "        scope: 'internal',\r\n\u001b[?2004l\r\u001b[?2004h> "]
[98.063406, "o", "      } as any);\r\n\u001b[?2004l\r\u001b[?2004h> "]
[98.063508, "o", "      // eslint-disable-next-line no-console\r\n\u001b[?2004l\r"]
[98.063537, "o", "\u001b[?2004h> "]
[98.063753, "o", "      console.error(`[seed] added ${doc.file_name}: ${JSON.stringify(resp)}`);\r\n\u001b[?2004l\r\u001b[?2004h"]
[98.063784, "o", "> "]
[98.063885, "o", "    } catch (err: any) {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[98.064083, "o", "      const status = err?.status ?? err?.statusCode ?? err?.response?.status;\r\n\u001b[?2004l\r"]
[98.064108, "o", "\u001b[?2004h> "]
[98.064235, "o", "      const msg = err?.message ?? String(err);\r\n\u001b[?2004l\r"]
[98.064258, "o", "\u001b[?2004h> "]
[98.064434, "o", "      if (status === 409 || /409|conflict|already/i.test(msg)) {\r\n\u001b[?2004l\r"]
[98.064459, "o", "\u001b[?2004h> "]
[98.064587, "o", "        // eslint-disable-next-line no-console\r\n\u001b[?2004l\r"]
[98.064611, "o", "\u001b[?2004h> "]
[98.064813, "o", "        console.error(`[seed] ${doc.file_name} already exists, skipping`);\r\n\u001b[?2004l\r"]
[98.064874, "o", "\u001b[?2004h> "]
[98.064899, "o", "        continue;\r\n\u001b[?2004l\r\u001b[?2004h> "]
[98.064958, "o", "      }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[98.065028, "o", "      throw err;\r\n\u001b[?2004l\r"]
[98.065056, "o", "\u001b[?2004h>     }\r\n"]
[98.06508, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[98.065163, "o", "  }\r\n\u001b[?2004l\r\u001b[?2004h"]
[98.065236, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[98.065381, "o", "  // Give the indexing pipeline a brief moment so newly added docs are\r\n\u001b[?2004l\r"]
[98.065408, "o", "\u001b[?2004h> "]
[98.065528, "o", "  // queryable on the very next request.\r\n\u001b[?2004l\r"]
[98.065555, "o", "\u001b[?2004h> "]
[98.065707, "o", "  await new Promise((r) => setTimeout(r, 1500));\r\n\u001b[?2004l\r"]
[98.065735, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[98.065765, "o", "\u001b[?2004h> "]
[98.065988, "o", "  // Metadata-filtered search using camelCase groupName (the asymmetry!).\r\n\u001b[?2004l\r"]
[98.066017, "o", "\u001b[?2004h> "]
[98.066192, "o", "  const searchResp: any = await client.v1.context.search({\r\n\u001b[?2004l\r"]
[98.066219, "o", "\u001b[?2004h> "]
[98.066299, "o", "    query: 'documents',\r\n\u001b[?2004l\r"]
[98.066329, "o", "\u001b[?2004h> "]
[98.066398, "o", "    scope: 'internal',\r\n\u001b[?2004l\r"]
[98.066452, "o", "\u001b[?2004h> "]
[98.06654, "o", "    metadata: { groupName: [group] },\r\n\u001b[?2004l\r\u001b[?2004h"]
[98.066592, "o", ">   } as any);\r\n\u001b[?2004l\r"]
[98.066627, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[98.066656, "o", "\u001b[?2004h> "]
[98.06688, "o", "  const contexts: any[] = Array.isArray(searchResp?.contexts)\r\n\u001b[?2004l\r\u001b[?2004h"]
[98.066935, "o", "> "]
[98.066989, "o", "    ? searchResp.contexts\r\n\u001b[?2004l\r"]
[98.067041, "o", "\u001b[?2004h>     : [];\r\n\u001b[?2004l\r"]
[98.067075, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[98.06714, "o", "\u001b[?2004h> "]
[98.067237, "o", "  const fileNames = new Set<string>();\r\n\u001b[?2004l\r"]
[98.06729, "o", "\u001b[?2004h> "]
[98.067356, "o", "  for (const c of contexts) {\r\n\u001b[?2004l\r"]
[98.067409, "o", "\u001b[?2004h> "]
[98.067478, "o", "    const meta = c?.metadata;\r\n\u001b[?2004l\r\u001b[?2004h"]
[98.067529, "o", "> "]
[98.067586, "o", "    if (!meta) continue;\r\n\u001b[?2004l\r\u001b[?2004h> "]
[98.067729, "o", "    const candidates: unknown[] = [];\r\n\u001b[?2004l\r\u001b[?2004h"]
[98.067788, "o", "> "]
[98.067862, "o", "    if (typeof meta === 'object') {\r\n\u001b[?2004l\r\u001b[?2004h"]
[98.067902, "o", "> "]
[98.068116, "o", "      candidates.push((meta as any).file_name, (meta as any).fileName);\r\n\u001b[?2004l\r\u001b[?2004h"]
[98.068172, "o", "> "]
[98.068294, "o", "      if (Array.isArray((meta as any).file_name)) {\r\n\u001b[?2004l\r"]
[98.06833, "o", "\u001b[?2004h> "]
[98.068493, "o", "        candidates.push(...(meta as any).file_name);\r\n\u001b[?2004l\r"]
[98.068543, "o", "\u001b[?2004h>       }\r\n\u001b[?2004l\r"]
[98.068595, "o", "\u001b[?2004h> "]
[98.068739, "o", "      if (Array.isArray((meta as any).fileName)) {\r\n\u001b[?2004l\r"]
[98.068771, "o", "\u001b[?2004h> "]
[98.06893, "o", "        candidates.push(...(meta as any).fileName);\r\n\u001b[?2004l\r\u001b[?2004h"]
[98.06898, "o", ">       }\r\n\u001b[?2004l\r\u001b[?2004h"]
[98.069016, "o", "> "]
[98.069117, "o", "    } else if (typeof meta === 'string') {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[98.069171, "o", "      try {\r\n\u001b[?2004l\r\u001b[?2004h"]
[98.069205, "o", "> "]
[98.069302, "o", "        const parsed = JSON.parse(meta);\r\n\u001b[?2004l\r"]
[98.069335, "o", "\u001b[?2004h> "]
[98.0695, "o", "        candidates.push(parsed?.file_name, parsed?.fileName);\r\n\u001b[?2004l\r\u001b[?2004h"]
[98.069534, "o", "> "]
[98.069565, "o", "      } catch {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[98.069638, "o", "        /* ignore */\r\n\u001b[?2004l\r\u001b[?2004h"]
[98.069693, "o", ">       }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[98.069727, "o", "    }\r\n\u001b[?2004l\r\u001b[?2004h"]
[98.069787, "o", "> "]
[98.069847, "o", "    for (const candidate of candidates) {\r\n\u001b[?2004l\r"]
[98.069876, "o", "\u001b[?2004h> "]
[98.069981, "o", "      if (typeof candidate === 'string') {\r\n\u001b[?2004l\r\u001b[?2004h"]
[98.070007, "o", "> "]
[98.070123, "o", "        fileNames.add(candidate);\r\n\u001b[?2004l\r\u001b[?2004h> "]
[98.070183, "o", "      }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[98.070239, "o", "    }\r\n\u001b[?2004l\r\u001b[?2004h>   }\r\n\u001b[?2004l\r"]
[98.070292, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[98.07047, "o", "  process.stdout.write(JSON.stringify([...fileNames]) + '\\n');\r\n\u001b[?2004l\r\u001b[?2004h"]
[98.070504, "o", "> }\r\n\u001b[?2004l\r"]
[98.070537, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[98.070568, "o", "\u001b[?2004h> "]
[98.070646, "o", "main().catch((err) => {\r\n\u001b[?2004l\r\u001b[?2004h"]
[98.070678, "o", "> "]
[98.070794, "o", "  // eslint-disable-next-line no-console\r\n\u001b[?2004l\r\u001b[?2004h"]
[98.070828, "o", "> "]
[98.070991, "o", "  console.error(err?.stack ?? err?.message ?? String(err));\r\n\u001b[?2004l\r\u001b[?2004h"]
[98.071025, "o", "> "]
[98.071127, "o", "  process.exit(1);\r\n\u001b[?2004l\r\u001b[?2004h> });\r\n\u001b[?2004l\r\u001b[?2004h"]
[98.071157, "o", "> EOF\r\n\u001b[?2004l\r"]
