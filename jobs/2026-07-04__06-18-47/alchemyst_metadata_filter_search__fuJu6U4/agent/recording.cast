[303.211152, "i", "cat > /tmp/test_sdk.js << 'EOF'\nconst AlchemystAI = require('/home/user/myproject/node_modules/@alchemystai/sdk').default;\nconst apiKey = process.env.ALCHEMYST_AI_API_KEY;\nconst client = new AlchemystAI({ apiKey });\n\n(async () => {\n  try {\n    const resp = await client.v1.context.search({\n      query: 'documents',\n      scope: 'internal',\n      body_metadata: { groupName: ['support'] },\n      similarity_threshold: 0.0,\n      minimum_similarity_threshold: 0.0,\n      metadata: 'true',\n    });\n    console.log('OK', JSON.stringify(resp).substring(0, 1500));\n  } catch (e) {\n    console.log('ERR', e.message);\n  }\n})();\nEOF\nnode /tmp/test_sdk.js\n"]
