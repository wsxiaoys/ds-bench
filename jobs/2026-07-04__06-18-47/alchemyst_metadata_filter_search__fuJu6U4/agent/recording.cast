[333.125032, "o", "      content:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[333.125172, "o", "        'Engineering design one: This is the first engineering document ' +\r\n\u001b[?2004l\r"]
[333.125241, "o", "\u001b[?2004h> "]
[333.12544, "o", "        'describing the production service architecture, including how ' +\r\n\u001b[?2004l\r"]
[333.125478, "o", "\u001b[?2004h> "]
[333.125728, "o", "        'requests flow through the API gateway and the workers that handle ' +\r\n\u001b[?2004l\r\u001b[?2004h"]
[333.125758, "o", "> "]
[333.125881, "o", "        'context ingestion.',\r\n\u001b[?2004l\r\u001b[?2004h> "]
[333.12603, "o", "      file_name: `engineering-1-${runId}.txt`,\r\n\u001b[?2004l\r"]
[333.126076, "o", "\u001b[?2004h> "]
[333.126189, "o", "      group_name: ['engineering'],\r\n\u001b[?2004l\r\u001b[?2004h"]
[333.126216, "o", "> "]
[333.126239, "o", "    },\r\n\u001b[?2004l\r\u001b[?2004h"]
[333.12626, "o", "> "]
[333.126283, "o", "    {\r\n\u001b[?2004l\r"]
[333.126312, "o", "\u001b[?2004h> "]
[333.12651, "o", "      content:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[333.12666, "o", "        'Engineering design two: This is the second engineering document ' +\r\n\u001b[?2004l\r"]
[333.1267, "o", "\u001b[?2004h> "]
[333.126935, "o", "        'explaining how the semantic search index is built, how similarity ' +\r\n\u001b[?2004l\r"]
[333.126961, "o", "\u001b[?2004h> "]
[333.127207, "o", "        'scores are computed, and how group-based metadata filtering is ' +\r\n\u001b[?2004l\r"]
[333.127235, "o", "\u001b[?2004h> "]
[333.127361, "o", "        'applied at query time.',\r\n\u001b[?2004l\r"]
[333.127389, "o", "\u001b[?2004h> "]
[333.127544, "o", "      file_name: `engineering-2-${runId}.txt`,\r\n\u001b[?2004l\r"]
[333.127573, "o", "\u001b[?2004h> "]
[333.127708, "o", "      group_name: ['engineering'],\r\n\u001b[?2004l\r"]
[333.127738, "o", "\u001b[?2004h>     },\r\n\u001b[?2004l\r"]
[333.127861, "o", "\u001b[?2004h>   ];\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[333.128093, "o", "  // Idempotent seeding. Adding the same file_name twice returns 409, so we\r\n\u001b[?2004l\r"]
[333.128197, "o", "\u001b[?2004h> "]
[333.128331, "o", "  // catch that error and continue without crashing on re-runs.\r\n\u001b[?2004l\r"]
[333.128359, "o", "\u001b[?2004h> "]
[333.128469, "o", "  for (const doc of docs) {\r\n\u001b[?2004l\r\u001b[?2004h"]
[333.128495, "o", "> "]
[333.128521, "o", "    try {\r\n\u001b[?2004l\r"]
[333.128544, "o", "\u001b[?2004h> "]
[333.128743, "o", "      const resp = await client.v1.context.add({\r\n\u001b[?2004l\r"]
[333.128771, "o", "\u001b[?2004h> "]
[333.128894, "o", "        documents: [doc as any],\r\n\u001b[?2004l\r"]
[333.128921, "o", "\u001b[?2004h> "]
[333.129044, "o", "        context_type: 'resource',\r\n\u001b[?2004l\r"]
[333.129072, "o", "\u001b[?2004h> "]
[333.129182, "o", "        source: 'docs',\r\n\u001b[?2004l\r\u001b[?2004h> "]
[333.129295, "o", "        scope: 'internal',\r\n\u001b[?2004l\r"]
[333.129323, "o", "\u001b[?2004h> "]
[333.129435, "o", "      } as any);\r\n\u001b[?2004l\r\u001b[?2004h> "]
[333.129573, "o", "      // eslint-disable-next-line no-console\r\n\u001b[?2004l\r"]
[333.129617, "o", "\u001b[?2004h> "]
[333.129858, "o", "      console.error(`[seed] added ${doc.file_name}: ${JSON.stringify(resp)}`);\r\n\u001b[?2004l\r"]
[333.129929, "o", "\u001b[?2004h> "]
[333.130038, "o", "    } catch (err: any) {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[333.130236, "o", "      const status = err?.status ?? err?.statusCode ?? err?.response?.status;\r\n\u001b[?2004l\r"]
[333.130307, "o", "\u001b[?2004h> "]
[333.130433, "o", "      const msg = err?.message ?? String(err);\r\n\u001b[?2004l\r"]
[333.13046, "o", "\u001b[?2004h> "]
[333.130663, "o", "      if (status === 409 || /409|conflict|already/i.test(msg)) {\r\n\u001b[?2004l\r"]
[333.130699, "o", "\u001b[?2004h> "]
[333.130857, "o", "        // eslint-disable-next-line no-console\r\n\u001b[?2004l\r"]
[333.130884, "o", "\u001b[?2004h> "]
[333.131112, "o", "        console.error(`[seed] ${doc.file_name} already exists, skipping`);\r\n\u001b[?2004l\r"]
[333.131139, "o", "\u001b[?2004h> "]
[333.131255, "o", "        continue;\r\n\u001b[?2004l\r\u001b[?2004h> "]
[333.131282, "o", "      }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[333.131389, "o", "      throw err;\r\n\u001b[?2004l\r\u001b[?2004h> "]
[333.13146, "o", "    }\r\n\u001b[?2004l\r\u001b[?2004h>   }\r\n\u001b[?2004l\r"]
[333.131486, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[333.131511, "o", "\u001b[?2004h> "]
[333.131758, "o", "  // Give the indexing pipeline a brief moment so newly added docs are\r\n\u001b[?2004l\r"]
[333.131786, "o", "\u001b[?2004h> "]
[333.131921, "o", "  // queryable on the very next request.\r\n\u001b[?2004l\r"]
[333.131949, "o", "\u001b[?2004h> "]
[333.132091, "o", "  await new Promise((r) => setTimeout(r, 3000));\r\n\u001b[?2004l\r"]
[333.132117, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[333.132142, "o", "\u001b[?2004h> "]
[333.132377, "o", "  // Metadata-filtered search using camelCase groupName (the asymmetry!).\r\n\u001b[?2004l\r\u001b[?2004h"]
[333.132401, "o", "> "]
[333.132616, "o", "  // The SDK uses `body_metadata` for the request body field and `metadata`\r\n\u001b[?2004l\r"]
[333.132642, "o", "\u001b[?2004h> "]
[333.132857, "o", "  // as a query string parameter controlling whether metadata is returned.\r\n\u001b[?2004l\r"]
[333.132883, "o", "\u001b[?2004h> "]
[333.133055, "o", "  const searchResp: any = await client.v1.context.search({\r\n\u001b[?2004l\r"]
[333.133081, "o", "\u001b[?2004h> "]
[333.133164, "o", "    query: 'documents',\r\n\u001b[?2004l\r"]
[333.133189, "o", "\u001b[?2004h> "]
[333.133274, "o", "    scope: 'internal',\r\n\u001b[?2004l\r"]
[333.1333, "o", "\u001b[?2004h> "]
[333.133404, "o", "    similarity_threshold: 0.0,\r\n\u001b[?2004l\r"]
[333.133429, "o", "\u001b[?2004h> "]
[333.133552, "o", "    minimum_similarity_threshold: 0.0,\r\n\u001b[?2004l\r"]
[333.133577, "o", "\u001b[?2004h> "]
[333.133658, "o", "    metadata: 'true',\r\n\u001b[?2004l\r"]
[333.133689, "o", "\u001b[?2004h> "]
[333.133828, "o", "    body_metadata: { groupName: [group] },\r\n\u001b[?2004l\r"]
[333.133855, "o", "\u001b[?2004h> "]
[333.133914, "o", "  } as any);\r\n\u001b[?2004l\r"]
[333.133979, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[333.134164, "o", "  const contexts: any[] = Array.isArray(searchResp?.contexts)\r\n\u001b[?2004l\r"]
[333.134191, "o", "\u001b[?2004h> "]
[333.13428, "o", "    ? searchResp.contexts\r\n\u001b[?2004l\r"]
[333.134306, "o", "\u001b[?2004h> "]
[333.134367, "o", "    : [];\r\n\u001b[?2004l\r\u001b[?2004h> "]
[333.134409, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[333.134527, "o", "  const fileNames = new Set<string>();\r\n\u001b[?2004l\r"]
[333.134553, "o", "\u001b[?2004h> "]
[333.134653, "o", "  for (const c of contexts) {\r\n\u001b[?2004l\r"]
[333.134685, "o", "\u001b[?2004h> "]
[333.134816, "o", "    const candidates: unknown[] = [];\r\n\u001b[?2004l\r"]
[333.134844, "o", "\u001b[?2004h> "]
[333.134941, "o", "    const meta = c?.metadata;\r\n\u001b[?2004l\r"]
[333.134968, "o", "\u001b[?2004h> "]
[333.135104, "o", "    if (meta && typeof meta === 'object') {\r\n\u001b[?2004l\r"]
[333.13513, "o", "\u001b[?2004h> "]
[333.135332, "o", "      candidates.push((meta as any).file_name, (meta as any).fileName);\r\n\u001b[?2004l\r"]
[333.135358, "o", "\u001b[?2004h> "]
[333.135486, "o", "    } else if (typeof meta === 'string') {\r\n\u001b[?2004l\r"]
[333.135513, "o", "\u001b[?2004h> "]
[333.135573, "o", "      try {\r\n\u001b[?2004l\r\u001b[?2004h"]
[333.135635, "o", "> "]
[333.135738, "o", "        const parsed = JSON.parse(meta);\r\n\u001b[?2004l\r"]
[333.135764, "o", "\u001b[?2004h> "]
[333.13594, "o", "        candidates.push(parsed?.file_name, parsed?.fileName);\r\n\u001b[?2004l\r"]
[333.135966, "o", "\u001b[?2004h> "]
[333.136033, "o", "      } catch {\r\n\u001b[?2004l\r\u001b[?2004h"]
[333.136058, "o", "> "]
[333.136135, "o", "        /* ignore */\r\n\u001b[?2004l\r"]
[333.136162, "o", "\u001b[?2004h> "]
[333.136222, "o", "      }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[333.136257, "o", "    }\r\n\u001b[?2004l\r\u001b[?2004h"]
[333.136281, "o", "> "]
[333.136411, "o", "    for (const candidate of candidates) {\r\n\u001b[?2004l\r"]
[333.136436, "o", "\u001b[?2004h> "]
[333.136628, "o", "      if (typeof candidate === 'string' && candidate.length > 0) {\r\n\u001b[?2004l\r"]
[333.136654, "o", "\u001b[?2004h> "]
[333.136773, "o", "        fileNames.add(candidate);\r\n\u001b[?2004l\r"]
[333.136798, "o", "\u001b[?2004h> "]
[333.136822, "o", "      }\r\n\u001b[?2004l\r"]
[333.136844, "o", "\u001b[?2004h> "]
[333.136869, "o", "    }\r\n\u001b[?2004l\r"]
[333.13689, "o", "\u001b[?2004h> "]
[333.136912, "o", "  }\r\n\u001b[?2004l\r"]
[333.136934, "o", "\u001b[?2004h> "]
[333.136963, "o", "\r\n\u001b[?2004l\r"]
[333.137089, "o", "\u001b[?2004h> "]
[333.137203, "o", "  process.stdout.write(JSON.stringify([...fileNames]) + '\\n');\r\n\u001b[?2004l\r"]
[333.13727, "o", "\u001b[?2004h> }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[333.137334, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[333.137393, "o", "main().catch((err) => {\r\n\u001b[?2004l\r"]
[333.137454, "o", "\u001b[?2004h> "]
[333.137558, "o", "  // eslint-disable-next-line no-console\r\n\u001b[?2004l\r"]
[333.137583, "o", "\u001b[?2004h> "]
[333.137772, "o", "  console.error(err?.stack ?? err?.message ?? String(err));\r\n\u001b[?2004l\r"]
[333.137798, "o", "\u001b[?2004h> "]
[333.137869, "o", "  process.exit(1);\r\n\u001b[?2004l\r"]
[333.13795, "o", "\u001b[?2004h> "]
[333.138007, "o", "});\r\n\u001b[?2004l\r\u001b[?2004h> EOF\r\n\u001b[?2004l\r"]
[333.176173, "o", "\u001b[?2004h"]
