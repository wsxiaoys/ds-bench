[304.427759, "o", "OK {\"statusText\":\"OK\",\"contexts\":[{\"updatedAt\":{\"$date\":\"2026-07-04T02:22:13.927Z\"},\"magic_keys\":{},\"context_type\":\"resource\",\"content\":\"This is a test support document for troubleshooting.\",\"indexable\":true,\"createdAt\":{\"$date\":\"2026-07-04T02:22:13.927Z\"},\"_id\":{\"$oid\":\"6a486e56143e8c873be48f94\"},\"context_weightage\":1,\"organization_id\":{\"$oid\":\"6a486bdab72e295a38de05e0\"},\"telemetry_data\":{},\"source\":\"*\",\"children_context_nodes\":{},\"blob\":null,\"parent_context_nodes\":{},\"corresponding_vector_id\":\"0726297fe7ae4fe1a91618434a929426\",\"tags\":[\"default\",\"sample\"],\"node_type\":\"reference\",\"indexed\":true,\"override_policy\":false,\"metadata\":{\"total_chunks\":1,\"chunk_length\":52,\"size\":54,\"last_modified_at\":\"2026-07-04T02:22:13.024Z\",\"metadata\":null,\"chunk_index\":0,\"doc_type\":\"text/plain\",\"group_name\":[\"support\"],\"file_name\":\"test_doc_zroz3ufjit\",\"source_doc_length\":52,\"modalities\":[\"image\",\"text\"],\"page_content\":null},\"governing_policies\":\"inherit\",\"user_id\":{\"$oid\":\"6a486bdab72e295a38de05de\"},\"scopes\":[\"basic.internal\"],\"corresponding_vector_id_new\":\"0726297fe7ae4fe1a91618434a929426\",\"text\":\"This is a test support document for troubleshooting.\",\"score\":0.0006057272548787296},{\"content\":\"Support document 2: Billing policy details. We bill on a monthly subscription basis. You can cancel your subscription at any time.\",\"magic_keys\":{},\"context_type\":\"resource\",\"updatedAt\":{\"$date\":\"2026-07-04T02:23:28.559Z\"},\"indexable\":true,\"createdAt\":{\"$date\":\"2026-07-04T02:23:28.559Z\"},\"context_weightage\":1\r\n"]
