[122.727878, "o", "    \"business days. Items must be returned in their original condition. \"\r\n\u001b[?2004l\r\u001b[?2004h"]
[122.727909, "o", "> "]
[122.728095, "o", "    \"Digital products are also eligible for the 30-day refund policy. \"\r\n\u001b[?2004l\r\u001b[?2004h"]
[122.728125, "o", "> "]
[122.728324, "o", "    \"If you have any questions about the refund process, please reach \"\r\n\u001b[?2004l\r"]
[122.728361, "o", "\u001b[?2004h> "]
[122.728454, "o", "    \"out to customer support.\"\r\n\u001b[?2004l\r"]
[122.728484, "o", "\u001b[?2004h> )\r\n\u001b[?2004l\r"]
[122.72855, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[122.728578, "o", "\u001b[?2004h> "]
[122.728638, "o", "def main() -> int:\r\n\u001b[?2004l\r\u001b[?2004h"]
[122.728667, "o", "> "]
[122.728775, "o", "    parser = argparse.ArgumentParser(\r\n\u001b[?2004l\r\u001b[?2004h"]
[122.728804, "o", "> "]
[122.728981, "o", "        description=\"Basic Alchemyst AI RAG flow demo.\"\r\n\u001b[?2004l\r"]
[122.729015, "o", "\u001b[?2004h> "]
[122.7291, "o", "    )\r\n\u001b[?2004l\r\u001b[?2004h> "]
[122.72913, "o", "    parser.add_argument(\r\n\u001b[?2004l\r\u001b[?2004h"]
[122.729193, "o", ">         \"--question\",\r\n"]
[122.729224, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[122.729293, "o", "        required=True,\r\n\u001b[?2004l\r"]
[122.729322, "o", "\u001b[?2004h> "]
[122.729492, "o", "        help=\"The user question to search the context engine for.\",\r\n\u001b[?2004l\r\u001b[?2004h"]
[122.729521, "o", ">     )\r\n\u001b[?2004l\r"]
[122.729577, "o", "\u001b[?2004h> "]
[122.729636, "o", "    args = parser.parse_args()\r\n\u001b[?2004l\r"]
[122.729664, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[122.729692, "o", "> "]
[122.729813, "o", "    api_key = os.environ[\"ALCHEMYST_AI_API_KEY\"]\r\n\u001b[?2004l\r\u001b[?2004h"]
[122.729847, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h"]
[122.729902, "o", "> "]
[122.730044, "o", "    with open(\"/logs/artifacts/run-id\", \"r\", encoding=\"utf-8\") as f:\r\n\u001b[?2004l\r\u001b[?2004h"]
[122.730074, "o", "> "]
[122.730156, "o", "        run_id = f.read().strip()\r\n\u001b[?2004l\r"]
[122.730184, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[122.730258, "o", "> "]
[122.730311, "o", "    client = AlchemystAI(api_key=api_key)\r\n\u001b[?2004l\r\u001b[?2004h"]
[122.73035, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[122.730506, "o", "    # 1. Add the policy document into the context engine.\r\n\u001b[?2004l\r\u001b[?2004h"]
[122.730532, "o", "> "]
[122.7306, "o", "    client.v1.context.add(\r\n\u001b[?2004l\r"]
[122.730624, "o", "\u001b[?2004h> "]
[122.730708, "o", "        context_type=\"resource\",\r\n\u001b[?2004l\r"]
[122.730731, "o", "\u001b[?2004h> "]
[122.730816, "o", "        source=\"documentation\",\r\n\u001b[?2004l\r\u001b[?2004h"]
[122.730857, "o", "> "]
[122.730912, "o", "        scope=\"internal\",\r\n\u001b[?2004l\r"]
[122.730946, "o", "\u001b[?2004h> "]
[122.731063, "o", "        documents=[{\"content\": POLICY_DOCUMENT}],\r\n\u001b[?2004l\r"]
[122.731086, "o", "\u001b[?2004h> "]
[122.73114, "o", "        metadata={\r\n\u001b[?2004l\r"]
[122.731163, "o", "\u001b[?2004h> "]
[122.731289, "o", "            \"file_name\": f\"refunds-{run_id}.md\",\r\n\u001b[?2004l\r"]
[122.731322, "o", "\u001b[?2004h> "]
[122.73146, "o", "            \"file_size\": float(len(POLICY_DOCUMENT)),\r\n\u001b[?2004l\r"]
[122.731483, "o", "\u001b[?2004h> "]
[122.731593, "o", "            \"file_type\": \"text/markdown\",\r\n\u001b[?2004l\r"]
[122.731627, "o", "\u001b[?2004h> "]
[122.731755, "o", "            \"last_modified\": \"2024-01-01T00:00:00Z\",\r\n\u001b[?2004l\r"]
[122.731788, "o", "\u001b[?2004h> "]
[122.731812, "o", "        },\r\n\u001b[?2004l\r\u001b[?2004h"]
[122.731847, "o", "> "]
[122.731896, "o", "    )\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[122.732056, "o", "    # 2. Search the context engine for the user's question.\r\n\u001b[?2004l\r"]
[122.732084, "o", "\u001b[?2004h> "]
[122.732206, "o", "    search_response = client.v1.context.search(\r\n\u001b[?2004l\r"]
[122.732228, "o", "\u001b[?2004h> "]
[122.732304, "o", "        query=args.question,\r\n\u001b[?2004l\r"]
[122.732327, "o", "\u001b[?2004h> "]
[122.732418, "o", "        similarity_threshold=0.6,\r\n\u001b[?2004l\r"]
[122.732446, "o", "\u001b[?2004h> "]
[122.732552, "o", "        minimum_similarity_threshold=0.1,\r\n\u001b[?2004l\r"]
[122.732588, "o", "\u001b[?2004h> "]
[122.732644, "o", "        scope=\"internal\",\r\n\u001b[?2004l\r"]
[122.732678, "o", "\u001b[?2004h>     )\r\n\u001b[?2004l\r"]
[122.732713, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[122.732746, "o", "\u001b[?2004h> "]
[122.732911, "o", "    contexts = getattr(search_response, \"contexts\", None) or []\r\n\u001b[?2004l\r"]
[122.732948, "o", "\u001b[?2004h> "]
[122.732988, "o", "    if not contexts:\r\n\u001b[?2004l\r"]
[122.733023, "o", "\u001b[?2004h> "]
[122.733211, "o", "        print(\"No contexts retrieved from the Alchemyst context engine.\")\r\n\u001b[?2004l\r"]
[122.733248, "o", "\u001b[?2004h> "]
[122.733294, "o", "        return 0\r\n\u001b[?2004l\r"]
[122.733328, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[122.733362, "o", "> "]
[122.733417, "o", "    for chunk in contexts:\r\n\u001b[?2004l\r\u001b[?2004h"]
[122.733451, "o", "> "]
[122.73357, "o", "        content = getattr(chunk, \"content\", None)\r\n\u001b[?2004l\r\u001b[?2004h"]
[122.733606, "o", "> "]
[122.733647, "o", "        if content:\r\n\u001b[?2004l\r\u001b[?2004h"]
[122.733673, "o", "> "]
[122.733743, "o", "            print(content)\r\n\u001b[?2004l\r"]
[122.733778, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[122.733827, "o", "    return 0\r\n\u001b[?2004l\r\u001b[?2004h"]
[122.733874, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[122.733908, "o", "\u001b[?2004h> "]
[122.733977, "o", "if __name__ == \"__main__\":\r\n\u001b[?2004l\r"]
[122.734012, "o", "\u001b[?2004h> "]
[122.734054, "o", "    sys.exit(main())\r\n\u001b[?2004l\r"]
[122.734088, "o", "\u001b[?2004h> PYEOF\r\n\u001b[?2004l\r"]
[122.735433, "o", "\u001b[?2004hroot@2afcfc97-7bd5-4072-a3a7-4ed423ec07ea:/home/user/myproject# "]
[123.101193, "i", "cd /home/user/myproject && python3 main.py --question \"What is the refund policy?\"\n"]
[123.101529, "o", "cd /home/user/myproject && python3 main.py --question \"What is the refund policy?\"\r\n\u001b[?2004l\r"]
[125.32693, "o", "{\"# Refund Policy\":\"- The product is not damaged.\"}\r\n{\"# Refund Policy\":\"- You have the receipt or proof of purchase.\"}\r\n{\"# Refund Policy\":\"We offer a 30-day refund policy for all our products. If you are not completely satisfied with your purchase, you can request a full refund within 30 days of the purchase date.\"}\r\n{\"# 30-Day Refund Policy\":\"All customers are entitled to a full refund within 30 days of purchase. To request a refund, please contact our support team with your order number. Refunds are typically processed within 5-7 business days. Items must be returned in their original condition. Digital products are also eligible for the 30-day refund policy. If you have any questions about the refund process, please reach out to customer support.\"}\r\n{\"# Refund Policy\":\"If you have any questions about our Refund Policy, please contact us at support@example.com.\"}\r\n{\"# Refund Policy\":\"To be eligible for a refund, please ensure that:\"}\r\n{\"# Refund Policy\":\"- The product was purchased in the last 30 days.\"}\r\n{\"# Refund Policy\":\"Refunds will be processed back to the original method of payment. Please allow 5-10 business days for the refund to appear on your statement.\"}\r\nC-camel: Refund policy - 30 day money back guarantee. Contact support@example.com. Password reset via forgot password link.\r\nSupport document 2: Billing policy details. We bill on a monthly subscription basis. You can cancel your subscription at any time.\r\nOur refund policy: We offer a 30-day money back guarantee. If you are not satisfied with your purchase, you may request a full refund within 30 days of the original purchase date. To request a refund, contact support@example.com with your order number and a brief reason for the return. Refunds are processed within 5-7 business days.\r\n"]
[125.358458, "o", "\u001b[?2004hroot@2afcfc97-7bd5-4072-a3a7-4ed423ec07ea:/home/user/myproject# "]
[166.333567, "i", "cat > /tmp/debug_test.py << 'PYEOF'\nimport os\nfrom alchemyst_ai import AlchemystAI\n\nclient = AlchemystAI(api_key=os.environ[\"ALCHEMYST_AI_API_KEY\"])\n\nwith open(\"/logs/artifacts/run-id\", \"r\") as f:\n    run_id = f.read().strip()\n\nclient.v1.context.add(\n    context_type=\"resource\",\n    source=\"documentation\",\n    scope=\"internal\",\n    documents=[{\"content\": \"Test doc about refunds\"}],\n    metadata={\n        \"file_name\": f\"refunds-{run_id}-debug.md\",\n        \"file_size\": 100.0,\n        \"file_type\": \"text/markdown\",\n        \"last_modified\": \"2024-01-01T00:00:00Z\",\n    },\n)\n\nres = client.v1.context.search(\n    query=\"refund\",\n    similarity_threshold=0.6,\n    minimum_similarity_threshold=0.1,\n    scope=\"internal\",\n)\nprint(\"TYPE:\", type(res.contexts))\nprint(\"COUNT:\", len(res.contexts) if res.contexts else 0)\nfor i, ctx in enumerate(res.contexts or []):\n    print(f\"--- Chunk {i} ---\")\n    print(\"Type of content:\", type(ctx.content))\n    print(\"Repr of content:\", repr(ctx.content)[:200])\nPYEOF\npython3 /tmp/debug_test.py 2>&1 | head -50\n"]
