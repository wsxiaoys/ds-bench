[51.217263, "o", ">     )\r\n\u001b[?2004l\r\u001b[?2004h> "]
[51.217349, "o", "    args = parser.parse_args()\r\n\u001b[?2004l\r\u001b[?2004h"]
[51.217405, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[51.217536, "o", "    api_key = os.environ[\"ALCHEMYST_AI_API_KEY\"]\r\n\u001b[?2004l\r\u001b[?2004h> "]
[51.217596, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[51.217771, "o", "    with open(\"/logs/artifacts/run-id\", \"r\", encoding=\"utf-8\") as f:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[51.217895, "o", "        run_id = f.read().strip()\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[51.217957, "o", "\u001b[?2004h> "]
[51.218047, "o", "    client = AlchemystAI(api_key=api_key)\r\n\u001b[?2004l\r\u001b[?2004h"]
[51.218106, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[51.218257, "o", "    # 1. Add the policy document into the context engine.\r\n\u001b[?2004l\r\u001b[?2004h"]
[51.218317, "o", "> "]
[51.218373, "o", "    client.v1.context.add(\r\n\u001b[?2004l\r\u001b[?2004h> "]
[51.218457, "o", "        context_type=\"resource\",\r\n\u001b[?2004l\r\u001b[?2004h"]
[51.218515, "o", "> "]
[51.218571, "o", "        source=\"documentation\",\r\n\u001b[?2004l\r\u001b[?2004h> "]
[51.218647, "o", "        scope=\"internal\",\r\n\u001b[?2004l\r\u001b[?2004h"]
[51.218704, "o", "> "]
[51.218758, "o", "        documents=[\r\n\u001b[?2004l\r\u001b[?2004h> "]
[51.21881, "o", "            {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[51.21893, "o", "                \"content\": POLICY_DOCUMENT,\r\n\u001b[?2004l\r\u001b[?2004h"]
[51.21899, "o", "> "]
[51.219051, "o", "                \"metadata\": {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[51.219217, "o", "                    \"file_name\": f\"refunds-{run_id}.md\",\r\n\u001b[?2004l\r\u001b[?2004h> "]
[51.219366, "o", "                    \"file_type\": \"text/markdown\",\r\n\u001b[?2004l\r\u001b[?2004h"]
[51.219429, "o", ">                 },\r\n\u001b[?2004l\r"]
[51.219485, "o", "\u001b[?2004h>             }\r\n\u001b[?2004l\r"]
[51.219541, "o", "\u001b[?2004h>         ],\r\n\u001b[?2004l\r"]
[51.219596, "o", "\u001b[?2004h>     )\r\n\u001b[?2004l\r"]
[51.219631, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[51.219827, "o", "    # 2. Search the context engine for the user's question.\r\n\u001b[?2004l\r\u001b[?2004h> "]
[51.219981, "o", "    search_response = client.v1.context.search(\r\n\u001b[?2004l\r\u001b[?2004h> "]
[51.220067, "o", "        query=args.question,\r\n\u001b[?2004l\r\u001b[?2004h"]
[51.220125, "o", "> "]
[51.220183, "o", "        similarity_threshold=0.6,\r\n\u001b[?2004l\r\u001b[?2004h> "]
[51.220311, "o", "        minimum_similarity_threshold=0.1,\r\n\u001b[?2004l\r\u001b[?2004h> "]
[51.220399, "o", "        scope=\"internal\",\r\n\u001b[?2004l\r\u001b[?2004h"]
[51.220458, "o", ">     )\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[51.220516, "o", "> "]
[51.220652, "o", "    contexts = getattr(search_response, \"contexts\", None) or []\r\n\u001b[?2004l\r\u001b[?2004h> "]
[51.220718, "o", "    if not contexts:\r\n\u001b[?2004l\r\u001b[?2004h"]
[51.220775, "o", "> "]
[51.220941, "o", "        print(\"No contexts retrieved from the Alchemyst context engine.\")\r\n\u001b[?2004l\r\u001b[?2004h> "]
[51.220999, "o", "        return 0\r\n\u001b[?2004l\r\u001b[?2004h"]
[51.221054, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[51.221117, "o", "    for chunk in contexts:\r\n\u001b[?2004l\r\u001b[?2004h"]
[51.221173, "o", "> "]
[51.221282, "o", "        content = getattr(chunk, \"content\", None)\r\n\u001b[?2004l\r\u001b[?2004h"]
[51.221342, "o", ">         if content:\r\n"]
[51.221398, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[51.221457, "o", "            print(content)\r\n\u001b[?2004l\r\u001b[?2004h"]
[51.221514, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[51.221572, "o", "    return 0\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[51.22163, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[51.22169, "o", "if __name__ == \"__main__\":\r\n\u001b[?2004l\r\u001b[?2004h"]
[51.221749, "o", "> "]
