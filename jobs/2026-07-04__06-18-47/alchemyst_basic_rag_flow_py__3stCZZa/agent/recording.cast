[51.214757, "o", "POLICY_DOCUMENT = (\r\n\u001b[?2004l\r\u001b[?2004h"]
[51.214809, "o", "> "]
[51.214883, "o", "    \"# 30-Day Refund Policy\\n\\n\"\r\n\u001b[?2004l\r\u001b[?2004h> "]
[51.21508, "o", "    \"All customers are entitled to a full refund within 30 days of \"\r\n\u001b[?2004l\r"]
[51.215114, "o", "\u001b[?2004h> "]
[51.215306, "o", "    \"purchase. To request a refund, please contact our support team with \"\r\n\u001b[?2004l\r\u001b[?2004h"]
[51.215361, "o", "> "]
[51.215506, "o", "    \"your order number. Refunds are typically processed within 5-7 \"\r\n\u001b[?2004l\r\u001b[?2004h"]
[51.215559, "o", "> "]
[51.215719, "o", "    \"business days. Items must be returned in their original condition. \"\r\n\u001b[?2004l\r\u001b[?2004h"]
[51.215752, "o", "> "]
[51.215944, "o", "    \"Digital products are also eligible for the 30-day refund policy. \"\r\n\u001b[?2004l\r\u001b[?2004h"]
[51.215981, "o", "> "]
[51.216149, "o", "    \"If you have any questions about the refund process, please reach \"\r\n\u001b[?2004l\r\u001b[?2004h"]
[51.216202, "o", "> "]
[51.216251, "o", "    \"out to customer support.\"\r\n\u001b[?2004l\r\u001b[?2004h"]
[51.216283, "o", "> )\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[51.216314, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[51.216346, "o", "\u001b[?2004h> "]
[51.216434, "o", "def main() -> int:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[51.216526, "o", "    parser = argparse.ArgumentParser(\r\n\u001b[?2004l\r\u001b[?2004h"]
[51.216583, "o", "> "]
[51.21669, "o", "        description=\"Basic Alchemyst AI RAG flow demo.\"\r\n\u001b[?2004l\r\u001b[?2004h"]
[51.21675, "o", ">     )\r\n\u001b[?2004l\r\u001b[?2004h> "]
[51.216818, "o", "    parser.add_argument(\r\n\u001b[?2004l\r\u001b[?2004h"]
