[168.557708, "o", "TYPE: <class 'list'>\r\nCOUNT: 11\r\n--- Chunk 0 ---\r\nType of content: <class 'str'>\r\nRepr of content: '{\"# 30-Day Refund Policy\":\"All customers are entitled to a full refund within 30 days of purchase. To request a refund, please contact our support team with your order number. Refunds are typically p\r\n--- Chunk 1 ---\r\nType of content: <class 'str'>\r\nRepr of content: '{\"# Refund Policy\":\"To be eligible for a refund, please ensure that:\"}'\r\n--- Chunk 2 ---\r\nType of content: <class 'str'>\r\nRepr of content: 'Our refund policy: We offer a 30-day money back guarantee. If you are not satisfied with your purchase, you may request a full refund within 30 days of the original purchase date. To request a refund\r\n--- Chunk 3 ---\r\nType of content: <class 'str'>\r\nRepr of content: '{\"# Refund Policy\":\"We offer a 30-day refund policy for all our products. If you are not completely satisfied with your purchase, you can request a full refund within 30 days of the purchase date.\"}'\r\n--- Chunk 4 ---\r\nType of content: <class 'str'>\r\nRepr of content: '{\"# Refund Policy\":\"Refunds will be processed back to the original method of payment. Please allow 5-10 business days for the refund to appear on your statement.\"}'\r\n--- Chunk 5 ---\r\nType of content: <class 'str'>\r\nRepr of content: '{\"# Refund Policy\":\"- The product is not damaged.\"}'\r\n--- Chunk 6 ---\r\nType of content: <class 'str'>\r\nRepr of content: '{\"# Refund Policy\":\"- You have the receipt or proof of purchase.\"}'\r\n--- Chunk 7 ---\r\nType of content: <class 'str'>\r\nRepr of content: '{\"# Refund Policy\":\"If you have any questions about our Refund Policy, please contact us at support@example.com.\"}'\r\n--- Chunk 8 ---\r\nType of content: <class 'str'>\r\nRepr of content: '{\"# Refund Policy\":\"- The product was purchased in the last 30 days.\"}'\r\n--- Chunk 9 ---\r\nType of content: <class 'str'>\r\nRepr of content: 'Test doc about refunds'\r\n--- Chunk 10 ---\r\nType of content: <class 'str'>\r\nRepr of content: 'C-camel: Refund policy - 30 day money back guarantee. Contact support@example.com. Password reset via forgot password link.'\r\n"]
