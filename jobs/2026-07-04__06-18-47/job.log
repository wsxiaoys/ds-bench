Z')) break;\n  }\n}\ngo().catch(e => { console.error('ERR', e.message); });\nJSEOF\ncd /home/user/myproject && node test_real2.js 2>&1 | tail -80\n"] min_timeout_sec: 60 max_timeout_sec: 180.0
