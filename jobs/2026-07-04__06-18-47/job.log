.log('   [MINE]', t.slice(0, 100));\n    }\n  }\n}\ngo().catch(e => { console.error('ERR', e.message); });\nJSEOF\ncd /home/user/myproject && node test_real.js\n"] min_timeout_sec: 30.0 max_timeout_sec: 180.0
