Sending keys: ['cat > /home/user/myproject/main.py << \'PYEOF\'\n#!/usr/bin/env python3\n"""\nContext Arithmetic (Intersection) demo CLI using Alchemyst AI Python SDK.\n\nOn every invocation this CLI:\n1. Reads the per-run id from /logs/artifacts/run-id.\n2. Removes any documents previously ingested under that run id (idempotent reruns).\n3. Ingests 3 documents whose `group_name` arrays overlap so the intersection\n   semantics of Context Arithmetic can be verified.\n4. Performs `client.v1.context.search(...)` filtered by `body_metadata={"group_name": [<groups from --groups>]}`\n   and prints the matching documents as a single JSON array to stdout.\n"""\n\nfrom __future__ import annotations\n\nimport argparse\nimport json\nimport os\nimport sys\nimport time\nfrom pathlib import Path\nfrom typing import Any, Dict, Iterable, List\n\nfrom alchemyst_ai import AlchemystAI\n\nRUN_ID_FILE = Path("/logs/artifacts/run-id")\n\n\ndef read_run_id() -> str:\n    """Read the run id from the canonical location."""\n    return RUN_ID_FILE.read_text().strip()\n\n\ndef parse_args() -> List[str]:\n    parser = argparse.ArgumentParser(\n        description="Demonstrate Context Arithmetic (group_name intersection)."\n    )\n    parser.add_argument(\n        "--groups",\n        nargs="+",\n        required=True,\n        help="One or more group names to AND-filter on (intersection semantics).",\n    )\n    args = parser.parse_args()\n    return list(args.groups)\n\n\ndef make_client() -> AlchemystAI:\n    api_key = os.environ.get("ALCHEMYST_AI_API_KEY")\n    if not api_key:\n        print(\n            "ERROR: ALCHEMYST_AI_API_KEY environment variable is not set.",\n            file=sys.stderr,\n        )\n        sys.exit(1)\n    return AlchemystAI(api_key=api_key)\n\n\ndef ingest_documents(\n    client: AlchemystAI, run_id: str, source: str\n) -> List[Dict[str, Any]]:\n    """Delete any documents previously ingested for this run id, then add fresh ones."""\n\n    # Best-effort cleanup so reruns with the same run-id don\'t 409.\n    # We delete by document and by source using the run-id namespaced file names.\n    for fname in (\n        f"docA-{run_id}.md",\n        f"docB-{run_id}.md",\n        f"docC-{run_id}.md",\n    ):\n        try:\n            client.v1.context.delete(\n                organization_id="default",\n                source=source,\n                by_doc=True,\n                user_id=fname,\n            )\n        except Exception as exc:  # noqa: BLE001\n            print(f"[cleanup] delete {fname}: {exc}", file=sys.stderr)\n\n    documents = [\n        {\n            "content": (\n                f"# Document A ({run_id})\\n\\n"\n                "This is engineering v1 release notes covering the platform team\\n"\n                "Q1 launch: new deployment pipeline, observability dashboards,\\n"\n                "and on-call rotations. Marker: docA."\n            ),\n            "metadata": {\n                "file_name": f"docA-{run_id}.md",\n                "group_name": ["eng", "v1"],\n            },\n        },\n        {\n            "content": (\n                f"# Document B ({run_id})\\n\\n"\n                "Engineering v2 changelog: refactored auth, switched to the new\\n"\n                "build system, upgraded the database driver. Marker: docB."\n            ),\n            "metadata": {\n                "file_name": f"docB-{run_id}.md",\n                "group_name": ["eng", "v2"],\n            },\n        },\n        {\n            "content": (\n                f"# Document C ({run_id})\\n\\n"\n                "Public-facing docs v1: user guide, installation, and FAQ for the\\n"\n                "initial GA release. Marker: docC."\n            ),\n            "metadata": {\n                "file_name": f"docC-{run_id}.md",\n                "group_name": ["docs", "v1"],\n            },\n        },\n    ]\n\n    # Try add with graceful handling of 409 Conflict in case cleanup missed.\n    try:\n        client.v1.context.add(\n            context_type="resource",\n            documents=documents,\n            scope="internal",\n            source=source,\n            metadata={\n                "run_id": run_id,\n                "file_name": f"batch-{run_id}.md",\n                "group_name": ["eng", "v1", "v2", "docs"],\n            },\n        )\n        print(f"[ingest] added {len(documents)} documents", file=sys.stderr)\n    except Exception as exc:  # noqa: BLE001\n        # If the batch add fails (e.g., due to conflict on the batch envelope),\n        # add each document individually so partial failures don\'t break reruns.\n        print(f"[ingest] batch add failed ({exc}); falling back to per-doc", file=sys.stderr)\n        for doc in documents:\n            try:\n                client.v1.context.add(\n                    context_type="resource",\n                    documents=[doc],\n                    scope="internal",\n                    source=source,\n                    metadata=doc["metadata"],\n                )\n            except Exception as inner_exc:  # noqa: BLE001\n                print(\n                    f"[ingest] per-doc add failed for {doc[\'metadata\'].get(\'file_name\')}: {inner_exc}",\n                    file=sys.stderr,\n                )\n\n    return documents  # type: ignore[return-value]\n\n\ndef run_search(\n    client: AlchemystAI, groups: List[str], source: str\n) -> List[Dict[str, Any]]:\n    """Perform the filtered search and return deduplicated matches."""\n\n    query = (\n        "engineering platform deployment release notes and public documentation"\n    )\n\n    matches: List[Dict[str, Any]] = []\n    seen: set[str] = set()\n\n    # Short bounded retry loop: vector indexing can take a moment to settle.\n    last_response: Any = None\n    for attempt in range(5):\n        try:\n            response = client.v1.context.search(\n                query=query,\n                minimum_similarity_threshold=0.1,\n                similarity_threshold=0.9,\n                metadata="true",\n                body_metadata={"group_name": groups},\n                scope="internal",\n                user_id=source,\n            )\n        except Exception as exc:  # noqa: BLE001\n            print(f"[search] attempt {attempt + 1} failed: {exc}", file=sys.stderr)\n            time.sleep(1.0)\n            continue\n\n        last_response = response\n        contexts = getattr(response, "contexts", None) or []\n        if contexts:\n            break\n        time.sleep(1.0)\n\n    contexts = getattr(last_response, "contexts", None) or []\n    for ctx in contexts:\n        meta = getattr(ctx, "metadata", None) or {}\n        # metadata may be dict-like or pydantic model\n        if hasattr(meta, "model_dump"):\n            meta = meta.model_dump()\n        elif hasattr(meta, "dict"):\n            meta = meta.dict()\n        if not isinstance(meta, dict):\n            meta = {}\n\n        file_name = meta.get("file_name") or meta.get("fileName")\n        if not file_name:\n            # Fallback: pull a deterministic marker out of the content.\n            content = getattr(ctx, "content", "") or ""\n            for marker in ("docA", "docB", "docC"):\n                if marker in content:\n                    # Recover the run-id namespaced file_name if possible.\n                    for fname in meta.get("file_name_candidates", []) if isinstance(meta, dict) else []:\n                        pass\n                    file_name = None\n                    break\n\n        if file_name and file_name not in seen:\n            seen.add(file_name)\n            matches.append({"file_name": file_name})\n\n    return matches\n\n\ndef main() -> int:\n    groups = parse_args()\n    run_id = read_run_id()\n    source = f"docs-{run_id}"\n\n    print(f"[start] run_id={run_id} groups={groups} source={source}", file=sys.stderr)\n\n    client = make_client()\n    ingest_documents(client, run_id=run_id, source=source)\n    matches = run_search(client, groups=groups, source=source)\n\n    # Final JSON array on the last line of stdout.\n    sys.stdout.write(json.dumps(matches, indent=2))\n    sys.stdout.write("\\n")\n    return 0\n\n\nif __name__ == "__main__":\n    raise SystemExit(main())\nPYEOF\n'] min_timeout_sec: 0.3 max_timeout_sec: 180.0
