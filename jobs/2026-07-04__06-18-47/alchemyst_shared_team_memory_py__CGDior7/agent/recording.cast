[89.400307, "o", "\r\n\r\nif TYPE_CHECKING:\r\n    from .resources import v1\r\n    from .resources.v1.v1 import V1Resource, AsyncV1Resource\r\n\r\n__all__ = [\r\n    \"Timeout\",\r\n    \"Transport\",\r\n    \"ProxiesTypes\",\r\n    \"RequestOptions\",\r\n    \"AlchemystAI\",\r\n    \"AsyncAlchemystAI\",\r\n    \"Client\",\r\n    \"AsyncClient\",\r\n]\r\n\r\n\r\nclass AlchemystAI(SyncAPIClient):\r\n    # client options\r\n    api_key: str | None\r\n\r\n    def __init__(\r\n        self,\r\n        *,\r\n        api_key: str | None = None,"]
