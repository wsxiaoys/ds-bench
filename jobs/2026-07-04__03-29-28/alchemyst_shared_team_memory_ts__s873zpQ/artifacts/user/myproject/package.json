{
  "name": "shared-team-memory-cli",
  "version": "1.0.0",
  "description": "CLI that uses @alchemystai/sdk to demonstrate shared team memory between multiple users in one Alchemyst AI session.",
  "private": true,
  "type": "commonjs",
  "main": "dist/main.js",
  "bin": {
    "shared-team-memory": "dist/main.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "clean": "rm -rf dist",
    "start": "node dist/main.js"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@alchemystai/sdk": "^0.11.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "typescript": "^5.6.3"
  }
}