{
  "name": "vercel-ai-memory",
  "version": "1.0.0",
  "description": "Cross-session memory CLI using Vercel AI SDK wrapped with Alchemyst",
  "type": "module",
  "main": "dist/main.js",
  "scripts": {
    "build": "tsc --noEmit && esbuild src/main.ts --bundle --platform=node --format=esm --target=node18 --outfile=dist/main.js --external:ai --external:@ai-sdk/openai",
    "build:bundle": "esbuild src/main.ts --bundle --platform=node --format=esm --target=node18 --outfile=dist/main.js --external:ai --external:@ai-sdk/openai",
    "typecheck": "tsc --noEmit",
    "start": "node dist/main.js"
  },
  "dependencies": {
    "ai": "^5.0.0",
    "@ai-sdk/openai": "^2.0.0",
    "@alchemystai/aisdk": "^0.0.5"
  },
  "devDependencies": {
    "typescript": "^5.6.0",
    "esbuild": "^0.24.0"
  }
}