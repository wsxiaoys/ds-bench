datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model Sample {
  id             Int      @id @default(autoincrement())
  metric         String
  value          Float
  recordedAt     DateTime
  idempotencyKey String   @unique
  ingestedAt     DateTime @default(now())
}

model MetricRollup {
  id        Int      @id @default(autoincrement())
  metric    String   @unique
  count     Int
  p95       Float?
  avg       Float?
  delta     Float?
  updatedAt DateTime @default(now())
}
