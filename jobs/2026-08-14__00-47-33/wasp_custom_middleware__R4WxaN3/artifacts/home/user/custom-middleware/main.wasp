app customMiddleware {
  wasp: {
    version: "^0.21.1"
  },
  title: "custom-middleware",
  head: [
    "<link rel='icon' href='/favicon.ico' />",
  ],
  server: {
    middlewareConfigFn: import { globalMiddleware } from "@src/server/middleware"
  }
}

route RootRoute { path: "/", to: MainPage }
page MainPage {
  component: import { MainPage } from "@src/MainPage"
}

apiNamespace apiNamespace {
  path: "/api",
  middlewareConfigFn: import { apiNamespaceMiddleware } from "@src/server/middleware"
}

api status {
  fn: import { status } from "@src/server/apis",
  httpRoute: (GET, "/api/status"),
  auth: false
}

api echo {
  fn: import { echo } from "@src/server/apis",
  httpRoute: (POST, "/api/echo"),
  middlewareConfigFn: import { echoMiddleware } from "@src/server/middleware",
  auth: false
}
