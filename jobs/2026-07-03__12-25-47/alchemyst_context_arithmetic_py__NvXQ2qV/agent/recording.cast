[179.059889, "i", "sleep 5 && python3 -c \"\nfrom alchemyst_ai import AlchemystAI\nimport os\nclient = AlchemystAI()\ntry:\n    resp = client.v1.context.add(\n        context_type='resource',\n        source='docs',\n        scope='internal',\n        documents=[{'content': 'hello world'}],\n        metadata={'file_name': 'test_zr4zf5qmfa.md', 'group_name': ['test_group']},\n    )\n    print('Add OK:', resp)\nexcept Exception as e:\n    print('Error:', type(e).__name__, str(e)[:500])\n\"\n"]
