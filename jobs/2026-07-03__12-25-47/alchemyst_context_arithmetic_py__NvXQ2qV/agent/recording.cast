[494.182726, "o", "    raise\r\n\u001b[?2004l\r\u001b[?2004h> \r\n"]
[494.182765, "o", "\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[494.182857, "o", "RUN_ID_ENV = \"ALCHEMYST_RUN_ID\"\r\n\u001b[?2004l\r"]
[494.182895, "o", "\u001b[?2004h> "]
[494.183009, "o", "RUN_ID_FILE = Path(\"/logs/artifacts/run-id\")\r\n\u001b[?2004l\r"]
[494.183054, "o", "\u001b[?2004h> "]
[494.1831, "o", "SOURCE = \"docs\"\r\n\u001b[?2004l\r\u001b[?2004h> "]
[494.183156, "o", "SCOPE = \"internal\"\r\n\u001b[?2004l\r"]
[494.183196, "o", "\u001b[?2004h> "]
[494.183282, "o", "CONTEXT_TYPE = \"resource\"\r\n\u001b[?2004l\r"]
[494.183323, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[494.183426, "o", "DOCUMENTS: List[Dict[str, Any]] = [\r\n\u001b[?2004l\r"]
[494.183463, "o", "\u001b[?2004h> "]
[494.183508, "o", "    {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[494.183583, "o", "        \"suffix\": \"docA\",\r\n\u001b[?2004l\r"]
[494.183621, "o", "\u001b[?2004h> "]
[494.183733, "o", "        \"groups\": [\"eng\", \"v1\"],\r\n\u001b[?2004l\r\u001b[?2004h"]
[494.183773, "o", "> "]
[494.183836, "o", "        \"content\": (\r\n\u001b[?2004l\r"]
[494.183877, "o", "\u001b[?2004h> "]
[494.184074, "o", "            \"Document A: engineering design notes for version 1 of the \"\r\n\u001b[?2004l\r"]
[494.184115, "o", "\u001b[?2004h> "]
[494.184325, "o", "            \"authentication subsystem. Covers JWT issuance, refresh token \"\r\n\u001b[?2004l\r"]
[494.184365, "o", "\u001b[?2004h> "]
[494.184577, "o", "            \"rotation and the public-key bootstrap process.\"\r\n\u001b[?2004l\r"]
[494.184616, "o", "\u001b[?2004h> "]
[494.184656, "o", "        ),\r\n\u001b[?2004l\r\u001b[?2004h"]
[494.184699, "o", ">     },\r\n\u001b[?2004l\r"]
[494.18474, "o", "\u001b[?2004h>     {\r\n\u001b[?2004l\r"]
[494.184778, "o", "\u001b[?2004h> "]
[494.184836, "o", "        \"suffix\": \"docB\",\r\n\u001b[?2004l\r"]
[494.184872, "o", "\u001b[?2004h> "]
[494.184992, "o", "        \"groups\": [\"eng\", \"v2\"],\r\n\u001b[?2004l\r"]
[494.185031, "o", "\u001b[?2004h> "]
[494.185096, "o", "        \"content\": (\r\n\u001b[?2004l\r\u001b[?2004h"]
[494.185135, "o", "> "]
[494.18531, "o", "            \"Document B: engineering design notes for version 2 of the \"\r\n\u001b[?2004l\r"]
[494.185348, "o", "\u001b[?2004h> "]
[494.18559, "o", "            \"authentication subsystem. Replaces the v1 design with a \"\r\n\u001b[?2004l\r"]
[494.18563, "o", "\u001b[?2004h> "]
[494.185864, "o", "            \"short-lived access token plus rotating refresh tokens.\"\r\n\u001b[?2004l\r"]
[494.185905, "o", "\u001b[?2004h> "]
[494.185948, "o", "        ),\r\n\u001b[?2004l\r\u001b[?2004h"]
[494.185985, "o", ">     },\r\n\u001b[?2004l\r"]
[494.186028, "o", "\u001b[?2004h>     {\r\n\u001b[?2004l\r"]
[494.186072, "o", "\u001b[?2004h> "]
[494.18613, "o", "        \"suffix\": \"docC\",\r\n\u001b[?2004l\r"]
[494.186166, "o", "\u001b[?2004h> "]
[494.186282, "o", "        \"groups\": [\"docs\", \"v1\"],\r\n\u001b[?2004l\r"]
[494.186321, "o", "\u001b[?2004h> "]
[494.186375, "o", "        \"content\": (\r\n\u001b[?2004l\r"]
[494.186416, "o", "\u001b[?2004h> "]
[494.186665, "o", "            \"Document C: public customer-facing documentation for version 1 \"\r\n\u001b[?2004l\r"]
[494.186706, "o", "\u001b[?2004h> "]
[494.186956, "o", "            \"of the API. Describes refund policy, shipping policy and how \"\r\n\u001b[?2004l\r"]
[494.186995, "o", "\u001b[?2004h> "]
[494.187165, "o", "            \"customers authenticate against the public API.\"\r\n\u001b[?2004l\r"]
[494.187206, "o", "\u001b[?2004h> "]
[494.187249, "o", "        ),\r\n\u001b[?2004l\r\u001b[?2004h"]
[494.187289, "o", ">     },\r\n\u001b[?2004l\r"]
[494.18733, "o", "\u001b[?2004h> ]\r\n\u001b[?2004l\r\u001b[?2004h> \r\n"]
[494.187372, "o", "\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[494.187451, "o", "def log(msg: str) -> None:\r\n\u001b[?2004l\r"]
[494.187562, "o", "\u001b[?2004h> "]
[494.187675, "o", "    sys.stderr.write(\"[alch-cli] \" + msg + \"\\n\")\r\n\u001b[?2004l\r\u001b[?2004h"]
[494.187714, "o", "> "]
[494.187774, "o", "    sys.stderr.flush()\r\n\u001b[?2004l\r"]
[494.187805, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[494.187834, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h"]
[494.187888, "o", "> "]
[494.187967, "o", "def read_run_id() -> str:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[494.188131, "o", "    env_val = os.environ.get(RUN_ID_ENV)\r\n\u001b[?2004l\r"]
[494.188159, "o", "\u001b[?2004h> "]
[494.188202, "o", "    if env_val:\r\n\u001b[?2004l\r"]
[494.188228, "o", "\u001b[?2004h> "]
[494.188354, "o", "        return env_val.strip()\r\n\u001b[?2004l\r\u001b[?2004h"]
[494.188384, "o", "> "]
[494.188482, "o", "    if RUN_ID_FILE.exists():\r\n\u001b[?2004l\r"]
[494.18852, "o", "\u001b[?2004h> "]
[494.188642, "o", "        return RUN_ID_FILE.read_text().strip()\r\n\u001b[?2004l\r"]
[494.188682, "o", "\u001b[?2004h> "]
[494.188794, "o", "    return str(int(time.time()))\r\n\u001b[?2004l\r\u001b[?2004h"]
[494.188836, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[494.188875, "o", "\u001b[?2004h> "]
[494.189073, "o", "def build_documents(run_id: str) -> List[Dict[str, Any]]:\r\n\u001b[?2004l\r\u001b[?2004h"]
[494.189116, "o", "> "]
[494.189228, "o", "    docs: List[Dict[str, Any]] = []\r\n\u001b[?2004l\r\u001b[?2004h"]
[494.189268, "o", "> "]
[494.189327, "o", "    for entry in DOCUMENTS:\r\n\u001b[?2004l\r"]
[494.189366, "o", "\u001b[?2004h> "]
[494.189572, "o", "        file_name = entry[\"suffix\"] + \"-\" + run_id + \".md\"\r\n\u001b[?2004l\r\u001b[?2004h"]
[494.189612, "o", "> "]
[494.189778, "o", "        marker = \"FILE_NAME_MARKER:\" + file_name\r\n\u001b[?2004l\r"]
[494.189818, "o", "\u001b[?2004h> "]
[494.189883, "o", "        docs.append({\r\n\u001b[?2004l\r"]
[494.189923, "o", "\u001b[?2004h> "]
[494.190132, "o", "            \"content\": marker + \"\\n\" + entry[\"content\"],\r\n\u001b[?2004l\r\u001b[?2004h"]
[494.190205, "o", ">             \"metadata\": {\r\n"]
[494.190236, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[494.190348, "o", "                \"file_name\": file_name,\r\n\u001b[?2004l\r"]
[494.190376, "o", "\u001b[?2004h> "]
[494.190563, "o", "                \"group_name\": list(entry[\"groups\"]),\r\n\u001b[?2004l\r\u001b[?2004h"]
[494.190605, "o", "> "]
[494.190742, "o", "                \"file_type\": \"text/markdown\",\r\n\u001b[?2004l\r"]
[494.19078, "o", "\u001b[?2004h> "]
[494.190999, "o", "                \"last_modified\": time.strftime(\"%Y-%m-%dT%H:%M:%SZ\", time.gmtime()),\r\n\u001b[?2004l\r"]
[494.19104, "o", "\u001b[?2004h> "]
[494.191093, "o", "            },\r\n\u001b[?2004l\r\u001b[?2004h> "]
[494.191182, "o", "        })\r\n\u001b[?2004l\r"]
[494.19125, "o", "\u001b[?2004h>     return docs\r\n"]
[494.191291, "o", "\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[494.206944, "o", "> def safe_delete(client: AlchemystAI) -> None:\r\n\u001b[?2004l\r\u001b[?2004h>     candidates = [\r\n\u001b[?2004l\r\u001b[?2004h>         {\"organization_id\": \"default\", \"source\": SOURCE, \"by_doc\": True},\r\n\u001b[?2004l\r\u001b[?2004h>         {\"organization_id\": \"default\", \"source\": SOURCE},\r\n\u001b[?2004l\r\u001b[?2004h>     ]\r\n\u001b[?2004l\r\u001b[?2004h>     for params in candidates:\r\n\u001b[?2004l\r\u001b[?2004h>         try:\r\n\u001b[?2004l\r\u001b[?2004h>             client.v1.context.delete(**params)\r\n\u001b[?2004l\r\u001b[?2004h>             log(\"delete succeeded with params=\" + json.dumps(params))\r\n\u001b[?2004l\r\u001b[?2004h>             return\r\n\u001b[?2004l\r\u001b[?2004h>         except Exception as exc:  # noqa: BLE001\r\n\u001b[?2004l\r"]
[494.20702, "o", "\u001b[?2004h> "]
[494.207274, "o", "            log(\"delete attempt failed (\" + type(exc).__name__ + \"): \" + str(exc))\r\n\u001b[?2004l\r"]
[494.207341, "o", "\u001b[?2004h> "]
[494.207371, "o", "            continue\r\n\u001b[?2004l\r"]
[494.207401, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[494.207437, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r_\u001b[?2004h"]
[494.207469, "o", "> "]
[494.207768, "o", "def ingest_documents(client: AlchemystAI, documents: List[Dict[str, Any]]) -> None:\r\n\u001b[?2004l\r\u001b[?2004h"]
[494.207818, "o", ">     try:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[494.20793, "o", "        safe_delete(client)\r\n\u001b[?2004l\r"]
[494.207977, "o", "\u001b[?2004h> "]
[494.208131, "o", "    except Exception as exc:  # noqa: BLE001\r\n\u001b[?2004l\r"]
[494.20816, "o", "\u001b[?2004h> "]
[494.208378, "o", "        log(\"safe_delete raised (ignored): \" + str(exc))\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[494.208424, "o", "> "]
[494.208469, "o", "    def _do_add() -> None:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[494.208543, "o", "        client.v1.context.add(\r\n\u001b[?2004l\r"]
[494.208588, "o", "\u001b[?2004h> "]
[494.208649, "o", "            context_type=CONTEXT_TYPE,\r\n\u001b[?2004l\r"]
[494.208692, "o", "\u001b[?2004h> "]
[494.208736, "o", "            source=SOURCE,\r\n\u001b[?2004l\r"]
[494.208766, "o", "\u001b[?2004h> "]
[494.208825, "o", "            scope=SCOPE,\r\n\u001b[?2004l\r\u001b[?2004h> "]
[494.208903, "o", "            documents=documents,\r\n\u001b[?2004l\r"]
[494.208931, "o", "\u001b[?2004h> "]
[494.209072, "o", "            metadata={\"group_name\": [\"context-arithmetic-run\"]},\r\n\u001b[?2004l\r\u001b[?2004h"]
[494.209118, "o", ">         )\r\n\u001b[?2004l\r"]
[494.209164, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[494.209194, "o", "    try:\r\n\u001b[?2004l\r"]
[494.209269, "o", "\u001b[?2004h> "]
[494.20937, "o", "        _do_add()\r\n\u001b[?2004l\r\u001b[?2004h> "]
[494.209422, "o", "        log(\"ingested \" + str(len(documents)) + \" documents\")\r\n\u001b[?2004l\r\u001b[?2004h"]
[494.209472, "o", ">         return\r\n\u001b[?2004l\r"]
[494.209516, "o", "\u001b[?2004h> "]
[494.20959, "o", "    except Exception as exc:  # noqa: BLE001\r\n\u001b[?2004l\r"]
[494.209616, "o", "\u001b[?2004h> "]
[494.209743, "o", "        log(\"add raised \" + type(exc).__name__ + \": \" + str(exc))\r\n\u001b[?2004l\r"]
[494.209791, "o", "\u001b[?2004h>         try:\r\n\u001b[?2004l\r"]
[494.209832, "o", "\u001b[?2004h> "]
[494.209889, "o", "            safe_delete(client)\r\n\u001b[?2004l\r"]
[494.209914, "o", "\u001b[?2004h> "]
[494.21002, "o", "        except Exception as exc2:  # noqa: BLE001\r\n\u001b[?2004l\r"]
[494.210079, "o", "\u001b[?2004h> "]
[494.210188, "o", "            log(\"retry safe_delete raised (ignored): \" + str(exc2))\r\n\u001b[?2004l\r"]
[494.210234, "o", "\u001b[?2004h> "]
[494.210272, "o", "        _do_add()\r\n\u001b[?2004l\r\u001b[?2004h> "]
[494.210427, "o", "        log(\"ingested \" + str(len(documents)) + \" documents after retry\")\r\n\u001b[?2004l\r"]
[494.21045, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[494.210478, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[494.210506, "o", "\u001b[?2004h> "]
[494.210678, "o", "def search_documents(client: AlchemystAI, groups: List[str]) -> List[Dict[str, Any]]:\r\n\u001b[?2004l\r\u001b[?2004h"]
[494.210703, "o", "> "]
[494.210766, "o", "    query = (\r\n\u001b[?2004l\r\u001b[?2004h> "]
[494.210894, "o", "        \"engineering design authentication documentation version \"\r\n\u001b[?2004l\r"]
[494.210917, "o", "\u001b[?2004h> "]
[494.210984, "o", "        \"context arithmetic\"\r\n\u001b[?2004l\r"]
[494.211007, "o", "\u001b[?2004h>     )\r\n"]
[494.211075, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[494.21112, "o", "    params: Dict[str, Any] = {\r\n\u001b[?2004l\r"]
[494.211151, "o", "\u001b[?2004h> "]
[494.211227, "o", "        \"query\": query,\r\n\u001b[?2004l\r\u001b[?2004h> "]
[494.211297, "o", "        \"similarity_threshold\": 0.1,\r\n\u001b[?2004l\r"]
[494.211349, "o", "\u001b[?2004h> "]
[494.211418, "o", "        \"minimum_similarity_threshold\": 0.0,\r\n\u001b[?2004l\r"]
[494.21147, "o", "\u001b[?2004h> "]
[494.211515, "o", "        \"scope\": SCOPE,\r\n\u001b[?2004l\r\u001b[?2004h> "]
[494.211619, "o", "        \"metadata\": {\"group_name\": list(groups)},\r\n\u001b[?2004l\r"]
[494.211645, "o", "\u001b[?2004h>     }\r\n"]
[494.211673, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[494.211702, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[494.211787, "o", "    response = None\r\n\u001b[?2004l\r\u001b[?2004h> "]
[494.211854, "o", "    last_err: Optional[Exception] = None\r\n\u001b[?2004l\r"]
[494.211905, "o", "\u001b[?2004h> "]
[494.211954, "o", "    for attempt in range(5):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[494.212006, "o", "        try:\r\n\u001b[?2004l\r\u001b[?2004h"]
[494.212032, "o", "> "]
[494.212156, "o", "            response = client.v1.context.search(**params)\r\n\u001b[?2004l\r\u001b[?2004h"]
[494.21218, "o", "> "]
[494.212236, "o", "            break\r\n\u001b[?2004l\r\u001b[?2004h> "]
[494.212371, "o", "        except Exception as exc:  # noqa: BLE001\r\n\u001b[?2004l\r"]
[494.212422, "o", "\u001b[?2004h> "]
[494.212468, "o", "            last_err = exc\r\n\u001b[?2004l\r\u001b[?2004h> "]
[494.212645, "o", "            log(\"search attempt \" + str(attempt) + \" failed: \" + str(exc))\r\n\u001b[?2004l\r"]
[494.212699, "o", "\u001b[?2004h> "]
[494.212757, "o", "            time.sleep(0.5 + attempt * 0.5)\r\n\u001b[?2004l\r\u001b[?2004h"]
[494.212809, "o", "> "]
[494.212869, "o", "    if response is None:  # pragma: no cover\r\n\u001b[?2004l\r"]
[494.21292, "o", "\u001b[?2004h> "]
[494.213049, "o", "        raise RuntimeError(\"search failed after retries: \" + str(last_err))\r\n\u001b[?2004l\r"]
[494.213115, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[494.213155, "o", "> "]
[494.213183, "o", "    contexts = response.contexts or []\r\n\u001b[?2004l\r"]
[494.213208, "o", "\u001b[?2004h> "]
[494.213351, "o", "    log(\"search returned \" + str(len(contexts)) + \" raw context(s)\")\r\n\u001b[?2004l\r\u001b[?2004h"]
[494.213374, "o", "> \r\n\u001b[?2004l\r"]
[494.213431, "o", "\u001b[?2004h>     seen = set()\r\n\u001b[?2004l\r"]
[494.213482, "o", "\u001b[?2004h> "]
[494.213546, "o", "    results: List[Dict[str, Any]] = []\r\n\u001b[?2004l\r"]
[494.213597, "o", "\u001b[?2004h> "]
[494.213644, "o", "    for ctx in contexts:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[494.213749, "o", "        meta = getattr(ctx, \"metadata\", None)\r\n\u001b[?2004l\r"]
[494.213801, "o", "\u001b[?2004h> "]
[494.213847, "o", "        file_name = None\r\n\u001b[?2004l\r\u001b[?2004h> "]
[494.213921, "o", "        if isinstance(meta, dict):\r\n\u001b[?2004l\r"]
[494.213973, "o", "\u001b[?2004h> "]
[494.214041, "o", "            file_name = meta.get(\"file_name\")\r\n\u001b[?2004l\r"]
[494.2141, "o", "\u001b[?2004h> "]
[494.214148, "o", "        elif meta is not None:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[494.2142, "o", "            try:\r\n\u001b[?2004l\r\u001b[?2004h"]
[494.214251, "o", "> "]
[494.214299, "o", "                meta_dict = dict(meta)\r\n\u001b[?2004l\r"]
[494.214351, "o", "\u001b[?2004h> "]
[494.214436, "o", "                file_name = meta_dict.get(\"file_name\")\r\n\u001b[?2004l\r"]
[494.214489, "o", "\u001b[?2004h> "]
[494.214559, "o", "            except Exception:  # noqa: BLE001\r\n\u001b[?2004l\r"]
[494.214612, "o", "\u001b[?2004h> "]
[494.214661, "o", "                meta_dict = {}\r\n\u001b[?2004l\r\u001b[?2004h"]
[494.214714, "o", ">         if not file_name:\r\n"]
[494.214765, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[494.214873, "o", "            content = getattr(ctx, \"content\", None) or \"\"\r\n\u001b[?2004l\r"]
[494.214924, "o", "\u001b[?2004h> "]
[494.214984, "o", "            marker = \"FILE_NAME_MARKER:\"\r\n\u001b[?2004l\r"]
[494.215035, "o", "\u001b[?2004h> "]
[494.215092, "o", "            if marker in content:\r\n\u001b[?2004l\r\u001b[?2004h"]
[494.215117, "o", "> "]
[494.21528, "o", "                file_name = content.split(marker, 1)[1].split(\"\\n\", 1)[0].strip()\r\n\u001b[?2004l\r\u001b[?2004h"]
[494.215333, "o", "> "]
[494.215399, "o", "        if not file_name or file_name in seen:\r\n\u001b[?2004l\r"]
[494.215454, "o", "\u001b[?2004h>             continue\r\n"]
[494.215482, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[494.215548, "o", "        seen.add(file_name)\r\n\u001b[?2004l\r\u001b[?2004h"]
[494.215572, "o", "> "]
[494.215684, "o", "        entry: Dict[str, Any] = {\"file_name\": file_name}\r\n\u001b[?2004l\r\u001b[?2004h"]
[494.215708, "o", "> "]
[494.215777, "o", "        if isinstance(meta, dict):\r\n\u001b[?2004l\r\u001b[?2004h"]
[494.215801, "o", "> "]
[494.215873, "o", "            entry[\"metadata\"] = meta\r\n\u001b[?2004l\r\u001b[?2004h"]
[494.215924, "o", "> "]
[494.215978, "o", "        score = getattr(ctx, \"score\", None)\r\n\u001b[?2004l\r\u001b[?2004h"]
[494.216001, "o", "> "]
[494.216072, "o", "        if score is not None:\r\n\u001b[?2004l\r\u001b[?2004h"]
[494.216099, "o", "> "]
[494.21617, "o", "            entry[\"score\"] = score\r\n\u001b[?2004l\r\u001b[?2004h"]
[494.216195, "o", "> "]
[494.216253, "o", "        results.append(entry)\r\n\u001b[?2004l\r\u001b[?2004h> \r\n"]
[494.216306, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[494.21635, "o", "    return results\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[494.216401, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[494.216552, "o", "def parse_args(argv: Optional[List[str]] = None) -> argparse.Namespace:\r\n\u001b[?2004l\r"]
[494.216604, "o", "\u001b[?2004h> "]
[494.216654, "o", "    parser = argparse.ArgumentParser(\r\n\u001b[?2004l\r\u001b[?2004h"]
[494.216683, "o", "> "]
[494.21674, "o", "        description=(\r\n\u001b[?2004l\r\u001b[?2004h> "]
[494.216886, "o", "            \"Demonstrate Alchemyst AI Context Arithmetic intersection: \"\r\n\u001b[?2004l\r\u001b[?2004h"]
[494.216937, "o", "> "]
[494.217072, "o", "            \"ingest documents and search the intersection of the given \"\r\n\u001b[?2004l\r\u001b[?2004h"]
[494.217106, "o", "> "]
[494.217178, "o", "            \"groups.\"\r\n\u001b[?2004l\r\u001b[?2004h>         )\r\n\u001b[?2004l\r\u001b[?2004h"]
[494.217226, "o", ">     )\r\n\u001b[?2004l\r\u001b[?2004h"]
[494.21727, "o", "> "]
[494.217314, "o", "    parser.add_argument(\r\n\u001b[?2004l\r\u001b[?2004h> "]
[494.217361, "o", "        \"--groups\",\r\n\u001b[?2004l\r\u001b[?2004h"]
[494.217408, "o", "> "]
[494.217452, "o", "        nargs=\"+\",\r\n\u001b[?2004l\r\u001b[?2004h> "]
[494.217497, "o", "        required=True,\r\n\u001b[?2004l\r"]
[494.217543, "o", "\u001b[?2004h> "]
[494.217673, "o", "        help=\"One or more group names to intersect (e.g. --groups eng v1).\",\r\n\u001b[?2004l\r"]
[494.217717, "o", "\u001b[?2004h>     )\r\n\u001b[?2004l\r\u001b[?2004h"]
[494.217761, "o", "> "]
[494.217808, "o", "    return parser.parse_args(argv)\r\n\u001b[?2004l\r"]
[494.217851, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[494.217895, "o", "\u001b[?2004h> "]
[494.217989, "o", "def main(argv: Optional[List[str]] = None) -> int:\r\n\u001b[?2004l\r"]
[494.218036, "o", "\u001b[?2004h> "]
[494.218091, "o", "    args = parse_args(argv)\r\n\u001b[?2004l\r\u001b[?2004h"]
[494.21812, "o", "> "]
[494.218178, "o", "    run_id = read_run_id()\r\n\u001b[?2004l\r\u001b[?2004h> "]
[494.218248, "o", "    groups = list(args.groups)\r\n\u001b[?2004l\r\u001b[?2004h"]
[494.218276, "o", "> "]
[494.218392, "o", "    log(\"run-id=\" + run_id + \" groups=\" + \",\".join(groups))\r\n\u001b[?2004l\r\u001b[?2004h"]
[494.21844, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[494.218541, "o", "    api_key = os.environ.get(\"ALCHEMYST_AI_API_KEY\")\r\n\u001b[?2004l\r"]
[494.21859, "o", "\u001b[?2004h> "]
[494.218636, "o", "    if not api_key:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[494.218799, "o", "        sys.stderr.write(\"ALCHEMYST_AI_API_KEY environment variable not set\\n\")\r\n\u001b[?2004l\r"]
[494.218847, "o", "\u001b[?2004h>         return 2\r\n\u001b[?2004l\r"]
[494.218893, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[494.218939, "o", "> "]
[494.218996, "o", "    client = AlchemystAI(api_key=api_key)\r\n\u001b[?2004l\r"]
[494.219044, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[494.219141, "o", "    documents = build_documents(run_id)\r\n\u001b[?2004l\r"]
[494.219189, "o", "\u001b[?2004h> "]
[494.219247, "o", "    ingest_documents(client, documents)\r\n\u001b[?2004l\r"]
[494.219275, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[494.219389, "o", "    matches = search_documents(client, groups)\r\n\u001b[?2004l\r\u001b[?2004h"]
[494.219442, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[494.219559, "o", "    sys.stdout.write(json.dumps(matches, indent=2, default=str))\r\n\u001b[?2004l\r\u001b[?2004h"]
[494.219604, "o", "> "]
[494.219651, "o", "    sys.stdout.write(\"\\n\")\r\n\u001b[?2004l\r\u001b[?2004h> "]
[494.219707, "o", "    sys.stdout.flush()\r\n\u001b[?2004l\r"]
[494.219753, "o", "\u001b[?2004h>     return 0\r\n"]
[494.219782, "o", "\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[494.219808, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[494.219879, "o", "\u001b[?2004h> "]
[494.219928, "o", "if __name__ == \"__main__\":\r\n\u001b[?2004l\r\u001b[?2004h> "]
[494.219978, "o", "    sys.exit(main())\r\n\u001b[?2004l\r\u001b[?2004h"]
[494.220031, "o", "> MAINEOF\r\n\u001b[?2004l\r"]
