e_url=base_url,\r\n/usr/local/lib/python3.12/dist-packages/alchemyst_ai/_base_client.py:            base_url=base_url,\r\n/usr/local/lib/python3.12/dist-packages/alchemyst_ai/_client.py:        base_url: str | httpx.URL | None = None,\r\n/usr/local/lib/python3.12/dist-packages/alchemyst_ai/_client.py:        if base_url is None:\r\ngrep: /usr/local/lib/python3.12/dist-packages/alchemyst_ai/_client.py:            base_url = os.environ.get(\"ALCHEMYST_AI_BASE_URL\")\r\n/usr/local/lib/python3.12/dist-packages/alchemyst_ai/__pycache__/_client.cpython-312.pyc: binary file matches\r\n"]
