[103.912289, "o", "> "]
[103.912396, "o", "            Thread t = threads[i];\r\n\u001b[?2004l\r\u001b[?2004h> "]
[103.912539, "o", "            if (t != null && t.getName() != null\r\n\u001b[?2004l\r\u001b[?2004h> "]
