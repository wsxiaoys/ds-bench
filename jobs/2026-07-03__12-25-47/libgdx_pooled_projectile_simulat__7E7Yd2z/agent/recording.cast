[103.907802, "o", "> "]
[103.908001, "o", "            // The internal thread that runs create()/render()/dispose()\r\n\u001b[?2004l\r\u001b[?2004h> "]
[103.908242, "o", "            // is not exposed, so we poll until Gdx.app no longer exists\r\n\u001b[?2004l\r\u001b[?2004h"]
[103.908298, "o", "> "]
