[103.911931, "o", "        Thread[] threads = new Thread[Thread.activeCount() * 2];\r\n\u001b[?2004l\r\u001b[?2004h> "]
[103.912086, "o", "        int n = Thread.enumerate(threads);\r\n\u001b[?2004l\r\u001b[?2004h"]
[103.912143, "o", "> "]
