[438.606294, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[438.606713, "o", "    private BufferedWriter writer;\r\n\u001b[?2004l\r"]
[438.606762, "o", "\u001b[?2004h"]
[438.606855, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h"]
[438.606904, "o", "> "]
[438.607744, "o", "    public SimulationListener(String scenarioPath, String outputPath) {\r\n\u001b[?2004l\r"]
[438.607796, "o", "\u001b[?2004h> "]
[438.608328, "o", "        this.scenarioPath = scenarioPath;\r\n\u001b[?2004l\r"]
[438.608425, "o", "\u001b[?2004h> "]
[438.608836, "o", "        this.outputPath = outputPath;\r\n\u001b[?2004l\r"]
[438.608935, "o", "\u001b[?2004h> "]
[438.609026, "o", "    }\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[438.609118, "o", "\u001b[?2004h> "]
[438.609295, "o", "    @Override\r\n\u001b[?2004l\r"]
[438.609385, "o", "\u001b[?2004h> "]
[438.609715, "o", "    public void create() {\r\n\u001b[?2004l\r"]
[438.609808, "o", "\u001b[?2004h> "]
[438.609948, "o", "        try {\r\n\u001b[?2004l\r"]
[438.610043, "o", "\u001b[?2004h> "]
[438.610637, "o", "            Path outFile = Paths.get(outputPath);\r\n\u001b[?2004l\r\u001b[?2004h"]
[438.610748, "o", "> "]
[438.611236, "o", "            if (outFile.getParent() != null) {\r\n\u001b[?2004l\r"]
[438.611286, "o", "\u001b[?2004h> "]
[438.611953, "o", "                Files.createDirectories(outFile.getParent());\r\n\u001b[?2004l\r"]
[438.612003, "o", "\u001b[?2004h> "]
[438.612151, "o", "            }\r\n\u001b[?2004l\r"]
[438.612202, "o", "\u001b[?2004h> "]
[438.612914, "o", "            writer = Files.newBufferedWriter(outFile, StandardCharsets.UTF_8);\r\n\u001b[?2004l\r"]
[438.612964, "o", "\u001b[?2004h> "]
[438.613016, "o", "\r\n\u001b[?2004l\r\u001b[?2004h"]
[438.613068, "o", "> "]
[438.613622, "o", "            FileHandle fh = Gdx.files.absolute(scenarioPath);\r\n\u001b[?2004l\r"]
[438.613722, "o", "\u001b[?2004h> "]
[438.614187, "o", "            String contents = fh.readString(\"UTF-8\");\r\n\u001b[?2004l\r"]
[438.614281, "o", "\u001b[?2004h> "]
[438.614578, "o", "            parseScenario(contents);\r\n\u001b[?2004l\r"]
[438.614679, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[438.614774, "o", "> "]
[438.615145, "o", "            writeLine(\"TICKS \" + totalTicks);\r\n\u001b[?2004l\r"]
[438.615242, "o", "\u001b[?2004h> "]
[438.615532, "o", "        } catch (IOException e) {\r\n\u001b[?2004l\r"]
[438.615613, "o", "\u001b[?2004h> "]
[438.616346, "o", "            throw new RuntimeException(\"Failed to initialise simulation\", e);\r\n\u001b[?2004l\r"]
[438.616445, "o", "\u001b[?2004h> "]
[438.616531, "o", "        }\r\n\u001b[?2004l\r"]
[438.616625, "o", "\u001b[?2004h>     }\r\n\u001b[?2004l\r"]
[438.616722, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[438.616798, "o", "\u001b[?2004h> "]
[438.617249, "o", "    private void parseScenario(String contents) {\r\n\u001b[?2004l\r"]
[438.617317, "o", "\u001b[?2004h> "]
[438.617756, "o", "        String[] lines = contents.split(\"\\r?\\n\");\r\n\u001b[?2004l\r"]
[438.617823, "o", "\u001b[?2004h> "]
[438.61823, "o", "        for (String raw : lines) {\r\n\u001b[?2004l\r"]
[438.618301, "o", "\u001b[?2004h> "]
[438.61877, "o", "            String line = raw.trim();\r\n\u001b[?2004l\r"]
[438.618835, "o", "\u001b[?2004h> "]
[438.619539, "o", "            if (line.isEmpty() || line.startsWith(\"#\")) {\r\n\u001b[?2004l\r"]
[438.619602, "o", "\u001b[?2004h> "]
[438.61992, "o", "                continue;\r\n\u001b[?2004l\r"]
[438.619987, "o", "\u001b[?2004h> "]
[438.620146, "o", "            }\r\n\u001b[?2004l\r"]
[438.620227, "o", "\u001b[?2004h> "]
[438.620824, "o", "            String[] parts = line.split(\"\\\\s+\");\r\n\u001b[?2004l\r"]
[438.620906, "o", "\u001b[?2004h> "]
[438.621314, "o", "            String head = parts[0];\r\n\u001b[?2004l\r"]
[438.621403, "o", "\u001b[?2004h> "]
[438.621659, "o", "            switch (head) {\r\n\u001b[?2004l\r"]
[438.621761, "o", "\u001b[?2004h> "]
[438.62204, "o", "                case \"TICKS\": {\r\n\u001b[?2004l\r"]
[438.622122, "o", "\u001b[?2004h> "]
[438.622652, "o", "                    totalTicks = Integer.parseInt(parts[1]);\r\n\u001b[?2004l\r"]
[438.622738, "o", "\u001b[?2004h> "]
[438.622964, "o", "                    break;\r\n\u001b[?2004l\r"]
[438.623046, "o", "\u001b[?2004h> "]
[438.623194, "o", "                }\r\n\u001b[?2004l\r"]
[438.623276, "o", "\u001b[?2004h> "]
[438.623527, "o", "                case \"GRAVITY\": {\r\n\u001b[?2004l\r"]
[438.623604, "o", "\u001b[?2004h> "]
[438.624057, "o", "                    gravityX = Integer.parseInt(parts[1]);\r\n\u001b[?2004l\r"]
[438.624133, "o", "\u001b[?2004h> "]
[438.62457, "o", "                    gravityY = Integer.parseInt(parts[2]);\r\n\u001b[?2004l\r"]
[438.624643, "o", "\u001b[?2004h> "]
[438.624806, "o", "                    break;\r\n\u001b[?2004l\r"]
[438.624881, "o", "\u001b[?2004h> "]
[438.624975, "o", "                }\r\n\u001b[?2004l\r"]
[438.625056, "o", "\u001b[?2004h> "]
[438.625225, "o", "                case \"FLOOR\": {\r\n\u001b[?2004l\r"]
[438.625296, "o", "\u001b[?2004h> "]
[438.62563, "o", "                    floorY = Integer.parseInt(parts[1]);\r\n\u001b[?2004l\r"]
[438.625708, "o", "\u001b[?2004h> "]
[438.625867, "o", "                    break;\r\n\u001b[?2004l\r"]
[438.625943, "o", "\u001b[?2004h> "]
[438.626029, "o", "                }\r\n\u001b[?2004l\r"]
[438.626109, "o", "\u001b[?2004h> "]
[438.626292, "o", "                case \"SPAWN\": {\r\n\u001b[?2004l\r"]
[438.626371, "o", "\u001b[?2004h> "]
[438.62672, "o", "                    int tick = Integer.parseInt(parts[1]);\r\n\u001b[?2004l\r"]
[438.626807, "o", "\u001b[?2004h> "]
[438.627113, "o", "                    int x = Integer.parseInt(parts[2]);\r\n\u001b[?2004l\r"]
[438.627186, "o", "\u001b[?2004h> "]
[438.627512, "o", "                    int y = Integer.parseInt(parts[3]);\r\n\u001b[?2004l\r"]
[438.627593, "o", "\u001b[?2004h> "]
[438.627926, "o", "                    int vx = Integer.parseInt(parts[4]);\r\n\u001b[?2004l\r\u001b[?2004h"]
[438.628002, "o", "> "]
[438.628322, "o", "                    int vy = Integer.parseInt(parts[5]);\r\n\u001b[?2004l\r"]
[438.6284, "o", "\u001b[?2004h> "]
[438.629045, "o", "                    spawnsByTick.computeIfAbsent(tick, k -> new ArrayList<>()).add(new int[]{x, y, vx, vy});\r\n\u001b[?2004l\r\u001b[?2004h"]
[438.629138, "o", "> "]
[438.629309, "o", "                    totalSpawns++;\r\n\u001b[?2004l\r"]
[438.629388, "o", "\u001b[?2004h> "]
[438.629532, "o", "                    break;\r\n\u001b[?2004l\r"]
[438.629611, "o", "\u001b[?2004h> "]
[438.629709, "o", "                }\r\n\u001b[?2004l\r"]
[438.629794, "o", "\u001b[?2004h> "]
[438.629911, "o", "                default:\r\n\u001b[?2004l\r"]
[438.629987, "o", "\u001b[?2004h> "]
[438.630501, "o", "                    throw new IllegalArgumentException(\"Unknown directive: \" + head);\r\n\u001b[?2004l\r\u001b[?2004h"]
[438.630588, "o", "> "]
[438.630666, "o", "            }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[438.630773, "o", "        }\r\n\u001b[?2004l\r\u001b[?2004h"]
[438.630848, "o", ">     }\r\n\u001b[?2004l\r"]
[438.630932, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[438.631012, "o", "> "]
[438.631085, "o", "    @Override\r\n\u001b[?2004l\r\u001b[?2004h"]
[438.631169, "o", "> "]
[438.63129, "o", "    public void render() {\r\n\u001b[?2004l\r\u001b[?2004h"]
[438.631374, "o", "> "]
[438.631598, "o", "        if (currentTick >= totalTicks) {\r\n\u001b[?2004l\r\u001b[?2004h"]
[438.631777, "o", "> "]
[438.631861, "o", "            Gdx.app.exit();\r\n\u001b[?2004l\r\u001b[?2004h"]
[438.631939, "o", "> "]
[438.632026, "o", "            return;\r\n\u001b[?2004l\r"]
[438.632097, "o", "\u001b[?2004h> "]
[438.632177, "o", "        }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[438.63228, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[438.632499, "o", "        int tick = currentTick;\r\n\u001b[?2004l\r\u001b[?2004h"]
[438.632591, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[438.632964, "o", "        // 1. Spawn scheduled projectiles for this tick.\r\n\u001b[?2004l\r"]
[438.633041, "o", "\u001b[?2004h> "]
[438.633534, "o", "        List<int[]> spawns = spawnsByTick.getOrDefault(tick, Collections.emptyList());\r\n\u001b[?2004l\r"]
[438.633608, "o", "\u001b[?2004h> "]
[438.633813, "o", "        for (int[] s : spawns) {\r\n\u001b[?2004l\r"]
[438.633888, "o", "\u001b[?2004h> "]
[438.634128, "o", "            Projectile p = pool.obtain();\r\n\u001b[?2004l\r"]
[438.634201, "o", "\u001b[?2004h> "]
[438.63441, "o", "            p.id = spawnIdCounter++;\r\n\u001b[?2004l\r"]
[438.634482, "o", "\u001b[?2004h> "]
[438.634723, "o", "            p.position.set(s[0], s[1]);\r\n\u001b[?2004l\r"]
[438.634799, "o", "\u001b[?2004h> "]
[438.63504, "o", "            p.velocity.set(s[2], s[3]);\r\n\u001b[?2004l\r"]
[438.662149, "o", "\u001b[?2004h>             active.add(p);\r\n\u001b[?2004l\r\u001b[?2004h>         }\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[438.662523, "o", "        // Track peak as the max simultaneously active count (right after spawning).\r\n\u001b[?2004l\r"]
[438.662594, "o", "\u001b[?2004h"]
[438.662649, "o", "> "]
[438.662953, "o", "        if (active.size() > peakActive) {\r\n\u001b[?2004l\r"]
[438.663006, "o", "\u001b[?2004h"]
[438.663068, "o", "> "]
[438.663327, "o", "            peakActive = active.size();\r\n\u001b[?2004l\r"]
[438.663372, "o", "\u001b[?2004h"]
[438.663393, "o", "> "]
[438.663478, "o", "        }\r\n\u001b[?2004l\r"]
[438.663557, "o", "\u001b[?2004h"]
[438.66358, "o", "> \r\n\u001b[?2004l\r"]
[438.663601, "o", "\u001b[?2004h"]
[438.663675, "o", "> "]
[438.663988, "o", "        // 2. Integrate in spawn-id order.\r\n\u001b[?2004l\r"]
[438.664041, "o", "\u001b[?2004h"]
[438.664088, "o", "> "]
[438.664525, "o", "        List<Projectile> sorted = new ArrayList<>(active);\r\n\u001b[?2004l\r"]
[438.664576, "o", "\u001b[?2004h"]
[438.664627, "o", "> "]
[438.66509, "o", "        sorted.sort((a, b) -> Integer.compare(a.id, b.id));\r\n\u001b[?2004l\r"]
[438.665139, "o", "\u001b[?2004h"]
[438.66519, "o", "> "]
[438.665466, "o", "        for (Projectile p : sorted) {\r\n\u001b[?2004l\r"]
[438.66552, "o", "\u001b[?2004h"]
[438.665569, "o", "> "]
[438.665861, "o", "            p.velocity.x += gravityX;\r\n\u001b[?2004l\r"]
[438.665904, "o", "\u001b[?2004h"]
[438.66593, "o", "> "]
[438.666243, "o", "            p.velocity.y += gravityY;\r\n\u001b[?2004l\r"]
[438.666298, "o", "\u001b[?2004h> "]
[438.66638, "o", "        }\r\n\u001b[?2004l\r"]
[438.666424, "o", "\u001b[?2004h"]
[438.666472, "o", "> "]
[438.666765, "o", "        for (Projectile p : sorted) {\r\n\u001b[?2004l\r"]
[438.666808, "o", "\u001b[?2004h"]
[438.666858, "o", "> "]
[438.667164, "o", "            p.position.x += p.velocity.x;\r\n\u001b[?2004l\r"]
[438.667214, "o", "\u001b[?2004h"]
[438.667264, "o", "> "]
[438.667557, "o", "            p.position.y += p.velocity.y;\r\n\u001b[?2004l\r"]
[438.667601, "o", "\u001b[?2004h"]
[438.667653, "o", "> "]
[438.66772, "o", "        }\r\n\u001b[?2004l\r"]
[438.667764, "o", "\u001b[?2004h"]
[438.667815, "o", "> "]
[438.667848, "o", "\r\n\u001b[?2004l\r\u001b[?2004h"]
[438.667922, "o", "> "]
[438.668098, "o", "        // 3. Ground check.\r\n\u001b[?2004l\r"]
[438.668142, "o", "\u001b[?2004h"]
[438.66819, "o", "> "]
[438.668716, "o", "        List<int[]> groundedThisTick = new ArrayList<>(); // [id, ...]\r\n\u001b[?2004l\r"]
[438.668759, "o", "\u001b[?2004h"]
[438.668805, "o", "> "]
[438.669326, "o", "        List<Projectile> stillActive = new ArrayList<>(active.size());\r\n\u001b[?2004l\r"]
[438.669378, "o", "\u001b[?2004h"]
[438.669425, "o", "> "]
[438.669689, "o", "        for (Projectile p : active) {\r\n\u001b[?2004l\r"]
[438.669736, "o", "\u001b[?2004h"]
[438.669784, "o", "> "]
[438.670094, "o", "            if (p.position.y <= floorY) {\r\n\u001b[?2004l\r"]
[438.670138, "o", "\u001b[?2004h"]
[438.670187, "o", "> "]
[438.670588, "o", "                groundedThisTick.add(new int[]{p.id});\r\n\u001b[?2004l\r"]
[438.670646, "o", "\u001b[?2004h"]
[438.670703, "o", "> "]
[438.670898, "o", "                pool.free(p);\r\n\u001b[?2004l\r"]
[438.670941, "o", "\u001b[?2004h"]
[438.670989, "o", "> "]
[438.67122, "o", "                groundedCount++;\r\n\u001b[?2004l\r"]
[438.671264, "o", "\u001b[?2004h"]
[438.671312, "o", "> "]
[438.671466, "o", "            } else {\r\n\u001b[?2004l\r"]
[438.671516, "o", "\u001b[?2004h"]
[438.671565, "o", "> "]
[438.671844, "o", "                stillActive.add(p);\r\n\u001b[?2004l\r"]
[438.671897, "o", "\u001b[?2004h"]
[438.671943, "o", "> "]
[438.672032, "o", "            }\r\n\u001b[?2004l\r"]
[438.672076, "o", "\u001b[?2004h"]
[438.672126, "o", "> "]
[438.672194, "o", "        }\r\n\u001b[?2004l\r"]
[438.672255, "o", "\u001b[?2004h"]
[438.67231, "o", "> "]
[438.672915, "o", "        Collections.sort(groundedThisTick, (a, b) -> Integer.compare(a[0], b[0]));\r\n\u001b[?2004l\r"]
[438.672958, "o", "\u001b[?2004h"]
[438.673007, "o", "> "]
[438.673476, "o", "        stillActive.sort((a, b) -> Integer.compare(a.id, b.id));\r\n\u001b[?2004l\r"]
[438.67352, "o", "\u001b[?2004h"]
[438.673567, "o", "> \r\n\u001b[?2004l\r"]
[438.673621, "o", "\u001b[?2004h"]
[438.673665, "o", "> "]
[438.673868, "o", "        // Emit tick summary.\r\n\u001b[?2004l\r"]
[438.673911, "o", "\u001b[?2004h"]
[438.673959, "o", "> "]
[438.674458, "o", "        writeLine(\"TICK \" + tick + \" ACTIVE \" + stillActive.size());\r\n\u001b[?2004l\r"]
[438.674503, "o", "\u001b[?2004h"]
[438.67455, "o", "> "]
[438.674882, "o", "        for (Projectile p : stillActive) {\r\n\u001b[?2004l\r"]
[438.674933, "o", "\u001b[?2004h"]
[438.674986, "o", "> "]
[438.675433, "o", "            writeLine(\"P\" + p.id + \" x=\" + (int) p.position.x\r\n\u001b[?2004l\r"]
[438.675486, "o", "\u001b[?2004h"]
[438.67553, "o", "> "]
[438.675901, "o", "                    + \" y=\" + (int) p.position.y\r\n\u001b[?2004l\r"]
[438.675955, "o", "\u001b[?2004h"]
[438.675998, "o", "> "]
[438.676352, "o", "                    + \" vx=\" + (int) p.velocity.x\r\n\u001b[?2004l\r"]
[438.676398, "o", "\u001b[?2004h"]
[438.67644, "o", "> "]
[438.676823, "o", "                    + \" vy=\" + (int) p.velocity.y);\r\n\u001b[?2004l\r"]
[438.676868, "o", "\u001b[?2004h"]
[438.676916, "o", "> "]
[438.676985, "o", "        }\r\n\u001b[?2004l\r"]
[438.677027, "o", "\u001b[?2004h"]
[438.677075, "o", "> "]
[438.677446, "o", "        for (int[] idHolder : groundedThisTick) {\r\n\u001b[?2004l\r"]
[438.677493, "o", "\u001b[?2004h"]
[438.677545, "o", "> "]
[438.678059, "o", "            writeLine(\"GROUNDED P\" + idHolder[0] + \" tick=\" + tick);\r\n\u001b[?2004l\r"]
[438.678109, "o", "\u001b[?2004h"]
[438.678159, "o", "> "]
[438.678211, "o", "        }\r\n\u001b[?2004l\r"]
[438.678254, "o", "\u001b[?2004h"]
[438.678283, "o", "> \r\n"]
[438.678328, "o", "\u001b[?2004l\r"]
[438.678375, "o", "\u001b[?2004h> "]
[438.678549, "o", "        active.clear();\r\n\u001b[?2004l\r"]
[438.678603, "o", "\u001b[?2004h"]
[438.678648, "o", "> "]
[438.678929, "o", "        active.addAll(stillActive);\r\n\u001b[?2004l\r"]
[438.678977, "o", "\u001b[?2004h"]
[438.679031, "o", "> \r\n\u001b[?2004l\r"]
[438.679081, "o", "\u001b[?2004h"]
[438.67913, "o", "> "]
[438.679257, "o", "        currentTick++;\r\n\u001b[?2004l\r"]
[438.67931, "o", "\u001b[?2004h"]
[438.679351, "o", "> \r\n\u001b[?2004l\r"]
[438.679406, "o", "\u001b[?2004h> "]
[438.679728, "o", "        if (currentTick >= totalTicks) {\r\n\u001b[?2004l\r"]
