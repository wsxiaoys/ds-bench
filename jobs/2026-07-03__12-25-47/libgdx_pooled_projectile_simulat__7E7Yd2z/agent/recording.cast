[90.51297, "o", "\u001b[?2004h> "]
[90.513054, "o", "                case \"SPAWN\": {\r\n\u001b[?2004l\r\u001b[?2004h"]
[90.51312, "o", "> "]
[90.513259, "o", "                    int tick = Integer.parseInt(parts[1]);\r\n\u001b[?2004l\r\u001b[?2004h"]
[90.513322, "o", "> "]
[90.513455, "o", "                    int x = Integer.parseInt(parts[2]);\r\n\u001b[?2004l\r\u001b[?2004h"]
[90.513517, "o", "> "]
[90.513657, "o", "                    int y = Integer.parseInt(parts[3]);\r\n\u001b[?2004l\r\u001b[?2004h"]
[90.513728, "o", "> "]
[90.513857, "o", "                    int vx = Integer.parseInt(parts[4]);\r\n\u001b[?2004l\r\u001b[?2004h"]
[90.513913, "o", "> "]
[90.514057, "o", "                    int vy = Integer.parseInt(parts[5]);\r\n\u001b[?2004l\r\u001b[?2004h"]
[90.514112, "o", "> "]
[90.514408, "o", "                    spawnsByTick.computeIfAbsent(tick, k -> new ArrayList<>()).add(new int[]{x, y, vx, vy});\r\n\u001b[?2004l\r\u001b[?2004h"]
[90.514472, "o", "> "]
[90.514545, "o", "                    totalSpawns++;\r\n\u001b[?2004l\r\u001b[?2004h"]
[90.514601, "o", "> "]
[90.514656, "o", "                    break;\r\n\u001b[?2004l\r\u001b[?2004h"]
[90.514723, "o", "> "]
[90.514785, "o", "                }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[90.514853, "o", "                default:\r\n\u001b[?2004l\r\u001b[?2004h"]
[90.514908, "o", "> "]
[90.515134, "o", "                    throw new IllegalArgumentException(\"Unknown directive: \" + head);\r\n\u001b[?2004l\r\u001b[?2004h"]
[90.515195, "o", ">             }\r\n\u001b[?2004l\r"]
[90.515257, "o", "\u001b[?2004h>         }\r\n\u001b[?2004l\r"]
[90.515321, "o", "\u001b[?2004h>     }\r\n\u001b[?2004l\r"]
[90.515387, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[90.515442, "o", "    @Override\r\n\u001b[?2004l\r\u001b[?2004h> "]
[90.515534, "o", "    public void render() {\r\n\u001b[?2004l\r\u001b[?2004h"]
[90.515588, "o", "> "]
[90.51569, "o", "        if (currentTick >= totalTicks) {\r\n\u001b[?2004l\r\u001b[?2004h"]
[90.51575, "o", "> "]
[90.515816, "o", "            Gdx.app.exit();\r\n\u001b[?2004l\r\u001b[?2004h"]
[90.515869, "o", "> "]
[90.51592, "o", "            return;\r\n\u001b[?2004l\r\u001b[?2004h> "]
[90.515987, "o", "        }\r\n\u001b[?2004l\r\u001b[?2004h"]
[90.516044, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[90.516127, "o", "        int tick = currentTick;\r\n\u001b[?2004l\r\u001b[?2004h"]
[90.516183, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[90.516457, "o", "        // 1. Spawn scheduled projectiles for this tick (ids assigned in spawn-line order).\r\n\u001b[?2004l\r\u001b[?2004h"]
[90.51651, "o", "> "]
[90.516754, "o", "        List<int[]> spawns = spawnsByTick.getOrDefault(tick, Collections.emptyList());\r\n\u001b[?2004l\r\u001b[?2004h"]
[90.516807, "o", "> "]
[90.516881, "o", "        for (int[] s : spawns) {\r\n\u001b[?2004l\r\u001b[?2004h"]
[90.516932, "o", "> "]
[90.517035, "o", "            Projectile p = pool.obtain();\r\n\u001b[?2004l\r\u001b[?2004h"]
[90.517086, "o", "> "]
[90.517175, "o", "            p.id = spawnIdCounter++;\r\n\u001b[?2004l\r\u001b[?2004h"]
[90.517226, "o", "> "]
[90.517322, "o", "            p.position.set(s[0], s[1]);\r\n\u001b[?2004l\r\u001b[?2004h"]
[90.517373, "o", "> "]
[90.517471, "o", "            p.velocity.set(s[2], s[3]);\r\n\u001b[?2004l\r\u001b[?2004h"]
[90.517522, "o", "> "]
[90.517582, "o", "            active.add(p);\r\n\u001b[?2004l\r\u001b[?2004h"]
[90.517635, "o", ">         }\r\n\u001b[?2004l\r"]
[90.517696, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[90.517962, "o", "        // Track peak as the max simultaneously active count (right after spawning).\r\n\u001b[?2004l\r\u001b[?2004h"]
[90.518015, "o", "> "]
[90.518115, "o", "        if (active.size() > peakActive) {\r\n\u001b[?2004l\r\u001b[?2004h"]
[90.518168, "o", "> "]
[90.518264, "o", "            peakActive = active.size();\r\n\u001b[?2004l\r\u001b[?2004h"]
[90.518317, "o", ">         }\r\n\u001b[?2004l\r"]
[90.518381, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[90.518666, "o", "        // 2. Integrate in spawn-id order: gravity to velocity, then velocity to position.\r\n\u001b[?2004l\r\u001b[?2004h"]
[90.518732, "o", "> "]
[90.518879, "o", "        List<Projectile> sorted = new ArrayList<>(active);\r\n\u001b[?2004l\r\u001b[?2004h"]
[90.518934, "o", "> "]
[90.519086, "o", "        sorted.sort((a, b) -> Integer.compare(a.id, b.id));\r\n\u001b[?2004l\r\u001b[?2004h"]
[90.51914, "o", "> "]
[90.519229, "o", "        for (Projectile p : sorted) {\r\n\u001b[?2004l\r\u001b[?2004h"]
[90.519285, "o", "> "]
[90.519372, "o", "            p.velocity.x += gravityX;\r\n\u001b[?2004l\r\u001b[?2004h"]
[90.519426, "o", "> "]
[90.519514, "o", "            p.velocity.y += gravityY;\r\n\u001b[?2004l\r\u001b[?2004h"]
[90.519574, "o", ">         }\r\n\u001b[?2004l\r"]
[90.51963, "o", "\u001b[?2004h> "]
[90.519736, "o", "        for (Projectile p : sorted) {\r\n\u001b[?2004l\r\u001b[?2004h"]
[90.519793, "o", "> "]
[90.519887, "o", "            p.position.x += p.velocity.x;\r\n\u001b[?2004l\r\u001b[?2004h"]
[90.519944, "o", "> "]
[90.520041, "o", "            p.position.y += p.velocity.y;\r\n\u001b[?2004l\r\u001b[?2004h"]
[90.520112, "o", ">         }\r\n\u001b[?2004l\r\u001b[?2004h"]
[90.520165, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[90.520243, "o", "        // 3. Ground check.\r\n\u001b[?2004l\r\u001b[?2004h"]
[90.520294, "o", "> "]
[90.520467, "o", "        List<Projectile> groundedThisTick = new ArrayList<>();\r\n\u001b[?2004l\r\u001b[?2004h"]
[90.520519, "o", "> "]
[90.520791, "o", "        List<Projectile> stillActive = new ArrayList<>(active.size());\r\n\u001b[?2004l\r\u001b[?2004h> "]
[90.520859, "o", "        for (Projectile p : active) {\r\n\u001b[?2004l\r\u001b[?2004h"]
[90.520913, "o", "> "]
[90.521014, "o", "            if (p.position.y <= floorY) {\r\n\u001b[?2004l\r\u001b[?2004h"]
[90.521065, "o", "> "]
[90.521166, "o", "                groundedThisTick.add(p);\r\n\u001b[?2004l\r\u001b[?2004h"]
[90.521217, "o", "> "]
[90.521279, "o", "            } else {\r\n\u001b[?2004l\r\u001b[?2004h"]
[90.521333, "o", "> "]
[90.5214, "o", "                stillActive.add(p);\r\n\u001b[?2004l\r\u001b[?2004h"]
[90.521466, "o", ">             }\r\n\u001b[?2004l\r"]
[90.521528, "o", "\u001b[?2004h>         }\r\n\u001b[?2004l\r"]
[90.521582, "o", "\u001b[?2004h> "]
[90.521779, "o", "        groundedThisTick.sort((a, b) -> Integer.compare(a.id, b.id));\r\n\u001b[?2004l\r\u001b[?2004h"]
[90.521836, "o", "> "]
[90.522, "o", "        stillActive.sort((a, b) -> Integer.compare(a.id, b.id));\r\n\u001b[?2004l\r\u001b[?2004h"]
[90.522054, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[90.522198, "o", "        for (Projectile p : groundedThisTick) {\r\n\u001b[?2004l\r\u001b[?2004h"]
[90.522258, "o", "> "]
[90.522333, "o", "            pool.free(p);\r\n\u001b[?2004l\r\u001b[?2004h> "]
[90.522435, "o", "            groundedCount++;\r\n\u001b[?2004l\r\u001b[?2004h> "]
[90.522505, "o", "        }\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[90.522575, "o", "\u001b[?2004h> "]
[90.522718, "o", "        // Emit tick summary lines in required order:\r\n\u001b[?2004l\r\u001b[?2004h"]
[90.522777, "o", "> "]
[90.522849, "o", "        //   TICK <t> ACTIVE <count>\r\n\u001b[?2004l\r\u001b[?2004h"]
[90.522904, "o", "> "]
[90.523105, "o", "        //   P<id> x=... y=... vx=... vy=... for each active at END of tick\r\n\u001b[?2004l\r\u001b[?2004h"]
[90.523171, "o", "> "]
[90.523328, "o", "        //   GROUNDED P<id> tick=<t> for each grounded this tick\r\n\u001b[?2004l\r\u001b[?2004h"]
[90.523384, "o", "> "]
[90.523563, "o", "        writeLine(\"TICK \" + tick + \" ACTIVE \" + stillActive.size());\r\n\u001b[?2004l\r\u001b[?2004h"]
[90.523618, "o", "> "]
[90.523732, "o", "        for (Projectile p : stillActive) {\r\n\u001b[?2004l\r\u001b[?2004h"]
[90.523788, "o", "> "]
[90.523941, "o", "            writeLine(\"P\" + p.id + \" x=\" + (int) p.position.x\r\n\u001b[?2004l\r\u001b[?2004h"]
[90.523997, "o", "> "]
[90.524115, "o", "                    + \" y=\" + (int) p.position.y\r\n\u001b[?2004l\r\u001b[?2004h"]
[90.524171, "o", "> "]
[90.524299, "o", "                    + \" vx=\" + (int) p.velocity.x\r\n\u001b[?2004l\r\u001b[?2004h"]
[90.524354, "o", "> "]
[90.524491, "o", "                    + \" vy=\" + (int) p.velocity.y);\r\n\u001b[?2004l\r\u001b[?2004h"]
[90.524545, "o", ">         }\r\n\u001b[?2004l\r"]
[90.524598, "o", "\u001b[?2004h> "]
[90.524731, "o", "        for (Projectile p : groundedThisTick) {\r\n\u001b[?2004l\r\u001b[?2004h"]
[90.524789, "o", "> "]
[90.524947, "o", "            writeLine(\"GROUNDED P\" + p.id + \" tick=\" + tick);\r\n\u001b[?2004l\r\u001b[?2004h"]
[90.525066, "o", ">         }\r\n\u001b[?2004l\r"]
[90.525118, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[90.52525, "o", "        active.clear();\r\n\u001b[?2004l\r\u001b[?2004h> "]
[90.525305, "o", "        active.addAll(stillActive);\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[90.52543, "o", "\u001b[?2004h>         currentTick++;\r\n\u001b[?2004l\r\u001b[?2004h"]
[90.52553, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[90.525614, "o", "        if (currentTick >= totalTicks) {\r\n\u001b[?2004l\r\u001b[?2004h"]
[90.525724, "o", "> "]
[90.525815, "o", "            writeLine(\"SUMMARY spawned=\" + totalSpawns\r\n\u001b[?2004l\r\u001b[?2004h"]
[90.525864, "o", "> "]
[90.525996, "o", "                    + \" grounded=\" + groundedCount\r\n\u001b[?2004l\r\u001b[?2004h"]
[90.526046, "o", "> "]
[90.526184, "o", "                    + \" pool_free=\" + pool.getFree()\r\n\u001b[?2004l\r\u001b[?2004h"]
[90.526284, "o", "> "]
[90.52637, "o", "                    + \" peak_active=\" + peakActive);\r\n\u001b[?2004l\r\u001b[?2004h"]
[90.526465, "o", "> "]
[90.526516, "o", "            Gdx.app.exit();\r\n\u001b[?2004l\r\u001b[?2004h> "]
[90.526631, "o", "        }\r\n\u001b[?2004l\r\u001b[?2004h>     }\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[90.526681, "o", "> "]
[90.526809, "o", "    private void writeLine(String s) {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[90.526852, "o", "        try {\r\n\u001b[?2004l\r\u001b[?2004h"]
[90.526891, "o", "> "]
[90.527029, "o", "            writer.write(s);\r\n\u001b[?2004l\r\u001b[?2004h> "]
[90.527115, "o", "            writer.write(\"\\n\");\r\n\u001b[?2004l\r\u001b[?2004h"]
[90.527196, "o", "> "]
[90.527244, "o", "        } catch (IOException e) {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[90.52748, "o", "            throw new RuntimeException(\"Failed to write log line\", e);\r\n\u001b[?2004l\r\u001b[?2004h"]
[90.527532, "o", ">         }\r\n\u001b[?2004l\r"]
[90.527654, "o", "\u001b[?2004h>     }\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[90.527748, "o", "    @Override\r\n\u001b[?2004l\r\u001b[?2004h"]
[90.562203, "o", "> "]
[90.562358, "o", "    public void dispose() {\r\n\u001b[?2004l\r"]
[90.562437, "o", "\u001b[?2004h> "]
[90.562613, "o", "        if (writer != null) {\r\n\u001b[?2004l\r"]
[90.5627, "o", "\u001b[?2004h> "]
[90.562809, "o", "            try {\r\n\u001b[?2004l\r"]
[90.562883, "o", "\u001b[?2004h> "]
[90.563094, "o", "                writer.flush();\r\n\u001b[?2004l\r"]
[90.563156, "o", "\u001b[?2004h"]
[90.563204, "o", "> "]
[90.563351, "o", "                writer.close();\r\n\u001b[?2004l\r"]
[90.563425, "o", "\u001b[?2004h> "]
[90.563702, "o", "            } catch (IOException ignored) {\r\n\u001b[?2004l\r"]
[90.563802, "o", "\u001b[?2004h> "]
[90.563862, "o", "            }\r\n\u001b[?2004l\r"]
[90.563933, "o", "\u001b[?2004h> "]
[90.564093, "o", "            writer = null;\r\n\u001b[?2004l\r"]
[90.56417, "o", "\u001b[?2004h> "]
[90.564225, "o", "        }\r\n\u001b[?2004l\r"]
[90.564297, "o", "\u001b[?2004h> "]
[90.564358, "o", "    }\r\n\u001b[?2004l\r"]
[90.564406, "o", "\u001b[?2004h> "]
[90.56443, "o", "}\r\n\u001b[?2004l\r"]
[90.564455, "o", "\u001b[?2004h"]
[90.564481, "o", "> "]
[90.564563, "o", "EOF\r\n\u001b[?2004l\r"]
[90.566076, "o", "\u001b[?2004h"]
[90.566176, "o", "root@f969055e-d19d-4744-b708-55ec51f6885f:/home/user/projectile_sim# "]
[91.166072, "i", "wc -l /home/user/projectile_sim/headless/src/main/java/com/example/sim/SimulationListener.java\n"]
[91.166974, "o", "wc -l /home/user/projectile_sim/headless/src/main/java/com/example/sim/SimulationListener.java\r\n\u001b[?2004l\r"]
[91.168442, "o", "217 /home/user/projectile_sim/headless/src/main/java/com/example/sim/SimulationListener.java\r\n"]
[91.168724, "o", "\u001b[?2004h"]
[91.16878, "o", "root@f969055e-d19d-4744-b708-55ec51f6885f:/home/user/projectile_sim# "]
[103.901787, "i", "cat > /home/user/projectile_sim/headless/src/main/java/com/example/sim/Main.java << 'EOF'\npackage com.example.sim;\n\nimport com.badlogic.gdx.backends.headless.HeadlessApplication;\nimport com.badlogic.gdx.backends.headless.HeadlessApplicationConfiguration;\n\npublic class Main {\n    public static void main(String[] args) throws Exception {\n        String scenario = null;\n        String output = null;\n\n        // Accept --scenario <path> --output <path> in any order, also accept -s/-o.\n        for (int i = 0; i < args.length; i++) {\n            String a = args[i];\n            if (a.equals(\"--scenario\") || a.equals(\"-s\")) {\n                scenario = args[++i];\n            } else if (a.equals(\"--output\") || a.equals(\"-o\")) {\n                output = args[++i];\n            }\n        }\n        if (scenario == null || output == null) {\n            System.err.println(\"Usage: --scenario <scenario_path> --output <output_path>\");\n            System.exit(1);\n        }\n\n        HeadlessApplicationConfiguration cfg = new HeadlessApplicationConfiguration();\n        cfg.updatesPerSecond = 0; // run as fast as possible\n        cfg.idlePriority = Thread.MIN_PRIORITY;\n\n        SimulationListener listener = new SimulationListener(scenario, output);\n        HeadlessApplication app = new HeadlessApplication(listener, cfg);\n\n        // Wait for the application thread to finish. The listener calls\n        // Gdx.app.exit() once all ticks are processed; the application\n        // thread then terminates, releasing this join.\n        try {\n            // The internal thread that runs create()/render()/dispose()\n            // is not exposed, so we poll until Gdx.app no longer exists\n            // (after exit it is set to null) and the application thread\n            // is no longer alive.\n            Thread renderThread = getRenderThread(app);\n            if (renderThread != null) {\n                renderThread.join();\n            }\n        } catch (InterruptedException ie) {\n            Thread.currentThread().interrupt();\n            System.exit(2);\n        }\n        // Give the listener a moment to flush+close.\n        Thread.sleep(50);\n    }\n\n    private static Thread getRenderThread(HeadlessApplication app) {\n        // HeadlessApplication exposes the thread via reflection. The\n        // field name \"runnables\" is private; instead we rely on the\n        // fact that ApplicationListener.create has already been called\n        // before main returns from constructing the application, and\n        // that the rendering loop terminates when Gdx.app.exit() is\n        // invoked. We find the running thread by name pattern.\n        Thread[] threads = new Thread[Thread.activeCount() * 2];\n        int n = Thread.enumerate(threads);\n        for (int i = 0; i < n; i++) {\n            Thread t = threads[i];\n            if (t != null && t.getName() != null\n                    && (t.getName().contains(\"HeadlessApplication\")\n                        || t.getName().contains(\"GDX\")\n                        || t.getName().contains(\"Application\"))) {\n                return t;\n            }\n        }\n        return null;\n    }\n}\nEOF\n"]
[103.902354, "o", "cat > /home/user/projectile_sim/headless/src/main/java/com/example/sim/Main.java << 'EOF'\r\n\u001b[?2004l\r"]
[103.90241, "o", "\u001b[?2004h> "]
