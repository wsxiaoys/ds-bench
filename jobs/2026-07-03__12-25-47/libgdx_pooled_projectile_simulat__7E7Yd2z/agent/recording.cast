[68.152702, "o", "            switch (head) {\r\n\u001b[?2004l\r"]
[68.152724, "o", "\u001b[?2004h> "]
[68.152858, "o", "                case \"TICKS\": {\r\n\u001b[?2004l\r"]
[68.152894, "o", "\u001b[?2004h> "]
[68.15312, "o", "                    totalTicks = Integer.parseInt(parts[1]);\r\n\u001b[?2004l\r"]
[68.153156, "o", "\u001b[?2004h> "]
[68.153268, "o", "                    break;\r\n\u001b[?2004l\r"]
[68.153299, "o", "\u001b[?2004h> "]
[68.153378, "o", "                }\r\n\u001b[?2004l\r"]
[68.153399, "o", "\u001b[?2004h> "]
[68.15355, "o", "                case \"GRAVITY\": {\r\n\u001b[?2004l\r"]
[68.153572, "o", "\u001b[?2004h> "]
[68.153826, "o", "                    gravityX = Integer.parseInt(parts[1]);\r\n\u001b[?2004l\r\u001b[?2004h"]
[68.153849, "o", "> "]
[68.154076, "o", "                    gravityY = Integer.parseInt(parts[2]);\r\n\u001b[?2004l\r"]
[68.154098, "o", "\u001b[?2004h> "]
[68.154211, "o", "                    break;\r\n\u001b[?2004l\r"]
[68.154233, "o", "\u001b[?2004h> "]
[68.154312, "o", "                }\r\n\u001b[?2004l\r"]
[68.154334, "o", "\u001b[?2004h> "]
[68.154468, "o", "                case \"FLOOR\": {\r\n\u001b[?2004l\r"]
[68.15449, "o", "\u001b[?2004h> "]
[68.154721, "o", "                    floorY = Integer.parseInt(parts[1]);\r\n\u001b[?2004l\r"]
[68.154758, "o", "\u001b[?2004h> "]
[68.15486, "o", "                    break;\r\n\u001b[?2004l\r"]
[68.154883, "o", "\u001b[?2004h> "]
[68.154966, "o", "                }\r\n\u001b[?2004l\r"]
[68.154986, "o", "\u001b[?2004h> "]
[68.155119, "o", "                case \"SPAWN\": {\r\n\u001b[?2004l\r"]
[68.155141, "o", "\u001b[?2004h> "]
[68.155371, "o", "                    int tick = Integer.parseInt(parts[1]);\r\n\u001b[?2004l\r"]
[68.155391, "o", "\u001b[?2004h> "]
[68.155605, "o", "                    int x = Integer.parseInt(parts[2]);\r\n\u001b[?2004l\r"]
[68.155627, "o", "\u001b[?2004h> "]
[68.155848, "o", "                    int y = Integer.parseInt(parts[3]);\r\n\u001b[?2004l\r"]
[68.155869, "o", "\u001b[?2004h"]
[68.155916, "o", "> "]
[68.156093, "o", "                    int vx = Integer.parseInt(parts[4]);\r\n\u001b[?2004l\r"]
[68.156114, "o", "\u001b[?2004h> "]
[68.156306, "o", "                    int vy = Integer.parseInt(parts[5]);\r\n\u001b[?2004l\r"]
[68.156326, "o", "\u001b[?2004h> "]
[68.156675, "o", "                    spawnsByTick.computeIfAbsent(tick, k -> new ArrayList<>()).add(new int[]{x, y, vx, vy});\r\n\u001b[?2004l\r"]
[68.156696, "o", "\u001b[?2004h> "]
[68.156824, "o", "                    totalSpawns++;\r\n\u001b[?2004l\r"]
[68.156844, "o", "\u001b[?2004h> "]
[68.156946, "o", "                    break;\r\n\u001b[?2004l\r"]
[68.156967, "o", "\u001b[?2004h> "]
[68.15704, "o", "                }\r\n\u001b[?2004l\r"]
[68.15706, "o", "\u001b[?2004h> "]
[68.157156, "o", "                default:\r\n\u001b[?2004l\r"]
[68.157176, "o", "\u001b[?2004h> "]
[68.157456, "o", "                    throw new IllegalArgumentException(\"Unknown directive: \" + head);\r\n\u001b[?2004l\r"]
[68.157476, "o", "\u001b[?2004h> "]
[68.157537, "o", "            }\r\n\u001b[?2004l\r"]
[68.157557, "o", "\u001b[?2004h"]
[68.157595, "o", "> "]
[68.157623, "o", "        }\r\n\u001b[?2004l\r\u001b[?2004h"]
[68.157645, "o", "> "]
[68.157692, "o", "    }\r\n\u001b[?2004l\r\u001b[?2004h"]
[68.157714, "o", "> \r\n\u001b[?2004l\r"]
[68.157736, "o", "\u001b[?2004h> "]
[68.157796, "o", "    @Override\r\n\u001b[?2004l\r"]
[68.157816, "o", "\u001b[?2004h> "]
[68.157918, "o", "    public void render() {\r\n\u001b[?2004l\r"]
[68.157939, "o", "\u001b[?2004h> "]
[68.158082, "o", "        if (currentTick >= totalTicks) {\r\n\u001b[?2004l\r"]
[68.158103, "o", "\u001b[?2004h> "]
[68.158257, "o", "            // Already done; ensure we exit.\r\n\u001b[?2004l\r"]
[68.158278, "o", "\u001b[?2004h> "]
[68.158381, "o", "            Gdx.app.exit();\r\n\u001b[?2004l\r"]
[68.158402, "o", "\u001b[?2004h> "]
[68.158481, "o", "            return;\r\n\u001b[?2004l\r"]
[68.158501, "o", "\u001b[?2004h> "]
[68.158552, "o", "        }\r\n\u001b[?2004l\r"]
[68.158573, "o", "\u001b[?2004h> "]
[68.158622, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[68.15874, "o", "        int tick = currentTick;\r\n\u001b[?2004l\r\u001b[?2004h"]
[68.158761, "o", "> \r\n\u001b[?2004l\r"]
[68.158809, "o", "\u001b[?2004h> "]
[68.158939, "o", "        // 1. Spawn scheduled projectiles.\r\n\u001b[?2004l\r"]
[68.15896, "o", "\u001b[?2004h> "]
[68.15924, "o", "        List<int[]> spawns = spawnsByTick.getOrDefault(tick, Collections.emptyList());\r\n\u001b[?2004l\r"]
[68.159262, "o", "\u001b[?2004h> "]
[68.15938, "o", "        for (int[] s : spawns) {\r\n\u001b[?2004l\r"]
[68.159402, "o", "\u001b[?2004h> "]
[68.159544, "o", "            Projectile p = pool.obtain();\r\n\u001b[?2004l\r"]
[68.159564, "o", "\u001b[?2004h> "]
[68.159832, "o", "            // Assign id based on total spawn order. The id counter increments\r\n\u001b[?2004l\r"]
[68.159852, "o", "\u001b[?2004h> "]
[68.160059, "o", "            // each time we issue a spawn, regardless of tick.\r\n\u001b[?2004l\r"]
[68.16008, "o", "\u001b[?2004h> "]
[68.160201, "o", "            p.id = nextSpawnId();\r\n\u001b[?2004l\r"]
[68.160221, "o", "\u001b[?2004h> "]
[68.160361, "o", "            p.position.set(s[0], s[1]);\r\n\u001b[?2004l\r"]
[68.160382, "o", "\u001b[?2004h> "]
[68.160521, "o", "            p.velocity.set(s[2], s[3]);\r\n\u001b[?2004l\r"]
[68.160542, "o", "\u001b[?2004h"]
[68.16058, "o", "> "]
[68.16065, "o", "            active.add(p);\r\n\u001b[?2004l\r"]
[68.160675, "o", "\u001b[?2004h> "]
[68.160726, "o", "        }\r\n\u001b[?2004l\r"]
[68.160747, "o", "\u001b[?2004h> "]
[68.160791, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[68.161018, "o", "        // 2. Integrate: gravity -> position update, in spawn-id order.\r\n\u001b[?2004l\r"]
[68.161039, "o", "\u001b[?2004h> "]
[68.161282, "o", "        // Sort active by id to guarantee deterministic order (already in\r\n\u001b[?2004l\r"]
[68.161302, "o", "\u001b[?2004h> "]
[68.161463, "o", "        // insertion order, but be defensive).\r\n\u001b[?2004l\r"]
[68.161483, "o", "\u001b[?2004h> "]
[68.161688, "o", "        active.sort((a, b) -> Integer.compare(a.id, b.id));\r\n\u001b[?2004l\r"]
[68.161708, "o", "\u001b[?2004h> "]
[68.161746, "o", "\r\n\u001b[?2004l\r\u001b[?2004h"]
[68.161767, "o", "> "]
[68.161888, "o", "        // Apply gravity to velocity.\r\n\u001b[?2004l\r"]
[68.161908, "o", "\u001b[?2004h> "]
[68.162042, "o", "        for (Projectile p : active) {\r\n\u001b[?2004l\r"]
[68.162062, "o", "\u001b[?2004h> "]
[68.162195, "o", "            p.velocity.x += gravityX;\r\n\u001b[?2004l\r"]
[68.162216, "o", "\u001b[?2004h> "]
[68.162347, "o", "            p.velocity.y += gravityY;\r\n\u001b[?2004l\r"]
[68.162368, "o", "\u001b[?2004h> "]
[68.162417, "o", "        }\r\n\u001b[?2004l\r"]
[68.162438, "o", "\u001b[?2004h> "]
[68.162568, "o", "        // Add velocity to position.\r\n\u001b[?2004l\r"]
[68.162588, "o", "\u001b[?2004h> "]
[68.162729, "o", "        for (Projectile p : active) {\r\n\u001b[?2004l\r"]
[68.16275, "o", "\u001b[?2004h> "]
[68.162896, "o", "            p.position.x += p.velocity.x;\r\n\u001b[?2004l\r"]
[68.162918, "o", "\u001b[?2004h> "]
[68.163065, "o", "            p.position.y += p.velocity.y;\r\n\u001b[?2004l\r"]
[68.163086, "o", "\u001b[?2004h> "]
[68.163134, "o", "        }\r\n\u001b[?2004l\r"]
[68.163154, "o", "\u001b[?2004h> \r\n"]
[68.163193, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[68.163292, "o", "        // 3. Ground check.\r\n\u001b[?2004l\r"]
[68.163314, "o", "\u001b[?2004h> "]
[68.163545, "o", "        List<Projectile> stillActive = new ArrayList<>(active.size());\r\n\u001b[?2004l\r"]
[68.163566, "o", "\u001b[?2004h> "]
[68.16378, "o", "        List<Projectile> groundedThisTick = new ArrayList<>();\r\n\u001b[?2004l\r"]
[68.163802, "o", "\u001b[?2004h> "]
[68.163934, "o", "        for (Projectile p : active) {\r\n\u001b[?2004l\r"]
[68.163957, "o", "\u001b[?2004h> "]
[68.164102, "o", "            if (p.position.y <= floorY) {\r\n\u001b[?2004l\r"]
[68.164123, "o", "\u001b[?2004h> "]
[68.164274, "o", "                groundedThisTick.add(p);\r\n\u001b[?2004l\r\u001b[?2004h"]
[68.164296, "o", "> "]
[68.16437, "o", "            } else {\r\n\u001b[?2004l\r"]
[68.164392, "o", "\u001b[?2004h> "]
[68.164519, "o", "                stillActive.add(p);\r\n\u001b[?2004l\r"]
[68.16454, "o", "\u001b[?2004h> "]
[68.164602, "o", "            }\r\n\u001b[?2004l\r"]
[68.164623, "o", "\u001b[?2004h> "]
[68.164675, "o", "        }\r\n\u001b[?2004l\r"]
[68.164694, "o", "\u001b[?2004h"]
[68.164731, "o", "> "]
[68.164853, "o", "        // Sort grounded by id for output.\r\n\u001b[?2004l\r"]
[68.164874, "o", "\u001b[?2004h"]
[68.164895, "o", "> "]
[68.165117, "o", "        groundedThisTick.sort((a, b) -> Integer.compare(a.id, b.id));\r\n\u001b[?2004l\r"]
[68.165137, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[68.165172, "o", "\u001b[?2004h> "]
[68.165333, "o", "        for (Projectile p : groundedThisTick) {\r\n\u001b[?2004l\r"]
[68.165355, "o", "\u001b[?2004h> "]
[68.165452, "o", "            pool.free(p);\r\n\u001b[?2004l\r"]
[68.165473, "o", "\u001b[?2004h> "]
[68.165579, "o", "            groundedCount++;\r\n\u001b[?2004l\r"]
[68.1656, "o", "\u001b[?2004h> "]
[68.16565, "o", "        }\r\n\u001b[?2004l\r"]
[68.165757, "o", "\u001b[?2004h> "]
[68.165781, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[68.16598, "o", "        // Write grounded lines BEFORE tick summary so output order matches spec.\r\n\u001b[?2004l\r"]
[68.166001, "o", "\u001b[?2004h> "]
[68.166166, "o", "        for (Projectile p : groundedThisTick) {\r\n\u001b[?2004l\r"]
[68.166187, "o", "\u001b[?2004h> "]
[68.166389, "o", "            writeLine(\"GROUNDED P\" + p.id + \" tick=\" + tick);\r\n\u001b[?2004l\r"]
[68.166409, "o", "\u001b[?2004h> "]
[68.166456, "o", "        }\r\n\u001b[?2004l\r"]
[68.166477, "o", "\u001b[?2004h"]
[68.166498, "o", "> \r\n\u001b[?2004l\r"]
[68.166521, "o", "\u001b[?2004h> "]
[68.166634, "o", "        // Update active list.\r\n\u001b[?2004l\r"]
[68.166655, "o", "\u001b[?2004h> "]
[68.166753, "o", "        active.clear();\r\n\u001b[?2004l\r"]
[68.166773, "o", "\u001b[?2004h> "]
[68.1669, "o", "        active.addAll(stillActive);\r\n\u001b[?2004l\r"]
[68.16692, "o", "\u001b[?2004h> \r\n"]
[68.166958, "o", "\u001b[?2004l\r\u001b[?2004h"]
[68.166987, "o", "> "]
[68.167049, "o", "        // Track peak.\r\n\u001b[?2004l\r"]
[68.16707, "o", "\u001b[?2004h> "]
[68.167216, "o", "        if (active.size() > peakActive) {\r\n\u001b[?2004l\r"]
[68.167236, "o", "\u001b[?2004h> "]
[68.167377, "o", "            peakActive = active.size();\r\n\u001b[?2004l\r"]
[68.167397, "o", "\u001b[?2004h> "]
[68.167444, "o", "        }\r\n\u001b[?2004l\r"]
[68.167465, "o", "\u001b[?2004h> "]
[68.167502, "o", "\r\n\u001b[?2004l\r\u001b[?2004h"]
[68.16753, "o", "> "]
[68.167616, "o", "        // Emit tick summary.\r\n\u001b[?2004l\r"]
[68.167636, "o", "\u001b[?2004h> "]
[68.167855, "o", "        writeLine(\"TICK \" + tick + \" ACTIVE \" + active.size());\r\n\u001b[?2004l\r"]
[68.167877, "o", "\u001b[?2004h> "]
[68.168009, "o", "        for (Projectile p : active) {\r\n\u001b[?2004l\r"]
[68.168029, "o", "\u001b[?2004h> "]
[68.168235, "o", "            writeLine(\"P\" + p.id + \" x=\" + (int) p.position.x\r\n\u001b[?2004l\r"]
[68.168256, "o", "\u001b[?2004h> "]
[68.16842, "o", "                    + \" y=\" + (int) p.position.y\r\n\u001b[?2004l\r"]
[68.168452, "o", "\u001b[?2004h> "]
[68.16861, "o", "                    + \" vx=\" + (int) p.velocity.x\r\n\u001b[?2004l\r"]
[68.16863, "o", "\u001b[?2004h> "]
[68.16881, "o", "                    + \" vy=\" + (int) p.velocity.y);\r\n\u001b[?2004l\r"]
[68.168831, "o", "\u001b[?2004h> "]
[68.16888, "o", "        }\r\n\u001b[?2004l\r"]
[68.168902, "o", "\u001b[?2004h> "]
[68.16894, "o", "\r\n\u001b[?2004l\r\u001b[?2004h"]
[68.168968, "o", "> "]
[68.169034, "o", "        currentTick++;\r\n\u001b[?2004l\r"]
[68.169054, "o", "\u001b[?2004h> \r\n"]
[68.169092, "o", "\u001b[?2004l\r\u001b[?2004h"]
[68.16912, "o", "> "]
[68.169238, "o", "        if (currentTick >= totalTicks) {\r\n\u001b[?2004l\r"]
[68.169258, "o", "\u001b[?2004h"]
[68.169296, "o", "> "]
[68.169394, "o", "            // Write final summary.\r\n\u001b[?2004l\r"]
[68.169424, "o", "\u001b[?2004h> "]
[68.169601, "o", "            writeLine(\"SUMMARY spawned=\" + totalSpawns\r\n\u001b[?2004l\r"]
[68.169622, "o", "\u001b[?2004h> "]
[68.169806, "o", "                    + \" grounded=\" + groundedCount\r\n\u001b[?2004l\r"]
[68.169829, "o", "\u001b[?2004h> "]
[68.170003, "o", "                    + \" pool_free=\" + pool.getFree()\r\n\u001b[?2004l\r"]
[68.170025, "o", "\u001b[?2004h> "]
[68.170201, "o", "                    + \" peak_active=\" + peakActive);\r\n\u001b[?2004l\r"]
[68.170223, "o", "\u001b[?2004h> "]
[68.170325, "o", "            Gdx.app.exit();\r\n\u001b[?2004l\r"]
[68.170346, "o", "\u001b[?2004h> "]
[68.170394, "o", "        }\r\n\u001b[?2004l\r"]
[68.170416, "o", "\u001b[?2004h> "]
[68.170453, "o", "    }\r\n\u001b[?2004l\r"]
[68.170475, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[68.170509, "o", "\u001b[?2004h"]
[68.170537, "o", "> "]
[68.170755, "o", "    // Counter for assigning spawn ids in the order SPAWN lines appear.\r\n\u001b[?2004l\r"]
[68.170776, "o", "\u001b[?2004h> "]
[68.170904, "o", "    private int spawnIdCounter = 0;\r\n\u001b[?2004l\r"]
[68.170926, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[68.17096, "o", "\u001b[?2004h"]
[68.170988, "o", "> "]
[68.171081, "o", "    private int nextSpawnId() {\r\n\u001b[?2004l\r"]
[68.171103, "o", "\u001b[?2004h> "]
[68.17122, "o", "        return spawnIdCounter++;\r\n\u001b[?2004l\r"]
[68.171242, "o", "\u001b[?2004h> "]
[68.171284, "o", "    }\r\n\u001b[?2004l\r"]
[68.171306, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[68.17135, "o", "\u001b[?2004h> "]
[68.171471, "o", "    private void writeLine(String s) {\r\n\u001b[?2004l\r"]
[68.171491, "o", "\u001b[?2004h> "]
[68.171556, "o", "        try {\r\n\u001b[?2004l\r"]
[68.171576, "o", "\u001b[?2004h> "]
[68.171688, "o", "            writer.write(s);\r\n\u001b[?2004l\r"]
[68.171708, "o", "\u001b[?2004h"]
[68.171747, "o", "> "]
[68.171835, "o", "            writer.write(\"\\n\");\r\n\u001b[?2004l\r"]
[68.171857, "o", "\u001b[?2004h> "]
[68.171979, "o", "        } catch (IOException e) {\r\n\u001b[?2004l\r"]
[68.172001, "o", "\u001b[?2004h> "]
[68.172233, "o", "            throw new RuntimeException(\"Failed to write log line\", e);\r\n\u001b[?2004l\r"]
[68.172255, "o", "\u001b[?2004h> "]
[68.172302, "o", "        }\r\n\u001b[?2004l\r"]
[68.172324, "o", "\u001b[?2004h> "]
[68.172364, "o", "    }\r\n\u001b[?2004l\r"]
[68.172386, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[68.172416, "o", "\u001b[?2004h> "]
[68.172478, "o", "    @Override\r\n\u001b[?2004l\r"]
[68.172499, "o", "\u001b[?2004h> "]
[68.172603, "o", "    public void dispose() {\r\n\u001b[?2004l\r"]
[68.172624, "o", "\u001b[?2004h"]
[68.172645, "o", "> "]
[68.172754, "o", "        if (writer != null) {\r\n\u001b[?2004l\r"]
[68.172774, "o", "\u001b[?2004h> "]
[68.172848, "o", "            try {\r\n\u001b[?2004l\r"]
[68.172868, "o", "\u001b[?2004h> "]
[68.172986, "o", "                writer.flush();\r\n\u001b[?2004l\r"]
[68.173006, "o", "\u001b[?2004h> "]
