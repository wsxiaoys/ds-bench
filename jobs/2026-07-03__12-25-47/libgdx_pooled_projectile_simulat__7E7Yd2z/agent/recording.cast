[103.903009, "o", "import com.badlogic.gdx.backends.headless.HeadlessApplicationConfiguration;\r\n\u001b[?2004l\r\u001b[?2004h> "]
[103.903063, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[103.903174, "o", "public class Main {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[103.903347, "o", "    public static void main(String[] args) throws Exception {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[103.903468, "o", "        String scenario = null;\r\n\u001b[?2004l\r\u001b[?2004h"]
[103.903521, "o", "> "]
[103.903624, "o", "        String output = null;\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[103.903911, "o", "        // Accept --scenario <path> --output <path> in any order, also accept -s/-o.\r\n\u001b[?2004l\r\u001b[?2004h> "]
[103.90408, "o", "        for (int i = 0; i < args.length; i++) {\r\n\u001b[?2004l\r\u001b[?2004h"]
