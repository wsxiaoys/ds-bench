[?2004l[?2004h>             String line = raw.trim();
[?2004l[?2004h>             if (line.isEmpty() || line.startsWith("#")) {
[?2004l[?2004h>                 continue;
[?2004l[?2004h>             }
[?2004l[?2004h>             String[] parts = line.split("\\s+");
[?2004l[?2004h>             String head = parts[0];
[?2004l[?2004h>             switch (head) {
[?2004l[?2004h>                 case "TICKS": {
[?2004l[?2004h>                     totalTicks = Integer.parseInt(parts[1]);
[?2004l[?2004h>                     break;
[?2004l[?2004h>                 }
[?2004l[?2004h>                 case "GRAVITY": {
[?2004l[?2004h>                     gravityX = Integer.parseInt(parts[1]);
