[?2004hroot@f969055e-d19d-4744-b708-55ec51f6885f:/home/user/projectile_sim# cat > /home/user/projectile_sim/headless/src/main/java/com/example/sim/SimulationListener.java << 'EOF'
[?2004l[?2004h> package com.example.sim;
[?2004l[?2004h> 
[?2004lb[?2004h> import com.badlogic.gdx.ApplicationAdapter;
[?2004l[?2004h> import com.badlogic.gdx.Gdx;
[?2004l[?2004h> import com.badlogic.gdx.files.FileHandle;
[?2004l[?2004h> import com.badlogic.gdx.utils.Pool;
[?2004l[?2004h> 
[?2004l[?2004h> import java.io.BufferedWriter;
[?2004l[?2004h> import java.io.IOException;
[?2004l[?2004h> import java.nio.charset.StandardCharsets;
[?2004l[?2004h> import java.nio.file.Files;
[?2004l[?2004h> import java.nio.file.Path;
[?2004l[?2004h> import java.nio.file.Paths;
[?2004l[?2004h> import java.util.ArrayList;
[?2004l[?2004h> import java.util.Collections;
[?2004l[?2004h> import java.util.HashMap;
[?2004l[?2004h> import java.util.List;
[?2004l[?2004h> import java.util.Map;
[?2004l[?2004h> 
[?2004l[?2004h> public class SimulationListener extends ApplicationAdapter {
[?2004l[?2004h> 
[?2004l[?2004h>     private final String scenarioPath;
[?2004l[?2004h>     private final String outputPath;
[?2004l[?2004h> 
[?2004l[?2004h>     private int totalTicks = 0;
[?2004l[?2004h>     private int gravityX = 0;
[?2004l[?2004h>     private int gravityY = 0;
[?2004l[?2004h>     private int floorY = 0;
[?2004l[?2004h>     private final Map<Integer, List<int[]>> spawnsByTick = new HashMap<>();
[?2004l[?2004h>     private int totalSpawns = 0;
[?2004l[?2004h> 
[?2004l[?2004h>     private final Pool<Projectile> pool = new Pool<Projectile>() {
[?2004l[?2004h>         @Override
[?2004l[?2004h>         protected Projectile newObject() {
[?2004l[?2004h>             return new Projectile();
[?2004l[?2004h>         }
[?2004l[?2004h>     };
[?2004l[?2004h> 
[?2004l[?2004h>     private final List<Projectile> active = new ArrayList<>();
[?2004l[?2004h> 
[?2004l[?2004h>     private int currentTick = 0;
[?2004l[?2004h>     private int groundedCount = 0;
[?2004l[?2004h>     private int peakActive = 0;
[?2004l[?2004h> 
[?2004l[?2004h>     private BufferedWriter writer;
[?2004l[?2004h> 
[?2004l[?2004h>     public SimulationListener(String scenarioPath, String outputPath) {
[?2004l[?2004h>         this.scenarioPath = scenarioPath;
[?2004l[?2004h>         this.outputPath = outputPath;
[?2004l[?2004h>     }
[?2004l[?2004h> 
[?2004l[?2004h>     @Override
[?2004l[?2004h>     public void create() {
[?2004l[?2004h>         try {
[?2004l[?2004h>             // Open output writer first.
[?2004l[?2004h>             Path outFile = Paths.get(outputPath);
[?2004l[?2004h>             if (outFile.getParent() != null) {
[?2004l[?2004h>                 Files.createDirectories(outFile.getParent());
[?2004l[?2004h>             }
[?2004l[?2004h>             writer = Files.newBufferedWriter(outFile, StandardCharsets.UTF_8);
[?2004l[?2004h> 
[?2004l[?2004h>             // Parse scenario file via Gdx.files.absolute.
[?2004l[?2004h>             FileHandle fh = Gdx.files.absolute(scenarioPath);
[?2004l[?2004h>             String contents = fh.readString("UTF-8");
[?2004l[?2004h>             parseScenario(contents);
[?2004l[?2004h> 
[?2004l[?2004h>             // Write header.
[?2004l[?2004h>             writeLine("TICKS " + totalTicks);
[?2004l[?2004h>         } catch (IOException e) {
[?2004l[?2004h>             throw new RuntimeException("Failed to initialise simulation", e);
[?2004l[?2004h>         }
[?2004l[?2004h>     }
[?2004l[?2004h> 
[?2004l[?2004h>     private void parseScenario(String contents) {
[?2004l[?2004h>         String[] lines = contents.split("\r?\n");
[?2004l[?2004h>         for (String raw : lines) {
[?2004l[?2004h>             String line = raw.trim();
[?2004l[?2004h>             if (line.isEmpty() || line.startsWith("#")) {
[?2004l[?2004h>                 continue;
[?2004l[?2004h>             }
[?2004l[?2004h>             String[] parts = line.split("\\s+");
[?2004l[?2004h>             String head = parts[0];
[?2004l[?2004h>             switch (head) {
[?2004l[?2004h>                 case "TICKS": {
[?2004l[?2004h>                     totalTicks = Integer.parseInt(parts[1]);
[?2004l[?2004h>                     break;
[?2004l[?2004h>                 }
[?2004l[?2004h>                 case "GRAVITY": {
[?2004l[?2004h>                     gravityX = Integer.parseInt(parts[1]);
[?2004l[?2004h>                     gravityY = Integer.parseInt(parts[2]);
[?2004l[?2004h>                     break;
[?2004l[?2004h>                 }
[?2004l[?2004h>                 case "FLOOR": {
[?2004l[?2004h>                     floorY = Integer.parseInt(parts[1]);
[?2004l[?2004h>                     break;
[?2004l[?2004h>                 }
[?2004l[?2004h>                 case "SPAWN": {
[?2004l[?2004h>                     int tick = Integer.parseInt(parts[1]);
[?2004l[?2004h>                     int x = Integer.parseInt(parts[2]);
[?2004l[?2004h>                     int y = Integer.parseInt(parts[3]);
[?2004l[?2004h>                     int vx = Integer.parseInt(parts[4]);
[?2004l[?2004h>                     int vy = Integer.parseInt(parts[5]);
[?2004l[?2004h>                     spawnsByTick.computeIfAbsent(tick, k -> new ArrayList<>()).add(new int[]{x, y, vx, vy});
[?2004l[?2004h>                     totalSpawns++;
[?2004l[?2004h>                     break;
[?2004l[?2004h>                 }
[?2004l[?2004h>                 default:
[?2004l[?2004h>                     throw new IllegalArgumentException("Unknown directive: " + head);
[?2004l[?2004h>             }
[?2004l[?2004h>         }
[?2004l[?2004h>     }
[?2004l[?2004h> 
[?2004l[?2004h>     @Override
[?2004l[?2004h>     public void render() {
[?2004l[?2004h>         if (currentTick >= totalTicks) {
[?2004l[?2004h>             // Already done; ensure we exit.
[?2004l[?2004h>             Gdx.app.exit();
[?2004l[?2004h>             return;
[?2004l[?2004h>         }
[?2004l[?2004h> 
[?2004l[?2004h>         int tick = currentTick;
[?2004l[?2004h> 
[?2004l[?2004h>         // 1. Spawn scheduled projectiles.
[?2004l[?2004h>         List<int[]> spawns = spawnsByTick.getOrDefault(tick, Collections.emptyList());
[?2004l[?2004h>         for (int[] s : spawns) {
[?2004l[?2004h>             Projectile p = pool.obtain();
[?2004l[?2004h>             // Assign id based on total spawn order. The id counter increments
[?2004l[?2004h>             // each time we issue a spawn, regardless of tick.
[?2004l[?2004h>             p.id = nextSpawnId();
[?2004l[?2004h>             p.position.set(s[0], s[1]);
[?2004l[?2004h>             p.velocity.set(s[2], s[3]);
[?2004l[?2004h>             active.add(p);
[?2004l[?2004h>         }
[?2004l[?2004h> 
[?2004l[?2004h>         // 2. Integrate: gravity -> position update, in spawn-id order.
[?2004l[?2004h>         // Sort active by id to guarantee deterministic order (already in
[?2004l[?2004h>         // insertion order, but be defensive).
[?2004l[?2004h>         active.sort((a, b) -> Integer.compare(a.id, b.id));
[?2004l[?2004h> 
[?2004l[?2004h>         // Apply gravity to velocity.
[?2004l[?2004h>         for (Projectile p : active) {
[?2004l[?2004h>             p.velocity.x += gravityX;
[?2004l[?2004h>             p.velocity.y += gravityY;
[?2004l[?2004h>         }
[?2004l[?2004h>         // Add velocity to position.
[?2004l[?2004h>         for (Projectile p : active) {
[?2004l[?2004h>             p.position.x += p.velocity.x;
[?2004l[?2004h>             p.position.y += p.velocity.y;
[?2004l[?2004h>         }
[?2004l[?2004h> 
[?2004l[?2004h>         // 3. Ground check.
[?2004l[?2004h>         List<Projectile> stillActive = new ArrayList<>(active.size());
[?2004l[?2004h>         List<Projectile> groundedThisTick = new ArrayList<>();
[?2004l[?2004h>         for (Projectile p : active) {
[?2004l[?2004h>             if (p.position.y <= floorY) {
[?2004l[?2004h>                 groundedThisTick.add(p);
[?2004l[?2004h>             } else {
[?2004l[?2004h>                 stillActive.add(p);
[?2004l[?2004h>             }
[?2004l[?2004h>         }
[?2004l[?2004h>         // Sort grounded by id for output.
[?2004l[?2004h>         groundedThisTick.sort((a, b) -> Integer.compare(a.id, b.id));
[?2004l[?2004h> 
[?2004l[?2004h>         for (Projectile p : groundedThisTick) {
[?2004l[?2004h>             pool.free(p);
[?2004l[?2004h>             groundedCount++;
[?2004l[?2004h>         }
[?2004l[?2004h> 
[?2004l[?2004h>         // Write grounded lines BEFORE tick summary so output order matches spec.
[?2004l[?2004h>         for (Projectile p : groundedThisTick) {
[?2004l[?2004h>             writeLine("GROUNDED P" + p.id + " tick=" + tick);
[?2004l[?2004h>         }
[?2004l[?2004h> 
[?2004l[?2004h>         // Update active list.
[?2004l[?2004h>         active.clear();
