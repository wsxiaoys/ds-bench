[?2004l[?2004h>                     int vy = Integer.parseInt(parts[5]);
[?2004l[?2004h>                     spawnsByTick.computeIfAbsent(tick, k -> new ArrayList<>()).add(new int[]{x, y, vx, vy});
[?2004l[?2004h>                     totalSpawns++;
