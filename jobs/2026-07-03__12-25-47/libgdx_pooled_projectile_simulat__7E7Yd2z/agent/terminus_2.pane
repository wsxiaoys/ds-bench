[?2004l[?2004h>             p.id = spawnIdCounter++;
[?2004l[?2004h>             p.position.set(s[0], s[1]);
[?2004l[?2004h>             p.velocity.set(s[2], s[3]);
[?2004l[?2004h>             active.add(p);
[?2004l[?2004h>         }
[?2004l[?2004h> 
[?2004l[?2004h>         // Track peak as the max simultaneously active count (right after spawning).
