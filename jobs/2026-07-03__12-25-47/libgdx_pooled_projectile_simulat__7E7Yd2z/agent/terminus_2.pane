[?2004l[?2004h>             if (a.equals("--scenario") || a.equals("-s")) {
[?2004l[?2004h>                 scenario = args[++i];
[?2004l[?2004h>             } else if (a.equals("--output") || a.equals("-o")) {
[?2004l[?2004h>                 output = args[++i];
[?2004l[?2004h>             }
[?2004l[?2004h>         }
[?2004l[?2004h>         if (scenario == null || output == null) {
[?2004l[?2004h>             System.err.println("Usage: --scenario <scenario_path> --output <output_path>");
[?2004l[?2004h>             System.exit(1);
[?2004l[?2004h>         }
[?2004l[?2004h> 
[?2004l[?2004h>         HeadlessApplicationConfiguration cfg = new HeadlessApplicationConfiguration();
[?2004l[?2004h>         cfg.updatesPerSecond = 0; // run as fast as possible
[?2004l[?2004h>         cfg.idlePriority = Thread.MIN_PRIORITY;
[?2004l[?2004h> 
[?2004l[?2004h>         SimulationListener listener = new SimulationListener(scenario, output);
[?2004l[?2004h>         HeadlessApplication app = new HeadlessApplication(listener, cfg);
[?2004l[?2004h> 
[?2004l[?2004h>         // Wait for the application thread to finish. The listener calls
[?2004l[?2004h>         // Gdx.app.exit() once all ticks are processed; the application
[?2004l[?2004h>         // thread then terminates, releasing this join.
[?2004l[?2004h>         try {
[?2004l[?2004h>             // The internal thread that runs create()/render()/dispose()
[?2004l[?2004h>             // is not exposed, so we poll until Gdx.app no longer exists
[?2004l[?2004h>             // (after exit it is set to null) and the application thread
[?2004l[?2004h>             // is no longer alive.
[?2004l[?2004h>             Thread renderThread = getRenderThread(app);
[?2004l[?2004h>             if (renderThread != null) {
[?2004l[?2004h>                 renderThread.join();
[?2004l[?2004h>             }
[?2004l[?2004h>         } catch (InterruptedException ie) {
[?2004l[?2004h>             Thread.currentThread().interrupt();
[?2004l[?2004h>             System.exit(2);
[?2004l[?2004h>         }
[?2004l[?2004h>         // Give the listener a moment to flush+close.
[?2004l[?2004h>         Thread.sleep(50);
[?2004l[?2004h>     }
[?2004l[?2004h> 
[?2004l[?2004h>     private static Thread getRenderThread(HeadlessApplication app) {
[?2004l[?2004h>         // HeadlessApplication exposes the thread via reflection. The
[?2004l[?2004h>         // field name "runnables" is private; instead we rely on the
[?2004l[?2004h>         // fact that ApplicationListener.create has already been called
[?2004l[?2004h>         // before main returns from constructing the application, and
[?2004l[?2004h>         // that the rendering loop terminates when Gdx.app.exit() is
[?2004l[?2004h>         // invoked. We find the running thread by name pattern.
[?2004l[?2004h>         Thread[] threads = new Thread[Thread.activeCount() * 2];
[?2004l[?2004h>         int n = Thread.enumerate(threads);
[?2004l[?2004h>         for (int i = 0; i < n; i++) {
[?2004l[?2004h>             Thread t = threads[i];
[?2004l[?2004h>             if (t != null && t.getName() != null
[?2004l[?2004h>                     && (t.getName().contains("HeadlessApplication")
[?2004l[?2004h>                         || t.getName().contains("GDX")
[?2004l[?2004h>                         || t.getName().contains("Application"))) {
[?2004l[?2004h>                 return t;
[?2004l[?2004h>             }
[?2004l[?2004h>         }
[?2004l[?2004h>         return null;
[?2004l[?2004h>     }
[?2004l[?2004h> }
