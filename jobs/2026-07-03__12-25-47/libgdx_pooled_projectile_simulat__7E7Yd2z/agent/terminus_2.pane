[?2004l[?2004h>         }
[?2004l[?2004h> 
[?2004l[?2004h>         active.clear();
[?2004l[?2004h>         active.addAll(stillActive);
[?2004l[?2004h> 
[?2004l[?2004h>         currentTick++;
[?2004l[?2004h> 
[?2004l[?2004h>         if (currentTick >= totalTicks) {
[?2004l[?2004h>             writeLine("SUMMARY spawned=" + totalSpawns
