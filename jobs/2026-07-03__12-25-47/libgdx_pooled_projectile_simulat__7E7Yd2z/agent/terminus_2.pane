[?2004l[?2004h>         stillActive.sort((a, b) -> Integer.compare(a.id, b.id));
[?2004l[?2004h> 
[?2004l[?2004h>         for (Projectile p : groundedThisTick) {
[?2004l[?2004h>             pool.free(p);
[?2004l[?2004h>             groundedCount++;
[?2004l[?2004h>         }
[?2004l[?2004h> 
