[209.01459, "o", "3982\r\n'package task\\n\\nimport (\\n\\t\"context\"\\n\\t\"database/sql\"\\n\\t\"errors\"\\n\\t\"fmt\"\\n\\n\\t\"encore.dev/storage/sqldb\"\\n)\\n\\n// Task represents a task in the task manager.\\ntype Task struct {\\n\\tID          int64  ` + chr(96) + `json:\"id\"` + chr(96) + `\\n\\tTitle       string ` + chr(96) + `json:\"title\"` + chr(96) + `\\n\\tDescription string ` + chr(96) + `json:\"description\"` + chr(96) + `\\n\\tDone        bool   ` + chr(96) + `json:\"done\"` + chr(96) + `\\n}\\n\\n// CreateTaskParams defines the parameters for creating a task.\\ntype CreateTas'\r\n"]
[209.01682, "o", "\u001b[?2004hroot@02854430-6324-41cb-a6ad-ff96d0e23730:/home/user# "]
[225.991115, "i", "cat > /tmp/gen_task.py << 'PYEOF'\nimport base64\n\n# The Go source code\ncode = '''package task\n\nimport (\n\\t\"context\"\n\\t\"database/sql\"\n\\t\"errors\"\n\\t\"fmt\"\n\n\\t\"encore.dev/storage/sqldb\"\n)\n\n// Task represents a task in the task manager.\ntype Task struct {\n\\tID          int64  BACKTICKjson:\"id\"BACKTICK\n\\tTitle       string BACKTICKjson:\"title\"BACKTICK\n\\tDescription string BACKTICKjson:\"description\"BACKTICK\n\\tDone        bool   BACKTICKjson:\"done\"BACKTICK\n}\n\n// CreateTaskParams defines the parameters for creating a task.\ntype CreateTaskParams struct {\n\\tTitle       string BACKTICKjson:\"title\"BACKTICK\n\\tDescription string BACKTICKjson:\"description\"BACKTICK\n}\n\n// ListTasksResponse defines the response for listing tasks.\ntype ListTasksResponse struct {\n\\tTasks []Task BACKTICKjson:\"tasks\"BACKTICK\n}\n\n// UpdateTaskParams defines the parameters for updating a task.\ntype UpdateTaskParams struct {\n\\tTitle       string BACKTICKjson:\"title\"BACKTICK\n\\tDescription string BACKTICKjson:\"description\"BACKTICK\n\\tDone        bool   BACKTICKjson:\"done\"BACKTICK\n}\n\n// taskdb is the PostgreSQL database used by the task service.\nvar taskdb = sqldb.NewDatabase(\"taskdb\", sqldb.DatabaseDriver{\n\\tName:         \"postgres\",\n\\tEncoreDriver: \"postgres\",\n\\tSupportsTLS:  true,\n\\tDatabaseName: \"taskdb\",\n})\n\n// CreateTask creates a new task.\n//encore:api public method=POST path=/tasks\nfunc CreateTask(ctx context.Context, params *CreateTaskParams) (*Task, error) {\n\\tt := &Task{\n\\t\\tTitle:       params.Title,\n\\t\\tDescription: params.Description,\n\\t\\tDone:        false,\n\\t}\n\\terr := taskdb.QueryRow(ctx, SQLQ\\n\\t\\tINSERT INTO tasks (title, description, done)\\n\\t\\tVALUES ($1, $2, $3)\\n\\t\\tRETURNING id\\n\\tSQLQ, t.Title, t.Description, t.Done).Scan(&t.ID)\n\\tif err != nil {\n\\t\\treturn nil, err\n\\t}\n\\treturn t, nil\n}\n\n// ListTasks lists all tasks.\n//encore:api public method=GET path=/tasks\nfunc ListTasks(ctx context.Context) (*ListTasksResponse, error) {\n\\trows, err := taskdb.Query(ctx, SQLQSELECT id, title, description, done FROM tasks ORDER BY idSQLQ)\n\\tif err != nil {\n\\t\\treturn nil, err\n\\t}\n\\tdefer rows.Close()\n\n\\ttasks := []Task{}\n\\tfor rows.Next() {\n\\t\\tvar t Task\n\\t\\tif err := rows.Scan(&t.ID, &t.Title, &t.Description, &t.Done); err != nil {\n\\t\\t\\treturn nil, err\n\\t\\t}\n\\t\\ttasks = append(tasks, t)\n\\t}\n\\tif err := rows.Err(); err != nil {\n\\t\\treturn nil, err\n\\t}\n\\treturn &ListTasksResponse{Tasks: tasks}, nil\n}\n\n// GetTask gets a single task by ID.\n//encore:api public method=GET path=/tasks/:id\nfunc GetTask(ctx context.Context, id int64) (*Task, error) {\n\\tt := &Task{}\n\\terr := taskdb.QueryRow(ctx, SQLQ\\n\\t\\tSELECT id, title, description, done FROM tasks WHERE id = $1\\n\\tSQLQ, id).Scan(&t.ID, &t.Title, &t.Description, &t.Done)\n\\tif err != nil {\n\\t\\tif errors.Is(err, sql.ErrNoRows) {\n\\t\\t\\treturn nil, &errNotFound{fmt.Sprintf(\"task %d not found\", id)}\n\\t\\t}\n\\t\\treturn nil, err\n\\t}\n\\treturn t, nil\n}\n\n// UpdateTask updates a task's title, description, and done status.\n//encore:api public method=PUT path=/tasks/:id\nfunc UpdateTask(ctx context.Context, id int64, params *UpdateTaskParams) (*Task, error) {\n\\tt := &Task{}\n\\terr := taskdb.QueryRow(ctx, SQLQ\\n\\t\\tUPDATE tasks SET title = $1, description = $2, done = $3\\n\\t\\tWHERE id = $4\\n\\t\\tRETURNING id, title, description, done\\n\\tSQLQ, params.Title, params.Description, params.Done, id).Scan(&t.ID, &t.Title, &t.Description, &t.Done)\n\\tif err != nil {\n\\t\\tif errors.Is(err, sql.ErrNoRows) {\n\\t\\t\\treturn nil, &errNotFound{fmt.Sprintf(\"task %d not found\", id)}\n\\t\\t}\n\\t\\treturn nil, err\n\\t}\n\\treturn t, nil\n}\n\n// DeleteTask deletes a task by ID.\n//encore:api public method=DELETE path=/tasks/:id\nfunc DeleteTask(ctx context.Context, id int64) error {\n\\tres, err := taskdb.Exec(ctx, SQLQDELETE FROM tasks WHERE id = $1SQLQ, id)\n\\tif err != nil {\n\\t\\treturn err\n\\t}\n\\tif n, err := res.RowsAffected(); err != nil {\n\\t\\treturn err\n\\t} else if n == 0 {\n\\t\\treturn &errNotFound{fmt.Sprintf(\"task %d not found\", id)}\n\\t}\n\\treturn nil\n}\n\ntype errNotFound struct{ msg string }\n\nfunc (e *errNotFound) Error() string { return e.msg }\n'''\n\n# Replace pl"]
[225.991163, "i", "aceholders\ncode = code.replace('BACKTICK', chr(96))\ncode = code.replace('SQLQ', chr(96))\n\nwith open('/home/user/task/task.go', 'w') as f:\n    f.write(code)\nprint('task.go written, length:', len(code))\nPYEOF\npython3 /tmp/gen_task.py\n"]
