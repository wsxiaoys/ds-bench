[130.28381, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[130.283928, "o", "// DeleteTask deletes a task by ID.\r\n\u001b[?2004l\r\u001b[?2004h> "]
[130.284062, "o", "//encore:api public method=DELETE path=/tasks/:id\r\n\u001b[?2004l\r\u001b[?2004h"]
[130.284113, "o", "> "]
[130.284217, "o", "func DeleteTask(ctx context.Context, id int64) error {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[130.28428, "o", "\u0007"]
[130.284424, "o", "res, err := taskdb.Exec(ctx, `DELETE FROM tasks WHERE id = $1`, id)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[130.284478, "o", "\u0007if err != nil {\r\n\u001b[?2004l\r"]
[130.284573, "o", "\u001b[?2004h> \u0007\r\n.gitignore  encore.app  go.mod      go.sum      task/       \r\n> return err\r\n\u001b[?2004l\r"]
[130.284651, "o", "\u001b[?2004h> \u0007}\r\n\u001b[?2004l\r\u001b[?2004h> \u0007"]
[130.284781, "o", "if n, err := res.RowsAffected(); err != nil {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[130.284833, "o", "\u0007\r\n.gitignore  encore.app  go.mod      go.sum      task/       \r\n> "]
[130.284888, "o", "return err\r\n\u001b[?2004l\r\u001b[?2004h> \u0007"]
[130.285028, "o", "} else if n == 0 {\r\n\u001b[?2004l\r\u001b[?2004h> \u0007\r\n.gitignore  encore.app  go.mod      go.sum      task/       \r\n> "]
[130.285155, "o", "return &errNotFound{fmt.Sprintf(\"task %d not found\", id)}\r\n\u001b[?2004l\r\u001b[?2004h> "]
[130.285206, "o", "\u0007}\r\n\u001b[?2004l\r\u001b[?2004h> \u0007"]
[130.285323, "o", "return nil\r\n\u001b[?2004l\r\u001b[?2004h> }\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[130.285431, "o", "type errNotFound struct{ msg string }\r\n\u001b[?2004l\r\u001b[?2004h> \r\n"]
[130.285483, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[130.285615, "o", "func (e *errNotFound) Error() string { return e.msg }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[130.285666, "o", "'''\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[130.285778, "o", "with open('task/task.go', 'w') as f:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[130.285853, "o", "    f.write(content)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[130.285945, "o", "print('Done writing task.go')\r\n\u001b[?2004l\r\u001b[?2004h> "]
[130.285995, "o", "PYEOF\r\n\u001b[?2004l\r"]
[130.293784, "o", "Done writing task.go\r\n"]
