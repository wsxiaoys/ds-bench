[226.009197, "o", "\u001b[?2004h"]
[226.009253, "o", "> "]
[226.009851, "o", "\\trows, err := taskdb.Query(ctx, SQLQSELECT id, title, description, done FROM tasks ORDER BY idSQLQ)\r\n\u001b[?2004l\r"]
[226.009907, "o", "\u001b[?2004h> "]
[226.010035, "o", "\\tif err != nil {\r\n\u001b[?2004l\r"]
