[226.007144, "o", "\\terr := taskdb.QueryRow(ctx, SQLQ\\n\\t\\tINSERT INTO tasks (title, description, done)\\n\\t\\tVALUES ($1, $2, $3)\\n\\t\\tRETURNING id\\n\\tSQLQ, t.Title, t.Description, t.Done).Scan(&t.ID)\r\n\u001b[?2004l\r"]
[226.007203, "o", "\u001b[?2004h"]
[226.007231, "o", "> "]
[226.007353, "o", "\\tif err != nil {\r\n\u001b[?2004l\r"]
