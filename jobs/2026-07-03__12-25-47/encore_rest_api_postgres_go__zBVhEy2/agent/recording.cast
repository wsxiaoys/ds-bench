[142.192432, "i", "python3 -c \"\nimport sys\ncode = '''package task\n\nimport (\n\\t\"context\"\n\\t\"database/sql\"\n\\t\"errors\"\n\\t\"fmt\"\n\n\\t\"encore.dev/storage/sqldb\"\n)\n\n// Task represents a task in the task manager.\ntype Task struct {\n\\tID          int64  `json:\\\"id\\\"`\n\\tTitle       string `json:\\\"title\\\"`\n\\tDescription string `json:\\\"description\\\"`\n\\tDone        bool   `json:\\\"done\\\"`\n}\n\n// CreateTaskParams defines the parameters for creating a task.\ntype CreateTaskParams struct {\n\\tTitle       string `json:\\\"title\\\"`\n\\tDescription string `json:\\\"description\\\"`\n}\n\n// ListTasksResponse defines the response for listing tasks.\ntype ListTasksResponse struct {\n\\tTasks []Task `json:\\\"tasks\\\"`\n}\n\n// UpdateTaskParams defines the parameters for updating a task.\ntype UpdateTaskParams struct {\n\\tTitle       string `json:\\\"title\\\"`\n\\tDescription string `json:\\\"description\\\"`\n\\tDone        bool   `json:\\\"done\\\"`\n}\n\n// taskdb is the PostgreSQL database used by the task service.\nvar taskdb = sqldb.NewDatabase(\\\"taskdb\\\", sqldb.DatabaseDriver{\n\\tName:         \\\"postgres\\\",\n\\tEncoreDriver: \\\"postgres\\\",\n\\tSupportsTLS:  true,\n\\tDatabaseName: \\\"taskdb\\\",\n})\n'''\nwith open('task/task.go', 'w') as f:\n    f.write(code)\nprint('part 1 done')\n\"\n"]
