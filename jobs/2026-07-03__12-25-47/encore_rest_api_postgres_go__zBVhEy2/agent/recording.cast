[226.011301, "o", "\u001b[?2004h> "]
[226.011797, "o", "\\t\\tif err := rows.Scan(&t.ID, &t.Title, &t.Description, &t.Done); err != nil {\r\n\u001b[?2004l\r"]
[226.01186, "o", "\u001b[?2004h> "]
[226.012016, "o", "\\t\\t\\treturn nil, err\r\n\u001b[?2004l\r"]
[226.012087, "o", "\u001b[?2004h"]
[226.012161, "o", "> \\t\\t}\r\n\u001b[?2004l\r"]
[226.012187, "o", "\u001b[?2004h> "]
[226.012412, "o", "\\t\\ttasks = append(tasks, t)\r\n\u001b[?2004l\r"]
[226.012474, "o", "\u001b[?2004h> "]
[226.012531, "o", "\\t}\r\n\u001b[?2004l\r"]
[226.012586, "o", "\u001b[?2004h> "]
[226.012834, "o", "\\tif err := rows.Err(); err != nil {\r\n\u001b[?2004l\r"]
[226.012895, "o", "\u001b[?2004h> "]
[226.01304, "o", "\\t\\treturn nil, err\r\n\u001b[?2004l\r"]
[226.013122, "o", "\u001b[?2004h> "]
[226.013157, "o", "\\t}\r\n\u001b[?2004l\r"]
[226.013287, "o", "\u001b[?2004h> "]
[226.013494, "o", "\\treturn &ListTasksResponse{Tasks: tasks}, nil\r\n\u001b[?2004l\r"]
[226.013524, "o", "\u001b[?2004h"]
[226.013582, "o", "> }\r\n\u001b[?2004l\r"]
[226.013664, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
