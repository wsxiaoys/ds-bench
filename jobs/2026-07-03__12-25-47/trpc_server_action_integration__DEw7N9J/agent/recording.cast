[320.53374, "o", "\u001b[?2004l\r\r\n"]
[320.534671, "o", "import { initTRPC } from '@trpc/server';\r\nimport { z } from 'zod';\r\n\r\nconst t = initTRPC.create();\r\n\r\nconst appRouter = t.router({\r\n  addMessage: t.procedure\r\n    .input(z.object({ text: z.string() }))\r\n    .mutation(({ input }) => {\r\n      return { success: true, message: input.text };\r\n    }),\r\n});\r\n\r\nexport type AppRouter = typeof appRouter;\r\n\r\nconst createCallerFactory = t.createCallerFactory;\r\nconst caller = createCallerFactory(appRouter)({});\r\n\r\nexport { caller };\r\n"]
[320.534836, "o", "\u001b[?2004h"]
[320.534874, "o", "root@439cdd8b-b0ba-4832-b3f0-b43bec485182:/home/user/project# "]
[320.86984, "i", "cat src/app/actions.ts\n"]
[320.87006, "o", "\u001b[?2004l\r\r\n"]
[320.871026, "o", "'use server';\r\n\r\nimport { caller } from '@/server/trpc';\r\n\r\nexport async function addMessageAction(text: string) {\r\n  const result = await caller.addMessage({ text });\r\n  return result;\r\n}\r\n"]
[320.871199, "o", "\u001b[?2004hroot@439cdd8b-b0ba-4832-b3f0-b43bec485182:/home/user/project# "]
[321.187241, "i", "cat src/app/message-form.tsx\n"]
[321.187481, "o", "\u001b[?2004l\r\r\n"]
[321.188381, "o", "'use client';\r\n\r\nimport { useState } from 'react';\r\nimport { addMessageAction } from './actions';\r\n\r\ntype ActionResult = {\r\n  success: boolean;\r\n  message: string;\r\n};\r\n\r\nexport function MessageForm() {\r\n  const [text, setText] = useState('');\r\n  const [result, setResult] = useState<ActionResult | null>(null);\r\n\r\n  async function handleSubmit(formData: FormData) {\r\n    const submittedText = formData.get('text') as string;\r\n    setText(submittedText);\r\n    const res = await addMessageAction(submittedText);\r\n    setResult(res);\r\n  }\r\n\r\n  return (\r\n    <div className=\"w-full max-w-md\">\r\n      <form action={handleSubmit} className=\"flex flex-col gap-4\">\r\n        <input\r\n          name=\"text\"\r\n          type=\"text\"\r\n          placeholder=\"Enter a message\"\r\n          className=\"border border-zinc-300 dark:border-zinc-700 rounded px-4 py-2 bg-white dark:bg-zinc-900 text-black dark:text-zinc-50\"\r\n          required\r\n        />\r\n        <button\r\n          type=\"submit\"\r\n          className=\"bg-blue-600 hover:bg-blue-700 text-white font-medium rounded px-5 py-2\"\r\n        >\r\n          Submit\r\n        </button>\r\n      </form>\r\n      {result && (\r\n        <div className=\"mt-6 p-4 border border-zinc-300 dark:border-zinc-700 rounded bg-zinc-100 dark:bg-zinc-900\">\r\n          <p className=\"text-black dark:text-zinc-50\">\r\n            <strong>Result:</strong> {JSON.stringify(result)}\r\n          </p>\r\n        </div>\r\n      )}\r\n    </div>\r\n  );\r\n}\r\n"]
[321.188578, "o", "\u001b[?2004hroot@439cdd8b-b0ba-4832-b3f0-b43bec485182:/home/user/project# "]
