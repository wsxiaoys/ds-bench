[9.735096, "o", "{\r\n  \"name\": \"myapp\",\r\n  \"private\": true,\r\n  \"version\": \"0.0.0\",\r\n  \"type\": \"module\",\r\n  \"scripts\": {\r\n    \"dev\": \"vite\",\r\n    \"build\": \"vite build\",\r\n    \"preview\": \"vite preview\"\r\n  },\r\n  \"devDependencies\": {\r\n    \"typescript\": \"~5.4.5\",\r\n    \"vite\": \"~5.4.10\"\r\n  }\r\n}\r\n"]
