[12.033338, "o", "import { render, route } from \"rwsdk/router\";\r\nimport { defineApp } from \"rwsdk/worker\";\r\n\r\nimport { Document } from \"@/app/document\";\r\nimport { setCommonHeaders } from \"@/app/headers\";\r\nimport { Home } from \"@/app/pages/home\";\r\n\r\nexport type AppContext = {};\r\n\r\nexport default defineApp([\r\n  setCommonHeaders(),\r\n  ({ ctx }) => {\r\n    // setup ctx here\r\n    ctx;\r\n  },\r\n  render(Document, [route(\"/\", Home)]),\r\n]);\r\n"]
[12.033375, "o", "import { initClient, initClientNavigation } from \"rwsdk/client\";\r\n\r\n// RedwoodSDK uses RSC RPC to emulate client side navigation.\r\n// https://docs.rwsdk.com/guides/frontend/client-side-nav/\r\nconst { handleResponse, onHydrated } = initClientNavigation();\r\ninitClient({ handleResponse, onHydrated });\r\n"]
