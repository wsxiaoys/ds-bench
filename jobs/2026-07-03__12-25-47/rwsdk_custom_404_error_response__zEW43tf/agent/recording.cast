[15.974787, "o", "export const Document: React.FC<{ children: React.ReactNode }> = ({\r\n  children,\r\n}) => (\r\n  <html lang=\"en\">\r\n    <head>\r\n      <meta charSet=\"utf-8\" />\r\n      <meta name=\"viewport\" content=\"width=device-width, initial-scale=1\" />\r\n      <title>@redwoodjs/starter-minimal</title>\r\n      <link rel=\"preconnect\" href=\"https://fonts.googleapis.com\" />\r\n      <link\r\n        rel=\"preconnect\"\r\n        href=\"https://fonts.gstatic.com\"\r\n        crossOrigin=\"\"\r\n      />\r\n      <link\r\n        rel=\"stylesheet\"\r\n        href=\"https://fonts.googleapis.com/css2?family=Noto+Sans:ital,wght@0,100..900;1,100..900&family=Playfair+Display:ital,wght@0,400..900;1,400..900&display=optional\"\r\n        precedence=\"first\"\r\n      />\r\n      <link rel=\"modulepreload\" href=\"/src/client.tsx\" />\r\n    </head>\r\n    <body>\r\n      {children}\r\n      <script>import(\"/src/client.tsx\")</script>\r\n    </body>\r\n  </html>\r\n);\r\n"]
[15.974827, "o", "import { RouteMiddleware } from \"rwsdk/router\";\r\n\r\nexport const setCommonHeaders =\r\n  (): RouteMiddleware =>\r\n  ({ response, rw: { nonce } }) => {\r\n    if (!import.meta.env.VITE_IS_DEV_SERVER) {\r\n      // Forces browsers to always use HTTPS for a specified time period (2 years)\r\n      response.headers.set(\r\n        \"Strict-Transport-Security\",\r\n        \"max-age=63072000; includeSubDomains; preload\",\r\n      );\r\n    }\r\n\r\n    // Forces browser to use the declared content-type instead of trying to guess/sniff it\r\n    response.headers.set(\"X-Content-Type-Options\", \"nosniff\");\r\n\r\n    // Stops browsers from sending the referring webpage URL in HTTP headers\r\n    response.headers.set(\"Referrer-Policy\", \"no-referrer\");\r\n\r\n    // Explicitly disables access to specific browser features/APIs\r\n    response.headers.set(\r\n      \"Permissions-Policy\",\r\n      \"geolocation=(), microphone=(), camera=()\",\r\n    );\r\n\r\n    // Defines trusted sources for content loading and script execution:\r\n    response.headers.set(\r\n      \"Content-Security-Policy\",\r\n      `default-src 'self'; script-src 'self' 'unsafe-eval' 'nonce-${nonce}' https://challenges.cloudflare.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; frame-ancestors 'self'; frame-src 'self' https://challenges.cloudflare.com; object-src 'none';`,\r\n    );\r\n  };\r\n"]
[15.974923, "o", "import { Welcome } from \"./welcome.js\";\r\n\r\nexport const Home = () => {\r\n  // _Feel free to delete this element and its import_\r\n  return <Welcome />;\r\n};\r\n\"use client\";\r\n/**\r\n * This is a minimal welcome page for the starter.\r\n *\r\n * _Feel free to delete this file_\r\n **/\r\n\r\nimport { useState } from \"react\";\r\nimport styles from \"./welcome.module.css\";\r\n\r\nexport const Welcome = () => {\r\n  return (\r\n    <div className={styles.container}>\r\n      <header className={styles.header}>\r\n        <h1 className={styles.title}>Welcome to RedwoodSDK</h1>\r\n        <p className={styles.subtitle}>\r\n          You’ve just installed the starter project. Here’s what to do next.\r\n        </p>\r\n      </header>\r\n\r\n      <main>\r\n        <section className={styles.section}>\r\n          <h2 className={styles.sectionTitle}>Next steps</h2>\r\n          <ol className={styles.list}>\r\n            <li>\r\n              Read the{\" \"}\r\n              <a\r\n                href=\"https://docs.rwsdk.com/getting-started/quick-start/\"\r\n                target=\"_blank\"\r\n                rel=\"noreferrer\"\r\n                className={styles.link}\r\n              >\r\n                Quick Start\r\n              </a>{\" \"}\r\n              to learn the basics.\r\n            </li>\r\n            <li>\r\n              Explore React Server Components and Server Functions in the{\" \"}\r\n              <a\r\n                href=\"https://docs.rwsdk.com/\"\r\n                target=\"_blank\"\r\n                rel=\"noreferrer\"\r\n                className={styles.link}\r\n              >\r\n                Docs\r\n              </a>\r\n              .\r\n            </li>\r\n            <li>\r\n              Join the community to ask questions and share what you’re\r\n              building.\r\n            </li>\r\n          </ol>\r\n        </section>\r\n\r\n        <section className={styles.section}>\r\n          <h2 className={styles.sectionTitle}>Deploy to Cloudflare</h2>\r\n          <p>\r\n            RedwoodSDK runs on Cloudflare Workers. Here’s the quickest way to\r\n            deploy.\r\n          </p>\r\n          <div className={styles.codeBlock}>\r\n            <span className={styles.codePrompt}>$</span>\r\n            <code className={styles.code}>pnpm release</code>\r\n            <Copy textToCopy=\"pnpm release\" />\r\n          </div>\r\n          <p>\r\n            Need more detail? Read the{\" \"}\r\n            <a\r\n              href=\"https://docs.rwsdk.com/core/hosting/\"\r\n              target=\"_blank\"\r\n              rel=\"noreferrer\"\r\n              className={styles.link}\r\n            >\r\n"]
[15.975012, "o", "              Cloudflare deployment guide\r\n            </a>\r\n            .\r\n          </p>\r\n        </section>\r\n      </main>\r\n    </div>\r\n  );\r\n};\r\n\r\nconst Copy = ({ textToCopy }: { textToCopy: string }) => {\r\n  const [copied, setCopied] = useState(false);\r\n\r\n  const handleCopy = () => {\r\n    navigator.clipboard.writeText(textToCopy).then(() => {\r\n      setCopied(true);\r\n      setTimeout(() => setCopied(false), 2000);\r\n    });\r\n  };\r\n\r\n  return (\r\n    <button onClick={handleCopy} className={styles.copyButton}>\r\n      {copied ? \"Copied!\" : \"Copy\"}\r\n    </button>\r\n  );\r\n};\r\n"]
