[33.306193, "o", "> "]
[33.30627, "o", "folder_id = resp['data']['id']\r\n\u001b[?2004l\r\u001b[?2004h"]
[33.306297, "o", "> "]
[33.306387, "o", "print('folder_id:', folder_id)\r\n\u001b[?2004l\r\u001b[?2004h"]
[33.306417, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[33.306481, "o", "# 3. Upload 3 files\r\n\u001b[?2004l\r"]
[33.30651, "o", "\u001b[?2004h> "]
[33.306565, "o", "file_ids = []\r\n\u001b[?2004l\r\u001b[?2004h> "]
[33.306622, "o", "for i in (1, 2, 3):\r\n\u001b[?2004l\r"]
[33.306648, "o", "\u001b[?2004h> "]
[33.306747, "o", "    fname = f'NOTE-{run_id}-{i}.txt'\r\n\u001b[?2004l\r"]
[33.306775, "o", "\u001b[?2004h> "]
[33.306954, "o", "    payload = f'Run-scoped note {i} for {run_id}\\n'.encode('utf-8')\r\n\u001b[?2004l\r\u001b[?2004h"]
[33.306979, "o", "> "]
[33.307043, "o", "    meta = json.dumps({\r\n\u001b[?2004l\r"]
[33.30707, "o", "\u001b[?2004h> "]
[33.30713, "o", "        'name': fname,\r\n\u001b[?2004l\r"]
[33.307158, "o", "\u001b[?2004h> "]
[33.307259, "o", "        'parent_folder_id': folder_id,\r\n\u001b[?2004l\r"]
[33.30729, "o", "\u001b[?2004h> "]
[33.307366, "o", "        'drive_id': drive_id,\r\n\u001b[?2004l\r\u001b[?2004h"]
[33.307395, "o", "> "]
[33.307465, "o", "    })\r\n\u001b[?2004l\r\u001b[?2004h> "]
[33.307648, "o", "    extra = {'x-apideck-metadata': meta, 'Content-Type': 'application/octet-stream'}\r\n\u001b[?2004l\r"]
[33.307676, "o", "\u001b[?2004h> "]
[33.307883, "o", "    status, resp = http('POST', f'{UPLOAD}/file-storage/files', payload, extra)\r\n\u001b[?2004l\r"]
[33.307912, "o", "\u001b[?2004h> "]
[33.308074, "o", "    print(f'Upload {fname}:', status, json.dumps(resp)[:300])\r\n\u001b[?2004l\r"]
[33.308102, "o", "\u001b[?2004h> "]
[33.308262, "o", "    assert status in (200, 201), f'File upload failed: {resp}'\r\n\u001b[?2004l\r"]
[33.308293, "o", "\u001b[?2004h> "]
[33.308393, "o", "    file_ids.append(resp['data']['id'])\r\n\u001b[?2004l\r"]
[33.308424, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[33.30848, "o", "> "]
[33.308507, "o", "# 4. Write output log\r\n\u001b[?2004l\r\u001b[?2004h"]
[33.308561, "o", "> "]
[33.308707, "o", "log_line = json.dumps({'folder_id': folder_id, 'file_ids': file_ids})\r\n\u001b[?2004l\r"]
[33.308733, "o", "\u001b[?2004h> "]
[33.308911, "o", "with open('/home/user/apideck_task/output.log', 'w') as f:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[33.309003, "o", "    f.write(log_line + '\\n')\r\n\u001b[?2004l\r"]
[33.30903, "o", "\u001b[?2004h> "]
[33.3091, "o", "print('LOG:', log_line)\r\n\u001b[?2004l\r"]
[33.30913, "o", "\u001b[?2004h> "]
[33.309194, "o", "print('DONE')\r\n\u001b[?2004l\r\u001b[?2004h> "]
[33.309223, "o", "PYEOF\r\n\u001b[?2004l\r"]
[33.310548, "o", "\u001b[?2004hroot@e8f71ea0-4500-4688-acfc-1a06a4ab6f38:/home/user/apideck_task# "]
[33.608769, "i", "python3 run.py\n"]
[33.608941, "o", "python3 run.py\r\n\u001b[?2004l\r"]
