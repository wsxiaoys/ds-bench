[?2004l[?2004h> import os, json, urllib.request, urllib.error
[?2004l[?2004h> 
[?2004l[?2004h> api_key = os.environ['APIDECK_API_KEY']
[?2004l[?2004h> app_id = os.environ['APIDECK_APP_ID']
[?2004l[?2004h> consumer_id = os.environ['APIDECK_CONSUMER_ID']
[?2004l[?2004h> run_id = open('/logs/artifacts/run-id').read().strip()
[?2004l[?2004h> 
[?2004l[?2004h> def get(url):
[?2004l[?2004h>     req = urllib.request.Request(url)
[?2004l[?2004h>     req.add_header('Authorization', f'Bearer {api_key}')
[?2004l[?2004h>     req.add_header('x-apideck-app-id', app_id)
[?2004l[?2004h>     req.add_header('x-apideck-consumer-id', consumer_id)
[?2004l[?2004h>     req.add_header('x-apideck-service-id', 'onedrive')
[?2004l[?2004h>     try:
[?2004l[?2004h>         with urllib.request.urlopen(req, timeout=30) as r:
[?2004l[?2004h>             return r.status, json.loads(r.read().decode())
[?2004l[?2004h>     except urllib.error.HTTPError as e:
[?2004l[?2004h>         return e.code, json.loads(e.read().decode() or 'null')
[?2004l[?2004h> 
[?2004l[?2004h> d = json.load(open('/home/user/apideck_task/output.log'))
[?2004l[?2004h> folder_id = d['folder_id']
[?2004l[?2004h> print('folder_id:', folder_id)
[?2004l[?2004h> print('file_ids:', d['file_ids'])
[?2004l[?2004h> 
[?2004l[?2004h> # Try listing files using the documented filter format
[?2004l[?2004h> urls = [
[?2004l[?2004h>     f'https://unify.apideck.com/file-storage/folders/{folder_id}/files',
[?2004l[?2004h>     f'https://unify.apideck.com/file-storage/files',
[?2004l[?2004h> ]
[?2004l[?2004h> for u in urls:
[?2004l[?2004h>     print('GET', u[:120])
[?2004l[?2004h>     s, r = get(u)
[?2004l[?2004h>     print(' ->', s, json.dumps(r)[:300])
[?2004l[?2004h> PYEOF
