[294.75734, "o", "#!/usr/bin/env python3\r\n\"\"\"Split a concatenated PDF into logical segments using LlamaCloud (beta).\"\"\"\r\nfrom __future__ import annotations\r\n\r\nimport argparse\r\nimport json\r\nimport os\r\nimport sys\r\nfrom typing import Any, Dict, List\r\n\r\nfrom llama_cloud import LlamaCloud\r\n\r\n\r\ndef parse_args(argv: List[str] | None = None) -> argparse.Namespace:\r\n    parser = argparse.ArgumentParser(\r\n        description=(\r\n            \"Split a concatenated PDF into logical segments with LlamaCloud's \"\r\n            \"beta Split API.\"\r\n        ),\r\n    )\r\n    parser.add_argument(\r\n"]
[294.757382, "o", "        \"--pdf\",\r\n        required=True,\r\n        help=\"Path to the input PDF file.\",\r\n    )\r\n    parser.add_argument(\r\n        \"--config\",\r\n        required=True,\r\n        help=\"Path to the categories configuration JSON file.\",\r\n    )\r\n"]
