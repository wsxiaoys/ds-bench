[234.385768, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[234.385869, "o", "\u001b[?2004h> "]
[234.386072, "o", "def load_categories(config_path: str) -> List[Dict[str, str]]:\r\n\u001b[?2004l\r"]
[234.386107, "o", "\u001b[?2004h> "]
[234.386368, "o", "    \"\"\"Load and validate the categories configuration file.\"\"\"\r\n\u001b[?2004l\r"]
[234.386402, "o", "\u001b[?2004h> "]
[234.386574, "o", "    if not os.path.isfile(config_path):\r\n\u001b[?2004l\r"]
[234.386614, "o", "\u001b[?2004h> "]
[234.386934, "o", "        raise FileNotFoundError(f\"Config file not found: {config_path}\")\r\n\u001b[?2004l\r"]
[234.387004, "o", "\u001b[?2004h> "]
[234.387235, "o", "    with open(config_path, \"r\", encoding=\"utf-8\") as fh:\r\n\u001b[?2004l\r"]
[234.387282, "o", "\u001b[?2004h> "]
[234.387397, "o", "        data = json.load(fh)\r\n\u001b[?2004l\r\u001b[?2004h"]
[234.387468, "o", "> "]
[234.387697, "o", "    if not isinstance(data, dict) or \"categories\" not in data:\r\n\u001b[?2004l\r\u001b[?2004h"]
[234.387789, "o", "> "]
[234.387828, "o", "        raise ValueError(\r\n\u001b[?2004l\r\u001b[?2004h"]
[234.387939, "o", "> "]
[234.38813, "o", "            \"Config JSON must be an object with a 'categories' key.\"\r\n\u001b[?2004l\r"]
[234.388172, "o", "\u001b[?2004h> "]
[234.388265, "o", "        )\r\n\u001b[?2004l\r\u001b[?2004h> "]
[234.388439, "o", "    categories = data[\"categories\"]\r\n\u001b[?2004l\r\u001b[?2004h"]
[234.388477, "o", "> "]
[234.38872, "o", "    if not isinstance(categories, list) or not categories:\r\n\u001b[?2004l\r\u001b[?2004h"]
[234.388754, "o", "> "]
[234.389094, "o", "        raise ValueError(\"'categories' must be a non-empty list.\")\r\n\u001b[?2004l\r\u001b[?2004h> "]
[234.389303, "o", "    cleaned: List[Dict[str, str]] = []\r\n\u001b[?2004l\r"]
[234.389335, "o", "\u001b[?2004h> "]
[234.389592, "o", "    for idx, entry in enumerate(categories):\r\n\u001b[?2004l\r"]
[234.389686, "o", "\u001b[?2004h> "]
[234.389846, "o", "        if not isinstance(entry, dict):\r\n\u001b[?2004l\r"]
[234.389883, "o", "\u001b[?2004h> "]
[234.390026, "o", "            raise ValueError(\r\n\u001b[?2004l\r"]
[234.390059, "o", "\u001b[?2004h> "]
[234.390414, "o", "                f\"Category at index {idx} must be an object with 'name'/\"\r\n\u001b[?2004l\r"]
[234.390446, "o", "\u001b[?2004h> "]
[234.39055, "o", "                \"'description'.\"\r\n\u001b[?2004l\r"]
[234.390585, "o", "\u001b[?2004h> "]
[234.390643, "o", "            )\r\n\u001b[?2004l\r"]
[234.390678, "o", "\u001b[?2004h> "]
[234.390945, "o", "        if \"name\" not in entry or \"description\" not in entry:\r\n\u001b[?2004l\r\u001b[?2004h"]
[234.391009, "o", "> "]
[234.391112, "o", "            raise ValueError(\r\n\u001b[?2004l\r"]
[234.391176, "o", "\u001b[?2004h> "]
[234.391436, "o", "                f\"Category at index {idx} must contain 'name' and 'description'.\"\r\n\u001b[?2004l\r"]
[234.391517, "o", "\u001b[?2004h> "]
[234.391561, "o", "            )\r\n\u001b[?2004l\r\u001b[?2004h> "]
[234.39169, "o", "        name = str(entry[\"name\"]).strip()\r\n\u001b[?2004l\r"]
[234.391725, "o", "\u001b[?2004h> "]
[234.391957, "o", "        description = str(entry[\"description\"]).strip()\r\n\u001b[?2004l\r\u001b[?2004h"]
[234.391998, "o", "> "]
[234.392126, "o", "        if not name or not description:\r\n\u001b[?2004l\r"]
[234.392202, "o", "\u001b[?2004h> "]
[234.392292, "o", "            raise ValueError(\r\n\u001b[?2004l\r"]
[234.392343, "o", "\u001b[?2004h> "]
[234.392584, "o", "                f\"Category at index {idx} has empty name or description.\"\r\n\u001b[?2004l\r"]
[234.392635, "o", "\u001b[?2004h> "]
[234.392689, "o", "            )\r\n\u001b[?2004l\r\u001b[?2004h"]
[234.392719, "o", "> "]
[234.392942, "o", "        cleaned.append({\"name\": name, \"description\": description})\r\n\u001b[?2004l\r"]
[234.392997, "o", "\u001b[?2004h> "]
[234.393046, "o", "    return cleaned\r\n\u001b[?2004l\r"]
[234.3931, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[234.393155, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[234.39321, "o", "> "]
[234.393377, "o", "def _segment_to_dict(segment: Any) -> Dict[str, Any]:\r\n\u001b[?2004l\r"]
[234.39341, "o", "\u001b[?2004h> "]
[234.393643, "o", "    \"\"\"Normalize a single segment into the expected JSON shape.\"\"\"\r\n\u001b[?2004l\r"]
[234.393721, "o", "\u001b[?2004h> "]
[234.393976, "o", "    # Prefer attribute access for pydantic models; fall back to dict-like access.\r\n\u001b[?2004l\r"]
[234.394024, "o", "\u001b[?2004h> "]
[234.394168, "o", "    def _get(obj, key, default=None):\r\n\u001b[?2004l\r"]
[234.394198, "o", "\u001b[?2004h> "]
[234.39433, "o", "        if isinstance(obj, dict):\r\n\u001b[?2004l\r"]
[234.39436, "o", "\u001b[?2004h> "]
[234.394518, "o", "            return obj.get(key, default)\r\n\u001b[?2004l\r"]
[234.394549, "o", "\u001b[?2004h> "]
[234.394711, "o", "        return getattr(obj, key, default)\r\n\u001b[?2004l\r"]
[234.39477, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[234.394922, "o", "    category = _get(segment, \"category\", \"\")\r\n\u001b[?2004l\r"]
[234.394954, "o", "\u001b[?2004h> "]
[234.39516, "o", "    confidence = _get(segment, \"confidence_category\", \"\")\r\n\u001b[?2004l\r"]
[234.39519, "o", "\u001b[?2004h> "]
[234.395335, "o", "    pages = _get(segment, \"pages\", [])\r\n\u001b[?2004l\r"]
[234.395363, "o", "\u001b[?2004h> "]
[234.395464, "o", "    if category is None:\r\n\u001b[?2004l\r"]
[234.395503, "o", "\u001b[?2004h> "]
[234.395596, "o", "        category = \"\"\r\n\u001b[?2004l\r"]
[234.395647, "o", "\u001b[?2004h> "]
[234.39573, "o", "    if confidence is None:\r\n\u001b[?2004l\r"]
[234.395775, "o", "\u001b[?2004h> "]
[234.395853, "o", "        confidence = \"\"\r\n\u001b[?2004l\r"]
[234.395898, "o", "\u001b[?2004h> "]
[234.395992, "o", "    if pages is None:\r\n\u001b[?2004l\r"]
[234.396036, "o", "\u001b[?2004h> "]
[234.396111, "o", "        pages = []\r\n\u001b[?2004l\r"]
[234.396149, "o", "\u001b[?2004h> "]
[234.396299, "o", "    pages_list = [int(p) for p in pages]\r\n\u001b[?2004l\r"]
[234.396338, "o", "\u001b[?2004h> "]
[234.396383, "o", "    return {\r\n\u001b[?2004l\r"]
[234.396411, "o", "\u001b[?2004h> "]
[234.396546, "o", "        \"category\": str(category),\r\n\u001b[?2004l\r"]
[234.396573, "o", "\u001b[?2004h> "]
[234.396684, "o", "        \"pages\": pages_list,\r\n\u001b[?2004l\r"]
[234.396729, "o", "\u001b[?2004h> "]
[234.39688, "o", "        \"confidence_category\": str(confidence),\r\n\u001b[?2004l\r"]
[234.396913, "o", "\u001b[?2004h> "]
[234.396979, "o", "    }\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[234.397029, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[234.397061, "o", "> "]
[234.397277, "o", "def extract_segments(response: Any) -> List[Dict[str, Any]]:\r\n\u001b[?2004l\r"]
[234.397323, "o", "\u001b[?2004h> "]
[234.397532, "o", "    \"\"\"Pull the segments list out of a SplitGetResponse-like object.\"\"\"\r\n\u001b[?2004l\r"]
[234.397573, "o", "\u001b[?2004h> "]
[234.397724, "o", "    result = getattr(response, \"result\", None)\r\n\u001b[?2004l\r"]
[234.397768, "o", "\u001b[?2004h> "]
[234.397951, "o", "    if result is None and isinstance(response, dict):\r\n\u001b[?2004l\r"]
[234.397986, "o", "\u001b[?2004h> "]
[234.398144, "o", "        result = response.get(\"result\")\r\n\u001b[?2004l\r"]
[234.398174, "o", "\u001b[?2004h> "]
[234.398265, "o", "    if result is None:\r\n\u001b[?2004l\r"]
[234.398322, "o", "\u001b[?2004h> "]
[234.398415, "o", "        raise RuntimeError(\r\n\u001b[?2004l\r"]
[234.398445, "o", "\u001b[?2004h> "]
[234.398757, "o", "            \"Split job completed but returned no 'result' payload.\"\r\n\u001b[?2004l\r"]
[234.398833, "o", "\u001b[?2004h> "]
[234.39918, "o", "        )\r\n\u001b[?2004l\r\u001b[?2004h>     segments = getattr(result, \"segments\", None)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[234.3993, "o", "    if segments is None and isinstance(result, dict):\r\n\u001b[?2004l\r"]
[234.399329, "o", "\u001b[?2004h> "]
[234.399486, "o", "        segments = result.get(\"segments\")\r\n\u001b[?2004l\r"]
[234.399513, "o", "\u001b[?2004h> "]
[234.399618, "o", "    if not segments:\r\n\u001b[?2004l\r\u001b[?2004h"]
[234.39967, "o", "> "]
[234.399747, "o", "        raise RuntimeError(\r\n\u001b[?2004l\r"]
[234.399809, "o", "\u001b[?2004h> "]
[234.400017, "o", "            \"Split job completed but returned no segments.\"\r\n\u001b[?2004l\r\u001b[?2004h"]
[234.400071, "o", ">         )\r\n"]
[234.400119, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[234.400315, "o", "    return [_segment_to_dict(s) for s in segments]\r\n\u001b[?2004l\r\u001b[?2004h"]
[234.400364, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[234.400394, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[234.400565, "o", "def run(args: argparse.Namespace) -> int:\r\n\u001b[?2004l\r"]
[234.400601, "o", "\u001b[?2004h> "]
[234.400729, "o", "    if not os.path.isfile(args.pdf):\r\n\u001b[?2004l\r"]
[234.40076, "o", "\u001b[?2004h> "]
[234.40101, "o", "        print(f\"Error: PDF file not found: {args.pdf}\", file=sys.stderr)\r\n\u001b[?2004l\r"]
[234.401049, "o", "\u001b[?2004h> "]
[234.401146, "o", "        return 2\r\n\u001b[?2004l\r\u001b[?2004h> "]
[234.401317, "o", "    if \"LLAMA_CLOUD_API_KEY\" not in os.environ:\r\n\u001b[?2004l\r"]
[234.401351, "o", "\u001b[?2004h> "]
[234.401542, "o", "        print(\r\n\u001b[?2004l\r\u001b[?2004h> "]
[234.40172, "o", "            \"Error: LLAMA_CLOUD_API_KEY environment variable is not set.\",\r\n\u001b[?2004l\r"]
[234.401748, "o", "\u001b[?2004h> "]
[234.401867, "o", "            file=sys.stderr,\r\n\u001b[?2004l\r"]
[234.401913, "o", "\u001b[?2004h> "]
[234.401937, "o", "        )\r\n\u001b[?2004l\r"]
[234.402, "o", "\u001b[?2004h> "]
[234.402047, "o", "        return 2\r\n\u001b[?2004l\r"]
[234.402096, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[234.402127, "o", "> "]
[234.402292, "o", "    categories = load_categories(args.config)\r\n\u001b[?2004l\r\u001b[?2004h"]
[234.402341, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[234.40244, "o", "    client = LlamaCloud()\r\n\u001b[?2004l\r"]
[234.402485, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[234.402525, "o", "> "]
[234.402688, "o", "    # 1. Upload the PDF with the 'split' purpose.\r\n\u001b[?2004l\r"]
[234.402737, "o", "\u001b[?2004h> "]
[234.402861, "o", "    with open(args.pdf, \"rb\") as fh:\r\n\u001b[?2004l\r"]
[234.402887, "o", "\u001b[?2004h> "]
[234.403114, "o", "        uploaded = client.files.create(file=fh, purpose=\"split\")\r\n\u001b[?2004l\r"]
[234.403169, "o", "\u001b[?2004h> "]
[234.403245, "o", "    file_id = uploaded.id\r\n\u001b[?2004l\r"]
[234.403283, "o", "\u001b[?2004h"]
[234.403311, "o", "> "]
[234.403527, "o", "    print(f\"Uploaded PDF as file id: {file_id}\", file=sys.stderr)\r\n\u001b[?2004l\r"]
[234.40355, "o", "\u001b[?2004h> "]
[234.403607, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[234.403793, "o", "    # 2. Run the split job, blocking until completion.\r\n\u001b[?2004l\r"]
[234.403815, "o", "\u001b[?2004h> "]
[234.403968, "o", "    response = client.beta.split.split(\r\n\u001b[?2004l\r"]
[234.404019, "o", "\u001b[?2004h> "]
[234.404115, "o", "        categories=categories,\r\n\u001b[?2004l\r"]
[234.404154, "o", "\u001b[?2004h> "]
[234.404375, "o", "        document_input={\"type\": \"file_id\", \"value\": file_id},\r\n\u001b[?2004l\r"]
[234.404404, "o", "\u001b[?2004h> "]
[234.404493, "o", "    )\r\n\u001b[?2004l\r"]
[234.404519, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[234.404655, "o", "    # 3. Extract the segment list and persist it.\r\n\u001b[?2004l\r"]
[234.404677, "o", "\u001b[?2004h> "]
[234.404829, "o", "    segments = extract_segments(response)\r\n\u001b[?2004l\r"]
[234.404855, "o", "\u001b[?2004h> "]
[234.404974, "o", "    output = {\"segments\": segments}\r\n\u001b[?2004l\r"]
[234.404999, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[234.405049, "o", "\u001b[?2004h> "]
[234.405141, "o", "    output_path = args.output\r\n\u001b[?2004l\r"]
[234.405174, "o", "\u001b[?2004h"]
[234.405204, "o", "> "]
[234.405356, "o", "    out_dir = os.path.dirname(os.path.abspath(output_path))\r\n\u001b[?2004l\r"]
[234.405386, "o", "\u001b[?2004h> "]
[234.405445, "o", "    if out_dir:\r\n\u001b[?2004l\r\u001b[?2004h"]
[234.405472, "o", "> "]
[234.405606, "o", "        os.makedirs(out_dir, exist_ok=True)\r\n\u001b[?2004l\r"]
[234.405648, "o", "\u001b[?2004h> "]
[234.40581, "o", "    with open(output_path, \"w\", encoding=\"utf-8\") as fh:\r\n\u001b[?2004l\r"]
[234.405835, "o", "\u001b[?2004h> "]
[234.406029, "o", "        json.dump(output, fh, indent=2, ensure_ascii=False)\r\n\u001b[?2004l\r"]
[234.406054, "o", "\u001b[?2004h> "]
[234.406158, "o", "        fh.write(\"\\n\")\r\n\u001b[?2004l\r"]
[234.406193, "o", "\u001b[?2004h> "]
[234.406454, "o", "    print(f\"Wrote {len(segments)} segments to {output_path}\", file=sys.stderr)\r\n\u001b[?2004l\r"]
[234.406497, "o", "\u001b[?2004h> "]
[234.406557, "o", "    return 0\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[234.406583, "o", "\u001b[?2004h> "]
[234.406609, "o", "\r\n\u001b[?2004l\r\u001b[?2004h"]
[234.406666, "o", "> "]
[234.406782, "o", "def main(argv: List[str] | None = None) -> int:\r\n\u001b[?2004l\r"]
[234.406808, "o", "\u001b[?2004h> "]
[234.406861, "o", "    try:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[234.406974, "o", "        args = parse_args(argv)\r\n\u001b[?2004l\r"]
[234.406995, "o", "\u001b[?2004h> "]
[234.407102, "o", "    except SystemExit as exc:\r\n\u001b[?2004l\r"]
[234.407128, "o", "\u001b[?2004h> "]
[234.421337, "o", "        return int(exc.code) if isinstance(exc.code, int) else 2\r\n\u001b[?2004l\r\u001b[?2004h>     try:\r\n\u001b[?2004l\r\u001b[?2004h>         return run(args)\r\n\u001b[?2004l\r\u001b[?2004h>     except FileNotFoundError as exc:\r\n\u001b[?2004l\r\u001b[?2004h>         print(f\"Error: {exc}\", file=sys.stderr)\r\n\u001b[?2004l\r\u001b[?2004h>         return 2\r\n\u001b[?2004l\r\u001b[?2004h>     except ValueError as exc:\r\n\u001b[?2004l\r\u001b[?2004h>         print(f\"Error: {exc}\", file=sys.stderr)\r\n\u001b[?2004l\r\u001b[?2004h>         return 2\r\n\u001b[?2004l\r\u001b[?2004h>     except Exception as exc:  # noqa: BLE001\r\n\u001b[?2004l\r\u001b[?2004h>         print(f\"Error: {exc}\", file=sys.stderr)\r\n\u001b[?2004l\r\u001b[?2004h>         return 1\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> if __name__ == \"__main__\":\r\n\u001b[?2004l\r\u001b[?2004h>     raise SystemExit(main())\r\n\u001b[?2004l\r\u001b[?2004h> PYEOF\r\n\u001b[?2004l\r"]
[234.421437, "o", "\u001b[?2004h"]
[234.421497, "o", "root@3608678c-8c4d-4bd6-bf57-ac997c16140c:/home/user/myproject# "]
[234.761747, "i", "ls -la run.py\n"]
[234.762467, "o", "ls -la run.py\r\n\u001b[?2004l\r"]
[234.763988, "o", "-rw-r--r-- 1 root root 5929 Jul  3 13:42 run.py\r\n"]
[234.764218, "o", "\u001b[?2004hroot@3608678c-8c4d-4bd6-bf57-ac997c16140c:/home/user/myproject# "]
[240.668101, "i", "python3 run.py --help\n"]
[240.668348, "o", "python3 run.py --help\r\n\u001b[?2004l\r"]
[240.985978, "o", "usage: run.py [-h] --pdf PDF --config CONFIG --output OUTPUT\r\n\r\nSplit a concatenated PDF into logical segments with LlamaCloud's beta Split API.\r\n\r\noptions:\r\n  -h, --help       show this help message and exit\r\n  --pdf PDF        Path to the input PDF file.\r\n  --config CONFIG  Path to the categories configuration JSON file.\r\n  --output OUTPUT  Path to the file where the segment result JSON will be written.\r\n"]
[241.02901, "o", "\u001b[?2004hroot@3608678c-8c4d-4bd6-bf57-ac997c16140c:/home/user/myproject# "]
