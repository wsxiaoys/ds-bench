[?2004l[?2004h> extends Node
[?2004l[?2004h> class_name DungeonGenerator
[?2004l[?2004h> 
[?2004l[?2004h> @export var seed_value: int = 12345
[?2004l[?2004h> @export var width: int = 64
[?2004l[?2004h> @export var height: int = 64
[?2004l[?2004h> @export var wall_threshold: float = 0.0
[?2004l[?2004h> 
[?2004l[?2004h> # Backwards compat: keep `seed` as an alias of `seed_value`
[?2004l[?2004h> # (the spec uses `seed`, but `seed` is a reserved property name on Node, so
[?2004l[?2004h> #  we expose it under the name `seed_value` and additionally provide a `seed`
[?2004l[?2004h> #  property via a setter/getter.)
[?2004l[?2004h> var seed: int:
[?2004l[?2004h>     set(value):
[?2004l[?2004h>         seed_value = value
[?2004l[?2004h>     get:
[?2004l[?2004h>         return seed_value
[?2004l[?2004h> 
[?2004l[?2004h> var _rooms: Array[Rect2i] = []
[?2004l[?2004h> 
[?2004l[?2004h> func generate(target: TileMapLayer) -> void:
[?2004l[?2004h>     _rooms.clear()
[?2004l[?2004h>     if target == null:
[?2004l[?2004h>         return
[?2004l[?2004h>     target.clear()
[?2004l[?2004h> 
[?2004l[?2004h>     # 1. Noise pass
[?2004l[?2004h>     var noise := FastNoiseLite.new()
[?2004l[?2004h>     noise.seed = seed_value
[?2004l[?2004h>     noise.noise_type = FastNoiseLite.TYPE_PERLIN
[?2004l[?2004h>     noise.frequency = 0.1
[?2004l[?2004h> 
[?2004l[?2004h>     for y in range(height):
[?2004l[?2004h>         for x in range(width):
[?2004l[?2004h>             var n: float = noise.get_noise_2d(x, y)
[?2004l[?2004h>             # n is in [-1, 1]; wall_threshold default 0.0 -> n >= 0 is floor
[?2004l[?2004h>             if n >= wall_threshold:
[?2004l[?2004h>                 target.set_cell(Vector2i(x, y), 0, Vector2i(0, 0))
[?2004l[?2004h>             else:
[?2004l[?2004h>                 target.set_cell(Vector2i(x, y), 1, Vector2i(1, 0))
[?2004l[?2004h> 
[?2004l[?2004h>     # 2. Force outer edge to wall (source_id 1)
[?2004l[?2004h>     for x in range(width):
[?2004l[?2004h>         target.set_cell(Vector2i(x, 0), 1, Vector2i(1, 0))
[?2004l[?2004h>         target.set_cell(Vector2i(x, height - 1), 1, Vector2i(1, 0))
[?2004l[?2004h>     for y in range(height):
[?2004l[?2004h>         target.set_cell(Vector2i(0, y), 1, Vector2i(1, 0))
[?2004l[?2004h>         target.set_cell(Vector2i(width - 1, y), 1, Vector2i(1, 0))
[?2004l[?2004h> 
[?2004l[?2004h>     # 3. Carve rooms deterministically using a separate RNG seeded from seed_value
[?2004l[?2004h>     var rng := RandomNumberGenerator.new()
[?2004l[?2004h>     rng.seed = seed_value
[?2004l[?2004h> 
[?2004l[?2004h>     var room_count: int = 4
[?2004l[?2004h>     var max_attempts: int = 64
[?2004l[?2004h>     var attempts: int = 0
[?2004l[?2004h>     var min_size: int = 4
[?2004l[?2004h>     var max_size: int = 8
[?2004l[?2004h> 
[?2004l[?2004h>     while _rooms.size() < room_count and attempts < max_attempts:
[?2004l[?2004h>         attempts += 1
[?2004l[?2004h>         var rw: int = rng.randi_range(min_size, max_size)
[?2004l[?2004h>         var rh: int = rng.randi_range(min_size, max_size)
[?2004l[?2004h>         var rx: int = rng.randi_range(1, width - 2 - rw)
[?2004l[?2004h>         var ry: int = rng.randi_range(1, height - 2 - rh)
[?2004l[?2004h>         var rect := Rect2i(rx, ry, rw, rh)
[?2004l[?2004h>         var ok: bool = true
[?2004l[?2004h>         for r in _rooms:
[?2004l[?2004h>             if r.intersects(rect):
[?2004l[?2004h>                 ok = false
[?2004l[?2004h>                 break
[?2004l[?2004h>         if not ok:
[?2004l[?2004h>             continue
[?2004l[?2004h>         _rooms.append(rect)
[?2004l[?2004h>         # Carve the room (write floor)
[?2004l[?2004h>         for y in range(ry, ry + rh):
[?2004l[?2004h>             for x in range(rx, rx + rw):
[?2004l[?2004h>                 target.set_cell(Vector2i(x, y), 0, Vector2i(0, 0))
[?2004l[?2004h> 
[?2004l[?2004h>     # 4. Connect rooms with L-shaped corridors
[?2004l[?2004h>     for i in range(1, _rooms.size()):
[?2004l[?2004h>         var prev: Rect2i = _rooms[i - 1]
[?2004l[?2004h>         var cur: Rect2i = _rooms[i]
[?2004l[?2004h>         var p_center: Vector2i = Vector2i(prev.position.x + prev.size.x / 2, prev.position.y + prev.size.y / 2)
[?2004l[?2004h>         var c_center: Vector2i = Vector2i(cur.position.x + cur.size.x / 2, cur.position.y + cur.size.y / 2)
[?2004l[?2004h>         # L-shape: horizontal then vertical (deterministic)
[?2004l[?2004h>         var step_x: int = 1 if c_center.x >= p_center.x else -1
[?2004l[?2004h>         var step_y: int = 1 if c_center.y >= p_center.y else -1
[?2004l[?2004h>         var x0: int = p_center.x
[?2004l[?2004h>         while x0 != c_center.x:
[?2004l[?2004h>             target.set_cell(Vector2i(x0, p_center.y), 0, Vector2i(0, 0))
[?2004l[?2004h>             x0 += step_x
[?2004l[?2004h>         # ensure the endpoint is carved too
[?2004l[?2004h>         target.set_cell(Vector2i(c_center.x, p_center.y), 0, Vector2i(0, 0))
[?2004l[?2004h>         var y0: int = p_center.y
[?2004l[?2004h>         while y0 != c_center.y:
[?2004l[?2004h>             target.set_cell(Vector2i(c_center.x, y0), 0, Vector2i(0, 0))
[?2004l[?2004h>             y0 += step_y
[?2004l[?2004h>         target.set_cell(Vector2i(c_center.x, c_center.y), 0, Vector2i(0, 0))
[?2004l[?2004h> 
[?2004l[?2004h> func count_floor_tiles(target: TileMapLayer) -> int:
[?2004l[?2004h>     var count: int = 0
[?2004l[?2004h>     for y in range(height):
[?2004l[?2004h>         for x in range(width):
[?2004l[?2004h>             if target.get_cell_source_id(Vector2i(x, y)) == 0:
[?2004l[?2004h>                 count += 1
[?2004l[?2004h>     return count
[?2004l[?2004h> 
[?2004l[?2004h> func find_rooms() -> Array[Rect2i]:
[?2004l[?2004h>     return _rooms
[?2004l[?2004h> EOF
