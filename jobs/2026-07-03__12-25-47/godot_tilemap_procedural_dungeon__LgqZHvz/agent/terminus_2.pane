extends Node
class_name DungeonGenerator

@export var seed: int = 12345
@export var width: int = 64
@export var height: int = 64
@export var wall_threshold: float = 0.0

var _rooms: Array[Rect2i] = []

func generate(target: TileMapLayer) -> void:
    _rooms.clear()
    if target == null:
        return
    target.clear()

    # 1. Noise pass
    var noise := FastNoiseLite.new()
    noise.seed = seed
    noise.noise_type = FastNoiseLite.TYPE_PERLIN
    noise.frequency = 0.1

    for y in range(height):
        for x in range(width):
            var n: float = noise.get_noise_2d(x, y)
            # n is in [-1, 1]; wall_threshold default 0.0 -> n >= 0 is floor
            if n >= wall_threshold:
                target.set_cell(Vector2i(x, y), 0, Vector2i(0, 0))
            else:
                target.set_cell(Vector2i(x, y), 1, Vector2i(1, 0))

    # 2. Force outer edge to wall (source_id 1)
    for x in range(width):
        target.set_cell(Vector2i(x, 0), 1, Vector2i(1, 0))
        target.set_cell(Vector2i(x, height - 1), 1, Vector2i(1, 0))
    for y in range(height):
        target.set_cell(Vector2i(0, y), 1, Vector2i(1, 0))
        target.set_cell(Vector2i(width - 1, y), 1, Vector2i(1, 0))

    # 3. Carve rooms deterministically using a separate RNG seeded from seed
    var rng := RandomNumberGenerator.new()
    rng.seed = seed

    var room_count: int = 4
    var max_attempts: int = 64
    var attempts: int = 0
    var min_size: int = 4
    var max_size: int = 8

    while _rooms.size() < room_count and attempts < max_attempts:
        attempts += 1
        var rw: int = rng.randi_range(min_size, max_size)
        var rh: int = rng.randi_range(min_size, max_size)
        var rx: int = rng.randi_range(1, width - 2 - rw)
        var ry: int = rng.randi_range(1, height - 2 - rh)
        var rect := Rect2i(rx, ry, rw, rh)
        var ok: bool = true
        for r in _rooms:
            if r.intersects(rect):
                ok = false
                break
        if not ok:
            continue
        _rooms.append(rect)
        # Carve the room (write floor)
        for y2 in range(ry, ry + rh):
            for x2 in range(rx, rx + rw):
                target.set_cell(Vector2i(x2, y2), 0, Vector2i(0, 0))

    # 4. Connect rooms with L-shaped corridors
    for i in range(1, _rooms.size()):
        var prev: Rect2i = _rooms[i - 1]
        var cur: Rect2i = _rooms[i]
        var p_center: Vector2i = Vector2i(prev.position.x + prev.size.x / 2, prev.position.y + prev.size.y / 2)
        var c_center: Vector2i = Vector2i(cur.position.x + cur.size.x / 2, cur.position.y + cur.size.y / 2)
        # L-shape: horizontal then vertical (deterministic)
        var step_x: int = 1 if c_center.x >= p_center.x else -1
        var step_y: int = 1 if c_center.y >= p_center.y else -1
        var x0: int = p_center.x
        while x0 != c_center.x:
            target.set_cell(Vector2i(x0, p_center.y), 0, Vector2i(0, 0))
            x0 += step_x
        # ensure the endpoint is carved too
        target.set_cell(Vector2i(c_center.x, p_center.y), 0, Vector2i(0, 0))
        var y0: int = p_center.y
        while y0 != c_center.y:
            target.set_cell(Vector2i(c_center.x, y0), 0, Vector2i(0, 0))
            y0 += step_y
        target.set_cell(Vector2i(c_center.x, c_center.y), 0, Vector2i(0, 0))

func count_floor_tiles(target: TileMapLayer) -> int:
    var count: int = 0
    for y in range(height):
        for x in range(width):
            if target.get_cell_source_id(Vector2i(x, y)) == 0:
                count += 1
    return count

func find_rooms() -> Array[Rect2i]:
    return _rooms
