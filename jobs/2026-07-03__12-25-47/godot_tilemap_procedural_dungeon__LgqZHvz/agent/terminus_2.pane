[?2004l[?2004h>     var room_count: int = 4
[?2004l[?2004h>     var max_attempts: int = 64
[?2004l[?2004h>     var attempts: int = 0
[?2004l[?2004h>     var min_size: int = 4
[?2004l[?2004h>     var max_size: int = 8
[?2004l[?2004h> 
[?2004l[?2004h>     while _rooms.size() < room_count and attempts < max_attempts:
[?2004l[?2004h>         attempts += 1
[?2004l[?2004h>         var rw: int = rng.randi_range(min_size, max_size)
[?2004l[?2004h>         var rh: int = rng.randi_range(min_size, max_size)
[?2004l[?2004h>         var rx: int = rng.randi_range(1, width - 2 - rw)
[?2004l[?2004h>         var ry: int = rng.randi_range(1, height - 2 - rh)
[?2004l[?2004h>         var rect := Rect2i(rx, ry, rw, rh)
[?2004l[?2004h>         var ok: bool = true
[?2004l[?2004h>         for r in _rooms:
[?2004l[?2004h>             if r.intersects(rect):
[?2004l[?2004h>                 ok = false
[?2004l[?2004h>                 break
[?2004l[?2004h>         if not ok:
[?2004l[?2004h>             continue
[?2004l[?2004h>         _rooms.append(rect)
[?2004l[?2004h>         # Carve the room (write floor)
[?2004l[?2004h>         for y2 in range(ry, ry + rh):
[?2004l[?2004h>             for x2 in range(rx, rx + rw):
[?2004l[?2004h>                 target.set_cell(Vector2i(x2, y2), 0, Vector2i(0, 0))
[?2004l[?2004h> 
[?2004l[?2004h>     # 4. Connect rooms with L-shaped corridors
[?2004l[?2004h>     for i in range(1, _rooms.size()):
[?2004l[?2004h>         var prev: Rect2i = _rooms[i - 1]
[?2004l[?2004h>         var cur: Rect2i = _rooms[i]
[?2004l[?2004h>         var p_center: Vector2i = Vector2i(prev.position.x + prev.size.x / 2, prev.position.y + prev.size.y / 2)
[?2004l[?2004h>         var c_center: Vector2i = Vector2i(cur.position.x + cur.size.x / 2, cur.position.y + cur.size.y / 2)
[?2004l[?2004h>         # L-shape: horizontal then vertical (deterministic)
[?2004l[?2004h>         var step_x: int = 1 if c_center.x >= p_center.x else -1
[?2004l[?2004h>         var step_y: int = 1 if c_center.y >= p_center.y else -1
[?2004l[?2004h>         var x0: int = p_center.x
[?2004l[?2004h>         while x0 != c_center.x:
[?2004l[?2004h>             target.set_cell(Vector2i(x0, p_center.y), 0, Vector2i(0, 0))
[?2004l[?2004h>             x0 += step_x
[?2004l[?2004h>         # ensure the endpoint is carved too
[?2004l[?2004h>         target.set_cell(Vector2i(c_center.x, p_center.y), 0, Vector2i(0, 0))
[?2004l[?2004h>         var y0: int = p_center.y
[?2004l[?2004h>         while y0 != c_center.y:
[?2004l[?2004h>             target.set_cell(Vector2i(c_center.x, y0), 0, Vector2i(0, 0))
[?2004l[?2004h>             y0 += step_y
[?2004l[?2004h>         target.set_cell(Vector2i(c_center.x, c_center.y), 0, Vector2i(0, 0))
