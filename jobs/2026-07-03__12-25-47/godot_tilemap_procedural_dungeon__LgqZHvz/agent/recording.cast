[439.636958, "i", "echo '=== project.godot ==='; cat /home/user/myproject/project.godot\necho '=== DungeonGenerator.gd ==='; cat /home/user/myproject/scripts/DungeonGenerator.gd\necho '=== Main.gd ==='; cat /home/user/myproject/scenes/Main.gd\necho '=== Main.tscn ==='; cat /home/user/myproject/scenes/Main.tscn\necho '=== dungeon.tres ==='; cat /home/user/myproject/tilesets/dungeon.tres\n"]
