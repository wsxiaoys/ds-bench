[404.14812, "i", "cat > /tmp/seed_test.gd << 'EOF'\n@tool\nextends SceneTree\n\nfunc _init():\n    var packed := load(\"res://scenes/Main.tscn\") as PackedScene\n    var main := packed.instantiate()\n    get_root().add_child(main)\n    \n    var tilemap = main.get_node(\"TileMapLayer\")\n    var gen = main.get_node(\"DungeonGenerator\")\n    \n    await process_frame\n    \n    # Test 1: regenerate with same seed, should be identical\n    gen.seed = 12345\n    gen.generate(tilemap)\n    var d1 = capture_data(gen, tilemap)\n    var r1 = gen.find_rooms()\n    \n    gen.seed = 12345\n    gen.generate(tilemap)\n    var d2 = capture_data(gen, tilemap)\n    var r2 = gen.find_rooms()\n    \n    var diff_same = compare(d1, d2)\n    print(\"Same seed determinism (should be 0 diffs): \", diff_same)\n    var rooms_same = r1.size() == r2.size()\n    if rooms_same:\n        for i in range(r1.size()):\n            if r1[i] != r2[i]:\n                rooms_same = false\n                break\n    print(\"Same seed rooms identical: \", rooms_same)\n    \n    # Test 2: regenerate with different seed, should differ\n    gen.seed = 12345\n    gen.generate(tilemap)\n    var d3 = capture_data(gen, tilemap)\n    \n    gen.seed = 99\n    gen.generate(tilemap)\n    var d4 = capture_data(gen, tilemap)\n    \n    var diff_diff = compare(d3, d4)\n    print(\"Different seed (should be > 0 diffs): \", diff_diff)\n    \n    quit(0)\n\nfunc capture_data(gen, tilemap):\n    var data = []\n    for y in range(gen.height):\n        var row = []\n        for x in range(gen.width):\n            row.append(tilemap.get_cell_source_id(Vector2i(x, y)))\n        data.append(row)\n    return data\n\nfunc compare(a, b):\n    var diffs = 0\n    for y in range(a.size()):\n        for x in range(a[0].size()):\n            if a[y][x] != b[y][x]:\n                diffs += 1\n    return diffs\nEOF\ncd /home/user/myproject && godot --headless --script /tmp/seed_test.gd 2>&1 | tail -10\n"]
