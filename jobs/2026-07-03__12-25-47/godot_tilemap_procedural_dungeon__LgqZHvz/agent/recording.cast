[58.069646, "i", "cat > /tmp/gen_png.py << 'EOF'\nfrom PIL import Image\n\nimg = Image.new('RGBA', (48, 16), (0, 0, 0, 0))\n# Floor (tile 0) - brown\nfor y in range(16):\n    for x in range(16):\n        img.putpixel((x, y), (139, 90, 43, 255))\n# Wall (tile 1) - gray\nfor y in range(16):\n    for x in range(16):\n        img.putpixel((16 + x, y), (128, 128, 128, 255))\n# Door (tile 2) - red\nfor y in range(16):\n    for x in range(16):\n        img.putpixel((32 + x, y), (180, 30, 30, 255))\n\nimg.save('/home/user/myproject/tilesets/dungeon_tiles.png')\nprint('PNG saved')\nEOF\npython3 /tmp/gen_png.py\nls -la /home/user/myproject/tilesets/\n"]
