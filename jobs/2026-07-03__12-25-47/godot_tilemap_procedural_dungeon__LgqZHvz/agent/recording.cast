[155.823654, "o", "            target.set_cell(Vector2i(c_center.x, y0), 0, Vector2i(0, 0))\r\n\u001b[?2004l\r"]
[155.82369, "o", "\u001b[?2004h> "]
[155.823756, "o", "            y0 += step_y\r\n\u001b[?2004l\r"]
[155.823779, "o", "\u001b[?2004h> "]
[155.823986, "o", "        target.set_cell(Vector2i(c_center.x, c_center.y), 0, Vector2i(0, 0))\r\n\u001b[?2004l\r"]
[155.82401, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[155.824035, "o", "\u001b[?2004h> "]
[155.824184, "o", "func count_floor_tiles(target: TileMapLayer) -> int:\r\n\u001b[?2004l\r"]
[155.824219, "o", "\u001b[?2004h> "]
[155.824282, "o", "    var count: int = 0\r\n\u001b[?2004l\r"]
[155.824305, "o", "\u001b[?2004h> "]
[155.824395, "o", "    for y in range(height):\r\n\u001b[?2004l\r"]
[155.824419, "o", "\u001b[?2004h> "]
[155.82451, "o", "        for x in range(width):\r\n\u001b[?2004l\r"]
[155.824546, "o", "\u001b[?2004h> "]
[155.824706, "o", "            if target.get_cell_source_id(Vector2i(x, y)) == 0:\r\n\u001b[?2004l\r"]
[155.82473, "o", "\u001b[?2004h> "]
[155.824814, "o", "                count += 1\r\n\u001b[?2004l\r"]
[155.824838, "o", "\u001b[?2004h> "]
[155.824884, "o", "    return count\r\n\u001b[?2004l\r"]
[155.824908, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[155.824952, "o", "\u001b[?2004h> "]
[155.82505, "o", "func find_rooms() -> Array[Rect2i]:\r\n\u001b[?2004l\r"]
[155.825074, "o", "\u001b[?2004h> "]
[155.825125, "o", "    return _rooms\r\n\u001b[?2004l\r"]
[155.825161, "o", "\u001b[?2004h> EOF\r\n\u001b[?2004l\r"]
