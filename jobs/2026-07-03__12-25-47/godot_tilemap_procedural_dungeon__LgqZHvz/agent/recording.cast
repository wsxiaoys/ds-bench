[242.026898, "i", "cat > /tmp/verify.gd << 'EOF'\n@tool\nextends SceneTree\n\nfunc _init():\n    var packed := load(\"res://scenes/Main.tscn\") as PackedScene\n    if packed == null:\n        print(\"FAIL: Could not load Main.tscn\")\n        quit(1)\n        return\n    var main := packed.instantiate()\n    get_root().add_child(main)\n    \n    var tilemap = main.get_node(\"TileMapLayer\")\n    var gen = main.get_node(\"DungeonGenerator\")\n    \n    if tilemap == null or gen == null:\n        print(\"FAIL: Missing nodes\")\n        quit(1)\n        return\n    \n    print(\"Tilemap: \", tilemap)\n    print(\"Generator: \", gen)\n    print(\"Generator seed: \", gen.seed)\n    print(\"Generator width: \", gen.width)\n    print(\"Generator height: \", gen.height)\n    print(\"Generator wall_threshold: \", gen.wall_threshold)\n    \n    # Wait for _ready to fire (it was added to tree)\n    await process_frame\n    \n    # Verify generate was called\n    var floor_count = gen.count_floor_tiles(tilemap)\n    print(\"Floor count: \", floor_count)\n    \n    var rooms = gen.find_rooms()\n    print(\"Number of rooms: \", rooms.size())\n    for r in rooms:\n        print(\"  Room: \", r)\n    \n    # Verify edge cells are walls\n    var edge_failures = 0\n    for x in range(gen.width):\n        if tilemap.get_cell_source_id(Vector2i(x, 0)) != 1:\n            edge_failures += 1\n        if tilemap.get_cell_source_id(Vector2i(x, gen.height - 1)) != 1:\n            edge_failures += 1\n    for y in range(gen.height):\n        if tilemap.get_cell_source_id(Vector2i(0, y)) != 1:\n            edge_failures += 1\n        if tilemap.get_cell_source_id(Vector2i(gen.width - 1, y)) != 1:\n            edge_failures += 1\n    print(\"Edge wall failures: \", edge_failures)\n    \n    # Verify determinism\n    var first_data = []\n    for y in range(gen.height):\n        var row = []\n        for x in range(gen.width):\n            row.append(tilemap.get_cell_source_id(Vector2i(x, y)))\n        first_data.append(row)\n    \n    gen.generate(tilemap)\n    var diff_count = 0\n    for y in range(gen.height):\n        for x in range(gen.width):\n            if tilemap.get_cell_source_id(Vector2i(x, y)) != first_data[y][x]:\n                diff_count += 1\n    print(\"Diff count (should be 0): \", diff_count)\n    \n    # Test with different seed\n    gen.seed = 99\n    var seed99_data = []\n    for y in range(gen.height):\n        var row = []\n        for x in range(gen.width):\n            row.append(tilemap.get_cell_source_id(Vector2i(x, y)))\n        seed99_data.append(row)\n    \n    gen.seed = 12345\n    gen.generate(tilemap)\n    var seed_diffs = 0\n    for y in range(gen.height):\n        for x in range(gen.width):\n            if seed99_data[y][x] != tilemap.get_cell_source_id(Vector2i(x, y)):\n                seed_diffs += 1\n    print(\"Seed 99 vs 12345 diffs (should be > 0): \", seed_diffs)\n    \n    # Test rooms sum\n    var total_area = 0\n    for r in rooms:\n        total_area += r.size.x * r.size.y\n    print(\"Sum of room areas: \", total_area, \" (floor_count=\", floor_count, \")\")\n    \n    quit(0)\nEOF\ncd /home/user/myproject && godot --headless --script /tmp/verify.gd 2>&1 | tail -50\n"]
