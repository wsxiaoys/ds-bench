[71.038192, "i", "cat > /tmp/bootstrap.gd << 'EOF'\n@tool\nextends SceneTree\n\nfunc _init():\n    # Create TileSet\n    var ts := TileSet.new()\n    ts.tile_size = Vector2i(16, 16)\n    \n    var source := TileSetAtlasSource.new()\n    source.texture = load(\"res://tilesets/dungeon_tiles.png\")\n    source.texture_region_size = Vector2i(16, 16)\n    \n    # Tile 0: floor at (0,0)\n    source.create_tile(Vector2i(0, 0))\n    # Tile 1: wall at (1,0)\n    source.create_tile(Vector2i(1, 0))\n    # Tile 2: door at (2,0)\n    source.create_tile(Vector2i(2, 0))\n    \n    ts.add_source(source)\n    \n    var err := ResourceSaver.save(ts, \"res://tilesets/dungeon.tres\")\n    print(\"TileSet save err: \", err)\n    \n    quit()\nEOF\ncd /home/user/myproject && godot --headless --script /tmp/bootstrap.gd 2>&1 | tail -30\n"]
