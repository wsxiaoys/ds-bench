[259.492525, "i", "cat > /tmp/verify2.gd << 'EOF'\n@tool\nextends SceneTree\n\nfunc _init():\n    var packed := load(\"res://scenes/Main.tscn\") as PackedScene\n    var main := packed.instantiate()\n    get_root().add_child(main)\n    \n    var tilemap = main.get_node(\"TileMapLayer\")\n    var gen = main.get_node(\"DungeonGenerator\")\n    \n    await process_frame\n    \n    # Capture data with seed 12345 (already generated by _ready)\n    gen.seed = 12345\n    gen.generate(tilemap)\n    var data12345 = []\n    for y in range(gen.height):\n        var row = []\n        for x in range(gen.width):\n            row.append(tilemap.get_cell_source_id(Vector2i(x, y)))\n        data12345.append(row)\n    var rooms12345 = gen.find_rooms()\n    \n    # Capture data with seed 99\n    gen.seed = 99\n    gen.generate(tilemap)\n    var data99 = []\n    for y in range(gen.height):\n        var row = []\n        for x in range(gen.width):\n            row.append(tilemap.get_cell_source_id(Vector2i(x, y)))\n        data99.append(row)\n    var rooms99 = gen.find_rooms()\n    \n    var diffs = 0\n    for y in range(gen.height):\n        for x in range(gen.width):\n            if data12345[y][x] != data99[y][x]:\n                diffs += 1\n    print(\"12345 vs 99 diffs: \", diffs)\n    print(\"Rooms 12345: \", rooms12345.size())\n    print(\"Rooms 99: \", rooms99.size())\n    for r in rooms12345:\n        print(\"  12345 room: \", r)\n    for r in rooms99:\n        print(\"  99 room: \", r)\n    \n    quit(0)\nEOF\ncd /home/user/myproject && godot --headless --script /tmp/verify2.gd 2>&1 | tail -30\n"]
