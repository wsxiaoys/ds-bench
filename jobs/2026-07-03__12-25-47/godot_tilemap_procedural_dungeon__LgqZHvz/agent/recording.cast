[439.642723, "o", "=== dungeon.tres ===\r\n"]
[439.643506, "o", "[gd_resource type=\"TileSet\" load_steps=3 format=3]\r\n\r\n[ext_resource type=\"Texture2D\" path=\"res://tilesets/dungeon_tiles.png\" id=\"1_q63t8\"]\r\n\r\n[sub_resource type=\"TileSetAtlasSource\" id=\"TileSetAtlasSource_3p7ks\"]\r\ntexture = ExtResource(\"1_q63t8\")\r\n0:0/0 = 0\r\n1:0/0 = 0\r\n2:0/0 = 0\r\n\r\n[resource]\r\nsources/0 = SubResource(\"TileSetAtlasSource_3p7ks\")\r\n"]
[439.643664, "o", "\u001b[?2004hroot@824614b0-6997-41e4-91dd-c059dc123854:/home/user/myproject# "]
[473.589928, "i", "cat > /tmp/final_test.gd << 'EOF'\n@tool\nextends SceneTree\n\nfunc _init():\n    # Test 1: Load scene like a harness would\n    var packed := load(\"res://scenes/Main.tscn\") as PackedScene\n    var main := packed.instantiate()\n    get_root().add_child(main)\n    await process_frame\n    \n    var tilemap = main.get_node(\"TileMapLayer\")\n    var gen = main.get_node(\"DungeonGenerator\")\n    \n    # Test 2: Verify API surface\n    assert(gen.has_method(\"generate\"))\n    assert(gen.has_method(\"count_floor_tiles\"))\n    assert(gen.has_method(\"find_rooms\"))\n    assert(\"seed\" in gen)\n    assert(\"width\" in gen)\n    assert(\"height\" in gen)\n    assert(\"wall_threshold\" in gen)\n    print(\"Test 2: API surface OK\")\n    \n    # Test 3: Default values\n    # Note: scene sets these so they're not default after loading\n    # But we can test via fresh instance\n    var fresh_script = load(\"res://scripts/DungeonGenerator.gd\")\n    var fresh = fresh_script.new()\n    assert(fresh.seed == 12345)\n    assert(fresh.width == 64)\n    assert(fresh.height == 64)\n    assert(fresh.wall_threshold == 0.0)\n    print(\"Test 3: Default values OK\")\n    \n    # Test 4: Generate on a fresh TileMapLayer (verifier-style)\n    var fresh_tilemap := TileMapLayer.new()\n    fresh_tilemap.tile_set = load(\"res://tilesets/dungeon.tres\")\n    fresh.generate(fresh_tilemap)\n    \n    var rooms = fresh.find_rooms()\n    print(\"Test 4: Fresh generate OK, rooms: \", rooms.size())\n    assert(rooms.size() >= 3, \"Must have at least 3 rooms\")\n    \n    var floor_count = fresh.count_floor_tiles(fresh_tilemap)\n    var sum_rooms = 0\n    for r in rooms:\n        sum_rooms += r.size.x * r.size.y\n    print(\"Test 4: floor_count=\", floor_count, \", sum_rooms=\", sum_rooms)\n    assert(floor_count >= sum_rooms, \"Floor count must be >= sum of room areas\")\n    \n    # Test 5: Edge cells are walls\n    for x in range(fresh.width):\n        assert(fresh_tilemap.get_cell_source_id(Vector2i(x, 0)) == 1)\n        assert(fresh_tilemap.get_cell_source_id(Vector2i(x, fresh.height - 1)) == 1)\n    for y in range(fresh.height):\n        assert(fresh_tilemap.get_cell_source_id(Vector2i(0, y)) == 1)\n        assert(fresh_tilemap.get_cell_source_id(Vector2i(fresh.width - 1, y)) == 1)\n    print(\"Test 5: Edge cells are walls OK\")\n    \n    # Test 6: Determinism - same seed -> same data\n    var fresh2_script = load(\"res://scripts/DungeonGenerator.gd\")\n    var fresh2 = fresh2_script.new()\n    var fresh2_tilemap := TileMapLayer.new()\n    fresh2_tilemap.tile_set = load(\"res://tilesets/dungeon.tres\")\n    fresh2.generate(fresh2_tilemap)\n    \n    var diffs = 0\n    for y in range(fresh.height):\n        for x in range(fresh.width):\n            if fresh_tilemap.get_cell_source_id(Vector2i(x, y)) != fresh2_tilemap.get_cell_source_id(Vector2i(x, y)):\n                diffs += 1\n    print(\"Test 6: Determinism diffs: \", diffs)\n    assert(diffs == 0, \"Same seed must produce same data\")\n    \n    # Test 7: Different seed -> different data\n    fresh.seed = 99\n    fresh.generate(fresh_tilemap)\n    var diffs2 = 0\n    for y in range(fresh.height):\n        for x in range(fresh.width):\n            if fresh_tilemap.get_cell_source_id(Vector2i(x, y)) != fresh2_tilemap.get_cell_source_id(Vector2i(x, y)):\n                diffs2 += 1\n    print(\"Test 7: Different seed diffs: \", diffs2)\n    assert(diffs2 > 0, \"Different seed must produce different data\")\n    \n    # Test 8: Room properties\n    for r in rooms:\n        assert(r.position.x >= 1)\n        assert(r.position.y >= 1)\n        assert(r.position.x + r.size.x <= fresh.width - 1)\n        assert(r.position.y + r.size.y <= fresh.height - 1)\n    print(\"Test 8: Rooms inside interior OK\")\n    \n    for i in range(rooms.size()):\n        for j in range(i + 1, rooms.size()):\n            assert(not rooms[i].intersects(rooms[j]), \"Rooms must not overlap\")\n    print(\"Test 8: Rooms non-overlapping OK\")\n    \n    print(\"ALL TESTS PASSED\")\n    quit(0)\nEOF\ncd /home/user/myproject && godot --headless --script /tmp/final_test.gd 2>&1 | tail -25\n"]
