[381.557263, "i", "cat > /tmp/final_verify.gd << 'EOF'\n@tool\nextends SceneTree\n\nfunc _init():\n    # Verify TileSet can be loaded\n    var ts := load(\"res://tilesets/dungeon.tres\") as TileSet\n    if ts == null:\n        print(\"FAIL: Cannot load TileSet\")\n        quit(1)\n        return\n    print(\"TileSet loaded: \", ts)\n    print(\"Number of sources: \", ts.get_source_count())\n    var src0 = ts.get_source(0)\n    if src0:\n        print(\"Source 0: \", src0)\n        print(\"Source 0 tile count: \", src0.get_tiles_count())\n    \n    # Load scene and instantiate\n    var packed := load(\"res://scenes/Main.tscn\") as PackedScene\n    if packed == null:\n        print(\"FAIL: Cannot load Main.tscn\")\n        quit(1)\n        return\n    var main := packed.instantiate()\n    get_root().add_child(main)\n    \n    var tilemap = main.get_node(\"TileMapLayer\")\n    var gen = main.get_node(\"DungeonGenerator\")\n    \n    await process_frame\n    \n    # Verify all required export properties\n    var props_ok = true\n    for prop in [\"seed\", \"width\", \"height\", \"wall_threshold\"]:\n        var has = (prop in gen)\n        print(\"Has property \", prop, \": \", has)\n        if not has:\n            props_ok = false\n    print(\"All required properties exist: \", props_ok)\n    \n    # Verify methods\n    var methods_ok = true\n    for method in [\"generate\", \"count_floor_tiles\", \"find_rooms\"]:\n        var has = gen.has_method(method)\n        print(\"Has method \", method, \": \", has)\n        if not has:\n            methods_ok = false\n    print(\"All required methods exist: \", methods_ok)\n    \n    # Verify the TileMapLayer has the TileSet\n    if tilemap.tile_set == null:\n        print(\"FAIL: TileMapLayer has no TileSet\")\n        quit(1)\n        return\n    print(\"TileMapLayer has TileSet: OK\")\n    \n    # Verify _ready triggered generate\n    var rooms = gen.find_rooms()\n    print(\"Rooms found: \", rooms.size())\n    if rooms.size() < 3:\n        print(\"FAIL: Less than 3 rooms\")\n        quit(1)\n        return\n    \n    # Verify rooms are non-overlapping and inside interior\n    var interior_ok = true\n    var overlap_ok = true\n    for i in range(rooms.size()):\n        var r: Rect2i = rooms[i]\n        # Check interior\n        if r.position.x < 1 or r.position.y < 1:\n            print(\"FAIL: Room \", i, \" touches boundary: \", r)\n            interior_ok = false\n        if r.position.x + r.size.x > gen.width - 1:\n            print(\"FAIL: Room \", i, \" extends past right boundary: \", r)\n            interior_ok = false\n        if r.position.y + r.size.y > gen.height - 1:\n            print(\"FAIL: Room \", i, \" extends past bottom boundary: \", r)\n            interior_ok = false\n        # Check overlap\n        for j in range(i + 1, rooms.size()):\n            if r.intersects(rooms[j]):\n                print(\"FAIL: Room \", i, \" overlaps room \", j)\n                overlap_ok = false\n    print(\"Rooms are interior: \", interior_ok)\n    print(\"Rooms are non-overlapping: \", overlap_ok)\n    \n    # Verify floor count >= sum of room areas\n    var sum_rooms = 0\n    for r in rooms:\n        sum_rooms += r.size.x * r.size.y\n    var floor_count = gen.count_floor_tiles(tilemap)\n    print(\"Floor count: \", floor_count, \", Sum room areas: \", sum_rooms)\n    print(\"Floor count >= sum room areas: \", floor_count >= sum_rooms)\n    \n    # Verify edge cells are walls\n    var edge_ok = true\n    for x in range(gen.width):\n        if tilemap.get_cell_source_id(Vector2i(x, 0)) != 1 or tilemap.get_cell_source_id(Vector2i(x, gen.height - 1)) != 1:\n            edge_ok = false\n    for y in range(gen.height):\n        if tilemap.get_cell_source_id(Vector2i(0, y)) != 1 or tilemap.get_cell_source_id(Vector2i(gen.width - 1, y)) != 1:\n            edge_ok = false\n    print(\"All edge cells are walls: \", edge_ok)\n    \n    quit(0)\nEOF\ncd /home/user/myproject && godot --headless --script /tmp/final_verify.gd 2>&1 | tail -40\n"]
