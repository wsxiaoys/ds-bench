[164.153624, "i", "cat > /tmp/create_scene.gd << 'EOF'\n@tool\nextends SceneTree\n\nfunc _init():\n    var main := Node2D.new()\n    main.name = \"Main\"\n    \n    var tilemap := TileMapLayer.new()\n    tilemap.name = \"TileMapLayer\"\n    tilemap.tile_set = load(\"res://tilesets/dungeon.tres\")\n    main.add_child(tilemap)\n    tilemap.owner = main\n    \n    var gen_script := load(\"res://scripts/DungeonGenerator.gd\")\n    var gen = gen_script.new()\n    gen.name = \"DungeonGenerator\"\n    main.add_child(gen)\n    gen.owner = main\n    \n    var packed := PackedScene.new()\n    packed.pack(main)\n    var err := ResourceSaver.save(packed, \"res://scenes/Main.tscn\")\n    print(\"Scene save err: \", err)\n    quit()\nEOF\ncd /home/user/myproject && godot --headless --script /tmp/create_scene.gd 2>&1 | tail -30\n"]
