[115.183402, "o", "[gd_resource type=\"TileSet\" load_steps=3 format=3]\r\n\r\n[ext_resource type=\"Texture2D\" path=\"res://tilesets/dungeon_tiles.png\" id=\"1_q63t8\"]\r\n\r\n[sub_resource type=\"TileSetAtlasSource\" id=\"TileSetAtlasSource_3p7ks\"]\r\ntexture = ExtResource(\"1_q63t8\")\r\n0:0/0 = 0\r\n1:0/0 = 0\r\n2:0/0 = 0\r\n\r\n[resource]\r\nsources/0 = SubResource(\"TileSetAtlasSource_3p7ks\")\r\n"]
