[439.637362, "o", "=== project.godot ===\r\n"]
[439.638229, "o", "; Engine configuration file.\r\nconfig_version=5\r\n\r\n[application]\r\n\r\nconfig/name=\"Dungeon Generator\"\r\nrun/main_scene=\"res://scenes/Main.tscn\"\r\nconfig/features=PackedStringArray(\"4.3\")\r\n\r\n[rendering]\r\n\r\nrenderer/rendering_method=\"gl_compatibility\"\r\nrenderer/rendering_method.mobile=\"gl_compatibility\"\r\n"]
[439.638435, "o", "\u001b[?2004h"]
[439.638458, "o", "root@824614b0-6997-41e4-91dd-c059dc123854:/home/user/myproject# "]
[439.638744, "o", "echo '=== DungeonGenerator.gd ==='; cat /home/user/myproject/scripts/DungeonGenerator.gd\r\n\u001b[?2004l\r=== DungeonGenerator.gd ===\r\n"]
[439.63973, "o", "extends Node\r\nclass_name DungeonGenerator\r\n\r\n@export var seed: int = 12345\r\n@export var width: int = 64\r\n@export var height: int = 64\r\n@export var wall_threshold: float = 0.0\r\n\r\nvar _rooms: Array[Rect2i] = []\r\n\r\nfunc generate(target: TileMapLayer) -> void:\r\n    _rooms.clear()\r\n    if target == null:\r\n        return\r\n    target.clear()\r\n\r\n    # 1. Noise pass\r\n    var noise := FastNoiseLite.new()\r\n    noise.seed = seed\r\n    noise.noise_type = FastNoiseLite.TYPE_PERLIN\r\n    noise.frequency = 0.1\r\n\r\n    for y in range(height):\r\n        for x in range(width):\r\n            var n: float = noise.get_noise_2d(x, y)\r\n            # n is in [-1, 1]; wall_threshold default 0.0 -> n >= 0 is floor\r\n            if n >= wall_threshold:\r\n                target.set_cell(Vector2i(x, y), 0, Vector2i(0, 0))\r\n            else:\r\n                target.set_cell(Vector2i(x, y), 1, Vector2i(1, 0))\r\n\r\n    # 2. Force outer edge to wall (source_id 1)\r\n    for x in range(width):\r\n        target.set_cell(Vector2i(x, 0), 1, Vector2i(1, 0))\r\n        target.set_cell(Vector2i(x, height - 1), 1, Vector2i(1, 0))\r\n    for y in range(height):\r\n        target.set_cell(Vector2i(0, y), 1, Vector2i(1, 0))\r\n        target.set_cell(Vector2i(width - 1, y), 1, Vector2i(1, 0))\r\n\r\n    # 3. Carve rooms deterministically using a separate RNG seeded from seed\r\n    var rng := RandomNumberGenerator.new()\r\n    rng.seed = seed\r\n\r\n    var room_count: int = 4\r\n    var max_attempts: int = 64\r\n    var attempts: int = 0\r\n    var min_size: int = 4\r\n    var max_size: int = 8\r\n\r\n    while _rooms.size() < room_count and attempts < max_attempts:\r\n        attempts += 1\r\n        var rw: int = rng.randi_range(min_size, max_size)\r\n        var rh: int = rng.randi_range(min_size, max_size)\r\n        var rx: int = rng.randi_range(1, width - 2 - rw)\r\n        var ry: int = rng.randi_range(1, height - 2 - rh)\r\n        var rect := Rect2i(rx, ry, rw, rh)\r\n        var ok: bool = true\r\n        for r in _rooms:\r\n            if r.intersects(rect):\r\n                ok = false\r\n                break\r\n        if not ok:\r\n            continue"]
[439.639763, "o", "\r\n        _rooms.append(rect)\r\n        # Carve the room (write floor)\r\n        for y2 in range(ry, ry + rh):\r\n            for x2 in range(rx, rx + rw):\r\n                target.set_cell(Vector2i(x2, y2), 0, Vector2i(0, 0))\r\n\r\n    # 4. Connect rooms with L-shaped corridors\r\n    for i in range(1, _rooms.size()):\r\n        var prev: Rect2i = _rooms[i - 1]\r\n        var cur: Rect2i = _rooms[i]\r\n        var p_center: Vector2i = Vector2i(prev.position.x + prev.size.x / 2, prev.position.y + prev.size.y / 2)\r\n        var c_center: Vector2i = Vector2i(cur.position.x + cur.size.x / 2, cur.position.y + cur.size.y / 2)\r\n        # L-shape: horizontal then vertical (deterministic)\r\n        var step_x: int = 1 if c_center.x >= p_center.x else -1\r\n        var step_y: int = 1 if c_center.y >= p_center.y else -1\r\n        var x0: int = p_center.x\r\n        while x0 != c_center.x:\r\n            target.set_cell(Vector2i(x0, p_center.y), 0, Vector2i(0, 0))\r\n            x0 += step_x\r\n        # ensure the endpoint is carved too\r\n        target.set_cell(Vector2i(c_center.x, p_center.y), 0, Vector2i(0, 0))\r\n        var y0: int = p_center.y\r\n        while y0 != c_center.y:\r\n            target.set_cell(Vector2i(c_center.x, y0), 0, Vector2i(0, 0))\r\n            y0 += step_y\r\n        target.set_cell(Vector2i(c_center.x, c_center.y), 0, Vector2i(0, 0))\r\n\r\nfunc count_floor_tiles(target: TileMapLayer) -> int:\r\n    var count: int = 0\r\n    for y in range(height):\r\n        for x in range(width):\r\n            if target.get_cell_source_id(Vector2i(x, y)) == 0:\r\n                count += 1\r\n    return count\r\n\r\nfunc find_rooms() -> Array[Rect2i]:\r\n    return _rooms\r\n"]
[439.639943, "o", "\u001b[?2004hroot@824614b0-6997-41e4-91dd-c059dc123854:/home/user/myproject# "]
[439.640112, "o", "echo '=== Main.gd ==='; cat /home/user/myproject/scenes/Main.gd\r\n\u001b[?2004l\r"]
[439.640137, "o", "=== Main.gd ===\r\n"]
[439.640899, "o", "extends Node2D\r\n\r\n@onready var tile_map: TileMapLayer = $TileMapLayer\r\n@onready var dungeon_generator: Node = $DungeonGenerator\r\n\r\nfunc _ready() -> void:\r\n    if dungeon_generator and tile_map:\r\n        dungeon_generator.generate(tile_map)\r\n"]
[439.641072, "o", "\u001b[?2004hroot@824614b0-6997-41e4-91dd-c059dc123854:/home/user/myproject# "]
[439.641266, "o", "echo '=== Main.tscn ==='; cat /home/user/myproject/scenes/Main.tscn\r\n\u001b[?2004l\r"]
[439.641307, "o", "=== Main.tscn ===\r\n"]
[439.642323, "o", "[gd_scene load_steps=4 format=3]\r\n\r\n[ext_resource type=\"Script\" path=\"res://scenes/Main.gd\" id=\"1_vfesw\"]\r\n[ext_resource type=\"TileSet\" path=\"res://tilesets/dungeon.tres\" id=\"2_jbnn0\"]\r\n[ext_resource type=\"Script\" path=\"res://scripts/DungeonGenerator.gd\" id=\"3_xysqo\"]\r\n\r\n[node name=\"Main\" type=\"Node2D\"]\r\nscript = ExtResource(\"1_vfesw\")\r\n\r\n[node name=\"TileMapLayer\" type=\"TileMapLayer\" parent=\".\"]\r\ntile_set = ExtResource(\"2_jbnn0\")\r\n\r\n[node name=\"DungeonGenerator\" type=\"Node\" parent=\".\"]\r\nscript = ExtResource(\"3_xysqo\")\r\nseed = 12345\r\nwidth = 64\r\nheight = 64\r\nwall_threshold = 0.0\r\n"]
[439.642486, "o", "\u001b[?2004h"]
[439.642524, "o", "root@824614b0-6997-41e4-91dd-c059dc123854:/home/user/myproject# "]
