pe RestoreBucketOptions, type RestoreBucketResponse, type RestoreInfo, type RestoreObjectOptions, type RestoreObjectResponse, RestoreStatus, type SetBucketCorsOptions, type SetBucketLifecycleOptions, type SetBucketMigrationOptions, type SetBucketNotificationsOptions, type SetBucketTtlOptions, type SetBucketTypeOptions, type SetObjectAccessOptions, type SetObjectAccessResponse, type SignedUploadUrlResponse, type StatsResponse, type StorageClass, type TigrisConfig, type UpdateBucketOptions, type UpdateBucketResponse, type UpdateObjectOptions, type UpdateObjectResponse, UploadAction, bundle, completeMultipartUpload, copy, createBucket, createBucketSnapshot, deleteBucketSnapshot, disableSnapshot, enableSnapshot, get, getBucketInfo, getPartsPresignedUrls, getPresignedUrl, getRestoreInfo, getSignedUploadUrl, getStats, handleClientUpload, head, initMultipartUpload, isMigrated, list, listBucketSnapshots, listBuckets, listForks, listVersions, mergeFork, migrate, move, put, rebaseFork, remove, removeBucket, restoreBucket, restoreObject, setBucketCors, setBucketLifecycle, setBucketMigration, setBucketNotifications, setBucketTtl, setBucketType, setObjectAccess, updateBucket, updateObject };\r\n"]
