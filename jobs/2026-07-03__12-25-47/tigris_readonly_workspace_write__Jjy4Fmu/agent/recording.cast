ions = {\r\n    config?: Omit<TigrisStorageConfig, 'bucket'>;\r\n    paginationToken?: string;\r\n    limit?: number;\r\n};\r\ntype BucketSnapshot = {\r\n    name?: string | undefined;\r\n    version: string | undefined;\r\n    creationDate: Date | undefined;\r\n};\r\ntype ListBucketSnapshotsResponse = {\r\n    snapshots: BucketSnapshot[];\r\n"]
