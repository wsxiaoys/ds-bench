[148.37507, "o", "    types.append(goblin_stats)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[148.375146, "o", "    types.append(orc_stats)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[148.375244, "o", "    types.append(dragon_stats)\r\n\u001b[?2004l\r\u001b[?2004h"]
[148.375296, "o", "> "]
