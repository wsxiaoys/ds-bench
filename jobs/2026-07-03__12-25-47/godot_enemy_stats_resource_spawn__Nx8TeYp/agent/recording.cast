[38.455726, "i", "python3 << 'PYEOF'\ncontent = '''extends CharacterBody2D\nclass_name Enemy\n\n@export var stats: EnemyStats\n\nvar current_health: int = 0\n\n@onready var color_rect: ColorRect = $ColorRect\n\nfunc _ready() -> void:\n    if stats == null:\n        current_health = 100\n        return\n    current_health = stats.max_health\n    if color_rect:\n        color_rect.color = stats.color\n\nfunc take_damage(amount: int) -> void:\n    current_health -= amount\n    if current_health <= 0:\n        queue_free()\n'''\nwith open('/home/user/myproject/scripts/Enemy.gd', 'w') as f:\n    f.write(content)\nprint('Written')\nPYEOF\n"]
