[103.07455, "i", "cat > /tmp/test_spawner.gd << 'EOF'\nextends SceneTree\n\nfunc _init() -> void:\n\tvar goblin_stats: Resource = load(\"res://resources/enemies/goblin.tres\")\n\tvar orc_stats: Resource = load(\"res://resources/enemies/orc.tres\")\n\tvar dragon_stats: Resource = load(\"res://resources/enemies/dragon.tres\")\n\tprint(\"Loaded goblin: \", goblin_stats)\n\tprint(\"Loaded orc: \", orc_stats)\n\tprint(\"Loaded dragon: \", dragon_stats)\n\t\n\tvar spawner_scene: PackedScene = load(\"res://scenes/Spawner.tscn\")\n\tvar spawner = spawner_scene.instantiate()\n\tspawner.enemy_types = [goblin_stats, orc_stats, dragon_stats]\n\troot.add_child(spawner)\n\tawait process_frame\n\tprint(\"Spawner has \", spawner.get_child_count(), \" children\")\n\tfor child in spawner.get_children():\n\t\tprint(\"  Child: \", child.name, \" health=\", child.current_health)\n\t\n\tspawner.take_damage_all(50)\n\tawait process_frame\n\tprint(\"After 50 damage:\")\n\tfor child in spawner.get_children():\n\t\tprint(\"  Child: \", child.name, \" health=\", child.current_health)\n\tprint(\"Children after damage: \", spawner.get_child_count())\n\tquit()\nEOF\n"]
