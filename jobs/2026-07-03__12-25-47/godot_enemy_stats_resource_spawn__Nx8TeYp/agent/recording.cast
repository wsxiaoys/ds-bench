[148.375406, "o", "> "]
[148.375455, "o", "    root.add_child(spawner)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[148.375526, "o", "    await process_frame\r\n\u001b[?2004l\r\u001b[?2004h> "]
[148.375709, "o", "    print(\"Spawner has \", spawner.get_child_count(), \" children\")\r\n\u001b[?2004l\r\u001b[?2004h"]
[148.375759, "o", "> "]
[148.375828, "o", "    for child in spawner.get_children():\r\n\u001b[?2004l\r\u001b[?2004h"]
[148.375877, "o", "> "]
[148.37613, "o", "        print(\"  Child: \", child.name, \" health=\", child.current_health, \" color=\", child.get_node(\"ColorRect\").color)\r\n\u001b[?2004l\r\u001b[?2004h"]
[148.376193, "o", ">     \r\n\u001b[?2004l\r\u001b[?2004h> "]
[148.376272, "o", "    spawner.take_damage_all(50)\r\n\u001b[?2004l\r\u001b[?2004h"]
[148.376321, "o", "> "]
[148.376372, "o", "    await process_frame\r\n\u001b[?2004l\r\u001b[?2004h> "]
[148.376493, "o", "    print(\"After 50 damage (goblin should die):\")\r\n\u001b[?2004l\r\u001b[?2004h> "]
[148.376667, "o", "    print(\"Children after damage: \", spawner.get_child_count())\r\n\u001b[?2004l\r\u001b[?2004h> "]
[148.376787, "o", "    for child in spawner.get_children():\r\n\u001b[?2004l\r\u001b[?2004h"]
[148.376836, "o", "> "]
[148.376984, "o", "        print(\"  Child: \", child.name, \" health=\", child.current_health)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[148.377032, "o", "    quit()\r\n\u001b[?2004l\r\u001b[?2004h"]
