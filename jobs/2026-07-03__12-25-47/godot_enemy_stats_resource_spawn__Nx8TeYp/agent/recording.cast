[148.372555, "i", "python3 << 'PYEOF'\ncontent = '''extends SceneTree\n\nfunc _init() -> void:\n    var goblin_stats: EnemyStats = load(\"res://resources/enemies/goblin.tres\")\n    var orc_stats: EnemyStats = load(\"res://resources/enemies/orc.tres\")\n    var dragon_stats: EnemyStats = load(\"res://resources/enemies/dragon.tres\")\n    print(\"Loaded goblin: \", goblin_stats, \" name=\", goblin_stats.name, \" hp=\", goblin_stats.max_health)\n    print(\"Loaded orc: \", orc_stats, \" name=\", orc_stats.name, \" hp=\", orc_stats.max_health)\n    print(\"Loaded dragon: \", dragon_stats, \" name=\", dragon_stats.name, \" hp=\", dragon_stats.max_health)\n    \n    var spawner_scene: PackedScene = load(\"res://scenes/Spawner.tscn\")\n    var spawner = spawner_scene.instantiate()\n    var types: Array[EnemyStats] = []\n    types.append(goblin_stats)\n    types.append(orc_stats)\n    types.append(dragon_stats)\n    spawner.set(\"enemy_types\", types)\n    root.add_child(spawner)\n    await process_frame\n    print(\"Spawner has \", spawner.get_child_count(), \" children\")\n    for child in spawner.get_children():\n        print(\"  Child: \", child.name, \" health=\", child.current_health, \" color=\", child.get_node(\"ColorRect\").color)\n    \n    spawner.take_damage_all(50)\n    await process_frame\n    print(\"After 50 damage (goblin should die):\")\n    print(\"Children after damage: \", spawner.get_child_count())\n    for child in spawner.get_children():\n        print(\"  Child: \", child.name, \" health=\", child.current_health)\n    quit()\n'''\nwith open('/home/user/myproject/test_spawner.gd', 'w') as f:\n    f.write(content)\nprint('Written')\nPYEOF\n"]
