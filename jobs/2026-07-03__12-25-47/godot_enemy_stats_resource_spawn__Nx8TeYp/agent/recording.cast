[38.797997, "o", "cat /home/user/myproject/scripts/Enemy.gd\r\n\u001b[?2004l\r"]
[38.799775, "o", "extends CharacterBody2D\r\nclass_name Enemy\r\n\r\n@export var stats: EnemyStats\r\n\r\nvar current_health: int = 0\r\n\r\n@onready var color_rect: ColorRect = $ColorRect\r\n\r\nfunc _ready() -> void:\r\n    if stats == null:\r\n        current_health = 100\r\n        return\r\n    current_health = stats.max_health\r\n    if color_rect:\r\n        color_rect.color = stats.color\r\n\r\nfunc take_damage(amount: int) -> void:\r\n    current_health -= amount\r\n    if current_health <= 0:\r\n        queue_free()\r\n"]
[38.800133, "o", "\u001b[?2004hroot@2c2dd983-956d-453d-bbac-8209021f9372:/home/user/myproject# "]
