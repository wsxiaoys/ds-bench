[52.761496, "i", "cat > build.gradle << 'EOF'\nplugins {\n    id 'application'\n    id 'java'\n}\n\ngroup = 'com.example'\nversion = '1.0.0'\n\njava {\n    toolchain {\n        languageVersion = JavaLanguageVersion.of(17)\n    }\n}\n\nrepositories {\n    mavenCentral()\n}\n\ndependencies {\n    implementation 'com.badlogicgames.gdx:gdx:1.14.2'\n    implementation 'com.badlogicgames.gdx:gdx-backend-headless:1.14.2'\n    natives 'com.badlogicgames.gdx:gdx-platform:1.14.2:natives-desktop'\n}\n\napplication {\n    mainClass = 'com.example.sim.SimApp'\n}\n\n// Distribute natives to runtime classpath as well\ntasks.named('runtimeClasspath') {\n    dependsOn tasks.named('javadocJar').get().taskDependencies.getDependencies(tasks.named('javadocJar').get())\n}\n\nrun {\n    standardInput = System.in\n}\nEOF\n"]
