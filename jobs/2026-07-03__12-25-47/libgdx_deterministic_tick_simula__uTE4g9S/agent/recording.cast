[69.401664, "i", "cat > src/main/java/com/example/sim/SimApp.java << 'JAVA_EOF'\npackage com.example.sim;\n\nimport java.io.OutputStreamWriter;\nimport java.io.Writer;\nimport java.nio.charset.StandardCharsets;\nimport java.util.Locale;\nimport java.util.Properties;\n\nimport com.badlogic.gdx.ApplicationAdapter;\nimport com.badlogic.gdx.Gdx;\nimport com.badlogic.gdx.backends.headless.HeadlessApplication;\nimport com.badlogic.gdx.backends.headless.HeadlessApplicationConfiguration;\nimport com.badlogic.gdx.files.FileHandle;\n\npublic class SimApp extends ApplicationAdapter {\n\n    private String outputPath;\n\n    private double x, y, vx, vy;\n    private double dt;\n    private double ay; // gravity_y\n    private int ticks;\n    private int renderCount = 0;\n    private volatile boolean started = false;\n\n    @Override\n    public void create() {\n        // Main thread has set up paths via static fields on the class.\n        this.started = true;\n\n        // Read config file (absolute path passed in).\n        Properties props = new Properties();\n        FileHandle cfg = Gdx.files.absolute(Main.configPath);\n        try (java.io.InputStreamReader reader = new java.io.InputStreamReader(cfg.read(), StandardCharsets.UTF_8)) {\n            props.load(reader);\n        } catch (java.io.IOException e) {\n            throw new RuntimeException(\"Failed to read config: \" + Main.configPath, e);\n        }\n\n        this.ticks = Integer.parseInt(props.getProperty(\"ticks\", \"0\").trim());\n        this.dt = Double.parseDouble(props.getProperty(\"dt\", \"0\").trim());\n        this.x = Double.parseDouble(props.getProperty(\"position_x\", \"0\").trim());\n        this.y = Double.parseDouble(props.getProperty(\"position_y\", \"0\").trim());\n        this.vx = Double.parseDouble(props.getProperty(\"velocity_x\", \"0\").trim());\n        this.vy = Double.parseDouble(props.getProperty(\"velocity_y\", \"0\").trim());\n        this.ay = Double.parseDouble(props.getProperty(\"gravity_y\", \"0\").trim());\n\n        this.outputPath = Main.outputPath;\n\n        // If ticks == 0, exit immediately after setup; dispose() will write the file.\n        if (this.ticks <= 0) {\n            Gdx.app.exit();\n        }\n    }\n\n    @Override\n    public void render() {\n        if (!started) return;\n        if (renderCount >= ticks) {\n            // Should not normally happen; just exit.\n            Gdx.app.exit();\n            return;\n        }\n\n        // Symplectic Euler integration\n        double ax = 0.0;\n        vx += ax * dt;\n        vy += ay * dt;\n        x += vx * dt;\n        y += vy * dt;\n\n        renderCount++;\n\n        if (renderCount >= ticks) {\n            Gdx.app.exit();\n        }\n    }\n\n    @Override\n    public void dispose() {\n        // Write the final state to the output file using UTF-8 and LF line endings.\n        if (outputPath == null) return;\n        FileHandle out = Gdx.files.absolute(outputPath);\n        StringBuilder sb = new StringBuilder();\n        sb.append(\"final_x=\").append(String.format(Locale.ROOT, \"%.6f\", x)).append('\\n');\n        sb.append(\"final_y=\").append(String.format(Locale.ROOT, \"%.6f\", y)).append('\\n');\n        sb.append(\"final_vx=\").append(String.format(Locale.ROOT, \"%.6f\", vx)).append('\\n');\n        sb.append(\"final_vy=\").append(String.format(Locale.ROOT, \"%.6f\", vy)).append('\\n');\n        sb.append(\"ticks=\").append(renderCount).append('\\n');\n        byte[] data = sb.toString().getBytes(StandardCharsets.UTF_8);\n        try (java.io.OutputStream os = out.write(false)) {\n            os.write(data);\n            os.flush();\n        } catch (java.io.IOException e) {\n            throw new RuntimeException(\"Failed to write output: \" + outputPath, e);\n        }\n    }\n\n    // ---------- Bootstrap ----------\n\n    public static class Main {\n        public static volatile String configPath;\n        public static volatile String outputPath;\n\n        public static void main(String[] args) {\n            if (args.length < 2) {\n                System.err.println(\"Usage: SimApp <config-path> <output-path>\");\n                System.exit(2);\n            }\n            configPath = args[0];\n            outputPath = args[1"]
[69.401807, "i", "];\n\n            HeadlessApplicationConfiguration cfg = new HeadlessApplicationConfiguration();\n            // Run the loop as fast as possible; no wall-clock pacing.\n            cfg.updatesPerSecond = 0;\n\n            HeadlessApplication app = new HeadlessApplication(new SimApp(), cfg);\n\n            // Wait until the application is done (until Gdx.app.exit() tears it down).\n            // HeadlessApplication exposes a thread via reflection-free API: getApplicationLogger\n            // but the runnable loop is internal. Use reflection to join the loop thread.\n            try {\n                java.lang.reflect.Field f = HeadlessApplication.class.getDeclaredField(\"mainLoopThread\");\n                f.setAccessible(true);\n                Thread t = (Thread) f.get(app);\n                if (t != null) {\n                    t.join();\n                }\n            } catch (NoSuchFieldException nsfe) {\n                // Fallback: try alternative field names used across versions.\n                try {\n                    java.lang.reflect.Field alt = null;\n                    for (java.lang.reflect.Field candidate : HeadlessApplication.class.getDeclaredFields()) {\n                        if (Thread.class.isAssignableFrom(candidate.getType())) {\n                            alt = candidate;\n                            break;\n                        }\n                    }\n                    if (alt != null) {\n                        alt.setAccessible(true);\n                        Thread t = (Thread) alt.get(app);\n                        if (t != null) t.join();\n                    }\n                } catch (Exception e) {\n                    throw new RuntimeException(e);\n                }\n            } catch (Exception e) {\n                throw new RuntimeException(e);\n            }\n        }\n    }\n}\nJAVA_EOF\n"]
