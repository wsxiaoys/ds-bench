[174.681347, "o", "import com.badlogic.gdx.ApplicationAdapter;\r\n\u001b[?2004l\r"]
[174.681388, "o", "\u001b[?2004h> "]
[174.681509, "o", "import com.badlogic.gdx.Gdx;\r\n\u001b[?2004l\r"]
[174.681536, "o", "\u001b[?2004h> "]
[174.681778, "o", "import com.badlogic.gdx.backends.headless.HeadlessApplication;\r\n\u001b[?2004l\r"]
[174.681807, "o", "\u001b[?2004h> "]
[174.682096, "o", "import com.badlogic.gdx.backends.headless.HeadlessApplicationConfiguration;\r\n\u001b[?2004l\r"]
[174.682119, "o", "\u001b[?2004h> "]
[174.682279, "o", "import com.badlogic.gdx.files.FileHandle;\r\n\u001b[?2004l\r"]
[174.682302, "o", "\u001b[?2004h> "]
[174.682383, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[174.682527, "o", "public class SimApp extends ApplicationAdapter {\r\n\u001b[?2004l\r"]
[174.682552, "o", "\u001b[?2004h> "]
[174.682601, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[174.682707, "o", "    // Paths supplied by main().\r\n\u001b[?2004l\r"]
[174.682728, "o", "\u001b[?2004h> "]
[174.682896, "o", "    public static volatile String configPath;\r\n\u001b[?2004l\r"]
[174.682918, "o", "\u001b[?2004h> "]
[174.683072, "o", "    public static volatile String outputPath;\r\n\u001b[?2004l\r"]
[174.683099, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[174.683149, "o", "\u001b[?2004h> "]
[174.68323, "o", "    // Simulation state.\r\n\u001b[?2004l\r"]
[174.683255, "o", "\u001b[?2004h> "]
[174.683384, "o", "    private double x, y, vx, vy;\r\n\u001b[?2004l\r"]
[174.683409, "o", "\u001b[?2004h> "]
[174.683499, "o", "    private double dt;\r\n\u001b[?2004l\r"]
[174.683524, "o", "\u001b[?2004h> "]
[174.683702, "o", "    private double ay; // gravity_y (ax is always 0)\r\n\u001b[?2004l\r"]
[174.683726, "o", "\u001b[?2004h> "]
[174.683815, "o", "    private int ticks;\r\n\u001b[?2004l\r"]
[174.683839, "o", "\u001b[?2004h"]
[174.683883, "o", "> "]
[174.683971, "o", "    private int renderCount = 0;\r\n\u001b[?2004l\r"]
[174.683996, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[174.684044, "o", "\u001b[?2004h> "]
[174.684089, "o", "    @Override\r\n\u001b[?2004l\r"]
[174.684111, "o", "\u001b[?2004h> "]
[174.684217, "o", "    public void create() {\r\n\u001b[?2004l\r"]
[174.684239, "o", "\u001b[?2004h> "]
[174.684468, "o", "        // Read config file via libGDX FileHandle (absolute path).\r\n\u001b[?2004l\r"]
[174.68449, "o", "\u001b[?2004h> "]
[174.684648, "o", "        Properties props = new Properties();\r\n\u001b[?2004l\r"]
[174.68467, "o", "\u001b[?2004h> "]
[174.684861, "o", "        FileHandle cfg = Gdx.files.absolute(configPath);\r\n\u001b[?2004l\r"]
[174.684885, "o", "\u001b[?2004h> "]
[174.685232, "o", "        try (InputStreamReader reader = new InputStreamReader(cfg.read(), StandardCharsets.UTF_8)) {\r\n\u001b[?2004l\r\u001b[?2004h"]
[174.685279, "o", "> "]
[174.685353, "o", "            props.load(reader);\r\n\u001b[?2004l\r"]
[174.685376, "o", "\u001b[?2004h> "]
[174.685499, "o", "        } catch (IOException e) {\r\n\u001b[?2004l\r"]
[174.685522, "o", "\u001b[?2004h> "]
[174.685788, "o", "            throw new RuntimeException(\"Failed to read config: \" + configPath, e);\r\n\u001b[?2004l\r"]
[174.68581, "o", "\u001b[?2004h> "]
[174.685862, "o", "        }\r\n\u001b[?2004l\r"]
[174.685884, "o", "\u001b[?2004h> "]
[174.685928, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[174.686179, "o", "        this.ticks = Integer.parseInt(props.getProperty(\"ticks\", \"0\").trim());\r\n\u001b[?2004l\r"]
[174.686202, "o", "\u001b[?2004h> "]
[174.686361, "o", "        if (this.ticks < 0) this.ticks = 0;\r\n\u001b[?2004l\r"]
[174.686383, "o", "\u001b[?2004h> "]
[174.68663, "o", "        this.dt = Double.parseDouble(props.getProperty(\"dt\", \"0\").trim());\r\n\u001b[?2004l\r"]
[174.686652, "o", "\u001b[?2004h> "]
[174.68692, "o", "        this.x  = Double.parseDouble(props.getProperty(\"position_x\", \"0\").trim());\r\n\u001b[?2004l\r"]
[174.686943, "o", "\u001b[?2004h> "]
[174.687213, "o", "        this.y  = Double.parseDouble(props.getProperty(\"position_y\", \"0\").trim());\r\n\u001b[?2004l\r"]
[174.687233, "o", "\u001b[?2004h> "]
[174.68751, "o", "        this.vx = Double.parseDouble(props.getProperty(\"velocity_x\", \"0\").trim());\r\n\u001b[?2004l\r"]
[174.687531, "o", "\u001b[?2004h> "]
[174.687802, "o", "        this.vy = Double.parseDouble(props.getProperty(\"velocity_y\", \"0\").trim());\r\n\u001b[?2004l\r"]
[174.68783, "o", "\u001b[?2004h> "]
[174.688095, "o", "        this.ay = Double.parseDouble(props.getProperty(\"gravity_y\", \"0\").trim());\r\n\u001b[?2004l\r"]
[174.688123, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[174.68817, "o", "\u001b[?2004h> "]
[174.688436, "o", "        // If ticks == 0 we still want to write the initial state to the output file.\r\n\u001b[?2004l\r"]
[174.688465, "o", "\u001b[?2004h> "]
[174.688575, "o", "        if (this.ticks == 0) {\r\n\u001b[?2004l\r"]
[174.688613, "o", "\u001b[?2004h> "]
[174.688697, "o", "            Gdx.app.exit();\r\n\u001b[?2004l\r"]
[174.688724, "o", "\u001b[?2004h> "]
[174.688768, "o", "        }\r\n\u001b[?2004l\r"]
[174.688794, "o", "\u001b[?2004h> "]
[174.688845, "o", "    }\r\n\u001b[?2004l\r\u001b[?2004h"]
[174.688876, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h"]
[174.688947, "o", ">     @Override\r\n\u001b[?2004l\r"]
[174.688983, "o", "\u001b[?2004h> "]
[174.689056, "o", "    public void render() {\r\n\u001b[?2004l\r"]
[174.689091, "o", "\u001b[?2004h> "]
[174.689192, "o", "        if (renderCount >= ticks) {\r\n\u001b[?2004l\r"]
[174.689227, "o", "\u001b[?2004h> "]
[174.689502, "o", "            // HeadlessApplication always invokes render() once more after we call exit().\r\n\u001b[?2004l\r"]
[174.68954, "o", "\u001b[?2004h> "]
[174.689762, "o", "            // Skip any further integration; just ensure exit is requested.\r\n\u001b[?2004l\r"]
[174.689798, "o", "\u001b[?2004h> "]
[174.689875, "o", "            Gdx.app.exit();\r\n\u001b[?2004l\r"]
[174.689909, "o", "\u001b[?2004h> "]
[174.689967, "o", "            return;\r\n\u001b[?2004l\r"]
[174.690002, "o", "\u001b[?2004h> "]
[174.690036, "o", "        }\r\n\u001b[?2004l\r\u001b[?2004h"]
[174.690069, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h"]
[174.690102, "o", "> "]
[174.690309, "o", "        // Symplectic Euler integration (velocity first, then position).\r\n\u001b[?2004l\r"]
[174.690354, "o", "\u001b[?2004h> "]
[174.690418, "o", "        double ax = 0.0;\r\n\u001b[?2004l\r"]
[174.690453, "o", "\u001b[?2004h> "]
[174.690516, "o", "        vx += ax * dt;\r\n\u001b[?2004l\r"]
[174.69055, "o", "\u001b[?2004h> "]
[174.690614, "o", "        vy += ay * dt;\r\n\u001b[?2004l\r"]
[174.690648, "o", "\u001b[?2004h> "]
[174.690712, "o", "        x  += vx * dt;\r\n\u001b[?2004l\r"]
[174.690746, "o", "\u001b[?2004h> "]
[174.69081, "o", "        y  += vy * dt;\r\n\u001b[?2004l\r"]
[174.690845, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[174.690879, "o", "\u001b[?2004h> "]
[174.69094, "o", "        renderCount++;\r\n\u001b[?2004l\r"]
[174.690975, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[174.691009, "o", "\u001b[?2004h> "]
[174.691111, "o", "        if (renderCount >= ticks) {\r\n\u001b[?2004l\r"]
[174.691144, "o", "\u001b[?2004h> "]
[174.691225, "o", "            Gdx.app.exit();\r\n\u001b[?2004l\r"]
[174.691259, "o", "\u001b[?2004h> "]
[174.691293, "o", "        }\r\n\u001b[?2004l\r"]
[174.691328, "o", "\u001b[?2004h>     }\r\n"]
[174.691371, "o", "\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[174.691407, "o", "\u001b[?2004h> "]
[174.691444, "o", "    @Override\r\n\u001b[?2004l\r"]
[174.691477, "o", "\u001b[?2004h> "]
[174.691555, "o", "    public void dispose() {\r\n\u001b[?2004l\r"]
[174.691589, "o", "\u001b[?2004h> "]
[174.691829, "o", "        // Write the final state to the output file with UTF-8 + LF line endings.\r\n\u001b[?2004l\r"]
[174.691865, "o", "\u001b[?2004h> "]
[174.692027, "o", "        FileHandle out = Gdx.files.absolute(outputPath);\r\n\u001b[?2004l\r"]
[174.692062, "o", "\u001b[?2004h> "]
[174.6922, "o", "        StringBuilder sb = new StringBuilder();\r\n\u001b[?2004l\r"]
[174.692234, "o", "\u001b[?2004h> "]
[174.692507, "o", "        sb.append(\"final_x=\").append(String.format(Locale.ROOT, \"%.6f\", x)).append('\\n');\r\n\u001b[?2004l\r"]
[174.692536, "o", "\u001b[?2004h> "]
[174.692818, "o", "        sb.append(\"final_y=\").append(String.format(Locale.ROOT, \"%.6f\", y)).append('\\n');\r\n\u001b[?2004l\r"]
[174.692847, "o", "\u001b[?2004h> "]
[174.693136, "o", "        sb.append(\"final_vx=\").append(String.format(Locale.ROOT, \"%.6f\", vx)).append('\\n');\r\n\u001b[?2004l\r"]
[174.693163, "o", "\u001b[?2004h> "]
[174.693459, "o", "        sb.append(\"final_vy=\").append(String.format(Locale.ROOT, \"%.6f\", vy)).append('\\n');\r\n\u001b[?2004l\r"]
[174.693487, "o", "\u001b[?2004h> "]
[174.693688, "o", "        sb.append(\"ticks=\").append(renderCount).append('\\n');\r\n\u001b[?2004l\r"]
[174.693716, "o", "\u001b[?2004h> "]
[174.69394, "o", "        byte[] data = sb.toString().getBytes(StandardCharsets.UTF_8);\r\n\u001b[?2004l\r"]
[174.693969, "o", "\u001b[?2004h> "]
[174.694136, "o", "        try (OutputStream os = out.write(false)) {\r\n\u001b[?2004l\r"]
[174.694163, "o", "\u001b[?2004h> "]
[174.694265, "o", "            os.write(data);\r\n\u001b[?2004l\r"]
[174.694292, "o", "\u001b[?2004h> "]
[174.694388, "o", "            os.flush();\r\n\u001b[?2004l\r"]
[174.694415, "o", "\u001b[?2004h> "]
[174.694532, "o", "        } catch (IOException e) {\r\n\u001b[?2004l\r"]
[174.694559, "o", "\u001b[?2004h> "]
[174.694827, "o", "            throw new RuntimeException(\"Failed to write output: \" + outputPath, e);\r\n\u001b[?2004l\r"]
[174.694855, "o", "\u001b[?2004h> "]
[174.694908, "o", "        }\r\n\u001b[?2004l\r\u001b[?2004h"]
[174.694943, "o", ">     }\r\n\u001b[?2004l\r"]
[174.694977, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[174.695011, "o", "\u001b[?2004h> "]
[174.695122, "o", "    // ---------- Bootstrap ----------\r\n\u001b[?2004l\r"]
[174.695157, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[174.695191, "o", "\u001b[?2004h> "]
[174.695379, "o", "    public static void main(String[] args) throws Exception {\r\n\u001b[?2004l\r"]
[174.695415, "o", "\u001b[?2004h> "]
[174.695508, "o", "        if (args.length < 2) {\r\n\u001b[?2004l\r"]
[174.695543, "o", "\u001b[?2004h> "]
[174.695772, "o", "            System.err.println(\"Usage: SimApp <config-path> <output-path>\");\r\n\u001b[?2004l\r"]
[174.695807, "o", "\u001b[?2004h> "]
[174.695886, "o", "            System.exit(2);\r\n\u001b[?2004l\r"]
[174.69592, "o", "\u001b[?2004h> "]
[174.695955, "o", "        }\r\n\u001b[?2004l\r\u001b[?2004h"]
[174.69599, "o", "> "]
[174.696065, "o", "        configPath = args[0];\r\n\u001b[?2004l\r"]
[174.6961, "o", "\u001b[?2004h> "]
[174.696184, "o", "        outputPath = args[1];\r\n\u001b[?2004l\r"]
[174.696219, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[174.696252, "o", "\u001b[?2004h> "]
[174.696512, "o", "        HeadlessApplicationConfiguration cfg = new HeadlessApplicationConfiguration();\r\n\u001b[?2004l\r"]
[174.696549, "o", "\u001b[?2004h> "]
[174.696768, "o", "        // 0 = run the main loop as fast as possible, no wall-clock pacing.\r\n\u001b[?2004l\r"]
[174.696803, "o", "\u001b[?2004h> "]
[174.696899, "o", "        cfg.updatesPerSecond = 0;\r\n\u001b[?2004l\r"]
[174.696934, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[174.696967, "o", "\u001b[?2004h> "]
[174.697197, "o", "        HeadlessApplication app = new HeadlessApplication(new SimApp(), cfg);\r\n\u001b[?2004l\r"]
[174.697235, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[174.697269, "o", "> "]
[174.697532, "o", "        // Join the main-loop thread so the JVM doesn't exit before dispose() runs.\r\n\u001b[?2004l\r"]
[174.697572, "o", "\u001b[?2004h> "]
[174.697864, "o", "        java.lang.reflect.Field f = HeadlessApplication.class.getDeclaredField(\"mainLoopThread\");\r\n\u001b[?2004l\r"]
[174.697901, "o", "\u001b[?2004h> "]
[174.697989, "o", "        f.setAccessible(true);\r\n\u001b[?2004l\r"]
[174.698024, "o", "\u001b[?2004h> "]
[174.698141, "o", "        Thread t = (Thread) f.get(app);\r\n\u001b[?2004l\r"]
[174.698177, "o", "\u001b[?2004h> "]
[174.698248, "o", "        if (t != null) {\r\n\u001b[?2004l\r"]
[174.698282, "o", "\u001b[?2004h> "]
[174.698352, "o", "            t.join();\r\n\u001b[?2004l\r"]
[174.698387, "o", "\u001b[?2004h> "]
[174.69842, "o", "        }\r\n\u001b[?2004l\r"]
[174.698455, "o", "\u001b[?2004h> "]
[174.698488, "o", "    }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[174.698517, "o", "}\r\n\u001b[?2004l\r\u001b[?2004h"]
[174.698585, "o", "> JAVA_EOF\r\n\u001b[?2004l\r"]
