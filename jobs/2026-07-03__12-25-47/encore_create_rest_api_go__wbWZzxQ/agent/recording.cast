[97.321324, "i", "cat books/books.go\n"]
[97.32161, "o", "cat books/books.go\r\n\u001b[?2004l\r"]
[97.322612, "o", "package books\r\n\r\nimport (\r\n\"context\"\r\n\"encore.dev/storage/sqldb\"\r\n)\r\n\r\nvar db = sqldb.NewDatabase(\"books\", sqldb.DatabaseConfig{\r\nMigrations: \"./migrations\",\r\n})\r\n\r\ntype Book struct {\r\nID     int64  `json:\"id\"`\r\nTitle  string `json:\"title\"`\r\nAuthor string `json:\"author\"`\r\n}\r\n\r\n//encore:api public method=POST path=/books\r\nfunc AddBook(ctx context.Context, b *Book) (*Book, error) {\r\nrow := db.QueryRow(ctx, `\r\nINSERT INTO books (title, author)\r\nVALUES ($1, $2)\r\nRETURNING id, title, author\r\n`, b.Title, b.Author)\r\n\r\nresult := &Book{}\r\nerr := row.Scan(&result.ID, &result.Title, &result.Author)\r\nif err != nil {\r\nreturn nil, err\r\n}\r\nreturn result, nil\r\n"]
[97.32268, "o", "}\r\n\r\n//encore:api public method=GET path=/books\r\nfunc ListBooks(ctx context.Context) ([]*Book, error) {\r\nrows, err := db.Query(ctx, `SELECT id, title, author FROM books`)\r\nif err != nil {\r\nreturn nil, err\r\n}\r\ndefer rows.Close()\r\n\r\nvar books []*Book\r\nfor rows.Next() {\r\nb := &Book{}\r\nif err := rows.Scan(&b.ID, &b.Title, &b.Author); err != nil {\r\nreturn nil, err\r\n}\r\nbooks = append(books, b)\r\n}\r\nif err := rows.Err(); err != nil {\r\nreturn nil, err\r\n}\r\nreturn books, nil\r\n}\r\n"]
[97.322844, "o", "\u001b[?2004hroot@fa725886-1620-40dd-b7bd-d00ff05a1403:/home/user/myproject# "]
[104.950239, "i", "cat books/migrations/1_create_tables.up.sql\n"]
[104.950512, "o", "cat books/migrations/1_create_tables.up.sql\r\n\u001b[?2004l\r"]
[104.951461, "o", "CREATE TABLE books (\r\n    id BIGSERIAL PRIMARY KEY,\r\n    title TEXT NOT NULL,\r\n    author TEXT NOT NULL\r\n);\r\n"]
