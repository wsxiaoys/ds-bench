[117.977379, "o", "Usage:\r\n  encore run [--debug] [--watch=true] [--level=TRACE] [--port=4000] [--listen=<listen-addr>] [flags]\r\n\r\nFlags:\r\n      --browser string             Whether to open the local development dashboard in the browser on startup. One of (\"REDACTED\", \"never\", or \"always\"). (default \"REDACTED\")\r\n      --color                      Whether to display colorized output\r\n      --debug string[=\"enabled\"]   Compile for debugging (disables some optimizations). One of (\"enabled\" or \"break\").\r\n  -h, --help                       help for run\r\n      --json                       Display logs in JSON format\r\n  -l, --level string               Minimum log level to display. One of (\"trace\", \"debug\", \"info\", \"warn\", or \"error\").\r\n      --listen string              Address to listen on (for example \"0.0.0.0:4000\")\r\n  -n, --namespace string           Namespace to use (defaults to active namespace)\r\n  -p, --port uint                  Port to listen on (default 4000)\r\n      --redact                     Redact sensitive data in traces when running locally\r\n  -w, --watch                      Watch for changes and live-reload (default true)\r\n\r\nGlobal Flags:\r\n      --trace string    file to write execution trace data to\r\n  -v, --verbose count   verbose output\r\n\r\nunknown command \"./...\" for \"encore run\"\r\n"]
