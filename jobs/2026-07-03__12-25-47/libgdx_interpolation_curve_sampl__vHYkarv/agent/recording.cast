[77.2303, "o", "            try {\r\n\u001b[?2004l\r"]
[77.230355, "o", "\u001b[?2004h> "]
[77.230773, "o", "                FileHandle fh = Gdx.files.absolute(configPath);\r\n\u001b[?2004l\r"]
[77.230858, "o", "\u001b[?2004h> "]
[77.231121, "o", "                Properties p = new Properties();\r\n\u001b[?2004l\r"]
[77.231172, "o", "\u001b[?2004h> "]
[77.231543, "o", "                try (Reader r = fh.reader(\"UTF-8\")) {\r\n\u001b[?2004l\r"]
[77.231595, "o", "\u001b[?2004h> "]
[77.231814, "o", "                    p.load(r);\r\n\u001b[?2004l\r"]
[77.231864, "o", "\u001b[?2004h> "]
[77.231993, "o", "                }\r\n\u001b[?2004l\r"]
[77.232043, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
