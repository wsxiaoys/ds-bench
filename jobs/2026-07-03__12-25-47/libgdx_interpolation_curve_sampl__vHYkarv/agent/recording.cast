[77.235827, "o", "> "]
[77.235921, "o", "                }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[77.236292, "o", "                Object val = curveField.get(null);\r\n\u001b[?2004l\r"]
[77.236372, "o", "\u001b[?2004h> "]
[77.236706, "o", "                if (!(val instanceof Interpolation)) {\r\n\u001b[?2004l\r"]
[77.236773, "o", "\u001b[?2004h> "]
[77.237422, "o", "                    throw new IllegalArgumentException(\"Field is not an Interpolation: \" + curveName);\r\n\u001b[?2004l\r"]
[77.2375, "o", "\u001b[?2004h> "]
[77.237616, "o", "                }\r\n\u001b[?2004l\r"]
[77.237688, "o", "\u001b[?2004h> "]
