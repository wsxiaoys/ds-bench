[77.238964, "o", "\u001b[?2004h> "]
[77.239349, "o", "                String samplesStr = p.getProperty(\"samples\");\r\n\u001b[?2004l\r"]
[77.239411, "o", "\u001b[?2004h> "]
[77.239943, "o", "                if (startStr == null || endStr == null || samplesStr == null) {\r\n\u001b[?2004l\r"]
[77.240006, "o", "\u001b[?2004h> "]
[77.240576, "o", "                    throw new IllegalArgumentException(\"Missing required property\");\r\n\u001b[?2004l\r"]
[77.240638, "o", "\u001b[?2004h> "]
[77.24076, "o", "                }\r\n\u001b[?2004l\r"]
[77.240822, "o", "\u001b[?2004h> "]
[77.241157, "o", "                start = Float.parseFloat(startStr);\r\n\u001b[?2004l\r"]
[77.241219, "o", "\u001b[?2004h> "]
[77.241551, "o", "                end = Float.parseFloat(endStr);\r\n\u001b[?2004l\r"]
[77.241614, "o", "\u001b[?2004h> "]
[77.241986, "o", "                samples = Integer.parseInt(samplesStr);\r\n\u001b[?2004l\r"]
[77.242049, "o", "\u001b[?2004h> "]
[77.242281, "o", "                if (samples < 2) {\r\n\u001b[?2004l\r"]
[77.242345, "o", "\u001b[?2004h> "]
