[77.232466, "o", "                curveName = p.getProperty(\"curve\");\r\n\u001b[?2004l\r"]
[77.232516, "o", "\u001b[?2004h> "]
[77.232797, "o", "                if (curveName == null) {\r\n\u001b[?2004l\r"]
[77.232845, "o", "\u001b[?2004h> "]
[77.23339, "o", "                    throw new IllegalArgumentException(\"Missing 'curve' property\");\r\n\u001b[?2004l\r"]
[77.233439, "o", "\u001b[?2004h> "]
[77.233584, "o", "                }\r\n\u001b[?2004l\r"]
[77.233631, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[77.233682, "o", "\u001b[?2004h> "]
[77.233936, "o", "                Field curveField;\r\n\u001b[?2004l\r"]
[77.233983, "o", "\u001b[?2004h> "]
[77.234144, "o", "                try {\r\n\u001b[?2004l\r"]
[77.234191, "o", "\u001b[?2004h> "]
[77.234689, "o", "                    curveField = Interpolation.class.getField(curveName);\r\n\u001b[?2004l\r"]
[77.234737, "o", "\u001b[?2004h> "]
[77.235102, "o", "                } catch (NoSuchFieldException e) {\r\n\u001b[?2004l\r\u001b[?2004h"]
[77.235247, "o", "> "]
