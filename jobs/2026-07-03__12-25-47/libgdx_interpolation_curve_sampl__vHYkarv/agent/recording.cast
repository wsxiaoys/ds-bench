[77.248018, "o", "\u001b[?2004h> "]
[77.248178, "o", "            float t;\r\n\u001b[?2004l\r"]
[77.248259, "o", "\u001b[?2004h> "]
[77.248464, "o", "            if (i == samples - 1) {\r\n\u001b[?2004l\r"]
[77.248532, "o", "\u001b[?2004h> "]
[77.248697, "o", "                t = 1.0f;\r\n\u001b[?2004l\r"]
[77.248762, "o", "\u001b[?2004h> "]
[77.248896, "o", "            } else {\r\n\u001b[?2004l\r"]
[77.248959, "o", "\u001b[?2004h> "]
