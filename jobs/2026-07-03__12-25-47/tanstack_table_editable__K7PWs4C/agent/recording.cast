[441.395116, "i", "cat > src/index.css << 'EOF'\n:root {\n  font-family: system-ui, -apple-system, sans-serif;\n  line-height: 1.5;\n  color: #213547;\n  background-color: #ffffff;\n}\n\n* {\n  box-sizing: border-box;\n}\n\nbody {\n  margin: 0;\n  min-width: 320px;\n  min-height: 100vh;\n  padding: 20px;\n  background-color: #f6f7f9;\n}\n\n.app {\n  max-width: 960px;\n  margin: 0 REDACTED;\n}\n\nh1 {\n  margin: 0 0 20px;\n  font-size: 1.5rem;\n  text-align: center;\n}\n\ntable {\n  width: 100%;\n  border-collapse: collapse;\n  background: #fff;\n  box-shadow: 0 1px 4px rgba(0, 0, 0, 0.08);\n}\n\nthead {\n  background: #f1f3f5;\n}\n\nth, td {\n  text-align: left;\n  padding: 10px 12px;\n  border-bottom: 1px solid #e9ecef;\n  font-size: 0.95rem;\n}\n\nth {\n  font-weight: 600;\n  color: #495057;\n}\n\ntr:hover {\n  background: #fafbfc;\n}\n\nbutton {\n  border: none;\n  border-radius: 6px;\n  padding: 6px 12px;\n  font-size: 0.85rem;\n  cursor: pointer;\n  margin-right: 6px;\n  font-weight: 500;\n  transition: opacity 0.15s;\n}\n\nbutton:hover {\n  opacity: 0.85;\n}\n\n.btn-edit {\n  background-color: #0d6efd;\n  color: #fff;\n}\n\n.btn-save {\n  background-color: #198754;\n  color: #fff;\n}\n\n.btn-cancel {\n  background-color: #6c757d;\n  color: #fff;\n}\n\ninput, select {\n  width: 100%;\n  padding: 6px 8px;\n  border: 1px solid #ced4da;\n  border-radius: 4px;\n  font-size: 0.9rem;\n  font-family: inherit;\n}\n\ninput:focus, select:focus {\n  outline: none;\n  border-color: #0d6efd;\n  box-shadow: 0 0 0 2px rgba(13, 110, 253, 0.15);\n}\n\n.error {\n  color: #dc3545;\n  font-size: 0.8rem;\n  margin-top: 2px;\n}\nEOF\n"]
