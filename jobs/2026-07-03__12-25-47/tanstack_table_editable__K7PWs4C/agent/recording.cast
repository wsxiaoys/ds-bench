[441.844206, "o", "drwxr-xr-x 2 root root   70 Jul  3 13:45 \u001b[0m\u001b[01;34m.\u001b[0m\r\ndrwxr-xr-x 1 root root  181 Jul  3 13:45 \u001b[01;34m..\u001b[0m\r\n-rw-r--r-- 1 root root  202 Jul  3 13:45 App.tsx\r\n-rw-r--r-- 1 root root 1480 Jul  3 13:45 index.css\r\n-rw-r--r-- 1 root root  226 Jul  3 13:45 main.tsx\r\n"]
