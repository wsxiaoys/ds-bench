[587.050679, "o", "import { api } from \"encore.dev/api\";\r\n\r\ninterface UserResponse {\r\n  id: number;\r\n  name: string;\r\n}\r\n\r\nexport const get = api(\r\n  { expose: true, method: \"GET\", path: \"/user/:id\" },\r\n  async ({ id }: { id: number }): Promise<UserResponse> => {\r\n    if (id === 1) {\r\n      return { id, name: \"Alice\" };\r\n    }\r\n    return { id, name: \"Unknown\" };\r\n  }\r\n);\r\n"]
[587.050824, "o", "\u001b[?2004hroot@eb01642a-0882-45ef-8fd9-31237070486e:/home/user/myapp# "]
[587.445606, "i", "cat /home/user/myapp/order/order.ts\n"]
[587.445818, "o", "cat /home/user/myapp/order/order.ts\r\n\u001b[?2004l\r"]
[587.446723, "o", "import { api } from \"encore.dev/api\";\r\nimport { user } from \"~encore/clients\";\r\n\r\ninterface OrderResponse {\r\n  orderId: number;\r\n  userId: number;\r\n  userName: string;\r\n}\r\n\r\nexport const get = api(\r\n  { expose: true, method: \"GET\", path: \"/order/:id\" },\r\n  async ({ id }: { id: number }): Promise<OrderResponse> => {\r\n    const u = await user.get({ id: 1 });\r\n    return {\r\n      orderId: id,\r\n      userId: u.id,\r\n      userName: u.name,\r\n    };\r\n  }\r\n);\r\n"]
