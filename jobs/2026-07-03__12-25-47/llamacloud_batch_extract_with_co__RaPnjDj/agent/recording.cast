[190.455906, "o", "const { LlamaCloud } = require('@llamaindex/llama-cloud') as typeof import('@llamaindex/llama-cloud');\r\n\u001b[?2004l\r"]
[190.455965, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[190.456142, "o", "// ---------- Zod schema for Invoice ----------\r\n\u001b[?2004l\r"]
[190.456178, "o", "\u001b[?2004h> "]
[190.4563, "o", "const InvoiceSchema = z.object({\r\n\u001b[?2004l\r\u001b[?2004h"]
[190.456331, "o", "> "]
[190.456412, "o", "  vendor_name: z.string(),\r\n\u001b[?2004l\r"]
[190.456445, "o", "\u001b[?2004h> "]
[190.456545, "o", "  invoice_number: z.string(),\r\n\u001b[?2004l\r"]
[190.456622, "o", "\u001b[?2004h> "]
[190.456678, "o", "  total_amount: z.number(),\r\n\u001b[?2004l\r"]
[190.456703, "o", "\u001b[?2004h> "]
[190.456832, "o", "  currency: z.string().length(3),\r\n\u001b[?2004l\r"]
[190.456858, "o", "\u001b[?2004h> });\r\n\u001b[?2004l\r"]
[190.456929, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[190.457111, "o", "const dataSchema = z.toJSONSchema(InvoiceSchema, {\r\n\u001b[?2004l\r\u001b[?2004h"]
[190.457181, "o", "> "]
[190.457252, "o", "  target: 'draft-7',\r\n\u001b[?2004l\r\u001b[?2004h> "]
[190.457312, "o", "  metadata: 'none',\r\n\u001b[?2004l\r"]
[190.457344, "o", "\u001b[?2004h> });\r\n\u001b[?2004l\r\u001b[?2004h"]
[190.457424, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[190.457605, "o", "// ---------- Discover PDFs (case-insensitive) ----------\r\n\u001b[?2004l\r\u001b[?2004h"]
[190.457639, "o", "> "]
[190.457797, "o", "const INVOICES_DIR = '/home/user/myproject/invoices';\r\n\u001b[?2004l\r"]
[190.457823, "o", "\u001b[?2004h> "]
[190.458027, "o", "const RESULTS_PATH = '/home/user/myproject/results.json';\r\n\u001b[?2004l\r"]
[190.458072, "o", "\u001b[?2004h> "]
[190.458221, "o", "const LOG_PATH = '/home/user/myproject/output.log';\r\n\u001b[?2004l\r"]
[190.458252, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[190.458289, "o", "\u001b[?2004h> "]
[190.458429, "o", "function discoverPdfs(dir: string): string[] {\r\n\u001b[?2004l\r\u001b[?2004h"]
[190.458469, "o", "> "]
[190.458664, "o", "  const entries = fs.readdirSync(dir, { withFileTypes: true });\r\n\u001b[?2004l\r"]
[190.458697, "o", "\u001b[?2004h> "]
[190.458816, "o", "  const out: string[] = [];\r\n\u001b[?2004l\r\u001b[?2004h"]
[190.45888, "o", "> "]
[190.458949, "o", "  for (const e of entries) {\r\n\u001b[?2004l\r\u001b[?2004h"]
[190.458977, "o", "> "]
[190.459096, "o", "    if (!e.isFile()) continue;\r\n\u001b[?2004l\r\u001b[?2004h"]
[190.45916, "o", "> "]
[190.459239, "o", "    if (e.name.toLowerCase().endsWith('.pdf')) {\r\n\u001b[?2004l\r"]
[190.459264, "o", "\u001b[?2004h> "]
[190.459378, "o", "      out.push(path.join(dir, e.name));\r\n\u001b[?2004l\r"]
[190.459402, "o", "\u001b[?2004h> "]
[190.459495, "o", "    }\r\n\u001b[?2004l\r\u001b[?2004h>   }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[190.459554, "o", "  out.sort();\r\n\u001b[?2004l\r\u001b[?2004h> "]
[190.459602, "o", "  return out;\r\n\u001b[?2004l\r"]
[190.459627, "o", "\u001b[?2004h> }\r\n\u001b[?2004l\r"]
[190.459696, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[190.459872, "o", "// ---------- Per-job polling with client-side timeout ----------\r\n\u001b[?2004l\r\u001b[?2004h"]
[190.459935, "o", "> "]
[190.459995, "o", "const PER_JOB_TIMEOUT_MS = 240 * 1000;\r\n\u001b[?2004l\r"]
[190.460022, "o", "\u001b[?2004h> "]
[190.460181, "o", "const TERMINAL = new Set(['COMPLETED', 'FAILED', 'CANCELLED']);\r\n\u001b[?2004l\r"]
[190.460207, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[190.46023, "o", "> "]
[190.46031, "o", "interface ResultEntry {\r\n\u001b[?2004l\r\u001b[?2004h"]
[190.460334, "o", "> "]
[190.460375, "o", "  file: string;\r\n\u001b[?2004l\r"]
[190.460398, "o", "\u001b[?2004h> "]
[190.46051, "o", "  status: 'success' | 'error';\r\n\u001b[?2004l\r\u001b[?2004h> "]
[190.460628, "o", "  data?: Record<string, unknown>;\r\n\u001b[?2004l\r\u001b[?2004h"]
[190.460674, "o", "> "]
[190.460722, "o", "  error?: string;\r\n\u001b[?2004l\r"]
[190.46076, "o", "\u001b[?2004h> }\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[190.460784, "o", "\u001b[?2004h> "]
[190.460909, "o", "function sleep(ms: number): Promise<void> {\r\n\u001b[?2004l\r"]
[190.460933, "o", "\u001b[?2004h> "]
[190.461069, "o", "  return new Promise((res) => setTimeout(res, ms));\r\n\u001b[?2004l\r"]
[190.461094, "o", "\u001b[?2004h> }\r\n\u001b[?2004l\r"]
[190.461171, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[190.461251, "o", "async function pollUntilTerminal(\r\n\u001b[?2004l\r"]
[190.461275, "o", "\u001b[?2004h> "]
[190.461388, "o", "  client: InstanceType<typeof LlamaCloud>,\r\n\u001b[?2004l\r"]
[190.461447, "o", "\u001b[?2004h> "]
[190.461487, "o", "  jobId: string,\r\n\u001b[?2004l\r\u001b[?2004h> "]
[190.461554, "o", "  timeoutMs: number,\r\n\u001b[?2004l\r"]
[190.461578, "o", "\u001b[?2004h> "]
[190.461698, "o", "): Promise<{ job: any; timedOut: boolean }> {\r\n\u001b[?2004l\r"]
[190.461721, "o", "\u001b[?2004h> "]
[190.461799, "o", "  const start = Date.now();\r\n\u001b[?2004l\r"]
[190.461823, "o", "\u001b[?2004h> "]
[190.461948, "o", "  while (Date.now() - start < timeoutMs) {\r\n\u001b[?2004l\r\u001b[?2004h"]
[190.462008, "o", "> "]
[190.462128, "o", "    const job: any = await client.extract.get(jobId);\r\n\u001b[?2004l\r\u001b[?2004h> "]
[190.462239, "o", "    if (TERMINAL.has(job.status)) {\r\n\u001b[?2004l\r"]
[190.462275, "o", "\u001b[?2004h> "]
[190.462365, "o", "      return { job, timedOut: false };\r\n\u001b[?2004l\r\u001b[?2004h"]
[190.462389, "o", ">     }\r\n\u001b[?2004l\r\u001b[?2004h"]
[190.462419, "o", "> "]
[190.462474, "o", "    await sleep(2000);\r\n\u001b[?2004l\r\u001b[?2004h"]
[190.462498, "o", ">   }\r\n\u001b[?2004l\r"]
[190.462519, "o", "\u001b[?2004h> "]
[190.462718, "o", "  // Timed out: do one final get for completeness, but treat as failure.\r\n\u001b[?2004l\r\u001b[?2004h"]
[190.462751, "o", "> "]
[190.462836, "o", "  let last: any = null;\r\n\u001b[?2004l\r\u001b[?2004h>   try {\r\n\u001b[?2004l\r"]
[190.462882, "o", "\u001b[?2004h> "]
[190.462979, "o", "    last = await client.extract.get(jobId);\r\n\u001b[?2004l\r"]
[190.46304, "o", "\u001b[?2004h> "]
[190.463072, "o", "  } catch (e) {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[190.463131, "o", "    // ignore\r\n\u001b[?2004l\r\u001b[?2004h"]
[190.463157, "o", ">   }\r\n\u001b[?2004l\r"]
[190.463218, "o", "\u001b[?2004h> "]
[190.463304, "o", "  return { job: last, timedOut: true };\r\n\u001b[?2004l\r"]
[190.463379, "o", "\u001b[?2004h> }\r\n\u001b[?2004l\r"]
[190.463411, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[190.463545, "o", "// ---------- Process a single file end-to-end ----------\r\n\u001b[?2004l\r"]
[190.463577, "o", "\u001b[?2004h> "]
[190.463647, "o", "async function processFile(\r\n\u001b[?2004l\r"]
[190.463711, "o", "\u001b[?2004h> "]
[190.463806, "o", "  client: InstanceType<typeof LlamaCloud>,\r\n\u001b[?2004l\r\u001b[?2004h"]
[190.46384, "o", "> "]
[190.463873, "o", "  filePath: string,\r\n\u001b[?2004l\r"]
[190.463909, "o", "\u001b[?2004h> "]
[190.463981, "o", "): Promise<ResultEntry> {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[190.464074, "o", "  const base = path.basename(filePath);\r\n\u001b[?2004l\r"]
[190.464113, "o", "\u001b[?2004h> "]
[190.464138, "o", "  try {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[190.464205, "o", "    // 1. Upload\r\n\u001b[?2004l\r\u001b[?2004h"]
[190.464237, "o", "> "]
[190.464391, "o", "    const uploaded: any = await client.files.create({\r\n\u001b[?2004l\r"]
[190.46443, "o", "\u001b[?2004h> "]
[190.464546, "o", "      file: fs.createReadStream(filePath),\r\n\u001b[?2004l\r\u001b[?2004h"]
[190.464578, "o", "> "]
[190.464647, "o", "      purpose: 'extract',\r\n\u001b[?2004l\r"]
[190.46468, "o", "\u001b[?2004h> "]
[190.464753, "o", "    });\r\n\u001b[?2004l\r\u001b[?2004h> "]
[190.464856, "o", "    const fileId: string = uploaded.id;\r\n\u001b[?2004l\r\u001b[?2004h"]
[190.464895, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[190.464995, "o", "    // 2. Create extract job\r\n\u001b[?2004l\r\u001b[?2004h"]
[190.465038, "o", "> "]
[190.465156, "o", "    const job: any = await client.extract.create({\r\n\u001b[?2004l\r"]
[190.465187, "o", "\u001b[?2004h> "]
[190.465259, "o", "      file_input: fileId,\r\n\u001b[?2004l\r"]
[190.465295, "o", "\u001b[?2004h> "]
[190.465347, "o", "      configuration: {\r\n\u001b[?2004l\r"]
[190.465387, "o", "\u001b[?2004h> "]
[190.46551, "o", "        data_schema: dataSchema as any,\r\n\u001b[?2004l\r"]
[190.465566, "o", "\u001b[?2004h> "]
[190.465664, "o", "        extraction_target: 'per_doc',\r\n\u001b[?2004l\r\u001b[?2004h"]
[190.465691, "o", "> "]
[190.465767, "o", "        tier: 'cost_effective',\r\n\u001b[?2004l\r"]
[190.465794, "o", "\u001b[?2004h> "]
[190.465825, "o", "      },\r\n\u001b[?2004l\r\u001b[?2004h"]
[190.465913, "o", ">     });\r\n\u001b[?2004l\r"]
[190.46594, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[190.466021, "o", "    // 3. Poll with per-job timeout\r\n\u001b[?2004l\r"]
[190.466045, "o", "\u001b[?2004h> "]
[190.466226, "o", "    const { job: finalJob, timedOut } = await pollUntilTerminal(\r\n\u001b[?2004l\r"]
[190.46626, "o", "\u001b[?2004h> "]
[190.466317, "o", "      client,\r\n\u001b[?2004l\r\u001b[?2004h> "]
[190.466356, "o", "      job.id,\r\n\u001b[?2004l\r\u001b[?2004h"]
[190.46638, "o", "> "]
[190.466455, "o", "      PER_JOB_TIMEOUT_MS,\r\n\u001b[?2004l\r"]
[190.466479, "o", "\u001b[?2004h> "]
[190.466538, "o", "    );\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[190.466658, "o", "    if (timedOut) {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[190.466683, "o", "      return {\r\n\u001b[?2004l\r\u001b[?2004h"]
[190.466706, "o", "> "]
[190.466769, "o", "        file: base,\r\n\u001b[?2004l\r\u001b[?2004h"]
[190.466793, "o", "> "]
[190.466857, "o", "        status: 'error',\r\n\u001b[?2004l\r"]
[190.466879, "o", "\u001b[?2004h> "]
[190.467182, "o", "        error: `Job ${job.id} did not reach terminal status within ${PER_JOB_TIMEOUT_MS / 1000}s`,\r\n\u001b[?2004l\r\u001b[?2004h"]
[190.46721, "o", ">       };\r\n"]
[190.467239, "o", "\u001b[?2004l\r\u001b[?2004h"]
[190.467262, "o", ">     }\r\n\u001b[?2004l\r"]
[190.467286, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[190.467486, "o", "\u001b[?2004h> "]
[190.467541, "o", "    if (finalJob.status === 'COMPLETED') {\r\n\u001b[?2004l\r\u001b[?2004h"]
[190.467622, "o", ">       const data = finalJob.extract_result ?? {};\r\n"]
[190.467652, "o", "\u001b[?2004l\r\u001b[?2004h"]
[190.467717, "o", ">       return {\r\n\u001b[?2004l\r\u001b[?2004h"]
[190.467741, "o", "> "]
[190.467794, "o", "        file: base,\r\n\u001b[?2004l\r"]
[190.467901, "o", "\u001b[?2004h> "]
[190.467967, "o", "        status: 'success',\r\n\u001b[?2004l\r\u001b[?2004h> "]
[190.468078, "o", "        data: data as Record<string, unknown>,\r\n\u001b[?2004l\r\u001b[?2004h"]
[190.468107, "o", "> "]
[190.468171, "o", "      };\r\n\u001b[?2004l\r\u001b[?2004h> "]
[190.468198, "o", "    }\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[190.46822, "o", "> "]
[190.468351, "o", "    if (finalJob.status === 'FAILED') {\r\n\u001b[?2004l\r\u001b[?2004h"]
[190.468399, "o", ">       return {\r\n\u001b[?2004l\r"]
[190.468425, "o", "\u001b[?2004h> "]
[190.468518, "o", "        file: base,\r\n\u001b[?2004l\r\u001b[?2004h"]
[190.468563, "o", "> "]
[190.468603, "o", "        status: 'error',\r\n\u001b[?2004l\r\u001b[?2004h> "]
[190.46879, "o", "        error: finalJob.error_message ?? `Job ${job.id} failed`,\r\n\u001b[?2004l\r\u001b[?2004h"]
[190.468843, "o", ">       };\r\n\u001b[?2004l\r\u001b[?2004h> "]
[190.468884, "o", "    }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[190.468927, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[190.469018, "o", "    // CANCELLED or other terminal\r\n\u001b[?2004l\r"]
[190.469042, "o", "\u001b[?2004h> "]
[190.469123, "o", "    return {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[190.469169, "o", "      file: base,"]
[190.469204, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[190.469286, "o", "      status: 'error',\r\n\u001b[?2004l\r\u001b[?2004h"]
[190.469327, "o", "> "]
[190.469501, "o", "      error: `Job ${job.id} ended with status ${finalJob.status}`,\r\n\u001b[?2004l\r\u001b[?2004h> "]
[190.469539, "o", "    };\r\n\u001b[?2004l\r\u001b[?2004h"]
[190.469571, "o", "> "]
[190.469639, "o", "  } catch (err: any) {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[190.469683, "o", "    return {\r\n\u001b[?2004l\r"]
[190.469709, "o", "\u001b[?2004h> "]
[190.46978, "o", "      file: base,\r\n\u001b[?2004l\r\u001b[?2004h> "]
[190.469841, "o", "      status: 'error',\r\n\u001b[?2004l\r"]
[190.46986, "o", "\u001b[?2004h> "]
[190.469965, "o", "      error: err?.message ?? String(err),\r\n\u001b[?2004l\r"]
[190.469997, "o", "\u001b[?2004h>     };\r\n"]
[190.470034, "o", "\u001b[?2004l\r\u001b[?2004h>   }\r\n\u001b[?2004l\r"]
[190.470057, "o", "\u001b[?2004h> }\r\n\u001b[?2004l\r"]
[190.47008, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[190.47013, "o", "\u001b[?2004h> "]
[190.470176, "o", "// ---------- Main ----------\r\n\u001b[?2004l\r"]
[190.470197, "o", "\u001b[?2004h> "]
[190.470305, "o", "async function main(): Promise<void> {\r\n\u001b[?2004l\r"]
[190.470357, "o", "\u001b[?2004h> "]
[190.470446, "o", "  if (!process.env.LLAMA_CLOUD_API_KEY) {\r\n\u001b[?2004l\r"]
[190.470487, "o", "\u001b[?2004h> "]
[190.470621, "o", "    throw new Error('LLAMA_CLOUD_API_KEY is not set');\r\n\u001b[?2004l\r\u001b[?2004h"]
[190.470658, "o", ">   }\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[190.47068, "o", "\u001b[?2004h> "]
[190.470887, "o", "  const client = new LlamaCloud({ apiKey: process.env.LLAMA_CLOUD_API_KEY });\r\n\u001b[?2004l\r"]
[190.470906, "o", "\u001b[?2004h> "]
[190.47096, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[190.471042, "o", "  const pdfs = discoverPdfs(INVOICES_DIR);\r\n\u001b[?2004l\r"]
[190.471063, "o", "\u001b[?2004h> "]
[190.471154, "o", "  const logLines: string[] = [];\r\n\u001b[?2004l\r\u001b[?2004h"]
[190.471189, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[190.471248, "o", "  const limit = pLimit(3);\r\n\u001b[?2004l\r"]
[190.471299, "o", "\u001b[?2004h> "]
[190.471359, "o", "  const tasks = pdfs.map((p) =>\r\n\u001b[?2004l\r"]
[190.471381, "o", "\u001b[?2004h> "]
[190.471478, "o", "    limit(async () => {\r\n\u001b[?2004l\r\u001b[?2004h"]
[190.471518, "o", "> "]
[190.471614, "o", "      console.log(`Starting ${path.basename(p)}`);\r\n\u001b[?2004l\r"]
[190.471636, "o", "\u001b[?2004h> "]
[190.471759, "o", "      const r = await processFile(client, p);\r\n\u001b[?2004l\r"]
[190.471784, "o", "\u001b[?2004h> "]
[190.471919, "o", "      const line = `PROCESSED ${r.file}: ${r.status}`;\r\n\u001b[?2004l\r"]
[190.471939, "o", "\u001b[?2004h> "]
[190.472029, "o", "      logLines.push(line);\r\n\u001b[?2004l\r"]
