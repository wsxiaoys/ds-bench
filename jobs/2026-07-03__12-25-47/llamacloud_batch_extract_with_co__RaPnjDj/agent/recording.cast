[361.815867, "o", "> "]
[361.816024, "o", "// ---------- Per-job polling with client-side timeout ----------\r\n\u001b[?2004l\r"]
[361.816047, "o", "\u001b[?2004h> "]
[361.816151, "o", "const PER_JOB_TIMEOUT_MS = 240 * 1000;\r\n\u001b[?2004l\r"]
[361.816174, "o", "\u001b[?2004h> "]
[361.816337, "o", "const TERMINAL = new Set(['COMPLETED', 'FAILED', 'CANCELLED']);\r\n\u001b[?2004l\r"]
[361.81636, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[361.816382, "o", "\u001b[?2004h> "]
[361.816462, "o", "interface ResultEntry {\r\n\u001b[?2004l\r\u001b[?2004h"]
[361.816485, "o", "> "]
[361.81653, "o", "  file: string;\r\n\u001b[?2004l\r"]
[361.816553, "o", "\u001b[?2004h> "]
[361.81664, "o", "  status: 'success' | 'error';\r\n\u001b[?2004l\r"]
[361.816663, "o", "\u001b[?2004h> "]
[361.816753, "o", "  data?: Record<string, unknown>;\r\n\u001b[?2004l\r"]
[361.816776, "o", "\u001b[?2004h> "]
[361.816835, "o", "  error?: string;\r\n\u001b[?2004l\r\u001b[?2004h"]
[361.816859, "o", "> }\r\n\u001b[?2004l\r"]
[361.816881, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[361.816904, "o", "\u001b[?2004h> "]
[361.817027, "o", "function sleep(ms: number): Promise<void> {\r\n\u001b[?2004l\r"]
[361.81705, "o", "\u001b[?2004h> "]
[361.817185, "o", "  return new Promise((res) => setTimeout(res, ms));\r\n\u001b[?2004l\r"]
[361.817221, "o", "\u001b[?2004h> }\r\n\u001b[?2004l\r"]
[361.817245, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[361.817269, "o", "\u001b[?2004h> "]
[361.817361, "o", "async function pollUntilTerminal(\r\n\u001b[?2004l\r"]
[361.817385, "o", "\u001b[?2004h> "]
[361.817504, "o", "  client: InstanceType<typeof LlamaCloud>,\r\n\u001b[?2004l\r"]
[361.817527, "o", "\u001b[?2004h> "]
[361.817578, "o", "  jobId: string,\r\n\u001b[?2004l\r"]
[361.817601, "o", "\u001b[?2004h> "]
[361.817665, "o", "  timeoutMs: number,\r\n\u001b[?2004l\r"]
[361.817687, "o", "\u001b[?2004h> "]
[361.817807, "o", "): Promise<{ job: any; timedOut: boolean }> {\r\n\u001b[?2004l\r"]
[361.81783, "o", "\u001b[?2004h> "]
[361.817906, "o", "  const start = Date.now();\r\n\u001b[?2004l\r"]
[361.817928, "o", "\u001b[?2004h> "]
[361.818041, "o", "  while (Date.now() - start < timeoutMs) {\r\n\u001b[?2004l\r"]
[361.818065, "o", "\u001b[?2004h> "]
[361.818203, "o", "    const job: any = await client.extract.get(jobId);\r\n\u001b[?2004l\r"]
[361.818225, "o", "\u001b[?2004h> "]
[361.818322, "o", "    if (TERMINAL.has(job.status)) {\r\n\u001b[?2004l\r"]
[361.818345, "o", "\u001b[?2004h> "]
[361.818451, "o", "      return { job, timedOut: false };\r\n\u001b[?2004l\r"]
[361.818473, "o", "\u001b[?2004h> "]
[361.818496, "o", "    }\r\n\u001b[?2004l\r"]
[361.818549, "o", "\u001b[?2004h> "]
[361.818592, "o", "    await sleep(2000);\r\n\u001b[?2004l\r"]
[361.818615, "o", "\u001b[?2004h>   }"]
[361.818637, "o", "\r\n\u001b[?2004l\r\u001b[?2004h"]
[361.81866, "o", "> "]
[361.81884, "o", "  // Timed out: do one final get for completeness, but treat as failure.\r\n\u001b[?2004l\r"]
[361.818863, "o", "\u001b[?2004h> "]
[361.818932, "o", "  let last: any = null;\r\n\u001b[?2004l\r"]
[361.818954, "o", "\u001b[?2004h> "]
[361.818985, "o", "  try {\r\n\u001b[?2004l\r"]
[361.819008, "o", "\u001b[?2004h> "]
[361.819124, "o", "    last = await client.extract.get(jobId);\r\n\u001b[?2004l\r"]
[361.819147, "o", "\u001b[?2004h> "]
[361.819195, "o", "  } catch {\r\n\u001b[?2004l\r\u001b[?2004h"]
[361.819218, "o", "> "]
[361.819264, "o", "    // ignore\r\n\u001b[?2004l\r\u001b[?2004h"]
[361.819287, "o", ">   }\r\n\u001b[?2004l\r"]
[361.81931, "o", "\u001b[?2004h> "]
[361.819422, "o", "  return { job: last, timedOut: true };\r\n\u001b[?2004l\r"]
[361.819451, "o", "\u001b[?2004h> }\r\n\u001b[?2004l\r"]
[361.819476, "o", "\u001b[?2004h"]
[361.8195, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[361.819663, "o", "// ---------- Process a single file end-to-end ----------\r\n\u001b[?2004l\r"]
[361.819687, "o", "\u001b[?2004h> "]
[361.819763, "o", "async function processFile(\r\n\u001b[?2004l\r"]
[361.819786, "o", "\u001b[?2004h> "]
[361.819897, "o", "  client: InstanceType<typeof LlamaCloud>,\r\n\u001b[?2004l\r"]
[361.81992, "o", "\u001b[?2004h> "]
[361.81998, "o", "  filePath: string,\r\n\u001b[?2004l\r"]
[361.820002, "o", "\u001b[?2004h> "]
[361.820087, "o", "): Promise<ResultEntry> {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[361.820198, "o", "  const base = path.basename(filePath);\r\n\u001b[?2004l\r"]
[361.820222, "o", "\u001b[?2004h> "]
[361.820244, "o", "  try {\r\n\u001b[?2004l\r"]
[361.8203, "o", "\u001b[?2004h> "]
[361.820323, "o", "    // 1. Upload\r\n\u001b[?2004l\r"]
[361.820366, "o", "\u001b[?2004h> "]
[361.820501, "o", "    const uploaded: any = await client.files.create({\r\n\u001b[?2004l\r"]
[361.820524, "o", "\u001b[?2004h> "]
[361.820644, "o", "      file: fs.createReadStream(filePath),\r\n\u001b[?2004l\r"]
[361.820669, "o", "\u001b[?2004h> "]
[361.820739, "o", "      purpose: 'extract',\r\n\u001b[?2004l\r"]
[361.820763, "o", "\u001b[?2004h> "]
[361.820786, "o", "    });\r\n\u001b[?2004l\r"]
[361.820809, "o", "\u001b[?2004h> "]
[361.82092, "o", "    const fileId: string = uploaded.id;\r\n\u001b[?2004l\r"]
[361.820944, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[361.820966, "o", "\u001b[?2004h> "]
[361.821051, "o", "    // 2. Create extract job\r\n\u001b[?2004l\r"]
[361.821073, "o", "\u001b[?2004h> "]
[361.821203, "o", "    const job: any = await client.extract.create({\r\n\u001b[?2004l\r"]
[361.821225, "o", "\u001b[?2004h> "]
[361.821298, "o", "      file_input: fileId,\r\n\u001b[?2004l\r"]
[361.82132, "o", "\u001b[?2004h> "]
[361.821386, "o", "      configuration: {\r\n\u001b[?2004l\r"]
[361.821408, "o", "\u001b[?2004h> "]
[361.821524, "o", "        data_schema: dataSchema as any,\r\n\u001b[?2004l\r"]
[361.821548, "o", "\u001b[?2004h> "]
[361.821647, "o", "        extraction_target: 'per_doc',\r\n\u001b[?2004l\r"]
[361.821669, "o", "\u001b[?2004h> "]
[361.821755, "o", "        tier: 'cost_effective',\r\n\u001b[?2004l\r"]
[361.821778, "o", "\u001b[?2004h> "]
[361.821826, "o", "      },\r\n\u001b[?2004l\r\u001b[?2004h> "]
[361.821861, "o", "    });\r\n\u001b[?2004l\r"]
[361.821898, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[361.82192, "o", "> "]
[361.822011, "o", "    // 3. Poll with per-job timeout\r\n\u001b[?2004l\r"]
[361.822034, "o", "\u001b[?2004h> "]
[361.822197, "o", "    const { job: finalJob, timedOut } = await pollUntilTerminal(\r\n\u001b[?2004l\r"]
[361.82222, "o", "\u001b[?2004h> "]
[361.822266, "o", "      client,\r\n\u001b[?2004l\r"]
[361.822289, "o", "\u001b[?2004h> "]
[361.822335, "o", "      job.id,\r\n\u001b[?2004l\r"]
[361.822357, "o", "\u001b[?2004h> "]
[361.822435, "o", "      PER_JOB_TIMEOUT_MS,\r\n\u001b[?2004l\r"]
[361.822471, "o", "\u001b[?2004h> "]
[361.822494, "o", "    );\r\n\u001b[?2004l\r\u001b[?2004h> "]
[361.822517, "o", "\r\n\u001b[?2004l\r\u001b[?2004h"]
[361.822539, "o", "> "]
[361.822597, "o", "    if (timedOut) {\r\n\u001b[?2004l\r"]
[361.822642, "o", "\u001b[?2004h> "]
[361.822665, "o", "      return {\r\n\u001b[?2004l\r"]
[361.822687, "o", "\u001b[?2004h> "]
[361.822751, "o", "        file: base,\r\n\u001b[?2004l\r"]
[361.822774, "o", "\u001b[?2004h> "]
[361.822846, "o", "        status: 'error',\r\n\u001b[?2004l\r"]
[361.822869, "o", "\u001b[?2004h> "]
[361.823109, "o", "        error: `Job ${job.id} did not reach terminal status within ${PER_JOB_TIMEOUT_MS / 1000}s`,\r\n\u001b[?2004l\r"]
[361.823132, "o", "\u001b[?2004h> "]
[361.82318, "o", "      };\r\n\u001b[?2004l\r\u001b[?2004h> "]
[361.823202, "o", "    }\r\n\u001b[?2004l\r"]
[361.823246, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[361.823269, "o", "> "]
[361.823375, "o", "    if (finalJob.status === 'COMPLETED') {\r\n\u001b[?2004l\r"]
[361.823398, "o", "\u001b[?2004h> "]
[361.82355, "o", "      const data = finalJob.extract_result ?? {};\r\n\u001b[?2004l\r"]
[361.823574, "o", "\u001b[?2004h> "]
[361.82362, "o", "      return {\r\n\u001b[?2004l\r"]
[361.823644, "o", "\u001b[?2004h> "]
[361.823701, "o", "        file: base,\r\n\u001b[?2004l\r"]
[361.823725, "o", "\u001b[?2004h> "]
[361.823802, "o", "        status: 'success',\r\n\u001b[?2004l\r"]
[361.823825, "o", "\u001b[?2004h> "]
[361.823946, "o", "        data: data as Record<string, unknown>,\r\n\u001b[?2004l\r"]
[361.823969, "o", "\u001b[?2004h> "]
[361.824005, "o", "      };\r\n\u001b[?2004l\r"]
[361.824029, "o", "\u001b[?2004h> "]
[361.824054, "o", "    }\r\n\u001b[?2004l\r\u001b[?2004h"]
[361.824076, "o", "> \r\n\u001b[?2004l\r"]
[361.824108, "o", "\u001b[?2004h> "]
[361.824214, "o", "    if (finalJob.status === 'FAILED') {\r\n\u001b[?2004l\r"]
[361.824238, "o", "\u001b[?2004h> "]
[361.824288, "o", "      return {\r\n\u001b[?2004l\r"]
[361.824311, "o", "\u001b[?2004h> "]
[361.824368, "o", "        file: base,\r\n\u001b[?2004l\r"]
[361.824391, "o", "\u001b[?2004h> "]
[361.824479, "o", "        status: 'error',\r\n\u001b[?2004l\r\u001b[?2004h"]
[361.824502, "o", "> "]
[361.824657, "o", "        error: finalJob.error_message ?? `Job ${job.id} failed`,\r\n\u001b[?2004l\r"]
[361.82468, "o", "\u001b[?2004h> "]
[361.824705, "o", "      };\r\n\u001b[?2004l\r"]
[361.824736, "o", "\u001b[?2004h> "]
[361.824761, "o", "    }\r\n\u001b[?2004l\r\u001b[?2004h"]
[361.824784, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h"]
[361.824807, "o", "> "]
[361.824909, "o", "    // CANCELLED or other terminal\r\n\u001b[?2004l\r\u001b[?2004h"]
[361.824932, "o", "> "]
[361.824979, "o", "    return {\r\n\u001b[?2004l\r\u001b[?2004h"]
[361.825002, "o", "> "]
[361.825051, "o", "      file: base,\r\n\u001b[?2004l\r"]
[361.825074, "o", "\u001b[?2004h> "]
[361.82514, "o", "      status: 'error',\r\n\u001b[?2004l\r"]
[361.825162, "o", "\u001b[?2004h> "]
[361.825331, "o", "      error: `Job ${job.id} ended with status ${finalJob.status}`,\r\n\u001b[?2004l\r"]
[361.825353, "o", "\u001b[?2004h> "]
[361.825376, "o", "    };\r\n\u001b[?2004l\r"]
[361.825398, "o", "\u001b[?2004h> "]
[361.825478, "o", "  } catch (err: any) {\r\n\u001b[?2004l\r\u001b[?2004h"]
[361.825501, "o", "> "]
[361.825549, "o", "    return {\r\n\u001b[?2004l\r\u001b[?2004h"]
[361.825571, "o", "> "]
[361.825622, "o", "      file: base,\r\n\u001b[?2004l\r"]
[361.825644, "o", "\u001b[?2004h> "]
[361.825708, "o", "      status: 'error',\r\n\u001b[?2004l\r"]
[361.825731, "o", "\u001b[?2004h> "]
[361.825842, "o", "      error: err?.message ?? String(err),\r\n\u001b[?2004l\r"]
[361.825865, "o", "\u001b[?2004h> "]
[361.825888, "o", "    };\r\n\u001b[?2004l\r"]
[361.825911, "o", "\u001b[?2004h> "]
[361.825934, "o", "  }\r\n\u001b[?2004l\r\u001b[?2004h"]
[361.825961, "o", "> }\r\n\u001b[?2004l\r"]
[361.825986, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[361.82601, "o", "\u001b[?2004h> "]
[361.826117, "o", "// ---------- Main ----------\r\n\u001b[?2004l\r\u001b[?2004h> "]
[361.826223, "o", "async function main(): Promise<void> {\r\n\u001b[?2004l\r"]
[361.826246, "o", "\u001b[?2004h> "]
[361.826357, "o", "  if (!process.env.LLAMA_CLOUD_API_KEY) {\r\n\u001b[?2004l\r"]
[361.82638, "o", "\u001b[?2004h> "]
[361.826527, "o", "    throw new Error('LLAMA_CLOUD_API_KEY is not set');\r\n\u001b[?2004l\r"]
[361.826551, "o", "\u001b[?2004h>   }\r\n"]
[361.826574, "o", "\u001b[?2004l\r\u001b[?2004h"]
[361.826598, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h"]
[361.826622, "o", "> "]
[361.826813, "o", "  const client = new LlamaCloud({ apiKey: process.env.LLAMA_CLOUD_API_KEY });\r\n\u001b[?2004l\r"]
[361.826837, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[361.826861, "o", "\u001b[?2004h> "]
[361.827005, "o", "  const pdfs = discoverPdfs(INVOICES_DIR);\r\n\u001b[?2004l\r\u001b[?2004h> "]
[361.827093, "o", "  const logLines: string[] = [];\r\n\u001b[?2004l\r"]
[361.827119, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[361.827142, "o", "\u001b[?2004h> "]
[361.827221, "o", "  const limit = pLimit(3);\r\n\u001b[?2004l\r"]
[361.827244, "o", "\u001b[?2004h> "]
[361.82733, "o", "  const tasks = pdfs.map((p) =>\r\n\u001b[?2004l\r"]
[361.827364, "o", "\u001b[?2004h> "]
[361.827423, "o", "    limit(async () => {\r\n\u001b[?2004l\r"]
[361.827449, "o", "\u001b[?2004h> "]
[361.827584, "o", "      console.log(`Starting ${path.basename(p)}`);\r\n\u001b[?2004l\r"]
[361.827607, "o", "\u001b[?2004h> "]
[361.827726, "o", "      const r = await processFile(client, p);\r\n\u001b[?2004l\r"]
[361.827761, "o", "\u001b[?2004h> "]
[361.827892, "o", "      const line = `PROCESSED ${r.file}: ${r.status}`;\r\n\u001b[?2004l\r"]
[361.827915, "o", "\u001b[?2004h> "]
[361.827993, "o", "      logLines.push(line);\r\n\u001b[?2004l\r"]
[361.828016, "o", "\u001b[?2004h> "]
[361.828085, "o", "      console.log(line);\r\n\u001b[?2004l\r"]
[361.82812, "o", "\u001b[?2004h> "]
[361.82816, "o", "      return r;\r\n\u001b[?2004l\r"]
[361.828193, "o", "\u001b[?2004h> "]
[361.828227, "o", "    }),\r\n\u001b[?2004l\r\u001b[?2004h> "]
[361.828257, "o", "  );\r\n\u001b[?2004l\r"]
[361.82829, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[361.828323, "o", "> "]
[361.828427, "o", "  const results = await Promise.all(tasks);\r\n\u001b[?2004l\r"]
[361.828464, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[361.828498, "o", "\u001b[?2004h> "]
[361.828561, "o", "  // Persist results.json\r\n\u001b[?2004l\r"]
[361.828583, "o", "\u001b[?2004h> "]
[361.828789, "o", "  fs.writeFileSync(RESULTS_PATH, JSON.stringify(results, null, 2));\r\n\u001b[?2004l\r\u001b[?2004h"]
[361.828822, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[361.828921, "o", "  // Summary\r\n\u001b[?2004l\r\u001b[?2004h> "]
[361.829023, "o", "  const total = results.length;\r\n\u001b[?2004l\r\u001b[?2004h> "]
[361.82918, "o", "  const success = results.filter((r) => r.status === 'success').length;\r\n\u001b[?2004l\r"]
[361.829242, "o", "\u001b[?2004h> "]
[361.829303, "o", "  const failed = total - success;\r\n\u001b[?2004l\r\u001b[?2004h"]
[361.829351, "o", "> "]
[361.829569, "o", "  const summary = `SUMMARY total=${total} success=${success} failed=${failed}`;\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[361.829805, "o", "\u001b[?2004h> "]
[361.829862, "o", "  logLines.push(summary);\r\n\u001b[?2004l\r\u001b[?2004h>   fs.writeFileSync(LOG_PATH, logLines.join('\\n') + '\\n');\r\n\u001b[?2004l\r\u001b[?2004h> "]
[361.829975, "o", "  console.log(summary);\r\n\u001b[?2004l\r\u001b[?2004h> }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[361.830504, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> main().catch((err) => {\r\n\u001b[?2004l\r\u001b[?2004h>   console.error('Fatal error:', err);\r\n\u001b[?2004l\r\u001b[?2004h>   process.exit(1);\r\n\u001b[?2004l\r\u001b[?2004h> });\r\n\u001b[?2004l\r\u001b[?2004h> RUNEOF\r\n\u001b[?2004l\r"]
