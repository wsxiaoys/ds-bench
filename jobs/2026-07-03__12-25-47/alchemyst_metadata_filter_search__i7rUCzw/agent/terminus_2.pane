[?2004l[?2004h>   const resp: any = await client.v1.context.search({
[?2004l[?2004h>     query: 'document',
[?2004l[?2004h>     minimum_similarity_threshold: 0,
[?2004l[?2004h>     similarity_threshold: 1,
[?2004l[?2004h>     scope: 'internal',
[?2004l[?2004h>     metadata: 'true',
[?2004l[?2004h>     // camelCase on search per the documented asymmetry
[?2004l[?2004h>     body_metadata: { groupName: [group] },
[?2004l[?2004h>   } as any);
[?2004l[?2004h> 
[?2004l[?2004h>   const contexts: any[] = resp?.contexts ?? [];
