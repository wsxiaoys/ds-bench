[?2004l[?2004h>       names.add(fileName);
[?2004l[?2004h>     }
[?2004l[?2004h>   }
[?2004l[?2004h>   return Array.from(names);
[?2004l[?2004h> }
[?2004l[?2004h> 
[?2004l[?2004h> async function main() {
