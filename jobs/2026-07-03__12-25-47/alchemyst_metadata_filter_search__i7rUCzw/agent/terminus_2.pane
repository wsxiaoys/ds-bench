[?2004l[?2004h>       // eslint-disable-next-line no-console
[?2004l[?2004h>       console.error(`Seeded ${doc.metadata.file_name}`);
[?2004l[?2004h>     } catch (err: any) {
[?2004l[?2004h>       const status: number | undefined =
[?2004l[?2004h>         err?.status ?? err?.statusCode ?? err?.response?.status;
[?2004l[?2004h>       const message: string =
[?2004l[?2004h>         err?.message ?? (typeof err === 'string' ? err : JSON.stringify(err));
[?2004l[?2004h>       // Idempotency: tolerate 409 conflicts (duplicate file_name).
[?2004l[?2004h>       if (status === 409 || /409|conflict|already/i.test(message)) {
[?2004l[?2004h>         // eslint-disable-next-line no-console
[?2004l[?2004h>         console.error(`Already exists, skipping: ${doc.metadata.file_name}`);
[?2004l[?2004h>         continue;
[?2004l[?2004h>       }
[?2004l[?2004h>       throw err;
[?2004l[?2004h>     }
[?2004l[?2004h>   }
[?2004l[?2004h> }
