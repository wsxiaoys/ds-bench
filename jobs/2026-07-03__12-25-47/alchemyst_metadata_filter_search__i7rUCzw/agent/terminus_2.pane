[?2004l[?2004h>     [k: string]: unknown;
[?2004l[?2004h>   }>
[?2004l[?2004h> ): Promise<void> {
[?2004l[?2004h>   for (const doc of documents) {
[?2004l[?2004h>     try {
[?2004l[?2004h>       // Per the task description: store documents with client.v1.context.add,
[?2004l[?2004h>       // putting file_name and group_name (snake_case) under each document's metadata.
[?2004l[?2004h>       await (client.v1.context as any).add({
[?2004l[?2004h>         documents: [doc],
[?2004l[?2004h>         context_type: 'resource',
