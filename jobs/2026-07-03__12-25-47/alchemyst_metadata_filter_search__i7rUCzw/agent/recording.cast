[118.541422, "o", "\u001b[?2004h> "]
[118.541604, "o", "        console.error(`Already exists, skipping: ${doc.metadata.file_name}`);\r\n\u001b[?2004l\r"]
[118.54164, "o", "\u001b[?2004h> "]
[118.541678, "o", "        continue;\r\n\u001b[?2004l\r\u001b[?2004h"]
[118.541704, "o", "> "]
[118.541739, "o", "      }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[118.541793, "o", "      throw err;\r\n\u001b[?2004l\r"]
