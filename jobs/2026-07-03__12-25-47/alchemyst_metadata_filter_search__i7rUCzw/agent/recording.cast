[281.657027, "o", "\u001b[?2004h> "]
[281.657074, "o", "      },\r\n\u001b[?2004l\r\u001b[?2004h> "]
[281.65711, "o", "    },\r\n\u001b[?2004l\r\u001b[?2004h> "]
[281.657145, "o", "    {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[281.65719, "o", "      content:\r\n\u001b[?2004l\r"]
