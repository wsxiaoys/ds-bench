[281.659029, "o", "    {\r\n\u001b[?2004l\r\u001b[?2004h"]
[281.659077, "o", ">       content:\r\n\u001b[?2004l\r"]
[281.659113, "o", "\u001b[?2004h> "]
[281.659386, "o", "        'Engineering postmortem: a brief investigation into an outage in the indexing pipeline on 2025-01-12.',\r\n\u001b[?2004l\r"]
[281.659409, "o", "\u001b[?2004h> "]
[281.659455, "o", "      metadata: {\r\n\u001b[?2004l\r\u001b[?2004h"]
[281.65949, "o", "> "]
[281.659641, "o", "        file_name: `engineering-postmortem-indexing-${runId}.md`,\r\n\u001b[?2004l\r"]
[281.659664, "o", "\u001b[?2004h> "]
[281.659758, "o", "        group_name: ['engineering'],\r\n\u001b[?2004l\r\u001b[?2004h"]
[281.659783, "o", "> "]
[281.659879, "o", "        file_type: 'text/markdown',\r\n\u001b[?2004l\r\u001b[?2004h"]
[281.659905, "o", "> "]
[281.659953, "o", "      },\r\n\u001b[?2004l\r\u001b[?2004h> "]
[281.659989, "o", "    },\r\n\u001b[?2004l\r\u001b[?2004h> "]
[281.660013, "o", "  ];\r\n\u001b[?2004l\r\u001b[?2004h"]
[281.660058, "o", "> }\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[281.660094, "o", "\u001b[?2004h> "]
[281.660188, "o", "async function addDocumentsIdempotently(\r\n\u001b[?2004l\r"]
[281.660213, "o", "\u001b[?2004h> "]
[281.660271, "o", "  client: AlchemystAI,\r\n\u001b[?2004l\r"]
[281.660307, "o", "\u001b[?2004h> "]
[281.66035, "o", "  documents: SeedDoc[]\r\n\u001b[?2004l\r"]
[281.660385, "o", "\u001b[?2004h> "]
[281.660423, "o", "): Promise<void> {\r\n\u001b[?2004l\r"]
[281.660447, "o", "\u001b[?2004h> "]
[281.660529, "o", "  for (const doc of documents) {\r\n\u001b[?2004l\r"]
[281.660553, "o", "\u001b[?2004h> "]
[281.660578, "o", "    try {\r\n\u001b[?2004l\r\u001b[?2004h"]
[281.660635, "o", "> "]
[281.660798, "o", "      // Per the task description: store documents with client.v1.context.add,\r\n\u001b[?2004l\r"]
[281.660821, "o", "\u001b[?2004h> "]
[281.661048, "o", "      // putting file_name and group_name (snake_case) under each document's metadata.\r\n\u001b[?2004l\r\u001b[?2004h"]
[281.661073, "o", "> "]
[281.661179, "o", "      await (client.v1.context as any).add({\r\n\u001b[?2004l\r"]
[281.661204, "o", "\u001b[?2004h> "]
[281.661267, "o", "        documents: [doc],\r\n\u001b[?2004l\r"]
[281.661291, "o", "\u001b[?2004h> "]
[281.661376, "o", "        context_type: 'resource',\r\n\u001b[?2004l\r"]
[281.6614, "o", "\u001b[?2004h> "]
[281.661459, "o", "        source: 'docs',\r\n\u001b[?2004l\r"]
[281.661484, "o", "\u001b[?2004h> "]
[281.66155, "o", "        scope: 'internal',\r\n\u001b[?2004l\r"]
[281.661586, "o", "\u001b[?2004h> "]
[281.661652, "o", "        metadata: doc.metadata,\r\n\u001b[?2004l\r"]
[281.661677, "o", "\u001b[?2004h> "]
[281.661724, "o", "      });\r\n\u001b[?2004l\r\u001b[?2004h> "]
[281.661842, "o", "      // eslint-disable-next-line no-console\r\n\u001b[?2004l\r"]
[281.661882, "o", "\u001b[?2004h> "]
[281.662013, "o", "      console.error(`Seeded ${doc.metadata.file_name}`);\r\n\u001b[?2004l\r\u001b[?2004h"]
[281.66205, "o", "> "]
[281.662099, "o", "    } catch (err: any) {\r\n\u001b[?2004l\r"]
[281.662122, "o", "\u001b[?2004h> "]
[281.662227, "o", "      const status: number | undefined =\r\n\u001b[?2004l\r"]
[281.662251, "o", "\u001b[?2004h> "]
[281.662412, "o", "        err?.status ?? err?.statusCode ?? err?.response?.status;\r\n\u001b[?2004l\r"]
[281.662435, "o", "\u001b[?2004h> "]
[281.662509, "o", "      const message: string =\r\n\u001b[?2004l\r\u001b[?2004h"]
[281.662533, "o", "> "]
[281.662748, "o", "        err?.message ?? (typeof err === 'string' ? err : JSON.stringify(err));\r\n\u001b[?2004l\r\u001b[?2004h> "]
[281.663075, "o", "      // Idempotency: tolerate 409 conflicts (duplicate file_name) so re-runs do not crash.\r\n\u001b[?2004l\r\u001b[?2004h"]
[281.663112, "o", "> "]
[281.663344, "o", "      if (status === 409 || /409|conflict|already/i.test(message)) {\r\n\u001b[?2004l\r"]
[281.663431, "o", "\u001b[?2004h> "]
[281.663544, "o", "        // eslint-disable-next-line no-console\r\n\u001b[?2004l\r\u001b[?2004h> "]
[281.663849, "o", "        console.error(`Already exists, skipping: ${doc.metadata.file_name}`);\r\n\u001b[?2004l\r\u001b[?2004h"]
[281.663966, "o", "> "]
[281.66401, "o", "        continue;\r\n\u001b[?2004l\r\u001b[?2004h>       }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[281.664149, "o", "      throw err;\r\n\u001b[?2004l\r\u001b[?2004h"]
[281.664253, "o", ">     }\r\n\u001b[?2004l\r\u001b[?2004h>   }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[281.664366, "o", "}\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[281.664509, "o", "function pickString(value: unknown): string | undefined {\r\n\u001b[?2004l\r\u001b[?2004h"]
[281.664587, "o", "> "]
[281.664838, "o", "  if (typeof value === 'string' && value.length > 0) return value;\r\n\u001b[?2004l\r\u001b[?2004h> "]
[281.665075, "o", "  if (Array.isArray(value) && typeof value[0] === 'string') return value[0];\r\n\u001b[?2004l\r\u001b[?2004h"]
[281.665153, "o", "> "]
[281.665219, "o", "  return undefined;\r\n\u001b[?2004l\r"]
[281.665255, "o", "\u001b[?2004h> }\r\n\u001b[?2004l\r\u001b[?2004h"]
[281.66529, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h"]
[281.665322, "o", "> "]
[281.665419, "o", "async function searchByGroup(\r\n\u001b[?2004l\r\u001b[?2004h"]
[281.6655, "o", ">   client: AlchemystAI,\r\n"]
[281.665571, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[281.665621, "o", "  group: string\r\n\u001b[?2004l\r\u001b[?2004h> "]
[281.665714, "o", "): Promise<string[]> {\r\n\u001b[?2004l\r\u001b[?2004h"]
[281.665771, "o", "> "]
[281.666034, "o", "  // Note the documented asymmetry: search filters with `groupName` (camelCase).\r\n\u001b[?2004l\r"]
[281.666082, "o", "\u001b[?2004h> "]
[281.666284, "o", "  const resp: any = await (client.v1.context as any).search({\r\n\u001b[?2004l\r"]
[281.666325, "o", "\u001b[?2004h> "]
[281.666427, "o", "    query: 'document',\r\n\u001b[?2004l\r\u001b[?2004h> "]
[281.666525, "o", "    minimum_similarity_threshold: 0,\r\n\u001b[?2004l\r"]
[281.666553, "o", "\u001b[?2004h> "]
[281.666651, "o", "    similarity_threshold: 1,\r\n\u001b[?2004l\r"]
[281.666679, "o", "\u001b[?2004h> "]
[281.666745, "o", "    scope: 'internal',\r\n\u001b[?2004l\r\u001b[?2004h"]
[281.66679, "o", "> "]
[281.666832, "o", "    metadata: 'true',\r\n\u001b[?2004l\r\u001b[?2004h> "]
[281.667024, "o", "    body_metadata: { groupName: [group] },\r\n\u001b[?2004l\r\u001b[?2004h> "]
[281.66709, "o", "  });\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[281.667373, "o", "  const contexts: any[] = Array.isArray(resp?.contexts) ? resp.contexts : [];\r\n\u001b[?2004l\r\u001b[?2004h"]
[281.667437, "o", "> "]
[281.667529, "o", "  const names = new Set<string>();\r\n\u001b[?2004l\r\u001b[?2004h"]
[281.667574, "o", "> "]
[281.667669, "o", "  for (const c of contexts) {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[281.667802, "o", "    const md: any = c?.metadata;\r\n\u001b[?2004l\r"]
[281.667832, "o", "\u001b[?2004h> "]
[281.667931, "o", "    if (!md) continue;\r\n\u001b[?2004l\r\u001b[?2004h> "]
[281.668099, "o", "    // The metadata may be stored under either case. Try both.\r\n\u001b[?2004l\r\u001b[?2004h"]
[281.668129, "o", "> "]
[281.6682, "o", "    const fileName =\r\n\u001b[?2004l\r\u001b[?2004h> "]
[281.668278, "o", "      pickString(md.file_name) ??\r\n\u001b[?2004l\r"]
[281.668309, "o", "\u001b[?2004h> "]
[281.668385, "o", "      pickString(md.fileName) ??\r\n\u001b[?2004l\r\u001b[?2004h"]
[281.668415, "o", "> "]
[281.668502, "o", "      pickString(md['file-name']);\r\n\u001b[?2004l\r\u001b[?2004h"]
[281.668533, "o", "> "]
[281.668623, "o", "    if (fileName) names.add(fileName);\r\n\u001b[?2004l\r\u001b[?2004h"]
[281.668653, "o", ">   }\r\n\u001b[?2004l\r"]
[281.668705, "o", "\u001b[?2004h> "]
[281.668749, "o", "  return Array.from(names);\r\n\u001b[?2004l\r\u001b[?2004h"]
[281.668776, "o", "> }\r\n\u001b[?2004l\r"]
[281.66883, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[281.66889, "o", "async function main() {\r\n\u001b[?2004l\r"]
[281.668916, "o", "\u001b[?2004h> "]
[281.669033, "o", "  const args = parseArgs(process.argv.slice(2));\r\n\u001b[?2004l\r"]
[281.669058, "o", "\u001b[?2004h> "]
[281.66919, "o", "  const apiKey = process.env.ALCHEMYST_AI_API_KEY;\r\n\u001b[?2004l\r"]
[281.669229, "o", "\u001b[?2004h> "]
[281.669253, "o", "  if (!apiKey) {\r\n\u001b[?2004l\r"]
[281.669282, "o", "\u001b[?2004h> "]
[281.669459, "o", "    throw new Error('ALCHEMYST_AI_API_KEY env var is required');\r\n\u001b[?2004l\r\u001b[?2004h"]
[281.669485, "o", ">   }\r\n\u001b[?2004l\r"]
[281.669534, "o", "\u001b[?2004h> "]
[281.669658, "o", "  const runId = loadRunId('/logs/artifacts/run-id');\r\n\u001b[?2004l\r"]
[281.669685, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[281.669738, "o", "> "]
[281.669826, "o", "  const client = new AlchemystAI({ apiKey });\r\n\u001b[?2004l\r"]
[281.669851, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[281.669893, "o", "> "]
[281.669993, "o", "  const documents = buildDocuments(runId);\r\n\u001b[?2004l\r\u001b[?2004h"]
[281.670031, "o", "> "]
[281.670149, "o", "  await addDocumentsIdempotently(client, documents);\r\n\u001b[?2004l\r"]
[281.670173, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[281.670201, "o", "\u001b[?2004h> "]
[281.670354, "o", "  const names = await searchByGroup(client, args.group);\r\n\u001b[?2004l\r\u001b[?2004h"]
[281.670378, "o", "> "]
[281.67051, "o", "  // Emit a single JSON array of strings on stdout.\r\n\u001b[?2004l\r\u001b[?2004h"]
[281.670536, "o", "> "]
[281.670671, "o", "  process.stdout.write(JSON.stringify(names) + '\\n');\r\n\u001b[?2004l\r"]
[281.670708, "o", "\u001b[?2004h> }\r\n\u001b[?2004l\r\u001b[?2004h"]
[281.670745, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[281.670811, "o", "main().catch((err) => {\r\n\u001b[?2004l\r"]
[281.670837, "o", "\u001b[?2004h> "]
[281.670959, "o", "  // eslint-disable-next-line no-console\r\n\u001b[?2004l\r\u001b[?2004h"]
[281.670986, "o", "> "]
[281.671147, "o", "  console.error('Error:', err && err.stack ? err.stack : err);\r\n\u001b[?2004l\r"]
[281.671184, "o", "\u001b[?2004h> "]
[281.671224, "o", "  process.exit(1);\r\n\u001b[?2004l\r"]
[281.671249, "o", "\u001b[?2004h> });\r\n\u001b[?2004l\r"]
[281.671296, "o", "\u001b[?2004h> MAINEOF\r\n\u001b[?2004l\r"]
[281.672722, "o", "\u001b[?2004hroot@0dcfc132-eb47-42f2-86b8-089f836b7d75:/home/user/myproject# "]
