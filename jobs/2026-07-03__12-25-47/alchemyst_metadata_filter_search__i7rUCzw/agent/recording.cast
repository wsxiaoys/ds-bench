[118.540886, "o", "> "]
[118.541054, "o", "      // Idempotency: tolerate 409 conflicts (duplicate file_name).\r\n\u001b[?2004l\r\u001b[?2004h"]
[118.541092, "o", "> "]
[118.541241, "o", "      if (status === 409 || /409|conflict|already/i.test(message)) {\r\n\u001b[?2004l\r"]
[118.541277, "o", "\u001b[?2004h> "]
