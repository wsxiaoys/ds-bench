[118.54565, "o", "  const client = new AlchemystAI({ apiKey });\r\n\u001b[?2004l\r"]
[118.545676, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[118.545724, "o", "\u001b[?2004h> "]
[118.545813, "o", "  const documents = buildDocuments(runId);\r\n\u001b[?2004l\r"]
[118.545852, "o", "\u001b[?2004h> "]
[118.545977, "o", "  await addDocumentsIdempotently(client, documents);\r\n\u001b[?2004l\r"]
[118.546016, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[118.546172, "o", "  const names = await searchByGroup(client, args.group);\r\n\u001b[?2004l\r"]
[118.54621, "o", "\u001b[?2004h> "]
