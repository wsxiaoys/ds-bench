[118.542765, "o", "\u001b[?2004h> "]
[118.542824, "o", "    scope: 'internal',\r\n\u001b[?2004l\r"]
[118.54285, "o", "\u001b[?2004h> "]
[118.542922, "o", "    metadata: 'true',\r\n\u001b[?2004l\r\u001b[?2004h"]
[118.542949, "o", "> "]
[118.543078, "o", "    // camelCase on search per the documented asymmetry\r\n\u001b[?2004l\r"]
[118.543105, "o", "\u001b[?2004h> "]
[118.543211, "o", "    body_metadata: { groupName: [group] },\r\n\u001b[?2004l\r"]
