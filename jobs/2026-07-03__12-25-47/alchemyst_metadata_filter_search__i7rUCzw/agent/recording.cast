[118.541955, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[118.54204, "o", "async function searchByGroup(\r\n\u001b[?2004l\r"]
[118.542066, "o", "\u001b[?2004h> "]
[118.542121, "o", "  client: AlchemystAI,\r\n\u001b[?2004l\r"]
[118.542148, "o", "\u001b[?2004h> "]
[118.542199, "o", "  group: string\r\n\u001b[?2004l\r\u001b[?2004h"]
[118.542238, "o", "> "]
[118.542277, "o", "): Promise<string[]> {\r\n\u001b[?2004l\r"]
[118.542305, "o", "\u001b[?2004h> "]
[118.542437, "o", "  const resp: any = await client.v1.context.search({\r\n\u001b[?2004l\r"]
[118.542475, "o", "\u001b[?2004h> "]
[118.542519, "o", "    query: 'document',\r\n\u001b[?2004l\r"]
[118.542557, "o", "\u001b[?2004h> "]
[118.54264, "o", "    minimum_similarity_threshold: 0,\r\n\u001b[?2004l\r"]
[118.542667, "o", "\u001b[?2004h> "]
