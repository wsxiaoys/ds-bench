[118.546365, "o", "\u001b[?2004h> "]
[118.546489, "o", "  process.stdout.write(JSON.stringify(names) + '\\n');\r\n\u001b[?2004l\r"]
[118.546527, "o", "\u001b[?2004h> }\r\n\u001b[?2004l\r\u001b[?2004h"]
