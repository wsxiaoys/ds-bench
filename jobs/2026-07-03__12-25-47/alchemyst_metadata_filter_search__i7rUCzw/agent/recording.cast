[118.544914, "o", "> "]
[118.545037, "o", "  const apiKey = process.env.ALCHEMYST_AI_API_KEY;\r\n\u001b[?2004l\r"]
[118.545077, "o", "\u001b[?2004h> "]
[118.545115, "o", "  if (!apiKey) {\r\n\u001b[?2004l\r\u001b[?2004h"]
[118.545153, "o", "> "]
