[118.538422, "o", "\u001b[?2004h> "]
[118.538468, "o", "): Promise<void> {\r\n\u001b[?2004l\r"]
[118.538502, "o", "\u001b[?2004h> "]
[118.538575, "o", "  for (const doc of documents) {\r\n\u001b[?2004l\r"]
[118.538609, "o", "\u001b[?2004h> "]
[118.538643, "o", "    try {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[118.538852, "o", "      // Per the task description: store documents with client.v1.context.add,\r\n\u001b[?2004l\r"]
[118.538895, "o", "\u001b[?2004h> "]
[118.539099, "o", "      // putting file_name and group_name (snake_case) under each document's metadata.\r\n\u001b[?2004l\r"]
[118.539135, "o", "\u001b[?2004h> "]
[118.539238, "o", "      await (client.v1.context as any).add({\r\n\u001b[?2004l\r"]
[118.539273, "o", "\u001b[?2004h> "]
[118.539331, "o", "        documents: [doc],\r\n\u001b[?2004l\r"]
[118.539366, "o", "\u001b[?2004h> "]
[118.539443, "o", "        context_type: 'resource',\r\n\u001b[?2004l\r"]
[118.539479, "o", "\u001b[?2004h> "]
[118.539533, "o", "        source: 'docs',\r\n\u001b[?2004l\r"]
[118.539567, "o", "\u001b[?2004h> "]
[118.539636, "o", "        scope: 'internal',\r\n\u001b[?2004l\r"]
[118.53967, "o", "\u001b[?2004h> "]
[118.539757, "o", "        metadata: doc.metadata,\r\n\u001b[?2004l\r"]
[118.539792, "o", "\u001b[?2004h> "]
[118.539826, "o", "      });\r\n\u001b[?2004l\r\u001b[?2004h> "]
[118.539949, "o", "      // eslint-disable-next-line no-console\r\n\u001b[?2004l\r"]
[118.539985, "o", "\u001b[?2004h> "]
[118.540119, "o", "      console.error(`Seeded ${doc.metadata.file_name}`);\r\n\u001b[?2004l\r"]
[118.540155, "o", "\u001b[?2004h> "]
[118.540205, "o", "    } catch (err: any) {\r\n\u001b[?2004l\r"]
[118.54024, "o", "\u001b[?2004h> "]
[118.540336, "o", "      const status: number | undefined =\r\n\u001b[?2004l\r"]
[118.540371, "o", "\u001b[?2004h> "]
[118.540523, "o", "        err?.status ?? err?.statusCode ?? err?.response?.status;\r\n\u001b[?2004l\r"]
[118.540549, "o", "\u001b[?2004h> "]
