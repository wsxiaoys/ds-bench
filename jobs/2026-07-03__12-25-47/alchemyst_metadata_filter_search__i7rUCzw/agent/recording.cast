[118.54415, "o", "\u001b[?2004h> "]
[118.544311, "o", "    if (typeof fileName === 'string' && fileName.length > 0) {\r\n\u001b[?2004l\r"]
[118.544337, "o", "\u001b[?2004h> "]
[118.544402, "o", "      names.add(fileName);\r\n\u001b[?2004l\r"]
[118.544428, "o", "\u001b[?2004h> "]
[118.544476, "o", "    }\r\n\u001b[?2004l\r\u001b[?2004h>   }\r\n\u001b[?2004l\r"]
[118.544503, "o", "\u001b[?2004h> "]
[118.544579, "o", "  return Array.from(names);\r\n\u001b[?2004l\r"]
[118.544606, "o", "\u001b[?2004h> }\r\n\u001b[?2004l\r"]
