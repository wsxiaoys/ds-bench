[215.102701, "o", "\u001b[?2004l\r\u001b[?2004h>     } catch (err: any) {\r\r\n\u001b[?2004l\r\u001b[?2004h>       const status: number | undefined =\r\r\n\u001b[?2004l\r\u001b[?2004h>         err?.status ?? err?.statusCode ?? err?.response?.status;\r\r\n\u001b[?2004l\r\u001b[?2004h>       const message: string =\r\r\n\u001b[?2004l\r\u001b[?2004h>         err?.message ?? (typeof err === 'string' ? err : JSON.stringify(err));\r\r\n\u001b[?2004l\r\u001b[?2004h>       // Idempotency: tolerate 409 conflicts (duplicate file_name).\r\r\n\u001b[?2004l\r\u001b[?2004h>       if (status === 409 || /409|conflict|already/i.test(message)) {\r\r\n\u001b[?2004l\r\u001b[?2004h>         // eslint-disable-next-line no-console\r\r\n\u001b[?2004l\r\u001b[?2004h>         console.error(`Already exists, skipping: ${doc.metadata.file_name}`);\r\r\n\u001b[?2004l\r\u001b[?2004h>         continue;\r\r\n\u001b[?2004l\r\u001b[?2004h>       }\r\r\n\u001b[?2004l\r\u001b[?2004h>       throw err;\r\r\n\u001b[?2004l\r\u001b[?2004h>     }\r\r\n\u001b[?2004l\r\u001b[?2004h>   }\r\r\n\u001b[?2004l\r\u001b[?2004h> }\r\r\n\u001b[?2004l\r\u001b[?2004h> \r\r\n\u001b[?2004l\r\u001b[?2004h> async function searchByGroup(\r\r\n\u001b[?2004l\r\u001b[?2004h>   client: AlchemystAI,\r\r\n\u001b[?2004l\r\u001b[?2004h>   group: string\r\r\n\u001b[?2004l\r\u001b[?2004h> ): Promise<string[]> {\r\r\n\u001b[?2004l\r\u001b[?2004h>   const resp: any = await client.v1.context.search({\r\r\n\u001b[?2004l\r\u001b[?2004h>     query: 'document',\r\r\n\u001b[?2004l\r\u001b[?2004h>     minimum_similarity_threshold: 0,\r\r\n\u001b[?2004l\r\u001b[?2004h>     similarity_threshold: 1,\r\r\n\u001b[?2004l\r\u001b[?2004h>     scope: 'internal',\r\r\n\u001b[?2004l\r\u001b[?2004h>     metadata: 'true',\r\r\n\u001b[?2004l\r\u001b[?2004h>     // camelCase on search per the documented asymmetry\r\r\n\u001b[?2004l\r\u001b[?2004h>     body_metadata: { groupName: [group] },\r\r\n\u001b[?2004l\r\u001b[?2004h>   } as any);\r\r\n\u001b[?2004l\r\u001b[?2004h> \r\r\n\u001b[?2004l\r\u001b[?2004h>   const contexts: any[] = resp?.contexts ?? [];\r\r\n\u001b[?2004l\r\u001b[?2004h>   const names = new Set<string>();\r\r\n\u001b[?2004l\r\u001b[?2004h>   for (const c of contexts) {\r\r\n\u001b[?2004l\r\u001b[?2004h>     const md = c?.metadata;\r\r\n\u001b[?2004l\r\u001b[?2004h>     if (!md) continue;\r\r\n\u001b[?2004l\r\u001b[?2004h>     const fileName =\r\r\n\u001b[?2004l\r\u001b[?2004h>       md.file_name ?? md.fileName ?? md['file-name'] ?? md.file_name;\r\r\n\u001b[?2004l\r\u001b[?2004h>     if (typeof fileName === 'string' && fileName.length > 0) {\r\r\n\u001b[?2004l\r\u001b[?2004h>       names.add(fileName);\r\r\n\u001b[?2004l\r\u001b[?2004h>     }\r\r\n\u001b[?2004l\r\u001b[?2004h>   }\r\r\n\u001b[?2004l\r\u001b[?2004h>   return Array.from(names);\r\r\n\u001b[?2004l\r\u001b[?2004h> }\r\r\n\u001b[?2004l\r\u001b[?2004h> \r\r\n\u001b[?2004l\r\u001b[?2004h> async function main() {\r\r\n\u001b[?2004l\r\u001b[?2004h>   const args = parseArgs(process.argv.slice(2));\r\r\n\u001b[?2004l\r\u001b[?2004h>   const apiKey = process.env.ALCHEMYST_AI_API_KEY;\r\r\n\u001b[?2004l\r\u001b[?2004h>   if (!apiKey) {\r\r\n\u001b[?2004l\r\u001b[?2004h>     throw new Error('ALCHEMYST_AI_API_KEY env var is required');\r\r\n\u001b[?2004l\r\u001b[?2004h>   }\r\r\n\u001b[?2004l\r\u001b[?2004h>   const runId = loadRunId('/logs/artifacts/run-id');\r\r\n\u001b[?2004l\r\u001b[?2004h> \r\r\n\u001b[?2004l\r\u001b[?2004h>   const client = new AlchemystAI({ apiKey });\r\r\n\u001b[?2004l\r\u001b[?2004h> \r\r\n\u001b[?2004l\r\u001b[?2004h>   const documents = buildDocuments(runId);\r\r\n\u001b[?2004l\r\u001b[?2004h>   await addDocumentsIdempotently(client, documents);\r\r\n\u001b[?2004l\r\u001b[?2004h> \r\r\n\u001b[?2004l\r\u001b[?2004h>   const names = await searchByGroup(client, args.group);\r\r\n\u001b[?2004l\r\u001b[?2004h>   // Emit a single JSON array of strings on stdout.\r\r\n\u001b[?2004l\r\u001b[?2004h>   process.stdout.write(JSON.stringify(names) + '\\n');\r\r\n\u001b[?2004l\r\u001b[?2004h> }\r\r\n\u001b[?2004l\r\u001b[?2004h> \r\r\n\u001b[?2004l\r\u001b[?2004h> main().catch((err) => {\r\r\n\u001b[?2004l\r\u001b[?2004h>   // eslint-disable-next-line no-console\r\r\n\u001b[?2004l\r\u001b[?2004h>   console.error('Error:', err && err.stack ? err.stack : err);\r\r\n\u001b[?2004l\r\u001b[?2004h>   process.exit(1);\r\r\n\u001b[?2004l\r\u001b[?2004h> });\r\r\n\u001b[?2004l\r\u001b[?2004h> MAINEOF\r\r\n\u001b[?2004l\r\u001b[?2004hroot@0dcfc132-eb47-42f2-86b8-089f836b7d75:/home/user/myproject# ls -la src/\r\r\n\u001b[?2004l\rtotal 8\r\r\ndrwxr-xr-x 2 root root   29 Jul  3 13:15 \u001b[0m\u001b[01;34m.\u001b[0m\r\r\ndrwxr-xr-x 1 root root  127 Jul  3 13:15 \u001b[01;34m..\u001b[0m\r\r\n-rw-r--r-- 1 root root 4795 Jul  3 13:15 main.ts\r\r\n\u001b[?2004hroot@0dcfc132-eb47-42f2-86b8-089f836b7d75:/home/user/myproject# npx tsc\r\r\n\u001b[?2004l\r⠙\u001b[1G\u001b[0K\u001b[?2004hroot@0dcfc132-eb47-42f2-86b8-089f836b7d75:/home/user/myproject# ls -la dist/\r\r\n\u001b[?2004l\rtotal 8\r\r\ndrwxr-xr-x 2 root root   29 Jul  3 13:15 \u001b[0m\u001b[01;34m.\u001b[0m\r\r\ndrwxr-xr-x 1 root root  143 Jul  3 13:15 \u001b[01;34m..\u001b[0m\r\r\n-rw-r--r-- 1 root root 6567 Jul  3 13:15 main.js\r\r\n\u001b[?2004hroot@0dc"]
