[118.54369, "o", "\u001b[?2004h> "]
[118.543759, "o", "    const md = c?.metadata;\r\n\u001b[?2004l\r"]
[118.543784, "o", "\u001b[?2004h> "]
[118.543845, "o", "    if (!md) continue;\r\n\u001b[?2004l\r"]
[118.543885, "o", "\u001b[?2004h> "]
[118.543934, "o", "    const fileName =\r\n\u001b[?2004l\r\u001b[?2004h"]
[118.543979, "o", "> "]
