[281.658779, "o", "        group_name: ['engineering'],\r\n\u001b[?2004l\r"]
[281.658803, "o", "\u001b[?2004h> "]
[281.658899, "o", "        file_type: 'text/markdown',\r\n\u001b[?2004l\r"]
[281.658936, "o", "\u001b[?2004h>       },\r\n\u001b[?2004l\r"]
[281.658959, "o", "\u001b[?2004h> "]
