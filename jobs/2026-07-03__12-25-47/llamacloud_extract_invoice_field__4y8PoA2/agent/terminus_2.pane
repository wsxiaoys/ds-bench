[?2004l[?2004h>     throw new Error(
[?2004l[?2004h>       `Extract job ${current.id} did not complete: status=${current.status}, error=${current.error_message ?? "unknown"}`
[?2004l[?2004h>     );
[?2004l[?2004h>   }
[?2004l[?2004h> 
[?2004l[?2004h>   const extractResult = current.extract_result as Invoice | null | undefined;
[?2004l[?2004h> 
