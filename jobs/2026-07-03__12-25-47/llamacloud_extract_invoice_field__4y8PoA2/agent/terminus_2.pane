[?2004l[?2004h> 
[?2004l[?2004h>   const inputPath = path.resolve(__dirname, "invoice.pdf");
[?2004l[?2004h>   const fileBuffer = fs.readFileSync(inputPath);
[?2004l[?2004h>   const fileBlob = new Blob([fileBuffer], { type: "application/pdf" });
[?2004l[?2004h> 
[?2004l[?2004h>   console.log(`Uploading ${inputPath} to LlamaCloud...`);
[?2004l[?2004h>   const uploaded = await client.files.create({
[?2004l[?2004h>     file: new File([fileBlob], "invoice.pdf", { type: "application/pdf" }),
[?2004l[?2004h>     purpose: "extract",
[?2004l[?2004h>   });
[?2004l[?2004h>   console.log(`Uploaded file id: ${uploaded.id}`);
[?2004l[?2004h> 
[?2004l[?2004h>   const dataSchema = toJSONSchema(InvoiceSchema);
[?2004l[?2004h> 
[?2004l[?2004h>   console.log("Creating extract job (agentic tier, per_doc)...");
[?2004l[?2004h>   const job = await client.extract.create({
[?2004l[?2004h>     file_input: uploaded.id,
[?2004l[?2004h>     configuration: {
[?2004l[?2004h>       data_schema: dataSchema as any,
[?2004l[?2004h>       extraction_target: "per_doc",
[?2004l[?2004h>       tier: "agentic",
[?2004l[?2004h>     },
[?2004l[?2004h>   });
[?2004l[?2004h> 
[?2004l[?2004h>   console.log(`Job created: ${job.id} (status=${job.status})`);
[?2004l[?2004h> 
[?2004l[?2004h>   // Poll until terminal state
[?2004l[?2004h>   const TERMINAL = new Set(["COMPLETED", "FAILED", "CANCELLED"]);
[?2004l[?2004h>   let current = job;
[?2004l[?2004h>   while (!TERMINAL.has(current.status)) {
[?2004l[?2004h>     await new Promise((r) => setTimeout(r, 2000));
[?2004l[?2004h>     current = await client.extract.get(current.id);
[?2004l[?2004h>     console.log(`Polling: ${current.id} status=${current.status}`);
[?2004l[?2004h>   }
[?2004l[?2004h> 
