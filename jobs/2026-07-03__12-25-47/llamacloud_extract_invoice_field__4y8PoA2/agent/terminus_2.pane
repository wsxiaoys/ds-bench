[?2004l[?2004h> // Zod schema for an invoice
[?2004l[?2004h> const InvoiceSchema = z.object({
[?2004l[?2004h>   invoice_number: z.string(),
[?2004l[?2004h>   invoice_date: z.string(),
[?2004l[?2004h>   vendor_name: z.string(),
[?2004l[?2004h>   total_amount: z.number(),
[?2004l[?2004h>   line_items: z.array(
[?2004l[?2004h>     z.object({
[?2004l[?2004h>       description: z.string(),
[?2004l[?2004h>       quantity: z.number(),
[?2004l[?2004h>       unit_price: z.number(),
[?2004l[?2004h>       total: z.number(),
[?2004l[?2004h>     })
[?2004l[?2004h>   ),
[?2004l[?2004h> });
[?2004l[?2004h> 
[?2004l[?2004h> type Invoice = z.infer<typeof InvoiceSchema>;
[?2004l[?2004h> 
[?2004l[?2004h> async function main() {
[?2004l[?2004h>   // Construct the LlamaCloud client (reads LLAMA_CLOUD_API_KEY from env)
