[156.89392, "i", "cat > /home/user/myproject/subscribe.js <<'JSEOF'\n#!/usr/bin/env node\n'use strict';\n\nconst PocketBase = require('pocketbase').default || require('pocketbase');\n\nfunction parseArgs(argv) {\n  const args = { chat: null };\n  for (let i = 0; i < argv.length; i++) {\n    const a = argv[i];\n    if (a === '--chat') {\n      args.chat = argv[i + 1];\n      i++;\n    } else if (a.startsWith('--chat=')) {\n      args.chat = a.slice('--chat='.length);\n    }\n  }\n  return args;\n}\n\nconst args = parseArgs(process.argv.slice(2));\nif (!args.chat) {\n  process.stderr.write('Usage: node subscribe.js --chat <chatId>\\n');\n  process.exit(1);\n}\n\nconst pb = new PocketBase('http://127.0.0.1:8090');\npb.REDACTEDCancellation(false);\n\nlet unsubFn = null;\nlet exiting = false;\n\nfunction writeLine(obj) {\n  try {\n    const line = JSON.stringify(obj);\n    process.stdout.write(line + '\\n');\n  } catch (e) {\n    process.stderr.write('Failed to serialize event: ' + (e && e.message) + '\\n');\n  }\n}\n\nfunction shutdown(signal) {\n  if (exiting) return;\n  exiting = true;\n  process.stderr.write('Received ' + signal + ', shutting down\\n');\n  try {\n    if (unsubFn && typeof unsubFn === 'function') {\n      try { unsubFn(); } catch (e) { /* ignore */ }\n    }\n    try { pb.realtime.disconnect(); } catch (e) { /* ignore */ }\n  } finally {\n    setTimeout(() => process.exit(0), 100).unref();\n  }\n}\n\nprocess.on('SIGTERM', () => shutdown('SIGTERM'));\nprocess.on('SIGINT', () => shutdown('SIGINT'));\nprocess.on('uncaughtException', (e) => {\n  process.stderr.write('Uncaught exception: ' + (e && e.stack ? e.stack : e) + '\\n');\n});\nprocess.on('unhandledRejection', (e) => {\n  process.stderr.write('Unhandled rejection: ' + (e && e.stack ? e.stack : e) + '\\n');\n});\n\n(async () => {\n  try {\n    await pb.admins.authWithPassword(process.env.PB_ADMIN_EMAIL, process.env.PB_ADMIN_PASSWORD);\n  } catch (e) {\n    process.stderr.write('Auth failed: ' + (e && e.message ? e.message : e) + '\\n');\n    process.exit(1);\n  }\n\n  const safeChat = String(args.chat).replace(/'/g, \"\\\\'\");\n  const filter = \"chat='\" + safeChat + \"'\";\n\n  try {\n    unsubFn = await pb.collection('messages').subscribe('*', function (e) {\n      if (!e) return;\n      const record = e.record || {};\n      writeLine({ action: e.action, record: record });\n    }, { filter: filter });\n  } catch (e) {\n    process.stderr.write('Subscribe failed: ' + (e && e.message ? e.message : e) + '\\n');\n    process.exit(1);\n  }\n\n  process.stderr.write('Subscribed to messages with filter: ' + filter + '\\n');\n})();\nJSEOF\n"]
