[572.731427, "o", "SEND: http://127.0.0.1:8090/api/realtime METHOD: POST BODY: {\"clientId\":\"iccoSt1DCPyTkKuEcV4zq2kXuZtHzD0y1b3gVQ4I\",\"subscriptions\":[\"messages?options=%7B%22query%22%3A%7B%22filter%22%3A%22chat%3D'chat-123'%22%7D%7D\"]}\r\n"]
