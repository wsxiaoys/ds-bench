func _ready() -> void:
    _parse_args()
    print("Args: port=%d clients=%d frames=%d deltas=%s out=%s" % [port, num_clients, num_frames, str(score_deltas), out_path])
    _build_scene()
    _start_server()
    _start_clients()
    _run()

func _parse_args() -> void:
    var args: PackedStringArray = OS.get_cmdline_user_args()
