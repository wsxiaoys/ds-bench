[322.103808, "o", "\u001b[?2004h> "]
[322.104303, "o", "content = '''\r\n\u001b[?2004l\r"]
[322.104896, "o", "\u001b[?2004h> "]
[322.105303, "o", "func _run() -> void:\r\n\u001b[?2004l\r"]
[322.105454, "o", "\u001b[?2004h> "]
[322.107319, "o", "    while frame_count < num_frames + 200:\r\n\u001b[?2004l\r"]
[322.107541, "o", "\u001b[?2004h> "]
[322.109118, "o", "        await get_tree().process_frame\r\n\u001b[?2004l\r"]
[322.10941, "o", "\u001b[?2004h> "]
[322.110236, "o", "        frame_count += 1\r\n\u001b[?2004l\r"]
[322.11059, "o", "\u001b[?2004h> "]
[322.111773, "o", "        var all_connected: bool = true\r\n\u001b[?2004l\r"]
[322.11198, "o", "\u001b[?2004h> "]
[322.113328, "o", "        for i in range(num_clients):\r\n\u001b[?2004l\r"]
[322.113733, "o", "\u001b[?2004h> "]
[322.115964, "o", "            var mp: MultiplayerAPI = client_multiplayers[i]\r\n\u001b[?2004l\r\u001b[?2004h> "]
[322.119129, "o", "            if mp == null or mp.multiplayer_peer == null:\r\n\u001b[?2004l\r"]
[322.119282, "o", "\u001b[?2004h> "]
[322.120723, "o", "                all_connected = false\r\n\u001b[?2004l\r"]
[322.120929, "o", "\u001b[?2004h> "]
[322.121797, "o", "                break\r\n\u001b[?2004l\r"]
[322.122021, "o", "\u001b[?2004h> "]
[322.125467, "o", "            if mp.multiplayer_peer.get_connection_status() != MultiplayerPeer.CONNECTION_CONNECTED:\r\n"]
[322.126456, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[322.127428, "o", "                all_connected = false\r\n\u001b[?2004l\r\u001b[?2004h> "]
[322.164054, "o", "                break\r\n\u001b[?2004l\r\u001b[?2004h>         if not all_connected:\r\n\u001b[?2004l\r\u001b[?2004h>             continue"]
[322.167821, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[322.168745, "o", "        if not all_client_connected:\r\n\u001b[?2004l\r\u001b[?2004h"]
[322.169147, "o", "> "]
[322.170299, "o", "            all_client_connected = true\r\n\u001b[?2004l\r\u001b[?2004h"]
[322.170658, "o", "> "]
[322.172752, "o", "            print(\"All clients connected at frame %d\" % frame_count)\r\n\u001b[?2004l\r"]
[322.173048, "o", "\u001b[?2004h> "]
[322.174985, "o", "            var target_frame: int = frame_count + num_frames\r\n\u001b[?2004l\r"]
[322.175132, "o", "\u001b[?2004h> "]
[322.176631, "o", "            while frame_count < target_frame:\r\n\u001b[?2004l\r"]
[322.17678, "o", "\u001b[?2004h> "]
[322.177689, "o", "                await get_tree().process_frame\r\n\u001b[?2004l\r"]
[322.177893, "o", "\u001b[?2004h> "]
[322.178504, "o", "                frame_count += 1\r\n\u001b[?2004l\r"]
[322.178786, "o", "\u001b[?2004h> "]
[322.179474, "o", "            for i in range(num_clients):\r\n\u001b[?2004l\r"]
[322.179796, "o", "\u001b[?2004h> "]
[322.180327, "o", "                if clients_score_sent[i]:\r\n\u001b[?2004l\r\u001b[?2004h"]
[322.180624, "o", "> "]
[322.181084, "o", "                    continue\r\n\u001b[?2004l\r"]
[322.181383, "o", "\u001b[?2004h> "]
[322.182393, "o", "                var c_root: Node = client_roots[i]\r\n\u001b[?2004l\r\u001b[?2004h> "]
[322.183565, "o", "                var mp: MultiplayerAPI = client_multiplayers[i]\r\n\u001b[?2004l\r"]
[322.183925, "o", "\u001b[?2004h> "]
[322.184664, "o", "                var my_id: int = mp.get_unique_id()\r\n\u001b[?2004l\r"]
[322.18503, "o", "\u001b[?2004h> "]
[322.186321, "o", "                var players_node: Node = c_root.get_node(PLAYERS_NODE_NAME)\r\n\u001b[?2004l\r"]
[322.186541, "o", "\u001b[?2004h> "]
[322.187229, "o", "                var my_player: Node = null\r\n\u001b[?2004l\r\u001b[?2004h"]
[322.187589, "o", "> "]
[322.188403, "o", "                for child in players_node.get_children():\r\n\u001b[?2004l\r"]
[322.188755, "o", "\u001b[?2004h> "]
[322.189957, "o", "                    if str(child.name) == str(my_id):\r\n\u001b[?2004l\r"]
[322.190184, "o", "\u001b[?2004h> "]
[322.191268, "o", "                        my_player = child\r\n\u001b[?2004l\r"]
[322.194187, "o", "\u001b[?2004h>                         break\r\n\u001b[?2004l\r\u001b[?2004h>                 if my_player == null:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[322.197047, "o", "                    print(\"Client %d could not find its player (my_id=%d)\" % [i, my_id])"]
[322.197577, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[322.198256, "o", "                    continue\r\n\u001b[?2004l\r"]
[322.198494, "o", "\u001b[?2004h> "]
[322.199811, "o", "                var delta_val: int = 0\r\n\u001b[?2004l\r"]
[322.200068, "o", "\u001b[?2004h> "]
[322.201484, "o", "                if i < score_deltas.size():\r\n\u001b[?2004l\r"]
[322.201711, "o", "\u001b[?2004h> "]
[322.203317, "o", "                    delta_val = score_deltas[i]\r\n\u001b[?2004l\r"]
[322.203732, "o", "\u001b[?2004h> "]
[322.20652, "o", "                print(\"Client %d (id=%d) sending update_score(%d)\" % [i, my_id, delta_val])\r\n\u001b[?2004l\r"]
[322.206872, "o", "\u001b[?2004h> "]
[322.208556, "o", "                my_player.update_score.rpc(delta_val)\r\n\u001b[?2004l\r\u001b[?2004h"]
[322.208798, "o", "> "]
[322.210196, "o", "                clients_score_sent[i] = true\r\n\u001b[?2004l\r"]
[322.210613, "o", "\u001b[?2004h> "]
[322.211435, "o", "            var extra: int = 0\r\n\u001b[?2004l\r"]
[322.21167, "o", "\u001b[?2004h> "]
[322.264316, "o", "            while extra < 10:\r\n\u001b[?2004l\r\u001b[?2004h>                 await get_tree().process_frame\r\n\u001b[?2004l\r\u001b[?2004h> "]
[322.265026, "o", "                frame_count += 1\r\n\u001b[?2004l\r"]
[322.265409, "o", "\u001b[?2004h> "]
[322.266135, "o", "                extra += 1\r\n\u001b[?2004l\r"]
[322.266556, "o", "\u001b[?2004h> "]
[322.267218, "o", "            _write_json()\r\n\u001b[?2004l\r"]
[322.267449, "o", "\u001b[?2004h> "]
[322.26851, "o", "            json_written = true\r\n\u001b[?2004l\r"]
[322.268863, "o", "\u001b[?2004h> "]
[322.269682, "o", "            get_tree().quit()\r\n\u001b[?2004l\r"]
[322.270048, "o", "\u001b[?2004h> "]
[322.270487, "o", "            return\r\n"]
[322.270695, "o", "\u001b[?2004l\r\u001b[?2004h"]
[322.271072, "o", "> "]
[322.271724, "o", "    if not json_written:\r\n"]
[322.273102, "o", "\u001b[?2004l\r"]
[322.274031, "o", "\u001b[?2004h>         _write_json()\r\n\u001b[?2004l\r\u001b[?2004h> "]
[322.274766, "o", "        get_tree().quit()\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[322.274875, "o", "\u001b[?2004h> "]
[322.277946, "o", "func _write_json() -> void:\r\n\u001b[?2004l\r\u001b[?2004h"]
[322.278413, "o", "> "]
[322.279843, "o", "    var server_data: Dictionary = _collect_state(server_root, host_multiplayer, true)\r\n\u001b[?2004l\r"]
[322.280085, "o", "\u001b[?2004h"]
[322.280274, "o", "> "]
[322.281274, "o", "    var clients_data: Array = []\r\n"]
[322.281502, "o", "\u001b[?2004l\r\u001b[?2004h"]
[322.281683, "o", "> "]
[322.28284, "o", "    for i in range(num_clients):\r\n\u001b[?2004l\r"]
[322.283661, "o", "\u001b[?2004h> "]
[322.286203, "o", "        var c_data: Dictionary = _collect_state(client_roots[i], client_multiplayers[i], false)\r\n\u001b[?2004l\r"]
[322.286449, "o", "\u001b[?2004h> "]
[322.287623, "o", "        clients_data.append(c_data)\r\n\u001b[?2004l\r"]
[322.288111, "o", "\u001b[?2004h> "]
[322.288785, "o", "    var out: Dictionary = {\r\n"]
[322.289026, "o", "\u001b[?2004l\r\u001b[?2004h"]
[322.289457, "o", "> "]
[322.290165, "o", "        \"server\": server_data,\r\n\u001b[?2004l\r"]
[322.290377, "o", "\u001b[?2004h> "]
[322.29149, "o", "        \"clients\": clients_data,\r\n\u001b[?2004l\r\u001b[?2004h"]
[322.291762, "o", "> "]
[322.292019, "o", "    }\r\n\u001b[?2004l\r\u001b[?2004h"]
[322.292258, "o", "> "]
[322.29433, "o", "    var f: FileAccess = FileAccess.open(out_path, FileAccess.WRITE)\r\n\u001b[?2004l\r"]
[322.294555, "o", "\u001b[?2004h> "]
[322.295087, "o", "    if f == null:\r\n\u001b[?2004l\r"]
[322.29531, "o", "\u001b[?2004h> "]
[322.299236, "o", "        push_error(\"cannot open out file: %s err=%d\" % [out_path, FileAccess.get_open_error()])\r\n\u001b[?2004l\r\u001b[?2004h> "]
[322.299523, "o", "        return\r\n\u001b[?2004l\r\u001b[?2004h> "]
[322.30105, "o", "    f.store_string(JSON.stringify(out, \"\\\\t\"))\r\n\u001b[?2004l\r"]
[322.301269, "o", "\u001b[?2004h> "]
[322.302036, "o", "    f.close()\r\n\u001b[?2004l\r\u001b[?2004h> "]
[322.303002, "o", "    print(\"WROTE: \" + out_path)\r\n\u001b[?2004l\r"]
[322.3032, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[322.303773, "o", "\u001b[?2004h> "]
[322.306214, "o", "func _collect_state(root: Node, mp: MultiplayerAPI, is_server: bool) -> Dictionary:\r\n\u001b[?2004l\r"]
[322.306711, "o", "\u001b[?2004h> "]
[322.30732, "o", "    var unique_id: int = 0\r\n\u001b[?2004l\r"]
[322.307767, "o", "\u001b[?2004h> "]
[322.30925, "o", "    if mp != null and mp.multiplayer_peer != null:\r\n\u001b[?2004l\r"]
[322.309599, "o", "\u001b[?2004h> "]
[322.364861, "o", "        unique_id = mp.get_unique_id()\r\n\u001b[?2004l\r\u001b[?2004h"]
[322.365163, "o", "> "]
[322.366213, "o", "    var peers: Array[int] = []\r\n\u001b[?2004l\r\u001b[?2004h> "]
[322.366851, "o", "    if is_server:\r\n\u001b[?2004l\r"]
[322.3675, "o", "\u001b[?2004h> "]
[322.368292, "o", "        for i in range(num_clients):\r\n\u001b[?2004l\r"]
[322.368513, "o", "\u001b[?2004h> "]
[322.370552, "o", "            var c_mp: MultiplayerAPI = client_multiplayers[i]\r\n\u001b[?2004l\r"]
[322.370895, "o", "\u001b[?2004h> "]
[322.375616, "o", "            if c_mp != null and c_mp.multiplayer_peer != null and c_mp.multiplayer_peer.get_connection_status() == MultiplayerPeer.CONNECTION_CONNECTED:\r\n\u001b[?2004l\r"]
[322.375837, "o", "\u001b[?2004h> "]
[322.377584, "o", "                peers.append(c_mp.get_unique_id())\r\n\u001b[?2004l\r"]
[322.377939, "o", "\u001b[?2004h> "]
[322.378567, "o", "    else:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[322.379624, "o", "        if host_multiplayer != null:\r\n\u001b[?2004l\r"]
[322.379992, "o", "\u001b[?2004h> "]
[322.381061, "o", "            peers.append(1)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[322.382489, "o", "        for i in range(num_clients):\r\n\u001b[?2004l\r\u001b[?2004h"]
[322.383115, "o", "> "]
[322.384611, "o", "            var c_mp2: MultiplayerAPI = client_multiplayers[i]\r\n\u001b[?2004l\r\u001b[?2004h"]
[322.385347, "o", "> "]
[322.386713, "o", "            if c_mp2 == null or c_mp2.multiplayer_peer == null:\r\n\u001b[?2004l\r"]
[322.38695, "o", "\u001b[?2004h> "]
[322.387667, "o", "                continue\r\n\u001b[?2004l\r"]
[322.387802, "o", "\u001b[?2004h"]
[322.388182, "o", "> "]
[322.390774, "o", "            if c_mp2.multiplayer_peer.get_connection_status() != MultiplayerPeer.CONNECTION_CONNECTED:\r\n\u001b[?2004l\r\u001b[?2004h"]
[322.391125, "o", "> "]
[322.391434, "o", "                continue\r\n\u001b[?2004l\r"]
[322.391621, "o", "\u001b[?2004h> "]
[322.393123, "o", "            var c_id: int = c_mp2.get_unique_id()\r\n"]
[322.393379, "o", "\u001b[?2004l\r"]
[322.393551, "o", "\u001b[?2004h> "]
[322.394598, "o", "            if c_id != unique_id:\r\n\u001b[?2004l\r"]
[322.394766, "o", "\u001b[?2004h> "]
[322.395899, "o", "                peers.append(c_id)\r\n\u001b[?2004l\r"]
[322.396093, "o", "\u001b[?2004h> "]
[322.396774, "o", "    peers.sort()\r\n\u001b[?2004l\r"]
[322.397001, "o", "\u001b[?2004h> "]
[322.398191, "o", "    var players_dict: Dictionary = {}\r\n\u001b[?2004l\r"]
[322.398501, "o", "\u001b[?2004h"]
[322.398727, "o", "> "]
[322.399209, "o", "    if root != null:\r\n\u001b[?2004l\r"]
[322.39937, "o", "\u001b[?2004h> "]
[322.401859, "o", "        var players_node: Node = root.get_node_or_null(PLAYERS_NODE_NAME)\r\n\u001b[?2004l\r"]
[322.402375, "o", "\u001b[?2004h> "]
[322.403179, "o", "        if players_node != null:\r\n\u001b[?2004l\r"]
[322.40343, "o", "\u001b[?2004h> "]
[322.405176, "o", "            for child in players_node.get_children():\r\n\u001b[?2004l\r"]
[322.405602, "o", "\u001b[?2004h> "]
[322.407011, "o", "                var key: String = str(child.name)\r\n\u001b[?2004l\r"]
[322.407218, "o", "\u001b[?2004h> "]
[322.464332, "o", "                var pos: Vector2 = child.position\r\n\u001b[?2004l\r\u001b[?2004h> "]
[322.466979, "o", "                var s: int = child.score\r\n\u001b[?2004l\r\u001b[?2004h>                 var auth: int = child.get_multiplayer_authority()\r\n\u001b[?2004l\r\u001b[?2004h"]
[322.46729, "o", "> "]
[322.468283, "o", "                players_dict[key] = {\r\n\u001b[?2004l\r"]
[322.468492, "o", "\u001b[?2004h> "]
[322.469853, "o", "                    \"authority\": auth,\r\n\u001b[?2004l\r"]
[322.470092, "o", "\u001b[?2004h> "]
[322.471655, "o", "                    \"position\": [pos.x, pos.y],\r\n\u001b[?2004l\r"]
[322.471934, "o", "\u001b[?2004h> "]
[322.473008, "o", "                    \"score\": s,\r\n\u001b[?2004l\r"]
[322.473367, "o", "\u001b[?2004h> "]
[322.47377, "o", "                }\r\n\u001b[?2004l\r"]
[322.474191, "o", "\u001b[?2004h> "]
[322.474581, "o", "    return {\r\n\u001b[?2004l\r"]
[322.474809, "o", "\u001b[?2004h> "]
[322.475821, "o", "        \"unique_id\": unique_id,\r\n\u001b[?2004l\r"]
[322.476087, "o", "\u001b[?2004h> "]
[322.476849, "o", "        \"peers\": peers,\r\n\u001b[?2004l\r"]
[322.477281, "o", "\u001b[?2004h> "]
[322.478175, "o", "        \"players\": players_dict,\r\n\u001b[?2004l\r"]
[322.478417, "o", "\u001b[?2004h> "]
[322.478891, "o", "    }\r\n\u001b[?2004l\r\u001b[?2004h> '''\r\n"]
[322.479153, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[322.480991, "o", "with open('/home/user/myproject/main.gd', 'a') as f:\r\n\u001b[?2004l\r"]
[322.481328, "o", "\u001b[?2004h> "]
[322.481841, "o", "    f.write(content)\r\n\u001b[?2004l\r"]
[322.482225, "o", "\u001b[?2004h> "]
[322.48287, "o", "print('wrote part 3')\r\n\u001b[?2004l\r"]
[322.483219, "o", "\u001b[?2004h> "]
[322.483354, "o", "PYEOF\r\n\u001b[?2004l\r"]
[322.600012, "o", "wrote part 3\r\n"]
[322.666731, "o", "\u001b[?2004hroot@58d91b2a-6d91-47bd-aa9d-05eb986c5b8b:~# "]
[327.542164, "i", "cat /home/user/myproject/main.gd | head -50\n"]
[327.543581, "o", "cat /home/user/myproject/main.gd | head -50\r\n\u001b[?2004l\r"]
[327.550714, "o", "extends Node\r\n\r\nconst HOST_ROOT: NodePath = NodePath(\"HostRoot\")\r\nconst CLIENT_ROOT_PREFIX: String = \"ClientRoot_\"\r\nconst PLAYERS_NODE_NAME: String = \"Players\"\r\nconst SPAWNER_NODE_NAME: String = \"Spawner\"\r\nconst PlayerScene: PackedScene = preload(\"res://player.tscn\")\r\n\r\nvar server_root: Node = null\r\nvar client_roots: Array[Node] = []\r\nvar client_multiplayers: Array[MultiplayerAPI] = []\r\nvar host_multiplayer: MultiplayerAPI = null\r\n\r\nvar port: int = 7000\r\nvar num_clients: int = 1\r\nvar num_frames: int = 30\r\nvar score_deltas: Array[int] = []\r\nvar out_path: String = \"\"\r\n\r\nvar frame_count: int = 0\r\nvar all_client_connected: bool = false\r\nvar clients_score_sent: Array[bool] = []\r\n"]
[327.5511, "o", "var json_written: bool = false\r\n\r\nfunc _ready() -> void:\r\n    _parse_args()\r\n    print(\"Args: port=%d clients=%d frames=%d deltas=%s out=%s\" % [port, num_clients, num_frames, str(score_deltas), out_path])\r\n    _build_scene()\r\n    _start_server()\r\n    _start_clients()\r\n    _run()\r\n\r\nfunc _parse_args() -> void:\r\n    var args: PackedStringArray = OS.get_cmdline_user_args()\r\n    var i: int = 0\r\n    while i < args.size():\r\n"]
[327.551346, "o", "        var a: String = args[i]\r\n        if a == \"--port\" and i + 1 < args.size():\r\n            port = int(args[i + 1])\r\n            i += 2\r\n        elif a == \"--clients\" and i + 1 < args.size():\r\n            num_clients = int(args[i + 1])\r\n            i += 2\r\n        elif a == \"--frames\" and i + 1 < args.size():\r\n            num_frames = int(args[i + 1])\r\n            i += 2\r\n        elif a == \"--score-deltas\" and i + 1 < args.size():\r\n            var parts: PackedStringArray = args[i + 1].split(\",\")\r\n            for p in parts:\r\n                if p.strip() != \"\":\r\n"]
[327.552176, "o", "\u001b[?2004hroot@58d91b2a-6d91-47bd-aa9d-05eb986c5b8b:~# "]
[333.322277, "i", "cat > /home/user/myproject/main.tscn << 'EOF'\n[gd_scene load_steps=2 format=3 uid=\"uid://b1main0000a\"]\n\n[ext_resource type=\"Script\" path=\"res://main.gd\" id=\"1_main\"]\n\n[node name=\"Main\" type=\"Node\"]\nscript = ExtResource(\"1_main\")\nEOF\n"]
