[562.059122, "i", "cat << 'PYEOF' > /tmp/test_sdk_client.py\nimport os\nimport json\nfrom apideck_unify import Apideck\n\nc = Apideck(\n    api_key=os.environ['APIDECK_API_KEY'],\n    app_id=os.environ['APIDECK_APP_ID'],\n    consumer_id=os.environ['APIDECK_CONSUMER_ID'],\n)\n\n# Use the SDK's httpx client\nclient = c.sdk_configuration.client\n\ndrive_id = '3ADA079B78534FF1'\nrun_id = 'zrf58p9vrg'\nname = f'report-{run_id}-alpha.txt'\npayload = f'alpha payload for {run_id}\\n'.encode('utf-8')\n\nurl = 'https://upload.apideck.com/file-storage/files'\nfiles = {'file': (name, payload, 'text/plain')}\ndata = {}\nmetadata = {\n    'name': name,\n    'parent_folder_id': 'root',\n    'drive_id': drive_id,\n}\nheaders = {\n    'x-apideck-consumer-id': os.environ['APIDECK_CONSUMER_ID'],\n    'x-apideck-app-id': os.environ['APIDECK_APP_ID'],\n    'x-apideck-service-id': 'onedrive',\n    'x-apideck-metadata': json.dumps(metadata),\n}\n\nr = client.post(url, files=files, data=data, headers=headers, timeout=60.0)\nprint('status:', r.status_code)\nprint('body:', r.text[:2000])\nPYEOF\npython3 /tmp/test_sdk_client.py\n"]
