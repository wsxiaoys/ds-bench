[256.829837, "i", "cat << 'PYEOF' > /tmp/test_session.py\nimport os\nfrom apideck_unify import Apideck\n\nc = Apideck(\n    api_key=os.environ['APIDECK_API_KEY'],\n    app_id=os.environ['APIDECK_APP_ID'],\n    consumer_id=os.environ['APIDECK_CONSUMER_ID'],\n)\n\ndrive_id = '3ADA079B78534FF1'\nrun_id = 'zrf58p9vrg'\nname = f'report-{run_id}-alpha.txt'\npayload = f'alpha payload for {run_id}\\n'.encode('utf-8')\nsize = len(payload)\n\ncreate_resp = c.file_storage.upload_sessions.create(\n    name=name,\n    parent_folder_id='root',\n    drive_id=drive_id,\n    size=size,\n    service_id='onedrive',\n)\nsession_id = create_resp.create_upload_session_response.data.id\nprint('session_id:', session_id[:50] + '...')\n\n# Get session details\nget_resp = c.file_storage.upload_sessions.get(id=session_id, service_id='onedrive')\nprint('GET session:', get_resp)\nif get_resp.get_upload_session_response:\n    print('session data:', get_resp.get_upload_session_response.data)\nPYEOF\npython3 /tmp/test_session.py\n"]
