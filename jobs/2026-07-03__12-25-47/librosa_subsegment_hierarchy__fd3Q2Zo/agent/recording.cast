[182.60497, "o", "k=4 bounds=[0, 1, 28, 39] diffs=[1, 27, 11, 4] min_diff=1\r\n"]
[182.607839, "o", "k=5 bounds=[0, 1, 22, 28, 39] diffs=[1, 21, 6, 11, 4] min_diff=1\r\n"]
[182.608421, "o", "k=6 bounds=[0, 1, 22, 28, 37, 39] diffs=[1, 21, 6, 9, 2, 4] min_diff=1\r\n"]
[182.609601, "o", "k=7 bounds=[0, 1, 22, 25, 28, 37, 39] diffs=[1, 21, 3, 3, 9, 2, 4] min_diff=1\r\n"]
