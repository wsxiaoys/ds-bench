[69.497788, "o", "\u001b[?2004h> "]
[69.497922, "o", "    for k in range(1, len(children)):\r\n\u001b[?2004l\r"]
[69.497951, "o", "\u001b[?2004h> "]
[69.498137, "o", "        if children[k]['start_frame'] != children[k-1]['end_frame']:\r\n\u001b[?2004l\r"]
[69.498224, "o", "\u001b[?2004h> "]
[69.498356, "o", "            children[k]['start_frame'] = children[k-1]['end_frame']\r\n\u001b[?2004l\r"]
[69.498381, "o", "\u001b[?2004h> "]
[69.498551, "o", "            children[k]['start'] = children[k-1]['end']"]
[69.5019, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> # Build final json\r\n\u001b[?2004l\r\u001b[?2004h> coarse_out = [{'index': c['index'], 'start': c['start'], 'end': c['end']} for c in coarse_segments]\r\n\u001b[?2004l\r\u001b[?2004h> fine_sorted = sorted(fine_segments, key=lambda x: x['start'])\r\n\u001b[?2004l\r\u001b[?2004h> fine_out = []\r\n\u001b[?2004l\r\u001b[?2004h> for i, f in enumerate(fine_sorted):\r\n\u001b[?2004l\r\u001b[?2004h>     fine_out.append({'index': i, 'start': f['start'], 'end': f['end'], 'parent_index': f['parent_index']})\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> result = {'coarse': coarse_out, 'fine': fine_out}\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> with open('/home/user/hierarchy.json', 'w') as f:\r\n\u001b[?2004l\r\u001b[?2004h>     json.dump(result, f, indent=2)\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> print(json.dumps(result, indent=2))\r\n\u001b[?2004l\r\u001b[?2004h> PYEOF\r\n\u001b[?2004l\r"]
