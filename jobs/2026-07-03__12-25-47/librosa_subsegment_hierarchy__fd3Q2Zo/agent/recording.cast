[69.483269, "o", "    end_t = float(librosa.frames_to_time(np.array([end_frame]), sr=sr, hop_length=HOP)[0])\r\n\u001b[?2004l\r\u001b[?2004h> "]
[69.483773, "o", "    coarse_segments.append({'index': i, 'start_frame': start_frame, 'end_frame': end_frame, 'start': start_t, 'end': end_t})\r\n\u001b[?2004l\r\u001b[?2004h> "]
[69.483806, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[69.483935, "o", "# Clamp last end to duration\r\n\u001b[?2004l\r\u001b[?2004h"]
[69.483993, "o", "> "]
[69.484102, "o", "coarse_segments[-1]['end'] = duration\r\n\u001b[?2004l\r"]
[69.484134, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[69.484197, "o", "> "]
[69.48428, "o", "# Subsegment each coarse segment\r\n\u001b[?2004l\r\u001b[?2004h"]
[69.484333, "o", "> fine_segments = []\r\n"]
[69.48438, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[69.484463, "o", "for c in coarse_segments:\r\n\u001b[?2004l\r\u001b[?2004h"]
[69.484513, "o", "> "]
[69.484693, "o", "    # Use the beat frames as the segment boundaries\r\n\u001b[?2004l\r\u001b[?2004h> "]
[69.485035, "o", "    # We need beat frames for this segment: find beats in [c['start_frame'], c['end_frame']]\r\n\u001b[?2004l\r"]
[69.48513, "o", "\u001b[?2004h> "]
[69.485426, "o", "    seg_beats = beats[(beats >= c['start_frame']) & (beats <= c['end_frame'])]\r\n\u001b[?2004l\r\u001b[?2004h> "]
[69.485731, "o", "    if len(seg_beats) < 2:\r\n\u001b[?2004l\r\u001b[?2004h"]
[69.485778, "o", ">         # not enough beats, just split equally? Use the frames\r\n\u001b[?2004l\r\u001b[?2004h> "]
[69.485907, "o", "        # Fallback: use frames\r\n\u001b[?2004l\r\u001b[?2004h> "]
[69.486109, "o", "        seg_beats = np.array([c['start_frame'], c['end_frame']])\r\n\u001b[?2004l\r\u001b[?2004h"]
[69.486145, "o", "> "]
[69.486449, "o", "    sub_bounds = librosa.segment.subsegment(chroma, seg_beats, n_segments=3)\r\n\u001b[?2004l\r"]
[69.486538, "o", "\u001b[?2004h> "]
[69.486698, "o", "    # sub_bounds merges input boundaries; split into per-interval 3 each\r\n\u001b[?2004l\r"]
[69.486775, "o", "\u001b[?2004h> "]
[69.487023, "o", "    # Number of intervals = len(seg_beats)-1, each interval should have up to 3 new boundaries\r\n\u001b[?2004l\r"]
[69.487056, "o", "\u001b[?2004h> "]
[69.487392, "o", "    # Total boundaries = (n_intervals) * (n_segments-1) + 1? Actually: per interval we get n_segments+1 boundaries if all exist\r\n\u001b[?2004l\r\u001b[?2004h"]
[69.487448, "o", "> "]
[69.487818, "o", "    # But subsegment returns boundaries consistent across intervals. The boundaries array contains all input boundaries AND the internal sub-boundaries.\r\n\u001b[?2004l\r"]
[69.487942, "o", "\u001b[?2004h> "]
[69.4883, "o", "    # The structure is: for each interval, returns n_segments boundaries (left boundary at start of interval, then n_segments-1 interior, then end is start of next).\r\n\u001b[?2004l\r"]
[69.488408, "o", "\u001b[?2004h> "]
[69.488706, "o", "    # Actually based on docs, subsegment returns \"list of sub-divided segment boundaries\" merging input boundaries.\r\n\u001b[?2004l\r"]
[69.488782, "o", "\u001b[?2004h> "]
[69.489092, "o", "    # Let's split: input has len(seg_beats) boundaries. Output should split each interval into n_segments subintervals.\r\n\u001b[?2004l\r"]
[69.489123, "o", "\u001b[?2004h> "]
[69.48939, "o", "    # So between input[i] and input[i+1], there are n_segments-1 new boundaries added.\r\n\u001b[?2004l\r"]
[69.489444, "o", "\u001b[?2004h> "]
[69.489759, "o", "    # Total = len(seg_beats) + (len(seg_beats)-1)*(n_segments-1) = n_segments*len(seg_beats) - n_segments + 1\r\n\u001b[?2004l\r"]
[69.489796, "o", "\u001b[?2004h> "]
[69.489921, "o", "    n_int = len(seg_beats) - 1\r\n\u001b[?2004l\r\u001b[?2004h"]
[69.489956, "o", "> "]
[69.490108, "o", "    expected = n_int * n_segments - n_segments + 1\r\n\u001b[?2004l\r"]
[69.490184, "o", "\u001b[?2004h> "]
[69.490624, "o", "    print('coarse', c['index'], 'seg_beats:', seg_beats, 'sub_bounds:', sub_bounds, 'expected:', expected)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[69.49165, "o", "    # Walk through intervals\r\n\u001b[?2004l\r\u001b[?2004h>     all_bounds = list(sub_bounds)\r\n\u001b[?2004l\r\u001b[?2004h>     idx = 0\r\n\u001b[?2004l\r\u001b[?2004h>     for interval_i in range(n_int):\r\n\u001b[?2004l\r\u001b[?2004h>         # take n_segments+1 boundaries: start, n_segments-1 interior, end\r\n\u001b[?2004l\r\u001b[?2004h>         # But end of interval i == start of interval i+1\r\n\u001b[?2004l\r\u001b[?2004h> "]
[69.492258, "o", "        # To extract exactly 3 sub-segments per interval, we want to read n_segments boundaries that include end of last\r\n\u001b[?2004l\r\u001b[?2004h>         # Actually let's just collect 3 boundaries per sub-seg \r\n\u001b[?2004l\r\u001b[?2004h>         # sub-seg j in [0..2]: boundary[j] to boundary[j+1]\r\n\u001b[?2004l\r\u001b[?2004h> "]
[69.492544, "o", "        # 4 boundaries per interval (start, two interior, end)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[69.492733, "o", "        # Let's check sizes: if each interval is split into 3, we have 4 boundaries per interval\r\n\u001b[?2004l\r\u001b[?2004h"]
[69.492798, "o", "> "]
[69.493554, "o", "        # but adjacent intervals share a boundary. So total = (n_int)*(n_segments+1) - (n_int-1) = n_int*n_segments + 1\r\n\u001b[?2004l\r\u001b[?2004h>         # That's what we expect\r\n\u001b[?2004l\r\u001b[?2004h>         b_sub = all_bounds[idx:idx+n_segments+1]\r\n\u001b[?2004l\r\u001b[?2004h> "]
[69.493626, "o", "        idx += n_segments\r\n\u001b[?2004l\r\u001b[?2004h> "]
[69.493921, "o", "        if len(b_sub) < n_segments+1:\r\n\u001b[?2004l\r\u001b[?2004h>             break\r\n\u001b[?2004l\r\u001b[?2004h> "]
[69.493986, "o", "        # build 3 sub-segments\r\n\u001b[?2004l\r\u001b[?2004h> "]
[69.494267, "o", "        for j in range(n_segments):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[69.494696, "o", "            sf = int(b_sub[j])\r\n\u001b[?2004l\r\u001b[?2004h>             ef = int(b_sub[j+1])\r\n\u001b[?2004l\r\u001b[?2004h>             # sanity: must be within coarse\r\n\u001b[?2004l\r\u001b[?2004h>             if sf < c['start_frame']: sf = c['start_frame']\r\n\u001b[?2004l\r\u001b[?2004h> "]
