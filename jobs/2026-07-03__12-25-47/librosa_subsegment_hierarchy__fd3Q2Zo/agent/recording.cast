[175.230903, "o", "> "]
[175.231124, "o", "    diffs = np.diff(np.concatenate([b_cand, [n_beats_total - 1]]))\r\n\u001b[?2004l\r"]
[175.231149, "o", "\u001b[?2004h> "]
[175.231267, "o", "    min_diff = int(diffs.min())\r\n\u001b[?2004l\r"]
[175.231293, "o", "\u001b[?2004h> "]
[175.231581, "o", "    # We need each interval to have enough beats for subsegment to yield 3 sub-segments\r\n\u001b[?2004l\r"]
[175.231606, "o", "\u001b[?2004h> "]
[175.23186, "o", "    # If an interval has few beats (< 4), it will fall back to even split\r\n\u001b[?2004l\r"]
[175.231899, "o", "\u001b[?2004h> "]
