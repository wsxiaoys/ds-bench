[183.327409, "o", "\u001b[?2004hroot@43871d43-2a93-4efb-8caa-f8f57bce6383:/tmp# "]
[209.647947, "i", "cat > /tmp/verify.py << 'PYEOF'\nimport json\nimport numpy as np\nimport librosa\n\nHOP = 512\nSR = 22050\n\ny, sr = librosa.load('/home/user/input.wav', sr=SR)\nduration = len(y) / float(sr)\n\nwith open('/home/user/hierarchy.json') as f:\n    res = json.load(f)\n\ncoarse = res['coarse']\nfine = res['fine']\n\nprint(f'audio duration: {duration}s')\n\n# Check coarse\nassert len(coarse) >= 4 and len(coarse) <= 8, f'coarse count {len(coarse)} not in 4..8'\nfor i, c in enumerate(coarse):\n    assert c['index'] == i, f'coarse index wrong at {i}: {c[\"index\"]}'\n    assert isinstance(c['start'], float) and isinstance(c['end'], float)\n    assert c['start'] < c['end'], f'segment {i} start >= end'\n\n# First starts within 0.3s of 0\nassert abs(coarse[0]['start']) <= 0.3, f'first start {coarse[0][\"start\"]} not within 0.3s of 0'\n# Last ends within 0.5s of duration\nassert abs(coarse[-1]['end'] - duration) <= 0.5, f'last end {coarse[-1][\"end\"]} not within 0.5s of duration {duration}'\n# Consecutive segments: no overlap, gap <= 0.3\nfor i in range(len(coarse)-1):\n    gap = coarse[i+1]['start'] - coarse[i]['end']\n    assert -1e-9 <= gap <= 0.3, f'gap {gap} at coarse {i}/{i+1}'\n    assert coarse[i]['end'] - coarse[i]['start'] > 0.5, f'coarse {i} too short: {coarse[i][\"end\"]-coarse[i][\"start\"]}'\n\n# Check fine\nassert all(isinstance(f['index'], int) for f in fine)\nassert all(f['index'] == i for i, f in enumerate(fine)) or True\nfine_by_index = sorted(fine, key=lambda x: x['index'])\nassert all(fine_by_index[i]['index'] == i for i in range(len(fine)))\nfor i, f in enumerate(fine):\n    assert isinstance(f['start'], float) and isinstance(f['end'], float) and isinstance(f['parent_index'], int)\n    assert f['start'] < f['end']\n    assert f['end'] - f['start'] > 0.1, f'fine {i} too short: {f[\"end\"]-f[\"start\"]}'\n\n# Each coarse should have exactly 3 fine\nfrom collections import defaultdict\nchildren = defaultdict(list)\nfor f in fine:\n    children[f['parent_index']].append(f)\n\nfor c_idx in range(len(coarse)):\n    kids = sorted(children[c_idx], key=lambda x: x['start'])\n    assert len(kids) == 3, f'coarse {c_idx} has {len(kids)} children'\n    c = coarse[c_idx]\n    # First child start ~= coarse start (within 0.05)\n    assert abs(kids[0]['start'] - c['start']) <= 0.05, f'coarse {c_idx} first child start {kids[0][\"start\"]} vs coarse start {c[\"start\"]}'\n    # Last child end ~= coarse end\n    assert abs(kids[-1]['end'] - c['end']) <= 0.05, f'coarse {c_idx} last child end {kids[-1][\"end\"]} vs coarse end {c[\"end\"]}'\n    # Adjacent kids: gap <= 0.05\n    for j in range(len(kids)-1):\n        g = kids[j+1]['start'] - kids[j]['end']\n        assert -1e-9 <= g <= 0.05, f'fine gap {g} at coarse {c_idx}, child {j}/{j+1}'\n\nprint('All coarse/fine constraints satisfied!')\nPYEOF\npython3 /tmp/verify.py\n"]
