[175.240476, "o", "        # No beats inside; we'll just use evenly spaced frame boundaries\r\n\u001b[?2004l\r"]
[175.240505, "o", "\u001b[?2004h> "]
[175.240581, "o", "        children = []\r\n\u001b[?2004l\r"]
[175.24061, "o", "\u001b[?2004h> "]
[175.240717, "o", "        for j in range(N_SEG):\r\n\u001b[?2004l\r\u001b[?2004h"]
[175.240747, "o", "> "]
[175.241023, "o", "            sf = c['start_frame'] + (c['end_frame'] - c['start_frame']) * j // N_SEG\r\n\u001b[?2004l\r"]
[175.241051, "o", "\u001b[?2004h> "]
[175.241342, "o", "            ef = c['start_frame'] + (c['end_frame'] - c['start_frame']) * (j + 1) // N_SEG\r\n\u001b[?2004l\r"]
[175.241371, "o", "\u001b[?2004h> "]
[175.241674, "o", "            start_t = float(librosa.frames_to_time(np.array([sf]), sr=sr, hop_length=HOP)[0])\r\n\u001b[?2004l\r"]
[175.241704, "o", "\u001b[?2004h> "]
[175.242009, "o", "            end_t = float(librosa.frames_to_time(np.array([ef]), sr=sr, hop_length=HOP)[0])\r\n\u001b[?2004l\r\u001b[?2004h"]
[175.242043, "o", "> "]
[175.242437, "o", "            children.append({'start_frame': sf, 'end_frame': ef, 'start': start_t, 'end': end_t, 'parent_index': c['index']})\r\n\u001b[?2004l\r"]
[175.24247, "o", "\u001b[?2004h> "]
[175.242495, "o", "    else:\r\n\u001b[?2004l\r"]
[175.242573, "o", "\u001b[?2004h> "]
[175.242727, "o", "        # Use seg_beats as input boundaries for subsegment\r\n\u001b[?2004l\r"]
[175.242761, "o", "\u001b[?2004h> "]
[175.243044, "o", "        sub_bounds = librosa.segment.subsegment(chroma, seg_beats, n_segments=N_SEG)\r\n\u001b[?2004l\r\u001b[?2004h"]
[175.243074, "o", "> "]
[175.243223, "o", "        sub_bounds = np.asarray(sub_bounds)\r\n\u001b[?2004l\r"]
[175.243252, "o", "\u001b[?2004h> "]
[175.243367, "o", "        n_int = len(seg_beats) - 1\r\n\u001b[?2004l\r"]
[175.243392, "o", "\u001b[?2004h> "]
[175.243584, "o", "        # Walk: take n_segments+1 boundaries per interval\r\n\u001b[?2004l\r"]
[175.24361, "o", "\u001b[?2004h> "]
[175.243881, "o", "        # interval 0 uses idx 0..n_seg, interval 1 uses idx n_seg..2n_seg, etc.\r\n\u001b[?2004l\r"]
[175.243907, "o", "\u001b[?2004h> "]
[175.244067, "o", "        # Total expected length: n_int * n_seg + 1\r\n\u001b[?2004l\r"]
[175.244094, "o", "\u001b[?2004h> "]
[175.244169, "o", "        children = []\r\n\u001b[?2004l\r"]
[175.244195, "o", "\u001b[?2004h> "]
[175.244318, "o", "        all_b = sub_bounds.tolist()\r\n\u001b[?2004l\r"]
[175.244345, "o", "\u001b[?2004h> "]
[175.244486, "o", "        expected_len = n_int * N_SEG + 1\r\n\u001b[?2004l\r"]
[175.244512, "o", "\u001b[?2004h> "]
[175.244641, "o", "        if len(all_b) < expected_len:\r\n\u001b[?2004l\r"]
[175.244667, "o", "\u001b[?2004h> "]
[175.244925, "o", "            # Some intervals may have been degraded due to too few frames.\r\n\u001b[?2004l\r"]
[175.244953, "o", "\u001b[?2004h> "]
[175.245145, "o", "            # In that case, the boundaries might be fewer.\r\n\u001b[?2004l\r"]
[175.24517, "o", "\u001b[?2004h> "]
[175.245234, "o", "            pass\r\n\u001b[?2004l\r"]
[175.245267, "o", "\u001b[?2004h> "]
[175.245521, "o", "        # Just use the structure: n_seg boundaries per interval (sharing endpoints)\r\n\u001b[?2004l\r"]
[175.245554, "o", "\u001b[?2004h> "]
[175.245613, "o", "        idx = 0\r\n\u001b[?2004l\r\u001b[?2004h> "]
[175.245891, "o", "        # The pattern: bounds = [b0, int_0_1, int_0_2, b1, int_1_1, int_1_2, b2, ...]\r\n\u001b[?2004l\r\u001b[?2004h"]
[175.245923, "o", "> "]
[175.246248, "o", "        # For each interval i, subsegments are pairs: (b[i*n_seg + j], b[i*n_seg + j+1]) for j=0..n_seg-1\r\n\u001b[?2004l\r\u001b[?2004h"]
[175.246281, "o", "> "]
[175.246619, "o", "        # So need n_seg+1 boundaries per interval: from idx i*n_seg to (i+1)*n_seg inclusive (n_seg+1 entries)\r\n\u001b[?2004l\r\u001b[?2004h"]
[175.246651, "o", "> "]
[175.246766, "o", "        for interval_i in range(n_int):\r\n\u001b[?2004l\r"]
[175.246797, "o", "\u001b[?2004h> "]
[175.246932, "o", "            start_idx = interval_i * N_SEG\r\n\u001b[?2004l\r\u001b[?2004h"]
[175.246963, "o", "> "]
[175.247094, "o", "            end_idx = start_idx + N_SEG + 1\r\n\u001b[?2004l\r"]
[175.247124, "o", "\u001b[?2004h> "]
[175.247237, "o", "            if end_idx > len(all_b):\r\n\u001b[?2004l\r\u001b[?2004h"]
[175.247268, "o", "> "]
[175.247375, "o", "                end_idx = len(all_b)\r\n\u001b[?2004l\r"]
[175.247408, "o", "\u001b[?2004h> "]
[175.247548, "o", "            b_sub = all_b[start_idx:end_idx]\r\n\u001b[?2004l\r"]
[175.247578, "o", "\u001b[?2004h> "]
[175.247664, "o", "            # pad if needed\r\n\u001b[?2004l\r\u001b[?2004h"]
[175.247694, "o", "> "]
[175.247819, "o", "            while len(b_sub) < N_SEG + 1:\r\n\u001b[?2004l\r\u001b[?2004h"]
[175.247851, "o", "> "]
[175.247989, "o", "                b_sub.append(c['end_frame'])\r\n\u001b[?2004l\r\u001b[?2004h"]
[175.248021, "o", "> "]
[175.248181, "o", "            # truncate if too many (shouldn't happen)\r\n\u001b[?2004l\r\u001b[?2004h"]
[175.248212, "o", "> "]
[175.248327, "o", "            if len(b_sub) > N_SEG + 1:\r\n\u001b[?2004l\r\u001b[?2004h"]
[175.248358, "o", "> "]
[175.248482, "o", "                b_sub = b_sub[:N_SEG + 1]\r\n\u001b[?2004l\r"]
[175.248513, "o", "\u001b[?2004h> "]
[175.248617, "o", "            for j in range(N_SEG):\r\n\u001b[?2004l\r\u001b[?2004h"]
[175.248647, "o", "> "]
[175.248751, "o", "                sf = int(b_sub[j])\r\n\u001b[?2004l\r\u001b[?2004h"]
[175.248781, "o", "> "]
[175.2489, "o", "                ef = int(b_sub[j+1])\r\n\u001b[?2004l\r\u001b[?2004h"]
[175.248931, "o", "> "]
[175.249093, "o", "                if sf < c['start_frame']: sf = c['start_frame']\r\n\u001b[?2004l\r\u001b[?2004h"]
[175.249125, "o", "> "]
[175.249267, "o", "                if ef > c['end_frame']: ef = c['end_frame']\r\n\u001b[?2004l\r\u001b[?2004h"]
[175.249298, "o", "> "]
[175.249364, "o", "                if ef <= sf:\r\n\u001b[?2004l\r\u001b[?2004h"]
[175.249393, "o", "> "]
[175.249467, "o", "                    ef = sf + 1\r\n\u001b[?2004l\r\u001b[?2004h"]
[175.249497, "o", "> "]
[175.249734, "o", "                start_t = float(librosa.frames_to_time(np.array([sf]), sr=sr, hop_length=HOP)[0])\r\n\u001b[?2004l\r\u001b[?2004h"]
[175.249765, "o", "> "]
[175.250023, "o", "                end_t = float(librosa.frames_to_time(np.array([ef]), sr=sr, hop_length=HOP)[0])\r\n\u001b[?2004l\r\u001b[?2004h"]
[175.250059, "o", "> "]
[175.25037, "o", "                children.append({'start_frame': sf, 'end_frame': ef, 'start': start_t, 'end': end_t, 'parent_index': c['index']})\r\n\u001b[?2004l\r\u001b[?2004h"]
[175.250402, "o", "> "]
[175.250482, "o", "        if len(children) != N_SEG:\r\n\u001b[?2004l\r\u001b[?2004h"]
[175.250514, "o", "> "]
[175.250601, "o", "            # Fall back to even split\r\n\u001b[?2004l\r\u001b[?2004h"]
[175.250631, "o", "> "]
[175.250689, "o", "            children = []\r\n\u001b[?2004l\r"]
[175.25072, "o", "\u001b[?2004h> "]
[175.250801, "o", "            for j in range(N_SEG):\r\n\u001b[?2004l\r\u001b[?2004h"]
[175.25083, "o", "> "]
[175.251053, "o", "                sf = c['start_frame'] + (c['end_frame'] - c['start_frame']) * j // N_SEG\r\n\u001b[?2004l\r\u001b[?2004h"]
[175.251086, "o", "> "]
[175.251313, "o", "                ef = c['start_frame'] + (c['end_frame'] - c['start_frame']) * (j + 1) // N_SEG\r\n\u001b[?2004l\r\u001b[?2004h"]
[175.251344, "o", "> "]
[175.251579, "o", "                start_t = float(librosa.frames_to_time(np.array([sf]), sr=sr, hop_length=HOP)[0])\r\n\u001b[?2004l\r"]
[175.251608, "o", "\u001b[?2004h> "]
[175.25189, "o", "                end_t = float(librosa.frames_to_time(np.array([ef]), sr=sr, hop_length=HOP)[0])\r\n\u001b[?2004l\r"]
[175.251919, "o", "\u001b[?2004h> "]
[175.252299, "o", "                children.append({'start_frame': sf, 'end_frame': ef, 'start': start_t, 'end': end_t, 'parent_index': c['index']})\r\n\u001b[?2004l\r\u001b[?2004h"]
[175.252328, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h"]
[175.252392, "o", "> "]
[175.252455, "o", "    fine_segments.extend(children)\r\n\u001b[?2004l\r\u001b[?2004h"]
[175.25248, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[175.252737, "o", "# Ensure each coarse segment's children cover it exactly: first.start = c.start, last.end = c.end\r\n\u001b[?2004l\r"]
[175.252764, "o", "\u001b[?2004h> "]
[175.252807, "o", "# and adjacency\r\n\u001b[?2004l\r"]
[175.252835, "o", "\u001b[?2004h> "]
[175.252917, "o", "for c in coarse_segments:\r\n\u001b[?2004l\r\u001b[?2004h"]
[175.252945, "o", "> "]
[175.253143, "o", "    children = [f for f in fine_segments if f['parent_index'] == c['index']]\r\n\u001b[?2004l\r"]
[175.25317, "o", "\u001b[?2004h> "]
[175.253313, "o", "    children.sort(key=lambda x: x['start_frame'])\r\n\u001b[?2004l\r\u001b[?2004h"]
[175.253341, "o", "> "]
[175.25347, "o", "    children[0]['start_frame'] = c['start_frame']\r\n\u001b[?2004l\r\u001b[?2004h"]
[175.253496, "o", "> "]
[175.253602, "o", "    children[0]['start'] = c['start']\r\n\u001b[?2004l\r\u001b[?2004h"]
[175.25363, "o", "> "]
[175.253751, "o", "    children[-1]['end_frame'] = c['end_frame']\r\n\u001b[?2004l\r"]
[175.253779, "o", "\u001b[?2004h> "]
[175.253886, "o", "    children[-1]['end'] = c['end']\r\n\u001b[?2004l\r"]
[175.253912, "o", "\u001b[?2004h> "]
[175.254034, "o", "    # Make adjacent children share boundary\r\n\u001b[?2004l\r\u001b[?2004h"]
[175.254062, "o", "> "]
[175.254161, "o", "    for k in range(1, len(children)):\r\n\u001b[?2004l\r\u001b[?2004h"]
[175.254187, "o", "> "]
[175.25436, "o", "        children[k]['start_frame'] = children[k-1]['end_frame']\r\n\u001b[?2004l\r\u001b[?2004h"]
[175.254387, "o", "> "]
[175.25452, "o", "        children[k]['start'] = children[k-1]['end']\r\n\u001b[?2004l\r\u001b[?2004h"]
[175.254547, "o", "> "]
[175.254839, "o", "    # Ensure each child has minimum duration (>0.1s i.e. > ~4-5 frames at hop=512 and sr=22050: 0.1s = 4.3 frames)\r\n\u001b[?2004l\r"]
[175.25487, "o", "\u001b[?2004h> "]
[175.254969, "o", "    for k in range(len(children)):\r\n\u001b[?2004l\r"]
[175.254997, "o", "\u001b[?2004h> "]
[175.25522, "o", "        min_frames = int(np.ceil(0.1 * sr / HOP)) + 1  # at least 5 frames for >0.1s\r\n\u001b[?2004l\r\u001b[?2004h"]
[175.255247, "o", "> "]
[175.255456, "o", "        if children[k]['end_frame'] - children[k]['start_frame'] < min_frames:\r\n\u001b[?2004l\r\u001b[?2004h"]
[175.255482, "o", "> "]
[175.255594, "o", "            # Steal from next if exists\r\n\u001b[?2004l\r\u001b[?2004h"]
[175.255622, "o", "> "]
[175.255918, "o", "            if k + 1 < len(children) and children[k+1]['end_frame'] - children[k+1]['start_frame'] > min_frames:\r\n\u001b[?2004l\r\u001b[?2004h"]
[175.255944, "o", "> "]
[175.256187, "o", "                steal = min_frames - (children[k]['end_frame'] - children[k]['start_frame'])\r\n\u001b[?2004l\r"]
[175.256214, "o", "\u001b[?2004h> "]
[175.256352, "o", "                children[k]['end_frame'] += steal\r\n\u001b[?2004l\r"]
[175.256378, "o", "\u001b[?2004h> "]
[175.256721, "o", "                children[k]['end'] = float(librosa.frames_to_time(np.array([children[k]['end_frame']]), sr=sr, hop_length=HOP)[0])\r\n\u001b[?2004l\r\u001b[?2004h"]
[175.256747, "o", "> "]
[175.256942, "o", "                children[k+1]['start_frame'] = children[k]['end_frame']\r\n\u001b[?2004l\r"]
[175.256968, "o", "\u001b[?2004h> "]
[175.257128, "o", "                children[k+1]['start'] = children[k]['end']\r\n\u001b[?2004l\r\u001b[?2004h"]
[175.257154, "o", "> "]
[175.257422, "o", "            elif k - 1 >= 0 and children[k-1]['end_frame'] - children[k-1]['start_frame'] > min_frames:\r\n\u001b[?2004l\r\u001b[?2004h"]
[175.257448, "o", "> "]
[175.25769, "o", "                steal = min_frames - (children[k]['end_frame'] - children[k]['start_frame'])\r\n\u001b[?2004l\r\u001b[?2004h"]
[175.257715, "o", "> "]
[175.257869, "o", "                children[k]['start_frame'] -= steal\r\n\u001b[?2004l\r\u001b[?2004h"]
[175.257895, "o", "> "]
[175.258239, "o", "                children[k]['start'] = float(librosa.frames_to_time(np.array([children[k]['start_frame']]), sr=sr, hop_length=HOP)[0])\r\n\u001b[?2004l\r\u001b[?2004h"]
[175.258265, "o", "> "]
[175.258974, "o", "                children[k-1]['end_frame'] = children[k]['start_frame']\r\n\u001b[?2004l\r\u001b[?2004h>                 children[k-1]['end'] = children[k]['start']\r\n\u001b[?2004l\r"]
[175.260343, "o", "\u001b[?2004h> "]
[175.260853, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> # Verify each coarse segment has exactly 3 fine segments\r\n\u001b[?2004l\r\u001b[?2004h> for c in coarse_segments:\r\n\u001b[?2004l\r\u001b[?2004h>     n_children = sum(1 for f in fine_segments if f['parent_index'] == c['index'])\r\n\u001b[?2004l\r"]
[175.261377, "o", "\u001b[?2004h>     if n_children != N_SEG:\r\n\u001b[?2004l\r\u001b[?2004h>         print(f'WARNING: coarse {c[\"index\"]} has {n_children} fine segments')\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> # Build final json\r\n\u001b[?2004l\r\u001b[?2004h> "]
[175.261735, "o", "coarse_out = [{'index': c['index'], 'start': round(float(c['start']), 6), 'end': round(float(c['end']), 6)} for c in coarse_segments]\r\n\u001b[?2004l\r"]
[175.261909, "o", "\u001b[?2004h> # Sort fine by start time globally\r\n\u001b[?2004l\r\u001b[?2004h> "]
[175.303215, "o", "fine_sorted = sorted(fine_segments, key=lambda x: x['start'])\r\n\u001b[?2004l\r\u001b[?2004h"]
[175.303254, "o", "> fine_out = []\r\n\u001b[?2004l\r"]
[175.303329, "o", "\u001b[?2004h> "]
[175.30338, "o", "for i, f in enumerate(fine_sorted):\r\n\u001b[?2004l\r\u001b[?2004h"]
[175.303423, "o", "> "]
[175.30377, "o", "    fine_out.append({'index': i, 'start': round(float(f['start']), 6), 'end': round(float(f['end']), 6), 'parent_index': int(f['parent_index'])})\r\n\u001b[?2004l\r"]
[175.303816, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[175.30387, "o", "> "]
[175.303966, "o", "result = {'coarse': coarse_out, 'fine': fine_out}\r\n\u001b[?2004l\r\u001b[?2004h"]
[175.304008, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[175.304151, "o", "with open('/home/user/hierarchy.json', 'w') as f:\r\n\u001b[?2004l\r\u001b[?2004h"]
[175.304173, "o", "> "]
[175.304268, "o", "    json.dump(result, f, indent=2)\r\n\u001b[?2004l\r\u001b[?2004h"]
[175.304291, "o", "> \r\n\u001b[?2004l\r"]
[175.304338, "o", "\u001b[?2004h> "]
[175.304416, "o", "print(json.dumps(result, indent=2))\r\n\u001b[?2004l\r"]
[175.304456, "o", "\u001b[?2004h> PYEOF\r\n\u001b[?2004l\r"]
[175.306427, "o", "\u001b[?2004hroot@43871d43-2a93-4efb-8caa-f8f57bce6383:/tmp# "]
[177.964679, "i", "python3 /tmp/segment.py 2>&1\n"]
[177.964987, "o", "python3 /tmp/segment.py 2>&1\r\n\u001b[?2004l\r"]
