[69.495405, "o", "            end_t = float(librosa.frames_to_time(np.array([ef]), sr=sr, hop_length=HOP)[0])\r\n\u001b[?2004l\r\u001b[?2004h> "]
[69.495752, "o", "            fine_segments.append({'start_frame': sf, 'end_frame': ef, 'start': start_t, 'end': end_t, 'parent_index': c['index']})\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[69.495815, "o", "\u001b[?2004h> "]
