[69.496028, "o", "for c in coarse_segments:\r\n\u001b[?2004l\r"]
[69.496058, "o", "\u001b[?2004h> "]
[69.496273, "o", "    children = [f for f in fine_segments if f['parent_index'] == c['index']]\r\n\u001b[?2004l\r"]
[69.496301, "o", "\u001b[?2004h> "]
[69.496368, "o", "    if not children:\r\n\u001b[?2004l\r"]
[69.496395, "o", "\u001b[?2004h> "]
[69.496464, "o", "        continue\r\n\u001b[?2004l\r\u001b[?2004h"]
[69.496507, "o", "> "]
[69.496603, "o", "    # first start clamp to coarse start\r\n\u001b[?2004l\r"]
[69.496665, "o", "\u001b[?2004h> "]
[69.496788, "o", "    if abs(children[0]['start'] - c['start']) > 0.001:\r\n\u001b[?2004l\r"]
[69.496814, "o", "\u001b[?2004h> "]
[69.496961, "o", "        children[0]['start'] = c['start']\r\n\u001b[?2004l\r\u001b[?2004h"]
[69.497007, "o", "> "]
[69.497128, "o", "        children[0]['start_frame'] = c['start_frame']\r\n\u001b[?2004l\r"]
[69.497156, "o", "\u001b[?2004h> "]
[69.497259, "o", "    # last end clamp to coarse end\r\n\u001b[?2004l\r"]
[69.497287, "o", "\u001b[?2004h> "]
[69.497392, "o", "    children[-1]['end'] = c['end']\r\n\u001b[?2004l\r"]
[69.49742, "o", "\u001b[?2004h> "]
[69.497546, "o", "    children[-1]['end_frame'] = c['end_frame']\r\n\u001b[?2004l\r"]
[69.497573, "o", "\u001b[?2004h> "]
