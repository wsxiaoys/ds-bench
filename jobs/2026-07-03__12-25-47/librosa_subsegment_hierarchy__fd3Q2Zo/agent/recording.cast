[82.832468, "o", "\r\nduration: 25.0\r\nTraceback (most recent call last):\r\n  File \"/tmp/segment.py\", line 77, in <module>\r\n    expected = n_int * n_segments - n_segments + 1\r\n                       ^^^^^^^^^^\r\nNameError: name 'n_segments' is not defined. Did you mean: 'fine_segments'?\r\n"]
[82.903744, "o", "\u001b[?2004hroot@43871d43-2a93-4efb-8caa-f8f57bce6383:/tmp# "]
[118.904052, "i", "cat > /tmp/segment.py << 'PYEOF'\nimport json\nimport numpy as np\nimport librosa\nimport librosa.feature\nimport librosa.beat\nimport librosa.segment\n\nHOP = 512\nSR = 22050\nN_SEG = 3\n\n# Load audio\ny, sr = librosa.load('/home/user/input.wav', sr=SR)\nduration = len(y) / float(sr)\n\n# Beat tracking\ntempo, beats = librosa.beat.beat_track(y=y, sr=sr, hop_length=HOP)\nbeats = np.asarray(beats)\nn_beats_total = len(beats)\nprint('duration:', duration, 'tempo:', tempo, 'beats:', n_beats_total)\n\n# Chroma CQT\nchroma = librosa.feature.chroma_cqt(y=y, sr=sr, hop_length=HOP)\n\n# Beat-synchronous chroma\nsync_chroma = librosa.util.sync(chroma, beats)\n\n# Coarse segmentation\n# Choose k so that each segment has at least 3 beats (so subsegment can give 3 sub-segments)\n# 44 beats / k=4 -> ~11 beats per segment, plenty\n# 44 beats / k=5 -> ~9 beats per segment\n# 44 beats / k=6 -> ~7 beats per segment\n# 44 beats / k=7 -> ~6 beats per segment\n# 44 beats / k=8 -> ~5 beats per segment\n# Try k=5 first\nk = 5\nbounds = librosa.segment.agglomerative(sync_chroma, k)\nbounds = np.asarray(bounds)\nprint('agglo bounds:', bounds, 'k=', k)\n\n# beats array indices -> frame mapping\n# Map each beat index to its frame\n# A coarse segment is bounds[i]..bounds[i+1] in beat indices\n# So start_frame = beats[bounds[i]], end_frame = beats[bounds[i+1]] (or end of track)\ntotal_frames = chroma.shape[1]\n\ncoarse_segments = []\nfor i in range(len(bounds)):\n    bi_start = int(bounds[i])\n    bi_end = int(bounds[i+1]) if i+1 < len(bounds) else (n_beats_total - 1)\n    # bi_end is the inclusive last beat of this segment; the segment is [beats[bi_start], beats[bi_end]]\n    # The next segment starts at beats[bi_end] (next coarse boundary index is bi_end)\n    # wait: if i+1 has bounds[i+1] = bi_end, then segment i goes from beats[bounds[i]] to beats[bounds[i+1]]\n    # but as a half-open interval we typically use [start, end). Let's use bi_end as index but the end_frame is beats[bi_end]\n    # and next segment starts at beats[bi_end] = same frame. So they share boundary.\n    start_frame = int(beats[bi_start])\n    if i + 1 < len(bounds):\n        end_frame = int(beats[bounds[i+1]])\n    else:\n        # Last segment: extend to end of audio\n        end_frame = total_frames\n    start_t = float(librosa.frames_to_time(np.array([start_frame]), sr=sr, hop_length=HOP)[0])\n    end_t = float(librosa.frames_to_time(np.array([end_frame]), sr=sr, hop_length=HOP)[0])\n    coarse_segments.append({'index': i, 'start_frame': start_frame, 'end_frame': end_frame, 'start': start_t, 'end': end_t})\n\n# Clamp last end to duration so coarse covers full track\ncoarse_segments[-1]['end'] = duration\n\nprint('coarse segments:', coarse_segments)\n\n# Subsegment each coarse segment using beat frames as boundaries\n# We need 3 sub-segments per coarse segment\nfine_segments = []\nfor c in coarse_segments:\n    # Use beat frames within the segment's frame range. Include both boundary beats.\n    # seg_beats: list of beat frame numbers inside [start_frame, end_frame]\n    seg_beats = beats[(beats >= c['start_frame']) & (beats <= c['end_frame'])]\n    if len(seg_beats) < 4:\n        # Not enough beats to sub-segment into 3 parts using beats\n        # Fall back to frame-level boundaries. Use start_frame, 1/3, 2/3, end_frame\n        sf = c['start_frame']\n        ef = c['end_frame']\n        thirds = [sf, sf + (ef - sf) // 3, sf + 2 * (ef - sf) // 3, ef]\n        seg_beats = np.array(sorted(set(thirds)), dtype=int)\n    sub_bounds = librosa.segment.subsegment(chroma, seg_beats, n_segments=N_SEG)\n    sub_bounds = np.asarray(sub_bounds)\n    # sub_bounds contains input seg_beats PLUS newly added interior boundaries\n    # Walk through each interval (between consecutive seg_beats) and extract N_SEG sub-segments\n    n_int = len(seg_beats) - 1\n    # Verify total length is approximately n_int * N_SEG + 1\n    # If subsegment fails for an interval (too few frames), interval becomes single-frame sub-segments\n    # In that case it still returns something consistent.\n    # Walk per interval\n    idx = 0\n    for interval_i in range(n_int):\n        # n_segments+1 bounda"]
[118.904173, "i", "ries for this interval\n        # but if there were fewer frames, may be different. Try to grab n_segments+1 boundaries\n        b_sub = sub_bounds[idx:idx+N_SEG+1].tolist()\n        if len(b_sub) < N_SEG + 1:\n            # truncate: we got fewer. Just take what's left\n            b_sub = sub_bounds[idx:].tolist()\n        idx += N_SEG\n        # Generate N_SEG sub-segments from these\n        # If we have b_sub with >= 2 elements we can make (len(b_sub)-1) sub-segments.\n        # We want exactly N_SEG. If len(b_sub) > N_SEG+1 we have a problem; but per design\n        # each interval yields exactly N_SEG+1 boundaries.\n        if len(b_sub) < 2:\n            continue\n        if len(b_sub) < N_SEG + 1:\n            # pad with end_frame\n            while len(b_sub) < N_SEG + 1:\n                b_sub.append(c['end_frame'])\n        if len(b_sub) > N_SEG + 1:\n            b_sub = b_sub[:N_SEG + 1]\n        for j in range(N_SEG):\n            sf = int(b_sub[j])\n            ef = int(b_sub[j+1])\n            # clamp to coarse range\n            if sf < c['start_frame']: sf = c['start_frame']\n            if ef > c['end_frame']: ef = c['end_frame']\n            if ef <= sf:\n                ef = sf + 1\n            start_t = float(librosa.frames_to_time(np.array([sf]), sr=sr, hop_length=HOP)[0])\n            end_t = float(librosa.frames_to_time(np.array([ef]), sr=sr, hop_length=HOP)[0])\n            fine_segments.append({'start_frame': sf, 'end_frame': ef, 'start': start_t, 'end': end_t, 'parent_index': c['index']})\n\n    # Ensure we have exactly N_SEG fine segments for this coarse. If not (e.g. too few frames),\n    # fall back to evenly split\n    children_now = [f for f in fine_segments if f['parent_index'] == c['index']]\n    if len(children_now) != N_SEG:\n        # Remove the ones we added for this coarse\n        fine_segments = [f for f in fine_segments if f['parent_index'] != c['index']]\n        # Even split\n        sf0 = c['start_frame']\n        ef0 = c['end_frame']\n        for j in range(N_SEG):\n            sf = sf0 + (ef0 - sf0) * j // N_SEG\n            ef = sf0 + (ef0 - sf0) * (j + 1) // N_SEG\n            start_t = float(librosa.frames_to_time(np.array([sf]), sr=sr, hop_length=HOP)[0])\n            end_t = float(librosa.frames_to_time(np.array([ef]), sr=sr, hop_length=HOP)[0])\n            fine_segments.append({'start_frame': sf, 'end_frame': ef, 'start': start_t, 'end': end_t, 'parent_index': c['index']})\n\n# Final cleanups: ensure parent coverage\nfor c in coarse_segments:\n    children = [f for f in fine_segments if f['parent_index'] == c['index']]\n    children.sort(key=lambda x: x['start_frame'])\n    # Force first start = coarse start, last end = coarse end\n    children[0]['start_frame'] = c['start_frame']\n    children[0]['start'] = c['start']\n    children[-1]['end_frame'] = c['end_frame']\n    children[-1]['end'] = c['end']\n    # Make adjacent children share boundary\n    for k in range(1, len(children)):\n        children[k]['start_frame'] = children[k-1]['end_frame']\n        children[k]['start'] = children[k-1]['end']\n    # Ensure each child has minimum duration\n    for k in range(len(children)):\n        if children[k]['end_frame'] - children[k]['start_frame'] < 2:\n            children[k]['end_frame'] = children[k]['start_frame'] + 2\n            children[k]['end'] = float(librosa.frames_to_time(np.array([children[k]['end_frame']]), sr=sr, hop_length=HOP)[0])\n            if k+1 < len(children):\n                children[k+1]['start_frame'] = children[k]['end_frame']\n                children[k+1]['start'] = children[k]['end']\n        # update in fine_segments\n        # (they are the same dicts, but we want consistency)\n\n# Build final json\ncoarse_out = [{'index': c['index'], 'start': round(c['start'], 6), 'end': round(c['end'], 6)} for c in coarse_segments]\nfine_sorted = sorted(fine_segments, key=lambda x: (x['parent_index'], x['start_frame']))\n# Re-sort globally by start time\nfine_sorted = sorted(fine_sorted, key=lambda x: x['start'])\nfine_out = []\nfor i, f in enumerate(fine_sorted):\n    fine_out.append({'index': i, 'start': round(f['start'], 6)"]
[118.904237, "i", ", 'end': round(f['end'], 6), 'parent_index': f['parent_index']})\n\nresult = {'coarse': coarse_out, 'fine': fine_out}\n\nwith open('/home/user/hierarchy.json', 'w') as f:\n    json.dump(result, f, indent=2)\n\nprint(json.dumps(result, indent=2))\nPYEOF\n"]
[118.904398, "o", "cat > /tmp/segment.py << 'PYEOF'\r\n\u001b[?2004l\r"]
[118.904449, "o", "\u001b[?2004h> "]
[118.904537, "o", "import json\r\n\u001b[?2004l\r\u001b[?2004h> "]
[118.904614, "o", "import numpy as np\r\n\u001b[?2004l\r"]
[118.904643, "o", "\u001b[?2004h> "]
[118.904693, "o", "import librosa\r\n\u001b[?2004l\r\u001b[?2004h"]
[118.904724, "o", "> "]
[118.90479, "o", "import librosa.feature\r\n\u001b[?2004l\r"]
[118.904812, "o", "\u001b[?2004h> "]
[118.904905, "o", "import librosa.beat\r\n\u001b[?2004l\r"]
[118.904928, "o", "\u001b[?2004h> "]
[118.905017, "o", "import librosa.segment\r\n\u001b[?2004l\r"]
[118.905053, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[118.905082, "o", "\u001b[?2004h> "]
[118.905127, "o", "HOP = 512\r\n\u001b[?2004l\r\u001b[?2004h"]
[118.90515, "o", "> "]
[118.905196, "o", "SR = 22050\r\n\u001b[?2004l\r\u001b[?2004h> "]
[118.905241, "o", "N_SEG = 3\r\n\u001b[?2004l\r"]
[118.905263, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[118.905314, "o", "\u001b[?2004h> "]
[118.905341, "o", "# Load audio\r\n\u001b[?2004l\r"]
[118.905406, "o", "\u001b[?2004h> "]
[118.905589, "o", "y, sr = librosa.load('/home/user/input.wav', sr=SR)\r\n\u001b[?2004l\r"]
[118.905616, "o", "\u001b[?2004h> "]
[118.905735, "o", "duration = len(y) / float(sr)\r\n\u001b[?2004l\r"]
[118.905758, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[118.905801, "o", "\u001b[?2004h> "]
[118.90587, "o", "# Beat tracking\r\n\u001b[?2004l\r\u001b[?2004h"]
[118.905901, "o", "> "]
[118.906207, "o", "tempo, beats = librosa.beat.beat_track(y=y, sr=sr, hop_length=HOP)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[118.90632, "o", "beats = np.asarray(beats)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[118.906442, "o", "n_beats_total = len(beats)\r\n\u001b[?2004l\r\u001b[?2004h"]
[118.906506, "o", "> "]
[118.90671, "o", "print('duration:', duration, 'tempo:', tempo, 'beats:', n_beats_total)\r\n\u001b[?2004l\r\u001b[?2004h"]
[118.906771, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[118.906829, "o", "# Chroma CQT\r\n\u001b[?2004l\r\u001b[?2004h> "]
[118.907073, "o", "chroma = librosa.feature.chroma_cqt(y=y, sr=sr, hop_length=HOP)\r\n\u001b[?2004l\r\u001b[?2004h"]
[118.907134, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[118.907221, "o", "# Beat-synchronous chroma\r\n\u001b[?2004l\r\u001b[?2004h"]
[118.90728, "o", "> "]
[118.907422, "o", "sync_chroma = librosa.util.sync(chroma, beats)\r\n\u001b[?2004l\r\u001b[?2004h"]
[118.907481, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[118.90755, "o", "# Coarse segmentation\r\n\u001b[?2004l\r\u001b[?2004h"]
[118.907606, "o", "> "]
[118.907949, "o", "# Choose k so that each segment has at least 3 beats (so subsegment can give 3 sub-segments)\r\n\u001b[?2004l\r\u001b[?2004h"]
[118.908024, "o", "> "]
[118.908186, "o", "# 44 beats / k=4 -> ~11 beats per segment, plenty\r\n\u001b[?2004l\r\u001b[?2004h> "]
[118.908344, "o", "# 44 beats / k=5 -> ~9 beats per segment\r\n\u001b[?2004l\r\u001b[?2004h"]
[118.908394, "o", "> "]
[118.908518, "o", "# 44 beats / k=6 -> ~7 beats per segment\r\n\u001b[?2004l\r\u001b[?2004h"]
[118.908578, "o", "> "]
[118.908702, "o", "# 44 beats / k=7 -> ~6 beats per segment\r\n\u001b[?2004l\r\u001b[?2004h"]
[118.90876, "o", "> "]
[118.908893, "o", "# 44 beats / k=8 -> ~5 beats per segment\r\n\u001b[?2004l\r\u001b[?2004h> "]
[118.908965, "o", "# Try k=5 first\r\n\u001b[?2004l\r"]
[118.909024, "o", "\u001b[?2004h> k = 5\r\n\u001b[?2004l\r\u001b[?2004h"]
[118.909087, "o", "> "]
[118.909255, "o", "bounds = librosa.segment.agglomerative(sync_chroma, k)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[118.909364, "o", "bounds = np.asarray(bounds)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[118.909523, "o", "print('agglo bounds:', bounds, 'k=', k)\r\n\u001b[?2004l\r\u001b[?2004h"]
[118.909589, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[118.909712, "o", "# beats array indices -> frame mapping\r\n\u001b[?2004l\r\u001b[?2004h"]
[118.909773, "o", "> "]
[118.909883, "o", "# Map each beat index to its frame\r\n\u001b[?2004l\r\u001b[?2004h"]
[118.909958, "o", "> "]
[118.910116, "o", "# A coarse segment is bounds[i]..bounds[i+1] in beat indices\r\n\u001b[?2004l\r"]
[118.910179, "o", "\u001b[?2004h> "]
[118.91044, "o", "# So start_frame = beats[bounds[i]], end_frame = beats[bounds[i+1]] (or end of track)\r\n\u001b[?2004l\r\u001b[?2004h"]
[118.910496, "o", "> "]
[118.910571, "o", "total_frames = chroma.shape[1]\r\n\u001b[?2004l\r"]
[118.9106, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[118.910658, "o", "> "]
[118.910696, "o", "coarse_segments = []\r\n\u001b[?2004l\r"]
[118.910721, "o", "\u001b[?2004h> "]
[118.910837, "o", "for i in range(len(bounds)):\r\n\u001b[?2004l\r"]
[118.910881, "o", "\u001b[?2004h> "]
[118.91099, "o", "    bi_start = int(bounds[i])\r\n\u001b[?2004l\r\u001b[?2004h"]
[118.91102, "o", "> "]
[118.911297, "o", "    bi_end = int(bounds[i+1]) if i+1 < len(bounds) else (n_beats_total - 1)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[118.911632, "o", "    # bi_end is the inclusive last beat of this segment; the segment is [beats[bi_start], beats[bi_end]]\r\n\u001b[?2004l\r\u001b[?2004h> "]
[118.911942, "o", "    # The next segment starts at beats[bi_end] (next coarse boundary index is bi_end)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[118.912316, "o", "    # wait: if i+1 has bounds[i+1] = bi_end, then segment i goes from beats[bounds[i]] to beats[bounds[i+1]]\r\n\u001b[?2004l\r\u001b[?2004h"]
[118.91238, "o", "> "]
[118.912747, "o", "    # but as a half-open interval we typically use [start, end). Let's use bi_end as index but the end_frame is beats[bi_end]\r\n\u001b[?2004l\r\u001b[?2004h"]
[118.912785, "o", "> "]
[118.913041, "o", "    # and next segment starts at beats[bi_end] = same frame. So they share boundary.\r\n\u001b[?2004l\r"]
[118.913106, "o", "\u001b[?2004h> "]
[118.913205, "o", "    start_frame = int(beats[bi_start])\r\n\u001b[?2004l\r"]
[118.913263, "o", "\u001b[?2004h> "]
[118.913365, "o", "    if i + 1 < len(bounds):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[118.913557, "o", "        end_frame = int(beats[bounds[i+1]])\r\n\u001b[?2004l\r\u001b[?2004h"]
[118.913601, "o", ">     else:"]
[118.913683, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[118.913851, "o", "        # Last segment: extend to end of audio\r\n\u001b[?2004l\r\u001b[?2004h"]
[118.913899, "o", "> "]
[118.913994, "o", "        end_frame = total_frames\r\n\u001b[?2004l\r\u001b[?2004h"]
[118.91404, "o", "> "]
[118.914352, "o", "    start_t = float(librosa.frames_to_time(np.array([start_frame]), sr=sr, hop_length=HOP)[0])\r\n\u001b[?2004l\r\u001b[?2004h"]
[118.914398, "o", "> "]
[118.914736, "o", "    end_t = float(librosa.frames_to_time(np.array([end_frame]), sr=sr, hop_length=HOP)[0])\r\n\u001b[?2004l\r\u001b[?2004h"]
[118.914782, "o", "> "]
[118.915245, "o", "    coarse_segments.append({'index': i, 'start_frame': start_frame, 'end_frame': end_frame, 'start': start_t, 'end': end_t})\r\n\u001b[?2004l\r\u001b[?2004h"]
[118.91529, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[118.915522, "o", "# Clamp last end to duration so coarse covers full track\r\n\u001b[?2004l\r\u001b[?2004h"]
[118.915567, "o", "> "]
[118.915682, "o", "coarse_segments[-1]['end'] = duration\r\n\u001b[?2004l\r\u001b[?2004h"]
[118.915726, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[118.915903, "o", "print('coarse segments:', coarse_segments)\r\n\u001b[?2004l\r\u001b[?2004h"]
[118.915961, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[118.916187, "o", "# Subsegment each coarse segment using beat frames as boundaries\r\n\u001b[?2004l\r\u001b[?2004h"]
[118.916234, "o", "> "]
[118.916385, "o", "# We need 3 sub-segments per coarse segment\r\n\u001b[?2004l\r\u001b[?2004h"]
[118.916457, "o", "> "]
[118.916504, "o", "fine_segments = []\r\n\u001b[?2004l\r\u001b[?2004h> "]
[118.916605, "o", "for c in coarse_segments:\r\n\u001b[?2004l\r\u001b[?2004h"]
[118.916682, "o", "> "]
[118.916972, "o", "    # Use beat frames within the segment's frame range. Include both boundary beats.\r\n\u001b[?2004l\r\u001b[?2004h> "]
[118.917276, "o", "    # seg_beats: list of beat frame numbers inside [start_frame, end_frame]\r\n\u001b[?2004l\r\u001b[?2004h"]
[118.917334, "o", "> "]
[118.917606, "o", "    seg_beats = beats[(beats >= c['start_frame']) & (beats <= c['end_frame'])]\r\n\u001b[?2004l\r\u001b[?2004h"]
[118.917658, "o", "> "]
[118.917737, "o", "    if len(seg_beats) < 4:\r\n\u001b[?2004l\r\u001b[?2004h"]
[118.917787, "o", "> "]
[118.918031, "o", "        # Not enough beats to sub-segment into 3 parts using beats\r\n\u001b[?2004l\r\u001b[?2004h"]
[118.91809, "o", "> "]
[118.91839, "o", "        # Fall back to frame-level boundaries. Use start_frame, 1/3, 2/3, end_frame\r\n\u001b[?2004l\r\u001b[?2004h"]
[118.918444, "o", "> "]
[118.918525, "o", "        sf = c['start_frame']\r\n\u001b[?2004l\r\u001b[?2004h"]
[118.918576, "o", "> "]
[118.918658, "o", "        ef = c['end_frame']\r\n\u001b[?2004l\r\u001b[?2004h"]
[118.918709, "o", "> "]
[118.918977, "o", "        thirds = [sf, sf + (ef - sf) // 3, sf + 2 * (ef - sf) // 3, ef]\r\n\u001b[?2004l\r\u001b[?2004h"]
[118.919032, "o", "> "]
[118.919249, "o", "        seg_beats = np.array(sorted(set(thirds)), dtype=int)\r\n\u001b[?2004l\r\u001b[?2004h"]
[118.919301, "o", "> "]
[118.9196, "o", "    sub_bounds = librosa.segment.subsegment(chroma, seg_beats, n_segments=N_SEG)\r\n\u001b[?2004l\r"]
[118.919665, "o", "\u001b[?2004h> "]
[118.919763, "o", "    sub_bounds = np.asarray(sub_bounds)\r\n\u001b[?2004l\r\u001b[?2004h"]
[118.919822, "o", "> "]
[118.920081, "o", "    # sub_bounds contains input seg_beats PLUS newly added interior boundaries\r\n\u001b[?2004l\r\u001b[?2004h"]
[118.920138, "o", "> "]
[118.92047, "o", "    # Walk through each interval (between consecutive seg_beats) and extract N_SEG sub-segments\r\n\u001b[?2004l\r\u001b[?2004h"]
[118.920529, "o", "> "]
[118.920606, "o", "    n_int = len(seg_beats) - 1\r\n\u001b[?2004l\r\u001b[?2004h"]
[118.920665, "o", "> "]
[118.92083, "o", "    # Verify total length is approximately n_int * N_SEG + 1\r\n\u001b[?2004l\r\u001b[?2004h"]
[118.920891, "o", "> "]
[118.921249, "o", "    # If subsegment fails for an interval (too few frames), interval becomes single-frame sub-segments\r\n\u001b[?2004l\r\u001b[?2004h"]
[118.921307, "o", "> "]
[118.921462, "o", "    # In that case it still returns something consistent.\r\n\u001b[?2004l\r\u001b[?2004h"]
[118.921522, "o", "> "]
[118.921574, "o", "    # Walk per interval\r\n\u001b[?2004l\r\u001b[?2004h> "]
[118.921636, "o", "    idx = 0\r\n\u001b[?2004l\r\u001b[?2004h> "]
[118.921787, "o", "    for interval_i in range(n_int):\r\n\u001b[?2004l\r\u001b[?2004h"]
[118.921861, "o", "> "]
[118.921982, "o", "        # n_segments+1 boundaries for this interval\r\n\u001b[?2004l\r\u001b[?2004h"]
[118.922031, "o", "> "]
[118.922389, "o", "        # but if there were fewer frames, may be different. Try to grab n_segments+1 boundaries\r\n\u001b[?2004l\r\u001b[?2004h"]
[118.922449, "o", "> "]
[118.922606, "o", "        b_sub = sub_bounds[idx:idx+N_SEG+1].tolist()\r\n\u001b[?2004l\r\u001b[?2004h"]
[118.922664, "o", "> "]
[118.922754, "o", "        if len(b_sub) < N_SEG + 1:\r\n\u001b[?2004l\r\u001b[?2004h"]
[118.922813, "o", "> "]
[118.922969, "o", "            # truncate: we got fewer. Just take what's left\r\n\u001b[?2004l\r\u001b[?2004h"]
[118.923015, "o", "> "]
[118.923113, "o", "            b_sub = sub_bounds[idx:].tolist()\r\n\u001b[?2004l\r\u001b[?2004h"]
[118.923161, "o", "> "]
[118.923213, "o", "        idx += N_SEG\r\n\u001b[?2004l\r\u001b[?2004h> "]
[118.923352, "o", "        # Generate N_SEG sub-segments from these\r\n\u001b[?2004l\r\u001b[?2004h> "]
[118.92359, "o", "        # If we have b_sub with >= 2 elements we can make (len(b_sub)-1) sub-segments.\r\n\u001b[?2004l\r\u001b[?2004h"]
[118.923645, "o", "> "]
[118.92384, "o", "        # We want exactly N_SEG. If len(b_sub) > N_SEG+1 we have a problem; but per design\r\n\u001b[?2004l\r\u001b[?2004h"]
[118.923902, "o", "> "]
[118.924017, "o", "        # each interval yields exactly N_SEG+1 boundaries.\r\n\u001b[?2004l\r\u001b[?2004h"]
[118.924075, "o", "> "]
[118.924129, "o", "        if len(b_sub) < 2:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[118.924185, "o", "            continue\r\n\u001b[?2004l\r\u001b[?2004h"]
[118.924237, "o", "> "]
[118.924299, "o", "        if len(b_sub) < N_SEG + 1:\r\n\u001b[?2004l\r\u001b[?2004h"]
[118.92435, "o", "> "]
[118.924411, "o", "            # pad with end_frame\r\n\u001b[?2004l\r\u001b[?2004h"]
[118.924462, "o", "> "]
[118.924546, "o", "            while len(b_sub) < N_SEG + 1:\r\n\u001b[?2004l\r\u001b[?2004h"]
[118.9246, "o", "> "]
[118.92469, "o", "                b_sub.append(c['end_frame'])\r\n\u001b[?2004l\r\u001b[?2004h"]
[118.924743, "o", "> "]
[118.924808, "o", "        if len(b_sub) > N_SEG + 1:\r\n\u001b[?2004l\r\u001b[?2004h"]
[118.924872, "o", "> "]
[118.924939, "o", "            b_sub = b_sub[:N_SEG + 1]\r\n\u001b[?2004l\r\u001b[?2004h"]
[118.924991, "o", "> "]
[118.925048, "o", "        for j in range(N_SEG):\r\n\u001b[?2004l\r\u001b[?2004h"]
[118.9251, "o", "> "]
[118.925157, "o", "            sf = int(b_sub[j])\r\n\u001b[?2004l\r\u001b[?2004h"]
[118.925208, "o", "> "]
[118.925268, "o", "            ef = int(b_sub[j+1])\r\n\u001b[?2004l\r\u001b[?2004h"]
[118.92532, "o", "> "]
[118.925387, "o", "            # clamp to coarse range\r\n\u001b[?2004l\r\u001b[?2004h"]
[118.925438, "o", "> "]
[118.925568, "o", "            if sf < c['start_frame']: sf = c['start_frame']\r\n\u001b[?2004l\r\u001b[?2004h"]
[118.925619, "o", "> "]
[118.925737, "o", "            if ef > c['end_frame']: ef = c['end_frame']\r\n\u001b[?2004l\r\u001b[?2004h"]
[118.92579, "o", "> "]
[118.925854, "o", "            if ef <= sf:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[118.925939, "o", "                ef = sf + 1\r\n\u001b[?2004l\r\u001b[?2004h"]
[118.925992, "o", "> "]
[118.926197, "o", "            start_t = float(librosa.frames_to_time(np.array([sf]), sr=sr, hop_length=HOP)[0])\r\n\u001b[?2004l\r\u001b[?2004h"]
[118.926249, "o", "> "]
[118.926456, "o", "            end_t = float(librosa.frames_to_time(np.array([ef]), sr=sr, hop_length=HOP)[0])\r\n\u001b[?2004l\r\u001b[?2004h"]
[118.926509, "o", "> "]
[118.926812, "o", "            fine_segments.append({'start_frame': sf, 'end_frame': ef, 'start': start_t, 'end': end_t, 'parent_index': c['index']})\r\n\u001b[?2004l\r\u001b[?2004h"]
[118.92688, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[118.927113, "o", "    # Ensure we have exactly N_SEG fine segments for this coarse. If not (e.g. too few frames),\r\n\u001b[?2004l\r\u001b[?2004h"]
[118.927165, "o", "> "]
[118.927222, "o", "    # fall back to evenly split\r\n\u001b[?2004l\r\u001b[?2004h"]
[118.927273, "o", "> "]
[118.927454, "o", "    children_now = [f for f in fine_segments if f['parent_index'] == c['index']]\r\n\u001b[?2004l\r\u001b[?2004h"]
[118.927507, "o", "> "]
[118.927572, "o", "    if len(children_now) != N_SEG:\r\n\u001b[?2004l\r\u001b[?2004h"]
[118.927623, "o", "> "]
[118.92773, "o", "        # Remove the ones we added for this coarse\r\n\u001b[?2004l\r\u001b[?2004h"]
[118.927783, "o", "> "]
[118.927982, "o", "        fine_segments = [f for f in fine_segments if f['parent_index'] != c['index']]\r\n\u001b[?2004l\r\u001b[?2004h"]
[118.928034, "o", "> "]
[118.928086, "o", "        # Even split\r\n\u001b[?2004l\r\u001b[?2004h> "]
[118.928162, "o", "        sf0 = c['start_frame']\r\n\u001b[?2004l\r\u001b[?2004h"]
[118.928213, "o", "> "]
[118.928267, "o", "        ef0 = c['end_frame']\r\n\u001b[?2004l\r\u001b[?2004h"]
[118.928317, "o", "> "]
[118.928375, "o", "        for j in range(N_SEG):\r\n\u001b[?2004l\r\u001b[?2004h"]
[118.928426, "o", "> "]
[118.928521, "o", "            sf = sf0 + (ef0 - sf0) * j // N_SEG\r\n\u001b[?2004l\r\u001b[?2004h"]
[118.928572, "o", "> "]
[118.928689, "o", "            ef = sf0 + (ef0 - sf0) * (j + 1) // N_SEG\r\n\u001b[?2004l\r\u001b[?2004h"]
[118.92874, "o", "> "]
[118.928961, "o", "            start_t = float(librosa.frames_to_time(np.array([sf]), sr=sr, hop_length=HOP)[0])\r\n\u001b[?2004l\r\u001b[?2004h"]
[118.929014, "o", "> "]
[118.929217, "o", "            end_t = float(librosa.frames_to_time(np.array([ef]), sr=sr, hop_length=HOP)[0])\r\n\u001b[?2004l\r\u001b[?2004h"]
[118.92927, "o", "> "]
[118.929593, "o", "            fine_segments.append({'start_frame': sf, 'end_frame': ef, 'start': start_t, 'end': end_t, 'parent_index': c['index']})\r\n\u001b[?2004l\r\u001b[?2004h> \r\n"]
[118.929649, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[118.92974, "o", "# Final cleanups: ensure parent coverage\r\n\u001b[?2004l\r\u001b[?2004h"]
[118.929797, "o", "> "]
[118.929855, "o", "for c in coarse_segments:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[118.930059, "o", "    children = [f for f in fine_segments if f['parent_index'] == c['index']]\r\n\u001b[?2004l\r\u001b[?2004h> "]
[118.930207, "o", "    children.sort(key=lambda x: x['start_frame'])\r\n\u001b[?2004l\r\u001b[?2004h"]
[118.930256, "o", "> "]
[118.930384, "o", "    # Force first start = coarse start, last end = coarse end\r\n\u001b[?2004l\r\u001b[?2004h> "]
[118.930541, "o", "    children[0]['start_frame'] = c['start_frame']\r\n\u001b[?2004l\r\u001b[?2004h"]
[118.930591, "o", "> "]
[118.930658, "o", "    children[0]['start'] = c['start']\r\n\u001b[?2004l\r\u001b[?2004h"]
[118.930707, "o", "> "]
[118.930798, "o", "    children[-1]['end_frame'] = c['end_frame']\r\n\u001b[?2004l\r\u001b[?2004h"]
[118.930853, "o", "> "]
[118.930944, "o", "    children[-1]['end'] = c['end']\r\n\u001b[?2004l\r\u001b[?2004h> "]
[118.931069, "o", "    # Make adjacent children share boundary\r\n\u001b[?2004l\r\u001b[?2004h"]
[118.931136, "o", "> "]
[118.931209, "o", "    for k in range(1, len(children)):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[118.9314, "o", "        children[k]['start_frame'] = children[k-1]['end_frame']\r\n\u001b[?2004l\r\u001b[?2004h"]
[118.931471, "o", "> "]
[118.931556, "o", "        children[k]['start'] = children[k-1]['end']\r\n\u001b[?2004l\r\u001b[?2004h"]
[118.931616, "o", "> "]
[118.931699, "o", "    # Ensure each child has minimum duration\r\n\u001b[?2004l\r\u001b[?2004h"]
[118.931759, "o", "> "]
[118.931825, "o", "    for k in range(len(children)):\r\n\u001b[?2004l\r\u001b[?2004h"]
[118.9319, "o", "> "]
[118.932031, "o", "        if children[k]['end_frame'] - children[k]['start_frame'] < 2:\r\n\u001b[?2004l\r\u001b[?2004h"]
[118.932092, "o", "> "]
[118.932241, "o", "            children[k]['end_frame'] = children[k]['start_frame'] + 2\r\n\u001b[?2004l\r\u001b[?2004h"]
[118.932305, "o", "> "]
[118.932582, "o", "            children[k]['end'] = float(librosa.frames_to_time(np.array([children[k]['end_frame']]), sr=sr, hop_length=HOP)[0])\r\n\u001b[?2004l\r\u001b[?2004h"]
[118.932643, "o", "> "]
[118.932707, "o", "            if k+1 < len(children):\r\n\u001b[?2004l\r\u001b[?2004h"]
[118.932768, "o", "> "]
[118.932922, "o", "                children[k+1]['start_frame'] = children[k]['end_frame']\r\n\u001b[?2004l\r\u001b[?2004h"]
[118.932985, "o", "> "]
[118.933103, "o", "                children[k+1]['start'] = children[k]['end']\r\n\u001b[?2004l\r\u001b[?2004h"]
[118.933163, "o", "> "]
[118.933225, "o", "        # update in fine_segments\r\n\u001b[?2004l\r\u001b[?2004h"]
[118.933287, "o", "> "]
[118.933405, "o", "        # (they are the same dicts, but we want consistency)\r\n\u001b[?2004l\r\u001b[?2004h"]
[118.933465, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[118.933525, "o", "# Build final json\r\n\u001b[?2004l\r\u001b[?2004h> "]
[118.933834, "o", "coarse_out = [{'index': c['index'], 'start': round(c['start'], 6), 'end': round(c['end'], 6)} for c in coarse_segments]\r\n\u001b[?2004l\r\u001b[?2004h"]
[118.93396, "o", "> "]
[118.934101, "o", "fine_sorted = sorted(fine_segments, key=lambda x: (x['parent_index'], x['start_frame']))\r\n\u001b[?2004l\r\u001b[?2004h"]
[118.934169, "o", "> "]
[118.934242, "o", "# Re-sort globally by start time\r\n\u001b[?2004l\r\u001b[?2004h> "]
[118.934399, "o", "fine_sorted = sorted(fine_sorted, key=lambda x: x['start'])\r\n\u001b[?2004l\r\u001b[?2004h"]
[118.934464, "o", "> fine_out = []\r\n\u001b[?2004l\r"]
[118.934528, "o", "\u001b[?2004h> "]
[118.934591, "o", "for i, f in enumerate(fine_sorted):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[118.934964, "o", "    fine_out.append({'index': i, 'start': round(f['start'], 6), 'end': round(f['end'], 6), 'parent_index': f['parent_index']})\r\n\u001b[?2004l\r\u001b[?2004h"]
[118.935028, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[118.935159, "o", "result = {'coarse': coarse_out, 'fine': fine_out}\r\n\u001b[?2004l\r\u001b[?2004h"]
[118.935223, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[118.935356, "o", "with open('/home/user/hierarchy.json', 'w') as f:\r\n\u001b[?2004l\r\u001b[?2004h"]
[118.935422, "o", "> "]
[118.935472, "o", "    json.dump(result, f, indent=2)\r\n\u001b[?2004l\r"]
[118.935534, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[118.935659, "o", "print(json.dumps(result, indent=2))\r\n\u001b[?2004l\r\u001b[?2004h"]
[118.935707, "o", "> PYEOF\r\n\u001b[?2004l\r"]
[118.950304, "o", "\u001b[?2004hroot@43871d43-2a93-4efb-8caa-f8f57bce6383:/tmp# "]
[119.326303, "i", "python3 /tmp/segment.py 2>&1 | tail -100\n"]
[119.326681, "o", "python3 /tmp/segment.py 2>&1 | tail -100\r\n\u001b[?2004l\r"]
[124.909216, "o", "    },\r\n    {\r\n      \"index\": 4,\r\n      \"start\": 22.523356,\r\n      \"end\": 25.0\r\n    }\r\n  ],\r\n  \"fine\": [\r\n    {\r\n      \"index\": 0,\r\n      \"start\": 1.184218,\r\n      \"end\": 1.346757,\r\n      \"parent_index\": 0\r\n    },\r\n    {\r\n      \"index\": 1,\r\n      \"start\": 1.346757,\r\n      \"end\": 1.532517,\r\n      \"parent_index\": 0\r\n    },\r\n    {\r\n      \"index\": 2,\r\n      \"start\": 1.532517,\r\n      \"end\": 1.718277,\r\n      \"parent_index\": 0\r\n    },\r\n    {\r\n      \"index\": 3,\r\n      \"start\": 1.718277,\r\n      \"end\": 5.619229,\r\n      \"parent_index\": 1\r\n    },\r\n    {\r\n      \"index\": 4,\r\n      \"start\": 5.619229,\r\n      \"end\": 9.520181,\r\n      \"parent_index\": 1\r\n    },\r\n    {\r\n      \"index\": 5,\r\n      \"start\": 9.520181,\r\n      \"end\": 13.421134,\r\n      \"parent_index\": 1\r\n    },\r\n    {\r\n      \"index\": 6,\r\n      \"start\": 13.421134,\r\n      \"end\": 14.489252,\r\n      \"parent_index\": 2\r\n    },\r\n    {\r\n      \"index\": 7,\r\n      \"start\": 14.489252,\r\n      \"end\": 15.55737,\r\n      \"parent_index\": 2\r\n    },\r\n    {\r\n      \"index\": 8,\r\n      \"start\": 15.55737,\r\n      \"end\": 16.625488,\r\n      \"parent_index\": 2\r\n    },\r\n    {\r\n      \"index\": 9,\r\n      \"start\": 16.625488,\r\n      \"end\": 18.575964,\r\n      \"parent_index\": 3\r\n    },\r\n    {\r\n      \"index\": 10,\r\n      \"start\": 18.575964,\r\n      \"end\": 20.54966,\r\n      \"parent_index\": 3\r\n    },\r\n    {\r\n      \"index\": 11,\r\n      \"start\": 20.54966,\r\n      \"end\": 22.523356,\r\n      \"parent_index\": 3\r\n    },\r\n    {\r\n      \"index\": 12,\r\n      \"start\": 22.523356,\r\n      \"end\": 23.336054,"]
[124.909268, "o", "\r\n      \"parent_index\": 4\r\n    },\r\n    {\r\n      \"index\": 13,\r\n      \"start\": 23.336054,\r\n      \"end\": 24.171973,\r\n      \"parent_index\": 4\r\n    },\r\n    {\r\n      \"index\": 14,\r\n      \"start\": 24.171973,\r\n      \"end\": 25.0,\r\n      \"parent_index\": 4\r\n    }\r\n  ]\r\n}\r\n"]
