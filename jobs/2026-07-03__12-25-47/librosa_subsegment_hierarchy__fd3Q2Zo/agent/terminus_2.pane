[?2004l[?2004h>                 b_sub.append(c['end_frame'])
[?2004l[?2004h>             # truncate if too many (shouldn't happen)
[?2004l[?2004h>             if len(b_sub) > N_SEG + 1:
[?2004l[?2004h>                 b_sub = b_sub[:N_SEG + 1]
[?2004l[?2004h>             for j in range(N_SEG):
[?2004l[?2004h>                 sf = int(b_sub[j])
[?2004l[?2004h>                 ef = int(b_sub[j+1])
[?2004l[?2004h>                 if sf < c['start_frame']: sf = c['start_frame']
[?2004l[?2004h>                 if ef > c['end_frame']: ef = c['end_frame']
[?2004l[?2004h>                 if ef <= sf:
[?2004l[?2004h>                     ef = sf + 1
[?2004l[?2004h>                 start_t = float(librosa.frames_to_time(np.array([sf]), sr=sr, hop_length=HOP)[0])
[?2004l[?2004h>                 end_t = float(librosa.frames_to_time(np.array([ef]), sr=sr, hop_length=HOP)[0])
[?2004l[?2004h>                 children.append({'start_frame': sf, 'end_frame': ef, 'start': start_t, 'end': end_t, 'parent_index': c['index']})
[?2004l[?2004h>         if len(children) != N_SEG:
[?2004l[?2004h>             # Fall back to even split
[?2004l[?2004h>             children = []
[?2004l[?2004h>             for j in range(N_SEG):
[?2004l[?2004h>                 sf = c['start_frame'] + (c['end_frame'] - c['start_frame']) * j // N_SEG
[?2004l[?2004h>                 ef = c['start_frame'] + (c['end_frame'] - c['start_frame']) * (j + 1) // N_SEG
[?2004l[?2004h>                 start_t = float(librosa.frames_to_time(np.array([sf]), sr=sr, hop_length=HOP)[0])
[?2004l[?2004h>                 end_t = float(librosa.frames_to_time(np.array([ef]), sr=sr, hop_length=HOP)[0])
[?2004l[?2004h>                 children.append({'start_frame': sf, 'end_frame': ef, 'start': start_t, 'end': end_t, 'parent_index': c['index']})
[?2004l[?2004h> 
[?2004l[?2004h>     fine_segments.extend(children)
[?2004l[?2004h> 
[?2004l[?2004h> # Ensure each coarse segment's children cover it exactly: first.start = c.start, last.end = c.end
[?2004l[?2004h> # and adjacency
[?2004l[?2004h> for c in coarse_segments:
[?2004l[?2004h>     children = [f for f in fine_segments if f['parent_index'] == c['index']]
[?2004l[?2004h>     children.sort(key=lambda x: x['start_frame'])
[?2004l[?2004h>     children[0]['start_frame'] = c['start_frame']
[?2004l[?2004h>     children[0]['start'] = c['start']
[?2004l[?2004h>     children[-1]['end_frame'] = c['end_frame']
[?2004l[?2004h>     children[-1]['end'] = c['end']
[?2004l[?2004h>     # Make adjacent children share boundary
[?2004l[?2004h>     for k in range(1, len(children)):
[?2004l[?2004h>         children[k]['start_frame'] = children[k-1]['end_frame']
[?2004l[?2004h>         children[k]['start'] = children[k-1]['end']
[?2004l[?2004h>     # Ensure each child has minimum duration (>0.1s i.e. > ~4-5 frames at hop=512 and sr=22050: 0.1s = 4.3 frames)
[?2004l[?2004h>     for k in range(len(children)):
[?2004l[?2004h>         min_frames = int(np.ceil(0.1 * sr / HOP)) + 1  # at least 5 frames for >0.1s
[?2004l[?2004h>         if children[k]['end_frame'] - children[k]['start_frame'] < min_frames:
[?2004l[?2004h>             # Steal from next if exists
[?2004l[?2004h>             if k + 1 < len(children) and children[k+1]['end_frame'] - children[k+1]['start_frame'] > min_frames:
[?2004l[?2004h>                 steal = min_frames - (children[k]['end_frame'] - children[k]['start_frame'])
[?2004l[?2004h>                 children[k]['end_frame'] += steal
[?2004l[?2004h>                 children[k]['end'] = float(librosa.frames_to_time(np.array([children[k]['end_frame']]), sr=sr, hop_length=HOP)[0])
[?2004l[?2004h>                 children[k+1]['start_frame'] = children[k]['end_frame']
[?2004l[?2004h>                 children[k+1]['start'] = children[k]['end']
[?2004l[?2004h>             elif k - 1 >= 0 and children[k-1]['end_frame'] - children[k-1]['start_frame'] > min_frames:
[?2004l[?2004h>                 steal = min_frames - (children[k]['end_frame'] - children[k]['start_frame'])
[?2004l[?2004h>                 children[k]['start_frame'] -= steal
[?2004l[?2004h>                 children[k]['start'] = float(librosa.frames_to_time(np.array([children[k]['start_frame']]), sr=sr, hop_length=HOP)[0])
[?2004l[?2004h>                 children[k-1]['end_frame'] = children[k]['start_frame']
[?2004l[?2004h>                 children[k-1]['end'] = children[k]['start']
[?2004l[?2004h> 
[?2004l[?2004h> # Verify each coarse segment has exactly 3 fine segments
[?2004l[?2004h> for c in coarse_segments:
[?2004l[?2004h>     n_children = sum(1 for f in fine_segments if f['parent_index'] == c['index'])
[?2004l[?2004h>     if n_children != N_SEG:
[?2004l[?2004h>         print(f'WARNING: coarse {c["index"]} has {n_children} fine segments')
[?2004l[?2004h> 
[?2004l[?2004h> # Build final json
