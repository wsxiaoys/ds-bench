[?2004l[?2004h>         sf = c['start_frame']
[?2004l[?2004h>         ef = c['end_frame']
[?2004l[?2004h>         thirds = [sf, sf + (ef - sf) // 3, sf + 2 * (ef - sf) // 3, ef]
[?2004l[?2004h>         seg_beats = np.array(sorted(set(thirds)), dtype=int)
[?2004l[?2004h>     sub_bounds = librosa.segment.subsegment(chroma, seg_beats, n_segments=N_SEG)
