[?2004l[?2004h> 
[?2004l[?2004h> print('coarse segments:', coarse_segments)
[?2004l[?2004h> 
[?2004l[?2004h> # Subsegment each coarse segment using beat frames as boundaries
[?2004l[?2004h> # We need 3 sub-segments per coarse segment
[?2004l[?2004h> fine_segments = []
[?2004l[?2004h> for c in coarse_segments:
[?2004l[?2004h>     # Use beat frames within the segment's frame range. Include both boundary beats.
[?2004l[?2004h>     # seg_beats: list of beat frame numbers inside [start_frame, end_frame]
