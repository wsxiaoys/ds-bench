[?2004l[?2004h> # Sort fine by start time globally
[?2004l[?2004h> fine_sorted = sorted(fine_segments, key=lambda x: x['start'])
[?2004l[?2004h> fine_out = []
[?2004l[?2004h> for i, f in enumerate(fine_sorted):
[?2004l[?2004h>     fine_out.append({'index': i, 'start': round(float(f['start']), 6), 'end': round(float(f['end']), 6), 'parent_index': int(f['parent_index'])})
