[?2004l[?2004h>         # but if there were fewer frames, may be different. Try to grab n_segments+1 boundaries
[?2004l[?2004h>         b_sub = sub_bounds[idx:idx+N_SEG+1].tolist()
[?2004l[?2004h>         if len(b_sub) < N_SEG + 1:
