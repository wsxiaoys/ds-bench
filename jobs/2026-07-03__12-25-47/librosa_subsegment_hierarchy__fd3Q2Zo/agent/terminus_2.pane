[?2004l[?2004h>         if len(b_sub) < N_SEG + 1:
[?2004l[?2004h>             # pad with end_frame
[?2004l[?2004h>             while len(b_sub) < N_SEG + 1:
[?2004l[?2004h>                 b_sub.append(c['end_frame'])
[?2004l[?2004h>         if len(b_sub) > N_SEG + 1:
[?2004l[?2004h>             b_sub = b_sub[:N_SEG + 1]
[?2004l[?2004h>         for j in range(N_SEG):
[?2004l[?2004h>             sf = int(b_sub[j])
[?2004l[?2004h>             ef = int(b_sub[j+1])
[?2004l[?2004h>             # clamp to coarse range
[?2004l[?2004h>             if sf < c['start_frame']: sf = c['start_frame']
[?2004l[?2004h>             if ef > c['end_frame']: ef = c['end_frame']
[?2004l[?2004h>             if ef <= sf:
[?2004l[?2004h>                 ef = sf + 1
[?2004l[?2004h>             start_t = float(librosa.frames_to_time(np.array([sf]), sr=sr, hop_length=HOP)[0])
[?2004l[?2004h>             end_t = float(librosa.frames_to_time(np.array([ef]), sr=sr, hop_length=HOP)[0])
[?2004l[?2004h>             fine_segments.append({'start_frame': sf, 'end_frame': ef, 'start': start_t, 'end': end_t, 'parent_index': c['index']})
