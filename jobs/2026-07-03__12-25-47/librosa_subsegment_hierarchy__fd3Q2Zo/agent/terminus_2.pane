[?2004l[?2004h>         # Walk: take n_segments+1 boundaries per interval
[?2004l[?2004h>         # interval 0 uses idx 0..n_seg, interval 1 uses idx n_seg..2n_seg, etc.
[?2004l[?2004h>         # Total expected length: n_int * n_seg + 1
[?2004l[?2004h>         children = []
[?2004l[?2004h>         all_b = sub_bounds.tolist()
