[?2004limport os
from e2b import Sandbox

# Create a new sandbox
sandbox = Sandbox.create()
print(f"Created sandbox: {sandbox.sandbox_id}")

# Create a file inside the sandbox
sandbox.files.write("/home/user/checkpoint.txt", "checkpoint 1")
print("File written inside sandbox")

# Verify file content
content = sandbox.files.read("/home/user/checkpoint.txt")
print(f"File content: {content}")

# Create a snapshot
snapshot = sandbox.create_snapshot()
snapshot_id = snapshot.snapshot_id
print(f"Snapshot ID: {snapshot_id}")

# Write the snapshot ID to /home/user/output.txt on the local machine
with open("/home/user/output.txt", "w") as f:
    f.write(snapshot_id)

print(f"Snapshot ID written to /home/user/output.txt")

# Clean up
sandbox.kill()
