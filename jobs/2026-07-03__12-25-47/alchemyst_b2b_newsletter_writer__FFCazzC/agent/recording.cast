[79.997853, "o", "\u001b[?2004h> "]
[79.998058, "o", "  fs.writeFileSync(outputPath, newsletter, 'utf8');\r\n\u001b[?2004l\r"]
[79.998081, "o", "\u001b[?2004h"]
[79.998126, "o", "> "]
[79.998435, "o", "  console.log(`Wrote newsletter (${newsletter.length} bytes) to ${outputPath}`);\r\n\u001b[?2004l\r"]
[79.998471, "o", "\u001b[?2004h> "]
[79.998501, "o", "}\r\n\u001b[?2004l\r"]
