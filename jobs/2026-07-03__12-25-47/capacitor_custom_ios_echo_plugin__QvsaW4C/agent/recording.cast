[65.699205, "i", "cat > /tmp/modify_pbxproj.py << 'PYEOF'\nimport re\n\npbxproj_path = 'ios/App/App.xcodeproj/project.pbxproj'\n\nwith open(pbxproj_path, 'r') as f:\n    content = f.read()\n\n# Use new unique IDs for the new entries\nfile_ref_id = 'F0F1FB09E7D4496EA16CE203'\nbuild_file_id = 'F0F1FB0AE7D4496EA16CE203'\n\n# 1. Add PBXBuildFile entry (in PBXBuildFile section, alphabetical order)\n# Find a good spot to insert - after the AppDelegate build file\nbuild_file_pattern = r'(\\s+504EC3081FED79650016851F /\\* AppDelegate\\.swift in Sources \\*/ = \\{isa = PBXBuildFile; fileRef = 504EC3071FED79650016851F /\\* AppDelegate\\.swift \\*/; \\};)'\nnew_build_file = f'\\n\\t\\t{build_file_id} /* EchoPlugin.swift in Sources */ = {{isa = PBXBuildFile; fileRef = {file_ref_id} /* EchoPlugin.swift */; }};'\ncontent = re.sub(build_file_pattern, r'\\1' + new_build_file, content)\n\n# 2. Add PBXFileReference entry (in PBXFileReference section)\n# Insert after AppDelegate.swift\nfile_ref_pattern = r'(\\s+504EC3071FED79650016851F /\\* AppDelegate\\.swift \\*/ = \\{isa = PBXFileReference; lastKnownFileType = sourcecode\\.swift; path = AppDelegate\\.swift; sourceTree = \"<group>\"; \\};)'\nnew_file_ref = f'\\n\\t\\t{file_ref_id} /* EchoPlugin.swift */ = {{isa = PBXFileReference; lastKnownFileType = sourcecode.swift; path = EchoPlugin.swift; sourceTree = \"<group>\"; }};'\ncontent = re.sub(file_ref_pattern, r'\\1' + new_file_ref, content)\n\n# 3. Add to App group children\ngroup_pattern = r'(\\s+504EC3071FED79650016851F /\\* AppDelegate\\.swift \\*/,)'\nnew_group_entry = f'\\n\\t\\t\\t\\t{file_ref_id} /* EchoPlugin.swift */,'\ncontent = re.sub(group_pattern, r'\\1' + new_group_entry, content)\n\n# 4. Add to PBXSourcesBuildPhase files\nsources_pattern = r'(\\s+504EC3081FED79650016851F /\\* AppDelegate\\.swift in Sources \\*/,)'\nnew_sources_entry = f'\\n\\t\\t\\t\\t{build_file_id} /* EchoPlugin.swift in Sources */,'\ncontent = re.sub(sources_pattern, r'\\1' + new_sources_entry, content)\n\nwith open(pbxproj_path, 'w') as f:\n    f.write(content)\n\nprint('Done')\nPYEOF\n"]
