[109.359398, "o", "\u001b[?2004h> "]
[109.359978, "o", "\"\"\"Classify a single PDF document using the LlamaCloud Classifier.\r\n\u001b[?2004l\r"]
[109.360105, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[109.360239, "o", "\u001b[?2004h> "]
