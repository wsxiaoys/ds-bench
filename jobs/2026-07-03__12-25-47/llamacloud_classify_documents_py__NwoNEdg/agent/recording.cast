[23.169313, "o", "' = None, timeout: 'float | httpx.Timeout | None | NotGiven' = NOT_GIVEN) -> 'ClassifyCreateResponse'\r\n |      Create a classify job.\r\n |\r\n"]
[23.16943, "o", " |      Classifies a document against a set of rules.\r\n |\r\n |      Set `file_input` to a file ID\r\n"]
[23.169517, "o", " |      (`dfl-...`) or parse job ID (`pjb-...`), and provide either inline\r\n |      `configuration` with rules or a `configuration_id` referencing a saved preset.\r\n |\r\n"]
[23.169596, "o", " |      Each rule has a `type` (the label to assign) and a `description` (natural\r\n |      language criteria). The classifier returns the best matching rule with a\r\n |      confidence score.\r\n |\r\n"]
[23.169682, "o", " |      The job runs asynchronously. Poll `GET /classify/{job_id}` to check status and\r\n |      retrieve results.\r\n |\r\n |      Args:\r\n"]
[23.169763, "o", " |        configuration: Configuration for a classify job.\r\n |\r\n |        configuration_id: Saved configuration ID\r\n |\r\n\u001b[7m--More--\u001b[27m"]
