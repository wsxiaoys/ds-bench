[141.934574, "i", "cat > src/main.ts << 'EOF'\n#!/usr/bin/env node\nimport AlchemystAI from '@alchemystai/sdk';\nimport * as fs from 'fs';\n\ninterface CliArgs {\n  userId?: string;\n  add?: string;\n  query?: string;\n}\n\nfunction parseArgs(argv: string[]): CliArgs {\n  const args: CliArgs = {};\n  for (let i = 2; i < argv.length; i++) {\n    const cur = argv[i];\n    if (cur === '--user-id' && i + 1 < argv.length) {\n      args.userId = argv[++i];\n    } else if (cur.startsWith('--user-id=')) {\n      args.userId = cur.substring('--user-id='.length);\n    } else if (cur === '--add' && i + 1 < argv.length) {\n      args.add = argv[++i];\n    } else if (cur.startsWith('--add=')) {\n      args.add = cur.substring('--add='.length);\n    } else if (cur === '--query' && i + 1 < argv.length) {\n      args.query = argv[++i];\n    } else if (cur.startsWith('--query=')) {\n      args.query = cur.substring('--query='.length);\n    }\n  }\n  return args;\n}\n\nfunction getRunId(): string {\n  try {\n    const path = process.env.RUN_ID_FILE || '/logs/artifacts/run-id';\n    return fs.readFileSync(path, 'utf8').trim();\n  } catch (err) {\n    if (process.env.RUN_ID) return process.env.RUN_ID.trim();\n    return 'default-run';\n  }\n}\n\nasync function main() {\n  const args = parseArgs(process.argv);\n\n  if (!args.userId || args.userId.trim() === '') {\n    console.error('MISSING_PARAMETERS: --user-id is required (userId and sessionId are mandatory for memory operations)');\n    process.exit(1);\n  }\n\n  const runId = getRunId();\n  const sessionId = `team-standup-${runId}`;\n  const userId = args.userId;\n\n  const apiKey = process.env.ALCHEMYST_AI_API_KEY;\n  if (!apiKey) {\n    console.error('ALCHEMYST_AI_API_KEY environment variable is not set');\n    process.exit(1);\n  }\n\n  const client = new AlchemystAI({ apiKey });\n\n  if (args.add) {\n    try {\n      // Per SDK v0.11.1: client.v1.context.memory.add takes { contents, sessionId }\n      // Embed userId in metadata so it is recoverable later.\n      await client.v1.context.memory.add({\n        contents: [\n          {\n            content: args.add,\n            metadata: { messageId: `${userId}-${Date.now()}-${Math.random().toString(36).slice(2,8)}`, userId },\n          },\n        ],\n        sessionId,\n        metadata: { groupName: [userId, sessionId] },\n      } as any);\n      console.log(`ADDED: ${args.add}`);\n      process.exit(0);\n    } catch (err: any) {\n      console.error(`ERROR: ${err?.message || String(err)}`);\n      process.exit(1);\n    }\n  }\n\n  if (args.query) {\n    try {\n      const result: any = await client.v1.context.search({\n        query: args.query,\n        similarity_threshold: 0.1,\n        minimum_similarity_threshold: 0.1,\n        mode: 'standard',\n      } as any);\n      const contexts = result?.contexts ?? result?.data?.contexts ?? result?.memories ?? result?.data?.memories ?? [];\n      const arr = Array.isArray(contexts) ? contexts : [];\n      for (const m of arr) {\n        const content =\n          (typeof m === 'string'\n            ? m\n            : m?.content ?? m?.memory ?? m?.text ?? m?.value ?? JSON.stringify(m));\n        console.log(`MEMORY: ${content}`);\n      }\n      process.exit(0);\n    } catch (err: any) {\n      console.error(`ERROR: ${err?.message || String(err)}`);\n      process.exit(1);\n    }\n  }\n\n  console.error('MISSING_PARAMETERS: must provide either --add or --query');\n  process.exit(1);\n}\n\nmain().catch((err) => {\n  console.error(`FATAL: ${err?.message || String(err)}`);\n  process.exit(1);\n});\nEOF\n"]
