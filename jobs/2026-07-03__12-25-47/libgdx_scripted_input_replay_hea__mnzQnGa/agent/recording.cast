[44.050159, "o", "            // so use a sentinel: after exit, the headless thread ends. We'll join the runtime's main thread.\r\n\u001b[?2004l\r"]
[44.050185, "o", "\u001b[?2004h> "]
[44.05058, "o", "            // Best approach: use a timeout-based polling and check whether the runtime thread is alive.\r\n\u001b[?2004l\r"]
[44.050653, "o", "\u001b[?2004h> "]
[44.051036, "o", "            // Simpler: just join via reflection or rely on the shutdown hook. For now, sleep then exit when done.\r\n\u001b[?2004l\r"]
[44.051067, "o", "\u001b[?2004h> "]
[44.051315, "o", "            if (Thread.currentThread().isInterrupted()) break;\r\n\u001b[?2004l\r\u001b[?2004h"]
[44.051351, "o", "> "]
[44.051722, "o", "            // Check if we should stop: we use a small heuristic - exit when we're sure app is done\r\n\u001b[?2004l\r\u001b[?2004h"]
[44.051796, "o", "> "]
[44.051956, "o", "            // Use System.gc-free polling with a sleep cap.\r\n\u001b[?2004l\r"]
[44.052046, "o", "\u001b[?2004h> "]
[44.052106, "o", "        }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[44.052407, "o", "        System.out.println(\"Final position: (\" + game.getX() + \", \" + game.getY() + \")\");\r\n\u001b[?2004l\r"]
[44.052435, "o", "\u001b[?2004h> "]
[44.052534, "o", "        System.exit(0);\r\n\u001b[?2004l\r"]
[44.052575, "o", "\u001b[?2004h> "]
[44.052599, "o", "    }\r\n\u001b[?2004l\r\u001b[?2004h"]
[44.052706, "o", "> }\r\n\u001b[?2004l\r\u001b[?2004h> EOF\r\n\u001b[?2004l\r"]
