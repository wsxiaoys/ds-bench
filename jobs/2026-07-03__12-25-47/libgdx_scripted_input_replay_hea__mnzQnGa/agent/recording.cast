[80.31697, "o", "\u001b[?2004h> "]
[80.317161, "o", "            if (line.isEmpty()) continue;\r\n\u001b[?2004l\r"]
[80.31722, "o", "\u001b[?2004h> "]
[80.317425, "o", "            if (line.startsWith(\"#\")) continue;\r\n\u001b[?2004l\r"]
[80.317478, "o", "\u001b[?2004h> "]
