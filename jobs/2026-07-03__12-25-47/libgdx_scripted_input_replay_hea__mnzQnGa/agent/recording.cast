[80.318368, "o", "                case \"LEFT\":\r\n\u001b[?2004l\r"]
[80.318425, "o", "\u001b[?2004h> "]
[80.318543, "o", "                case \"RIGHT\":\r\n\u001b[?2004l\r"]
[80.318599, "o", "\u001b[?2004h> "]
[80.318754, "o", "                    keys.add(upper);\r\n\u001b[?2004l\r"]
[80.318807, "o", "\u001b[?2004h> "]
[80.318915, "o", "                    break;\r\n\u001b[?2004l\r"]
[80.31897, "o", "\u001b[?2004h> "]
[80.319077, "o", "                default:\r\n\u001b[?2004l\r"]
[80.319102, "o", "\u001b[?2004h> "]
[80.319487, "o", "                    throw new IllegalArgumentException(\"unknown key \" + line);\r\n\u001b[?2004l\r"]
[80.319538, "o", "\u001b[?2004h> "]
[80.319628, "o", "            }\r\n\u001b[?2004l\r"]
