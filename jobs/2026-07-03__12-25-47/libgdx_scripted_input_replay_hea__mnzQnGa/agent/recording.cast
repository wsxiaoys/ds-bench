[43.549654, "o", "import java.util.concurrent.atomic.AtomicReference;\r\n\u001b[?2004l\r"]
[43.549708, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[43.549774, "o", "\u001b[?2004h> "]
[43.549893, "o", "public class ScriptedInput extends MockInput {\r\n\u001b[?2004l\r"]
[43.549961, "o", "\u001b[?2004h> "]
[43.550137, "o", "    private final List<String> keys = new ArrayList<>();\r\n\u001b[?2004l\r"]
[43.550188, "o", "\u001b[?2004h> "]
[43.55027, "o", "    private int index = 0;\r\n\u001b[?2004l\r"]
[43.550322, "o", "\u001b[?2004h> "]
[43.55044, "o", "    private InputProcessor processor;\r\n\u001b[?2004l\r"]
[43.550505, "o", "\u001b[?2004h> "]
[43.550764, "o", "    private final AtomicReference<String> error = new AtomicReference<>(null);\r\n\u001b[?2004l\r"]
[43.550816, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[43.550852, "o", "\u001b[?2004h> "]
[43.551051, "o", "    public ScriptedInput(String path) throws IOException {\r\n\u001b[?2004l\r"]
[43.551106, "o", "\u001b[?2004h> "]
[43.551412, "o", "        List<String> lines = Files.readAllLines(Paths.get(path), StandardCharsets.UTF_8);\r\n\u001b[?2004l\r"]
[43.551466, "o", "\u001b[?2004h> "]
[43.551573, "o", "        for (String raw : lines) {\r\n\u001b[?2004l\r"]
[43.551597, "o", "\u001b[?2004h> "]
[43.551753, "o", "            String line = raw.trim();\r\n\u001b[?2004l\r"]
[43.551812, "o", "\u001b[?2004h> "]
[43.55195, "o", "            if (line.isEmpty()) continue;\r\n\u001b[?2004l\r"]
[43.552011, "o", "\u001b[?2004h> "]
[43.552169, "o", "            if (line.startsWith(\"#\")) continue;\r\n\u001b[?2004l\r"]
[43.552217, "o", "\u001b[?2004h> "]
[43.552373, "o", "            String upper = line.toUpperCase();\r\n\u001b[?2004l\r"]
[43.552425, "o", "\u001b[?2004h> "]
[43.552826, "o", "            if (!upper.equals(\"UP\") && !upper.equals(\"DOWN\") && !upper.equals(\"LEFT\") && !upper.equals(\"RIGHT\")) {\r\n\u001b[?2004l\r"]
[43.55285, "o", "\u001b[?2004h> "]
[43.553143, "o", "                throw new IllegalArgumentException(\"unknown key \" + line);\r\n\u001b[?2004l\r"]
[43.553194, "o", "\u001b[?2004h> "]
[43.553256, "o", "            }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[43.553363, "o", "            keys.add(upper);\r\n\u001b[?2004l\r"]
[43.553413, "o", "\u001b[?2004h> "]
[43.553472, "o", "        }\r\n\u001b[?2004l\r\u001b[?2004h"]
[43.553538, "o", ">     }\r\n\u001b[?2004l\r\u001b[?2004h"]
[43.553571, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[43.553854, "o", "    public boolean hasError() { return error.get() != null; }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[43.55406, "o", "    public String getError() { return error.get(); }\r\n\u001b[?2004l\r"]
[43.554118, "o", "\u001b[?2004h> "]
[43.554381, "o", "    public boolean isExhausted() { return index >= keys.size(); }\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[43.554483, "o", ">     @Override\r\n\u001b[?2004l\r\u001b[?2004h> "]
[43.554729, "o", "    public void setInputProcessor(InputProcessor processor) {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[43.554891, "o", "        this.processor = processor;\r\n\u001b[?2004l\r\u001b[?2004h> "]
[43.554997, "o", "    }\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[43.555101, "o", "    @Override\r\n\u001b[?2004l\r\u001b[?2004h> "]
[43.555272, "o", "    public InputProcessor getInputProcessor() {\r\n\u001b[?2004l\r\u001b[?2004h"]
[43.555352, "o", "> "]
[43.555423, "o", "        return processor;\r\n\u001b[?2004l\r\u001b[?2004h> "]
[43.555592, "o", "    }\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h>     @Override\r\n\u001b[?2004l\r\u001b[?2004h> "]
[43.555709, "o", "    public void update() {\r\n\u001b[?2004l\r\u001b[?2004h"]
[43.555773, "o", "> "]
[43.55602, "o", "        // Do not REDACTED-dispatch - render() in the game calls dispatchNext\r\n\u001b[?2004l\r\u001b[?2004h"]
[43.556087, "o", ">     }\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[43.556146, "o", "\u001b[?2004h> "]
[43.5563, "o", "    public boolean dispatchNext() {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[43.556483, "o", "        if (index >= keys.size()) return false;\r\n\u001b[?2004l\r\u001b[?2004h> "]
[43.55666, "o", "        String key = keys.get(index++);\r\n\u001b[?2004l\r\u001b[?2004h> "]
[43.556779, "o", "        int keycode;\r\n\u001b[?2004l\r\u001b[?2004h> "]
[43.5569, "o", "        switch (key) {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[43.55713, "o", "            case \"UP\": keycode = Input.Keys.UP; break;\r\n\u001b[?2004l\r\u001b[?2004h> "]
[43.557374, "o", "            case \"DOWN\": keycode = Input.Keys.DOWN; break;\r\n\u001b[?2004l\r\u001b[?2004h"]
[43.557431, "o", "> "]
[43.557634, "o", "            case \"LEFT\": keycode = Input.Keys.LEFT; break;\r\n\u001b[?2004l\r\u001b[?2004h> "]
[43.557881, "o", "            case \"RIGHT\": keycode = Input.Keys.RIGHT; break;\r\n\u001b[?2004l\r\u001b[?2004h> "]
[43.558018, "o", "            default:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[43.558218, "o", "                error.set(\"unknown key \" + key);\r\n\u001b[?2004l\r\u001b[?2004h> "]
[43.558408, "o", "                return false;\r\n\u001b[?2004l\r\u001b[?2004h> "]
[43.558525, "o", "        }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[43.558621, "o", "        if (processor != null) {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[43.558779, "o", "            processor.keyDown(keycode);\r\n\u001b[?2004l\r\u001b[?2004h> "]
[43.558887, "o", "        }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[43.558997, "o", "        return true;\r\n\u001b[?2004l\r\u001b[?2004h>     }\r\n\u001b[?2004l\r\u001b[?2004h"]
[43.559074, "o", "> }\r\n\u001b[?2004l\r\u001b[?2004h> EOF\r\n\u001b[?2004l\r"]
[43.560312, "o", "\u001b[?2004hroot@e272d2f3-9a14-4b6a-96ae-055c8a116978:/home/user/gdx-game# "]
[44.035408, "i", "cat > src/main/java/com/example/walker/Main.java << 'EOF'\npackage com.example.walker;\n\nimport com.badlogic.gdx.ApplicationListener;\nimport com.badlogic.gdx.Gdx;\nimport com.badlogic.gdx.backends.headless.HeadlessApplication;\nimport com.badlogic.gdx.backends.headless.HeadlessApplicationConfiguration;\n\npublic class Main {\n    public static void main(String[] args) throws Exception {\n        String inputPath = null;\n        for (String arg : args) {\n            if (arg.startsWith(\"--input=\")) {\n                inputPath = arg.substring(\"--input=\".length());\n            }\n        }\n        if (inputPath == null) {\n            System.err.println(\"Usage: gdx-game --input=<path>\");\n            System.exit(2);\n        }\n\n        ScriptedInput scriptedInput;\n        try {\n            scriptedInput = new ScriptedInput(inputPath);\n        } catch (IllegalArgumentException e) {\n            System.err.println(\"Error: \" + e.getMessage());\n            System.exit(1);\n            return;\n        }\n\n        HeadlessApplicationConfiguration config = new HeadlessApplicationConfiguration();\n        config.updatesPerSecond = 60;\n        // Render at every update\n        config.renderInterval = 1.0f / 60.0f;\n\n        WalkerGame game = new WalkerGame();\n        HeadlessApplication app = new HeadlessApplication(game, config);\n        // Overwrite Gdx.input with our scripted version\n        Gdx.input = scriptedInput;\n        // Re-register input processor now that we replaced Gdx.input\n        Gdx.input.setInputProcessor(game);\n\n        // Drive the simulation in a separate thread: dispatch one key per tick then call Gdx.app.exit() when exhausted\n        Thread driver = new Thread(() -> {\n            try {\n                while (!scriptedInput.isExhausted()) {\n                    Thread.sleep(1000L / 60L);\n                    // Dispatch on the application thread via postRunnable\n                    final boolean[] done = {false};\n                    Gdx.app.postRunnable(() -> {\n                        scriptedInput.dispatchNext();\n                        done[0] = true;\n                    });\n                    // Wait briefly so we don't busy loop\n                    long start = System.currentTimeMillis();\n                    while (!done[0] && (System.currentTimeMillis() - start) < 1000) {\n                        Thread.sleep(1);\n                    }\n                }\n                Gdx.app.postRunnable(() -> Gdx.app.exit());\n            } catch (InterruptedException e) {\n                Thread.currentThread().interrupt();\n            }\n        });\n        driver.setDaemon(true);\n        driver.start();\n\n        // Block main thread on the application to keep JVM alive\n        app.getApplicationListener().create(); // already called by HeadlessApplication; harmless\n        // The HeadlessApplication runs its own main loop on a non-daemon thread; join it.\n        // We can do this by waiting for Gdx.app to be exiting. Simpler approach: just spin.\n        while (Gdx.app != null) {\n            Thread.sleep(50);\n            // Check if app exited - HeadlessApplication sets thread interrupted/exited. We don't have direct API\n            // so use a sentinel: after exit, the headless thread ends. We'll join the runtime's main thread.\n            // Best approach: use a timeout-based polling and check whether the runtime thread is alive.\n            // Simpler: just join via reflection or rely on the shutdown hook. For now, sleep then exit when done.\n            if (Thread.currentThread().isInterrupted()) break;\n            // Check if we should stop: we use a small heuristic - exit when we're sure app is done\n            // Use System.gc-free polling with a sleep cap.\n        }\n        System.out.println(\"Final position: (\" + game.getX() + \", \" + game.getY() + \")\");\n        System.exit(0);\n    }\n}\nEOF\n"]
