[314.223154, "o", "    public InputProcessor getInputProcessor() {\r\n\u001b[?2004l\r"]
[314.223206, "o", "\u001b[?2004h> "]
[314.223374, "o", "        return processor;\r\n\u001b[?2004l\r"]
[314.223424, "o", "\u001b[?2004h> "]
[314.223514, "o", "    }\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[314.223565, "o", "\u001b[?2004h> "]
[314.223819, "o", "    public boolean dispatchNext() {\r\n\u001b[?2004l\r"]
[314.223866, "o", "\u001b[?2004h> "]
[314.224119, "o", "        if (index >= keys.size()) {\r\n\u001b[?2004l\r"]
[314.224174, "o", "\u001b[?2004h> "]
[314.224335, "o", "            return false;\r\n\u001b[?2004l\r"]
[314.224386, "o", "\u001b[?2004h> "]
[314.224471, "o", "        }\r\n\u001b[?2004l\r\u001b[?2004h"]
[314.224523, "o", "> "]
[314.224776, "o", "        String key = keys.get(index++);\r\n\u001b[?2004l\r"]
[314.224828, "o", "\u001b[?2004h> "]
[314.224966, "o", "        int keycode;\r\n\u001b[?2004l\r"]
[314.225029, "o", "\u001b[?2004h> "]
[314.225186, "o", "        switch (key) {\r\n\u001b[?2004l\r"]
[314.22524, "o", "\u001b[?2004h> "]
[314.225597, "o", "            case \"UP\": keycode = Input.Keys.UP; break;\r\n\u001b[?2004l\r"]
[314.225651, "o", "\u001b[?2004h> "]
[314.226115, "o", "            case \"DOWN\": keycode = Input.Keys.DOWN; break;\r\n\u001b[?2004l\r\u001b[?2004h> "]
[314.226464, "o", "            case \"LEFT\": keycode = Input.Keys.LEFT; break;\r\n\u001b[?2004l\r"]
[314.226515, "o", "\u001b[?2004h> "]
[314.226909, "o", "            case \"RIGHT\": keycode = Input.Keys.RIGHT; break;\r\n\u001b[?2004l\r"]
[314.22696, "o", "\u001b[?2004h> "]
[314.227115, "o", "            default:\r\n\u001b[?2004l\r"]
[314.227164, "o", "\u001b[?2004h> "]
[314.22763, "o", "                throw new IllegalStateException(\"unreachable: \" + key);\r\n\u001b[?2004l\r"]
[314.227682, "o", "\u001b[?2004h> "]
[314.227848, "o", "        }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[314.228036, "o", "        if (processor != null) {\r\n\u001b[?2004l\r"]
[314.22809, "o", "\u001b[?2004h> "]
[314.228368, "o", "            processor.keyDown(keycode);\r\n\u001b[?2004l\r"]
[314.228426, "o", "\u001b[?2004h> "]
[314.228551, "o", "        }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[314.228679, "o", "        return true;\r\n\u001b[?2004l\r"]
[314.228739, "o", "\u001b[?2004h> "]
[314.228871, "o", "    }\r\n\u001b[?2004l\r\u001b[?2004h> }\r\n\u001b[?2004l\r\u001b[?2004h"]
