[313.659812, "o", "\u001b[?2004h> "]
[313.659954, "o", "            return;\r\n\u001b[?2004l\r"]
[313.660021, "o", "\u001b[?2004h> "]
[313.660121, "o", "        }\r\n\u001b[?2004l\r\u001b[?2004h> "]
