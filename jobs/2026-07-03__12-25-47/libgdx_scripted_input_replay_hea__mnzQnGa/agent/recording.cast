[43.547321, "i", "cat > src/main/java/com/example/walker/ScriptedInput.java << 'EOF'\npackage com.example.walker;\n\nimport com.badlogic.gdx.InputProcessor;\nimport com.badlogic.gdx.backends.headless.MockInput;\nimport com.badlogic.gdx.Input;\n\nimport java.io.IOException;\nimport java.nio.charset.StandardCharsets;\nimport java.nio.file.Files;\nimport java.nio.file.Paths;\nimport java.util.ArrayList;\nimport java.util.List;\nimport java.util.concurrent.atomic.AtomicReference;\n\npublic class ScriptedInput extends MockInput {\n    private final List<String> keys = new ArrayList<>();\n    private int index = 0;\n    private InputProcessor processor;\n    private final AtomicReference<String> error = new AtomicReference<>(null);\n\n    public ScriptedInput(String path) throws IOException {\n        List<String> lines = Files.readAllLines(Paths.get(path), StandardCharsets.UTF_8);\n        for (String raw : lines) {\n            String line = raw.trim();\n            if (line.isEmpty()) continue;\n            if (line.startsWith(\"#\")) continue;\n            String upper = line.toUpperCase();\n            if (!upper.equals(\"UP\") && !upper.equals(\"DOWN\") && !upper.equals(\"LEFT\") && !upper.equals(\"RIGHT\")) {\n                throw new IllegalArgumentException(\"unknown key \" + line);\n            }\n            keys.add(upper);\n        }\n    }\n\n    public boolean hasError() { return error.get() != null; }\n    public String getError() { return error.get(); }\n    public boolean isExhausted() { return index >= keys.size(); }\n\n    @Override\n    public void setInputProcessor(InputProcessor processor) {\n        this.processor = processor;\n    }\n\n    @Override\n    public InputProcessor getInputProcessor() {\n        return processor;\n    }\n\n    @Override\n    public void update() {\n        // Do not REDACTED-dispatch - render() in the game calls dispatchNext\n    }\n\n    public boolean dispatchNext() {\n        if (index >= keys.size()) return false;\n        String key = keys.get(index++);\n        int keycode;\n        switch (key) {\n            case \"UP\": keycode = Input.Keys.UP; break;\n            case \"DOWN\": keycode = Input.Keys.DOWN; break;\n            case \"LEFT\": keycode = Input.Keys.LEFT; break;\n            case \"RIGHT\": keycode = Input.Keys.RIGHT; break;\n            default:\n                error.set(\"unknown key \" + key);\n                return false;\n        }\n        if (processor != null) {\n            processor.keyDown(keycode);\n        }\n        return true;\n    }\n}\nEOF\n"]
