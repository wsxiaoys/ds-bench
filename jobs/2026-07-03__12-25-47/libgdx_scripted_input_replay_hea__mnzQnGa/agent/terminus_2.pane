[?2004l[?2004h>         // Block main thread on the application to keep JVM alive
[?2004l[?2004h>         app.getApplicationListener().create(); // already called by HeadlessApplication; harmless
[?2004l[?2004h>         // The HeadlessApplication runs its own main loop on a non-daemon thread; join it.
[?2004l[?2004h>         // We can do this by waiting for Gdx.app to be exiting. Simpler approach: just spin.
