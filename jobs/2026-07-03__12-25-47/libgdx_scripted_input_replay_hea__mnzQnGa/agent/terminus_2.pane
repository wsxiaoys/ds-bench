[?2004l[?2004h> 
[?2004l[?2004h>         WalkerGame game = new WalkerGame();
[?2004l[?2004h>         HeadlessApplication app = new HeadlessApplication(game, config);
[?2004l[?2004h>         // Overwrite Gdx.input with our scripted version
