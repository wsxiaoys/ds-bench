[?2004l[?2004h>             System.exit(1);
[?2004l[?2004h>             return;
[?2004l[?2004h>         }
[?2004l[?2004h> 
[?2004l[?2004h>         HeadlessApplicationConfiguration config = new HeadlessApplicationConfiguration();
[?2004l[?2004h>         config.updatesPerSecond = 60;
[?2004l[?2004h>         // Render at every update
