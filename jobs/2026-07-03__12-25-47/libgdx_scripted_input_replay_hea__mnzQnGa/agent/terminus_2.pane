[?2004l[?2004h>         // Re-register input processor now that we replaced Gdx.input
[?2004l[?2004h>         Gdx.input.setInputProcessor(game);
[?2004l[?2004h> 
[?2004l[?2004h>         // Drive the simulation in a separate thread: dispatch one key per tick then call Gdx.app.exit() when exhausted
[?2004l[?2004h>         Thread driver = new Thread(() -> {
[?2004l[?2004h>             try {
[?2004l[?2004h>                 while (!scriptedInput.isExhausted()) {
[?2004l[?2004h>                     Thread.sleep(1000L / 60L);
[?2004l[?2004h>                     // Dispatch on the application thread via postRunnable
