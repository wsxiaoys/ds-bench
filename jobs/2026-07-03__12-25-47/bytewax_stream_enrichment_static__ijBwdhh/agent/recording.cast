[391.539571, "o", "drwxr-xr-x 1 root root   58 Jul  3 14:11 \u001b[0m\u001b[01;34m.\u001b[0m\r\ndrwxr-xr-x 1 root root   37 Jul  3 14:04 \u001b[01;34m..\u001b[0m\r\ndrwxr-xr-x 2 root root   86 Jul  3 14:11 \u001b[01;34m__pycache__\u001b[0m\r\n-rw-r--r-- 1 root root 4088 Jul  3 14:11 enrichment.py\r\n-rw-r--r-- 1 root root  102 Jul  3 14:04 products.json\r\n-rw-r--r-- 1 root root  485 Jul  3 14:04 transactions.jsonl\r\n"]
