[97.394383, "o", "    emit_mode: Literal[\"complete\"],\r\n    ordered: bool = ...,\r\n) -> WindowOut[Union[U, V, W, X], Tuple[U, V, W, X]]: ...\r\n\r\n\r\n@overload\r\ndef join_window(\r\n    step_id: str,\r\n    clock: Clock[V, Any],\r\n    windower: Windower[Any],\r\n    side1: KeyedStream[V],\r\n    /,\r\n    *,\r\n    insert_mode: JoinInsertMode = ...,\r\n    emit_mode: JoinEmitMode = ...,\r\n    ordered: bool = ...,\r\n) -> WindowOut[V, Tuple[Optional[V]]]: ...\r\n\r\n\r\n@overload\r\ndef join_window(\r\n    step_id: str,\r\n"]
