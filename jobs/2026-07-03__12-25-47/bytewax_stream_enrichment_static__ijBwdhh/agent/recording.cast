[314.897835, "o", "debug.down: ('cat1', (720, 60.0))\r\ndebug.meta: ('cat1', (720, WindowMetadata(open_time=datetime.datetime(2026, 1, 1, 12, 0, tzinfo=datetime.timezone.utc), close_time=datetime.datetime(2026, 1, 1, 12, 1, tzinfo=datetime.timezone.utc), merged_ids=set())))\r\ndebug.joined: ('cat1', ((720, 60.0), (720, WindowMetadata(open_time=datetime.datetime(2026, 1, 1, 12, 0, tzinfo=datetime.timezone.utc), close_time=datetime.datetime(2026, 1, 1, 12, 1, tzinfo=datetime.timezone.utc), merged_ids=set()))))\r\n"]
