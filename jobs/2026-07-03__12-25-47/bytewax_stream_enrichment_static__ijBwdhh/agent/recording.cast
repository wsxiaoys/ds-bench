[334.914945, "o", "    clock,\r\n\u001b[?2004l\r"]
[334.914996, "o", "\u001b[?2004h> "]
[334.915142, "o", "    windower,\r\n\u001b[?2004l\r"]
[334.915193, "o", "\u001b[?2004h> "]
[334.915406, "o", "    builder=lambda: 0.0,\r\n\u001b[?2004l\r"]
[334.915458, "o", "\u001b[?2004h> "]
[334.915759, "o", "    folder=lambda acc, x: acc + x[1],\r\n\u001b[?2004l\r"]
[334.915812, "o", "\u001b[?2004h> "]
[334.916076, "o", "    merger=lambda a, b: a + b,\r\n\u001b[?2004l\r"]
[334.916197, "o", "\u001b[?2004h> )\r\n"]
[334.91625, "o", "\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[334.916304, "o", "\u001b[?2004h> "]
[334.916811, "o", "# 5) Join the aggregated values (down) with window metadata (meta) to\r\n\u001b[?2004l\r"]
[334.916866, "o", "\u001b[?2004h> "]
[334.917141, "o", "# obtain the window start time.\r\n\u001b[?2004l\r"]
[334.917197, "o", "\u001b[?2004h> "]
[334.917385, "o", "down = windowed.down\r\n\u001b[?2004l\r"]
[334.917439, "o", "\u001b[?2004h> "]
[334.917627, "o", "meta = windowed.meta\r\n\u001b[?2004l\r"]
[334.917681, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[334.917798, "o", "\u001b[?2004h> "]
[334.918115, "o", "joined = op.join(\"join_down_meta\", down, meta)\r\n\u001b[?2004l\r"]
[334.918166, "o", "\u001b[?2004h> "]
[334.918378, "o", "# joined item structure:\r\n\u001b[?2004l\r"]
[334.918428, "o", "\u001b[?2004h> "]
[334.91891, "o", "# (category, ((window_id, revenue), (window_id, WindowMetadata)))\r\n\u001b[?2004l\r"]
[334.918962, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[334.919088, "o", "\u001b[?2004h> "]
[334.919296, "o", "def format_output(item) -> str:\r\n\u001b[?2004l\r"]
[334.91935, "o", "\u001b[?2004h> "]
[334.919876, "o", "    category, ((_window_id, revenue), (_window_id2, window_meta)) = item\r\n\u001b[?2004l\r"]
[334.919933, "o", "\u001b[?2004h> "]
[334.920422, "o", "    window_start = window_meta.open_time.astimezone(timezone.utc)\r\n\u001b[?2004l\r"]
[334.920479, "o", "\u001b[?2004h> "]
[334.966992, "o", "    window_start_str = window_start.strftime(\"%Y-%m-%dT%H:%M:%S+00:00\")\r\n\u001b[?2004l\r\u001b[?2004h>     return json.dumps(\r\n\u001b[?2004l\r\u001b[?2004h>         {\r\n\u001b[?2004l\r\u001b[?2004h>             \"category\": category,\r\n\u001b[?2004l\r\u001b[?2004h>             \"window_start\": window_start_str,\r\n\u001b[?2004l\r\u001b[?2004h>             \"revenue\": revenue,\r\n\u001b[?2004l\r\u001b[?2004h>         }\r\n\u001b[?2004l\r\u001b[?2004h>     )\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> formatted = op.map(\"format_output\", joined, format_output)\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> # 6) Write to stdout.\r\n\u001b[?2004l\r\u001b[?2004h> op.output(\"stdout\", formatted, StdOutSink())\r\n\u001b[?2004l\r\u001b[?2004h> PYEOF\r\n\u001b[?2004l\r"]
