[130.406052, "o", "from datetime import datetime, timedelta, timezone\r\n\u001b[?2004l\r"]
[130.406124, "o", "\u001b[?2004h> "]
[130.406393, "o", "from typing import Iterable, Optional, Tuple\r\n\u001b[?2004l\r"]
[130.40644, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[130.406485, "o", "\u001b[?2004h> "]
[130.40673, "o", "import bytewax.operators as op\r\n\u001b[?2004l\r"]
[130.406776, "o", "\u001b[?2004h> "]
[130.407161, "o", "from bytewax.connectors.stdio import StdOutSink\r\n\u001b[?2004l\r\r\n\r\n    f\u001b[?2004h"]
[130.407202, "o", "> "]
[130.407436, "o", "from bytewax.dataflow import Dataflow\r\n\u001b[?2004l\r"]
[130.407479, "o", "\u001b[?2004h> "]
[130.407944, "o", "from bytewax.inputs import FixedPartitionedSource, StatefulSourcePartition\r\n\u001b[?2004l\r"]
[130.407988, "o", "\u001b[?2004h> "]
[130.408523, "o", "from bytewax.operators.windowing import EventClock, TumblingWindower, reduce_window\r\n\u001b[?2004l\r"]
[130.408571, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[130.408616, "o", "\u001b[?2004h> "]
[130.408877, "o", "# Load static product metadata at module load time.\r\n\u001b[?2004l\r\u001b[?2004h"]
[130.408919, "o", "> "]
[130.409127, "o", "with open(\"products.json\", \"r\") as _f:\r\n\u001b[?2004l\r\u001b[?2004h"]
[130.40917, "o", "> "]
[130.409311, "o", "    PRODUCTS = json.load(_f)\r\n\u001b[?2004l\r"]
[130.409355, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[130.409455, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[130.409689, "o", "def _parse_timestamp(ts_str: str) -> datetime:\r\n\u001b[?2004l\r"]
[130.409736, "o", "\u001b[?2004h> "]
[130.410084, "o", "    \"\"\"Parse an ISO8601 timestamp string into a UTC-aware datetime.\"\"\"\r\n\u001b[?2004l\r"]
[130.410127, "o", "\u001b[?2004h> "]
[130.410546, "o", "    # Python's fromisoformat doesn't accept the trailing 'Z' before 3.11.\r\n\u001b[?2004l\r\u001b[?2004h> "]
[130.410697, "o", "    if ts_str.endswith(\"Z\"):\r\n\u001b[?2004l\r"]
[130.410739, "o", "\u001b[?2004h> "]
[130.410956, "o", "        ts_str = ts_str[:-1] + \"+00:00\"\r\n\u001b[?2004l\r"]
[130.410995, "o", "\u001b[?2004h> "]
[130.411226, "o", "    dt = datetime.fromisoformat(ts_str)\r\n\u001b[?2004l\r"]
[130.411272, "o", "\u001b[?2004h> "]
[130.411404, "o", "    if dt.tzinfo is None:\r\n\u001b[?2004l\r"]
[130.411441, "o", "\u001b[?2004h> "]
[130.411685, "o", "        dt = dt.replace(tzinfo=timezone.utc)\r\n\u001b[?2004l\r"]
[130.411721, "o", "\u001b[?2004h> "]
[130.41193, "o", "    return dt.astimezone(timezone.utc)\r\n\u001b[?2004l\r"]
[130.411966, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[130.412033, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[130.412116, "o", "\u001b[?2004h> "]
[130.412375, "o", "class JSONLinesSource(FixedPartitionedSource[dict, int]):\r\n\u001b[?2004l\r"]
[130.412413, "o", "\u001b[?2004h> "]
[130.412813, "o", "    \"\"\"A simple source that reads a JSON lines file as a stream of dicts.\"\"\"\r\n\u001b[?2004l\r"]
[130.41285, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[130.412922, "o", "\u001b[?2004h> "]
[130.413095, "o", "    def __init__(self, path: str):\r\n\u001b[?2004l\r"]
[130.413163, "o", "\u001b[?2004h> "]
[130.413302, "o", "        self._path = path\r\n\u001b[?2004l\r"]
[130.413377, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[130.413596, "o", "    def list_parts(self) -> list[str]:\r\n\u001b[?2004l\r"]
[130.413665, "o", "\u001b[?2004h> "]
[130.413794, "o", "        return [\"singleton\"]\r\n\u001b[?2004l\r"]
[130.413863, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[130.413931, "o", "> "]
[130.414019, "o", "    def build_part(\r\n\u001b[?2004l\r\u001b[?2004h"]
[130.414104, "o", "> "]
[130.414174, "o", "        self,\r\n\u001b[?2004l\r\u001b[?2004h> "]
[130.414323, "o", "        step_id: str,\r\n\u001b[?2004l\r"]
[130.414389, "o", "\u001b[?2004h> "]
[130.414498, "o", "        for_part: str,\r\n\u001b[?2004l\r"]
[130.414567, "o", "\u001b[?2004h> "]
[130.414774, "o", "        resume_state: Optional[int],\r\n\u001b[?2004l\r"]
[130.414843, "o", "\u001b[?2004h> "]
[130.415108, "o", "    ) -> StatefulSourcePartition[dict, int]:\r\n\u001b[?2004l\r"]
[130.415179, "o", "\u001b[?2004h> "]
[130.415499, "o", "        return _JSONLinesPartition(self._path, resume_state)\r\n\u001b[?2004l\r"]
[130.415541, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[130.415652, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[130.416001, "o", "class _JSONLinesPartition(StatefulSourcePartition[dict, int]):\r\n\u001b[?2004l\r"]
[130.416082, "o", "\u001b[?2004h> "]
[130.416416, "o", "    def __init__(self, path: str, start_offset: Optional[int]):\r\n\u001b[?2004l\r"]
[130.416488, "o", "\u001b[?2004h> "]
[130.416588, "o", "        self._path = path\r\n\u001b[?2004l\r"]
[130.416657, "o", "\u001b[?2004h> "]
[130.417014, "o", "        self._offset = start_offset if start_offset is not None else 0\r\n\u001b[?2004l\r"]
[130.417127, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[130.417197, "o", "> "]
[130.417393, "o", "    def next_batch(self) -> Iterable[dict]:\r\n\u001b[?2004l\r"]
[130.41746, "o", "\u001b[?2004h> "]
[130.417545, "o", "        batch = []\r\n\u001b[?2004l\r"]
[130.417613, "o", "\u001b[?2004h> "]
[130.417818, "o", "        with open(self._path, \"r\") as f:\r\n\u001b[?2004l\r"]
[130.417884, "o", "\u001b[?2004h> "]
[130.418059, "o", "            f.seek(self._offset)\r\n\u001b[?2004l\r"]
[130.418155, "o", "\u001b[?2004h> "]
[130.418239, "o", "            for line in f:\r\n\u001b[?2004l\r"]
[130.418306, "o", "\u001b[?2004h> "]
[130.418464, "o", "                line = line.strip()\r\n\u001b[?2004l\r"]
[130.418529, "o", "\u001b[?2004h> "]
[130.418698, "o", "                if not line:\r\n\u001b[?2004l\r"]
[130.418767, "o", "\u001b[?2004h> "]
[130.418923, "o", "                    continue\r\n\u001b[?2004l\r"]
[130.418991, "o", "\u001b[?2004h> "]
[130.419245, "o", "                batch.append(json.loads(line))\r\n\u001b[?2004l\r"]
[130.419316, "o", "\u001b[?2004h> "]
[130.419521, "o", "            self._offset = f.tell()\r\n\u001b[?2004l\r"]
[130.419589, "o", "\u001b[?2004h> "]
[130.419722, "o", "        if not batch:\r\n\u001b[?2004l\r"]
[130.419791, "o", "\u001b[?2004h> "]
[130.419992, "o", "            raise StopIteration()\r\n\u001b[?2004l\r"]
[130.42007, "o", "\u001b[?2004h> "]
[130.420203, "o", "        return batch\r\n\u001b[?2004l\r"]
[130.42027, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[130.420336, "o", "\u001b[?2004h> "]
[130.420484, "o", "    def snapshot(self) -> int:\r\n\u001b[?2004l\r"]
[130.420555, "o", "\u001b[?2004h> "]
[130.420673, "o", "        return self._offset\r\n\u001b[?2004l\r"]
[130.420751, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[130.42082, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[130.420995, "o", "def build_flow() -> Dataflow:\r\n\u001b[?2004l\r"]
[130.421075, "o", "\u001b[?2004h> "]
[130.421253, "o", "    flow = Dataflow(\"enrichment\")\r\n\u001b[?2004l\r"]
[130.42132, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[130.421386, "o", "\u001b[?2004h> "]
[130.421644, "o", "    # 1) Ingest transactions as a stream of dicts.\r\n\u001b[?2004l\r"]
[130.421713, "o", "\u001b[?2004h> "]
[130.422212, "o", "    raw = op.input(\"transactions\", flow, JSONLinesSource(\"transactions.jsonl\"))\r\n\u001b[?2004l\r"]
[130.422251, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[130.422331, "o", "\u001b[?2004h> "]
[130.422665, "o", "    # 2) Parse timestamp into a UTC-aware datetime and enrich / filter.\r\n\u001b[?2004l\r"]
[130.422735, "o", "\u001b[?2004h> "]
[130.422993, "o", "    def parse_and_enrich(event: dict) -> Optional[dict]:\r\n\u001b[?2004l\r"]
[130.423154, "o", "\u001b[?2004h> "]
[130.423386, "o", "        product = PRODUCTS.get(event[\"product_id\"])\r\n\u001b[?2004l\r"]
[130.423457, "o", "\u001b[?2004h> "]
[130.423602, "o", "        if product is None:\r\n\u001b[?2004l\r"]
[130.42367, "o", "\u001b[?2004h> "]
[130.423797, "o", "            return None\r\n\u001b[?2004l\r"]
[130.423862, "o", "\u001b[?2004h> "]
[130.424134, "o", "        ts = _parse_timestamp(event[\"timestamp\"])\r\n\u001b[?2004l\r"]
[130.424203, "o", "\u001b[?2004h> "]
[130.424278, "o", "        return {\r\n\u001b[?2004l\r"]
[130.424346, "o", "\u001b[?2004h> "]
[130.424591, "o", "            \"transaction_id\": event[\"transaction_id\"],\r\n\u001b[?2004l\r"]
[130.424658, "o", "\u001b[?2004h> "]
[130.424871, "o", "            \"category\": product[\"category\"],\r\n\u001b[?2004l\r"]
[130.424938, "o", "\u001b[?2004h> "]
[130.42528, "o", "            \"revenue\": product[\"price\"] * event[\"quantity\"],\r\n\u001b[?2004l\r"]
[130.425349, "o", "\u001b[?2004h> "]
[130.425479, "o", "            \"timestamp\": ts,\r\n\u001b[?2004l\r"]
[130.425546, "o", "\u001b[?2004h> "]
[130.425614, "o", "        }\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[130.425685, "o", "\u001b[?2004h> "]
[130.426004, "o", "    parsed = op.filter_map(\"parse_and_enrich\", raw, parse_and_enrich)\r\n\u001b[?2004l\r"]
[130.426085, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[130.42623, "o", "    # 3) Key by category.\r\n\u001b[?2004l\r"]
[130.426298, "o", "\u001b[?2004h> "]
[130.426699, "o", "    keyed = op.key_on(\"by_category\", parsed, lambda e: e[\"category\"])\r\n\u001b[?2004l\r"]
[130.426768, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[130.426835, "o", "\u001b[?2004h> "]
[130.427294, "o", "    # 4) Window with EventClock + 1-minute TumblingWindower aligned to the hour.\r\n\u001b[?2004l\r"]
[130.427365, "o", "\u001b[?2004h> "]
[130.427825, "o", "    clock = EventClock(lambda e: e[\"timestamp\"], wait_for_system_duration=timedelta(seconds=10))\r\n\u001b[?2004l\r"]
[130.427899, "o", "\u001b[?2004h> "]
[130.428289, "o", "    align_to = datetime(2026, 1, 1, 0, 0, 0, tzinfo=timezone.utc)\r\n\u001b[?2004l\r"]
[130.428364, "o", "\u001b[?2004h> "]
[130.428793, "o", "    windower = TumblingWindower(length=timedelta(minutes=1), align_to=align_to)\r\n\u001b[?2004l\r"]
[130.428866, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[130.428936, "o", "\u001b[?2004h> "]
[130.429101, "o", "    windowed = reduce_window(\r\n\u001b[?2004l\r"]
[130.429168, "o", "\u001b[?2004h> "]
[130.429352, "o", "        \"revenue_per_category\",\r\n\u001b[?2004l\r"]
[130.429422, "o", "\u001b[?2004h> "]
[130.429493, "o", "        keyed,\r\n\u001b[?2004l\r"]
[130.42956, "o", "\u001b[?2004h> "]
[130.429628, "o", "        clock,\r\n\u001b[?2004l\r\u001b[?2004h"]
[130.429696, "o", "> "]
[130.429764, "o", "        windower,\r\n\u001b[?2004l\r"]
[130.429831, "o", "\u001b[?2004h> "]
[130.430107, "o", "        reducer=lambda acc, x: acc + x[\"revenue\"],\r\n\u001b[?2004l\r"]
[130.430204, "o", "\u001b[?2004h>     )\r\n\u001b[?2004l\r"]
[130.430302, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[130.430715, "o", "    # 5) Join the aggregated values (down) with window metadata (meta) to\r\n\u001b[?2004l\r"]
[130.430782, "o", "\u001b[?2004h> "]
[130.430946, "o", "    # obtain the window start time.\r\n\u001b[?2004l\r"]
[130.431009, "o", "\u001b[?2004h> "]
[130.431174, "o", "    down = windowed.down\r\n\u001b[?2004l\r"]
[130.43124, "o", "\u001b[?2004h> "]
[130.431352, "o", "    meta = windowed.meta\r\n\u001b[?2004l\r"]
[130.431411, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[130.43147, "o", "> "]
[130.431699, "o", "    joined = op.join(\"join_down_meta\", down, meta)\r\n\u001b[?2004l\r"]
[130.431767, "o", "\u001b[?2004h> "]
[130.432161, "o", "    # joined items are ((category, window_id), (value, WindowMetadata))\r\n\u001b[?2004l\r\u001b[?2004h"]
[130.432223, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[130.432443, "o", "    def format_output(item) -> str:\r\n\u001b[?2004l\r"]
[130.432483, "o", "\u001b[?2004h> "]
[130.432747, "o", "        (key, (revenue, window_meta)) = item\r\n\u001b[?2004l\r"]
[130.432803, "o", "\u001b[?2004h> "]
[130.433014, "o", "        category, _window_id = key\r\n\u001b[?2004l\r"]
[130.433078, "o", "\u001b[?2004h> "]
[130.433324, "o", "        window_start = window_meta.open_time\r\n\u001b[?2004l\r"]
[130.433377, "o", "\u001b[?2004h> "]
[130.433639, "o", "        # Format with explicit UTC offset.\r\n\u001b[?2004l\r"]
[130.433701, "o", "\u001b[?2004h> "]
[130.434098, "o", "        window_start_str = window_start.astimezone(timezone.utc).strftime(\r\n\u001b[?2004l\r"]
[130.434155, "o", "\u001b[?2004h> "]
[130.434362, "o", "            \"%Y-%m-%dT%H:%M:%S+00:00\"\r\n\u001b[?2004l\r"]
[130.434417, "o", "\u001b[?2004h> "]
[130.434478, "o", "        )\r\n\u001b[?2004l\r"]
[130.434531, "o", "\u001b[?2004h> "]
[130.434696, "o", "        return json.dumps(\r\n\u001b[?2004l\r"]
[130.434752, "o", "\u001b[?2004h> "]
[130.434848, "o", "            {\r\n\u001b[?2004l\r"]
[130.434913, "o", "\u001b[?2004h> "]
[130.435148, "o", "                \"category\": category,\r\n\u001b[?2004l\r"]
[130.435214, "o", "\u001b[?2004h> "]
[130.435471, "o", "                \"window_start\": window_start_str,\r\n\u001b[?2004l\r"]
[130.435602, "o", "\u001b[?2004h> "]
[130.435713, "o", "                \"revenue\": revenue,\r\n\u001b[?2004l\r"]
[130.43578, "o", "\u001b[?2004h> "]
[130.435843, "o", "            }\r\n\u001b[?2004l\r\u001b[?2004h"]
[130.435906, "o", ">         )\r\n\u001b[?2004l\r"]
[130.435969, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[130.436051, "o", "\u001b[?2004h> "]
[130.436331, "o", "    formatted = op.map(\"format_output\", joined, format_output)\r\n\u001b[?2004l\r"]
[130.436397, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[130.436458, "o", "> "]
[130.436551, "o", "    # 6) Write to stdout.\r\n\u001b[?2004l\r"]
[130.436614, "o", "\u001b[?2004h> "]
[130.436844, "o", "    op.output(\"stdout\", formatted, StdOutSink())\r\n\u001b[?2004l\r"]
[130.436917, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[130.436973, "o", "\u001b[?2004h> "]
[130.437026, "o", "    return flow\r\n\u001b[?2004l\r\u001b[?2004h"]
[130.437095, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[130.437148, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[130.437264, "o", "flow = build_flow()\r\n\u001b[?2004l\r"]
[130.437317, "o", "\u001b[?2004h> "]
[130.43737, "o", "PYEOF\r\n\u001b[?2004l\r"]
[130.44337, "o", "\u001b[?2004h"]
[130.444734, "o", "root@01aa9e18-2703-48f5-91f1-cc64ecbdfd76:/home/user/bytewax_project# "]
[130.891488, "i", "cat /home/user/bytewax_project/enrichment.py\n"]
[130.891715, "o", "cat /home/user/bytewax_project/enrichment.py\r\n\u001b[?2004l\r"]
[130.892528, "o", "import json\r\nfrom datetime import datetime, timedelta, timezone\r\nfrom typing import Iterable, Optional, Tuple\r\n\r\nimport bytewax.operators as op\r\nfrom bytewax.connectors.stdio import StdOutSink\r\nfrom bytewax.dataflow import Dataflow\r\nfrom bytewax.inputs import FixedPartitionedSource, StatefulSourcePartition\r\nfrom bytewax.operators.windowing import EventClock, TumblingWindower, reduce_window\r\n\r\n# Load static product metadata at module load time.\r\nwith open(\"products.json\", \"r\") as _f:\r\n    PRODUCTS = json.load(_f)\r\n\r\n\r\ndef _parse_timestamp(ts_str: str) -> datetime:\r\n    \"\"\"Parse an ISO8601 timestamp string into a UTC-aware datetime.\"\"\"\r\n    # Python's fromisoformat doesn't accept the trailing 'Z' before 3.11.\r\n    if ts_str.endswith(\"Z\"):\r\n        ts_str = ts_str[:-1] + \"+00:00\"\r\n    dt = datetime.fromisoformat(ts_str)\r\n    if dt.tzinfo is None:\r\n        dt = dt.replace(tzinfo=timezone.utc)\r\n    return dt.astimezone(timezone.utc)\r\n\r\n\r\n"]
[130.892578, "o", "class JSONLinesSource(FixedPartitionedSource[dict, int]):\r\n    \"\"\"A simple source that reads a JSON lines file as a stream of dicts.\"\"\"\r\n\r\n    def __init__(self, path: str):\r\n        self._path = path\r\n\r\n    def list_parts(self) -> list[str]:\r\n        return [\"singleton\"]\r\n\r\n    def build_part(\r\n        self,\r\n        step_id: str,\r\n        for_part: str,\r\n        resume_state: Optional[int],\r\n    ) -> StatefulSourcePartition[dict, int]:\r\n        return _JSONLinesPartition(self._path, resume_state)\r\n\r\n\r\nclass _JSONLinesPartition(StatefulSourcePartition[dict, int]):\r\n    def __init__(self, path: str, start_offset: Optional[int]):\r\n        self._path = path\r\n        self._offset = start_offset if start_offset is not None else 0\r\n\r\n    def next_batch(self) -> Iterable[dict]:\r\n        batch = []\r\n        with open(self._path, \"r\") as f:\r\n            f.seek(self._offset)\r\n            for line in f:\r\n                line = line.strip()\r\n                if not line:\r\n                    continue\r\n                batch.append(json.loads(line))\r\n            self._offset = f.tell()\r\n        if not batch:\r\n            raise StopIteration()\r\n        return batch\r\n\r\n    def snapshot(self) -> int:\r\n        return self._offset\r\n\r\n\r\ndef build_flow() -> Dataflow:\r\n    flow = Dataflow(\"enrichment\")\r\n\r\n    # 1) Ingest transactions as a stream of dicts.\r\n    raw = op.input(\"transactions\", flow, JSONLinesSource(\"transactions.jsonl\"))\r\n\r\n    # 2) Parse timestamp into a UTC-aware datetime and enrich / filter.\r\n    def parse_and_enrich(event: dict) -> Optional[dict]:\r\n        product = PRODUCTS.get(event[\"product_id\"])\r\n        if product is None:\r\n            return None\r\n        ts = _parse_timestamp(event[\"timestamp\"])\r\n        return {\r\n            \"transaction_id\": event[\"transaction_id\"],\r\n            \"category\": product[\"category\"],\r\n            \"revenue\": product[\"price\"] * event[\"quantity\"],\r\n            \"timestamp\": ts,\r\n"]
[130.892621, "o", "        }\r\n\r\n    parsed = op.filter_map(\"parse_and_enrich\", raw, parse_and_enrich)\r\n\r\n    # 3) Key by category.\r\n    keyed = op.key_on(\"by_category\", parsed, lambda e: e[\"category\"])\r\n\r\n    # 4) Window with EventClock + 1-minute TumblingWindower aligned to the hour.\r\n    clock = EventClock(lambda e: e[\"timestamp\"], wait_for_system_duration=timedelta(seconds=10))\r\n    align_to = datetime(2026, 1, 1, 0, 0, 0, tzinfo=timezone.utc)\r\n    windower = TumblingWindower(length=timedelta(minutes=1), align_to=align_to)\r\n\r\n    windowed = reduce_window(\r\n        \"revenue_per_category\",\r\n        keyed,\r\n        clock,\r\n        windower,\r\n        reducer=lambda acc, x: acc + x[\"revenue\"],\r\n    )\r\n\r\n    # 5) Join the aggregated values (down) with window metadata (meta) to\r\n    # obtain the window start time.\r\n    down = windowed.down\r\n    meta = windowed.meta\r\n\r\n    joined = op.join(\"join_down_meta\", down, meta)\r\n    # joined items are ((category, window_id), (value, WindowMetadata))\r\n\r\n    def format_output(item) -> str:\r\n        (key, (revenue, window_meta)) = item\r\n        category, _window_id = key\r\n        window_start = window_meta.open_time\r\n        # Format with explicit UTC offset.\r\n        window_start_str = window_start.astimezone(timezone.utc).strftime(\r\n            \"%Y-%m-%dT%H:%M:%S+00:00\"\r\n        )\r\n        return json.dumps(\r\n            {\r\n                \"category\": category,\r\n                \"window_start\": window_start_str,\r\n                \"revenue\": revenue,\r\n            }"]
[130.892659, "o", "\r\n        )\r\n\r\n    formatted = op.map(\"format_output\", joined, format_output)\r\n\r\n    # 6) Write to stdout.\r\n    op.output(\"stdout\", formatted, StdOutSink())\r\n\r\n    return flow\r\n\r\n\r\nflow = build_flow()\r\n"]
