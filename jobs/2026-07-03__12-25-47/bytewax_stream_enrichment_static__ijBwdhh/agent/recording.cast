[334.904906, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h"]
[334.905067, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[334.905289, "o", "flow = Dataflow(\"enrichment\")\r\n\u001b[?2004l\r"]
[334.905344, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[334.905497, "o", "> "]
[334.905769, "o", "# 1) Ingest transactions as a stream of dicts.\r\n\u001b[?2004l\r"]
[334.905828, "o", "\u001b[?2004h> "]
[334.906402, "o", "raw = op.input(\"transactions\", flow, JSONLinesSource(\"transactions.jsonl\"))\r\n\u001b[?2004l\r"]
[334.906465, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[334.90661, "o", "> "]
[334.907022, "o", "# 2) Parse timestamp into a UTC-aware datetime and enrich / filter.\r\n\u001b[?2004l\r"]
[334.907152, "o", "\u001b[?2004h> "]
[334.907492, "o", "def parse_and_enrich(event: dict) -> Optional[tuple]:\r\n\u001b[?2004l\r"]
[334.907547, "o", "\u001b[?2004h> "]
[334.907915, "o", "    product = PRODUCTS.get(event[\"product_id\"])\r\n\u001b[?2004l\r"]
[334.90797, "o", "\u001b[?2004h> "]
[334.908189, "o", "    if product is None:\r\n\u001b[?2004l\r"]
[334.90829, "o", "\u001b[?2004h> "]
[334.908419, "o", "        return None\r\n\u001b[?2004l\r"]
[334.908473, "o", "\u001b[?2004h> "]
[334.908817, "o", "    ts = _parse_timestamp(event[\"timestamp\"])\r\n\u001b[?2004l\r"]
[334.908872, "o", "\u001b[?2004h> "]
[334.909263, "o", "    revenue = product[\"price\"] * event[\"quantity\"]\r\n\u001b[?2004l\r"]
[334.909318, "o", "\u001b[?2004h> "]
[334.90967, "o", "    return (product[\"category\"], revenue, ts)\r\n\u001b[?2004l\r"]
[334.909725, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[334.909874, "o", "> "]
[334.910288, "o", "parsed = op.filter_map(\"parse_and_enrich\", raw, parse_and_enrich)\r\n\u001b[?2004l\r"]
[334.910348, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[334.910516, "o", "\u001b[?2004h> "]
[334.910721, "o", "# 3) Key by category.\r\n\u001b[?2004l\r\u001b[?2004h> "]
[334.911135, "o", "keyed = op.key_on(\"by_category\", parsed, lambda e: e[0])\r\n\u001b[?2004l\r\u001b[?2004h"]
[334.911198, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h"]
[334.911336, "o", "> "]
[334.911798, "o", "# 4) Window with EventClock + 1-minute TumblingWindower aligned to the hour.\r\n\u001b[?2004l\r"]
[334.91185, "o", "\u001b[?2004h> "]
[334.912033, "o", "clock = EventClock(\r\n\u001b[?2004l\r"]
[334.91211, "o", "\u001b[?2004h> "]
[334.912342, "o", "    ts_getter=lambda e: e[2],\r\n\u001b[?2004l\r"]
[334.912393, "o", "\u001b[?2004h> "]
[334.912782, "o", "    wait_for_system_duration=timedelta(seconds=10),\r\n\u001b[?2004l\r"]
[334.912834, "o", "\u001b[?2004h> )\r\n"]
[334.912969, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[334.913392, "o", "align_to = datetime(2026, 1, 1, 0, 0, 0, tzinfo=timezone.utc)\r\n\u001b[?2004l\r"]
[334.913448, "o", "\u001b[?2004h> "]
[334.913982, "o", "windower = TumblingWindower(length=timedelta(minutes=1), align_to=align_to)\r\n\u001b[?2004l\r"]
[334.914046, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[334.914201, "o", "\u001b[?2004h> "]
[334.914327, "o", "windowed = fold_window(\r\n\u001b[?2004l\r"]
[334.914378, "o", "\u001b[?2004h> "]
[334.914605, "o", "    \"revenue_per_category\",\r\n\u001b[?2004l\r"]
[334.914656, "o", "\u001b[?2004h> "]
[334.914774, "o", "    keyed,\r\n\u001b[?2004l\r"]
