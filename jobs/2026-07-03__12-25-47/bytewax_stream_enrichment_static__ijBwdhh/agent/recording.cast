[106.217444, "o", "\r\n    @abstractmethod\r\n"]
[106.217492, "o", "    \u001b[01;31m\u001b[Kdef list_parts\u001b[m\u001b[K(self) -> List[str]:\r\n        \"\"\"List all local partitions this worker has access to.\r\n\r\n        You do not need to list all partitions globally.\r\n\r\n        :returns: Local partition keys.\r\n\r\n        \"\"\"\r\n        ...\r\n\r\n    @abstractmethod\r\n    def build_part(\r\n        self,\r\n        step_id: str,\r\n        for_part: str,\r\n        resume_state: Optional[S],\r\n    ) -> StatefulSourcePartition[X, S]:\r\n        \"\"\"Build anew or resume an input partition.\r\n\r\n        Will be called once per execution for each partition key on a\r\n"]
[106.217595, "o", "        worker that reported that partition was local in\r\n\u001b[36m\u001b[K--\u001b[m\u001b[K\r\n\r\n    @override\r\n    \u001b[01;31m\u001b[Kdef list_parts\u001b[m\u001b[K(self) -> List[str]:\r\n        return [\"singleton\"]\r\n\r\n    @override\r\n    def build_part(\r\n        self,\r\n        _step_id: str,\r\n        for_part: str,\r\n        resume_state: Optional[Sn],\r\n    ) -> _SimplePollingPartition[X, Sn]:\r\n        now = datetime.now(timezone.utc)\r\n\r\n        if resume_state is not None:\r\n            self.resume(resume_state)\r\n\r\n        return _SimplePollingPartition(\r\n            now,\r\n            self._interval,\r\n            self._align_to,\r\n            self.next_item,\r\n            self.snapshot,\r\n"]
[106.217782, "o", "\u001b[?2004hroot@01aa9e18-2703-48f5-91f1-cc64ecbdfd76:/home/user/bytewax_project# "]
[130.405334, "i", "cat > /home/user/bytewax_project/enrichment.py << 'PYEOF'\nimport json\nfrom datetime import datetime, timedelta, timezone\nfrom typing import Iterable, Optional, Tuple\n\nimport bytewax.operators as op\nfrom bytewax.connectors.stdio import StdOutSink\nfrom bytewax.dataflow import Dataflow\nfrom bytewax.inputs import FixedPartitionedSource, StatefulSourcePartition\nfrom bytewax.operators.windowing import EventClock, TumblingWindower, reduce_window\n\n# Load static product metadata at module load time.\nwith open(\"products.json\", \"r\") as _f:\n    PRODUCTS = json.load(_f)\n\n\ndef _parse_timestamp(ts_str: str) -> datetime:\n    \"\"\"Parse an ISO8601 timestamp string into a UTC-aware datetime.\"\"\"\n    # Python's fromisoformat doesn't accept the trailing 'Z' before 3.11.\n    if ts_str.endswith(\"Z\"):\n        ts_str = ts_str[:-1] + \"+00:00\"\n    dt = datetime.fromisoformat(ts_str)\n    if dt.tzinfo is None:\n        dt = dt.replace(tzinfo=timezone.utc)\n    return dt.astimezone(timezone.utc)\n\n\nclass JSONLinesSource(FixedPartitionedSource[dict, int]):\n    \"\"\"A simple source that reads a JSON lines file as a stream of dicts.\"\"\"\n\n    def __init__(self, path: str):\n        self._path = path\n\n    def list_parts(self) -> list[str]:\n        return [\"singleton\"]\n\n    def build_part(\n        self,\n        step_id: str,\n        for_part: str,\n        resume_state: Optional[int],\n    ) -> StatefulSourcePartition[dict, int]:\n        return _JSONLinesPartition(self._path, resume_state)\n\n\nclass _JSONLinesPartition(StatefulSourcePartition[dict, int]):\n    def __init__(self, path: str, start_offset: Optional[int]):\n        self._path = path\n        self._offset = start_offset if start_offset is not None else 0\n\n    def next_batch(self) -> Iterable[dict]:\n        batch = []\n        with open(self._path, \"r\") as f:\n            f.seek(self._offset)\n            for line in f:\n                line = line.strip()\n                if not line:\n                    continue\n                batch.append(json.loads(line))\n            self._offset = f.tell()\n        if not batch:\n            raise StopIteration()\n        return batch\n\n    def snapshot(self) -> int:\n        return self._offset\n\n\ndef build_flow() -> Dataflow:\n    flow = Dataflow(\"enrichment\")\n\n    # 1) Ingest transactions as a stream of dicts.\n    raw = op.input(\"transactions\", flow, JSONLinesSource(\"transactions.jsonl\"))\n\n    # 2) Parse timestamp into a UTC-aware datetime and enrich / filter.\n    def parse_and_enrich(event: dict) -> Optional[dict]:\n        product = PRODUCTS.get(event[\"product_id\"])\n        if product is None:\n            return None\n        ts = _parse_timestamp(event[\"timestamp\"])\n        return {\n            \"transaction_id\": event[\"transaction_id\"],\n            \"category\": product[\"category\"],\n            \"revenue\": product[\"price\"] * event[\"quantity\"],\n            \"timestamp\": ts,\n        }\n\n    parsed = op.filter_map(\"parse_and_enrich\", raw, parse_and_enrich)\n\n    # 3) Key by category.\n    keyed = op.key_on(\"by_category\", parsed, lambda e: e[\"category\"])\n\n    # 4) Window with EventClock + 1-minute TumblingWindower aligned to the hour.\n    clock = EventClock(lambda e: e[\"timestamp\"], wait_for_system_duration=timedelta(seconds=10))\n    align_to = datetime(2026, 1, 1, 0, 0, 0, tzinfo=timezone.utc)\n    windower = TumblingWindower(length=timedelta(minutes=1), align_to=align_to)\n\n    windowed = reduce_window(\n        \"revenue_per_category\",\n        keyed,\n        clock,\n        windower,\n        reducer=lambda acc, x: acc + x[\"revenue\"],\n    )\n\n    # 5) Join the aggregated values (down) with window metadata (meta) to\n    # obtain the window start time.\n    down = windowed.down\n    meta = windowed.meta\n\n    joined = op.join(\"join_down_meta\", down, meta)\n    # joined items are ((category, window_id), (value, WindowMetadata))\n\n    def format_output(item) -> str:\n        (key, (revenue, window_meta)) = item\n        category, _window_id = key\n        window_start = window_meta.open_time\n        # Format with explicit UTC offset.\n        window_start_str = window_start.astimezone(timezone.utc).strftim"]
[130.405381, "i", "e(\n            \"%Y-%m-%dT%H:%M:%S+00:00\"\n        )\n        return json.dumps(\n            {\n                \"category\": category,\n                \"window_start\": window_start_str,\n                \"revenue\": revenue,\n            }\n        )\n\n    formatted = op.map(\"format_output\", joined, format_output)\n\n    # 6) Write to stdout.\n    op.output(\"stdout\", formatted, StdOutSink())\n\n    return flow\n\n\nflow = build_flow()\nPYEOF\n"]
