[164.118951, "o", "> \r\n\u001b[?2004l\r"]
[164.118987, "o", "\u001b[?2004h"]
[164.119009, "o", "> \r\n\u001b[?2004l\r"]
[164.119054, "o", "\u001b[?2004h> "]
[164.119253, "o", "flow = Dataflow(\"enrichment\")\r\n\u001b[?2004l\r"]
[164.119283, "o", "\u001b[?2004h"]
[164.119305, "o", "> \r\n\u001b[?2004l\r"]
[164.119341, "o", "\u001b[?2004h"]
[164.119363, "o", "> "]
[164.119642, "o", "# 1) Ingest transactions as a stream of dicts.\r\n\u001b[?2004l\r"]
[164.119673, "o", "\u001b[?2004h"]
[164.119694, "o", "> "]
[164.120155, "o", "raw = op.input(\"transactions\", flow, JSONLinesSource(\"transactions.jsonl\"))\r\n\u001b[?2004l\r"]
[164.120188, "o", "\u001b[?2004h"]
[164.12022, "o", "> \r\n\u001b[?2004l\r"]
[164.120249, "o", "\u001b[?2004h"]
[164.120278, "o", "> "]
[164.120673, "o", "# 2) Parse timestamp into a UTC-aware datetime and enrich / filter.\r\n\u001b[?2004l\r"]
[164.120704, "o", "\u001b[?2004h"]
[164.120729, "o", "> "]
[164.121047, "o", "def parse_and_enrich(event: dict) -> Optional[dict]:\r\n\u001b[?2004l\r"]
[164.121089, "o", "\u001b[?2004h> "]
[164.12139, "o", "    product = PRODUCTS.get(event[\"product_id\"])\r\n\u001b[?2004l\r"]
[164.121423, "o", "\u001b[?2004h"]
[164.121443, "o", "> "]
[164.121591, "o", "    if product is None:\r\n\u001b[?2004l\r"]
[164.121627, "o", "\u001b[?2004h"]
[164.121648, "o", "> "]
[164.121769, "o", "        return None\r\n\u001b[?2004l\r"]
[164.121808, "o", "\u001b[?2004h"]
[164.121827, "o", "> "]
[164.122118, "o", "    ts = _parse_timestamp(event[\"timestamp\"])\r\n\u001b[?2004l\r"]
[164.12215, "o", "\u001b[?2004h"]
[164.122171, "o", "> "]
[164.122256, "o", "    return {\r\n\u001b[?2004l\r"]
[164.122291, "o", "\u001b[?2004h"]
[164.122311, "o", "> "]
[164.122617, "o", "        \"transaction_id\": event[\"transaction_id\"],\r\n\u001b[?2004l\r"]
[164.122651, "o", "\u001b[?2004h"]
[164.122672, "o", "> "]
[164.122918, "o", "        \"category\": product[\"category\"],\r\n\u001b[?2004l\r"]
[164.122951, "o", "\u001b[?2004h"]
[164.122971, "o", "> "]
[164.123324, "o", "        \"revenue\": product[\"price\"] * event[\"quantity\"],\r\n\u001b[?2004l\r"]
[164.123355, "o", "\u001b[?2004h"]
[164.123376, "o", "> "]
[164.123529, "o", "        \"timestamp\": ts,\r\n\u001b[?2004l\r"]
[164.123565, "o", "\u001b[?2004h"]
[164.123585, "o", "> "]
[164.123623, "o", "    }\r\n\u001b[?2004l\r"]
[164.123657, "o", "\u001b[?2004h"]
[164.123679, "o", "> \r\n\u001b[?2004l\r"]
[164.123717, "o", "\u001b[?2004h"]
[164.123738, "o", "> "]
[164.124144, "o", "parsed = op.filter_map(\"parse_and_enrich\", raw, parse_and_enrich)\r\n\u001b[?2004l\r"]
[164.124175, "o", "\u001b[?2004h"]
[164.124204, "o", "> \r\n\u001b[?2004l\r"]
[164.124268, "o", "\u001b[?2004h> "]
[164.124384, "o", "# 3) Key by category.\r\n\u001b[?2004l\r"]
[164.124417, "o", "\u001b[?2004h"]
[164.124437, "o", "> "]
[164.12484, "o", "keyed = op.key_on(\"by_category\", parsed, lambda e: e[\"category\"])\r\n\u001b[?2004l\r"]
[164.124872, "o", "\u001b[?2004h"]
[164.124893, "o", "> \r\n\u001b[?2004l\r"]
[164.124929, "o", "\u001b[?2004h"]
[164.12495, "o", "> "]
[164.125473, "o", "# 4) Window with EventClock + 1-minute TumblingWindower aligned to the hour.\r\n\u001b[?2004l\r\u001b[?2004h"]
[164.125547, "o", "> "]
[164.125619, "o", "clock = EventClock(\r\n\u001b[?2004l\r"]
[164.125675, "o", "\u001b[?2004h> "]
[164.125854, "o", "    lambda e: e[\"timestamp\"],\r\n\u001b[?2004l\r"]
[164.125909, "o", "\u001b[?2004h> "]
[164.12623, "o", "    wait_for_system_duration=timedelta(seconds=10),\r\n\u001b[?2004l\r"]
[164.126253, "o", "\u001b[?2004h> "]
[164.126296, "o", ")\r\n\u001b[?2004l\r"]
[164.126327, "o", "\u001b[?2004h> "]
[164.126697, "o", "align_to = datetime(2026, 1, 1, 0, 0, 0, tzinfo=timezone.utc)\r\n\u001b[?2004l\r"]
[164.126734, "o", "\u001b[?2004h"]
[164.126755, "o", "> "]
[164.12722, "o", "windower = TumblingWindower(length=timedelta(minutes=1), align_to=align_to)\r\n\u001b[?2004l\r"]
[164.127277, "o", "\u001b[?2004h"]
[164.127327, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h"]
[164.127372, "o", "> "]
[164.127483, "o", "windowed = reduce_window(\r\n\u001b[?2004l\r"]
[164.127529, "o", "\u001b[?2004h> "]
[164.127703, "o", "    \"revenue_per_category\",\r\n\u001b[?2004l\r"]
[164.127745, "o", "\u001b[?2004h"]
[164.127793, "o", "> "]
[164.127834, "o", "    keyed,\r\n\u001b[?2004l\r"]
[164.127869, "o", "\u001b[?2004h> "]
[164.127955, "o", "    clock,\r\n\u001b[?2004l\r"]
[164.127997, "o", "\u001b[?2004h> "]
[164.128102, "o", "    windower,\r\n"]
[164.128144, "o", "\u001b[?2004l\r"]
[164.128181, "o", "\u001b[?2004h> "]
[164.128449, "o", "    reducer=lambda acc, x: acc + x[\"revenue\"],\r\n\u001b[?2004l\r"]
[164.128489, "o", "\u001b[?2004h"]
[164.128514, "o", "> )\r\n\u001b[?2004l\r"]
[164.128573, "o", "\u001b[?2004h"]
[164.128614, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h"]
[164.128641, "o", "> "]
[164.129048, "o", "# 5) Join the aggregated values (down) with window metadata (meta) to\r\n\u001b[?2004l\r"]
[164.129106, "o", "\u001b[?2004h> "]
[164.129299, "o", "# obtain the window start time.\r\n\u001b[?2004l\r"]
[164.129341, "o", "\u001b[?2004h"]
[164.129368, "o", "> "]
[164.129486, "o", "down = windowed.down\r\n\u001b[?2004l\r"]
[164.129529, "o", "\u001b[?2004h> "]
[164.129672, "o", "meta = windowed.meta\r\n\u001b[?2004l\r"]
[164.129718, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[164.129759, "o", "\u001b[?2004h"]
[164.129785, "o", "> "]
[164.130098, "o", "joined = op.join(\"join_down_meta\", down, meta)\r\n\u001b[?2004l\r\u001b[?2004h"]
[164.130119, "o", "> "]
[164.130534, "o", "# joined items are ((category, window_id), (value, WindowMetadata))\r\n\u001b[?2004l\r"]
[164.130581, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[164.130621, "o", "\u001b[?2004h"]
[164.130647, "o", "> "]
[164.130832, "o", "def format_output(item) -> str:\r\n\u001b[?2004l\r"]
[164.130874, "o", "\u001b[?2004h"]
[164.130898, "o", "> "]
[164.131145, "o", "    (key, (revenue, window_meta)) = item\r\n\u001b[?2004l\r"]
[164.131188, "o", "\u001b[?2004h"]
[164.131212, "o", "> "]
[164.131449, "o", "    category, _window_id = key\r\n\u001b[?2004l\r"]
[164.131497, "o", "\u001b[?2004h"]
[164.131524, "o", "> "]
[164.132032, "o", "    window_start = window_meta.open_time.astimezone(timezone.utc)\r\n\u001b[?2004l\r"]
[164.13209, "o", "\u001b[?2004h"]
