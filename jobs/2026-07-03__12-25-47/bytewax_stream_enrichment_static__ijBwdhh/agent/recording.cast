[285.196306, "i", "cat > /tmp/debug_join.py << 'PYEOF'\nimport json\nfrom datetime import datetime, timedelta, timezone\nfrom typing import Iterable, Optional\n\nimport bytewax.operators as op\nfrom bytewax.dataflow import Dataflow\nfrom bytewax.inputs import FixedPartitionedSource, StatefulSourcePartition\nfrom bytewax.operators.windowing import EventClock, TumblingWindower, fold_window\n\nclass JSONLinesSource(FixedPartitionedSource[dict, int]):\n    def __init__(self, path: str):\n        self._path = path\n\n    def list_parts(self) -> list[str]:\n        return [\"singleton\"]\n\n    def build_part(self, step_id, for_part, resume_state):\n        return _JSONLinesPartition(self._path, resume_state)\n\n\nclass _JSONLinesPartition(StatefulSourcePartition[dict, int]):\n    def __init__(self, path: str, start_offset):\n        self._path = path\n        self._offset = start_offset if start_offset is not None else 0\n\n    def next_batch(self) -> Iterable[dict]:\n        batch = []\n        with open(self._path, \"r\") as f:\n            f.seek(self._offset)\n            for line in f:\n                line = line.strip()\n                if not line:\n                    continue\n                batch.append(json.loads(line))\n            self._offset = f.tell()\n        if not batch:\n            raise StopIteration()\n        return batch\n\n    def snapshot(self) -> int:\n        return self._offset\n\n\nflow = Dataflow(\"debug\")\n\nraw = op.input(\"transactions\", flow, JSONLinesSource(\"transactions.jsonl\"))\n\n# Parse and create (category, revenue, timestamp)\ndef parse_and_enrich(event: dict) -> Optional[tuple]:\n    ts = datetime.fromisoformat(event[\"timestamp\"].replace(\"Z\", \"+00:00\"))\n    return (\"cat1\", event.get(\"quantity\", 1) * 10.0, ts)\n\nparsed = op.filter_map(\"parse\", raw, parse_and_enrich)\nkeyed = op.key_on(\"by_cat\", parsed, lambda e: e[0])\n\nclock = EventClock(ts_getter=lambda e: e[2], wait_for_system_duration=timedelta(seconds=1))\nwindower = TumblingWindower(length=timedelta(minutes=1), align_to=datetime(2026, 1, 1, tzinfo=timezone.utc))\n\nwindowed = fold_window(\n    \"fold\",\n    keyed,\n    clock,\n    windower,\n    builder=lambda: 0.0,\n    folder=lambda acc, x: acc + x[1],\n    merger=lambda a, b: a + b,\n)\n\ndef inspect_down(x):\n    print(\"DOWN:\", x, type(x))\n    return x\n\ndef inspect_meta(x):\n    print(\"META:\", x, type(x))\n    return x\n\nop.inspect(\"down\", windowed.down)\nop.inspect(\"meta\", windowed.meta)\n\njoined = op.join(\"join\", windowed.down, windowed.meta)\n\ndef inspect_join(x):\n    print(\"JOIN:\", x, type(x))\n    if isinstance(x, tuple) and len(x) == 2:\n        k, v = x\n        print(\"  key:\", k, type(k))\n        print(\"  value:\", v, type(v))\n    return x\n\nop.inspect(\"joined\", joined)\nPYEOF\npython3 /tmp/debug_join.py\n"]
