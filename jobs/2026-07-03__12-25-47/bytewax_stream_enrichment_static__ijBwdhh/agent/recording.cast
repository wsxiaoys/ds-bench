[254.047668, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[254.04773, "o", "> "]
[254.048067, "o", "class JSONLinesSource(FixedPartitionedSource[dict, int]):\r\n\u001b[?2004l\r"]
[254.048131, "o", "\u001b[?2004h> "]
[254.048586, "o", "    \"\"\"A simple source that reads a JSON lines file as a stream of dicts.\"\"\"\r\n\u001b[?2004l\r"]
[254.048646, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[254.048705, "o", "\u001b[?2004h> "]
[254.048913, "o", "    def __init__(self, path: str):\r\n\u001b[?2004l\r"]
[254.048973, "o", "\u001b[?2004h> "]
[254.049131, "o", "        self._path = path\r\n\u001b[?2004l\r"]
[254.049197, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[254.049258, "o", "\u001b[?2004h> "]
[254.04947, "o", "    def list_parts(self) -> list[str]:\r\n\u001b[?2004l\r"]
[254.049534, "o", "\u001b[?2004h> "]
[254.049694, "o", "        return [\"singleton\"]\r\n\u001b[?2004l\r"]
[254.049758, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[254.049817, "o", "\u001b[?2004h> "]
[254.049922, "o", "    def build_part(\r\n\u001b[?2004l\r"]
[254.049981, "o", "\u001b[?2004h> "]
[254.050073, "o", "        self,\r\n\u001b[?2004l\r"]
[254.050135, "o", "\u001b[?2004h> "]
[254.050287, "o", "        step_id: str,\r\n\u001b[?2004l\r"]
[254.050341, "o", "\u001b[?2004h> "]
[254.050484, "o", "        for_part: str,\r\n\u001b[?2004l\r"]
[254.050546, "o", "\u001b[?2004h> "]
[254.050765, "o", "        resume_state: Optional[int],\r\n\u001b[?2004l\r"]
[254.050823, "o", "\u001b[?2004h> "]
[254.051098, "o", "    ) -> StatefulSourcePartition[dict, int]:\r\n\u001b[?2004l\r"]
[254.051168, "o", "\u001b[?2004h> "]
[254.051526, "o", "        return _JSONLinesPartition(self._path, resume_state)\r\n\u001b[?2004l\r"]
[254.051588, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[254.051646, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[254.051715, "o", "\u001b[?2004h> "]
[254.052099, "o", "class _JSONLinesPartition(StatefulSourcePartition[dict, int]):\r\n\u001b[?2004l\r"]
[254.052162, "o", "\u001b[?2004h> "]
[254.052544, "o", "    def __init__(self, path: str, start_offset: Optional[int]):\r\n\u001b[?2004l\r"]
[254.052607, "o", "\u001b[?2004h> "]
[254.052764, "o", "        self._path = path\r\n\u001b[?2004l\r"]
[254.052821, "o", "\u001b[?2004h> "]
[254.053276, "o", "        self._offset = start_offset if start_offset is not None else 0\r\n\u001b[?2004l\r"]
[254.05334, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[254.053403, "o", "\u001b[?2004h> "]
[254.053686, "o", "    def next_batch(self) -> Iterable[dict]:\r\n\u001b[?2004l\r"]
[254.053745, "o", "\u001b[?2004h> "]
[254.053889, "o", "        batch = []\r\n\u001b[?2004l\r"]
[254.053972, "o", "\u001b[?2004h> "]
[254.054216, "o", "        with open(self._path, \"r\") as f:\r\n\u001b[?2004l\r"]
[254.054302, "o", "\u001b[?2004h> "]
[254.054466, "o", "            f.seek(self._offset)\r\n\u001b[?2004l\r"]
[254.054549, "o", "\u001b[?2004h> "]
[254.054682, "o", "            for line in f:\r\n\u001b[?2004l\r"]
[254.054767, "o", "\u001b[?2004h> "]
[254.05495, "o", "                line = line.strip()\r\n\u001b[?2004l\r"]
[254.055032, "o", "\u001b[?2004h> "]
[254.055186, "o", "                if not line:\r\n\u001b[?2004l\r"]
[254.055269, "o", "\u001b[?2004h> "]
[254.055411, "o", "                    continue\r\n\u001b[?2004l\r"]
[254.055491, "o", "\u001b[?2004h> "]
[254.055809, "o", "                batch.append(json.loads(line))\r\n\u001b[?2004l\r\u001b[?2004h> "]
[254.056126, "o", "            self._offset = f.tell()\r\n\u001b[?2004l\r"]
[254.056213, "o", "\u001b[?2004h> "]
[254.056295, "o", "        if not batch:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[254.056502, "o", "            raise StopIteration()\r\n\u001b[?2004l\r"]
[254.056583, "o", "\u001b[?2004h> "]
[254.05668, "o", "        return batch\r\n\u001b[?2004l\r"]
[254.056763, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[254.056981, "o", "    def snapshot(self) -> int:\r\n\u001b[?2004l\r\u001b[?2004h"]
[254.057083, "o", "> "]
[254.057205, "o", "        return self._offset\r\n\u001b[?2004l\r"]
[254.05729, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[254.057372, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[254.057566, "o", "flow = Dataflow(\"enrichment\")\r\n\u001b[?2004l\r"]
[254.057653, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[254.057968, "o", "# 1) Ingest transactions as a stream of dicts.\r\n\u001b[?2004l\r\u001b[?2004h"]
[254.058055, "o", "> "]
[254.058484, "o", "raw = op.input(\"transactions\", flow, JSONLinesSource(\"transactions.jsonl\"))\r\n\u001b[?2004l\r\u001b[?2004h"]
[254.05856, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[254.059, "o", "# 2) Parse timestamp into a UTC-aware datetime and enrich / filter.\r\n\u001b[?2004l\r\u001b[?2004h"]
[254.059092, "o", "> "]
[254.059379, "o", "def parse_and_enrich(event: dict) -> Optional[tuple]:\r\n\u001b[?2004l\r\u001b[?2004h"]
[254.059453, "o", "> "]
[254.059721, "o", "    product = PRODUCTS.get(event[\"product_id\"])\r\n\u001b[?2004l\r"]
[254.059778, "o", "\u001b[?2004h> "]
[254.059941, "o", "    if product is None:\r\n\u001b[?2004l\r"]
[254.059996, "o", "\u001b[?2004h> "]
[254.060137, "o", "        return None\r\n\u001b[?2004l\r"]
[254.060189, "o", "\u001b[?2004h> "]
[254.06047, "o", "    ts = _parse_timestamp(event[\"timestamp\"])\r\n\u001b[?2004l\r"]
[254.060519, "o", "\u001b[?2004h> "]
[254.060832, "o", "    revenue = product[\"price\"] * event[\"quantity\"]\r\n\u001b[?2004l\r"]
[254.060905, "o", "\u001b[?2004h> "]
[254.061183, "o", "    return (product[\"category\"], revenue, ts)\r\n\u001b[?2004l\r"]
[254.061227, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[254.06132, "o", "\u001b[?2004h> "]
[254.061701, "o", "parsed = op.filter_map(\"parse_and_enrich\", raw, parse_and_enrich)\r\n\u001b[?2004l\r"]
[254.061749, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[254.061834, "o", "\u001b[?2004h> "]
[254.061948, "o", "# 3) Key by category.\r\n\u001b[?2004l\r"]
[254.061991, "o", "\u001b[?2004h> "]
[254.062364, "o", "keyed = op.key_on(\"by_category\", parsed, lambda e: e[0])\r\n\u001b[?2004l\r"]
[254.062408, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[254.062494, "o", "\u001b[?2004h> "]
[254.062944, "o", "# 4) Window with EventClock + 1-minute TumblingWindower aligned to the hour.\r\n\u001b[?2004l\r"]
[254.062991, "o", "\u001b[?2004h> "]
[254.063143, "o", "clock = EventClock(\r\n\u001b[?2004l\r"]
[254.063192, "o", "\u001b[?2004h> "]
[254.06339, "o", "    ts_getter=lambda e: e[2],\r\n\u001b[?2004l\r"]
[254.063438, "o", "\u001b[?2004h> "]
[254.063764, "o", "    wait_for_system_duration=timedelta(seconds=10),\r\n\u001b[?2004l\r"]
[254.063812, "o", "\u001b[?2004h> )\r\n\u001b[?2004l\r"]
[254.063901, "o", "\u001b[?2004h> "]
[254.064289, "o", "align_to = datetime(2026, 1, 1, 0, 0, 0, tzinfo=timezone.utc)\r\n\u001b[?2004l\r"]
[254.064367, "o", "\u001b[?2004h> "]
[254.064774, "o", "windower = TumblingWindower(length=timedelta(minutes=1), align_to=align_to)\r\n\u001b[?2004l\r"]
[254.064829, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[254.06488, "o", "\u001b[?2004h> "]
[254.065025, "o", "windowed = fold_window(\r\n\u001b[?2004l\r"]
[254.065081, "o", "\u001b[?2004h> "]
[254.065256, "o", "    \"revenue_per_category\",\r\n\u001b[?2004l\r"]
[254.065307, "o", "\u001b[?2004h> "]
[254.065379, "o", "    keyed,\r\n\u001b[?2004l\r"]
[254.065433, "o", "\u001b[?2004h> "]
[254.065499, "o", "    clock,\r\n\u001b[?2004l\r"]
[254.065551, "o", "\u001b[?2004h> "]
[254.065637, "o", "    windower,\r\n\u001b[?2004l\r"]
[254.065687, "o", "\u001b[?2004h> "]
[254.065849, "o", "    builder=lambda: 0.0,\r\n\u001b[?2004l\r"]
[254.0659, "o", "\u001b[?2004h> "]
[254.066164, "o", "    folder=lambda acc, x: acc + x[1],\r\n\u001b[?2004l\r"]
[254.066215, "o", "\u001b[?2004h> "]
[254.066401, "o", "    merger=lambda a, b: a + b,\r\n\u001b[?2004l\r"]
[254.066451, "o", "\u001b[?2004h> )\r\n"]
[254.066502, "o", "\u001b[?2004l\r\u001b[?2004h"]
[254.066552, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h"]
[254.066601, "o", "> "]
[254.067012, "o", "# 5) Join the aggregated values (down) with window metadata (meta) to\r\n\u001b[?2004l\r"]
[254.06707, "o", "\u001b[?2004h> "]
[254.067289, "o", "# obtain the window start time.\r\n\u001b[?2004l\r"]
[254.06734, "o", "\u001b[?2004h> "]
[254.067482, "o", "down = windowed.down\r\n\u001b[?2004l\r"]
[254.067532, "o", "\u001b[?2004h> "]
[254.067673, "o", "meta = windowed.meta\r\n\u001b[?2004l\r"]
[254.067724, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[254.067773, "o", "\u001b[?2004h> "]
[254.068079, "o", "joined = op.join(\"join_down_meta\", down, meta)\r\n\u001b[?2004l\r"]
[254.06813, "o", "\u001b[?2004h> "]
[254.068553, "o", "# joined items are ((category, window_id), (value, WindowMetadata))\r\n\u001b[?2004l\r"]
[254.068604, "o", "\u001b[?2004h> "]
[254.068654, "o", "\r\n\u001b[?2004l\r\u001b[?2004h"]
[254.068704, "o", "> "]
[254.068866, "o", "def format_output(item) -> str:\r\n\u001b[?2004l\r"]
[254.068916, "o", "\u001b[?2004h> "]
[254.069182, "o", "    (key, (revenue, window_meta)) = item\r\n\u001b[?2004l\r"]
[254.069233, "o", "\u001b[?2004h> "]
[254.069427, "o", "    category, _window_id = key\r\n\u001b[?2004l\r"]
[254.069477, "o", "\u001b[?2004h> "]
[254.069906, "o", "    window_start = window_meta.open_time.astimezone(timezone.utc)\r\n\u001b[?2004l\r"]
[254.069959, "o", "\u001b[?2004h> "]
[254.070401, "o", "    window_start_str = window_start.strftime(\"%Y-%m-%dT%H:%M:%S+00:00\")\r\n\u001b[?2004l\r"]
[254.070451, "o", "\u001b[?2004h> "]
[254.07059, "o", "    return json.dumps(\r\n\u001b[?2004l\r"]
[254.07064, "o", "\u001b[?2004h> "]
[254.070714, "o", "        {\r\n\u001b[?2004l\r"]
[254.070765, "o", "\u001b[?2004h> "]
[254.070969, "o", "            \"category\": category,\r\n\u001b[?2004l\r"]
[254.071019, "o", "\u001b[?2004h> "]
[254.071323, "o", "            \"window_start\": window_start_str,\r\n\u001b[?2004l\r"]
[254.071374, "o", "\u001b[?2004h> "]
[254.071568, "o", "            \"revenue\": revenue,\r\n\u001b[?2004l\r"]
[254.071617, "o", "\u001b[?2004h> "]
[254.071686, "o", "        }\r\n\u001b[?2004l\r"]
[254.071737, "o", "\u001b[?2004h> "]
[254.071787, "o", "    )\r\n\u001b[?2004l\r"]
[254.071837, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[254.071887, "o", "\u001b[?2004h> "]
[254.07228, "o", "formatted = op.map(\"format_output\", joined, format_output)\r\n\u001b[?2004l\r"]
[254.072331, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[254.072378, "o", "\u001b[?2004h> "]
[254.072544, "o", "# 6) Write to stdout.\r\n\u001b[?2004l\r"]
[254.072595, "o", "\u001b[?2004h> "]
[254.072874, "o", "op.output(\"stdout\", formatted, StdOutSink())\r\n\u001b[?2004l\r"]
[254.072925, "o", "\u001b[?2004h> "]
[254.072974, "o", "PYEOF\r\n\u001b[?2004l\r"]
