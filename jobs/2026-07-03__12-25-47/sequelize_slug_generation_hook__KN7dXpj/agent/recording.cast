[88.799797, "o", "drwxr-xr-x   1 root root    83 Jul  3 13:50 \u001b[0m\u001b[01;34m.\u001b[0m\r\ndrwxr-xr-x   1 root root    31 Jul  3 13:48 \u001b[01;34m..\u001b[0m\r\n-rw-r--r--   1 root root  1915 Jul  3 13:49 index.js\r\ndrwxr-xr-x 196 root root  8192 Jul  3 13:49 \u001b[01;34mnode_modules\u001b[0m\r\n-rw-r--r--   1 root root 91218 Jul  3 13:49 package-lock.json\r\n-rw-r--r--   1 root root   254 Jul  3 13:48 package.json\r\n"]
[88.800217, "o", "\u001b[?2004hroot@93695a69-7bcd-4918-b77c-6c2882614813:/home/user/myproject# "]
