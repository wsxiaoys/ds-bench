[410.792305, "o", "Password        string `json:\"password\"`\r\n\u001b[?2004l\r\u001b[?2004h"]
[410.792393, "o", "> "]
[410.792504, "o", "PasswordConfirm string `json:\"passwordConfirm\"`\r\n\u001b[?2004l\r\u001b[?2004h> }\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[410.792596, "o", "payload := &signupPayload{}\r\n\u001b[?2004l\r\u001b[?2004h> "]
[410.792722, "o", "if err := e.BindBody(payload); err != nil {\r\n\u001b[?2004l\r\u001b[?2004h"]
[410.792754, "o", "> "]
[410.792895, "o", "return e.BadRequestError(\"Failed to bind request body.\", err)\r\n\u001b[?2004l\r\u001b[?2004h"]
[410.792928, "o", "> }\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[410.792955, "o", "\u001b[?2004h> "]
[410.793182, "o", "if payload.Email == \"\" || payload.Password == \"\" || payload.PasswordConfirm == \"\" {\r\n\u001b[?2004l\r\u001b[?2004h"]
[410.793212, "o", "> "]
[410.793416, "o", "return e.BadRequestError(\"email, password and passwordConfirm are required.\", nil)\r\n\u001b[?2004l\r\u001b[?2004h"]
[410.793447, "o", "> }\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[410.793477, "o", "\u001b[?2004h> "]
[410.793613, "o", "if payload.Password != payload.PasswordConfirm {\r\n\u001b[?2004l\r\u001b[?2004h"]
[410.793644, "o", "> "]
[410.793826, "o", "return e.BadRequestError(\"Password and passwordConfirm do not match.\", nil)\r\n\u001b[?2004l\r\u001b[?2004h"]
[410.793921, "o", "> }\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[410.794046, "o", "collection, err := e.App.FindCollectionByNameOrId(\"users\")\r\n\u001b[?2004l\r\u001b[?2004h"]
[410.794077, "o", "> "]
[410.794107, "o", "if err != nil {\r\n\u001b[?2004l\r\u001b[?2004h"]
[410.794135, "o", "> "]
[410.794318, "o", "return e.InternalServerError(\"Failed to load users collection.\", err)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[410.79435, "o", "}\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[410.794378, "o", "\u001b[?2004h> "]
[410.794523, "o", "record := core.NewRecord(collection)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[410.794599, "o", "record.Set(\"email\", payload.Email)\r\n\u001b[?2004l\r\u001b[?2004h"]
[410.794643, "o", "> "]
[410.794728, "o", "record.Set(\"password\", payload.Password)\r\n\u001b[?2004l\r"]
[410.794802, "o", "\u001b[?2004h> "]
[410.794878, "o", "record.Set(\"passwordConfirm\", payload.PasswordConfirm)\r\n\u001b[?2004l\r\u001b[?2004h"]
[410.794907, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[410.795051, "o", "if err := e.App.Save(record); err != nil {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[410.795201, "o", "return e.BadRequestError(\"Failed to create user.\", err)\r\n\u001b[?2004l\r\u001b[?2004h"]
[410.795234, "o", "> }\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[410.795323, "o", "\u001b[?2004h> "]
[410.795408, "o", "return e.JSON(http.StatusOK, map[string]any{\r\n\u001b[?2004l\r\u001b[?2004h> "]
[410.795505, "o", "\"id\":    record.Id,\r\n\u001b[?2004l\r\u001b[?2004h> "]
[410.795582, "o", "\"email\": record.Get(\"email\"),\r\n\u001b[?2004l\r\u001b[?2004h"]
[410.795665, "o", "> })\r\n\u001b[?2004l\r\u001b[?2004h> }\r\n\u001b[?2004l\r\u001b[?2004h> EOF\r\n\u001b[?2004l\r"]
