[68.698613, "o", "\u001b[32m\u001b[K17\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[01;31m\u001b[Kfunc \u001b[m\u001b[KrecordAuthWithPassword(e *core.RequestEvent) error {\r\n\u001b[32m\u001b[K111\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[01;31m\u001b[Kfunc \u001b[m\u001b[K(form *authWithPasswordForm) validate(collection *core.Collection) error {\r\n\u001b[32m\u001b[K125\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[01;31m\u001b[Kfunc \u001b[m\u001b[KdummyPasswordCheck(app core.App, collection *core.Collection) {\r\n\u001b[32m\u001b[K138\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[01;31m\u001b[Kfunc \u001b[m\u001b[KfindRecordByIdentityField(app core.App, collection *core.Collection, field string, value any) (*core.Record, error) {\r\n"]
