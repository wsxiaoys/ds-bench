[53.291883, "o", "/root/go/pkg/mod/github.com/pocketbase/pocketbase@v0.39.5/core/settings_model.go:613:// FindRateLimitRule returns the first matching rule based on the provided labels.\r\n/root/go/pkg/mod/github.com/pocketbase/pocketbase@v0.39.5/core/settings_model.go:615:// Optionally you can further specify a list of valid RateLimitRule.Audience values to further filter the matching rule\r\n/root/go/pkg/mod/github.com/pocketbase/pocketbase@v0.39.5/core/settings_model.go:617:func (c *RateLimitsConfig) FindRateLimitRule(searchLabels []string, optOnlyAudience ...string) (RateLimitRule, bool) {\r\n/root/go/pkg/mod/github.com/pocketbase/pocketbase@v0.39.5/core/settings_model.go:644:\treturn RateLimitRule{}, false\r\n/root/go/pkg/mod/github.com/pocketbase/pocketbase@v0.39.5/core/settings_model.go:648:func (c RateLimitsConfig) MarshalJSON() ([]byte, error) {\r\n/root/go/pkg/mod/github.com/pocketbase/pocketbase@v0.39.5/core/settings_model.go:649:\ttype alias RateLimitsConfig\r\n/root/go/pkg/mod/github.com/pocketbase/pocketbase@v0.39.5/core/settings_model.go:653:\t\tc.Rules = []RateLimitRule{}\r\n/root/go/pkg/mod/github.com/pocketbase/pocketbase@v0.39.5/core/settings_model.go:662:// Validate makes RateLimitsConfig validatable by implementing [validation.Validatable] interface.\r\n/root/go/pkg/mod/github.com/pocketbase/pocketbase@v0.39.5/core/settings_model.go:663:func (c RateLimitsConfig) Validate() error {\r\n/root/go/pkg/mod/github.com/pocketbase/pocketbase@v0.39.5/core/settings_model.go:678:\trules, ok := value.([]RateLimitRule)\r\n/root/go/pkg/mod/github.com/pocketbase/pocketbase@v0.39.5/core/settings_model.go:713:// The allowed RateLimitRule.Audience values\r\n/root/go/pkg/mod/github.com/pocketbase/pocketbase@v0.39.5/core/settings_model.go:715:\tRateLimitRuleAudienceAll   = \"\"\r\n/root/go/pkg/mod/github.com/pocketbase/pocketbase@v0.39.5/core/settings_model.go:716:\t"]
[53.291931, "o", "RateLimitRuleAudienceGuest = \"@guest\"\r\n/root/go/pkg/mod/github.com/pocketbase/pocketbase@v0.39.5/core/settings_model.go:717:\tRateLimitRuleAudienceAuth  = \"@auth\"\r\n/root/go/pkg/mod/github.com/pocketbase/pocketbase@v0.39.5/core/settings_model.go:720:type RateLimitRule struct {\r\n/root/go/pkg/mod/github.com/pocketbase/pocketbase@v0.39.5/core/settings_model.go:748:// Validate makes RateLimitRule validatable by implementing [validation.Validatable] interface.\r\n/root/go/pkg/mod/github.com/pocketbase/pocketbase@v0.39.5/core/settings_model.go:749:func (c RateLimitRule) Validate() error {\r\n/root/go/pkg/mod/github.com/pocketbase/pocketbase@v0.39.5/core/settings_model.go:755:\t\t\tvalidation.In(RateLimitRuleAudienceAll, RateLimitRuleAudienceGuest, RateLimitRuleAudienceAuth),\r\n/root/go/pkg/mod/github.com/pocketbase/pocketbase@v0.39.5/core/settings_model.go:761:func (c RateLimitRule) DurationTime() time.Duration {\r\n/root/go/pkg/mod/github.com/pocketbase/pocketbase@v0.39.5/core/settings_model.go:766:func (c RateLimitRule) String() string {\r\n/root/go/pkg/mod/git"]
