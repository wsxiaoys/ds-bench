[75.289103, "i", "python3 -c \"import json; data=json.load(open('/home/user/chords.json')); print(f'Segments: {len(data)}'); print(f'First: {data[0]}'); print(f'Last: {data[-1]}'); print(f'All start < end: {all(s[\\\"start\\\"] < s[\\\"end\\\"] for s in data)}'); print(f'Sorted: {data == sorted(data, key=lambda x: x[\\\"start\\\"])}'); labels=set(s['chord'] for s in data); print(f'Distinct labels: {len(labels)}'); print(f'All duration > 0.1: {all(s[\\\"end\\\"] - s[\\\"start\\\"] > 0.1 for s in data)}'); allowed={'C:maj','C#:maj','D:maj','D#:maj','E:maj','F:maj','F#:maj','G:maj','G#:maj','A:maj','A#:maj','B:maj','C:min','C#:min','D:min','D#:min','E:min','F:min','F#:min','G:min','G#:min','A:min','A#:min','B:min'}; print(f'All labels allowed: {labels.issubset(allowed)}'); print(f'Last end matches duration: {data[-1][\\\"end\\\"]}')\"\n"]
[75.291338, "o", "python3 -c \"import json; data=json.load(open('/home/user/chords.json')); print(f'Segments: {len(data)}'); print(f'First: {data[0]}'); print(f'Last: {data[-1]}'); print(f'All start < end: {all(s[\\\"start\\\"] < s[\\\"end\\\"] for s in data)}'); print(f'Sorted: {data == sorted(data, key=lambda x: x[\\\"start\\\"])}'); labels=set(s['chord'] for s in data); print(f'Distinct labels: {len(labels)}'); print(f'All duration > 0.1: {all(s[\\\"end\\\"] - s[\\\"start\\\"] > 0.1 for s in data)}'); allowed={'C:maj','C#:maj','D:maj','D#:maj','E:maj','F:maj','F#:maj','G:maj','G#:maj','A:maj','A#:maj','B:maj','C:min','C#:min','D:min','D#:min','E:min','F:min','F#:min','G:min','G#:min','A:min','A#:min','B:min'}; print(f'All labels allowed: {labels.issubset(allowed)}'); print(f'Last end matches duration: {data[-1][\\\"end\\\"]}')\"\r\n\u001b[?2004l\r"]
