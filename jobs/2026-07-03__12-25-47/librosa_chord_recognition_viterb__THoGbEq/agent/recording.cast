[86.47854, "i", "python3 << 'EOF'\nimport json\n\nwith open('/home/user/chords.json') as f:\n    data = json.load(f)\n\n# Verify schema and constraints\nallowed = {'C:maj','C#:maj','D:maj','D#:maj','E:maj','F:maj','F#:maj','G:maj','G#:maj','A:maj','A#:maj','B:maj','C:min','C#:min','D:min','D#:min','E:min','F:min','F#:min','G:min','G#:min','A:min','A#:min','B:min'}\n\nassert isinstance(data, list), \"Must be a list\"\nfor s in data:\n    assert set(s.keys()) == {'start', 'end', 'chord'}, f\"Bad keys: {s.keys()}\"\n    assert isinstance(s['start'], float), f\"start not float: {s['start']}\"\n    assert isinstance(s['end'], float), f\"end not float: {s['end']}\"\n    assert s['start'] < s['end'], f\"start >= end: {s}\"\n    assert s['chord'] in allowed, f\"Bad chord label: {s['chord']}\"\n    assert s['end'] - s['start'] > 0.1, f\"Segment too short: {s}\"\n\n# Check chronological sort\nfor i in range(1, len(data)):\n    assert data[i-1]['end'] <= data[i]['start'] + 1e-9, f\"Gap or overlap at index {i}\"\n    assert data[i-1]['start'] <= data[i]['start'], f\"Not sorted at index {i}\"\n\nlabels = set(s['chord'] for s in data)\nassert len(labels) >= 2, f\"Need at least 2 distinct chords, got {len(labels)}\"\n\nprint(f\"All checks pass! {len(data)} segments, {len(labels)} distinct chords\")\nprint(f\"Covers: [{data[0]['start']}, {data[-1]['end']}]\")\nEOF\n"]
[86.478766, "o", "python3 << 'EOF'\r\n\u001b[?2004l\r"]
[86.478812, "o", "\u001b[?2004h> "]
[86.478853, "o", "import json\r\n\u001b[?2004l\r"]
[86.478886, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[86.478917, "o", "> "]
[86.479013, "o", "with open('/home/user/chords.json') as f:\r\n\u001b[?2004l\r"]
[86.479047, "o", "\u001b[?2004h> "]
[86.479181, "o", "    data = json.load(f)\r\n\u001b[?2004l\r"]
[86.479213, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[86.479312, "o", "# Verify schema and constraints\r\n\u001b[?2004l\r"]
[86.479336, "o", "\u001b[?2004h> "]
[86.4799, "o", "allowed = {'C:maj','C#:maj','D:maj','D#:maj','E:maj','F:maj','F#:maj','G:maj','G#:maj','A:maj','A#:maj','B:maj','C:min','C#:min','D:min','D#:min','E:min','F:min','F#:min','G:min','G#:min','A:min','A#:min','B:min'}\r\n\u001b[?2004l\r\u001b[?2004h"]
[86.479924, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h"]
[86.47997, "o", "> "]
[86.480072, "o", "assert isinstance(data, list), \"Must be a list\"\r\n\u001b[?2004l\r"]
[86.480103, "o", "\u001b[?2004h> "]
[86.480138, "o", "for s in data:\r\n\u001b[?2004l\r"]
[86.480168, "o", "\u001b[?2004h> "]
[86.480363, "o", "    assert set(s.keys()) == {'start', 'end', 'chord'}, f\"Bad keys: {s.keys()}\"\r\n\u001b[?2004l\r"]
[86.480402, "o", "\u001b[?2004h> "]
[86.480586, "o", "    assert isinstance(s['start'], float), f\"start not float: {s['start']}\"\r\n\u001b[?2004l\r\u001b[?2004h"]
[86.480617, "o", "> "]
[86.480786, "o", "    assert isinstance(s['end'], float), f\"end not float: {s['end']}\"\r\n\u001b[?2004l\r\u001b[?2004h"]
[86.480818, "o", "> "]
[86.480948, "o", "    assert s['start'] < s['end'], f\"start >= end: {s}\"\r\n\u001b[?2004l\r"]
[86.48098, "o", "\u001b[?2004h> "]
[86.481142, "o", "    assert s['chord'] in allowed, f\"Bad chord label: {s['chord']}\"\r\n\u001b[?2004l\r"]
[86.481173, "o", "\u001b[?2004h> "]
[86.481333, "o", "    assert s['end'] - s['start'] > 0.1, f\"Segment too short: {s}\"\r\n\u001b[?2004l\r"]
[86.481365, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[86.481409, "o", "> "]
[86.481468, "o", "# Check chronological sort\r\n\u001b[?2004l\r"]
[86.481499, "o", "\u001b[?2004h> "]
[86.481576, "o", "for i in range(1, len(data)):\r\n\u001b[?2004l\r"]
[86.481608, "o", "\u001b[?2004h> "]
[86.481821, "o", "    assert data[i-1]['end'] <= data[i]['start'] + 1e-9, f\"Gap or overlap at index {i}\"\r\n\u001b[?2004l\r"]
[86.481852, "o", "\u001b[?2004h> "]
[86.482046, "o", "    assert data[i-1]['start'] <= data[i]['start'], f\"Not sorted at index {i}\"\r\n\u001b[?2004l\r"]
[86.482078, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[86.482108, "o", "\u001b[?2004h> "]
[86.482201, "o", "labels = set(s['chord'] for s in data)\r\n\u001b[?2004l\r"]
[86.482233, "o", "\u001b[?2004h> "]
[86.482433, "o", "assert len(labels) >= 2, f\"Need at least 2 distinct chords, got {len(labels)}\"\r\n\u001b[?2004l\r\u001b[?2004h"]
[86.482465, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h"]
[86.482497, "o", "> "]
[86.482685, "o", "print(f\"All checks pass! {len(data)} segments, {len(labels)} distinct chords\")\r\n\u001b[?2004l\r"]
[86.482716, "o", "\u001b[?2004h> "]
[86.482865, "o", "print(f\"Covers: [{data[0]['start']}, {data[-1]['end']}]\")\r\n\u001b[?2004l\r"]
[86.482897, "o", "\u001b[?2004h> EOF\r\n\u001b[?2004l\r"]
[86.498308, "o", "All checks pass! 93 segments, 17 distinct chords\r\nCovers: [0.0, 119.87591836734694]\r\n"]
