[?2004lconst express = require('express');
const { PrismaClient } = require('@prisma/client');

const app = express();
app.use(express.json());

const prisma = new PrismaClient();

app.get('/items', async (req, res) => {
  const tenantId = req.header('x-tenant-id');
  if (!tenantId) {
    return res.status(400).json({ error: 'x-tenant-id header is required' });
  }

  // Create a scoped client per request that enforces tenantId
  const tenantPrisma = prisma.$extends({
    query: {
      item: {
        $allOperations({ args, query, operation }) {
          // Only filter when an item model is involved
          const filteredArgs = { ...args };
          if (filteredArgs.where) {
            filteredArgs.where = { ...filteredArgs.where, tenantId };
          } else {
            filteredArgs.where = { tenantId };
          }
          return query(filteredArgs);
        },
      },
    },
  });

  try {
    const items = await tenantPrisma.item.findMany();
    res.json(items);
  } catch (err) {
    res.status(500).json({ error: err.message });
  }
});

app.post('/items', async (req, res) => {
  const tenantId = req.header('x-tenant-id');
  if (!tenantId) {
    return res.status(400).json({ error: 'x-tenant-id header is required' });
  }
  const { name } = req.body || {};
  if (!name) {
    return res.status(400).json({ error: 'name is required' });
  }

  // Create a scoped client per request
  const tenantPrisma = prisma.$extends({
    query: {
      item: {
        $allOperations({ args, query, operation }) {
          const filteredArgs = { ...args };
          if (filteredArgs.where) {
            filteredArgs.where = { ...filteredArgs.where, tenantId };
          } else {
            filteredArgs.where = { tenantId };
          }
          return query(filteredArgs);
        },
      },
    },
  });

  try {
    const item = await tenantPrisma.item.create({
      data: { name, tenantId },
    });
    res.json(item);
  } catch (err) {
    res.status(500).json({ error: err.message });
  }
});

const PORT = 3000;
app.listen(PORT, () => {
  console.log(`Server listening on port ${PORT}`);
});
