'05756112-b8f5-430b-a8d1-58549d56dd7d',\r\n    'x-session-id': '4d6f5b10-9f36-497b-bbcd-dde3eb517929'\r\n  },\r\n  error: {\r\n    detail: `Failed to upload file: (sqlalchemy.dialects.postgresql.asyncpg.IntegrityError) <class 'asyncpg.exceptions.UniqueViolationError'>: duplicate key value violates unique constraint \"project_ds_external_id_uc\"\\n` +\r\n      'DETAIL:  Key (project_id, data_source_id, external_file_id)=(b420cea9-2ed0-451d-8ebc-617151ec45f6, null, zrurq3cihz-acme_invoice) already exists.\\n' +\r\n      '[SQL: INSERT INTO file (name, file_size, last_modified_at, resource_info, permission_info, storage_metadata, expires_at, external_file_id, data_source_id, id, project_id) VALUES ($1::VARCHAR, $2::INTEGER, $3::TIMESTAMP WITHOUT TIME ZONE, $4::JSONB, $5::JSONB, $6::JSONB, $7::TIMESTAMP WITH TIME ZONE, $8::VARCHAR, $9::UUID, uuid_generate_v4(), $10::UUID) RETURNING file.id, file.created_at, file.updated_at]\\n' +\r\n      `[parameters: ('acme_invoice.pdf', 2561, None, 'null', 'null', '{\"purpose\": \"extract\"}', datetime.datetime(2026, 7, 5, 13, 46, 37, 548996, tzinfo=datetime.timezone.utc), 'zrurq3cihz-acme_invoice', None, UUID('b420cea9-2ed0-451d-8ebc-617151ec45f6'))]\\n` +\r\n      '(Background on this error at: https://sqlalche.me/e/20/gkpj)'\r\n  }\r\n}\r\n"]
