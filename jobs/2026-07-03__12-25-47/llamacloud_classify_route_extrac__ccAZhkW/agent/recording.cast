[187.490474, "o", "import fs from 'node:fs';\r\n\u001b[?2004l\r"]
[187.490498, "o", "\u001b[?2004h> "]
[187.490608, "o", "import path from 'node:path';\r\n\u001b[?2004l\r\u001b[?2004h"]
[187.490655, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[187.490751, "o", "// ---------- Schemas ----------\r\n\u001b[?2004l\r"]
[187.490777, "o", "\u001b[?2004h> "]
[187.490882, "o", "const lineItemSchema = z.object({\r\n\u001b[?2004l\r"]
[187.490925, "o", "\u001b[?2004h> "]
[187.491001, "o", "  description: z.string(),\r\n\u001b[?2004l\r"]
[187.491024, "o", "\u001b[?2004h> "]
[187.491104, "o", "  quantity: z.number(),\r\n\u001b[?2004l\r"]
[187.49115, "o", "\u001b[?2004h> "]
[187.491211, "o", "  unit_price: z.number(),\r\n\u001b[?2004l\r"]
[187.491255, "o", "\u001b[?2004h> "]
[187.491306, "o", "  total: z.number(),\r\n\u001b[?2004l\r\u001b[?2004h"]
[187.491349, "o", "> });\r\n\u001b[?2004l\r\u001b[?2004h"]
[187.491371, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h"]
[187.491446, "o", "> "]
[187.491518, "o", "const invoiceSchema = z.object({\r\n\u001b[?2004l\r\u001b[?2004h"]
[187.491543, "o", "> "]
[187.491638, "o", "  invoice_number: z.string(),\r\n\u001b[?2004l\r"]
[187.491687, "o", "\u001b[?2004h> "]
[187.491747, "o", "  vendor_name: z.string(),\r\n\u001b[?2004l\r\u001b[?2004h"]
[187.491791, "o", "> "]
[187.491857, "o", "  total_amount: z.number(),\r\n\u001b[?2004l\r"]
[187.491902, "o", "\u001b[?2004h> "]
[187.492005, "o", "  line_items: z.array(lineItemSchema),\r\n\u001b[?2004l\r"]
[187.492042, "o", "\u001b[?2004h> });\r\n\u001b[?2004l\r"]
[187.492078, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[187.492204, "o", "const contractSchema = z.object({\r\n\u001b[?2004l\r"]
[187.49223, "o", "\u001b[?2004h> "]
[187.492354, "o", "  parties: z.array(z.string()).min(2),\r\n\u001b[?2004l\r"]
[187.492394, "o", "\u001b[?2004h> "]
[187.492495, "o", "  effective_date: z.string(),\r\n\u001b[?2004l\r"]
[187.492522, "o", "\u001b[?2004h> "]
[187.492585, "o", "  term: z.string(),\r\n\u001b[?2004l\r"]
[187.492623, "o", "\u001b[?2004h> });\r\n\u001b[?2004l\r\u001b[?2004h"]
[187.492659, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[187.492771, "o", "// ---------- Helpers ----------\r\n\u001b[?2004l\r"]
[187.492808, "o", "\u001b[?2004h> "]
[187.492888, "o", "function readRunId(): string {\r\n\u001b[?2004l\r"]
[187.49294, "o", "\u001b[?2004h> "]
[187.493136, "o", "  return fs.readFileSync('/logs/artifacts/run-id', 'utf8').trim();\r\n\u001b[?2004l\r\u001b[?2004h"]
[187.493208, "o", "> }\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[187.493265, "o", "\u001b[?2004h> "]
[187.493432, "o", "function stripMeta<T extends Record<string, any>>(obj: T): T {\r\n\u001b[?2004l\r"]
[187.493463, "o", "\u001b[?2004h> "]
[187.493816, "o", "  // zodToJsonSchema can include $schema; strip any keys starting with $ (LLM extractors don't need them).\r\n\u001b[?2004l\r"]
[187.493847, "o", "\u001b[?2004h> "]
[187.493974, "o", "  const out: Record<string, any> = {};\r\n\u001b[?2004l\r"]
[187.494009, "o", "\u001b[?2004h> "]
[187.494159, "o", "  for (const [k, v] of Object.entries(obj)) {\r\n\u001b[?2004l\r"]
[187.494186, "o", "\u001b[?2004h> "]
[187.494313, "o", "    if (k.startsWith('$')) continue;\r\n\u001b[?2004l\r"]
[187.49436, "o", "\u001b[?2004h> "]
[187.494407, "o", "    out[k] = v;\r\n\u001b[?2004l\r"]
[187.494436, "o", "\u001b[?2004h> "]
[187.494463, "o", "  }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[187.494546, "o", "  return out as T;\r\n\u001b[?2004l\r"]
[187.494572, "o", "\u001b[?2004h> }\r\n\u001b[?2004l\r"]
[187.494601, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[187.494625, "o", "\u001b[?2004h> "]
[187.494829, "o", "async function pollUntilDone<T extends { status: string }>(\r\n\u001b[?2004l\r"]
[187.494879, "o", "\u001b[?2004h> "]
[187.494946, "o", "  get: () => Promise<T>,\r\n\u001b[?2004l\r"]
[187.494992, "o", "\u001b[?2004h> "]
[187.495084, "o", "  isDone: (r: T) => boolean,\r\n\u001b[?2004l\r"]
[187.49511, "o", "\u001b[?2004h> "]
[187.495319, "o", "  { intervalMs = 2000, timeoutMs = 10 * 60 * 1000 } = {},\r\n\u001b[?2004l\r"]
[187.495366, "o", "\u001b[?2004h> "]
[187.495396, "o", "): Promise<T> {\r\n\u001b[?2004l\r"]
[187.495422, "o", "\u001b[?2004h> "]
[187.495511, "o", "  const start = Date.now();\r\n\u001b[?2004l\r"]
[187.495536, "o", "\u001b[?2004h> "]
[187.495587, "o", "  while (true) {\r\n\u001b[?2004l\r\u001b[?2004h"]
[187.495633, "o", "> "]
[187.495689, "o", "    const r = await get();\r\n\u001b[?2004l\r"]
[187.495715, "o", "\u001b[?2004h> "]
[187.495809, "o", "    if (isDone(r)) return r;\r\n\u001b[?2004l\r"]
[187.495833, "o", "\u001b[?2004h> "]
[187.496, "o", "    if (['FAILED', 'CANCELLED'].includes(r.status)) {\r\n\u001b[?2004l\r"]
[187.496038, "o", "\u001b[?2004h> "]
[187.496209, "o", "      throw new Error(`Job ended with status ${r.status}`);\r\n\u001b[?2004l\r"]
[187.496233, "o", "\u001b[?2004h> "]
[187.49626, "o", "    }\r\n\u001b[?2004l\r\u001b[?2004h"]
[187.496318, "o", "> "]
[187.496439, "o", "    if (Date.now() - start > timeoutMs) {\r\n\u001b[?2004l\r"]
[187.496481, "o", "\u001b[?2004h> "]
[187.496662, "o", "      throw new Error('Timed out waiting for job');\r\n\u001b[?2004l\r"]
[187.496713, "o", "\u001b[?2004h> "]
[187.496766, "o", "    }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[187.49696, "o", "    await new Promise((r) => setTimeout(r, intervalMs));\r\n\u001b[?2004l\r\u001b[?2004h"]
[187.49699, "o", ">   }\r\n\u001b[?2004l\r"]
[187.497018, "o", "\u001b[?2004h> "]
[187.497049, "o", "}\r\n\u001b[?2004l\r\u001b[?2004h"]
[187.497078, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h"]
[187.497106, "o", "> "]
[187.497228, "o", "// ---------- Main ----------\r\n\u001b[?2004l\r\u001b[?2004h"]
[187.497257, "o", "> "]
[187.497342, "o", "async function main() {\r\n\u001b[?2004l\r"]
[187.497372, "o", "\u001b[?2004h> "]
[187.497516, "o", "  const runId = readRunId();\r\n\u001b[?2004l\r\u001b[?2004h"]
[187.497553, "o", "> "]
[187.497701, "o", "  console.log(`[run] run-id=${runId}`);\r\n\u001b[?2004l\r"]
[187.497745, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[187.497783, "o", "> "]
[187.497933, "o", "  const inputsDir = path.resolve('./inputs');\r\n\u001b[?2004l\r"]
[187.497963, "o", "\u001b[?2004h> "]
[187.498139, "o", "  const outputsDir = path.resolve('./outputs');\r\n\u001b[?2004l\r"]
[187.498188, "o", "\u001b[?2004h> "]
[187.498341, "o", "  fs.mkdirSync(outputsDir, { recursive: true });\r\n\u001b[?2004l\r"]
[187.498373, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[187.49841, "o", "\u001b[?2004h> "]
[187.49852, "o", "  const basenames = fs\r\n\u001b[?2004l\r\u001b[?2004h"]
[187.498578, "o", "> "]
[187.498676, "o", "    .readdirSync(inputsDir)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[187.498861, "o", "    .filter((f) => f.toLowerCase().endsWith('.pdf'))\r\n\u001b[?2004l\r\u001b[?2004h"]
[187.498911, "o", ">     .sort();"]
[187.498974, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[187.499124, "o", "  const client = new LlamaCloud();\r\n\u001b[?2004l\r"]
[187.499165, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[187.499321, "o", "  // ---- Phase 0: Upload files ----\r\n\u001b[?2004l\r\u001b[?2004h"]
[187.499352, "o", "> "]
[187.499584, "o", "  type Uploaded = { basename: string; fileId: string };\r\n\u001b[?2004l\r\u001b[?2004h"]
[187.499616, "o", "> "]
[187.499754, "o", "  const uploaded: Uploaded[] = [];\r\n\u001b[?2004l\r"]
[187.499793, "o", "\u001b[?2004h> "]
[187.499939, "o", "  for (const basename of basenames) {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[187.500131, "o", "    const fullPath = path.join(inputsDir, basename);\r\n\u001b[?2004l\r\u001b[?2004h"]
[187.500194, "o", "> "]
[187.500309, "o", "    const stem = basename.replace(/\\.[^.]+$/, '');\r\n\u001b[?2004l\r"]
[187.500362, "o", "\u001b[?2004h> "]
[187.500472, "o", "    const externalFileId = `${runId}-${stem}`;\r\n\u001b[?2004l\r\u001b[?2004h"]
[187.500526, "o", "> "]
[187.500703, "o", "    console.log(`[upload] ${basename} (external_file_id=${externalFileId})`);\r\n\u001b[?2004l\r"]
[187.500738, "o", "\u001b[?2004h> "]
[187.500861, "o", "    const file = await client.files.create({\r\n\u001b[?2004l\r"]
[187.500896, "o", "\u001b[?2004h> "]
[187.501007, "o", "      file: fs.createReadStream(fullPath),\r\n\u001b[?2004l\r"]
[187.501042, "o", "\u001b[?2004h> "]
[187.501113, "o", "      purpose: 'extract',\r\n\u001b[?2004l\r"]
[187.501148, "o", "\u001b[?2004h> "]
[187.501251, "o", "      external_fileId: externalFileId,\r\n\u001b[?2004l\r"]
[187.501285, "o", "\u001b[?2004h> "]
[187.501351, "o", "    } as any);\r\n\u001b[?2004l\r\u001b[?2004h> "]
[187.501497, "o", "    uploaded.push({ basename, fileId: file.id });\r\n\u001b[?2004l\r"]
[187.501527, "o", "\u001b[?2004h> "]
[187.501646, "o", "    console.log(`[upload] -> ${file.id}`);\r\n\u001b[?2004l\r"]
[187.501677, "o", "\u001b[?2004h>   }\r\n\u001b[?2004l\r"]
[187.50174, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[187.501837, "o", "  // ---- Phase 1: Classify ----\r\n\u001b[?2004l\r"]
[187.501871, "o", "\u001b[?2004h> "]
[187.502007, "o", "  const fileIds = uploaded.map((u) => u.fileId);\r\n\u001b[?2004l\r"]
[187.502048, "o", "\u001b[?2004h> "]
[187.502226, "o", "  console.log(`[classify] starting for ${fileIds.length} files`);\r\n\u001b[?2004l\r"]
[187.502277, "o", "\u001b[?2004h> "]
[187.502429, "o", "  const classifyResult = await client.classifier.classify({\r\n\u001b[?2004l\r"]
[187.502465, "o", "\u001b[?2004h> "]
[187.50253, "o", "    file_ids: fileIds,\r\n\u001b[?2004l\r"]
[187.502565, "o", "\u001b[?2004h> "]
[187.502603, "o", "    rules: [\r\n\u001b[?2004l\r\u001b[?2004h"]
[187.502681, "o", ">       {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[187.50275, "o", "        type: 'invoice',\r\n\u001b[?2004l\r"]
[187.502785, "o", "\u001b[?2004h> "]
[187.502845, "o", "        description:\r\n\u001b[?2004l\r"]
[187.50288, "o", "\u001b[?2004h> "]
[187.50335, "o", "          'A commercial invoice issued by a vendor to a buyer. It must include an invoice number, line items (description, quantity, unit price, total), and a grand total amount.',\r\n\u001b[?2004l\r"]
[187.503393, "o", "\u001b[?2004h> "]
[187.503461, "o", "      },\r\n\u001b[?2004l\r\u001b[?2004h>       {\r\n"]
[187.503498, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[187.503577, "o", "        type: 'contract',\r\n\u001b[?2004l\r"]
[187.503612, "o", "\u001b[?2004h> "]
[187.503669, "o", "        description:\r\n\u001b[?2004l\r"]
[187.503704, "o", "\u001b[?2004h> "]
[187.504115, "o", "          'A legal agreement signed by two or more parties. It must identify the parties and include an effective date and a term/duration (e.g., \"12 months\").',\r\n\u001b[?2004l\r"]
[187.504149, "o", "\u001b[?2004h> "]
[187.504219, "o", "      },\r\n\u001b[?2004l\r\u001b[?2004h>     ],\r\n\u001b[?2004l\r"]
[187.504254, "o", "\u001b[?2004h> "]
[187.504322, "o", "    mode: 'FAST',\r\n\u001b[?2004l\r"]
[187.504356, "o", "\u001b[?2004h>   });\r\n\u001b[?2004l\r"]
[187.504424, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[187.504583, "o", "  // Index results by file_id (order is NOT guaranteed)\r\n\u001b[?2004l\r\u001b[?2004h"]
[187.504613, "o", "> "]
[187.504832, "o", "  const classifyByFileId = new Map<string, { type: string; confidence: number }>();\r\n\u001b[?2004l\r\u001b[?2004h"]
[187.504863, "o", "> "]
[187.504985, "o", "  for (const item of classifyResult.items) {\r\n\u001b[?2004l\r\u001b[?2004h"]
[187.505017, "o", "> "]
[187.505148, "o", "    if (!item.file_id || !item.result) continue;\r\n\u001b[?2004l\r"]
[187.505178, "o", "\u001b[?2004h> "]
[187.50529, "o", "    classifyByFileId.set(item.file_id, {\r\n\u001b[?2004l\r"]
[187.50532, "o", "\u001b[?2004h> "]
[187.50541, "o", "      type: item.result.type,\r\n\u001b[?2004l\r"]
[187.50544, "o", "\u001b[?2004h> "]
[187.505575, "o", "      confidence: Number(item.result.confidence),\r\n\u001b[?2004l\r"]
[187.505605, "o", "\u001b[?2004h> "]
[187.505667, "o", "    });\r\n\u001b[?2004l\r\u001b[?2004h>   }\r\n\u001b[?2004l\r"]
[187.505698, "o", "\u001b[?2004h> "]
[187.505786, "o", "  for (const u of uploaded) {\r\n\u001b[?2004l\r\u001b[?2004h"]
[187.505817, "o", "> "]
[187.505939, "o", "    const r = classifyByFileId.get(u.fileId);\r\n\u001b[?2004l\r"]
[187.50597, "o", "\u001b[?2004h> "]
[187.506167, "o", "    if (!r) throw new Error(`No classification result for ${u.basename}`);\r\n\u001b[?2004l\r"]
[187.506198, "o", "\u001b[?2004h> "]
[187.506249, "o", "    console.log(\r\n\u001b[?2004l\r"]
[187.50628, "o", "\u001b[?2004h> "]
[187.506494, "o", "      `[classify] ${u.basename} -> ${r.type} (${r.confidence.toFixed(3)})`,\r\n\u001b[?2004l\r\u001b[?2004h"]
[187.506525, "o", ">     );\r\n\u001b[?2004l\r"]
[187.506556, "o", "\u001b[?2004h> "]
[187.506635, "o", "  }\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[187.506826, "o", "  // Sanity: both invoices should be the same type, both contracts too.\r\n\u001b[?2004l\r"]
[187.506859, "o", "\u001b[?2004h> "]
[187.50703, "o", "  // ---- Phase 2: Per-category Extract (concurrent, cap 2) ----\r\n\u001b[?2004l\r"]
[187.507065, "o", "\u001b[?2004h> "]
[187.507334, "o", "  const invoiceJsonSchema = stripMeta(zodToJsonSchema(invoiceSchema, { target: 'jsonSchema7' }) as any);\r\n\u001b[?2004l\r\u001b[?2004h"]
[187.507367, "o", "> "]
[187.507646, "o", "  const contractJsonSchema = stripMeta(zodToJsonSchema(contractSchema, { target: 'jsonSchema7' }) as any);\r\n\u001b[?2004l\r\u001b[?2004h"]
[187.507681, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h"]
[187.50771, "o", "> "]
[187.507785, "o", "  const limit = pLimit(2);\r\n\u001b[?2004l\r\u001b[?2004h"]
[187.507818, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h"]
[187.507879, "o", "> "]
[187.507959, "o", "  const extractJobs = uploaded.map((u) =>\r\n\u001b[?2004l\r"]
[187.507992, "o", "\u001b[?2004h> "]
[187.508065, "o", "    limit(async () => {\r\n\u001b[?2004l\r\u001b[?2004h"]
[187.508098, "o", "> "]
[187.508231, "o", "      const cat = classifyByFileId.get(u.fileId)!;\r\n\u001b[?2004l\r"]
[187.508265, "o", "\u001b[?2004h> "]
[187.508334, "o", "      const dataSchema =\r\n\u001b[?2004l\r"]
[187.508368, "o", "\u001b[?2004h> "]
[187.508566, "o", "        cat.type === 'invoice' ? invoiceJsonSchema : contractJsonSchema;\r\n\u001b[?2004l\r\u001b[?2004h"]
[187.508602, "o", "> "]
[187.508772, "o", "      console.log(`[extract] start ${u.basename} (${cat.type})`);\r\n\u001b[?2004l\r\u001b[?2004h"]
[187.508807, "o", "> "]
[187.508941, "o", "      const created = await client.extract.create({\r\n\u001b[?2004l\r"]
[187.508976, "o", "\u001b[?2004h> "]
[187.509057, "o", "        file_input: u.fileId,\r\n\u001b[?2004l\r"]
[187.509093, "o", "\u001b[?2004h> "]
[187.50916, "o", "        configuration: {\r\n\u001b[?2004l\r"]
[187.509196, "o", "\u001b[?2004h> "]
[187.509307, "o", "          data_schema: dataSchema as any,\r\n\u001b[?2004l\r"]
[187.509343, "o", "\u001b[?2004h> "]
[187.509457, "o", "          extraction_target: 'per_doc',\r\n\u001b[?2004l\r\u001b[?2004h"]
[187.509493, "o", "> "]
[187.509566, "o", "          tier: 'agentic',\r\n\u001b[?2004l\r\u001b[?2004h"]
[187.509604, "o", "> "]
[187.509681, "o", "        },\r\n\u001b[?2004l\r\u001b[?2004h>       });\r\n\u001b[?2004l\r"]
[187.509719, "o", "\u001b[?2004h> "]
[187.509826, "o", "      const final = await pollUntilDone(\r\n\u001b[?2004l\r"]
[187.509865, "o", "\u001b[?2004h> "]
[187.509986, "o", "        () => client.extract.get(created.id),\r\n\u001b[?2004l\r\u001b[?2004h"]
