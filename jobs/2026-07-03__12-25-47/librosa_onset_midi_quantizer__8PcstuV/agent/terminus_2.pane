[?2004l[?2004h> 
[?2004l[?2004h> # Detect onsets with backtrack=True
[?2004l[?2004h> onset_frames = librosa.onset.onset_detect(y=y, sr=sr, backtrack=True)
[?2004l[?2004h> onset_times = librosa.frames_to_time(onset_frames, sr=sr)
[?2004l[?2004h> 
