[?2004l[?2004h>         )
[?2004l[?2004h>     except Exception:
[?2004l[?2004h>         f0 = np.array([np.nan])
[?2004l[?2004h> 
[?2004l[?2004h>     voiced_f0 = f0[~np.isnan(f0)]
[?2004l[?2004h>     if len(voiced_f0) == 0:
[?2004l[?2004h>         continue
[?2004l[?2004h> 
[?2004l[?2004h>     pitch_hz = float(np.median(voiced_f0))
[?2004l[?2004h>     pitch_midi_f = float(librosa.hz_to_midi(pitch_hz))
[?2004l[?2004h>     pitch_midi = int(round(pitch_midi_f))
[?2004l[?2004h>     pitch_midi = max(0, min(127, pitch_midi))
[?2004l[?2004h> 
[?2004l[?2004h>     # RMS for this segment
