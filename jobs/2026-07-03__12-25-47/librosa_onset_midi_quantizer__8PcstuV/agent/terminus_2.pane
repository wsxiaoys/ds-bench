[?2004l[?2004h>         else:
[?2004l[?2004h>             v = 100
[?2004l[?2004h>         n['velocity'] = max(1, min(127, v))
[?2004l[?2004h> 
[?2004l[?2004h> # Clamp offset_sec to <= duration + 0.1
[?2004l[?2004h> max_offset = duration + 0.1
