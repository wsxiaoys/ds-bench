[?2004l[?2004h>     end_frame = max(end_frame, start_frame + 1)
[?2004l[?2004h>     seg_rms = rms_all[start_frame:end_frame]
[?2004l[?2004h>     if len(seg_rms) == 0:
[?2004l[?2004h>         seg_rms = np.array([0.0])
[?2004l[?2004h>     rms_val = float(np.mean(seg_rms))
[?2004l[?2004h> 
[?2004l[?2004h>     raw_notes.append({
[?2004l[?2004h>         'onset_sec': start,
