[?2004l[?2004h> 
[?2004l[?2004h> fmin_hz = librosa.note_to_hz('C2')
[?2004l[?2004h> fmax_hz = librosa.note_to_hz('C7')
[?2004l[?2004h> 
[?2004l[?2004h> raw_notes = []
[?2004l[?2004h> for i in range(len(onset_times)):
[?2004l[?2004h>     start = float(onset_times[i])
[?2004l[?2004h>     end = float(boundaries[i + 1])
[?2004l[?2004h>     if end <= start:
[?2004l[?2004h>         # Ensure strict increase
[?2004l[?2004h>         end = start + 1.0 / sr
[?2004l[?2004h> 
[?2004l[?2004h>     start_sample = int(start * sr)
[?2004l[?2004h>     end_sample = max(end_sample if False else int(end * sr), start_sample + 1)
[?2004l[?2004h>     y_seg = y[start_sample:end_sample]
[?2004l[?2004h> 
[?2004l[?2004h>     # Estimate pitch with pyin
[?2004l[?2004h>     try:
[?2004l[?2004h>         f0, voiced_flag, voiced_prob = librosa.pyin(
