[?2004l[?2004h>         if t > unique[-1] + 1e-6:
[?2004l[?2004h>             unique.append(t)
[?2004l[?2004h>     onset_times = np.array(unique)
[?2004l[?2004h> 
[?2004l[?2004h> # Build segment boundaries: each onset to next onset (or end)
[?2004l[?2004h> boundaries = list(onset_times) + [duration]
