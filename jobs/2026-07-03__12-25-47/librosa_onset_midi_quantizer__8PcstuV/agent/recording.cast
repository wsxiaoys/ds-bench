[127.21258, "i", "python3 -c \"import librosa; y, sr = librosa.load('/home/user/input.wav', sr=None); print('duration:', librosa.get_duration(y=y, sr=sr), 'sr:', sr)\"\n"]
[127.213688, "o", "python3 -c \"import librosa; y, sr = librosa.load('/home/user/input.wav', sr=None); print('duration:', librosa.get_duration(y=y, sr=sr), 'sr:', sr)\"\r\n\u001b[?2004l\r"]
