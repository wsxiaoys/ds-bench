[338.400038, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[338.400348, "o", "# Sort and dedupe (keep first of exact duplicates)\r\n\u001b[?2004l\r"]
[338.400392, "o", "\u001b[?2004h> "]
[338.400751, "o", "onset_times = np.sort(np.unique(np.round(onset_times, 6)))\r\n\u001b[?2004l\r"]
[338.400791, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[338.400841, "o", "\u001b[?2004h> "]
[338.401082, "o", "fmin_hz = librosa.note_to_hz('C2')\r\n\u001b[?2004l\r"]
[338.401119, "o", "\u001b[?2004h> "]
[338.401336, "o", "fmax_hz = librosa.note_to_hz('C7')\r\n\u001b[?2004l\r"]
[338.401372, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[338.401458, "o", "\u001b[?2004h> "]
[338.401801, "o", "# First pass: estimate pitch for each segment between onsets\r\n\u001b[?2004l\r"]
[338.401845, "o", "\u001b[?2004h> "]
[338.402125, "o", "def estimate_pitch(y_seg, sr, fmin, fmax):\r\n\u001b[?2004l\r"]
[338.402165, "o", "\u001b[?2004h> "]
[338.40239, "o", "    if len(y_seg) < int(0.05 * sr):\r\n\u001b[?2004l\r"]
[338.402429, "o", "\u001b[?2004h> "]
[338.402565, "o", "        return None\r\n\u001b[?2004l\r"]
[338.402603, "o", "\u001b[?2004h> "]
[338.402674, "o", "    try:\r\n\u001b[?2004l\r"]
[338.402713, "o", "\u001b[?2004h> "]
[338.403138, "o", "        f0, _, _ = librosa.pyin(y_seg, fmin=fmin, fmax=fmax, sr=sr)\r\n\u001b[?2004l\r"]
[338.403177, "o", "\u001b[?2004h> "]
[338.403319, "o", "    except Exception:\r\n\u001b[?2004l\r"]
[338.403358, "o", "\u001b[?2004h> "]
[338.403496, "o", "        return None\r\n\u001b[?2004l\r"]
[338.403535, "o", "\u001b[?2004h> "]
[338.403732, "o", "    voiced = f0[~np.isnan(f0)]\r\n\u001b[?2004l\r"]
[338.403772, "o", "\u001b[?2004h> "]
[338.403946, "o", "    if len(voiced) == 0:\r\n\u001b[?2004l\r"]
[338.403984, "o", "\u001b[?2004h> "]
[338.404112, "o", "        return None\r\n\u001b[?2004l\r"]
[338.40415, "o", "\u001b[?2004h> "]
[338.404366, "o", "    hz = float(np.median(voiced))\r\n\u001b[?2004l\r"]
[338.404404, "o", "\u001b[?2004h> "]
[338.404741, "o", "    midi = int(round(float(librosa.hz_to_midi(hz))))\r\n\u001b[?2004l\r"]
[338.40478, "o", "\u001b[?2004h> "]
[338.405009, "o", "    return max(0, min(127, midi))\r\n\u001b[?2004l\r"]
[338.405048, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[338.405132, "o", "\u001b[?2004h> "]
[338.405379, "o", "# Build candidate onsets with their pitches\r\n\u001b[?2004l\r"]
[338.405415, "o", "\u001b[?2004h> "]
[338.405529, "o", "candidates = []\r\n\u001b[?2004l\r"]
[338.405567, "o", "\u001b[?2004h> "]
[338.40579, "o", "for i in range(len(onset_times)):\r\n\u001b[?2004l\r"]
[338.405827, "o", "\u001b[?2004h> "]
[338.406049, "o", "    start = float(onset_times[i])\r\n\u001b[?2004l\r"]
[338.406085, "o", "\u001b[?2004h> "]
[338.406559, "o", "    end = float(onset_times[i + 1]) if i + 1 < len(onset_times) else duration\r\n\u001b[?2004l\r"]
[338.406597, "o", "\u001b[?2004h> "]
[338.406736, "o", "    if end <= start:\r\n\u001b[?2004l\r"]
[338.406772, "o", "\u001b[?2004h> "]
[338.406985, "o", "        end = start + 1.0 / sr\r\n\u001b[?2004l\r"]
[338.407021, "o", "\u001b[?2004h> "]
[338.40718, "o", "    s = int(start * sr)\r\n\u001b[?2004l\r"]
[338.40722, "o", "\u001b[?2004h> "]
[338.407439, "o", "    e = max(int(end * sr), s + 1)\r\n\u001b[?2004l\r"]
[338.407476, "o", "\u001b[?2004h> "]
[338.407605, "o", "    y_seg = y[s:e]\r\n\u001b[?2004l\r"]
[338.407642, "o", "\u001b[?2004h> "]
[338.408001, "o", "    pitch = estimate_pitch(y_seg, sr, fmin_hz, fmax_hz)\r\n\u001b[?2004l\r"]
[338.40804, "o", "\u001b[?2004h> "]
[338.408451, "o", "    candidates.append({'time': start, 'end': end, 'pitch': pitch})\r\n\u001b[?2004l\r"]
[338.408487, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[338.408563, "o", "\u001b[?2004h> "]
[338.409009, "o", "# Filter: remove onsets whose pitch equals the previous kept onset's pitch\r\n\u001b[?2004l\r"]
[338.409048, "o", "\u001b[?2004h> "]
[338.40937, "o", "# These are false duplicates from the onset detector\r\n\u001b[?2004l\r"]
[338.409409, "o", "\u001b[?2004h> "]
[338.409507, "o", "filtered = []\r\n\u001b[?2004l\r"]
[338.409545, "o", "\u001b[?2004h> "]
[338.409697, "o", "for c in candidates:\r\n\u001b[?2004l\r"]
[338.409736, "o", "\u001b[?2004h> "]
[338.409924, "o", "    if c['pitch'] is None:\r\n\u001b[?2004l\r"]
[338.409963, "o", "\u001b[?2004h> "]
[338.410138, "o", "        filtered.append(c)\r\n\u001b[?2004l\r"]
[338.410177, "o", "\u001b[?2004h> "]
[338.410293, "o", "        continue\r\n\u001b[?2004l\r"]
[338.410332, "o", "\u001b[?2004h> "]
[338.41068, "o", "    if filtered and filtered[-1]['pitch'] == c['pitch']:\r\n\u001b[?2004l\r"]
[338.410719, "o", "\u001b[?2004h> "]
[338.410969, "o", "        # False duplicate - skip it\r\n\u001b[?2004l\r"]
[338.411008, "o", "\u001b[?2004h> "]
[338.411125, "o", "        continue\r\n\u001b[?2004l\r"]
[338.411164, "o", "\u001b[?2004h> "]
[338.411314, "o", "    filtered.append(c)\r\n\u001b[?2004l\r"]
[338.411353, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[338.411407, "o", "\u001b[?2004h> "]
[338.411945, "o", "# Now compute final boundaries: each note ends at the next kept onset (or end of audio)\r\n\u001b[?2004l\r"]
[338.411981, "o", "\u001b[?2004h> "]
[338.412284, "o", "# Then re-estimate pitch using the full segment\r\n\u001b[?2004l\r"]
[338.412323, "o", "\u001b[?2004h> "]
[338.412422, "o", "raw_notes = []\r\n\u001b[?2004l\r"]
[338.412462, "o", "\u001b[?2004h> "]
[338.412672, "o", "for i, c in enumerate(filtered):\r\n\u001b[?2004l\r"]
[338.412711, "o", "\u001b[?2004h> "]
[338.412888, "o", "    start = c['time']\r\n\u001b[?2004l\r\u001b[?2004h"]
[338.412938, "o", "> "]
[338.413392, "o", "    end = float(filtered[i + 1]['time']) if i + 1 < len(filtered) else duration\r\n\u001b[?2004l\r"]
[338.413429, "o", "\u001b[?2004h> "]
[338.413568, "o", "    if end <= start:\r\n\u001b[?2004l\r"]
[338.413606, "o", "\u001b[?2004h> "]
[338.413808, "o", "        end = start + 1.0 / sr\r\n\u001b[?2004l\r"]
[338.413855, "o", "\u001b[?2004h> "]
[338.414044, "o", "    s = int(start * sr)\r\n\u001b[?2004l\r"]
[338.41408, "o", "\u001b[?2004h> "]
[338.414327, "o", "    e = max(int(end * sr), s + 1)\r\n\u001b[?2004l\r"]
[338.414369, "o", "\u001b[?2004h> "]
[338.414517, "o", "    y_seg = y[s:e]\r\n\u001b[?2004l\r"]
[338.414553, "o", "\u001b[?2004h> "]
[338.414931, "o", "    pitch = estimate_pitch(y_seg, sr, fmin_hz, fmax_hz)\r\n\u001b[?2004l\r"]
[338.414978, "o", "\u001b[?2004h> "]
[338.415137, "o", "    if pitch is None:\r\n\u001b[?2004l\r"]
[338.415173, "o", "\u001b[?2004h> "]
[338.415312, "o", "        continue\r\n\u001b[?2004l\r"]
[338.415348, "o", "\u001b[?2004h> "]
[338.415522, "o", "    raw_notes.append({\r\n\u001b[?2004l\r"]
[338.415558, "o", "\u001b[?2004h> "]
[338.41576, "o", "        'onset_sec': start,\r\n\u001b[?2004l\r"]
[338.415796, "o", "\u001b[?2004h> "]
[338.416004, "o", "        'offset_sec': end,\r\n\u001b[?2004l\r"]
[338.416041, "o", "\u001b[?2004h> "]
[338.416251, "o", "        'pitch_midi': pitch,\r\n\u001b[?2004l\r"]
[338.416289, "o", "\u001b[?2004h> "]
[338.416373, "o", "    })\r\n\u001b[?2004l\r"]
[338.41641, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[338.416494, "o", "\u001b[?2004h> "]
[338.416607, "o", "# Pre-compute RMS\r\n\u001b[?2004l\r"]
[338.416646, "o", "\u001b[?2004h> "]
[338.416787, "o", "hop_length = 512\r\n\u001b[?2004l\r"]
[338.416827, "o", "\u001b[?2004h> "]
[338.417232, "o", "rms_all = librosa.feature.rms(y=y, hop_length=hop_length)[0]\r\n\u001b[?2004l\r"]
[338.417272, "o", "\u001b[?2004h> "]
[338.417833, "o", "rms_times = librosa.frames_to_time(np.arange(len(rms_all)), sr=sr, hop_length=hop_length)\r\n\u001b[?2004l\r"]
[338.41801, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[338.418153, "o", "# Compute RMS for each note\r\n\u001b[?2004l\r"]
[338.418193, "o", "\u001b[?2004h> "]
[338.418346, "o", "for n in raw_notes:\r\n\u001b[?2004l\r"]
[338.418385, "o", "\u001b[?2004h> "]
[338.418808, "o", "    start_frame = int(np.searchsorted(rms_times, n['onset_sec']))\r\n\u001b[?2004l\r"]
[338.418852, "o", "\u001b[?2004h> "]
[338.419274, "o", "    end_frame = int(np.searchsorted(rms_times, n['offset_sec']))\r\n\u001b[?2004l\r"]
[338.419313, "o", "\u001b[?2004h> "]
[338.41963, "o", "    end_frame = max(end_frame, start_frame + 1)\r\n\u001b[?2004l\r"]
[338.419668, "o", "\u001b[?2004h> "]
[338.419984, "o", "    seg_rms = rms_all[start_frame:end_frame]\r\n\u001b[?2004l\r"]
[338.420022, "o", "\u001b[?2004h> "]
[338.42021, "o", "    if len(seg_rms) == 0:\r\n\u001b[?2004l\r"]
[338.420248, "o", "\u001b[?2004h> "]
[338.420489, "o", "        seg_rms = np.array([0.0])\r\n\u001b[?2004l\r"]
[338.42053, "o", "\u001b[?2004h> "]
[338.420792, "o", "    n['rms'] = float(np.mean(seg_rms))\r\n\u001b[?2004l\r"]
[338.42083, "o", "\u001b[?2004h> "]
[338.420918, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[338.421061, "o", "# Velocity from RMS\r\n\u001b[?2004l\r"]
[338.421099, "o", "\u001b[?2004h"]
[338.421171, "o", "> "]
[338.421287, "o", "if len(raw_notes) > 0:\r\n\u001b[?2004l\r"]
[338.421326, "o", "\u001b[?2004h> "]
[338.421689, "o", "    rms_vals = np.array([n['rms'] for n in raw_notes])\r\n\u001b[?2004l\r"]
[338.421728, "o", "\u001b[?2004h> "]
[338.42197, "o", "    rmin = float(rms_vals.min())\r\n\u001b[?2004l\r"]
[338.422008, "o", "\u001b[?2004h> "]
[338.422249, "o", "    rmax = float(rms_vals.max())\r\n\u001b[?2004l\r"]
[338.422311, "o", "\u001b[?2004h> "]
[338.422457, "o", "    for n in raw_notes:\r\n\u001b[?2004l\r"]
[338.422496, "o", "\u001b[?2004h> "]
[338.422679, "o", "        if rmax > rmin:\r\n\u001b[?2004l\r"]
[338.422718, "o", "\u001b[?2004h> "]
[338.423194, "o", "            v = 1 + int(round((n['rms'] - rmin) / (rmax - rmin) * 126))\r\n\u001b[?2004l\r"]
[338.423233, "o", "\u001b[?2004h> "]
[338.423346, "o", "        else:\r\n\u001b[?2004l\r"]
[338.423385, "o", "\u001b[?2004h> "]
[338.423539, "o", "            v = 100\r\n\u001b[?2004l\r"]
[338.423577, "o", "\u001b[?2004h> "]
[338.423886, "o", "        n['velocity'] = max(1, min(127, v))\r\n\u001b[?2004l\r"]
[338.423925, "o", "\u001b[?2004h> "]
[338.424008, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[338.424189, "o", "max_offset = duration + 0.1\r\n\u001b[?2004l\r"]
[338.424225, "o", "\u001b[?2004h> "]
[338.424381, "o", "for n in raw_notes:\r\n\u001b[?2004l\r"]
[338.424416, "o", "\u001b[?2004h> "]
[338.42467, "o", "    if n['offset_sec'] > max_offset:\r\n\u001b[?2004l\r"]
[338.424733, "o", "\u001b[?2004h> "]
[338.424981, "o", "        n['offset_sec'] = max_offset\r\n\u001b[?2004l\r"]
[338.425018, "o", "\u001b[?2004h> "]
[338.425299, "o", "    if n['offset_sec'] <= n['onset_sec']:\r\n\u001b[?2004l\r"]
[338.425335, "o", "\u001b[?2004h> "]
[338.425677, "o", "        n['offset_sec'] = n['onset_sec'] + 1.0 / sr\r\n\u001b[?2004l\r"]
[338.425713, "o", "\u001b[?2004h> "]
[338.425787, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[338.42592, "o", "final_notes = [\r\n\u001b[?2004l\r"]
[338.425958, "o", "\u001b[?2004h> "]
[338.42604, "o", "    {\r\n\u001b[?2004l\r"]
[338.426078, "o", "\u001b[?2004h> "]
[338.426367, "o", "        'onset_sec': float(n['onset_sec']),\r\n\u001b[?2004l\r"]
[338.426405, "o", "\u001b[?2004h> "]
[338.426712, "o", "        'offset_sec': float(n['offset_sec']),\r\n\u001b[?2004l\r"]
[338.426749, "o", "\u001b[?2004h> "]
[338.427055, "o", "        'pitch_midi': int(n['pitch_midi']),\r\n\u001b[?2004l\r"]
[338.427093, "o", "\u001b[?2004h> "]
[338.427362, "o", "        'velocity': int(n['velocity']),\r\n\u001b[?2004l\r"]
[338.4274, "o", "\u001b[?2004h> "]
[338.427469, "o", "    }\r\n\u001b[?2004l\r"]
[338.427507, "o", "\u001b[?2004h> "]
[338.42769, "o", "    for n in raw_notes\r\n\u001b[?2004l\r"]
[338.427728, "o", "\u001b[?2004h"]
[338.427807, "o", "> ]\r\n\u001b[?2004l\r\u001b[?2004h"]
[338.427894, "o", "> \r\n\u001b[?2004l\r"]
[338.427938, "o", "\u001b[?2004h> "]
[338.428255, "o", "final_notes.sort(key=lambda x: x['onset_sec'])\r\n\u001b[?2004l\r"]
[338.428292, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[338.428376, "o", "\u001b[?2004h> "]
[338.428636, "o", "with open('/home/user/notes.json', 'w') as f:\r\n\u001b[?2004l\r"]
[338.428675, "o", "\u001b[?2004h> "]
[338.428942, "o", "    json.dump(final_notes, f, indent=2)\r\n\u001b[?2004l\r"]
[338.428981, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[338.429067, "o", "\u001b[?2004h> "]
[338.429454, "o", "print(f\"Wrote {len(final_notes)} notes to /home/user/notes.json\")\r\n\u001b[?2004l\r"]
[338.429488, "o", "\u001b[?2004h> "]
[338.429649, "o", "for n in final_notes:\r\n\u001b[?2004l\r"]
[338.429685, "o", "\u001b[?2004h> "]
[338.429782, "o", "    print(n)\r\n\u001b[?2004l\r"]
[338.429818, "o", "\u001b[?2004h> "]
[338.429899, "o", "PYEOF\r\n\u001b[?2004l\r"]
[338.431329, "o", "\u001b[?2004h"]
[338.431368, "o", "root@c364f0cc-8efa-4cdf-b78c-31ca8ae43f22:~# "]
[338.833134, "i", "python3 /home/user/transcribe.py\n"]
[338.833443, "o", "python3 /home/user/transcribe.py\r\n\u001b[?2004l\r"]
[342.186454, "o", "Wrote 5 notes to /home/user/notes.json\r\n{'onset_sec': 0.04644, 'offset_sec': 1.021678, 'pitch_midi': 60, 'velocity': 127}\r\n{'onset_sec': 1.184218, 'offset_sec': 2.391655, 'pitch_midi': 64, 'velocity': 16}\r\n{'onset_sec': 2.391655, 'offset_sec': 3.599093, 'pitch_midi': 67, 'velocity': 1}\r\n{'onset_sec': 3.599093, 'offset_sec': 4.620771, 'pitch_midi': 72, 'velocity': 105}\r\n{'onset_sec': 4.783311, 'offset_sec': 5.8, 'pitch_midi': 67, 'velocity': 119}\r\n"]
[342.3206, "o", "\u001b[?2004hroot@c364f0cc-8efa-4cdf-b78c-31ca8ae43f22:~# "]
[380.203379, "i", "python3 -c \"\nimport json\nwith open('/home/user/notes.json') as f:\n    notes = json.load(f)\nprint('Number of notes:', len(notes))\nprint('Keys check:')\nrequired = {'onset_sec', 'offset_sec', 'pitch_midi', 'velocity'}\nfor n in notes:\n    assert set(n.keys()) == required, f'Wrong keys: {n.keys()}'\n    assert isinstance(n['onset_sec'], float), f'onset_sec not float: {n[\\\"onset_sec\\\"]}'\n    assert isinstance(n['offset_sec'], float), f'offset_sec not float'\n    assert isinstance(n['pitch_midi'], int), f'pitch_midi not int: {n[\\\"pitch_midi\\\"]}'\n    assert isinstance(n['velocity'], int), f'velocity not int'\n    assert 0 <= n['pitch_midi'] <= 127, f'pitch out of range'\n    assert 1 <= n['velocity'] <= 127, f'velocity out of range'\n    assert n['offset_sec'] > n['onset_sec'], f'offset <= onset'\n    assert n['offset_sec'] <= 5.9, f'offset too large'\nprint('All checks passed!')\nfor n in notes:\n    print(n)\n\"\n"]
[380.20353, "o", "python3 -c \"\r\n\u001b[?2004l\r"]
[380.20358, "o", "\u001b[?2004h> "]
[380.203609, "o", "import json\r\n\u001b[?2004l\r\u001b[?2004h"]
[380.20367, "o", "> "]
[380.20374, "o", "with open('/home/user/notes.json') as f:\r\n\u001b[?2004l\r"]
[380.203766, "o", "\u001b[?2004h> "]
[380.203854, "o", "    notes = json.load(f)\r\n\u001b[?2004l\r"]
[380.203882, "o", "\u001b[?2004h> "]
[380.203983, "o", "print('Number of notes:', len(notes))\r\n\u001b[?2004l\r\u001b[?2004h"]
[380.204008, "o", "> "]
[380.204056, "o", "print('Keys check:')\r\n\u001b[?2004l\r\u001b[?2004h"]
[380.204084, "o", "> "]
[380.204231, "o", "required = {'onset_sec', 'offset_sec', 'pitch_midi', 'velocity'}\r\n\u001b[?2004l\r"]
[380.204256, "o", "\u001b[?2004h> "]
[380.204314, "o", "for n in notes:\r\n\u001b[?2004l\r\u001b[?2004h"]
[380.204354, "o", "> "]
[380.204524, "o", "    assert set(n.keys()) == required, f'Wrong keys: {n.keys()}'\r\n\u001b[?2004l\r"]
[380.20455, "o", "\u001b[?2004h> "]
[380.204789, "o", "    assert isinstance(n['onset_sec'], float), f'onset_sec not float: {n[\\\"onset_sec\\\"]}'\r\n\u001b[?2004l\r"]
[380.204812, "o", "\u001b[?2004h> "]
[380.205016, "o", "    assert isinstance(n['offset_sec'], float), f'offset_sec not float'\r\n\u001b[?2004l\r"]
[380.205041, "o", "\u001b[?2004h> "]
[380.205293, "o", "    assert isinstance(n['pitch_midi'], int), f'pitch_midi not int: {n[\\\"pitch_midi\\\"]}'\r\n\u001b[?2004l\r"]
[380.205318, "o", "\u001b[?2004h> "]
[380.205474, "o", "    assert isinstance(n['velocity'], int), f'velocity not int'\r\n\u001b[?2004l\r"]
[380.205499, "o", "\u001b[?2004h> "]
[380.205673, "o", "    assert 0 <= n['pitch_midi'] <= 127, f'pitch out of range'\r\n\u001b[?2004l\r"]
[380.20571, "o", "\u001b[?2004h> "]
[380.205896, "o", "    assert 1 <= n['velocity'] <= 127, f'velocity out of range'\r\n\u001b[?2004l\r"]
[380.205921, "o", "\u001b[?2004h> "]
[380.206133, "o", "    assert n['offset_sec'] > n['onset_sec'], f'offset <= onset'\r\n\u001b[?2004l\r"]
[380.206156, "o", "\u001b[?2004h> "]
[380.206308, "o", "    assert n['offset_sec'] <= 5.9, f'offset too large'\r\n\u001b[?2004l\r"]
[380.206332, "o", "\u001b[?2004h> "]
[380.206405, "o", "print('All checks passed!')\r\n\u001b[?2004l\r"]
[380.20643, "o", "\u001b[?2004h> "]
[380.206473, "o", "for n in notes:\r\n\u001b[?2004l\r"]
[380.206496, "o", "\u001b[?2004h> "]
[380.206547, "o", "    print(n)\r\n\u001b[?2004l\r"]
[380.20657, "o", "\u001b[?2004h> \"\r\n\u001b[?2004l\r"]
