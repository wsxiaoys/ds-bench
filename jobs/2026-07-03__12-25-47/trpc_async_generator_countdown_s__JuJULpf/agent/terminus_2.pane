const t = initTRPC.create();
const publicProcedure = t.procedure;

const appRouter = t.router({
  countdown: publicProcedure
    .input(z.number())
    .subscription(async function* (opts) {
      console.log('Generator function called, opts.input:', JSON.stringify(opts.input));
      const n = opts.input as number;
      console.log('n =', n, 'type:', typeof n);
      for (let i = n; i >= 0; i--) {
        console.log('Loop iteration i=' + i);
        await new Promise((resolve) => setTimeout(resolve, 100));
        yield i;
      }
      console.log('Generator function done');
    }),
});

export type AppRouter = typeof appRouter;

const server = createHTTPServer({
  router: appRouter,
  onError: ({ error, path }) => {
    console.error('Server error:', error.message, 'path:', path, 'stack:', error.stack);
  },
});

server.listen(3000, () => {
  console.log('Server listening on port 3000');
});
