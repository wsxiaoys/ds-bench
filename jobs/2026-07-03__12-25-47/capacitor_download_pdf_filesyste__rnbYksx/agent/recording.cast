[103.72812, "i", "cat > index.html << 'EOF'\n<!DOCTYPE html>\n<html lang=\"en\">\n  <head>\n    <meta charset=\"UTF-8\" />\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\" />\n    <title>Filesystem Demo</title>\n  </head>\n  <body>\n    <main id=\"app\">\n      <h1>Filesystem Demo</h1>\n      <button id=\"download-pdf\" type=\"button\">Download PDF</button>\n      <p id=\"download-status\">idle</p>\n      <p>\n        File size: <span id=\"file-size\"></span> bytes\n      </p>\n      <p>\n        SHA-256: <span id=\"file-sha256\"></span>\n      </p>\n    </main>\n    <script type=\"module\" src=\"/src/main.ts\"></script>\n  </body>\n</html>\nEOF\n"]
