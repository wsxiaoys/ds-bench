[?2004l[?2004h>                         int r = Integer.parseInt(tokens[4]);
[?2004l[?2004h>                         int g = Integer.parseInt(tokens[5]);
[?2004l[?2004h>                         int b = Integer.parseInt(tokens[6]);
[?2004l[?2004h>                         int a = Integer.parseInt(tokens[7]);
[?2004l[?2004h>                         pixmap.setColor(r / 255f, g / 255f, b / 255f, a / 255f);
[?2004l[?2004h>                         pixmap.fillCircle(cx, cy, radius);
[?2004l[?2004h>                         cmdCount++;
[?2004l[?2004h>                         break;
[?2004l[?2004h>                     }
[?2004l[?2004h>                     case "PIXEL": {
[?2004l[?2004h>                         if (tokens.length != 7) {
[?2004l[?2004h>                             throw new GdxRuntimeException(
[?2004l[?2004h>                                     "PIXEL expects 6 arguments at line " + (idx + 1));
[?2004l[?2004h>                         }
[?2004l[?2004h>                         int x = Integer.parseInt(tokens[1]);
