[?2004l[?2004h> #!/usr/bin/env bash
[?2004l[?2004h> # Entry point for the procedural pixmap renderer.
[?2004l[?2004h> # Usage: run.sh <input-script> <output-png>
[?2004l[?2004h> set -euo pipefail
[?2004l[?2004h> 
[?2004l[?2004h> if [ "$#" -lt 2 ]; then
[?2004l[?2004h>     echo "Usage: $0 <input-script> <output-png>" >&2
[?2004l[?2004h>     exit 2
[?2004l[?2004h> fi
[?2004l[?2004h> 
[?2004l[?2004h> INPUT="$1"
[?2004l[?2004h> OUTPUT="$2"
[?2004l[?2004h> 
[?2004l[?2004h> cd "$(dirname "$0")"
[?2004l[?2004h> 
[?2004l[?2004h> if [ ! -f "$INPUT" ]; then
[?2004l[?2004h>     echo "Input file does not exist: $INPUT" >&2
[?2004l[?2004h>     exit 1
[?2004l[?2004h> fi
[?2004l[?2004h> 
[?2004l[?2004h> # Resolve to absolute paths so the JVM can find them regardless of cwd.
[?2004l[?2004h> ABS_INPUT="$(readlink -f "$INPUT")"
[?2004l[?2004h> ABS_OUTPUT="$(readlink -f "$OUTPUT")"
[?2004l[?2004h> 
[?2004l[?2004h> mkdir -p "$(dirname "$ABS_OUTPUT")"
[?2004l[?2004h> 
[?2004l[?2004h> exec gradle --no-daemon --offline -q run --args="$ABS_INPUT $ABS_OUTPUT"
[?2004l[?2004h> EOF
