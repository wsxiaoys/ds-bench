[?2004l[?2004h>                         int r = Integer.parseInt(tokens[3]);
[?2004l[?2004h>                         int g = Integer.parseInt(tokens[4]);
[?2004l[?2004h>                         int b = Integer.parseInt(tokens[5]);
[?2004l[?2004h>                         int a = Integer.parseInt(tokens[6]);
[?2004l[?2004h>                         pixmap.setColor(r / 255f, g / 255f, b / 255f, a / 255f);
