[?2004l[?2004h> package com.example;
[?2004l[?2004h> 
[?2004l[?2004h> import com.badlogic.gdx.backends.headless.HeadlessApplication;
[?2004l[?2004h> import com.badlogic.gdx.backends.headless.HeadlessApplicationConfiguration;
[?2004l[?2004h> 
[?2004l[?2004h> /**
[?2004l[?2004h>  * Boots a HeadlessApplication that runs the procedural Pixmap renderer.
[?2004l[?2004h>  */
[?2004l[?2004h> public class Main {
[?2004l[?2004h> 
[?2004l[?2004h>     public static void main(String[] args) {
[?2004l[?2004h>         if (args.length < 2) {
[?2004l[?2004h>             System.err.println("Usage: Main <input-script> <output-png>");
[?2004l[?2004h>             System.exit(2);
[?2004l[?2004h>         }
[?2004l[?2004h> 
[?2004l[?2004h>         String inputPath = args[0];
[?2004l[?2004h>         String outputPath = args[1];
[?2004l[?2004h> 
[?2004l[?2004h>         HeadlessApplicationConfiguration config = new HeadlessApplicationConfiguration();
[?2004l[?2004h>         // Headless runs at a sensible but not infinite FPS; create() does the work.
[?2004l[?2004h>         config.renderInterval = 1f / 30f;
[?2004l[?2004h>         config.updatesPerSecond = 30;
[?2004l[?2004h> 
[?2004l[?2004h>         PixmapRenderer listener = new PixmapRenderer(inputPath, outputPath);
[?2004l[?2004h>         HeadlessApplication app = new HeadlessApplication(listener, config);
[?2004l[?2004h> 
[?2004l[?2004h>         // Block this thread until the listener calls Gdx.app.exit().
[?2004l[?2004h>         // The listener renders the summary and requests exit from render().
[?2004l[?2004h>         while (app.getApplicationListener() != null) {
[?2004l[?2004h>             try {
[?2004l[?2004h>                 Thread.sleep(50);
[?2004l[?2004h>             } catch (InterruptedException ie) {
[?2004l[?2004h>                 Thread.currentThread().interrupt();
[?2004l[?2004h>                 break;
[?2004l[?2004h>             }
[?2004l[?2004h>         }
[?2004l[?2004h> 
[?2004l[?2004h>         // The HeadlessApplication's exit sets listener to null; ensure clean shutdown.
[?2004l[?2004h>         try {
[?2004l[?2004h>             app.exit();
[?2004l[?2004h>         } catch (Throwable ignored) {
[?2004l[?2004h>         }
[?2004l[?2004h>     }
[?2004l[?2004h> }
