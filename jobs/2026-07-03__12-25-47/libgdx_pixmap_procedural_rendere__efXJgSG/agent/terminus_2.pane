[?2004l[?2004h>                         int g = Integer.parseInt(tokens[6]);
[?2004l[?2004h>                         int b = Integer.parseInt(tokens[7]);
[?2004l[?2004h>                         int a = Integer.parseInt(tokens[8]);
[?2004l[?2004h>                         pixmap.setColor(r / 255f, g / 255f, b / 255f, a / 255f);
[?2004l[?2004h>                         pixmap.fillRectangle(x, y, w, h);
