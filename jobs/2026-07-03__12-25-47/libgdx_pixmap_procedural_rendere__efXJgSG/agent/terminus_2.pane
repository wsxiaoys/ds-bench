[?2004l[?2004h>                         break;
[?2004l[?2004h>                     }
[?2004l[?2004h>                     case "CIRCLE": {
[?2004l[?2004h>                         if (tokens.length != 7) {
[?2004l[?2004h>                             throw new GdxRuntimeException(
