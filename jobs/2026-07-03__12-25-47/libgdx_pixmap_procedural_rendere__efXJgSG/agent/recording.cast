[475.420649, "o", "        }\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[475.420772, "o", "\u001b[?2004h> "]
[475.420888, "o", "        if (!exitRequested) {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[475.420949, "o", "            exitRequested = true;\r\n\u001b[?2004l\r\u001b[?2004h> "]
[475.421244, "o", "            // Ask the headless loop to exit on the next iteration. The actual\r\n\u001b[?2004l\r\u001b[?2004h> "]
[475.421522, "o", "            // shutdown is performed by the launcher (main) joining the loop.\r\n\u001b[?2004l\r\u001b[?2004h> "]
[475.421612, "o", "            try {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[475.421749, "o", "                Gdx.app.exit();\r\n\u001b[?2004l\r\u001b[?2004h> "]
[475.421928, "o", "            } catch (Throwable ignored) {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[475.42199, "o", "            }\r\n\u001b[?2004l\r\u001b[?2004h"]
[475.422111, "o", ">         }\r\n\u001b[?2004l\r\u001b[?2004h>     }\r\n\u001b[?2004l\r\u001b[?2004h"]
