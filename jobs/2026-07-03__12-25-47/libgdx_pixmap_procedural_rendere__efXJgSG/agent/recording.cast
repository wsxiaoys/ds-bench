[475.422666, "o", "        // create() prints the summary and requests exit; render() must be a no-op.\r\n\u001b[?2004l\r\u001b[?2004h> "]
[475.422729, "o", "    }\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
