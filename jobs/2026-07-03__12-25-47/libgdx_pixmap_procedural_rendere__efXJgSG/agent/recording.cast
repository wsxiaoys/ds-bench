[475.361012, "o", "                                \"Unknown command '\" + tokens[0] + \"' at line \" + (idx + 1));\r\n\u001b[?2004l\r\u001b[?2004h"]
[475.361063, "o", ">                 }\r\n"]
[475.361116, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[475.361166, "o", "            }\r\n\u001b[?2004l\r\u001b[?2004h"]
[475.361232, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[475.361346, "o", "            if (!sized) {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[475.361667, "o", "                throw new GdxRuntimeException(\"Script is missing a SIZE command\");\r\n\u001b[?2004l\r\u001b[?2004h> "]
[475.361726, "o", "            }\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[475.361788, "o", "\u001b[?2004h> "]
[475.417281, "o", "            commandCount = cmdCount;\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h>             // Write PNG to absolute output path\r\n\u001b[?2004l\r\u001b[?2004h>             FileHandle outFile = Gdx.files.absolute(outputPath);\r\n\u001b[?2004l\r\u001b[?2004h"]
[475.417411, "o", "> "]
[475.417566, "o", "            java.io.File parent = outFile.file().getAbsoluteFile().getParentFile();\r\n\u001b[?2004l\r\u001b[?2004h> "]
[475.41777, "o", "            if (parent != null && !parent.exists()) {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[475.41793, "o", "                parent.mkdirs();\r\n\u001b[?2004l\r\u001b[?2004h> "]
[475.417995, "o", "            }\r\n\u001b[?2004l\r\u001b[?2004h"]
[475.418123, "o", "> "]
[475.418222, "o", "            PixmapIO.writePNG(outFile, pixmap);\r\n\u001b[?2004l\r\u001b[?2004h> "]
[475.418325, "o", "            pixmap.dispose();\r\n\u001b[?2004l\r\u001b[?2004h> "]
[475.418439, "o", "            pixmap = null;\r\n\u001b[?2004l\r\u001b[?2004h"]
[475.418506, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[475.418747, "o", "            summary = \"RENDER_OK width=\" + width + \" height=\" + height\r\n\u001b[?2004l\r\u001b[?2004h> "]
[475.418948, "o", "                    + \" commands=\" + commandCount;\r\n\u001b[?2004l\r\u001b[?2004h> "]
[475.419102, "o", "        } catch (RuntimeException e) {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[475.419345, "o", "            System.err.println(\"RENDER_ERROR: \" + e.getMessage());\r\n\u001b[?2004l\r\u001b[?2004h> "]
[475.419486, "o", "            if (pixmap != null) {\r\n\u001b[?2004l\r\u001b[?2004h> "]
