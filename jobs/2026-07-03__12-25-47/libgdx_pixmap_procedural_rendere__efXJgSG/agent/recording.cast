[475.422967, "o", "    public void dispose() {\r\n\u001b[?2004l\r\u001b[?2004h"]
[475.42306, "o", "> "]
[475.423151, "o", "        if (pixmap != null) {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[475.423244, "o", "            pixmap.dispose();\r\n\u001b[?2004l\r\u001b[?2004h> "]
