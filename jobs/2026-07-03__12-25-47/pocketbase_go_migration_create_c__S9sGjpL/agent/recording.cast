[90.067741, "o", "\t\t{\r\n\t\t\tDB:             app.DB(),\r\n\t\t\tMigrationsList: migrations.AppMigrations,\r\n\t\t},\r\n\t\t{\r\n\t\t\tDB:             app.LogsDB(),\r\n\t\t\tMigrationsList: logs.LogsMigrations,\r\n\t\t},\r\n\t}\r\n\r\n\tfor _, c := range connections {\r\n\t\trunner, err := migrate.NewRunner(c.DB, c.MigrationsList)\r\n\t\tif err != nil {\r\n\t\t\treturn err\r\n\t\t}\r\n\r\n\t\tif _, err := runner.Up(); err != nil {\r\n\t\t\treturn err\r\n\t\t}\r\n\t}\r\n\r\n\treturn nil\r\n}\r\n"]
