[106.842556, "o", "file:///home/user/myproject/node_modules/@ark/util/out/errors.js:5\r\n    throw new ctor(message);\r\n          ^\r\n\r\nParseError: An unordered union of a type including a morph and a type with overlapping input is indeterminate:\r\nLeft: (In: { value: string }) => Out<unknown>\r\nRight: (In: { value: string }) => Out<unknown>\r\n    at throwError \u001b[90m(file:///home/user/myproject/\u001b[39mnode_modules/\u001b[4m@ark/util\u001b[24m/out/errors.js:5:11\u001b[90m)\u001b[39m\r\n    at throwParseError \u001b[90m(file:///home/user/myproject/\u001b[39mnode_modules/\u001b[4m@ark/util\u001b[24m/out/errors.js:10:43\u001b[90m)\u001b[39m\r\n    at assertDeterminateOverlap \u001b[90m(file:///home/user/myproject/\u001b[39mnode_modules/\u001b[4m@ark/schema\u001b[24m/out/roots/union.js:675:9\u001b[90m)\u001b[39m\r\n    at reduceBranches \u001b[90m(file:///home/user/myproject/\u001b[39mnode_modules/\u001b[4m@ark/schema\u001b[24m/out/roots/union.js:660:17\u001b[90m)\u001b[39m\r\n    at Object.reduce \u001b[90m(file:///home/user/myproject/\u001b[39mnode_modules/\u001b[4m@ark/schema\u001b[24m/out/roots/union.js:50:33\u001b[90m)\u001b[39m\r\n    at parseNode \u001b[90m(file:///home/user/myproject/\u001b[39mnode_modules/\u001b[4m@ark/schema\u001b[24m/out/parse.js:92:30\u001b[90m)\u001b[39m\r\n    at InternalScope.node \u001b[90m(file:///home/user/myproject/\u001b[39mnode_modules/\u001b[4m@ark/schema\u001b[24m/out/scope.js:362:22\u001b[90m)\u001b[39m\r\n    at MorphNode.rawOr \u001b[90m(file:///home/user/myproject/\u001b[39mnode_modules/\u001b[4m@ark/schema\u001b[24m/out/roots/root.js:132:23\u001b[90m)\u001b[39m\r\n    at MorphNode.or \u001b[90m(file:///home/user/myproject/\u001b[39mnode_modules/\u001b[4m@ark/schema\u001b[24m/out/roots/root.js:128:37\u001b[90m)\u001b[39m\r\n    at <anonymous> \u001b[90m(/home/user/myproject/\u001b[39mbroken.ts:11:4\u001b[90m)\u001b[39m\r\n\r\nNode.js v24.18.0\r\n"]
