[60.949744, "i", "cat > /tmp/test_schema.ts << 'EOF'\nimport { PayloadSchema } from \"/home/user/myproject/src/schema.ts\";\nimport { type } from \"arktype\";\n\nconst a = PayloadSchema({ kind: \"int\", value: \"42\" });\nconsole.log(\"int result:\", JSON.stringify(a), \"value type:\", typeof (a as any).value);\n\nconst b = PayloadSchema({ kind: \"raw\", value: \"42\" });\nconsole.log(\"raw result:\", JSON.stringify(b), \"value type:\", typeof (b as any).value);\n\nconst c = PayloadSchema({ kind: \"other\", value: \"42\" });\nconsole.log(\"other result:\", c instanceof type.errors, c);\nEOF\ncd /home/user/myproject && npx tsx /tmp/test_schema.ts 2>&1\n"]
