[97.064498, "i", "cat > /tmp/verify.ts << 'EOF'\nimport { PayloadSchema } from \"/home/user/myproject/src/schema.ts\";\nimport { type } from \"arktype\";\n\n// Test 1: int branch morphs value to number\nconst r1 = PayloadSchema({ kind: \"int\", value: \"42\" });\nif (typeof r1.value !== 'number') { console.error(\"FAIL: int value should be number, got\", typeof r1.value); process.exit(1); }\nif (r1.value !== 42) { console.error(\"FAIL: int value should be 42, got\", r1.value); process.exit(1); }\nif (r1.kind !== \"int\") { console.error(\"FAIL: kind should be int\"); process.exit(1); }\nconsole.log(\"PASS Test 1: int morphs to number:\", JSON.stringify(r1));\n\n// Test 2: raw branch preserves string\nconst r2 = PayloadSchema({ kind: \"raw\", value: \"42\" });\nif (typeof r2.value !== 'string') { console.error(\"FAIL: raw value should be string\"); process.exit(1); }\nif (r2.value !== \"42\") { console.error(\"FAIL: raw value should be '42', got\", r2.value); process.exit(1); }\nif (r2.kind !== \"raw\") { console.error(\"FAIL: kind should be raw\"); process.exit(1); }\nconsole.log(\"PASS Test 2: raw preserves string:\", JSON.stringify(r2));\n\n// Test 3: other kind is rejected\nconst r3 = PayloadSchema({ kind: \"other\", value: \"42\" });\nif (!(r3 instanceof type.errors)) { console.error(\"FAIL: other should be errors, got\", r3); process.exit(1); }\nconsole.log(\"PASS Test 3: other rejected, instanceof type.errors:\", true);\n\nconsole.log(\"\\nAll tests passed!\");\nEOF\ncp /tmp/verify.ts /home/user/myproject/verify.ts\ncd /home/user/myproject && npx tsx verify.ts\n"]
