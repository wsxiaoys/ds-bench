[36.373946, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h"]
[36.373983, "o", "> "]
[36.374273, "o", "export const getDashboard = api(\r\n\u001b[?2004l\r"]
[36.37437, "o", "\u001b[?2004h> "]
[36.374877, "o", "  { auth: true, method: \"GET\", path: \"/dashboard\", expose: true },\r\n\u001b[?2004l\r"]
[36.374919, "o", "\u001b[?2004h> "]
[36.375285, "o", "  async (): Promise<DashboardResponse> => {\r\n\u001b[?2004l\r"]
