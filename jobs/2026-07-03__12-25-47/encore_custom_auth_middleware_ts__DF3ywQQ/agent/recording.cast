[530.078477, "o", "import { authHandler } from \"encore.dev/auth\";\r\nimport { APIError, Header } from \"encore.dev/api\";\r\n\r\ninterface AuthParams {\r\n  authorization: Header<\"Authorization\">;\r\n}\r\n\r\ninterface AuthData {\r\n  userID: string;\r\n}\r\n\r\nexport const myAuth = authHandler<AuthParams, AuthData>(\r\n  async (params) => {\r\n    const authHeader = params.authorization;\r\n    if (!authHeader) {\r\n      throw APIError.unauthenticated(\"missing authorization header\");\r\n    }\r\n\r\n    const token = authHeader.replace(/^Bearer\\s+/i, \"\").trim();\r\n    if (token === \"\") {\r\n      throw APIError.unauthenticated(\"missing bearer token\");\r\n    }\r\n\r\n    if (token !== \"secret-token\") {\r\n      throw APIError.unauthenticated(\"invalid token\");\r\n    }\r\n\r\n    return {\r\n      userID: \"user-123\",\r\n    };\r\n  }\r\n);\r\n"]
[530.078687, "o", "\u001b[?2004hroot@b35992c9-f3ad-411d-bec0-617d5a803e03:/home/user/customauth# "]
[530.078793, "o", "echo \"---\"\r\n\u001b[?2004l\r"]
[530.078893, "o", "---\r\n\u001b[?2004hroot@b35992c9-f3ad-411d-bec0-617d5a803e03:/home/user/customauth# "]
[530.079093, "o", "cat /home/user/customauth/src/dashboard.ts\r\n\u001b[?2004l\r"]
[530.080851, "o", "import { api } from \"encore.dev/api\";\r\nimport { getAuthData } from \"../encore.gen/auth\";\r\n\r\ninterface DashboardResponse {\r\n  message: string;\r\n}\r\n\r\nexport const getDashboard = api(\r\n  { auth: true, method: \"GET\", path: \"/dashboard\", expose: true },\r\n  async (): Promise<DashboardResponse> => {\r\n    const auth = getAuthData()!;\r\n    return {\r\n      message: `Welcome to the dashboard, ${auth.userID}!`,\r\n    };\r\n  }\r\n);\r\n"]
[530.081107, "o", "\u001b[?2004hroot@b35992c9-f3ad-411d-bec0-617d5a803e03:/home/user/customauth# "]
[530.081199, "o", "echo \"---\"\r\n\u001b[?2004l\r"]
[530.081292, "o", "---\r\n\u001b[?2004hroot@b35992c9-f3ad-411d-bec0-617d5a803e03:/home/user/customauth# "]
[530.081504, "o", "cat /home/user/customauth/src/gateway.ts\r\n\u001b[?2004l\r"]
[530.08241, "o", "import { Gateway } from \"encore.dev/api\";\r\nimport { myAuth } from \"./auth\";\r\n\r\nexport const gateway = new Gateway({ authHandler: myAuth });\r\n"]
[530.082573, "o", "\u001b[?2004hroot@b35992c9-f3ad-411d-bec0-617d5a803e03:/home/user/customauth# "]
