[35.95718, "o", "\u001b[?2004hroot@b35992c9-f3ad-411d-bec0-617d5a803e03:/home/user/customauth# "]
[36.371653, "i", "cat > src/dashboard.ts << 'EOF'\nimport { api } from \"encore.dev/api\";\nimport { myAuth } from \"./auth\";\n\ninterface DashboardResponse {\n  message: string;\n}\n\nexport const getDashboard = api(\n  { auth: true, method: \"GET\", path: \"/dashboard\", expose: true },\n  async (): Promise<DashboardResponse> => {\n    const auth = myAuth();\n    return {\n      message: `Welcome to the dashboard, ${auth.userID}!`,\n    };\n  }\n);\nEOF\n"]
[36.372207, "o", "cat > src/dashboard.ts << 'EOF'\r\n\u001b[?2004l\r"]
[36.372296, "o", "\u001b[?2004h> "]
