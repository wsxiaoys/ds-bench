[?2004limport { Gateway } from "encore.dev/api";
import { myAuth } from "./auth";

export const gateway = new Gateway({ authHandler: myAuth });
[?2004hroot@b35992c9-f3ad-411d-bec0-617d5a803e03:/home/user/customauth# 