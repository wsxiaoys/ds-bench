[17.88463, "o", "prefect flow-run ls --help\r\n\u001b[?2004l\r"]
[18.770598, "o", "\u001b[1mUsage: \u001b[0m\u001b[1mprefect flow-run ls [OPTIONS]\u001b[0m\r\n\r\n"]
[18.770687, "o", "View recent flow runs or flow runs for specific flows.\r\n\r\n"]
[18.775927, "o", "╭─ Parameters ─────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────╮\r\n│ \u001b[36m--flow-name --empty-flow-name  \u001b[0m\u001b[36m  \u001b[0mName of the flow                                                                                                            │\r\n│ \u001b[36m--limit                        \u001b[0m\u001b[36m  \u001b[0mMaximum number of flow runs to list \u001b[2m[default: 15]\u001b[0m                                                                           │\r\n│ \u001b[36m--state --empty-state          \u001b[0m\u001b[36m  \u001b[0mName of the flow run's state                                                                                                │\r\n│ \u001b[36m--state-type --empty-state-type\u001b[0m\u001b[36m  \u001b[0mType of the flow run's state                                                                                                │\r\n│ \u001b[36m--output -o                    \u001b[0m\u001b[36m  \u001b[0mSpecify an output format. Currently supports: json                                                                          │\r\n╰──────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────╯\r\n"]
[18.776614, "o", "╭─ Session Parameters ─────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────╮\r\n│ \u001b[36m--profile           \u001b[0m\u001b[36m  \u001b[0mSelect a profile for this CLI run.                                                                                                     │\r\n│ \u001b[36m--prompt --no-prompt\u001b[0m\u001b[36m  \u001b[0mToggle interactive prompts.                                                                                                            │\r\n╰──────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────╯\r\n"]
