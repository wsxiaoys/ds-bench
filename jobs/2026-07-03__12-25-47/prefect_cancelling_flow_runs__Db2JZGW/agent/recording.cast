[11.584549, "i", "prefect --help\n"]
[11.584809, "o", "prefect --help\r\n\u001b[?2004l\r"]
[12.366093, "o", "\u001b[1mUsage: \u001b[0m\u001b[1mprefect COMMAND [OPTIONS]\u001b[0m\r\n\r\n"]
[12.366287, "o", "Prefect CLI for workflow orchestration.\r\n\r\n"]
[12.373559, "o", "╭─ Commands ───────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────╮\r\n│ \u001b[36mapi                                   \u001b[0m\u001b[36m  \u001b[0mInteract with the Prefect API.                                                                                       │\r\n│ \u001b[36martifact                              \u001b[0m\u001b[36m  \u001b[0mInspect and delete artifacts.                                                                                        │\r\n│ \u001b[36mREDACTEDmation (REDACTEDmations)              \u001b[0m\u001b[36m  \u001b[0mManage REDACTEDmations.                                                                                                  │\r\n│ \u001b[36mblock (blocks)                        \u001b[0m\u001b[36m  \u001b[0mManage blocks.                                                                                                       │\r\n│ \u001b[36mcloud                                 \u001b[0m\u001b[36m  \u001b[0mAuthenticate and interact with Prefect Cloud.                                                                        │\r\n│ \u001b[36mconcurrency-limit (concurrency-limits)\u001b[0m\u001b[36m  \u001b[0mManage task-level concurrency limits.                                                                                │\r\n│ \u001b[36mconfig                                \u001b[0m\u001b[36m  \u001b[0mView and set Prefect settings.                                                                                       │\r\n│ \u001b[36mdashboard                             \u001b[0m\u001b[36m  \u001b[0mCommands for interacting with the Prefect UI.                                                                        │\r\n│ \u001b[36mdeploy                                \u001b[0m\u001b[36m  \u001b[0mCreate and manage deployments.                                                                                       │\r\n│ \u001b[36mdeployment (deployments)              \u001b[0m\u001b[36m  \u001b[0mManage deployments.                                                                                                  │\r\n│ \u001b[36mdev                                   \u001b[0m\u001b[36m  \u001b[0mInternal Prefect development.                                                                                        │\r\n│ \u001b[36mevents (event)                        \u001b[0m\u001b[36m  \u001b[0mStream events.                                                                                                       │\r\n│ \u001b[36mexperimental                          \u001b[0m\u001b[36m  \u001b[0mAccess experimental features (subject to change).                                                                    │\r\n│ \u001b[36mflow (flows)                          \u001b[0m\u001b[36m  \u001b[0mView and serve flows.                                                                                                │\r\n│ \u001b[36mflow-run (flow-runs)                  \u001b[0m\u001b[36m  \u001b[0mInteract with flow runs.                                                                                             │\r\n│ \u001b[36mglobal-concurrency-limit (gcl)        \u001b[0m\u001b[36m  \u001b[0mManage global concurrency limits.                                                                                    │\r\n│ \u001b[36minit                                  \u001b[0m\u001b[36m  \u001b[0mInitialize a Prefect project.                                                                                        │\r\n│ \u001b[36mplugins                               \u001b[0m\u001b[36m  \u001b[0mPlugin system diagnostics.                                                                                           │\r\n│ \u001b[36mprofile (profiles)                    \u001b[0m\u001b[36m  \u001b[0mSelect and manage Prefect profiles.                                                                                  │\r\n│ \u001b[36msdk                                   \u001b[0m\u001b[36m  \u001b[0mManage Prefect SDKs. (beta)                                                "]
[12.373718, "o", "                                          │\r\n│ \u001b[36mserver                                \u001b[0m\u001b[36m  \u001b[0mStart a Prefect server instance and interact with the database.                                                      │\r\n│ \u001b[36mshell                                 \u001b[0m\u001b[36m  \u001b[0mServe and watch shell commands as Prefect flows.                                                                     │\r\n│ \u001b[36mtask                                  \u001b[0m\u001b[36m  \u001b[0mWork with task scheduling.                                                                                           │\r\n│ \u001b[36mtask-run (task-runs)                  \u001b[0m\u001b[36m  \u001b[0mView and inspect task runs.                                                                                          │\r\n│ \u001b[36mtransfer                              \u001b[0m\u001b[36m  \u001b[0mTransfer resources from one Prefect profile to another.                                                              │\r\n│ \u001b[36mvariable                              \u001b[0m\u001b[36m  \u001b[0mManage variables.                                                                                                    │\r\n│ \u001b[36mversion                               \u001b[0m\u001b[36m  \u001b[0mGet the current Prefect version and integration information.                                                         │\r\n│ \u001b[36mwork-pool (work-pools)                \u001b[0m\u001b[36m  \u001b[0mManage work pools.                                                                                                   │\r\n│ \u001b[36mwork-queue (work-queues)              \u001b[0m\u001b[36m  \u001b[0mManage work queues.                                                                                                  │\r\n│ \u001b[36mworker                                \u001b[0m\u001b[36m  \u001b[0mStart and interact with workers.                                                                                     │\r\n│ \u001b[36m--help                                \u001b[0m\u001b[36m  \u001b[0mDisplay this message and exit.                                                                                       │\r\n╰──────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────╯\r\n"]
[12.374276, "o", "╭─ Session Parameters ─────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────╮\r\n│ \u001b[36m--profile           \u001b[0m\u001b[36m  \u001b[0mSelect a profile for this CLI run.                                                                                                     │\r\n│ \u001b[36m--prompt --no-prompt\u001b[0m\u001b[36m  \u001b[0mToggle interactive prompts.                                                                                                            │\r\n╰──────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────╯\r\n"]
