[5.502258, "i", "cat flow.py\n"]
[5.502572, "o", "cat flow.py\r\n\u001b[?2004l\r"]
[5.50339, "o", "import time\r\nfrom prefect import flow, task\r\n\r\n@task\r\ndef do_nothing():\r\n    pass\r\n\r\n@flow(name=\"infinite_loop_flow\", log_prints=True)\r\ndef infinite_loop_flow():\r\n    print(\"Starting infinite loop flow...\")\r\n    while True:\r\n        do_nothing()\r\n        time.sleep(1)\r\n\r\nif __name__ == \"__main__\":\r\n    infinite_loop_flow()\r\n"]
[5.50356, "o", "\u001b[?2004hroot@fe601e3b-2c69-4595-9b15-e2b77320096f:/home/user/project# "]
