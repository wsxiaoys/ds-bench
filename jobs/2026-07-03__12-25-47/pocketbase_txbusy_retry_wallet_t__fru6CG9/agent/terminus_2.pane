	m.RefreshTokenKey() // manually refresh the token key because the plain password is resetted

	// unset the plain value to skip the field validators
	if raw, ok := m.GetRaw(FieldNamePassword).(*PasswordFieldValue); ok {
		raw.Plain = ""
	}

	return pass
}

