[207.86589, "o", "482:func newRecordFromNullStringMap(collection *Collection, data dbx.NullStringMap) (*Record, error) {\r\n522:func newRecordsFromNullStringMaps(collection *Collection, rows []dbx.NullStringMap) ([]*Record, error) {\r\n539:func NewRecord(collection *Collection) *Record {\r\n567:func (m *Record) Collection() *Collection {\r\n780:\t\tresult[fieldName] = m.Get(fieldName)\r\n918:// Get returns a normalized single record model data value for \"key\".\r\n919:func (m *Record) Get(key string) any {\r\n"]
