[146.831238, "o", "390:\t// FindCollectionByNameOrId finds a single collection by its name (case insensitive) or id.s\r\n391:\tFindCollectionByNameOrId(nameOrId string) (*Collection, error)\r\n393:\t// FindCachedCollectionByNameOrId is similar to [App.FindCollectionByNameOrId]\r\n399:\t// with the [App.FindCollectionByNameOrId] method.\r\n402:\t// use [App.FindCollectionByNameOrId] instead.\r\n553:\t// RecordQuery returns a new Record select query from a collection model, id or name.\r\n558:\tRecordQuery(collectionModelOrIdentifier any) *dbx.SelectQuery\r\n560:\t// FindRecordById finds the Record model by its id.\r\n561:\tFindRecordById(collectionModelOrIdentifier any, recordId string, optFilters ...func(q *dbx.SelectQuery) error) (*Record, error)\r\n668:\t//\trecord, _ := app.FindRecordById(\"example\", \"RECORD_ID\")\r\n"]
