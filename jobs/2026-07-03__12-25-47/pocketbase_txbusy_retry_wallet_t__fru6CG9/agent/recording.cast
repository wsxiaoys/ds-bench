[475.953461, "i", "cat > /tmp/concurrent_test.sh << 'EOF'\n#!/bin/bash\nTOKEN=$1\nN=${2:-50}\nfor i in $(seq 1 $N); do\n  curl -s -o /dev/null -w \"$i: %{http_code}\\n\" -X POST http://localhost:8090/api/wallets/transfer \\\n    -H \"Authorization: $TOKEN\" \\\n    -H 'Content-Type: application/json' \\\n    -d '{\"fromId\":\"a0frewkjzzoxu1f\",\"toId\":\"w4bh7xj1jdy6dzq\",\"amount\":1}' &\ndone\nwait\nEOF\nchmod +x /tmp/concurrent_test.sh\n"]
