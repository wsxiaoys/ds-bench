[168.894143, "o", "/root/go/pkg/mod/github.com/pocketbase/pocketbase@v0.31.0/core/collection_model.go:792:func onCollectionSave(e *CollectionEvent) error {\r\n/root/go/pkg/mod/github.com/pocketbase/pocketbase@v0.31.0/core/collection_model.go:819:func onCollectionSaveExecute(e *CollectionEvent) error {\r\n/root/go/pkg/mod/github.com/pocketbase/pocketbase@v0.31.0/core/collection_model_test.go:1257:func TestCollectionSaveModel(t *testing.T) {\r\n/root/go/pkg/mod/github.com/pocketbase/pocketbase@v0.31.0/core/collection_model_test.go:1478:func TestCollectionSaveIndirectViewsUpdate(t *testing.T) {\r\n/root/go/pkg/mod/github.com/pocketbase/pocketbase@v0.31.0/core/collection_model_test.go:1534:func TestCollectionSaveViewWrapping(t *testing.T) {\r\n/root/go/pkg/mod/github.com/pocketbase/pocketbase@v0.31.0/core/db.go:178:func (app *BaseApp) Save(model Model) error {\r\n/root/go/pkg/mod/github.com/pocketbase/pocketbase@v0.31.0/core/db.go:185:func (app *BaseApp) SaveWithContext(ctx context.Context, model Model) error {\r\n/root/go/pkg/mod/github.com/pocketbase/pocketbase@v0.31.0/core/db.go:192:func (app *BaseApp) SaveNoValidate(model Model) error {\r\n/root/go/pkg/mod/github.com/pocketbase/pocketbase@v0.31.0/core/db.go:200:func (app *BaseApp) SaveNoValidateWithContext(ctx context.Context, model Model) error {\r\n/root/go/pkg/mod/github.com/pocketbase/pocketbase@v0.31.0/core/db.go:207:func (app *BaseApp) AuxSave(model Model) error {\r\n"]
