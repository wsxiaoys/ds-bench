[503.204179, "i", "cat > /tmp/concurrent_mixed.sh << 'EOF'\n#!/bin/bash\nTOKEN=$1\nN=${2:-50}\nfor i in $(seq 1 $N); do\n  if [ $((i % 2)) -eq 0 ]; then\n    BODY='{\"fromId\":\"a0frewkjzzoxu1f\",\"toId\":\"w4bh7xj1jdy6dzq\",\"amount\":1}'\n  else\n    BODY='{\"fromId\":\"w4bh7xj1jdy6dzq\",\"toId\":\"a0frewkjzzoxu1f\",\"amount\":1}'\n  fi\n  curl -s -o /dev/null -w \"$i: %{http_code}\\n\" -X POST http://localhost:8090/api/wallets/transfer \\\n    -H \"Authorization: $TOKEN\" \\\n    -H 'Content-Type: application/json' \\\n    -d \"$BODY\" &\ndone\nwait\nEOF\nchmod +x /tmp/concurrent_mixed.sh\n"]
[503.204491, "o", "cat > /tmp/concurrent_mixed.sh << 'EOF'\r\n\u001b[?2004l\r"]
