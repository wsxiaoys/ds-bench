[47.668165, "o", "        branch = status.current_branch\r\n\u001b[?2004l\r"]
[47.668211, "o", "\u001b[?2004h> "]
[47.668334, "o", "        print(f\"Current branch: {branch}\")\r\n\u001b[?2004l\r\u001b[?2004h"]
[47.668381, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h"]
[47.668405, "o", "> "]
[47.668466, "o", "        # Read README\r\n\u001b[?2004l\r\u001b[?2004h> "]
[47.668694, "o", "        readme_bytes = sandbox.fs.download_file(f'{clone_path}/README')\r\n\u001b[?2004l\r\u001b[?2004h"]
[47.668716, "o", "> "]
[47.668816, "o", "        if readme_bytes is None:\r\n\u001b[?2004l\r"]
[47.668837, "o", "\u001b[?2004h> "]
[47.668966, "o", "            # Fallback to process exec\r\n\u001b[?2004l\r"]
[47.668987, "o", "\u001b[?2004h> "]
[47.669185, "o", "            result = sandbox.process.exec(f'cat {clone_path}/README')\r\n\u001b[?2004l\r"]
[47.669205, "o", "\u001b[?2004h> "]
[47.669414, "o", "            readme_text = result.result if hasattr(result, 'result') else str(result)\r\n\u001b[?2004l\r\u001b[?2004h"]
[47.669434, "o", "> "]
[47.669477, "o", "        else:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[47.669662, "o", "            readme_text = readme_bytes.decode('utf-8', errors='replace')\r\n\u001b[?2004l\r"]
[47.669682, "o", "\u001b[?2004h> "]
[47.669857, "o", "        first_line = readme_text.splitlines()[0] if readme_text else ''\r\n\u001b[?2004l\r\u001b[?2004h"]
[47.669894, "o", "> "]
[47.67001, "o", "        print(f\"README first line: {first_line}\")\r\n\u001b[?2004l\r\u001b[?2004h"]
[47.67003, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h"]
[47.670069, "o", "> "]
[47.670124, "o", "        # Write to output.log\r\n\u001b[?2004l\r"]
[47.670157, "o", "\u001b[?2004h> "]
[47.67025, "o", "        with open(output_path, 'w') as f:\r\n\u001b[?2004l\r"]
[47.670286, "o", "\u001b[?2004h> "]
[47.670377, "o", "            f.write(f'Branch: {branch}\\n')\r\n\u001b[?2004l\r"]
[47.6704, "o", "\u001b[?2004h> "]
[47.670513, "o", "            f.write(f'README: {first_line}\\n')\r\n\u001b[?2004l\r\u001b[?2004h"]
[47.670534, "o", "> "]
[47.670616, "o", "        print(\"Wrote output.log\")\r\n\u001b[?2004l\r\u001b[?2004h"]
[47.670653, "o", "> "]
[47.670673, "o", "    finally:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[47.670769, "o", "        if sandbox is not None:\r\n\u001b[?2004l\r\u001b[?2004h"]
[47.670791, "o", "> "]
[47.670834, "o", "            try:\r\n\u001b[?2004l\r\u001b[?2004h"]
[47.670856, "o", "> "]
[47.670971, "o", "                print(\"Deleting sandbox...\")\r\n\u001b[?2004l\r\u001b[?2004h"]
[47.670994, "o", "> "]
[47.671072, "o", "                sandbox.delete()\r\n\u001b[?2004l\r\u001b[?2004h"]
[47.671104, "o", "> "]
[47.671193, "o", "                print(\"Sandbox deleted\")\r\n\u001b[?2004l\r\u001b[?2004h"]
[47.671224, "o", "> "]
[47.671305, "o", "            except Exception as e:\r\n\u001b[?2004l\r\u001b[?2004h"]
[47.671339, "o", "> "]
[47.671483, "o", "                print(f\"Failed to delete sandbox: {e}\")\r\n\u001b[?2004l\r"]
[47.671502, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[47.671542, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[47.671562, "o", "> "]
[47.671647, "o", "if __name__ == '__main__':\r\n\u001b[?2004l\r"]
[47.671678, "o", "\u001b[?2004h> "]
[47.671699, "o", "    main()\r\n\u001b[?2004l\r"]
