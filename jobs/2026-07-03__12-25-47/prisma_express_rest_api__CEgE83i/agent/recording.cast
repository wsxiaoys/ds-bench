[309.389683, "o", "\u001b[?2004hroot@597895b8-2f71-4512-b4ef-6078c52d353b:/home/user/myproject# "]
[312.475812, "i", "cat server.js | head -25\n"]
[312.475999, "o", "\u001b[?2004l\r\r\n"]
[312.477948, "o", "const path = require('path');\r\n// Load .env if DATABASE_URL isn't already set\r\nif (!process.env.DATABASE_URL) {\r\n  try {\r\n    const fs = require('fs');\r\n    const envPath = path.join(__dirname, '.env');\r\n    if (fs.existsSync(envPath)) {\r\n      const content = fs.readFileSync(envPath, 'utf8');\r\n      for (const line of content.split('\\n')) {\r\n        const m = line.match(/^\\s*([A-Z_][A-Z0-9_]*)\\s*=\\s*\"?(.*?)\"?\\s*$/i);\r\n        if (m) {\r\n          process.env[m[1]] = m[2];\r\n        }\r\n      }\r\n"]
[312.477981, "o", "    }\r\n  } catch (_) {}\r\n}\r\n\r\nconst express = require('express');\r\nconst { PrismaClient } = require('./generated/prisma');\r\nconst { PrismaBetterSqlite3 } = require('@prisma/adapter-better-sqlite3');\r\n\r\nconst dbUrl = process.env.DATABASE_URL || 'file:./dev.db';\r\nconst sqlitePath = dbUrl.startsWith('file:') ? dbUrl.slice('file:'.length) : dbUrl;\r\n\r\n"]
[312.47816, "o", "\u001b[?2004hroot@597895b8-2f71-4512-b4ef-6078c52d353b:/home/user/myproject# "]
[312.780891, "i", "node server.js > server.log 2>&1 &\n"]
[312.781115, "o", "\u001b[?2004l\r\r\n"]
[312.781439, "o", "[1] 2783\r\n"]
[312.781543, "o", "\u001b[?2004h"]
[312.781572, "o", "root@597895b8-2f71-4512-b4ef-6078c52d353b:/home/user/myproject# "]
[313.297569, "i", "sleep 2 && cat server.log\n"]
[313.297764, "o", "\u001b[?2004l\r\r\n"]
