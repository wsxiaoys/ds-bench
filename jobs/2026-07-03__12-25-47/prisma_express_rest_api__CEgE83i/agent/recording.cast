[19.8992, "o", "cat prisma/schema.prisma\r\n\u001b[?2004l\r"]
[19.900085, "o", "// This is your Prisma schema file,\r\n// learn more about it in the docs: https://pris.ly/d/prisma-schema\r\n\r\ngenerator client {\r\n  provider = \"prisma-client-js\"\r\n  output   = \"../generated/prisma\"\r\n}\r\n\r\ndatasource db {\r\n  provider = \"sqlite\"\r\n  url      = env(\"DATABASE_URL\")\r\n}\r\n\r\nmodel User {\r\n  id    String @id @default(cuid())\r\n  email String @unique\r\n  name  String\r\n  tasks Task[]\r\n}\r\n\r\nmodel Task {\r\n  id          String   @id @default(cuid())\r\n  title       String\r\n  description String?\r\n  status      String   @default(\"todo\")\r\n  priority    Int      @default(0)\r\n  userId      String\r\n  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)\r\n  createdAt   DateTime @default(now())\r\n  updatedAt   DateTime @updatedAt\r\n\r\n  @@index([userId])\r\n  @@index([status])\r\n}\r\n"]
[19.900259, "o", "\u001b[?2004hroot@597895b8-2f71-4512-b4ef-6078c52d353b:/home/user/myproject# "]
[23.229512, "i", "npx prisma --help\n"]
[23.229781, "o", "npx prisma --help\r\n\u001b[?2004l\r"]
[24.28189, "o", "\u001b[2mLoaded Prisma config from prisma.config.ts.\r\n\u001b[22m\r\n"]
[24.282241, "o", "\r\n    \u001b[1m\u001b[32m◭  \u001b[39m\u001b[22mPrisma is a modern DB toolkit to query, migrate and model your database (\u001b[4mhttps://prisma.io\u001b[24m)\r\n\r\n    \u001b[1mUsage\u001b[22m\r\n\r\n      \u001b[2m$\u001b[22m prisma [command]\r\n\r\n    \u001b[1mCommands\u001b[22m\r\n\r\n                init   Set up Prisma for your app\r\n           bootstrap   Bootstrap a Prisma Postgres project\r\n                 dev   Start a local Prisma Postgres server for development\r\n            generate   Generate artifacts (e.g. Prisma Client)\r\n                  db   Manage your database schema and lifecycle\r\n             migrate   Migrate your database\r\n              studio   Browse your data with Prisma Studio\r\n            validate   Validate your Prisma schema\r\n              format   Format your Prisma schema\r\n             version   Displays Prisma version info\r\n               debug   Displays Prisma debug info\r\n            platform   Prisma Data Platform commands\r\n            postgres   Manage Prisma Postgres databases\r\n                 mcp   Starts an MCP server to use with AI development tools\r\n\r\n    \u001b[1mFlags\u001b[22m\r\n\r\n         --preview-feature   Run Preview Prisma commands\r\n         --help, -h          Show additional information about a command\r\n\r\n\u001b[90m\u001b[90m┌─\u001b[39m\u001b[90m\u001b[90m──────────────────────────────────────────────────────────────────────────────────────┐\u001b[39m\u001b[90m\r\n\u001b[90m│\u001b[39m\u001b[90m  \u001b[0mOptimize performance through connection pooling and caching with Prisma Accelerate.\u001b[0m  \u001b[90m│\u001b[39m\u001b[90m\r\n\u001b[90m│\u001b[39m\u001b[90m  \u001b[0mLearn more at \u001b[4mhttps://pris.ly/cli/pdp\u001b[24m\u001b[0m                                                \u001b[90m│\u001b[39m\u001b[90m\r\n└───────────────────────────────────────────────────────────────────────────────────────┘\u001b[39m\r\n\r\n    \u001b[1mExamples\u001b[22m\r\n\r\n      Set up a new local Prisma Postgres `prisma dev`-ready project\r\n      \u001b[2m$\u001b[22m prisma init\r\n\r\n      Start a local Prisma Postgres server for development\r\n      \u001b[2m$\u001b[22m prisma dev\r\n\r\n      Generate artifacts (e.g. Prisma Client)\r\n      \u001b[2m$\u001b[22m prisma generate\r\n\r\n      Browse your data\r\n      \u001b[2m$\u001b[22m prisma studio\r\n\r\n      Create migrations from your Prisma schema, apply them to the database, generate artifacts (e.g. Prisma Client)\r\n      \u001b[2m$\u001b[22m prisma migrate dev\r\n\r\n      Pull the schema from an existing database, updating the Prisma schema\r\n      \u001b[2m$\u001b[22m prisma db pull\r\n\r\n      Push the Prisma schema state to the database\r\n      \u001b[2m$\u001b[22m prisma db push\r\n\r\n      Validate your Prisma schema\r\n      \u001b[2m$\u001b[22m prisma validate\r\n\r\n      Format your Prisma schema\r\n      \u001b[2m$\u001b[22m prisma format\r\n\r\n      Display Prisma version info\r\n      \u001b[2m$\u001b[22m prisma version\r\n\r\n      Display Prisma debug info\r\n      \u001b[2m$\u001b[22m prisma debug\r\n\r\n"]
