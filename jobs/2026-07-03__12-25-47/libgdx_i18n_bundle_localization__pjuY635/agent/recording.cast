[551.643077, "i", "cat > /home/user/gdx-game/src/main/java/com/example/gdxgame/I18NConsole.java << 'JAVAEOF'\npackage com.example.gdxgame;\n\nimport java.io.BufferedReader;\nimport java.io.FileReader;\nimport java.io.InputStream;\nimport java.io.InputStreamReader;\nimport java.nio.charset.StandardCharsets;\nimport java.util.HashMap;\nimport java.util.Locale;\nimport java.util.Map;\nimport java.util.Properties;\n\nimport com.badlogic.gdx.ApplicationListener;\nimport com.badlogic.gdx.Gdx;\nimport com.badlogic.gdx.files.FileHandle;\nimport com.badlogic.gdx.utils.I18NBundle;\n\npublic class I18NConsole implements ApplicationListener {\n\n    private final String inputFile;\n    private volatile boolean finished = false;\n    private volatile int exitCode = 0;\n\n    public I18NConsole(String inputFile) {\n        this.inputFile = inputFile;\n    }\n\n    public boolean isFinished() {\n        return finished;\n    }\n\n    public int getExitCode() {\n        return exitCode;\n    }\n\n    private Properties loadProps(String resourcePath) throws Exception {\n        Properties p = new Properties();\n        InputStream in = Thread.currentThread().getContextClassLoader().getResourceAsStream(resourcePath);\n        if (in == null) {\n            in = I18NConsole.class.getClassLoader().getResourceAsStream(resourcePath);\n        }\n        if (in == null) {\n            throw new java.io.FileNotFoundException(resourcePath);\n        }\n        try (InputStream stream = in; InputStreamReader r = new InputStreamReader(stream, StandardCharsets.UTF_8)) {\n            p.load(r);\n        }\n        return p;\n    }\n\n    private String localeResourcePath(String code) {\n        if (\"en\".equals(code)) {\n            return \"i18n/Messages.properties\";\n        }\n        return \"i18n/Messages_\" + code + \".properties\";\n    }\n\n    @Override\n    public void create() {\n        FileHandle baseFile = Gdx.files.internal(\"i18n/Messages\");\n        Map<String, Properties> localeProps = new HashMap<>();\n        Properties baseProps;\n        try {\n            baseProps = loadProps(\"i18n/Messages.properties\");\n        } catch (Exception e) {\n            System.err.println(\"Error: \" + e.getMessage());\n            exitCode = 1;\n            finished = true;\n            return;\n        }\n\n        I18NBundle activeBundle = null;\n        Properties activeLocaleProps = null;\n        int localExit = 0;\n        boolean done = false;\n\n        try (BufferedReader reader = new BufferedReader(new FileReader(inputFile))) {\n            String line;\n            while (!done && (line = reader.readLine()) != null) {\n                String trimmed = line.trim();\n                if (trimmed.isEmpty() || trimmed.startsWith(\"#\")) {\n                    continue;\n                }\n                String[] tokens = trimmed.split(\"\\\\s+\");\n                String cmd = tokens[0];\n\n                if (\"LOCALE\".equals(cmd)) {\n                    if (tokens.length < 2) {\n                        System.err.println(\"Error: unsupported locale \");\n                        localExit = 1;\n                        done = true;\n                        break;\n                    }\n                    String code = tokens[1];\n                    Locale locale;\n                    switch (code) {\n                        case \"en\":\n                            locale = new Locale(\"en\");\n                            break;\n                        case \"fr\":\n                            locale = new Locale(\"fr\");\n                            break;\n                        case \"de\":\n                            locale = new Locale(\"de\");\n                            break;\n                        default:\n                            System.err.println(\"Error: unsupported locale \" + code);\n                            localExit = 1;\n                            done = true;\n                            continue;\n                    }\n                    activeBundle = I18NBundle.createBundle(baseFile, locale);\n                    if (!localeProps.containsKey(code)) {\n                        try {\n                            localeProps.put(code, loadProps(localeResourcePath("]
[551.643195, "i", "code)));\n                        } catch (Exception ex) {\n                            localeProps.put(code, new Properties());\n                        }\n                    }\n                    if (\"en\".equals(code)) {\n                        activeLocaleProps = baseProps;\n                    } else {\n                        activeLocaleProps = localeProps.get(code);\n                    }\n                } else if (\"GET\".equals(cmd)) {\n                    if (tokens.length < 2) {\n                        System.err.println(\"Error: missing key \");\n                        localExit = 1;\n                        done = true;\n                        break;\n                    }\n                    String key = tokens[1];\n                    if (activeBundle == null) {\n                        System.err.println(\"Error: no locale selected\");\n                        localExit = 1;\n                        done = true;\n                        break;\n                    }\n                    if (!activeLocaleProps.containsKey(key) && !baseProps.containsKey(key)) {\n                        System.err.println(\"Error: missing key \" + key);\n                        localExit = 1;\n                        done = true;\n                        break;\n                    }\n                    String value = activeBundle.get(key);\n                    System.out.println(key + \"=\" + value);\n                } else if (\"FORMAT\".equals(cmd)) {\n                    if (tokens.length < 2) {\n                        System.err.println(\"Error: missing key \");\n                        localExit = 1;\n                        done = true;\n                        break;\n                    }\n                    String key = tokens[1];\n                    if (activeBundle == null) {\n                        System.err.println(\"Error: no locale selected\");\n                        localExit = 1;\n                        done = true;\n                        break;\n                    }\n                    if (!activeLocaleProps.containsKey(key) && !baseProps.containsKey(key)) {\n                        System.err.println(\"Error: missing key \" + key);\n                        localExit = 1;\n                        done = true;\n                        break;\n                    }\n                    int argCount = tokens.length - 2;\n                    Object[] args = new Object[argCount];\n                    for (int i = 0; i < argCount; i++) {\n                        args[i] = tokens[2 + i];\n                    }\n                    String value = activeBundle.format(key, args);\n                    System.out.println(key + \"=\" + value);\n                } else {\n                    System.err.println(\"Error: unknown command \" + cmd);\n                    localExit = 1;\n                    done = true;\n                    break;\n                }\n            }\n        } catch (Exception e) {\n            System.err.println(\"Error: \" + e.getMessage());\n            localExit = 1;\n        }\n\n        exitCode = localExit;\n        finished = true;\n    }\n\n    @Override\n    public void render() {\n    }\n\n    @Override\n    public void resize(int width, int height) {\n    }\n\n    @Override\n    public void pause() {\n    }\n\n    @Override\n    public void resume() {\n    }\n\n    @Override\n    public void dispose() {\n    }\n}\nJAVAEOF\n"]
