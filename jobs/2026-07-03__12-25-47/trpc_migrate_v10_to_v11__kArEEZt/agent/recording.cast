[18.894404, "o", "import { trpc } from '../utils/trpc';\r\n\r\nexport default function IndexPage() {\r\n  const hello = trpc.hello.useQuery({ text: 'world' });\r\n  if (!hello.data) {\r\n    return <div>Loading...</div>;\r\n  }\r\n  return (\r\n    <div>\r\n      <p>{hello.data.greeting}</p>\r\n    </div>\r\n  );\r\n}\r\n"]
