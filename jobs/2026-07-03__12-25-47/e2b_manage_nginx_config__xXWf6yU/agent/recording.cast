[185.165457, "o", "\u001b[?2004h> "]
[185.165479, "o", "from e2b import Sandbox\r\n\u001b[?2004l\r\u001b[?2004h"]
[185.165504, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h"]
[185.165567, "o", "> "]
[185.165609, "o", "# Create a new sandbox environment\r\n\u001b[?2004l\r"]
[185.165631, "o", "\u001b[?2004h> "]
[185.1657, "o", "sandbox = Sandbox.create()\r\n\u001b[?2004l\r"]
[185.165725, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[185.165747, "o", "> "]
[185.1659, "o", "# Create the directory /etc/custom_nginx/ (needs sudo)\r\n\u001b[?2004l\r\u001b[?2004h"]
[185.16592, "o", "> "]
[185.166067, "o", "sandbox.commands.run('sudo mkdir -p /etc/custom_nginx/')\r\n\u001b[?2004l\r\u001b[?2004h"]
[185.166092, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[185.166185, "o", "# Nginx configuration content\r\n\u001b[?2004l\r"]
[185.166206, "o", "\u001b[?2004h> "]
[185.166276, "o", "nginx_config = \"\"\"server {\r\n\u001b[?2004l\r"]
[185.166297, "o", "\u001b[?2004h> "]
[185.166342, "o", "    listen 8080;\r\n\u001b[?2004l\r"]
[185.166363, "o", "\u001b[?2004h> "]
[185.166433, "o", "    server_name localhost;\r\n\u001b[?2004l\r"]
[185.166453, "o", "\u001b[?2004h> "]
[185.166505, "o", "    location / {\r\n\u001b[?2004l\r\u001b[?2004h"]
[185.166525, "o", "> "]
[185.166591, "o", "        root /var/www/html;\r\n\u001b[?2004l\r"]
[185.166611, "o", "\u001b[?2004h> "]
[185.166678, "o", "        index index.html;\r\n\u001b[?2004l\r"]
[185.166698, "o", "\u001b[?2004h> "]
[185.166722, "o", "    }\r\n\u001b[?2004l\r\u001b[?2004h"]
[185.166743, "o", "> }\"\"\"\r\n\u001b[?2004l\r"]
[185.16677, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[185.166792, "o", "\u001b[?2004h> "]
[185.166948, "o", "# Write the configuration file to a temp location first\r\n\u001b[?2004l\r\u001b[?2004h"]
[185.16697, "o", "> "]
[185.167067, "o", "with open('/tmp/nginx.conf', 'w') as f:\r\n\u001b[?2004l\r"]
[185.167088, "o", "\u001b[?2004h> "]
[185.167156, "o", "    f.write(nginx_config)\r\n\u001b[?2004l\r"]
[185.16718, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[185.167202, "o", "\u001b[?2004h> "]
[185.167301, "o", "# Move it to the destination with sudo\r\n\u001b[?2004l\r"]
[185.167322, "o", "\u001b[?2004h> "]
[185.167514, "o", "sandbox.commands.run('sudo cp /tmp/nginx.conf /etc/custom_nginx/nginx.conf')\r\n\u001b[?2004l\r"]
[185.16754, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[185.167562, "o", "\u001b[?2004h> "]
[185.167706, "o", "# Also use sandbox.files.write to /tmp first then sudo mv\r\n\u001b[?2004l\r"]
[185.167727, "o", "\u001b[?2004h> "]
[185.167791, "o", "# Read it back to verify\r\n\u001b[?2004l\r"]
[185.167814, "o", "\u001b[?2004h> "]
[185.168002, "o", "result = sandbox.commands.run('sudo cat /etc/custom_nginx/nginx.conf')\r\n\u001b[?2004l\r\u001b[?2004h"]
[185.168022, "o", "> "]
[185.168087, "o", "read_back = result.stdout\r\n\u001b[?2004l\r"]
[185.168109, "o", "\u001b[?2004h> "]
[185.168231, "o", "print(\"=== Content read back from sandbox ===\")\r\n\u001b[?2004l\r"]
[185.168255, "o", "\u001b[?2004h> "]
[185.168302, "o", "print(read_back)\r\n\u001b[?2004l\r"]
[185.168323, "o", "\u001b[?2004h> "]
[185.168407, "o", "print(\"=== End of content ===\")\r\n\u001b[?2004l\r"]
[185.168432, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[185.168452, "o", "\u001b[?2004h> "]
[185.168608, "o", "# Write the sandbox_id to the JSON file on the host machine\r\n\u001b[?2004l\r\u001b[?2004h"]
[185.168629, "o", "> "]
[185.168677, "o", "task_info = {\r\n\u001b[?2004l\r\u001b[?2004h"]
[185.168698, "o", "> "]
[185.168788, "o", "    \"sandbox_id\": sandbox.sandbox_id\r\n\u001b[?2004l\r"]
[185.168812, "o", "\u001b[?2004h> "]
[185.168862, "o", "}\r\n\u001b[?2004l\r\u001b[?2004h> "]
[185.169001, "o", "with open('/home/user/e2b_task_info.json', 'w') as f:\r\n\u001b[?2004l\r\u001b[?2004h"]
[185.169025, "o", "> "]
[185.169114, "o", "    json.dump(task_info, f, indent=2)\r\n\u001b[?2004l\r"]
[185.169137, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[185.169189, "o", "\u001b[?2004h> "]
[185.169271, "o", "print(f\"Sandbox ID: {sandbox.sandbox_id}\")\r\n\u001b[?2004l\r"]
[185.169314, "o", "\u001b[?2004h> "]
[185.169442, "o", "print(f\"JSON info written to /home/user/e2b_task_info.json\")\r\n\u001b[?2004l\r"]
[185.169467, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[185.169542, "o", "\u001b[?2004h> "]
[185.169626, "o", "# Keep the sandbox alive with a long timeout\r\n\u001b[?2004l\r"]
[185.169646, "o", "\u001b[?2004h> "]
[185.169733, "o", "sandbox.set_timeout(3600)\r\n\u001b[?2004l\r"]
[185.169757, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[185.16978, "o", "\u001b[?2004h> "]
[185.169954, "o", "# Wait to keep the script alive so the sandbox persists\r\n\u001b[?2004l\r"]
[185.169978, "o", "\u001b[?2004h> "]
[185.170144, "o", "print(\"Sandbox is alive. Sleeping to keep it running...\")\r\n\u001b[?2004l\r"]
[185.170166, "o", "\u001b[?2004h> "]
[185.170221, "o", "time.sleep(60)\r\n\u001b[?2004l\r"]
[185.170245, "o", "\u001b[?2004h> "]
[185.170268, "o", "PYEOF\r\n\u001b[?2004l\r"]
[185.171632, "o", "\u001b[?2004hroot@239c5c66-ad74-4b5d-ae9c-5266a2e4cc03:/home/user# "]
[185.480092, "i", "cat /home/user/provision.py\n"]
[185.480322, "o", "cat /home/user/provision.py\r\n\u001b[?2004l\r"]
[185.481456, "o", "import os\r\nimport json\r\nimport time\r\nfrom e2b import Sandbox\r\n\r\n# Create a new sandbox environment\r\nsandbox = Sandbox.create()\r\n\r\n# Create the directory /etc/custom_nginx/ (needs sudo)\r\nsandbox.commands.run('sudo mkdir -p /etc/custom_nginx/')\r\n\r\n# Nginx configuration content\r\nnginx_config = \"\"\"server {\r\n    listen 8080;\r\n    server_name localhost;\r\n    location / {\r\n        root /var/www/html;\r\n        index index.html;\r\n    }\r\n}\"\"\"\r\n\r\n# Write the configuration file to a temp location first\r\nwith open('/tmp/nginx.conf', 'w') as f:\r\n    f.write(nginx_config)\r\n\r\n# Move it to the destination with sudo\r\nsandbox.commands.run('sudo cp /tmp/nginx.conf /etc/custom_nginx/nginx.conf')\r\n\r\n# Also use sandbox.files.write to /tmp first then sudo mv\r\n# Read it back to verify\r\nresult = sandbox.commands.run('sudo cat /etc/custom_nginx/nginx.conf')\r\nread_back = result.stdout\r\nprint(\"=== Content read back from sandbox ===\")\r\nprint(read_back)\r\nprint(\"=== End of content ===\")\r\n\r\n# Write the sandbox_id to the JSON file on the host machine\r\ntask_info = {\r\n    \"sandbox_id\": sandbox.sandbox_id\r\n}\r\nwith open('/home/user/e2b_task_info.json', 'w') as f:\r\n    json.dump(task_info, f, indent=2)\r\n\r\nprint(f\"Sandbox ID: {sandbox.sandbox_id}\")\r\nprint(f\"JSON info written to /home/user/e2b_task_info.json\")\r\n\r\n# Keep the sandbox alive with a long timeout\r\nsandbox.set_timeout(3600)\r\n\r\n# Wait to keep the script alive so the sandbox persists\r\nprint(\"Sandbox is alive. Sleeping to keep it running...\")\r\ntime.sleep(60)"]
[185.481482, "o", "\r\n"]
[185.481651, "o", "\u001b[?2004hroot@239c5c66-ad74-4b5d-ae9c-5266a2e4cc03:/home/user# "]
[193.57133, "i", "cat > /home/user/provision.py << 'PYEOF'\nimport os\nimport json\nimport time\nfrom e2b import Sandbox\n\n# Create a new sandbox environment\nsandbox = Sandbox.create()\n\n# Create the directory /etc/custom_nginx/ (needs sudo because sandbox user isn't root)\nsandbox.commands.run('sudo mkdir -p /etc/custom_nginx/')\n\n# Nginx configuration content\nnginx_config = \"\"\"server {\n    listen 8080;\n    server_name localhost;\n    location / {\n        root /var/www/html;\n        index index.html;\n    }\n}\"\"\"\n\n# Write the file to /tmp in the sandbox first, then move with sudo\nsandbox.files.write('/tmp/nginx.conf', nginx_config)\nsandbox.commands.run('sudo cp /tmp/nginx.conf /etc/custom_nginx/nginx.conf')\n\n# Read it back to verify using sandbox.files.read with sudo cat via commands\nresult = sandbox.commands.run('sudo cat /etc/custom_nginx/nginx.conf')\nread_back = result.stdout\nprint(\"=== Content read back from sandbox ===\")\nprint(read_back)\nprint(\"=== End of content ===\")\n\n# Write the sandbox_id to the JSON file on the host machine\ntask_info = {\n    \"sandbox_id\": sandbox.sandbox_id\n}\nwith open('/home/user/e2b_task_info.json', 'w') as f:\n    json.dump(task_info, f, indent=2)\n\nprint(f\"Sandbox ID: {sandbox.sandbox_id}\")\nprint(f\"JSON info written to /home/user/e2b_task_info.json\")\n\n# Keep the sandbox alive with a long timeout\nsandbox.set_timeout(3600)\n\n# Wait to keep the script alive so the sandbox persists\nprint(\"Sandbox is alive. Sleeping to keep it running...\")\ntime.sleep(60)\nPYEOF\n"]
