[168.981288, "o", "nohup: ignoring input\r\nTraceback (most recent call last):\r\n  File \"/home/user/provision.py\", line 10, in <module>\r\n    sandbox.commands.run('mkdir -p /etc/custom_nginx/')\r\n  File \"/usr/local/lib/python3.12/dist-packages/e2b/sandbox_sync/commands/command.py\", line 298, in run\r\n    else proc.wait(\r\n         ^^^^^^^^^^\r\n  File \"/usr/local/lib/python3.12/dist-packages/e2b/sandbox_sync/commands/command_handle.py\", line 189, in wait\r\n    raise CommandExitException(\r\ne2b.sandbox.commands.command_handle.CommandExitException: Command exited with code 1 and error:\r\nmkdir: cannot create directory '/etc/custom_nginx/': Permission denied\r\n\r\n"]
