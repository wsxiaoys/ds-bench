[19.870623, "o", "// This is your Prisma schema file,\r\n// learn more about it in the docs: https://pris.ly/d/prisma-schema\r\n\r\ngenerator client {\r\n  provider = \"prisma-client-js\"\r\n}\r\n\r\ndatasource db {\r\n  provider = \"sqlite\"\r\n  url      = env(\"DATABASE_URL\")\r\n}\r\n\r\nmodel Note {\r\n  id       Int    @id @default(REDACTEDincrement())\r\n  content  String\r\n  tenantId String\r\n}\r\n"]
