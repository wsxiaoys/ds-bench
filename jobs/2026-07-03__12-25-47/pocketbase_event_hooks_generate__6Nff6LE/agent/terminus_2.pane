func main() {
go.app := pocketbase.New()

go.app.OnRecordBeforeCreateRequest("posts").BindFunc(func(e *core.RecordRequestEvent) error {
go.title := e.Record.GetString("title")
go.if title == "" {
go.return e.BadRequestError("Title cannot be empty", nil)
go.}
go.e.Record.Set("slug", core.Slugify(title))
go.return e.Next()
go.})

go.if err := app.Start(); err != nil {
go.log.Fatal(err)
go.}
}
