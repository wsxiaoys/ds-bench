[46.460033, "o", "package main$\r\n$\r\nimport ($\r\n^I\"log\"$\r\n$\r\n^I\"github.com/pocketbase/pocketbase/core\"$\r\n"]
[46.46013, "o", "^I\"github.com/pocketbase/pocketbase\"$\r\n)$\r\n$\r\nfunc main() {$\r\n^Iapp := pocketbase.New()$\r\n$\r\n^Iapp.OnRecordBeforeCreateRequest(\"posts\").BindFunc(func(e *core.RecordRequestEvent) error {$\r\n^I^Ititle := e.Record.GetString(\"title\")$\r\n^I^Iif title == \"\" {$\r\n^I^I^Ireturn e.BadRequestError(\"Title cannot be empty\", nil)$\r\n^I^I}$\r\n^I^Ie.Record.Set(\"slug\", core.Slugify(title))$\r\n^I^Ireturn e.Next()$\r\n^I})$\r\n"]
