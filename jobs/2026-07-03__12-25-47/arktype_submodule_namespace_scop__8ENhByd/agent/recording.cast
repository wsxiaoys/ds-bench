[514.141371, "i", "cat > src/test_module.ts << 'EOF'\nimport { scope } from 'arktype';\n\n// Approach 6: Use a Module as a value, where the value of each alias is a thunk that returns a parsed node\ntry {\n  const outer = scope({\n    db: {\n      User: { id: 'string.uuid' },\n      Org: { id: 'string.uuid' }\n    },\n    api: {\n      CreateUserRequest: () => ({ user: 'db.User' }),\n      CreateOrgRequest: () => ({ org: 'db.Org' })\n    }\n  });\n  const exported = outer.export();\n  console.log('exported keys:', Object.keys(exported));\n  console.log('exported.api:', exported.api);\n  console.log('exported.api.CreateUserRequest:', exported.api?.CreateUserRequest);\n  console.log('exported.db.User:', exported.db?.User);\n} catch (e) {\n  console.log('failed:', e.message);\n}\nEOF\nnpx tsx src/test_module.ts 2>&1 | head -30\n"]
