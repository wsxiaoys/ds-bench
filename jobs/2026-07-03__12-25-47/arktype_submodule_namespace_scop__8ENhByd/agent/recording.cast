[386.770951, "i", "cat > src/test_module.ts << 'EOF'\nimport { scope, Module } from 'arktype';\n\n// Approach 5: outer scope, inner modules with cross-references\n// Use Scope.module to create the db and api submodules\n// But we need a way for the api module to reference db.User\n\n// Try: use a thunk so the inner scope is created after db is in the outer scope\ntry {\n  const m = scope({\n    db: Module.new ? null : null,  // try later\n  });\n} catch (e) {}\n\n// Use new Module directly\ntry {\n  const dbModule = new Module({\n    User: { id: 'string.uuid' },\n    Org: { id: 'string.uuid' }\n  });\n  console.log('dbModule:', dbModule);\n  console.log('dbModule keys:', Object.keys(dbModule));\n  const apiModule = new Module({\n    CreateUserRequest: { user: 'db.User' }\n  });\n  console.log('apiModule:', apiModule);\n  const outer = scope({\n    db: dbModule,\n    api: apiModule\n  });\n  console.log('outer.db:', outer.db);\n  console.log('outer.api:', outer.api);\n  const exported = outer.export();\n  console.log('exported.db.User:', exported.db?.User);\n  console.log('exported.api.CreateUserRequest:', exported.api?.CreateUserRequest);\n} catch (e) {\n  console.log('Approach failed:', e.message);\n  console.log(e.stack);\n}\nEOF\nnpx tsx src/test_module.ts\n"]
