[?2004hroot@3296d218-014f-4885-ba31-c4a589988247:/home/user/cleanup-app# cat /home/user/cleanup-app/cleanup/cleanup.go
[?2004lpackage cleanup

import (
    "context"
    "time"
)

//encore:api public method=POST path=/cleanup
func Cleanup(ctx context.Context) error {
    cutoff := time.Now().Add(-24 * time.Hour)
    _, err := db.Exec(ctx, `
        DELETE FROM records
        WHERE created_at < $1
    `, cutoff)
    return err
}
