[780.083207, "o", "package cleanup\r\n\r\nimport \"encore.dev/storage/sqldb\"\r\n\r\n//encore:service\r\nvar db = sqldb.NewDatabase(\"cleanup_db\", sqldb.DatabaseConfig{\r\n    Migrations: \"./migrations\",\r\n})\r\n"]
