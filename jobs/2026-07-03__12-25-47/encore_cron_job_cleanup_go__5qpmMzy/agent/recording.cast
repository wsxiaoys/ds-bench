1b[36m\u001b[K-\u001b[m\u001b[K\r\n\u001b[35m\u001b[K/root/.encore/runtimes/go/storage/sqldb/db.go\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\tdb.init()\r\n"]
