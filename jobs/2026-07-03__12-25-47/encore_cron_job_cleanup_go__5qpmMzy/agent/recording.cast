[790.7034, "o", "CREATE TABLE records (\r\n    id TEXT PRIMARY KEY,\r\n    data TEXT NOT NULL,\r\n    created_at TIMESTAMPTZ NOT NULL\r\n);\r\n"]
[790.703643, "o", "\u001b[?2004h"]
[790.703707, "o", "root@3296d218-014f-4885-ba31-c4a589988247:/home/user/cleanup-app# "]
[791.721237, "i", "cat /home/user/cleanup-app/cleanup/cron.go\n"]
[791.72184, "o", "cat /home/user/cleanup-app/cleanup/cron.go\r\n\u001b[?2004l\r"]
[791.724002, "o", "package cleanup\r\n\r\nimport \"encore.dev/cron\"\r\n\r\n//encore:cron\r\nvar _ = cron.NewJob(\"cleanup-cron\", cron.JobConfig{\r\n    Title:    \"Cleanup stale records\",\r\n    Every:    1 * cron.Hour,\r\n    Endpoint: Cleanup,\r\n})\r\n"]
[791.72434, "o", "\u001b[?2004hroot@3296d218-014f-4885-ba31-c4a589988247:/home/user/cleanup-app# "]
[792.297056, "i", "cat /home/user/cleanup-app/cleanup/cleanup.go\n"]
[792.297388, "o", "cat /home/user/cleanup-app/cleanup/cleanup.go\r\n\u001b[?2004l\r"]
[792.29966, "o", "package cleanup\r\n\r\nimport (\r\n    \"context\"\r\n    \"time\"\r\n)\r\n\r\n//encore:api public method=POST path=/cleanup\r\nfunc Cleanup(ctx context.Context) error {\r\n    cutoff := time.Now().Add(-24 * time.Hour)\r\n    _, err := db.Exec(ctx, `\r\n        DELETE FROM records\r\n        WHERE created_at < $1\r\n    `, cutoff)\r\n    return err\r\n}\r\n"]
[792.299959, "o", "\u001b[?2004hroot@3296d218-014f-4885-ba31-c4a589988247:/home/user/cleanup-app# "]
