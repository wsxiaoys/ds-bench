[266.48666, "i", "cat > cleanup/cleanup.go << 'EOF'\npackage cleanup\n\nimport (\n    \"context\"\n    \"time\"\n)\n\n//encore:api public method=POST path=/cleanup\nfunc Cleanup(ctx context.Context) error {\n    cutoff := time.Now().Add(-24 * time.Hour)\n    _, err := db.Exec(ctx, `\n        DELETE FROM records\n        WHERE created_at < $1\n    `, cutoff)\n    return err\n}\nEOF\n"]
