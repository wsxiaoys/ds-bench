[?2004l[?2004hroot@b3385978-6238-410a-a93d-fb66bb468c1f:/home/user/myproject# cat checkout.js
[?2004lconst { PrismaClient } = require('@prisma/client');
const fs = require('fs');

const prisma = new PrismaClient();

async function checkout(productId, quantity) {
  return prisma.$transaction(async (tx) => {
    const product = await tx.product.findUnique({ where: { id: productId } });
    if (!product || product.stock < quantity) {
      throw new Error('Insufficient stock');
    }
    await tx.product.update({
      where: { id: productId },
      data: { stock: { decrement: quantity } },
    });
    const order = await tx.order.create({
      data: { productId, quantity },
    });
    return order;
  });
}

(async () => {
  try {
    const successOrder = await checkout(1, 3);
    console.log('Success order:', successOrder);

    let insufficientStockCaught = false;
    try {
      await checkout(1, 100);
    } catch (e) {
      console.log('Caught error:', e.message);
      insufficientStockCaught = true;
    }

    const finalProduct = await prisma.product.findUnique({ where: { id: 1 } });
    const orderCount = await prisma.order.count();

    const result = {
      finalStock: finalProduct.stock,
      orderCount,
      insufficientStockCaught,
    };

    fs.writeFileSync('/home/user/myproject/checkout_result.json', JSON.stringify(result));
    console.log('Result:', result);
  } catch (e) {
    console.error('Error:', e);
    process.exitCode = 1;
  } finally {
    await prisma.$disconnect();
  }
})();
