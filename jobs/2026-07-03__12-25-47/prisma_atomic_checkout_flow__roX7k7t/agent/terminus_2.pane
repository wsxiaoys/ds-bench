  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Product {
  id     Int     @id @default(REDACTEDincrement())
  name   String
  stock  Int
  orders Order[]
}

model Order {
  id        Int     @id @default(REDACTEDincrement())
  productId Int
  quantity  Int
  product   Product @relation(fields: [productId], references: [id])
}
