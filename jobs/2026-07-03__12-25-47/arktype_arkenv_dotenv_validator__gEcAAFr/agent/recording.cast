[210.604041, "o", "\u001b[?2004h> "]
[210.604286, "o", "  // Collapse the error message down to a single line so that stdout\r\n\u001b[?2004l\r"]
[210.604377, "o", "\u001b[?2004h> "]
[210.604566, "o", "  // contains exactly one non-empty line beginning with `INVALID:`.\r\n\u001b[?2004l\r"]
[210.604615, "o", "\u001b[?2004h> "]
[210.60496, "o", "  const firstLine = raw.split(/\\r?\\n/).map((l) => l.trim()).find((l) => l.length > 0) ?? raw;\r\n\u001b[?2004l\r"]
[210.604989, "o", "\u001b[?2004h> "]
[210.605156, "o", "  console.log(`INVALID: ${firstLine}`);\r\n\u001b[?2004l\r"]
[210.605193, "o", "\u001b[?2004h> }\r\n\u001b[?2004l\r"]
[210.60523, "o", "\u001b[?2004h> "]
[210.605319, "o", "EOF\r\n\u001b[?2004l\r"]
