[93.003629, "o", "cat /home/user/myproject/cli.ts\r\n\u001b[?2004l\r"]
[93.005757, "o", "import { config as loadDotenv } from \"dotenv\";\r\nimport arkenv, { type } from \"arkenv\";\r\n\r\n// Load the .env file at the project root into process.env so that arkenv\r\n// can see all of the values declared in it.\r\nloadDotenv({ path: \"/home/user/myproject/.env\" });\r\n\r\nconst schema = {\r\n  PORT: \"1024 <= number.integer <= 65535\",\r\n  DATABASE_URL: \"string.url\",\r\n  ALLOWED_ORIGINS: \"string.url[] >= 1\",\r\n  LOG_LEVEL: \"'debug' | 'info' | 'warn' | 'error'\",\r\n};\r\n\r\ntry {\r\n  const env = arkenv(schema, { arrayFormat: \"comma\" });\r\n  console.log(\"VALID\");\r\n  console.log(JSON.stringify(env));\r\n} catch (err) {\r\n  const message = err instanceof Error ? err.message : String(err);\r\n  console.log(`INVALID: ${message}`);\r\n}\r\n"]
[93.006083, "o", "\u001b[?2004h"]
