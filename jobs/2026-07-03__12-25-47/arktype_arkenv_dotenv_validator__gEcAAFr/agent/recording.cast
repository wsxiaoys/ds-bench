[62.335986, "i", "cd /tmp && cat > test_arktype.ts << 'EOF'\nimport { type } from 'arktype';\n\n// Test URL validation\nconst urlSchema = type('string.url');\nconsole.log('URL test:', urlSchema('https://example.com'));\nconsole.log('URL test invalid:', urlSchema('not a url'));\n\n// Test integer range\nconst portSchema = type('1024 <= number.integer <= 65535');\nconsole.log('Port 8080:', portSchema('8080'));\nconsole.log('Port 80:', portSchema('80'));\n\n// Test literal\nconst logLevel = type(\"'debug' | 'info' | 'warn' | 'error'\");\nconsole.log('Log debug:', logLevel('debug'));\nconsole.log('Log verbose:', logLevel('verbose'));\n\n// Test array of urls\nconst arrSchema = type('string.url[] >= 1');\nconsole.log('Array URLs:', arrSchema(['https://example.com', 'https://other.com']));\nconsole.log('Array URLs invalid:', arrSchema(['noturl']));\nconsole.log('Empty array:', arrSchema([]));\nEOF\n"]
