[?2004limport { config as loadDotenv } from "dotenv";
import arkenv, { type } from "arkenv";

// Load the .env file at the project root into process.env so that arkenv
// can see all of the values declared in it.
loadDotenv({ path: "/home/user/myproject/.env" });

const schema = {
  PORT: "1024 <= number.integer <= 65535",
  DATABASE_URL: "string.url",
  ALLOWED_ORIGINS: "string.url[] >= 1",
  LOG_LEVEL: "'debug' | 'info' | 'warn' | 'error'",
};

try {
  const env = arkenv(schema, { arrayFormat: "comma" });
  console.log("VALID");
  console.log(JSON.stringify(env));
} catch (err) {
  const message = err instanceof Error ? err.message : String(err);
  console.log(`INVALID: ${message}`);
}
