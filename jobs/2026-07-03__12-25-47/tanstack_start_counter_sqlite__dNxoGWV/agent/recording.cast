[509.541055, "i", "cat > src/routes/index.tsx << 'EOF'\nimport { createFileRoute } from '@tanstack/react-router'\nimport { getCounter, incrementCounter } from '../server/counter'\n\nexport const Route = createFileRoute('/')({\n  loader: async () => {\n    const data = await getCounter()\n    return { count: data.count }\n  },\n  component: Home,\n})\n\nfunction Home() {\n  const { count } = Route.useLoaderData()\n  return (\n    <div className=\"p-8\">\n      <h1 className=\"text-4xl font-bold\">Counter</h1>\n      <p className=\"mt-4 text-lg\" data-testid=\"counter-value\">\n        Current count: <strong>{count}</strong>\n      </p>\n      <form\n        method=\"post\"\n        action=\"/api/counter/increment\"\n        className=\"mt-4\"\n        onSubmit={async (e) => {\n          e.preventDefault()\n          const data = await incrementCounter()\n          window.location.reload()\n        }}\n      >\n        <button\n          type=\"submit\"\n          className=\"px-4 py-2 bg-blue-600 text-white rounded\"\n        >\n          Increment\n        </button>\n      </form>\n    </div>\n  )\n}\nEOF\n"]
