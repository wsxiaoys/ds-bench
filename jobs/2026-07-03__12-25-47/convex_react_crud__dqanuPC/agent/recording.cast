[430.687613, "i", "cat > src/App.css << 'EOF'\n.app {\n  max-width: 700px;\n  margin: 2rem REDACTED;\n  padding: 1rem 2rem;\n  font-family: system-ui, -apple-system, sans-serif;\n}\n\nh1 {\n  text-align: center;\n}\n\n.run-id {\n  text-align: center;\n  color: #666;\n  font-size: 0.85rem;\n}\n\n.add-form {\n  display: flex;\n  gap: 0.5rem;\n  margin: 1rem 0;\n}\n\n.add-form input {\n  flex: 1;\n  padding: 0.5rem;\n  font-size: 1rem;\n}\n\n.add-form button {\n  padding: 0.5rem 1rem;\n  font-size: 1rem;\n  cursor: pointer;\n}\n\n.task-list {\n  list-style: none;\n  padding: 0;\n}\n\n.task {\n  display: flex;\n  align-items: center;\n  gap: 0.5rem;\n  padding: 0.5rem;\n  border: 1px solid #ddd;\n  margin-bottom: 0.5rem;\n  border-radius: 4px;\n}\n\n.task.done .task-text {\n  text-decoration: line-through;\n  color: #888;\n}\n\n.task-text {\n  flex: 1;\n}\n\n.task-status {\n  font-size: 0.75rem;\n  padding: 0.2rem 0.5rem;\n  border-radius: 4px;\n  background: #eee;\n}\n\n.task-actions {\n  display: flex;\n  gap: 0.5rem;\n}\n\n.task-actions button {\n  cursor: pointer;\n}\n\n.task-actions .delete {\n  background: #fee;\n  color: #c00;\n  border: 1px solid #fcc;\n}\n\n.empty {\n  text-align: center;\n  color: #999;\n}\nEOF\n"]
