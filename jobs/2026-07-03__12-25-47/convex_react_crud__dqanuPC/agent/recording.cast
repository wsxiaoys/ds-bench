[274.006862, "o", "import { query, mutation } from \"./_generated/server\";\r\nimport { v } from \"convex/values\";\r\n\r\nexport const get = query({\r\n  args: {\r\n    runId: v.string(),\r\n    status: v.optional(v.union(v.literal(\"todo\"), v.literal(\"done\"))),\r\n  },\r\n  handler: async (ctx, args) => {\r\n    if (args.status !== undefined) {\r\n      return await ctx.db\r\n        .query(\"tasks\")\r\n        .withIndex(\"by_run_id_and_status\", (q) =>\r\n          q.eq(\"runId\", args.runId).eq(\"status\", args.status!)\r\n        )\r\n        .collect();\r\n    }\r\n    return await ctx.db\r\n      .query(\"tasks\")\r\n      .withIndex(\"by_run_id_and_status\", (q) => q.eq(\"runId\", args.runId))\r\n      .collect();\r\n  },\r\n});\r\n\r\nexport const add = mutation({\r\n  args: {\r\n    text: v.string(),\r\n    runId: v.string(),\r\n  },\r\n  handler: async (ctx, args) => {\r\n    const taskId = await ctx.db.insert(\"tasks\", {\r\n      text: args.text,\r\n      status: \"todo\",\r\n      runId: args.runId,\r\n    });\r\n    return taskId;\r\n  },\r\n});\r\n\r\nexport const updateStatus = mutation({\r\n  args: {\r\n    id: v.id(\"tasks\"),\r\n    status: v.union(v.literal(\"todo\"), v.literal(\"done\")),\r\n  },\r\n  handler: async (ctx, args) => {\r\n    await ctx.db.patch(args.id, { status: args.status });\r\n  },\r\n});\r\n\r\nexport const remove = mutation({\r\n  args: {\r\n    id: v.id(\"tasks\"),\r\n  },\r\n  handler: async (ctx, args) => {\r\n    await ctx.db.delete(args.id);\r\n  },\r\n});\r\n"]
