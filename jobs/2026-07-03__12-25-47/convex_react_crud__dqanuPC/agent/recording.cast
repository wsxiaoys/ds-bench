[261.588113, "o", "import { StrictMode } from 'react'\r\nimport { createRoot } from 'react-dom/client'\r\nimport './index.css'\r\nimport App from './App.tsx'\r\n\r\ncreateRoot(document.getElementById('root')!).render(\r\n  <StrictMode>\r\n    <App />\r\n  </StrictMode>,\r\n)\r\n"]
[261.588354, "o", "\u001b[?2004h"]
[261.588403, "o", "root@cdc95b6b-9f57-4f42-a1c7-de5c454325ec:/home/user/my-app# "]
[261.936402, "i", "cat src/App.tsx\n"]
[261.936747, "o", "cat src/App.tsx\r\n\u001b[?2004l\r"]
[261.937843, "o", "import { useState } from 'react'\r\nimport reactLogo from './assets/react.svg'\r\nimport viteLogo from './assets/vite.svg'\r\nimport heroImg from './assets/hero.png'\r\nimport './App.css'\r\n\r\nfunction App() {\r\n  const [count, setCount] = useState(0)\r\n\r\n  return (\r\n    <>\r\n      <section id=\"center\">\r\n        <div className=\"hero\">\r\n          <img src={heroImg} className=\"base\" width=\"170\" height=\"179\" alt=\"\" />\r\n          <img src={reactLogo} className=\"framework\" alt=\"React logo\" />\r\n          <img src={viteLogo} className=\"vite\" alt=\"Vite logo\" />\r\n        </div>\r\n        <div>\r\n          <h1>Get started</h1>\r\n          <p>\r\n            Edit <code>src/App.tsx</code> and save to test <code>HMR</code>\r\n          </p>\r\n        </div>\r\n        <button\r\n          type=\"button\"\r\n          className=\"counter\"\r\n          onClick={() => setCount((count) => count + 1)}\r\n        >\r\n          Count is {count}\r\n        </button>\r\n      </section>\r\n\r\n      <div className=\"ticks\"></div>\r\n\r\n      <section id=\"next-steps\">\r\n        <div id=\"docs\">\r\n          <svg className=\"icon\" role=\"presentation\" aria-hidden=\"true\">\r\n            <use href=\"/icons.svg#documentation-icon\"></use>\r\n          </svg>\r\n          <h2>Documentation</h2>\r\n          <p>Your questions, answered</p>\r\n          <ul>\r\n            <li>\r\n              <a href=\"https://vite.dev/\" target=\"_blank\">\r\n                <img className=\"logo\" src={viteLogo} alt=\"\" />\r\n                Explore Vite\r\n              </a>\r\n            </li>\r\n            <li>\r\n              <a href=\"https://react.dev/\" target=\"_blank\">\r\n                <img className=\"button-icon\" src={reactLogo} alt=\"\" />\r\n                Learn more\r\n              </a>\r\n            </li>\r\n          </ul>\r\n        </div>\r\n        <div id=\"social\">\r\n          <svg className=\"icon\" role=\"presentation\" aria-hidden=\"true\">\r\n            <use href=\"/icons.svg#social-icon\"></use>\r\n          </svg>\r\n          <h2>Connect with us</h2>\r\n          <p>Join the Vite community</p>\r\n          <ul>\r\n            <li>\r\n              <a href=\"https://github.com/vitejs/vite\" target=\"_blank\">\r\n                <svg\r\n                  className=\"button-icon\"\r\n                  role=\"presentation\"\r\n                  aria-hidden=\"true\"\r\n                >\r\n                  <use href=\"/icons.svg#github-icon\"></use>\r\n                </svg>\r\n                GitHub\r\n              </a>\r\n            </li>\r\n            <li>\r\n              <a href=\"https://chat.vite.dev/\" target=\"_blank\">\r\n                <svg\r\n                  className=\"button-icon\"\r\n                  role=\"presentation\"\r\n                  aria-hidden=\"true\"\r\n                >\r\n                  <use href=\"/icons.svg#discord-icon\"></use>\r\n                </svg>\r\n                Discord\r\n              </a>\r\n            </li>\r\n            <li>\r\n              <a href=\"https://x.com/vite_js\" target=\"_blank\">\r\n                <svg\r\n                  className=\"button-icon\"\r\n                  role=\"presentation\"\r\n                  aria-hidden=\"true\"\r\n                >\r\n                  <use href=\"/icons.svg#x-icon\"></use>\r\n                </svg>\r\n                X.com\r\n              </a>\r\n            </li>\r\n            <li>\r\n              <a href=\"https://bsky.app/profile/vite.dev\" target=\"_blank\">\r\n                <svg\r\n                  className=\"button-icon\"\r\n                  role=\"presentation\"\r\n                  aria-hidden=\"true\"\r\n                >\r\n                  <use href=\"/icons.svg#bluesky-icon\"></use>\r\n                </svg>\r\n                Bluesky\r\n              </a>\r\n            </li>\r\n          </ul>\r\n        </div>\r\n      </section>\r\n\r\n      <div className=\"ticks\"></div>\r\n      <section id=\"spacer\"></section>\r\n    </>\r\n  )\r\n}\r\n\r\nexport default App\r\n"]
