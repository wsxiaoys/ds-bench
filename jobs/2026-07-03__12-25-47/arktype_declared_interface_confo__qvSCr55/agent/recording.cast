[443.826842, "i", "cat > test.ts << 'EOF'\nimport { type } from \"arktype\";\nimport type { Product } from \"./types\";\n\n// The parser is { type: ... } - we need it callable.\n// Let me try to wrap it as a Callable\n\nconst parser = type.declare<Product>();\n\n// Make a callable wrapper using a function\nconst callableParser: any = function(def: any) { return parser.type(def); };\nObject.assign(callableParser, parser);\n\nconst schema = callableParser({ id: \"string\", sku: \"string\", price: \"number\", tags: \"string[]\" });\nconsole.log('schema:', typeof schema);\nconst result = schema({ id: \"prod-001\", sku: \"SKU-001\", price: 10, tags: [\"a\"] });\nconsole.log('result:', result);\nconsole.log('Validated product:', result.id);\nEOF\nnpx tsx test.ts\n"]
