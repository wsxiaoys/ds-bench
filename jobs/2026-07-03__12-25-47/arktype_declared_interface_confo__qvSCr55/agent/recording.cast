[475.953191, "i", "cat > test.ts << 'EOF'\n// Let me check the actual @ark/util to see if I can patch declare\nimport { type } from \"arktype\";\nimport type { Product } from \"./types\";\n\n// Looking at scope.js: declare = () => ({ type: this.type })\n// This is not callable. Let me see if I can use a Callable wrapper\n\nimport { Callable } from \"@ark/util\";\n\nconst parser = type.declare<Product>();\n\n// Make a callable wrapper\nclass CallableParser extends Callable<((def: any) => any) & typeof parser> {\n  constructor(p: typeof parser) {\n    super((def: any) => p.type(def), { attach: p as any });\n  }\n}\n\nconst cp = new CallableParser(parser);\nconst schema = cp({ id: \"string\", sku: \"string\", price: \"number\", tags: \"string[]\" });\nconsole.log('schema:', typeof schema);\nEOF\nnpx tsx test.ts\n"]
