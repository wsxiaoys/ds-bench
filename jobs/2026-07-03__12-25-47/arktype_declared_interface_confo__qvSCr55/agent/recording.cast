[339.761771, "i", "cat > test.ts << 'EOF'\nimport { type } from \"arktype\";\nimport type { Product } from \"./types\";\n\nconst parser = type.declare<Product>();\nconsole.log('parser type:', typeof parser);\nconsole.log('parser proto:', Object.getPrototypeOf(parser));\nconsole.log('parser toString:', parser.toString());\n\n// Maybe try calling parser with bind\ntry {\n  const result = parser.call(null, { id: \"string\", sku: \"string\", price: \"number\", tags: \"string[]\" });\n  console.log('call result:', result);\n} catch(e) {\n  console.log('call error:', (e as Error).message);\n}\nEOF\nnpx tsx test.ts\n"]
