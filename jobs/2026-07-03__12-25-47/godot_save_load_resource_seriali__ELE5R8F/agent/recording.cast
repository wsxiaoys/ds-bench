[89.791914, "i", "python3 << 'PYEOF'\ncontent = '''extends Node\nclass_name SaveManager\n\nconst _EXT_TRES := \".tres\"\nconst _EXT_RES := \".res\"\n\nfunc save_to_disk(data: GameSaveData, path: String, binary: bool) -> int:\n\\tvar target_ext: String = _EXT_RES if binary else _EXT_TRES\n\\tvar normalized_path: String = _normalize_save_path(path, target_ext)\n\\tvar err: int = ResourceSaver.save(data, normalized_path)\n\\treturn err\n\nfunc load_from_disk(path: String) -> GameSaveData:\n\\tvar resolved_path: String = _resolve_load_path(path)\n\\tvar res: Resource = ResourceLoader.load(resolved_path, \"\", ResourceLoader.CACHE_MODE_IGNORE)\n\\tif res == null:\n\\t\\treturn null\n\\treturn res as GameSaveData\n\nfunc compute_hash(data: GameSaveData) -> String:\n\\tvar ctx: HashingContext = HashingContext.new()\n\\tctx.start(HashingContext.HASH_SHA256)\n\\t_hash_field(ctx, str(data.player_position.x))\n\\t_hash_field(ctx, str(data.player_position.y))\n\\t_hash_field(ctx, str(data.inventory.size()))\n\\tfor item in data.inventory:\n\\t\\t_hash_field(ctx, str(item.id))\n\\t\\t_hash_field(ctx, str(item.quantity))\n\\t\\t_hash_field(ctx, str(item.rarity))\n\\t_hash_field(ctx, str(data.unlocked_levels.size()))\n\\tfor lvl in data.unlocked_levels:\n\\t\\t_hash_field(ctx, str(lvl))\n\\t_hash_field(ctx, str(data.last_played))\n\\treturn ctx.finish().hex_encode().to_lower()\n\nfunc _hash_field(ctx: HashingContext, value: String) -> void:\n\\tctx.update(value.to_utf8_buffer())\n\\tctx.update(\"|\".to_utf8_buffer())\n\nfunc _normalize_save_path(path: String, target_ext: String) -> String:\n\\tvar p: String = path\n\\tif p.ends_with(_EXT_TRES) or p.ends_with(_EXT_RES):\n\\t\\tp = p.get_basename()\n\\treturn p + target_ext\n\nfunc _resolve_load_path(path: String) -> String:\n\\tif path.ends_with(_EXT_TRES):\n\\t\\tif FileAccess.file_exists(path):\n\\t\\t\\treturn path\n\\t\\tvar res_path: String = path.get_basename() + _EXT_RES\n\\t\\tif FileAccess.file_exists(res_path):\n\\t\\t\\treturn res_path\n\\t\\treturn path\n\\tif path.ends_with(_EXT_RES):\n\\t\\tif FileAccess.file_exists(path):\n\\t\\t\\treturn path\n\\t\\tvar tres_path: String = path.get_basename() + _EXT_TRES\n\\t\\tif FileAccess.file_exists(tres_path):\n\\t\\t\\treturn tres_path\n\\t\\treturn path\n\\tvar candidate_res: String = path + _EXT_RES\n\\tif FileAccess.file_exists(candidate_res):\n\\t\\treturn candidate_res\n\\tvar candidate_tres: String = path + _EXT_TRES\n\\tif FileAccess.file_exists(candidate_tres):\n\\t\\treturn candidate_tres\n\\treturn path\n'''\nwith open('/home/user/myproject/scripts/SaveManager.gd', 'w') as f:\n    f.write(content)\nprint('done')\nPYEOF\n"]
