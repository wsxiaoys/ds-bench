[55.913741, "o", "extends Node$\r\nclass_name SaveManager$\r\n$\r\nconst _EXT_TRES := \".tres\"$\r\nconst _EXT_RES := \".res\"$\r\n$\r\nfunc save_to_disk(data: GameSaveData, path: String, binary: bool) -> int:$\r\n^Ivar target_ext: String = _EXT_RES if binary else _EXT_TRES$\r\n^Ivar normalized_path: String = _normalize_save_path(path, target_ext)$\r\n^Ivar err: int = ResourceSaver.save(data, normalized_path)$\r\n^Ireturn err$\r\n$\r\nfunc load_from_disk(path: String) -> GameSaveData:$\r\n^Ivar resolved_path: String = _resolve_load_path(path)$\r\n^Ivar res: Resource = ResourceLoader.load(resolved_path, \"\", ResourceLoader.CACHE_MODE_IGNORE)$\r\n^Iif res == null:$\r\n^I^Ireturn null$\r\n^Ireturn res as GameSaveData$\r\n$\r\nfunc compute_hash(data: GameSaveData) -> String:$\r\n^Ivar ctx: HashingContext = HashingContext.new()$\r\n^Ictx.start(HashingContext.HASH_SHA256)$\r\n^Ictx.update(str(data.player_position.x))$\r\n^Ictx.update(\"|\")$\r\n^Ictx.update(str(data.player_position.y))$\r\n^Ictx.update(\"|\")$\r\n^Ictx.update(str(data.inventory.size()))$\r\n^Ictx.update(\"|\")$\r\n^Ifor item in data.inventory:$\r\n^I^Ictx.update(str(item.id))$\r\n"]
