[101.877062, "i", "cat > /tmp/test_save.gd << 'TESTEOF'\nextends SceneTree\n\nfunc _init():\n\tprint(\"=== Starting test ===\")\n\tvar item := ItemData.new()\n\titem.id = \"sword\"\n\titem.quantity = 1\n\titem.rarity = 5\n\tprint(\"Item created: \", item.id, \" x\", item.quantity, \" r\", item.rarity)\n\t\n\tvar save_data := GameSaveData.new()\n\tsave_data.player_position = Vector2(10.5, 20.25)\n\tsave_data.inventory.append(item)\n\tsave_data.unlocked_levels = PackedStringArray([\"level1\", \"level2\"])\n\tsave_data.last_played = 1234567890\n\tprint(\"SaveData created: pos=\", save_data.player_position, \" items=\", save_data.inventory.size())\n\t\n\tvar sm := SaveManager.new()\n\tvar r1 := sm.save_to_disk(save_data, \"user://test_save\", true)\n\tprint(\"save .res err=\", r1)\n\tvar r2 := sm.save_to_disk(save_data, \"user://test_save\", false)\n\tprint(\"save .tres err=\", r2)\n\t\n\tvar loaded_res := sm.load_from_disk(\"user://test_save\")\n\tvar loaded_tres := sm.load_from_disk(\"user://test_save.tres\")\n\tprint(\"loaded .res =\", loaded_res, \" pos=\", loaded_res.player_position if loaded_res else \"nil\")\n\tprint(\"loaded .tres =\", loaded_tres, \" pos=\", loaded_tres.player_position if loaded_tres else \"nil\")\n\t\n\tprint(\"hash orig: \", sm.compute_hash(save_data))\n\tif loaded_res:\n\t\tprint(\"hash loaded .res: \", sm.compute_hash(loaded_res))\n\tif loaded_tres:\n\t\tprint(\"hash loaded .tres: \", sm.compute_hash(loaded_tres))\n\t\n\t# Test resolution with extension variants\n\tvar l1 := sm.load_from_disk(\"user://test_save\")\n\tvar l2 := sm.load_from_disk(\"user://test_save.tres\")\n\tvar l3 := sm.load_from_disk(\"user://test_save.res\")\n\tprint(\"resolves:\", l1 != null, l2 != null, l3 != null)\n\tprint(\"=== Test complete ===\")\n\tquit()\nTESTEOF\n"]
