[122.592869, "i", "python3 << 'PYEOF'\ncontent = '''extends SceneTree\n\nfunc _init():\n\\tprint(\"=== Starting test ===\")\n\\tvar item := ItemData.new()\n\\titem.id = \"sword\"\n\\titem.quantity = 1\n\\titem.rarity = 5\n\\tprint(\"Item created: id=\", item.id, \" q=\", item.quantity, \" r=\", item.rarity)\n\\t\n\\tvar item2 := ItemData.new()\n\\titem2.id = \"shield\"\n\\titem2.quantity = 2\n\\titem2.rarity = 3\n\\t\n\\tvar save_data := GameSaveData.new()\n\\tsave_data.player_position = Vector2(10.5, 20.25)\n\\tsave_data.inventory.append(item)\n\\tsave_data.inventory.append(item2)\n\\tsave_data.unlocked_levels = PackedStringArray([\"level1\", \"level2\"])\n\\tsave_data.last_played = 1234567890\n\\tprint(\"SaveData created: pos=\", save_data.player_position, \" items=\", save_data.inventory.size())\n\\t\n\\tvar sm := SaveManager.new()\n\\tvar r1 := sm.save_to_disk(save_data, \"user://test_save\", true)\n\\tprint(\"save .res err=\", r1)\n\\tvar r2 := sm.save_to_disk(save_data, \"user://test_save\", false)\n\\tprint(\"save .tres err=\", r2)\n\\t\n\\tvar loaded_res := sm.load_from_disk(\"user://test_save\")\n\\tvar loaded_tres := sm.load_from_disk(\"user://test_save.tres\")\n\\tvar loaded_res_ext := sm.load_from_disk(\"user://test_save.res\")\n\\tprint(\"loaded .res exists=\", loaded_res != null)\n\\tprint(\"loaded .tres exists=\", loaded_tres != null)\n\\tprint(\"loaded .res ext exists=\", loaded_res_ext != null)\n\\t\n\\tif loaded_res != null:\n\\t\\tprint(\"loaded .res pos=\", loaded_res.player_position, \" items=\", loaded_res.inventory.size(), \" last=\", loaded_res.last_played)\n\\t\\tprint(\"loaded .res item0: \", loaded_res.inventory[0].id, \" q=\", loaded_res.inventory[0].quantity, \" r=\", loaded_res.inventory[0].rarity, \" script=\", loaded_res.inventory[0].get_script())\n\\tif loaded_tres != null:\n\\t\\tprint(\"loaded .tres pos=\", loaded_tres.player_position, \" items=\", loaded_tres.inventory.size(), \" last=\", loaded_tres.last_played)\n\\t\\tprint(\"loaded .tres item0: \", loaded_tres.inventory[0].id, \" q=\", loaded_tres.inventory[0].quantity, \" r=\", loaded_tres.inventory[0].rarity, \" script=\", loaded_tres.inventory[0].get_script())\n\\t\n\\tprint(\"hash orig: \", sm.compute_hash(save_data))\n\\tif loaded_res:\n\\t\\tprint(\"hash loaded .res: \", sm.compute_hash(loaded_res))\n\\tif loaded_tres:\n\\t\\tprint(\"hash loaded .tres: \", sm.compute_hash(loaded_tres))\n\\t\n\\t# Determine on disk: which extension was used\n\\tprint(\"=== Test complete ===\")\n\\tquit()\n'''\nwith open('/home/user/myproject/scripts/_test_save.gd', 'w') as f:\n    f.write(content)\nprint('done')\nPYEOF\n"]
