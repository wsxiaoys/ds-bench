[?2004l<!DOCTYPE html>
<html>
<head>
  <meta charset="UTF-8">
  <title>US State-Level Engineers Choropleth</title>
  <script type="text/javascript" src="https://cdn.jsdelivr.net/npm/vega@6"></script>
  <script type="text/javascript" src="https://cdn.jsdelivr.net/npm/vega-lite@6.4.1"></script>
  <script type="text/javascript" src="https://cdn.jsdelivr.net/npm/vega-embed@7"></script>
  <style>
    #vis {
      width: 100%;
      display: flex;
    }
  </style>
</head>
<body>
  <div id="vis"></div>
  <script type="application/json" id="vis-spec">
{
  "config": {
    "view": {
      "continuousWidth": 300,
      "continuousHeight": 300
    }
  },
  "data": {
    "url": "https://cdn.jsdelivr.net/npm/vega-datasets@v1.29.0/data/us-10m.json",
    "format": {
      "feature": "states",
      "type": "topojson"
    }
  },
  "mark": {
    "type": "geoshape"
  },
  "encoding": {
    "color": {
      "field": "engineers",
      "scale": {
        "scheme": "blues"
      },
      "type": "quantitative"
    },
    "tooltip": [
      {
        "field": "state",
        "type": "nominal"
      },
      {
        "field": "engineers",
        "type": "quantitative"
      }
    ]
  },
  "height": 400,
  "projection": {
    "type": "albersUsa"
  },
  "transform": [
    {
      "lookup": "id",
      "from": {
        "data": {
          "url": "https://cdn.jsdelivr.net/npm/vega-datasets@v1.29.0/data/population_engineers_hurricanes.csv"
        },
        "key": "id",
        "fields": [
          "engineers",
          "state"
        ]
      }
    }
  ],
  "width": 700,
  "$schema": "https://vega.github.io/schema/vega-lite/v6.4.1.json"
}
  </script>
  <script>
    (function() {
      var spec = JSON.parse(document.getElementById('vis-spec').textContent);
      var embedOpt = {"mode": "vega-lite"};
      function showError(el, error) {
          el.innerHTML = ('<div style="color:red;">'
                          + '<p>JavaScript Error: ' + error.message + '</p>'
                          + "<p>This usually means there's a typo in your chart specification. "
                          + 'See the javascript console for the full traceback.</p>'
                          + '</div>');
          throw error;
      }
      const el = document.getElementById('vis');
      vegaEmbed('#vis', spec, embedOpt).catch(error => showError(el, error));
    })();
  </script>
</body>
</html>
