<body>
  <div id="vis"></div>
  <script>
    (function(vegaEmbed) {
      var spec = {"config": {"view": {"continuousWidth": 300, "continuousHeight": 300}}, "data": {"url": "https://cdn.jsdelivr.net/npm/vega-datasets@v1.29.0/data/us-10m.json", "format": {"feature": "states", "type": "topojson"}}, "mark": {"type": "geoshape"}, "encoding": {"color": {"field": "engineers", "scale": {"scheme": "blues"}, "type": "quantitative"}, "tooltip": [{"field": "state", "type": "nominal"}, {"field": "engineers", "type": "quantitative"}]}, "height": 400, "projection": {"type": "albersUsa"}, "transform": [{"lookup": "id", "from": {"data": {"url": "https://cdn.jsdelivr.net/npm/vega-datasets@v1.29.0/data/population_engineers_hurricanes.csv"}, "key": "id", "fields": ["engineers", "state"]}}], "width": 700, "$schema": "https://vega.github.io/schema/vega-lite/v6.4.1.json"};
