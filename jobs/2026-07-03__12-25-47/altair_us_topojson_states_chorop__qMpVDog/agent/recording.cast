[51.897783, "o", "chart = (\r\n"]
[51.897824, "o", "\u001b[?2004l\r\u001b[?2004h>     alt.Chart(states)\r\n\u001b[?2004l\r\u001b[?2004h>     .mark_geoshape()\r\n\u001b[?2004l\r\u001b[?2004h>     .transform_lookup(\r\n\u001b[?2004l\r\u001b[?2004h>         lookup='id',\r\n\u001b[?2004l\r\u001b[?2004h>         from_=alt.LookupData(\r\n\u001b[?2004l\r\u001b[?2004h>             pop_url,\r\n\u001b[?2004l\r\u001b[?2004h>             key='id',\r\n\u001b[?2004l\r\u001b[?2004h>             fields=['engineers', 'state'],\r\n\u001b[?2004l\r\u001b[?2004h>         ),\r\n\u001b[?2004l\r\u001b[?2004h>     )\r\n\u001b[?2004l\r\u001b[?2004h>     .encode(\r\n\u001b[?2004l\r\u001b[?2004h>         color=alt.Color('engineers:Q', scale=alt.Scale(scheme='blues')),\r\n\u001b[?2004l\r\u001b[?2004h>         tooltip=['state:N', 'engineers:Q'],\r\n\u001b[?2004l\r\u001b[?2004h>     )\r\n\u001b[?2004l\r\u001b[?2004h>     .project(type='albersUsa')\r\n\u001b[?2004l\r\u001b[?2004h>     .properties(width=700, height=400)\r\n\u001b[?2004l\r\u001b[?2004h> )\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> # Get the Vega-Lite spec as dict\r\n\u001b[?2004l\r\u001b[?2004h> spec = chart.to_dict()\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> # Build a self-contained HTML file with the spec in a JSON block, rendered via vegaEmbed\r\n\u001b[?2004l\r\u001b[?2004h> html = f\"\"\"<!DOCTYPE html>\r\n\u001b[?2004l\r\u001b[?2004h> <html>\r\n\u001b[?2004l\r\u001b[?2004h> <head>\r\n\u001b[?2004l\r\u001b[?2004h>   <meta charset=\"UTF-8\">\r\n\u001b[?2004l\r\u001b[?2004h>   <title>US State-Level Engineers Choropleth</title>\r\n\u001b[?2004l\r\u001b[?2004h>   <script type=\"text/javascript\" src=\"https://cdn.jsdelivr.net/npm/vega@6\"></script>\r\n\u001b[?2004l\r\u001b[?2004h>   <script type=\"text/javascript\" src=\"https://cdn.jsdelivr.net/npm/vega-lite@6.4.1\"></script>\r\n\u001b[?2004l\r\u001b[?2004h>   <script type=\"text/javascript\" src=\"https://cdn.jsdelivr.net/npm/vega-embed@7\"></script>\r\n\u001b[?2004l\r\u001b[?2004h>   <style>\r\n\u001b[?2004l\r\u001b[?2004h>     #vis {{\r\n\u001b[?2004l\r\u001b[?2004h>       width: 100%;\r\n\u001b[?2004l\r\u001b[?2004h>       display: flex;\r\n\u001b[?2004l\r\u001b[?2004h>     }}\r\n\u001b[?2004l\r\u001b[?2004h>   </style>\r\n\u001b[?2004l\r\u001b[?2004h> </head>\r\n\u001b[?2004l\r\u001b[?2004h> <body>\r\n\u001b[?2004l\r\u001b[?2004h>   <div id=\"vis\"></div>\r\n\u001b[?2004l\r\u001b[?2004h>   <script type=\"application/json\" id=\"vis-spec\">\r\n\u001b[?2004l\r\u001b[?2004h> {json.dumps(spec, indent=2)}\r\n\u001b[?2004l\r\u001b[?2004h>   </script>\r\n\u001b[?2004l\r\u001b[?2004h>   <script>\r\n\u001b[?2004l\r\u001b[?2004h>     (function() {{\r\n\u001b[?2004l\r\u001b[?2004h>       var spec = JSON.parse(document.getElementById('vis-spec').textContent);\r\n\u001b[?2004l\r\u001b[?2004h>       var embedOpt = {{\"mode\": \"vega-lite\"}};\r\n\u001b[?2004l\r\u001b[?2004h>       function showError(el, error) {{\r\n\u001b[?2004l\r\u001b[?2004h>           el.innerHTML = ('<div style=\"color:red;\">'\r\n\u001b[?2004l\r\u001b[?2004h>                           + '<p>JavaScript Error: ' + error.message + '</p>'\r\n\u001b[?2004l\r\u001b[?2004h>                           + \"<p>This usually means there's a typo in your chart specification. \"\r\n\u001b[?2004l\r\u001b[?2004h>                           + 'See the javascript console for the full traceback.</p>'\r\n\u001b[?2004l\r\u001b[?2004h>                           + '</div>');\r\n\u001b[?2004l\r\u001b[?2004h>           throw error;\r\n\u001b[?2004l\r\u001b[?2004h>       }}\r\n\u001b[?2004l\r\u001b[?2004h>       const el = document.getElementById('vis');\r\n\u001b[?2004l\r\u001b[?2004h>       vegaEmbed('#vis', spec, embedOpt).catch(error => showError(el, error));\r\n\u001b[?2004l\r\u001b[?2004h>     }})();\r\n\u001b[?2004l\r\u001b[?2004h>   </script>\r\n\u001b[?2004l\r\u001b[?2004h> </body>\r\n\u001b[?2004l\r\u001b[?2004h> </html>\r\n\u001b[?2004l\r\u001b[?2004h> \"\"\"\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> with open('chart.html', 'w') as f:\r\n\u001b[?2004l\r\u001b[?2004h>     f.write(html)\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> print('Chart saved to chart.html')\r\n\u001b[?2004l\r\u001b[?2004h> EOF\r\n\u001b[?2004l\r"]
