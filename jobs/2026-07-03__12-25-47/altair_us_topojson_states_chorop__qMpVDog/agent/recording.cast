[51.890556, "i", "cat > /home/user/myproject/build_chart.py << 'EOF'\nimport altair as alt\nimport json\nfrom vega_datasets import data\n\n# Load TopoJSON URL for US state boundaries\nstates = alt.topo_feature(data.us_10m.url, 'states')\n\n# URL for population_engineers_hurricanes dataset\npop_url = data.population_engineers_hurricanes.url\n\n# Build the chart\nchart = (\n    alt.Chart(states)\n    .mark_geoshape()\n    .transform_lookup(\n        lookup='id',\n        from_=alt.LookupData(\n            pop_url,\n            key='id',\n            fields=['engineers', 'state'],\n        ),\n    )\n    .encode(\n        color=alt.Color('engineers:Q', scale=alt.Scale(scheme='blues')),\n        tooltip=['state:N', 'engineers:Q'],\n    )\n    .project(type='albersUsa')\n    .properties(width=700, height=400)\n)\n\n# Get the Vega-Lite spec as dict\nspec = chart.to_dict()\n\n# Build a self-contained HTML file with the spec in a JSON block, rendered via vegaEmbed\nhtml = f\"\"\"<!DOCTYPE html>\n<html>\n<head>\n  <meta charset=\"UTF-8\">\n  <title>US State-Level Engineers Choropleth</title>\n  <script type=\"text/javascript\" src=\"https://cdn.jsdelivr.net/npm/vega@6\"></script>\n  <script type=\"text/javascript\" src=\"https://cdn.jsdelivr.net/npm/vega-lite@6.4.1\"></script>\n  <script type=\"text/javascript\" src=\"https://cdn.jsdelivr.net/npm/vega-embed@7\"></script>\n  <style>\n    #vis {{\n      width: 100%;\n      display: flex;\n    }}\n  </style>\n</head>\n<body>\n  <div id=\"vis\"></div>\n  <script type=\"application/json\" id=\"vis-spec\">\n{json.dumps(spec, indent=2)}\n  </script>\n  <script>\n    (function() {{\n      var spec = JSON.parse(document.getElementById('vis-spec').textContent);\n      var embedOpt = {{\"mode\": \"vega-lite\"}};\n      function showError(el, error) {{\n          el.innerHTML = ('<div style=\"color:red;\">'\n                          + '<p>JavaScript Error: ' + error.message + '</p>'\n                          + \"<p>This usually means there's a typo in your chart specification. \"\n                          + 'See the javascript console for the full traceback.</p>'\n                          + '</div>');\n          throw error;\n      }}\n      const el = document.getElementById('vis');\n      vegaEmbed('#vis', spec, embedOpt).catch(error => showError(el, error));\n    }})();\n  </script>\n</body>\n</html>\n\"\"\"\n\nwith open('chart.html', 'w') as f:\n    f.write(html)\n\nprint('Chart saved to chart.html')\nEOF\n"]
