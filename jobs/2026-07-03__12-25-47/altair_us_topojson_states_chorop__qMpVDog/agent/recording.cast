[62.666748, "o", "cat /home/user/myproject/chart.html\r\n\u001b[?2004l\r"]
[62.676672, "o", "<!DOCTYPE html>\r\n<html>\r\n<head>\r\n  <meta charset=\"UTF-8\">\r\n  <title>US State-Level Engineers Choropleth</title>\r\n  <script type=\"text/javascript\" src=\"https://cdn.jsdelivr.net/npm/vega@6\"></script>\r\n  <script type=\"text/javascript\" src=\"https://cdn.jsdelivr.net/npm/vega-lite@6.4.1\"></script>\r\n  <script type=\"text/javascript\" src=\"https://cdn.jsdelivr.net/npm/vega-embed@7\"></script>\r\n  <style>\r\n    #vis {\r\n      width: 100%;\r\n      display: flex;\r\n    }\r\n  </style>\r\n</head>\r\n<body>\r\n  <div id=\"vis\"></div>\r\n  <script type=\"application/json\" id=\"vis-spec\">\r\n{\r\n  \"config\": {\r\n    \"view\": {\r\n      \"continuousWidth\": 300,\r\n      \"continuousHeight\": 300\r\n    }\r\n  },\r\n  \"data\": {\r\n    \"url\": \"https://cdn.jsdelivr.net/npm/vega-datasets@v1.29.0/data/us-10m.json\",\r\n    \"format\": {\r\n      \"feature\": \"states\",\r\n      \"type\": \"topojson\"\r\n    }\r\n  },\r\n  \"mark\": {\r\n    \"type\": \"geoshape\"\r\n  },\r\n  \"encoding\": {\r\n    \"color\": {\r\n      \"field\": \"engineers\",\r\n      \"scale\": {\r\n        \"scheme\": \"blues\"\r\n      },\r\n      \"type\": \"quantitative\"\r\n    },\r\n    \"tooltip\": [\r\n      {\r\n        \"field\": \"state\",\r\n        \"type\": \"nominal\"\r\n      },\r\n      {\r\n        \"field\": \"engineers\",\r\n        \"type\": \"quantitative\"\r\n      }\r\n    ]\r\n  },\r\n  \"height\": 400,\r\n  \"projection\": {\r\n    \"type\": \"albersUsa\"\r\n  },\r\n  \"transform\": [\r\n    {\r\n      \"lookup\": \"id\",\r\n      \"from\": {\r\n        \"data\": {\r\n          \"url\": \"https://cdn.jsdelivr.net/npm/vega-datasets@v1.29.0/data/population_engineers_hurricanes.csv\"\r\n        },\r\n        \"key\": \"id\",\r\n        \"fields\": [\r\n          \"engineers\",\r\n          \"state\"\r\n        ]\r\n      }\r\n    }\r\n  ],\r\n  \"width\": 700,\r\n  \"$schema\": \"https://vega.github.io/schema/vega-lite/v6.4.1.json\"\r\n}\r\n  </script>\r\n  <script>\r\n    (function() {\r\n      var spec = JSON.parse(document.getElementById('vis-spec').textContent);\r\n      var embedOpt = {\"mode\": \"vega-lite\"};\r\n      function showError(el, error) {\r\n          el.innerHTML = ('<div style=\"color:red;\">'\r\n                          + '<p>JavaScript Error: ' + error.message + '</p>'\r\n                          + \"<p>This usually means there's a typo in your char"]
[62.677551, "o", "t specification. \"\r\n                          + 'See the javascript console for the full traceback.</p>'\r\n                          + '</div>');\r\n          throw error;\r\n      }\r\n      const el = document.getElementById('vis');\r\n      vegaEmbed('#vis', spec, embedOpt).catch(error => showError(el, error));\r\n    })();\r\n  </script>\r\n</body>\r\n</html>\r\n"]
