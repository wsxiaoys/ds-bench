": {"condition": [{"param": "param_4a98c29607107dd6", "value": 1, "empty": false}], "value": 0}, "text": {"field": "label", "type": "nominal"}, "x": {"field": "date", "type": "temporal"}, "y": {"field": "temp_mean", "type": "quantitative"}}, "transform": [{"calculate": "(datum.temp_min + datum.temp_max) / 2", "as": "temp_mean"}, {"calculate": "timeFormat(datum.date, '%Y-%m-%d') + ' | Mean: ' + format(datum.temp_mean, '.1f') + '\u00b0C' + ' | Precip: ' + format(datum.precipitation, '.1f') + 'mm'", "as": "label"}]}], "data": {"url": "https://cdn.jsdelivr.net/npm/vega-datasets@v1.29.0/data/seattle-weather.csv"}, "height": 420, "params": [{"name": "param_4a98c29607107dd6", "select": {"type": "point", "encodings": ["x"], "nearest": true, "on": "pointerover"}, "views": ["view_606ec5977ba30ba1_0"]}], "resolve": {"scale": {"y": "independent"}}, "title": "Seattle Weather: Temperature Range, Mean and Precipitation", "width": 900, "$schema": "https://vega.github.io/schema/vega-lite/v6.4.1.json"};
      var embedOpt = {"mode": "vega-lite"};

