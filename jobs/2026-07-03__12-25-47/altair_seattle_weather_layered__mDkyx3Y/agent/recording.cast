[157.062992, "o", "tail -50 /home/user/myproject/chart.html\r\n\u001b[?2004l\r"]
[157.063952, "o", "  ],\r\n  \"data\": {\r\n    \"url\": \"https://cdn.jsdelivr.net/npm/vega-datasets@v1.29.0/data/seattle-weather.csv\"\r\n  },\r\n  \"height\": 420,\r\n  \"params\": [\r\n    {\r\n      \"name\": \"param_4a98c29607107dd6\",\r\n      \"select\": {\r\n        \"type\": \"point\",\r\n        \"encodings\": [\r\n          \"x\"\r\n        ],\r\n        \"nearest\": true,\r\n        \"on\": \"pointerover\"\r\n      },\r\n      \"views\": [\r\n        \"view_606ec5977ba30ba1_0\"\r\n      ]\r\n    }\r\n  ],\r\n  \"resolve\": {\r\n    \"scale\": {\r\n      \"y\": \"independent\"\r\n    }\r\n  },\r\n  \"title\": \"Seattle Weather: Temperature Range, Mean and Precipitation\",\r\n  \"width\": 900,\r\n  \"$schema\": \"https://vega.github.io/schema/vega-lite/v6.4.1.json\"\r\n}\r\n  </script>\r\n  <script type=\"text/javascript\">\r\n    (function() {\r\n      var spec = JSON.parse(document.getElementById('spec').textContent);\r\n      var embedOpt = { \"mode\": \"vega-lite\" };\r\n\r\n      function showError(el, error) {\r\n          el.innerHTML = ('<div style=\"color:red;\">'\r\n                          + '<p>JavaScript Error: ' + error.message + '</p>'\r\n                          + \"<p>This usually means there's a typo in your chart specification. \"\r\n                          + \"See the javascript console for the full traceback.</p>\"\r\n                          + '</div>');\r\n          throw error;\r\n      }\r\n      const el = document.getElementById('vis');\r\n      vegaEmbed(\"#vis\", spec, embedOpt).catch(error => showError(el, error));\r\n    })();\r\n  </script>\r\n</body>\r\n</html>\r\n"]
