[102.70461, "o", "<!DOCTYPE html>\r\n<html>\r\n<head>\r\n  <meta charset=\"UTF-8\">\r\n  <style>\r\n    #vis.vega-embed {\r\n      width: 100%;\r\n      display: flex;\r\n    }\r\n\r\n    #vis.vega-embed details,\r\n    #vis.vega-embed details summary {\r\n      position: relative;\r\n    }\r\n  </style>\r\n  <script type=\"text/javascript\" src=\"https://cdn.jsdelivr.net/npm/vega@6\"></script>\r\n  <script type=\"text/javascript\" src=\"https://cdn.jsdelivr.net/npm/vega-lite@6.4.1\"></script>\r\n  <script type=\"text/javascript\" src=\"https://cdn.jsdelivr.net/npm/vega-embed@7\"></script>\r\n</head>\r\n<body>\r\n  <div id=\"vis\"></div>\r\n  <script>\r\n    (function(vegaEmbed) {\r\n"]
[102.704715, "o", "      var spec = {\"config\": {\"view\": {\"continuousWidth\": 300, \"continuousHeight\": 300}}, \"layer\": [{\"mark\": {\"type\": \"area\", \"color\": \"#fdd0a2\", \"fillOpacity\": 0.55, \"opacity\": 0.85, \"stroke\": \"darkorange\"}, \"encoding\": {\"x\": {\"field\": \"date\", \"title\": \"Date\", \"type\": \"temporal\"}, \"y\": {\"field\": \"temp_max\", \"title\": \"Temperature (\\u00b0C)\", \"type\": \"quantitative\"}, \"y2\": {\"field\": \"temp_min\"}}, \"name\": \"view_606ec5977ba30ba1_0\", \"transform\": [{\"calculate\": \"(datum.temp_min + datum.temp_max) / 2\", \"as\": \"temp_mean\"}]}, {\"mark\": {\"type\": \"line\", \"color\": \"crimson\", \"strokeWidth\": 2}, \"encoding\": {\"x\": {\"field\": \"date\", \"title\": \"Date\", \"type\": \"temporal\"}, \"y\": {\"field\": \"temp_mean\", \"type\": \"quantitative\"}}, \"transform\": [{\"calculate\": \"(datum.temp_min + datum.temp_max) / 2\", \"as\": \"temp_mean\"}]}, {\"mark\": {\"type\": \"bar\", \"color\": \"steelblue\", \"opacity\": 0.45}, \"encoding\": {\"x\": {\"field\": \"date\", \"title\": \"Date\", \"type\": \"temporal\"}, \"y\": {\"axis\": {\"title\": \"Precipitation (mm)\"}, \"field\": \"precipitation\", \"type\": \"quantitative\"}}, \"transform\": [{\"calculate\": \"(datum.temp_min + datum.temp_max) / 2\", \"as\": \"temp_mean\"}]}, {\"mark\": {\"type\": \"rule\", \"color\": \"black\", \"opacity\": 0.6, \"strokeDash\": [4, 4], \"strokeWidth\": 1.5}, \"encoding\": {\"x\": {\"field\": \"date\", \"title\": \"Date\", \"type\": \"temporal\"}, \"y\": {\"type\": \"quantitative\", \"datum\": 0}}, \"transform\": [{\"calculate\": \"(datum.temp_min + datum.temp_max) / 2\", \"as\": \"temp_mean\"}]}, {\"mark\": {\"type\": \"rule\", \"color\": \"black\", \"strokeWidth\": 1}, \"encoding\": {\"opacity\": {\"condition\": [{\"param\": \"param_4a98c29607107dd6\", \"value\": 0.55, \"empty\": false}], \"value\": 0}, \"x\": {\"field\": \"date\", \"type\": \"temporal\"}, \"y\": {\"type\": \"quantitative\", \"datum\": -10}, \"y2\": {\"datum\": 35, \"type\": \"quantitative\"}}, \"transform\": [{\"calculate\": \"(datum.temp_min + datum.temp_max) / 2\", \"as\": \"temp_mean\"}]}, {\"mark\": {\"type\": \"text\", \"align\": \"left\", \"color\": \"black\", \"dx\": 5, \"dy\": -12, \"fontSize\": 11, \"fontWeight\": \"bold\"}, \"encoding\": {\"opacity\": {\"condition\": [{\"param\": \"param_4a98c29607107dd6\", \"value\": 1, \"empty\": false}], \"value\": 0}, \"text\": {\"field\": \"label\", \"type\": \"nominal\"}, \"x\": {\"field\": \"date\", \"type\": \"temporal\"}, \"y\": {\"field\": \"temp_mean\", \"type\": \"quantitative\"}}, \"transform\": [{\"calculate\": \"(datum.temp_min + datum.temp_max) / 2\", \"as\": \"temp_mean\"}, {\"calculate\": \"timeFormat(datum.date, '%Y-%m-%d') + ' | Mean: ' + format(datum.temp_mean, '.1f') + '\\u00b0C' + ' | Precip: ' + format(datum.precipitation, '.1f') + 'mm'\", \"as\": \"label\"}]}], \"data\": {\"url\": \"https://cdn.jsdelivr.net/npm/vega-datasets@v1.29.0/data/seattle-weather.csv\"}, \"height\": 420, \"params\": [{\"name\": \"param_4a98c29607107dd6\", \"select\": {\"type\": \"point\", \"encodings\": [\"x\"], \"nearest\": true, \"on\": \"pointerover\"}, \"views\": [\"view_606ec5977ba30ba1_0\"]}], \"resolve\": {\"scale\": {\"y\": \"independent\"}}, \"title\": \"Seattle Weather: Temperature Range, Mean and Precipitation\", \"width\": 900, \"$schema\": \"https://vega.github.io/schema/vega-lite/v6.4.1.json\"};\r\n      var embedOpt = {\"mode\": \"vega-lite\"};\r\n\r\n      function showError(el, error){\r\n          el.innerHTML = ('<div style=\"color:red;\">'\r\n                          + '<p>JavaScript Error: ' + error.message + '</p>'\r\n                          + \"<p>This usually means there's a typo in your chart specification. \"\r\n                          + \"See the javascript console for the full traceback.</p>\"\r\n                          + '</div>');\r\n          throw error;\r\n      }\r\n      const el = document.getElementById('vis');\r\n      vegaEmbed(\"#vis\", spec, embedOpt)\r\n        .catch(error => showError(el, error));\r\n    })(vegaEmbed);\r\n\r\n  </script>\r\n</body>\r\n</html>"]
