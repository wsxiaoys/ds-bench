[?2004hroot@8b287a72-0bab-46af-a336-5034d94c457b:/home/user/project# cat > src/auth-store.ts << 'EOF'
[?2004l[?2004h> // Module-level auth store used by both the React context components
[?2004l[?2004h> // and the TanStack Router `beforeLoad` route guards, so the routing
[?2004l[?2004h> // guards always see the latest authentication state.
[?2004l[?2004h> 
[?2004l[?2004h> type AuthState = { isAuthenticated: boolean }
[?2004l[?2004h> type Listener = (state: AuthState) => void
[?2004l[?2004h> 
[?2004l[?2004h> const state: AuthState = { isAuthenticated: false }
[?2004l[?2004h> const listeners: Set<Listener> = new Set()
[?2004l[?2004h> 
[?2004l[?2004h> export function getAuthState(): AuthState {
[?2004l[?2004h>   return state
[?2004l[?2004h> }
[?2004l[?2004h> 
[?2004l[?2004h> export function login(): void {
[?2004l[?2004h>   state.isAuthenticated = true
[?2004l[?2004h>   listeners.forEach((l) => l(state))
[?2004l[?2004h> }
[?2004l[?2004h> 
[?2004l[?2004h> export function logout(): void {
[?2004l[?2004h>   state.isAuthenticated = false
[?2004l[?2004h>   listeners.forEach((l) => l(state))
[?2004l[?2004h> }
[?2004l[?2004h> 
[?2004l[?2004h> export function subscribe(listener: Listener): () => void {
[?2004l[?2004h>   listeners.add(listener)
[?2004l[?2004h>   return () => {
[?2004l[?2004h>     listeners.delete(listener)
[?2004l[?2004h>   }
[?2004l[?2004h> }
[?2004l[?2004h> EOF
[?2004l[?2004hroot@8b287a72-0bab-46af-a336-5034d94c457b:/home/user/project# cat > src/AuthContext.tsx << 'EOF'
[?2004l[?2004h> import { createContext, useContext, useEffect, useState } from 'react'
[?2004l[?2004h> import type { ReactNode } from 'react'
[?2004l[?2004h> import {
[?2004l[?2004h>   getAuthState,
[?2004l[?2004h>   login as storeLogin,
[?2004l[?2004h>   logout as storeLogout,
[?2004l[?2004h>   subscribe as storeSubscribe,
[?2004l[?2004h> } from './auth-store'
[?2004l[?2004h> 
[?2004l[?2004h> interface AuthContextValue {
[?2004l[?2004h>   isAuthenticated: boolean
[?2004l[?2004h>   login: () => void
[?2004l[?2004h>   logout: () => void
[?2004l[?2004h> }
[?2004l[?2004h> 
[?2004l[?2004h> const AuthContext = createContext<AuthContextValue | undefined>(undefined)
[?2004l[?2004h> 
[?2004l[?2004h> export function AuthProvider({ children }: { children: ReactNode }) {
[?2004l[?2004h>   const [isAuthenticated, setIsAuthenticated] = useState<boolean>(
[?2004l[?2004h>     getAuthState().isAuthenticated,
[?2004l[?2004h>   )
[?2004l[?2004h> 
[?2004l[?2004h>   useEffect(() => {
[?2004l[?2004h>     return storeSubscribe((s) => setIsAuthenticated(s.isAuthenticated))
[?2004l[?2004h>   }, [])
[?2004l[?2004h> 
[?2004l[?2004h>   return (
[?2004l[?2004h>     <AuthContext.Provider
[?2004l[?2004h>       value={{
[?2004l[?2004h>         isAuthenticated,
[?2004l[?2004h>         login: storeLogin,
[?2004l[?2004h>         logout: storeLogout,
[?2004l[?2004h>       }}
[?2004l[?2004h>     >
[?2004l[?2004h>       {children}
[?2004l[?2004h>     </AuthContext.Provider>
[?2004l[?2004h>   )
[?2004l[?2004h> }
[?2004l[?2004h> 
[?2004l[?2004h> export function useAuth(): AuthContextValue {
[?2004l[?2004h>   const ctx = useContext(AuthContext)
[?2004l[?2004h>   if (!ctx) {
[?2004l[?2004h>     throw new Error('useAuth must be used within AuthProvider')
[?2004l[?2004h>   }
[?2004l[?2004h>   return ctx
[?2004l[?2004h> }
[?2004l[?2004h> EOF
