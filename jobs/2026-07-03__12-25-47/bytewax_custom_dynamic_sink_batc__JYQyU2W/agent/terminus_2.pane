[?2004l[?2004h> class JSONLRotatingPartition(StatelessSinkPartition):
[?2004l[?2004h>     """A stateless sink partition that writes items to JSONL files with rotation.
[?2004l[?2004h> 
[?2004l[?2004h>     Each file contains at most RECORDS_PER_FILE records. When the limit is reached,
[?2004l[?2004h>     the file is closed and a new file with the next part number is opened.
[?2004l[?2004h>     """
[?2004l[?2004h> 
[?2004l[?2004h>     def __init__(self, run_id, worker_index, output_dir, records_per_file=RECORDS_PER_FILE):
[?2004l[?2004h>         self._run_id = run_id
[?2004l[?2004h>         self._worker_index = worker_index
[?2004l[?2004h>         self._output_dir = output_dir
