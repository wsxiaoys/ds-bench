[?2004l[?2004h>         """Write items to the current file, rotating as needed."""
[?2004l[?2004h>         for item in items:
[?2004l[?2004h>             # If the current file is full, rotate to a new part
[?2004l[?2004h>             if self._records_in_current_file >= self._records_per_file:
[?2004l[?2004h>                 self._advance_part()
[?2004l[?2004h> 
[?2004l[?2004h>             # Ensure a file is open
[?2004l[?2004h>             self._ensure_file()
[?2004l[?2004h> 
[?2004l[?2004h>             # Write the record
[?2004l[?2004h>             record = {"worker": self._worker_index, "value": item}
[?2004l[?2004h>             self._current_file.write(json.dumps(record) + "\n")
[?2004l[?2004h>             self._records_in_current_file += 1
[?2004l[?2004h> 
[?2004l[?2004h>             # If this write filled up the file, close it immediately
[?2004l[?2004h>             if self._records_in_current_file >= self._records_per_file:
[?2004l[?2004h>                 self._close_file()
[?2004l[?2004h>                 # Prepare for the next part, but don't open a new file yet.
[?2004l[?2004h>                 # We'll advance the part number when we actually need to write again.
[?2004l[?2004h>                 # But the spec says we need to advance to next part number.
[?2004l[?2004h>                 self._part_number += 1
