[?2004l[?2004h>         self._part_number = 0
[?2004l[?2004h>         self._records_in_current_file = 0
[?2004l[?2004h>         self._current_file = None
[?2004l[?2004h> 
[?2004l[?2004h>     def _current_path(self):
[?2004l[?2004h>         return os.path.join(
[?2004l[?2004h>             self._output_dir,
[?2004l[?2004h>             f"output-{self._run_id}-worker-{self._worker_index}-part-{self._part_number}.jsonl",
[?2004l[?2004h>         )
[?2004l[?2004h> 
[?2004l[?2004h>     def _open_file(self):
[?2004l[?2004h>         """Open a new file for the current part."""
[?2004l[?2004h>         if self._current_file is None:
[?2004l[?2004h>             path = self._current_path()
[?2004l[?2004h>             self._current_file = open(path, "w")
[?2004l[?2004h>             self._records_in_current_file = 0
[?2004l[?2004h> 
[?2004l[?2004h>     def _close_file(self):
[?2004l[?2004h>         """Close the currently open file, if any."""
[?2004l[?2004h>         if self._current_file is not None:
[?2004l[?2004h>             self._current_file.close()
[?2004l[?2004h>             self._current_file = None
[?2004l[?2004h> 
[?2004l[?2004h>     def _rotate(self):
[?2004l[?2004h>         """Close current file and advance part number for the next one."""
[?2004l[?2004h>         self._close_file()
[?2004l[?2004h>         self._part_number += 1
[?2004l[?2004h> 
[?2004l[?2004h>     def write_batch(self, items):
[?2004l[?2004h>         """Write a batch of items to JSONL files, rotating as needed."""
[?2004l[?2004h>         for item in items:
[?2004l[?2004h>             # Open current file if needed
[?2004l[?2004h>             self._open_file()
[?2004l[?2004h> 
[?2004l[?2004h>             # Write the record
[?2004l[?2004h>             record = {"worker": self._worker_index, "value": item}
[?2004l[?2004h>             self._current_file.write(json.dumps(record) + "\n")
[?2004l[?2004h>             self._records_in_current_file += 1
[?2004l[?2004h> 
[?2004l[?2004h>             # If we've filled the file, close it and advance the part number
[?2004l[?2004h>             if self._records_in_current_file >= self._records_per_file:
[?2004l[?2004h>                 self._close_file()
[?2004l[?2004h>                 self._part_number += 1
[?2004l[?2004h>                 # records_in_current_file reset to 0 by _open_file on next use
[?2004l[?2004h> 
[?2004l[?2004h>     def close(self):
[?2004l[?2004h>         """Cleanup: close any open file."""
[?2004l[?2004h>         self._close_file()
