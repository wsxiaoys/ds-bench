[54.85494, "o", "        self._records_in_current_file = 0\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[54.854967, "o", "\u001b[?2004h> "]
[54.855005, "o", "    def write_batch(self, items):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[54.855089, "o", "        \"\"\"Write items to the current file, rotating as needed.\"\"\"\r\n\u001b[?2004l\r\u001b[?2004h> "]
[54.855132, "o", "        for item in items:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[54.85521, "o", "            # If the current file is full, rotate to a new part\r\n\u001b[?2004l\r\u001b[?2004h> "]
[54.8553, "o", "            if self._records_in_current_file >= self._records_per_file:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[54.85535, "o", "                self._advance_part()\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[54.855378, "o", "\u001b[?2004h> "]
[54.855422, "o", "            # Ensure a file is open\r\n\u001b[?2004l\r\u001b[?2004h> "]
[54.855464, "o", "            self._ensure_file()\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[54.855492, "o", "\u001b[?2004h> "]
[54.855526, "o", "            # Write the record\r\n\u001b[?2004l\r\u001b[?2004h> "]
[54.855612, "o", "            record = {\"worker\": self._worker_index, \"value\": item}\r\n\u001b[?2004l\r\u001b[?2004h"]
[54.855641, "o", "> "]
[54.855695, "o", "            self._current_file.write(json.dumps(record) + \"\\n\")\r\n\u001b[?2004l\r\u001b[?2004h> "]
[54.855761, "o", "            self._records_in_current_file += 1\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[54.85579, "o", "\u001b[?2004h> "]
[54.855856, "o", "            # If this write filled up the file, close it immediately\r\n\u001b[?2004l\r\u001b[?2004h> "]
[54.855952, "o", "            if self._records_in_current_file >= self._records_per_file:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[54.856, "o", "                self._close_file()\r\n\u001b[?2004l\r\u001b[?2004h> "]
[54.856093, "o", "                # Prepare for the next part, but don't open a new file yet.\r\n\u001b[?2004l\r\u001b[?2004h> "]
[54.8562, "o", "                # We'll advance the part number when we actually need to write again.\r\n\u001b[?2004l\r\u001b[?2004h> "]
[54.856292, "o", "                # But the spec says we need to advance to next part number.\r\n\u001b[?2004l\r\u001b[?2004h"]
[54.85632, "o", "> "]
[54.856347, "o", "                self._part_number += 1\r\n\u001b[?2004l\r\u001b[?2004h> "]
[54.856421, "o", "                self._records_in_current_file = 0\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[54.85645, "o", "\u001b[?2004h> "]
[54.856479, "o", "    def close(self):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[54.856552, "o", "        \"\"\"Close any open file when the partition is closed.\"\"\"\r\n\u001b[?2004l\r\u001b[?2004h> "]
[54.856592, "o", "        self._close_file()\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[54.856619, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[54.856664, "o", "class JSONLRotatingSink(DynamicSink):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[54.856762, "o", "    \"\"\"A dynamic sink that writes items to rotating JSONL files per worker.\"\"\"\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[54.856789, "o", "\u001b[?2004h> "]
[54.856854, "o", "    def __init__(self, run_id, output_dir, records_per_file=20):\r\n\u001b[?2004l\r\u001b[?2004h"]
[54.856882, "o", "> "]
[54.85691, "o", "        self._run_id = run_id\r\n\u001b[?2004l\r\u001b[?2004h> "]
[54.856953, "o", "        self._output_dir = output_dir\r\n\u001b[?2004l\r\u001b[?2004h> "]
[54.857023, "o", "        self._records_per_file = records_per_file\r\n\u001b[?2004l\r\u001b[?2004h> "]
[54.857054, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[54.857116, "o", "    def build(self, step_id, worker_index, worker_count):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[54.857173, "o", "        return JSONLRotatingPartition(\r\n\u001b[?2004l\r\u001b[?2004h"]
[54.857201, "o", "> "]
[54.857228, "o", "            run_id=self._run_id,\r\n\u001b[?2004l\r\u001b[?2004h> "]
[54.857276, "o", "            worker_index=worker_index,\r\n\u001b[?2004l\r\u001b[?2004h> "]
[54.85733, "o", "            output_dir=self._output_dir,\r\n\u001b[?2004l\r\u001b[?2004h> "]
[54.85741, "o", "            records_per_file=self._records_per_file,\r\n\u001b[?2004l\r\u001b[?2004h> "]
[54.857439, "o", "        )\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[54.857468, "o", "\u001b[?2004h> "]
[54.857503, "o", "# Create a list of 200 integers 0..199\r\n\u001b[?2004l\r\u001b[?2004h> "]
[54.857542, "o", "items = list(range(200))\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[54.857571, "o", "\u001b[?2004h> # Build the dataflow\r\n\u001b[?2004l\r"]
[54.857597, "o", "\u001b[?2004h> "]
[54.857634, "o", "flow = Dataflow(\"jsonl-rotation\")\r\n\u001b[?2004l\r\u001b[?2004h> "]
[54.857702, "o", "inp = input(\"inp\", flow, TestingSource(items))\r\n\u001b[?2004l\r\u001b[?2004h> "]
[54.85778, "o", "output(\"out\", inp, JSONLRotatingSink(RUN_ID, OUTPUT_DIR))\r\n\u001b[?2004l\r\u001b[?2004h> "]
[54.857808, "o", "EOF\r\n\u001b[?2004l\r"]
[54.860085, "o", "\u001b[?2004hroot@018f3f93-1e8d-4bf2-9ed6-81373c3c59c6:/home/user/bytewax-sink# "]
[55.209119, "i", "ls -la /home/user/bytewax-sink/\n"]
[55.209373, "o", "ls -la /home/user/bytewax-sink/\r\n\u001b[?2004l\r"]
[55.210856, "o", "total 4\r\n"]
[55.210902, "o", "drwxr-xr-x 1 root root   20 Jul  3 13:27 \u001b[0m\u001b[01;34m.\u001b[0m\r\ndrwxr-xr-x 1 root root   26 Jul  3 13:26 \u001b[01;34m..\u001b[0m\r\n-rw-r--r-- 1 root root 3967 Jul  3 13:27 run.py\r\n"]
[55.211015, "o", "\u001b[?2004hroot@018f3f93-1e8d-4bf2-9ed6-81373c3c59c6:/home/user/bytewax-sink# "]
[67.157035, "i", "cat > /home/user/bytewax-sink/run.py << 'EOF'\nimport json\nimport os\n\nfrom bytewax.dataflow import Dataflow\nfrom bytewax.outputs import DynamicSink, StatelessSinkPartition\nfrom bytewax.operators import input, output\nfrom bytewax.testing import TestingSource\n\n\n# Read the run-id from the artifacts directory\nRUN_ID_FILE = \"/logs/artifacts/run-id\"\nwith open(RUN_ID_FILE, \"r\") as f:\n    RUN_ID = f.read().strip()\n\n# Output directory\nOUTPUT_DIR = \"/home/user/bytewax-sink/out\"\nos.makedirs(OUTPUT_DIR, exist_ok=True)\n\n\nRECORDS_PER_FILE = 20\n\n\nclass JSONLRotatingPartition(StatelessSinkPartition):\n    \"\"\"A stateless sink partition that writes items to JSONL files with rotation.\n\n    Each file contains at most RECORDS_PER_FILE records. When the limit is reached,\n    the file is closed and a new file with the next part number is opened.\n    \"\"\"\n\n    def __init__(self, run_id, worker_index, output_dir, records_per_file=RECORDS_PER_FILE):\n        self._run_id = run_id\n        self._worker_index = worker_index\n        self._output_dir = output_dir\n        self._records_per_file = records_per_file\n        self._part_number = 0\n        self._records_in_current_file = 0\n        self._current_file = None\n\n    def _current_path(self):\n        return os.path.join(\n            self._output_dir,\n            f\"output-{self._run_id}-worker-{self._worker_index}-part-{self._part_number}.jsonl\",\n        )\n\n    def _open_file(self):\n        \"\"\"Open a new file for the current part.\"\"\"\n        if self._current_file is None:\n            path = self._current_path()\n            self._current_file = open(path, \"w\")\n            self._records_in_current_file = 0\n\n    def _close_file(self):\n        \"\"\"Close the currently open file, if any.\"\"\"\n        if self._current_file is not None:\n            self._current_file.close()\n            self._current_file = None\n\n    def _rotate(self):\n        \"\"\"Close current file and advance part number for the next one.\"\"\"\n        self._close_file()\n        self._part_number += 1\n\n    def write_batch(self, items):\n        \"\"\"Write a batch of items to JSONL files, rotating as needed.\"\"\"\n        for item in items:\n            # Open current file if needed\n            self._open_file()\n\n            # Write the record\n            record = {\"worker\": self._worker_index, \"value\": item}\n            self._current_file.write(json.dumps(record) + \"\\n\")\n            self._records_in_current_file += 1\n\n            # If we've filled the file, close it and advance the part number\n            if self._records_in_current_file >= self._records_per_file:\n                self._close_file()\n                self._part_number += 1\n                # records_in_current_file reset to 0 by _open_file on next use\n\n    def close(self):\n        \"\"\"Cleanup: close any open file.\"\"\"\n        self._close_file()\n\n\nclass JSONLRotatingSink(DynamicSink):\n    \"\"\"A dynamic sink that writes items to rotating JSONL files per worker.\"\"\"\n\n    def __init__(self, run_id, output_dir, records_per_file=RECORDS_PER_FILE):\n        self._run_id = run_id\n        self._output_dir = output_dir\n        self._records_per_file = records_per_file\n\n    def build(self, step_id, worker_index, worker_count):\n        return JSONLRotatingPartition(\n            run_id=self._run_id,\n            worker_index=worker_index,\n            output_dir=self._output_dir,\n            records_per_file=self._records_per_file,\n        )\n\n\n# Create a list of 200 integers 0..199\nitems = list(range(200))\n\n# Build the dataflow\nflow = Dataflow(\"jsonl-rotation\")\ninp = input(\"inp\", flow, TestingSource(items))\noutput(\"out\", inp, JSONLRotatingSink(RUN_ID, OUTPUT_DIR))\nEOF\n"]
[67.15727, "o", "cat > /home/user/bytewax-sink/run.py << 'EOF'\r\n"]
[67.15945, "o", "\u001b[?2004l\r\u001b[?2004h> import json\r\n\u001b[?2004l\r\u001b[?2004h> import os\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> from bytewax.dataflow import Dataflow\r\n\u001b[?2004l\r\u001b[?2004h> from bytewax.outputs import DynamicSink, StatelessSinkPartition\r\n\u001b[?2004l\r\u001b[?2004h> from bytewax.operators import input, output\r\n\u001b[?2004l\r\u001b[?2004h> from bytewax.testing import TestingSource\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> # Read the run-id from the artifacts directory\r\n\u001b[?2004l\r\u001b[?2004h> RUN_ID_FILE = \"/logs/artifacts/run-id\"\r\n\u001b[?2004l\r\u001b[?2004h> with open(RUN_ID_FILE, \"r\") as f:\r\n\u001b[?2004l\r\u001b[?2004h>     RUN_ID = f.read().strip()\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> # Output directory\r\n\u001b[?2004l\r\u001b[?2004h> OUTPUT_DIR = \"/home/user/bytewax-sink/out\"\r\n\u001b[?2004l\r\u001b[?2004h> os.makedirs(OUTPUT_DIR, exist_ok=True)\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> RECORDS_PER_FILE = 20\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> class JSONLRotatingPartition(StatelessSinkPartition):\r\n\u001b[?2004l\r\u001b[?2004h>     \"\"\"A stateless sink partition that writes items to JSONL files with rotation.\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h>     Each file contains at most RECORDS_PER_FILE records. When the limit is reached,\r\n\u001b[?2004l\r\u001b[?2004h>     the file is closed and a new file with the next part number is opened.\r\n\u001b[?2004l\r\u001b[?2004h>     \"\"\"\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h>     def __init__(self, run_id, worker_index, output_dir, records_per_file=RECORDS_PER_FILE):\r\n\u001b[?2004l\r\u001b[?2004h>         self._run_id = run_id\r\n\u001b[?2004l\r\u001b[?2004h>         self._worker_index = worker_index\r\n\u001b[?2004l\r\u001b[?2004h>         self._output_dir = output_dir\r\n\u001b[?2004l\r\u001b[?2004h>         self._records_per_file = records_per_file\r\n\u001b[?2004l\r\u001b[?2004h>         self._part_number = 0\r\n\u001b[?2004l\r\u001b[?2004h>         self._records_in_current_file = 0\r\n\u001b[?2004l\r\u001b[?2004h>         self._current_file = None\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h>     def _current_path(self):\r\n\u001b[?2004l\r\u001b[?2004h>         return os.path.join(\r\n\u001b[?2004l\r\u001b[?2004h>             self._output_dir,\r\n\u001b[?2004l\r\u001b[?2004h>             f\"output-{self._run_id}-worker-{self._worker_index}-part-{self._part_number}.jsonl\",\r\n\u001b[?2004l\r\u001b[?2004h>         )\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h>     def _open_file(self):\r\n\u001b[?2004l\r\u001b[?2004h>         \"\"\"Open a new file for the current part.\"\"\"\r\n\u001b[?2004l\r\u001b[?2004h>         if self._current_file is None:\r\n\u001b[?2004l\r\u001b[?2004h>             path = self._current_path()\r\n\u001b[?2004l\r\u001b[?2004h>             self._current_file = open(path, \"w\")\r\n\u001b[?2004l\r\u001b[?2004h>             self._records_in_current_file = 0\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h>     def _close_file(self):\r\n\u001b[?2004l\r\u001b[?2004h>         \"\"\"Close the currently open file, if any.\"\"\"\r\n\u001b[?2004l\r\u001b[?2004h>         if self._current_file is not None:\r\n\u001b[?2004l\r\u001b[?2004h>             self._current_file.close()\r\n\u001b[?2004l\r\u001b[?2004h>             self._current_file = None\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h>     def _rotate(self):\r\n\u001b[?2004l\r\u001b[?2004h>         \"\"\"Close current file and advance part number for the next one.\"\"\"\r\n\u001b[?2004l\r\u001b[?2004h>         self._close_file()\r\n\u001b[?2004l\r\u001b[?2004h>         self._part_number += 1\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
