[104.037764, "i", "python3 -c \"\nimport json\nimport glob\ntotal = 0\nvalues = []\nfor f in sorted(glob.glob('/home/user/bytewax-sink/out/*.jsonl')):\n    with open(f) as fp:\n        for line in fp:\n            obj = json.loads(line)\n            assert 'worker' in obj and 'value' in obj\n            assert isinstance(obj['worker'], int)\n            assert isinstance(obj['value'], int)\n            values.append(obj['value'])\n            total += 1\nprint(f'Total records: {total}')\nprint(f'All values present: {sorted(values) == list(range(200))}')\nprint(f'Values range: {min(values)} to {max(values)}')\n\"\n"]
[104.037961, "o", "python3 -c \"\r\n\u001b[?2004l\r"]
