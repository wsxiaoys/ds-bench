[43.210249, "i", "sed -n '140,200p' /usr/local/lib/python3.12/dist-packages/bytewax/testing.py\n"]
[43.210473, "o", "sed -n '140,200p' /usr/local/lib/python3.12/dist-packages/bytewax/testing.py\r\n\u001b[?2004l\r"]
[43.211734, "o", "    def next_awake(self) -> Optional[datetime]:\r\n        return self._next_awake\r\n\r\n    @override\r\n    def snapshot(self) -> int:\r\n        return self._start_idx\r\n\r\n\r\nclass TestingSource(FixedPartitionedSource[X, int]):\r\n    \"\"\"Produce input from a Python iterable.\r\n\r\n    You only want to use this for unit testing.\r\n\r\n    The iterable must be identical on all workers.\r\n\r\n    There is no parallelism; only one worker will actually consume the\r\n    iterable.\r\n\r\n"]
[43.21178, "o", "    Be careful using a generator as the iterable; if you fail and\r\n    attempt to resume the dataflow without rebuilding it, the\r\n    half-consumed generator will be re-used on recovery and early\r\n    input will be lost so resume will see the correct data.\r\n\r\n    \"\"\"\r\n\r\n    __test__ = False\r\n\r\n    @dataclass\r\n    class EOF:\r\n        \"\"\"Signal the input to EOF.\r\n\r\n        The next execution will continue from the item after this.\r\n\r\n        \"\"\"\r\n\r\n        pass\r\n\r\n    # TODO: Find a way to use ABORT in a multi-worker scenario.\r\n    # Something like a back channel that one has aborted.\r\n    @dataclass\r\n    class ABORT:\r\n        \"\"\"Abort the execution when the input processes this item.\r\n\r\n        The next execution will resume from some item befor this one.\r\n\r\n        Each abort will only trigger once. They'll be skipped on\r\n        resume executions.\r\n\r\n        You cannot use this in multi-worker executions because the\r\n        other workers don't know when to stop.\r\n\r\n        \"\"\"\r\n\r\n        _triggered: bool = False\r\n\r\n    @dataclass\r\n    class PAUSE:\r\n        \"\"\"Signal this input to not emit items for a duration.\"\"\"\r\n\r\n        for_duration: timedelta\r\n\r\n"]
[43.211989, "o", "\u001b[?2004hroot@018f3f93-1e8d-4bf2-9ed6-81373c3c59c6:/home/user/bytewax-sink# "]
[54.851817, "i", "cat > /home/user/bytewax-sink/run.py << 'EOF'\nimport json\nimport os\n\nfrom bytewax.dataflow import Dataflow\nfrom bytewax.inputs import FixedPartitionedSource\nfrom bytewax.outputs import DynamicSink, StatelessSinkPartition\nfrom bytewax.operators import input, output\nfrom bytewax.testing import TestingSource\n\n\n# Read the run-id from the artifacts directory\nRUN_ID_FILE = \"/logs/artifacts/run-id\"\nwith open(RUN_ID_FILE, \"r\") as f:\n    RUN_ID = f.read().strip()\n\n# Output directory\nOUTPUT_DIR = \"/home/user/bytewax-sink/out\"\nos.makedirs(OUTPUT_DIR, exist_ok=True)\n\n\nclass JSONLRotatingPartition(StatelessSinkPartition):\n    \"\"\"A stateless sink partition that writes items to JSONL files with rotation.\n\n    Each file contains at most RECORDS_PER_FILE records. When the limit is reached,\n    the file is closed and a new file with the next part number is opened.\n    \"\"\"\n\n    def __init__(self, run_id, worker_index, output_dir, records_per_file=20):\n        self._run_id = run_id\n        self._worker_index = worker_index\n        self._output_dir = output_dir\n        self._records_per_file = records_per_file\n        self._part_number = 0\n        self._records_in_current_file = 0\n        self._current_file = None\n\n    def _current_path(self):\n        return os.path.join(\n            self._output_dir,\n            f\"output-{self._run_id}-worker-{self._worker_index}-part-{self._part_number}.jsonl\",\n        )\n\n    def _ensure_file(self):\n        \"\"\"Open a new file if one is not currently open.\"\"\"\n        if self._current_file is None:\n            path = self._current_path()\n            self._current_file = open(path, \"a\")\n\n    def _close_file(self):\n        \"\"\"Close the current file (if any) and reset state.\"\"\"\n        if self._current_file is not None:\n            self._current_file.close()\n            self._current_file = None\n\n    def _advance_part(self):\n        \"\"\"Move to the next part number.\"\"\"\n        self._close_file()\n        self._part_number += 1\n        self._records_in_current_file = 0\n\n    def write_batch(self, items):\n        \"\"\"Write items to the current file, rotating as needed.\"\"\"\n        for item in items:\n            # If the current file is full, rotate to a new part\n            if self._records_in_current_file >= self._records_per_file:\n                self._advance_part()\n\n            # Ensure a file is open\n            self._ensure_file()\n\n            # Write the record\n            record = {\"worker\": self._worker_index, \"value\": item}\n            self._current_file.write(json.dumps(record) + \"\\n\")\n            self._records_in_current_file += 1\n\n            # If this write filled up the file, close it immediately\n            if self._records_in_current_file >= self._records_per_file:\n                self._close_file()\n                # Prepare for the next part, but don't open a new file yet.\n                # We'll advance the part number when we actually need to write again.\n                # But the spec says we need to advance to next part number.\n                self._part_number += 1\n                self._records_in_current_file = 0\n\n    def close(self):\n        \"\"\"Close any open file when the partition is closed.\"\"\"\n        self._close_file()\n\n\nclass JSONLRotatingSink(DynamicSink):\n    \"\"\"A dynamic sink that writes items to rotating JSONL files per worker.\"\"\"\n\n    def __init__(self, run_id, output_dir, records_per_file=20):\n        self._run_id = run_id\n        self._output_dir = output_dir\n        self._records_per_file = records_per_file\n\n    def build(self, step_id, worker_index, worker_count):\n        return JSONLRotatingPartition(\n            run_id=self._run_id,\n            worker_index=worker_index,\n            output_dir=self._output_dir,\n            records_per_file=self._records_per_file,\n        )\n\n\n# Create a list of 200 integers 0..199\nitems = list(range(200))\n\n# Build the dataflow\nflow = Dataflow(\"jsonl-rotation\")\ninp = input(\"inp\", flow, TestingSource(items))\noutput(\"out\", inp, JSONLRotatingSink(RUN_ID, OUTPUT_DIR))\nEOF\n"]
[54.852071, "o", "cat > /home/user/bytewax-sink/run.py << 'EOF'\r\n\u001b[?2004l\r\u001b[?2004h> "]
