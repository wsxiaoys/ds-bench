[219.392955, "o", " * group metadata in @alchemystai/sdk:\r\n\u001b[?2004l\r"]
[219.393023, "o", "\u001b[?2004h> "]
[219.395784, "o", " *  - v1.context.add  -> metadata.group_name (snake_case) when ingesting\r\n\u001b[?2004l\r\u001b[?2004h>  *  - v1.context.search -> metadata.groupName (camelCase) when filtering\r\n\u001b[?2004l\r\u001b[?2004h>  *\r\n\u001b[?2004l\r\u001b[?2004h>  * Usage:\r\n\u001b[?2004l\r\u001b[?2004h>  *   node dist/main.js --groups eng v1\r\n\u001b[?2004l\r\u001b[?2004h>  *\r\n\u001b[?2004l\r\u001b[?2004h>  * Outputs a single JSON array on stdout containing the deduplicated matched\r\n\u001b[?2004l\r\u001b[?2004h>  * documents (each with at least a `key` field).\r\n\u001b[?2004l\r\u001b[?2004h>  */\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> import * as fs from 'fs';\r\n\u001b[?2004l\r\u001b[?2004h> import * as path from 'path';\r\n\u001b[?2004l\r\u001b[?2004h> import AlchemystAI from '@alchemystai/sdk';\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> // ----- Seed corpus -----\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> interface SeedDoc {\r\n\u001b[?2004l\r\u001b[?2004h>   key: string;\r\n\u001b[?2004l\r\u001b[?2004h>   groups: string[];\r\n\u001b[?2004l\r\u001b[?2004h>   content: string;\r\n\u001b[?2004l\r\u001b[?2004h> }\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> const SEED: SeedDoc[] = [\r\n\u001b[?2004l\r\u001b[?2004h>   {\r\n\u001b[?2004l\r\u001b[?2004h>     key: 'ENG_V1_DOC',\r\n\u001b[?2004l\r\u001b[?2004h>     groups: ['eng', 'v1'],\r\n\u001b[?2004l\r\u001b[?2004h>     content:\r\n\u001b[?2004l\r\u001b[?2004h>       'ENG_V1_DOC: Engineering notes for API version 1. ' +\r\n\u001b[?2004l\r\u001b[?2004h>       'This document covers the original REST API surface introduced in v1, ' +\r\n\u001b[?2004l\r\u001b[?2004h>       'including endpoints, authentication via API keys, request/response ' +\r\n\u001b[?2004l\r\u001b[?2004h>       'schemas, rate limiting, and deprecation policy for v1 endpoints.',\r\n\u001b[?2004l\r\u001b[?2004h>   },\r\n\u001b[?2004l\r\u001b[?2004h>   {\r\n\u001b[?2004l\r\u001b[?2004h>     key: 'ENG_V2_DOC',\r\n\u001b[?2004l\r\u001b[?2004h>     groups: ['eng', 'v2'],\r\n\u001b[?2004l\r\u001b[?2004h>     content:\r\n\u001b[?2004l\r\u001b[?2004h>       'ENG_V2_DOC: Engineering notes for API version 2. ' +\r\n\u001b[?2004l\r\u001b[?2004h>       'This document covers the v2 release of the API: new endpoints, ' +\r\n\u001b[?2004l\r\u001b[?2004h>       'breaking changes vs v1, JSON-only payloads, OAuth2 auth, versioning ' +\r\n\u001b[?2004l\r\u001b[?2004h>       'headers, and migration guidance for clients still on v1.',\r\n\u001b[?2004l\r\u001b[?2004h>   },\r\n\u001b[?2004l\r\u001b[?2004h>   {\r\n\u001b[?2004l\r\u001b[?2004h>     key: 'PRODUCT_V1_DOC',\r\n\u001b[?2004l\r\u001b[?2004h>     groups: ['product', 'v1'],\r\n\u001b[?2004l\r\u001b[?2004h>     content:\r\n\u001b[?2004l\r\u001b[?2004h>       'PRODUCT_V1_DOC: Product notes for release version 1. ' +\r\n\u001b[?2004l\r\u001b[?2004h>       'This document covers the v1 product launch: positioning, target ' +\r\n\u001b[?2004l\r\u001b[?2004h>       'customers, core feature set, pricing tiers, launch checklist, ' +\r\n\u001b[?2004l\r\u001b[?2004h>       'success metrics, and roadmap inputs that fed into the v1 release.',\r\n\u001b[?2004l\r\u001b[?2004h>   },\r\n\u001b[?2004l\r\u001b[?2004h>   {\r\n\u001b[?2004l\r\u001b[?2004h>     key: 'PRODUCT_V2_DOC',\r\n\u001b[?2004l\r\u001b[?2004h>     groups: ['product', 'v2'],\r\n\u001b[?2004l\r\u001b[?2004h>     content:\r\n\u001b[?2004l\r\u001b[?2004h>       'PRODUCT_V2_DOC: Product notes for release version 2. ' +\r\n\u001b[?2004l\r\u001b[?2004h>       'This document covers the v2 product release: new positioning, ' +\r\n\u001b[?2004l\r\u001b[?2004h>       'expanded ICP, new features beyond v1, updated pricing, GTM plan, ' +\r\n\u001b[?2004l\r\u001b[?2004h>       'launch readiness review, and what we learned from v1 customers.',\r\n\u001b[?2004l\r\u001b[?2004h>   },\r\n\u001b[?2004l\r\u001b[?2004h> ];\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> // ----- CLI parsing -----\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> function parseArgs(argv: string[]): string[] {\r\n\u001b[?2004l\r\u001b[?2004h>   const groups: string[] = [];\r\n\u001b[?2004l\r\u001b[?2004h>   let i = 0;\r\n\u001b[?2004l\r\u001b[?2004h>   while (i < argv.length) {\r\n\u001b[?2004l\r\u001b[?2004h>     const a = argv[i];\r\n\u001b[?2004l\r\u001b[?2004h>     if (a === '--groups') {\r\n\u001b[?2004l\r\u001b[?2004h>       i++;\r\n\u001b[?2004l\r\u001b[?2004h>       while (i < argv.length && !argv[i].startsWith('--')) {\r\n\u001b[?2004l\r\u001b[?2004h>         groups.push(argv[i]);\r\n\u001b[?2004l\r\u001b[?2004h>         i++;\r\n\u001b[?2004l\r\u001b[?2004h>       }\r\n\u001b[?2004l\r\u001b[?2004h>     } else {\r\n\u001b[?2004l\r\u001b[?2004h>       // ignore unknown flags\r\n\u001b[?2004l\r\u001b[?2004h>       i++;\r\n\u001b[?2004l\r\u001b[?2004h>     }\r\n\u001b[?2004l\r\u001b[?2004h>   }\r\n\u001b[?2004l\r\u001b[?2004h>   return groups;\r\n\u001b[?2004l\r\u001b[?2004h> }\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> // ----- Run-id resolution -----\r\n"]
[219.396369, "o", "\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> function resolveRunId(): string {\r\n\u001b[?2004l\r\u001b[?2004h>   const envRunId = process.env.RUN_ID;\r\n\u001b[?2004l\r\u001b[?2004h>   if (envRunId && envRunId.length > 0) return envRunId;\r\n\u001b[?2004l\r\u001b[?2004h>   const filePath = '/logs/artifacts/run-id';\r\n\u001b[?2004l\r\u001b[?2004h>   try {\r\n\u001b[?2004l\r\u001b[?2004h>     const txt = fs.readFileSync(filePath, 'utf8').trim();\r\n\u001b[?2004l\r\u001b[?2004h>     if (txt.length > 0) return txt;\r\n\u001b[?2004l\r\u001b[?2004h>   } catch (_) {\r\n\u001b[?2004l\r\u001b[?2004h>     // fall through\r\n\u001b[?2004l\r\u001b[?2004h>   }\r\n\u001b[?2004l\r\u001b[?2004h>   return `local-${Date.now()}`;\r\n\u001b[?2004l\r\u001b[?2004h> }\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> // ----- Helpers -----\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> function extractKeyFromContent(content: string): string | null {\r\n\u001b[?2004l\r\u001b[?2004h>   const m = content.match(/\\b(ENG_V1_DOC|ENG_V2_DOC|PRODUCT_V1_DOC|PRODUCT_V2_DOC)\\b/);\r\n\u001b[?2004l\r\u001b[?2004h>   return m ? m[1] : null;\r\n\u001b[?2004l\r\u001b[?2004h> }\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> function extractKeyFromMeta(meta: unknown): string | null {\r\n\u001b[?2004l\r\u001b[?2004h>   if (!meta || typeof meta !== 'object') return null;\r\n\u001b[?2004l\r\u001b[?2004h>   const m = meta as Record<string, unknown>;\r\n\u001b[?2004l\r\u001b[?2004h>   const fileName = m['fileName'] ?? m['file_name'];\r\n\u001b[?2004l\r\u001b[?2004h>   if (typeof fileName === 'string') {\r\n\u001b[?2004l\r\u001b[?2004h>     const m2 = fileName.match(/^(ENG_V1_DOC|ENG_V2_DOC|PRODUCT_V1_DOC|PRODUCT_V2_DOC)-/);\r\n\u001b[?2004l\r\u001b[?2004h>     if (m2) return m2[1];\r\n\u001b[?2004l\r\u001b[?2004h>   }\r\n\u001b[?2004l\r\u001b[?2004h>   // also accept a direct `key` field if present\r\n\u001b[?2004l\r\u001b[?2004h>   const directKey = m['key'];\r\n\u001b[?2004l\r\u001b[?2004h>   if (typeof directKey === 'string' && /^(ENG|PRODUCT)_/.test(directKey)) return directKey;\r\n\u001b[?2004l\r\u001b[?2004h>   return null;\r\n\u001b[?2004l\r\u001b[?2004h> }\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> async function sleep(ms: number): Promise<void> {\r\n\u001b[?2004l\r\u001b[?2004h>   return new Promise((r) => setTimeout(r, ms));\r\n\u001b[?2004l\r\u001b[?2004h> }\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> // ----- Main -----\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> async function main(): Promise<void> {\r\n\u001b[?2004l\r\u001b[?2004h>   const groups = parseArgs(process.argv.slice(2));\r\n\u001b[?2004l\r\u001b[?2004h>   if (groups.length === 0) {\r\n\u001b[?2004l\r\u001b[?2004h>     process.stderr.write('Usage: node dist/main.js --groups <g1> [g2] ...\\n');\r\n\u001b[?2004l\r\u001b[?2004h>     process.exit(2);\r\n\u001b[?2004l\r\u001b[?2004h>   }\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h>   const apiKey = process.env.ALCHEMYST_AI_API_KEY;\r\n\u001b[?2004l\r\u001b[?2004h>   if (!apiKey || apiKey.length === 0) {\r\n\u001b[?2004l\r\u001b[?2004h>     process.stderr.write('ALCHEMYST_AI_API_KEY is not set\\n');\r\n\u001b[?2004l\r\u001b[?2004h>     process.exit(2);\r\n\u001b[?2004l\r\u001b[?2004h>   }\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[219.397775, "o", "  const runId = resolveRunId();\r\n\u001b[?2004l\r\u001b[?2004h>   process.stderr.write(`[alchemyst-cli] run-id=${runId} groups=[${groups.join(',')}]\\n`);\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h>   const client = new AlchemystAI({ apiKey });\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h>   // ----- Ingest the seed corpus -----\r\n\u001b[?2004l\r\u001b[?2004h>   // The task spec requires using group_name (snake_case) when adding documents,\r\n\u001b[?2004l\r\u001b[?2004h>   // because the TypeScript SDK is parameter-asymmetric between write/read.\r\n\u001b[?2004l\r\u001b[?2004h>   for (const doc of SEED) {\r\n\u001b[?2004l\r\u001b[?2004h>     const fileName = `${doc.key}-${runId}.md`;\r\n\u001b[?2004l\r\u001b[?2004h>     try {\r\n\u001b[?2004l\r\u001b[?2004h>       await client.v1.context.add({\r\n\u001b[?2004l\r\u001b[?2004h> "]
[219.397962, "o", "        documents: [{ content: doc.content }],\r\n\u001b[?2004l\r\u001b[?2004h"]
[219.398044, "o", ">         context_type: 'resource',"]
[219.398242, "o", "\r\n\u001b[?2004l\r\u001b[?2004h>         source: `alchemyst-cli-${runId}`,"]
[219.39827, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[219.398348, "o", "        scope: 'internal',"]
[219.398383, "o", "\r\n\u001b[?2004l\r\u001b[?2004h>         metadata: {"]
[219.398462, "o", "\r\n\u001b[?2004l\r\u001b[?2004h"]
[219.398489, "o", ">           fileName,"]
[219.398557, "o", "\r\n\u001b[?2004l\r\u001b[?2004h"]
[219.39857, "o", "> "]
[219.398651, "o", "          fileType: 'text/markdown',\r\n"]
[219.398692, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[219.398791, "o", "          // INTENTIONAL snake_case per the task spec quirk:\r\n"]
[219.398799, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[219.39892, "o", "          // use `group_name` (not `groupName`) on add.\r\n"]
[219.398927, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[219.399007, "o", "          group_name: doc.groups as unknown as string[],"]
[219.399035, "o", "\r\n\u001b[?2004l\r\u001b[?2004h"]
[219.399112, "o", ">           lastModified: new Date().toISOString(),"]
[219.399177, "o", "\r\n"]
[219.399223, "o", "\u001b[?2004l\r\u001b[?2004h"]
[219.399248, "o", "> "]
[219.399281, "o", "          fileSize: doc.content.length,"]
[219.399367, "o", "\r\n\u001b[?2004l\r\u001b[?2004h"]
[219.399374, "o", "> "]
[219.399486, "o", "          // We also keep a `key` field for easier verification on read.\r\n\u001b[?2004l\r\u001b[?2004h"]
[219.399521, "o", ">           key: doc.key,"]
[219.399592, "o", "\r\n\u001b[?2004l\r\u001b[?2004h"]
[219.399599, "o", ">         } as unknown as Record<string, unknown>,"]
[219.399668, "o", "\r\n"]
[219.399718, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[219.399775, "o", "      });"]
[219.399827, "o", "\r\n\u001b[?2004l\r\u001b[?2004h>       process.stderr.write(`[alchemyst-cli] added ${doc.key} as ${fileName}\\n`);"]
[219.399896, "o", "\r\n"]
[219.399941, "o", "\u001b[?2004l\r"]
[219.399986, "o", "\u001b[?2004h> "]
[219.400033, "o", "    } catch (err: any) {"]
[219.40007, "o", "\r\n"]
[219.400129, "o", "\u001b[?2004l\r"]
[219.400173, "o", "\u001b[?2004h"]
[219.40022, "o", "> "]
[219.400298, "o", "      // Tolerate 409 conflict on re-runs of the same run-id."]
[219.400359, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[219.400409, "o", "      const status: number | undefined ="]
[219.40046, "o", "\r\n\u001b[?2004l\r\u001b[?2004h"]
[219.400508, "o", "> "]
[219.400555, "o", "        err?.status ?? err?.statusCode ?? err?.response?.status;"]
[219.400632, "o", "\r\n\u001b[?2004l\r"]
[219.400667, "o", "\u001b[?2004h> "]
[219.400754, "o", "      const msg: string = err?.message ?? String(err);\r\n\u001b[?2004l\r\u001b[?2004h"]
[219.400769, "o", "> "]
[219.400864, "o", "      if (status === 409 || /409|conflict/i.test(msg)) {\r\n"]
[219.400893, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[219.400984, "o", "        process.stderr.write(`[alchemyst-cli] ${doc.key} already exists (409) - skipping\\n`);"]
[219.401037, "o", "\r\n\u001b[?2004l\r\u001b[?2004h"]
[219.401117, "o", ">       } else {"]
[219.401156, "o", "\r\n\u001b[?2004l\r"]
[219.401223, "o", "\u001b[?2004h"]
[219.401233, "o", ">         process.stderr.write(`[alchemyst-cli] failed to add ${doc.key}: ${msg}\\n`);"]
[219.401383, "o", "\r\n"]
[219.401453, "o", "\u001b[?2004l\r\u001b[?2004h"]
[219.401493, "o", ">       }"]
[219.401533, "o", "\r\n\u001b[?2004l\r"]
[219.401565, "o", "\u001b[?2004h> "]
[219.401598, "o", "    }\r\n\u001b[?2004l\r"]
[219.40162, "o", "\u001b[?2004h> "]
[219.401645, "o", "  }\r\n"]
[219.401669, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[219.40173, "o", "\r\n\u001b[?2004l\r\u001b[?2004h"]
[219.401739, "o", ">   // Give the backend a moment to index the documents before searching."]
[219.401886, "o", "\r\n"]
[219.401927, "o", "\u001b[?2004l\r\u001b[?2004h"]
[219.402009, "o", ">   await sleep(1500);"]
[219.4021, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> \r\n"]
[219.402199, "o", "\u001b[?2004l\r"]
[219.402258, "o", "\u001b[?2004h> "]
[219.402406, "o", "  // ----- Context Arithmetic intersection search -----\r\n"]
[219.402481, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[219.40261, "o", "  // The task spec requires camelCase groupName on search."]
[219.402662, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[219.402726, "o", "  const query =\r\n"]
[219.402795, "o", "\u001b[?2004l\r\u001b[?2004h"]
[219.402821, "o", ">     'engineering product API release version v1 v2 notes documentation';"]
[219.402937, "o", "\r\n\u001b[?2004l\r"]
[219.403015, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[219.403048, "o", "> "]
[219.403155, "o", "  let rawContexts: any[] = [];\r\n\u001b[?2004l\r\u001b[?2004h"]
[219.403201, "o", "> "]
[219.403281, "o", "  let lastErr: unknown = null;"]
[219.403305, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[219.403403, "o", "  for (let attempt = 0; attempt < 4; attempt++) {\r\n"]
[219.403452, "o", "\u001b[?2004l\r\u001b[?2004h"]
[219.403506, "o", "> "]
[219.403549, "o", "    try {\r\n"]
[219.403613, "o", "\u001b[?2004l\r\u001b[?2004h"]
[219.403655, "o", "> "]
[219.403726, "o", "      const resp = await client.v1.context.search({"]
[219.403792, "o", "\r\n\u001b[?2004l\r\u001b[?2004h"]
[219.403866, "o", ">         query,"]
[219.403963, "o", "\r\n\u001b[?2004l\r\u001b[?2004h"]
[219.403994, "o", ">         similarity_threshold: 0.5,"]
[219.404086, "o", "\r\n\u001b[?2004l\r"]
[219.404138, "o", "\u001b[?2004h> "]
[219.404277, "o", "        minimum_similarity_threshold: 0.1,\r\n\u001b[?2004l\r\u001b[?2004h"]
[219.40429, "o", ">         scope: 'internal',"]
[219.404387, "o", "\r\n"]
[219.40443, "o", "\u001b[?2004l\r\u001b[?2004h"]
[219.404491, "o", "> "]
[219.40453, "o", "        // ask the API to include metadata so we can recover the key."]
[219.40462, "o", "\r\n"]
[219.404685, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[219.404786, "o", "        metadata: 'true',\r\n\u001b[?2004l\r\u001b[?2004h"]
[219.40484, "o", ">         mode: 'standard',"]
[219.404902, "o", "\r\n\u001b[?2004l\r"]
[219.404941, "o", "\u001b[?2004h"]
[219.404987, "o", "> "]
[219.405159, "o", "        // CamelCase `groupName` per the task spec quirk on search.\r\n\u001b[?2004l\r\u001b[?2004h"]
[219.405179, "o", "> "]
[219.405258, "o", "        body_metadata: {\r\n\u001b[?2004l\r"]
[219.405313, "o", "\u001b[?2004h"]
[219.405346, "o", "> "]
[219.405453, "o", "          groupName: groups,\r\n\u001b[?2004l\r\u001b[?2004h"]
[219.405477, "o", "> "]
[219.405543, "o", "        } as unknown as Record<string, unknown>,"]
[219.405648, "o", "\r\n\u001b[?2004l\r\u001b[?2004h"]
[219.405694, "o", ">       });"]
[219.405735, "o", "\r\n\u001b[?2004l\r"]
[219.405849, "o", "\u001b[?2004h"]
[219.405897, "o", ">       rawContexts = (resp?.contexts ?? []) as any[];"]
[219.405967, "o", "\r\n\u001b[?2004l\r\u001b[?2004h"]
[219.406001, "o", ">       break;"]
[219.406047, "o", "\r\n\u001b[?2004l\r\u001b[?2004h"]
[219.406134, "o", ">     } catch (err) {"]
[219.406214, "o", "\r\n\u001b[?2004l\r\u001b[?2004h"]
[219.406255, "o", "> "]
[219.406322, "o", "      lastErr = err;"]
[219.406362, "o", "\r\n\u001b[?2004l\r"]
[219.40641, "o", "\u001b[?2004h"]
[219.406467, "o", "> "]
[219.406546, "o", "      process.stderr.write(\r\n"]
[219.40659, "o", "\u001b[?2004l\r\u001b[?2004h"]
[219.40665, "o", "> "]
[219.406766, "o", "        `[alchemyst-cli] search attempt ${attempt + 1} failed: ${"]
[219.406819, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[219.406958, "o", "          (err as any)?.message ?? String(err)\r\n\u001b[?2004l\r\u001b[?2004h"]
[219.407044, "o", ">         }\\n`,\r\n\u001b[?2004l\r"]
[219.407133, "o", "\u001b[?2004h>       );"]
[219.407172, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[219.407257, "o", "      await sleep(1500 * (attempt + 1));"]
[219.407308, "o", "\r\n\u001b[?2004l\r\u001b[?2004h"]
[219.407365, "o", "> "]
[219.407424, "o", "    }\r\n\u001b[?2004l\r\u001b[?2004h"]
[219.407533, "o", ">   }"]
[219.407555, "o", "\r\n\u001b[?2004l\r\u001b[?2004h>   if (rawContexts.length === 0 && lastErr) {"]
[219.407636, "o", "\r\n\u001b[?2004l\r"]
[219.407753, "o", "\u001b[?2004h"]
[219.407766, "o", ">     process.stderr.write(`[alchemyst-cli] search ultimately failed: ${(lastErr as any)?.message ?? lastErr}\\n`);"]
[219.407856, "o", "\r\n"]
[219.407925, "o", "\u001b[?2004l\r"]
[219.407988, "o", "\u001b[?2004h"]
[219.40803, "o", ">   }\r\n\u001b[?2004l\r\u001b[?2004h"]
[219.408074, "o", "> \r\n"]
[219.408155, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[219.408207, "o", "  // ----- Deduplicate and shape the output -----"]
[219.408279, "o", "\r\n\u001b[?2004l\r"]
[219.408339, "o", "\u001b[?2004h"]
[219.408348, "o", ">   const seen = new Set<string>();"]
[219.408438, "o", "\r\n\u001b[?2004l\r"]
[219.408504, "o", "\u001b[?2004h>   const results: Array<Record<string, unknown>> = [];"]
[219.408608, "o", "\r\n\u001b[?2004l\r"]
[219.408643, "o", "\u001b[?2004h> "]
[219.408678, "o", "  for (const ctx of rawContexts) {"]
[219.408756, "o", "\r\n\u001b[?2004l\r"]
[219.40884, "o", "\u001b[?2004h"]
[219.40885, "o", ">     const content = typeof ctx?.content === 'string' ? ctx.content : '';"]
[219.408978, "o", "\r\n\u001b[?2004l\r"]
[219.409034, "o", "\u001b[?2004h> "]
[219.409149, "o", "    const meta = ctx?.metadata;"]
[219.409196, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[219.409248, "o", "    const keyFromMeta = extractKeyFromMeta(meta);"]
[219.409365, "o", "\r\n\u001b[?2004l\r\u001b[?2004h"]
[219.409374, "o", ">     const keyFromContent = extractKeyFromContent(content);"]
[219.409471, "o", "\r\n"]
[219.409532, "o", "\u001b[?2004l\r\u001b[?2004h>     const key = keyFromMeta ?? keyFromContent;"]
[219.409596, "o", "\r\n"]
[219.409655, "o", "\u001b[?2004l\r"]
[219.40973, "o", "\u001b[?2004h> "]
[219.409768, "o", "    if (!key) continue;"]
[219.409846, "o", "\r\n"]
[219.409903, "o", "\u001b[?2004l\r"]
[219.409942, "o", "\u001b[?2004h>     if (seen.has(key)) continue;"]
[219.410017, "o", "\r\n\u001b[?2004l\r"]
[219.410105, "o", "\u001b[?2004h> "]
[219.410155, "o", "    seen.add(key);"]
[219.410204, "o", "\r\n\u001b[?2004l\r"]
[219.410254, "o", "\u001b[?2004h> "]
[219.410355, "o", "\r\n\u001b[?2004l\r\u001b[?2004h"]
[219.410405, "o", ">     const result: Record<string, unknown> = { key };"]
[219.410496, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[219.410508, "o", "    if (content) result.content = content;"]
[219.41057, "o", "\r\n"]
[219.410688, "o", "\u001b[?2004l\r"]
[219.410701, "o", "\u001b[?2004h>     if (meta && typeof meta === 'object') result.metadata = meta;"]
[219.410771, "o", "\r\n"]
[219.410831, "o", "\u001b[?2004l\r"]
[219.41092, "o", "\u001b[?2004h> "]
[219.410929, "o", "    if (typeof ctx?.score === 'number') result.score = ctx.score;"]
[219.411008, "o", "\r\n"]
[219.411111, "o", "\u001b[?2004l\r\u001b[?2004h"]
[219.411121, "o", ">     // also include file_name when available for verifiability"]
[219.411177, "o", "\r\n"]
[219.411226, "o", "\u001b[?2004l\r"]
[219.411267, "o", "\u001b[?2004h"]
[219.411323, "o", "> "]
[219.411438, "o", "    const fileName =\r\n\u001b[?2004l\r\u001b[?2004h"]
[219.411448, "o", "> "]
[219.411542, "o", "      (meta && typeof meta === 'object' && (meta as any).fileName) ||"]
[219.411693, "o", "\r\n\u001b[?2004l\r"]
[219.411705, "o", "\u001b[?2004h>       (meta && typeof meta === 'object' && (meta as any).file_name) ||"]
[219.411824, "o", "\r\n"]
[219.411869, "o", "\u001b[?2004l\r"]
[219.411923, "o", "\u001b[?2004h> "]
[219.411988, "o", "      undefined;"]
[219.412035, "o", "\r\n\u001b[?2004l\r"]
[219.412073, "o", "\u001b[?2004h> "]
[219.412166, "o", "    if (fileName) result.file_name = fileName;"]
[219.412251, "o", "\r\n\u001b[?2004l\r\u001b[?2004h"]
[219.41231, "o", ">     results.push(result);"]
[219.4124, "o", "\r\n\u001b[?2004l\r\u001b[?2004h"]
[219.412466, "o", ">   }\r\n"]
[219.412572, "o", "\u001b[?2004l\r\u001b[?2004h"]
[219.412625, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[219.412669, "o", "  // Single JSON array on stdout, nothing else."]
[219.41277, "o", "\r\n\u001b[?2004l\r\u001b[?2004h"]
[219.412888, "o", "> "]
[219.412909, "o", "  process.stdout.write(JSON.stringify(results));"]
[219.413004, "o", "\r\n\u001b[?2004l\r"]
[219.413085, "o", "\u001b[?2004h> "]
[219.413168, "o", "}\r\n\u001b[?2004l\r\u001b[?2004h> "]
[219.413223, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> main().catch((err) => {"]
