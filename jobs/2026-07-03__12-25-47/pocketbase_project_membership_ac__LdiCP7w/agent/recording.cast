[412.223855, "i", "python3 << 'EOF'\nimport sqlite3, json\nc = sqlite3.connect('pb_data/data.db')\nprint('All collections:')\nfor row in c.execute(\"SELECT id, name, type, system FROM _collections\"):\n    print(' -', row)\nprint()\nfor cn in ['projects', 'tasks']:\n    print(f'=== {cn} ===')\n    for row in c.execute(f\"SELECT name, listRule, viewRule, createRule, updateRule, deleteRule FROM _collections WHERE name=?\", (cn,)):\n        for i, col in enumerate(['name','listRule','viewRule','createRule','updateRule','deleteRule']):\n            print(f'  {col}: {row[i]}')\n    for row in c.execute(f\"SELECT json_extract(fields,'$') FROM _collections WHERE name=?\", (cn,)):\n        data = json.loads(row[0])\n        for f in data:\n            print(f'  - {f.get(\"name\")} ({f.get(\"type\")}): required={f.get(\"required\")}, cid={f.get(\"collectionId\")}, minSelect={f.get(\"minSelect\")}, maxSelect={f.get(\"maxSelect\")}, min={f.get(\"min\")}, max={f.get(\"max\")}')\nEOF\n"]
