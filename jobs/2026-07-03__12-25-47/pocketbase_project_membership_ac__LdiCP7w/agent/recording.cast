[383.735493, "i", "python3 << 'EOF'\nimport sqlite3\nc = sqlite3.connect('pb_data/data.db')\nprint('Collections:')\nfor row in c.execute(\"SELECT id, name, type, system FROM _collections\"):\n    print(' -', row)\nprint()\nprint('Project collection rules:')\nfor row in c.execute(\"SELECT name, listRule, viewRule, createRule, updateRule, deleteRule FROM _collections WHERE name='projects'\"):\n    for i, col in enumerate(['name','listRule','viewRule','createRule','updateRule','deleteRule']):\n        print(f'  {col}: {row[i]}')\nprint()\nprint('Project fields:')\nfor row in c.execute(\"SELECT name, json_extract(fields,'$') FROM _collections WHERE name='projects'\"):\n    print(' - name:', row[0])\n    print(' - fields:', row[1])\nEOF\n"]
