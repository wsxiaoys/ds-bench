= \"project.members ?= @request.auth.id\";\n  savedTasks.viewRule = \"project.members ?= @request.auth.id\";\n  savedTasks.createRule = \"project.members ?= @request.auth.id\";\n  savedTasks.updateRule = \"project.members ?= @request.auth.id\";\n  savedTasks.deleteRule = \"project.members ?= @request.auth.id\";\n  app.save(savedTasks);\n}, (app) => {\n  try { app.delete(app.findCollectionByNameOrId(\"tasks\")); } catch (_) {}\n  try { app.delete(app.findCollectionByNameOrId(\"projects\")); } catch (_) {}\n});\nMIGRATION_EOF\n"]
