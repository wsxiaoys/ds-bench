[121.128643, "i", "cat > pb_migrations/1700000000_create_projects_and_tasks.js << 'MIGRATION_EOF'\n/// <reference path=\"../pb_data/types.d.ts\" />\n\nmigrate((app) => {\n  const users = app.findCollectionByNameOrId(\"users\");\n\n  // projects collection\n  const projects = new Collection({\n    name: \"projects\",\n    type: \"base\",\n    schema: [\n      {\n        name: \"name\",\n        type: \"text\",\n        required: true,\n        options: { min: 1, max: 500 },\n      },\n      {\n        name: \"members\",\n        type: \"relation\",\n        required: true,\n        options: {\n          collectionId: users.id,\n          cascadeDelete: false,\n          minSelect: 1,\n          maxSelect: 999,\n        },\n      },\n    ],\n  });\n\n  app.save(projects);\n\n  // Update rules via DB to avoid validation timing issue\n  const dao = app.dao() || app.db();\n  // use direct rule setting on persisted collection\n  const savedProjects = app.findCollectionByNameOrId(\"projects\");\n  savedProjects.listRule = \"members ?= @request.auth.id\";\n  savedProjects.viewRule = \"members ?= @request.auth.id\";\n  savedProjects.createRule = \"@request.auth.id != ''\";\n  savedProjects.updateRule = \"members ?= @request.auth.id\";\n  savedProjects.deleteRule = \"members ?= @request.auth.id\";\n  app.save(savedProjects);\n\n  const projectsCol = app.findCollectionByNameOrId(\"projects\");\n\n  const tasks = new Collection({\n    name: \"tasks\",\n    type: \"base\",\n    schema: [\n      {\n        name: \"title\",\n        type: \"text\",\n        required: true,\n        options: { min: 1, max: 500 },\n      },\n      {\n        name: \"description\",\n        type: \"text\",\n        required: false,\n        options: { max: 5000 },\n      },\n      {\n        name: \"project\",\n        type: \"relation\",\n        required: true,\n        options: {\n          collectionId: projectsCol.id,\n          cascadeDelete: true,\n          minSelect: 1,\n          maxSelect: 1,\n        },\n      },\n    ],\n  });\n\n  app.save(tasks);\n\n  const savedTasks = app.findCollectionByNameOrId(\"tasks\");\n  savedTasks.listRule = \"project.members ?= @request.auth.id\";\n  savedTasks.viewRule = \"project.members ?= @request.auth.id\";\n  savedTasks.createRule = \"project.members ?= @request.auth.id\";\n  savedTasks.updateRule = \"project.members ?= @request.auth.id\";\n  savedTasks.deleteRule = \"project.members ?= @request.auth.id\";\n  app.save(savedTasks);\n}, (app) => {\n  try { app.delete(app.findCollectionByNameOrId(\"tasks\")); } catch (_) {}\n  try { app.delete(app.findCollectionByNameOrId(\"projects\")); } catch (_) {}\n});\nMIGRATION_EOF\n"]
