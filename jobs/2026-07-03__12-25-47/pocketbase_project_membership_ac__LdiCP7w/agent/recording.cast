[245.195537, "i", "python3 << 'EOF'\nimport sqlite3\nc = sqlite3.connect('pb_data/data.db')\nprint('Collections:')\nfor row in c.execute(\"SELECT id, name, type FROM _collections\"):\n    print(' -', row)\nprint()\nprint('Projects rules:')\nfor row in c.execute(\"SELECT name, listRule, viewRule, createRule, updateRule, deleteRule FROM _collections WHERE name='projects'\"):\n    for i, col in enumerate(['name','listRule','viewRule','createRule','updateRule','deleteRule']):\n        print(f'  {col}: {row[i]}')\nprint()\nprint('Tasks rules:')\nfor row in c.execute(\"SELECT name, listRule, viewRule, createRule, updateRule, deleteRule FROM _collections WHERE name='tasks'\"):\n    for i, col in enumerate(['name','listRule','viewRule','createRule','updateRule','deleteRule']):\n        print(f'  {col}: {row[i]}')\nEOF\n"]
