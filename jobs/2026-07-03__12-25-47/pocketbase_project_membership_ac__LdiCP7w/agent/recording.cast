],\n  });\n\n  app.save(tasks);\n\n  // set the rules after save\n  tasks.listRule = \"@request.auth.id != '' && project.members ?~ @request.auth.id\";\n  tasks.viewRule = \"@request.auth.id != '' && project.members ?~ @request.auth.id\";\n  tasks.createRule = \"@request.auth.id != '' && project.members ?~ @request.auth.id\";\n  tasks.updateRule = \"@request.auth.id != '' && project.members ?~ @request.auth.id\";\n  tasks.deleteRule = \"@request.auth.id != '' && project.members ?~ @request.auth.id\";\n  app.save(tasks);\n}, (app) => {\n  try { app.delete(app.findCollectionByNameOrId(\"tasks\")); } catch (_) {}\n  try { app.delete(app.findCollectionByNameOrId(\"projects\")); } catch (_) {}\n});\nMIGRATION_EOF\n"]
