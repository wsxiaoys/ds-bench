[10.171658, "o", "{\r\n  \"name\": \"trpc-input-validation-task\",\r\n  \"version\": \"1.0.0\",\r\n  \"description\": \"tRPC v11 input validation task\",\r\n  \"main\": \"index.js\",\r\n  \"scripts\": {\r\n    \"test\": \"echo \\\"Error: no test specified\\\" && exit 1\"\r\n  },\r\n  \"dependencies\": {\r\n    \"@trpc/server\": \"next\",\r\n    \"zod\": \"^3.22.4\"\r\n  },\r\n  \"devDependencies\": {\r\n    \"typescript\": \"^5.3.3\",\r\n    \"tsx\": \"^4.7.1\",\r\n    \"@types/node\": \"^20.11.16\"\r\n  }\r\n}\r\n"]
