[15.874917, "i", "cat > router.ts << 'EOF'\nimport { initTRPC } from '@trpc/server';\nimport { z } from 'zod';\n\nconst t = initTRPC.create();\nconst publicProcedure = t.procedure;\nconst router = t.router;\n\nexport const appRouter = router({\n  hello: publicProcedure.query(() => 'Hello World'),\n  registerUser: publicProcedure\n    .input(\n      z.object({\n        username: z.string().min(3),\n        email: z.string().email(),\n        password: z.string().min(8),\n      })\n    )\n    .mutation(({ input }) => ({\n      success: true,\n      user: {\n        username: input.username,\n        email: input.email,\n      },\n    })),\n});\n\nexport type AppRouter = typeof appRouter;\nEOF\n"]
[15.876679, "o", "cat > router.ts << 'EOF'\r\n\u001b[?2004l\r\u001b[?2004h> import { initTRPC } from '@trpc/server';\r\n"]
[15.876699, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[15.876711, "o", "import { z } from 'zod';\r\n\u001b[?2004l\r"]
[15.877328, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> const t = initTRPC.create();\r\n\u001b[?2004l\r\u001b[?2004h> const publicProcedure = t.procedure;\r\n\u001b[?2004l\r\u001b[?2004h> const router = t.router;\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> export const appRouter = router({\r\n\u001b[?2004l\r\u001b[?2004h>   hello: publicProcedure.query(() => 'Hello World'),\r\n\u001b[?2004l\r\u001b[?2004h>   registerUser: publicProcedure\r\n\u001b[?2004l\r\u001b[?2004h>     .input(\r\n\u001b[?2004l\r\u001b[?2004h>       z.object({\r\n\u001b[?2004l\r\u001b[?2004h>         username: z.string().min(3),\r\n\u001b[?2004l\r\u001b[?2004h>         email: z.string().email(),\r\n\u001b[?2004l\r\u001b[?2004h>         password: z.string().min(8),\r\n\u001b[?2004l\r\u001b[?2004h>       })\r\n\u001b[?2004l\r\u001b[?2004h>     )\r\n\u001b[?2004l\r\u001b[?2004h>     .mutation(({ input }) => ({\r\n\u001b[?2004l\r\u001b[?2004h>       success: true,\r\n\u001b[?2004l\r\u001b[?2004h>       user: {\r\n\u001b[?2004l\r\u001b[?2004h>         username: input.username,\r\n\u001b[?2004l\r\u001b[?2004h>         email: input.email,\r\n\u001b[?2004l\r\u001b[?2004h>       },\r\n\u001b[?2004l\r\u001b[?2004h>     })),\r\n\u001b[?2004l\r\u001b[?2004h> });\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> export type AppRouter = typeof appRouter;\r\n\u001b[?2004l\r\u001b[?2004h> EOF\r\n\u001b[?2004l\r"]
