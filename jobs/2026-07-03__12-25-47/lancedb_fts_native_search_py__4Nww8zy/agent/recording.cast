[52.956906, "o", "results = {}\r\n\u001b[?2004l\r\u001b[?2004h> "]
[52.95708, "o", "for qkey, qtext in [(\"query_1\", \"vector database\"), (\"query_2\", \"lance format\")]:\r\n\u001b[?2004l\r"]
[52.957153, "o", "\u001b[?2004h> "]
[52.957284, "o", "    hits = table.search(qtext, query_type=\"fts\").limit(3).to_list()\r\n\u001b[?2004l\r"]
[52.95732, "o", "\u001b[?2004h> "]
[52.957409, "o", "    out = []\r\n\u001b[?2004l\r\u001b[?2004h> "]
[52.957502, "o", "    for h in hits:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[52.957587, "o", "        out.append({\r\n\u001b[?2004l\r\u001b[?2004h> "]
[52.95763, "o", "            \"id\": int(h[\"id\"]),\r\n\u001b[?2004l\r\u001b[?2004h> "]
[52.957713, "o", "            \"title\": h[\"title\"],\r\n\u001b[?2004l\r\u001b[?2004h"]
[52.957783, "o", "> "]
[52.957849, "o", "            \"_score\": float(h[\"_score\"]),\r\n\u001b[?2004l\r\u001b[?2004h"]
[52.957913, "o", ">         })\r\n\u001b[?2004l\r\u001b[?2004h> "]
[52.957977, "o", "    results[qkey] = out\r\n\u001b[?2004l\r"]
[52.958005, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[52.958098, "o", "> "]
[52.958187, "o", "os.makedirs(os.path.dirname(OUT_PATH), exist_ok=True)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[52.958279, "o", "with open(OUT_PATH, \"w\") as f:\r\n\u001b[?2004l\r"]
[52.958307, "o", "\u001b[?2004h> "]
[52.958405, "o", "    json.dump(results, f, indent=2)\r\n\u001b[?2004l\r\u001b[?2004h"]
[52.958434, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[52.958546, "o", "print(json.dumps(results, indent=2))\r\n\u001b[?2004l\r\u001b[?2004h"]
[52.958575, "o", "> '''\r\n\u001b[?2004l\r"]
[52.958663, "o", "\u001b[?2004h> "]
[52.958733, "o", "with open(\"/home/user/fts_script.py\", \"w\") as f:\r\n\u001b[?2004l\r\u001b[?2004h"]
[52.958797, "o", "> "]
[52.958827, "o", "    f.write(script)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[52.958943, "o", "print(\"written\", len(script), \"bytes\")\r\n\u001b[?2004l\r\u001b[?2004h"]
[52.958972, "o", "> OUTER\r\n\u001b[?2004l\r"]
[52.96049, "o", "\u001b[?2004hroot@93b034a4-ce09-498f-bade-1b06996893b7:~# "]
[52.960577, "o", "python3 /tmp/write_script.py\r\n\u001b[?2004l\r"]
