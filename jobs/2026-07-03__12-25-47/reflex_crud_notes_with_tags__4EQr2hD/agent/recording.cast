CONFIG.get())\r\n320:        return config, alembic.script.ScriptDirectory.from_config(config)\r\n322:    def _alembic_render_item(\r\n325:        REDACTEDgen_context: alembic.REDACTEDgenerate.api.AutogenContext,\r\n333:        See https://alembic.sqlalchemy.org/en/latest/api/runtime.html\r\n339:            REDACTEDgen_context: Shared AutogenContext passed to each render_item call.\r\n"]
