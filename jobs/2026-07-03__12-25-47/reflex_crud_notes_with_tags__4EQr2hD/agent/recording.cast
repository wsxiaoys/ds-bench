[283.930794, "o", "\r\n55:    import sqlalchemy\r\n56:    import sqlalchemy.exc\r\n57:    import sqlalchemy.ext.asyncio\r\n58:    import sqlalchemy.orm\r\n63:    def get_engine_args(url: str | None = None) -> dict[str, Any]:\r\n89:    def get_engine(url: str | None = None) -> sqlalchemy.engine.Engine:\r\n122:    def create_all():\r\n125:        ModelRegistry.get_metadata().create_all(engine)\r\n127:    def get_async_engine(url: str | None) -> sqlalchemy.ext.asyncio.AsyncEngine:\r\n170:    def sqla_session(url: str | None = None) -> sqlalchemy.orm.Session:\r\n185:            _metadata: Cache the metadata to avoid re-creating it.\r\n190:        _metadata: ClassVar[sqlalchemy.MetaData | None] = None\r\n193:        def register(cls, model: SQLModelOrSqlAlchemyT) -> SQLModelOrSqlAlchemyT:\r\n206:        def get_models(cls, include_empty: bool = False) -> set[SQLModelOrSqlAlchemy]:\r\n210:                include_empty: If True, include models with empty metadata.\r\n218:                model for model in cls.models if not cls._model_metadata_is_empty(model)\r\n222:        def _model_metadata_is_empty(model: SQLModelOrSqlAlchemy) -> bool:\r\n223:            \"\"\"Check if the model metadata is empty.\r\n229:                True if the model metadata is empty, False otherwise.\r\n231:            return len(model.metadata.tables) == 0\r\n234:        def get_metadata(cls) -> sqlalchemy.MetaData:\r\n235:            \"\"\"Get the database metadata."]
[283.930872, "o", "\r\n238:                The database metadata.\r\n240:            if cls._metadata is not None:\r\n"]
