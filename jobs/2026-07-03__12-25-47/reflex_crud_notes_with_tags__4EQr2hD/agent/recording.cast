[515.461662, "o", "122:    def create_all():\r\n125:        ModelRegistry.get_metadata().create_all(engine)\r\n267:if find_spec(\"sqlalchemy\") and find_spec(\"alembic\"):\r\n268:    import alembic.REDACTEDgenerate\r\n269:    import alembic.command\r\n270:    import alembic.config\r\n271:    import alembic.operations.ops\r\n272:    import alembic.runtime.environment\r\n273:    import alembic.script\r\n274:    from alembic.runtime.migration import MigrationContext\r\n275:    from alembic.script.base import Script\r\n285:            rev: The alembic script object\r\n"]
