[537.370449, "o", "def check_schema_up_to_date():\r\n    \"\"\"Check if the sqlmodel metadata matches the current database schema.\"\"\"\r\n    if get_config().db_url is None or not environment.ALEMBIC_CONFIG.get().exists():\r\n        return\r\n    with model.get_engine().connect() as connection:\r\n        from alembic.util.exc import CommandError\r\n\r\n        try:\r\n            if model.alembic_REDACTEDgenerate(\r\n                connection=connection,\r\n"]
[537.370525, "o", "                write_migration_scripts=False,\r\n            ):\r\n                console.error(\r\n                    \"Detected database schema changes. Run [bold]reflex db makemigrations[/bold] \"\r\n                    \"to generate migration scripts.\",\r\n                )\r\n        except CommandError as command_error:\r\n            if \"Target database is not up to date.\" in str(command_error):\r\n                console.error(\r\n                    f\"{command_error} Run [bold]reflex db migrate[/bold] to update database.\"\r\n                )\r\n\r\n\r\n@once\r\ndef get_user_tier():\r\n    \"\"\"Get the current user's tier.\r\n\r\n    Returns:\r\n"]
[537.370584, "o", "        The current user's tier.\r\n    \"\"\"\r\n    from reflex_cli.v2.utils import hosting\r\n\r\n    authenticated_token = hosting.authenticated_token()\r\n    return (\r\n        authenticated_token[1].get(\"tier\", \"\").lower()\r\n        if authenticated_token[0]\r\n        else \"anonymous\"\r\n    )\r\n"]
[537.371062, "o", "\u001b[?2004hroot@287d1d77-eca7-4b3e-b46c-8019b1c6f4f4:/home/user/myproject# "]
[553.106136, "i", "uv run reflex db migrate\n"]
[553.106432, "o", "uv run reflex db migrate\r\n\u001b[?2004l\r"]
[553.693555, "o", "\u001b[33mDeprecationWarning: reflex.Model has been deprecated in version 0.9.2. Directly use database ORM layer, like sqlalchemy or SQLModel. It will be completely \u001b[0m\r\n\u001b[33mremoved in 1.0.0. (<frozen abc>:106)\u001b[0m\r\n"]
[553.760446, "o", "\u001b[31mDetected database schema changes. Run \u001b[0m\u001b[1;31mreflex db makemigrations\u001b[0m\u001b[31m to generate migration scripts.\u001b[0m\r\n"]
