[334.620358, "o", "\u001b[?2004h> "]
[334.620729, "o", "    def _resolve_tags(self, session, tag_names: List[str]) -> List[Tag]:\r\n\u001b[?2004l\r"]
[334.620763, "o", "\u001b[?2004h"]
[334.620782, "o", "> "]
[334.621136, "o", "        \"\"\"Resolve tag names into Tag rows, creating any missing tags.\"\"\"\r\n\u001b[?2004l\r"]
[334.621169, "o", "\u001b[?2004h"]
[334.62119, "o", "> "]
[334.621274, "o", "        out = []\r\n\u001b[?2004l\r"]
[334.621303, "o", "\u001b[?2004h"]
[334.621331, "o", "> "]
[334.621467, "o", "        for raw in tag_names:\r\n\u001b[?2004l\r"]
[334.621494, "o", "\u001b[?2004h"]
[334.621528, "o", "> "]
[334.621706, "o", "            name = (raw or \"\").strip()\r\n\u001b[?2004l\r"]
[334.621741, "o", "\u001b[?2004h"]
[334.62176, "o", "> "]
[334.621883, "o", "            if not name:\r\n\u001b[?2004l\r"]
[334.621915, "o", "\u001b[?2004h"]
[334.621944, "o", "> "]
[334.622056, "o", "                continue\r\n\u001b[?2004l\r"]
[334.622088, "o", "\u001b[?2004h"]
[334.622116, "o", "> "]
[334.622351, "o", "            tag = _get_or_create_tag(session, name)\r\n\u001b[?2004l\r"]
[334.622385, "o", "\u001b[?2004h"]
[334.622413, "o", "> "]
[334.622564, "o", "            if tag is not None:\r\n\u001b[?2004l\r"]
[334.622594, "o", "\u001b[?2004h"]
[334.622614, "o", "> "]
[334.622779, "o", "                out.append(tag)\r\n\u001b[?2004l\r"]
[334.62281, "o", "\u001b[?2004h"]
[334.622837, "o", "> "]
[334.622921, "o", "        return out\r\n\u001b[?2004l\r"]
[334.622952, "o", "\u001b[?2004h"]
[334.622971, "o", "> \r\n\u001b[?2004l\r"]
[334.623007, "o", "\u001b[?2004h> "]
[334.623277, "o", "    def add_note(self, content: str, tags_text: str):\r\n\u001b[?2004l\r"]
[334.623306, "o", "\u001b[?2004h"]
[334.623325, "o", "> "]
[334.623736, "o", "        \"\"\"Create a new note with the given content and tags (comma separated).\"\"\"\r\n\u001b[?2004l\r"]
[334.623759, "o", "\u001b[?2004h"]
[334.6238, "o", "> "]
[334.623986, "o", "        content = (content or \"\").strip()\r\n\u001b[?2004l\r"]
[334.624017, "o", "\u001b[?2004h"]
[334.624036, "o", "> "]
[334.624154, "o", "        if not content:\r\n\u001b[?2004l\r"]
[334.624183, "o", "\u001b[?2004h"]
[334.624204, "o", "> "]
[334.624299, "o", "            return\r\n\u001b[?2004l\r"]
[334.624329, "o", "\u001b[?2004h"]
[334.624357, "o", "> "]
[334.624753, "o", "        tag_names = [t.strip() for t in (tags_text or \"\").split(\",\") if t.strip()]\r\n\u001b[?2004l\r"]
[334.624773, "o", "\u001b[?2004h"]
[334.624814, "o", "> "]
[334.624977, "o", "        with rx.session() as session:\r\n\u001b[?2004l\r"]
[334.625007, "o", "\u001b[?2004h"]
[334.625026, "o", "> "]
[334.625223, "o", "            note = Note(content=content)\r\n\u001b[?2004l\r"]
[334.625255, "o", "\u001b[?2004h"]
[334.625276, "o", "> "]
[334.625422, "o", "            session.add(note)\r\n\u001b[?2004l\r"]
[334.625453, "o", "\u001b[?2004h"]
[334.625472, "o", "> "]
[334.62563, "o", "            session.commit()\r\n\u001b[?2004l\r"]
[334.625662, "o", "\u001b[?2004h"]
[334.625682, "o", "> "]
[334.625844, "o", "            session.refresh(note)\r\n\u001b[?2004l\r"]
[334.625876, "o", "\u001b[?2004h"]
[334.625895, "o", "> "]
[334.626208, "o", "            for tag in self._resolve_tags(session, tag_names):\r\n\u001b[?2004l\r"]
[334.626231, "o", "\u001b[?2004h> "]
[334.626614, "o", "                session.add(NoteTagLink(note_id=note.id, tag_id=tag.id))\r\n\u001b[?2004l\r"]
[334.626634, "o", "\u001b[?2004h"]
[334.626678, "o", "> "]
[334.626788, "o", "            session.commit()\r\n\u001b[?2004l\r"]
[334.626823, "o", "\u001b[?2004h"]
[334.626842, "o", "> "]
[334.626965, "o", "        self.load_notes()\r\n\u001b[?2004l\r"]
[334.626996, "o", "\u001b[?2004h"]
[334.627018, "o", "> \r\n\u001b[?2004l\r"]
[334.627055, "o", "\u001b[?2004h> "]
[334.627368, "o", "    def update_note_content(self, note_id: int, content: str):\r\n\u001b[?2004l\r"]
[334.627399, "o", "\u001b[?2004h"]
[334.627419, "o", "> "]
[334.627686, "o", "        \"\"\"Update the content of an existing note.\"\"\"\r\n\u001b[?2004l\r"]
[334.627716, "o", "\u001b[?2004h"]
[334.627737, "o", "> "]
[334.627939, "o", "        content = (content or \"\").strip()\r\n\u001b[?2004l\r"]
[334.627969, "o", "\u001b[?2004h"]
[334.62799, "o", "> "]
[334.628166, "o", "        with rx.session() as session:\r\n\u001b[?2004l\r"]
[334.628197, "o", "\u001b[?2004h"]
[334.628215, "o", "> "]
[334.628437, "o", "            note = session.get(Note, note_id)\r\n\u001b[?2004l\r"]
[334.628473, "o", "\u001b[?2004h"]
[334.628494, "o", "> "]
[334.62865, "o", "            if note is None:\r\n\u001b[?2004l\r"]
[334.628682, "o", "\u001b[?2004h"]
[334.628711, "o", "> "]
[334.628818, "o", "                return\r\n\u001b[?2004l\r"]
[334.628855, "o", "\u001b[?2004h"]
[334.628895, "o", "> "]
[334.62904, "o", "            note.content = content\r\n\u001b[?2004l\r"]
[334.62907, "o", "\u001b[?2004h> "]
[334.62923, "o", "            session.add(note)\r\n\u001b[?2004l\r"]
[334.629262, "o", "\u001b[?2004h"]
[334.629281, "o", "> "]
[334.629422, "o", "            session.commit()\r\n\u001b[?2004l\r"]
[334.629453, "o", "\u001b[?2004h"]
[334.629481, "o", "> "]
[334.629569, "o", "        self.load_notes()\r\n\u001b[?2004l\r"]
[334.629589, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[334.62963, "o", "\u001b[?2004h> "]
[334.62976, "o", "    def set_note_tags(self, note_id: int, tags_text: str):\r\n\u001b[?2004l\r"]
[334.62978, "o", "\u001b[?2004h> "]
[334.629918, "o", "        \"\"\"Replace the entire tag set of a note.\"\"\"\r\n\u001b[?2004l\r\u001b[?2004h"]
[334.629937, "o", "> "]
[334.630146, "o", "        tag_names = [t.strip() for t in (tags_text or \"\").split(\",\") if t.strip()]\r\n\u001b[?2004l\r\u001b[?2004h> "]
[334.630253, "o", "        with rx.session() as session:\r\n\u001b[?2004l\r\u001b[?2004h"]
[334.630273, "o", "> "]
[334.630386, "o", "            note = session.get(Note, note_id)\r\n\u001b[?2004l\r\u001b[?2004h"]
[334.630407, "o", "> "]
[334.630479, "o", "            if note is None:\r\n\u001b[?2004l\r"]
[334.63051, "o", "\u001b[?2004h> "]
[334.630581, "o", "                return\r\n\u001b[?2004l\r\u001b[?2004h> "]
[334.630672, "o", "            # Remove existing links\r\n\u001b[?2004l\r\u001b[?2004h"]
[334.630702, "o", "> "]
[334.630948, "o", "            existing_links = session.exec(select(NoteTagLink).where(NoteTagLink.note_id == note_id)).all()\r\n\u001b[?2004l\r"]
[334.630968, "o", "\u001b[?2004h> "]
[334.631069, "o", "            for link in existing_links:\r\n\u001b[?2004l\r"]
[334.631088, "o", "\u001b[?2004h> "]
[334.631186, "o", "                session.delete(link)\r\n\u001b[?2004l\r"]
[334.631205, "o", "\u001b[?2004h> "]
[334.63128, "o", "            session.commit()\r\n\u001b[?2004l\r"]
[334.631299, "o", "\u001b[?2004h> "]
[334.63137, "o", "            # Add new tags\r\n\u001b[?2004l\r"]
[334.631389, "o", "\u001b[?2004h> "]
[334.631551, "o", "            for tag in self._resolve_tags(session, tag_names):\r\n\u001b[?2004l\r\u001b[?2004h"]
[334.63157, "o", "> "]
[334.631748, "o", "                session.add(NoteTagLink(note_id=note.id, tag_id=tag.id))\r\n\u001b[?2004l\r"]
[334.631767, "o", "\u001b[?2004h> "]
[334.631842, "o", "            session.commit()\r\n\u001b[?2004l\r"]
[334.631862, "o", "\u001b[?2004h> "]
[334.63193, "o", "        self.load_notes()\r\n\u001b[?2004l\r"]
[334.631948, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[334.631985, "o", "\u001b[?2004h> "]
[334.632075, "o", "    def delete_note(self, note_id: int):\r\n\u001b[?2004l\r"]
[334.632095, "o", "\u001b[?2004h> "]
[334.632271, "o", "        \"\"\"Delete a note and its link rows; do NOT delete Tag rows.\"\"\"\r\n\u001b[?2004l\r"]
[334.63229, "o", "\u001b[?2004h> "]
[334.632384, "o", "        with rx.session() as session:\r\n\u001b[?2004l\r"]
[334.632404, "o", "\u001b[?2004h> "]
[334.632571, "o", "            note = session.get(Note, note_id)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[334.632622, "o", "            if note is None:\r\n\u001b[?2004l\r"]
[334.632641, "o", "\u001b[?2004h> "]
[334.632703, "o", "                return\r\n\u001b[?2004l\r"]
[334.632722, "o", "\u001b[?2004h> "]
[334.632981, "o", "            existing_links = session.exec(select(NoteTagLink).where(NoteTagLink.note_id == note_id)).all()\r\n\u001b[?2004l\r\u001b[?2004h"]
[334.633001, "o", "> "]
[334.633103, "o", "            for link in existing_links:\r\n\u001b[?2004l\r"]
[334.633122, "o", "\u001b[?2004h> "]
[334.633224, "o", "                session.delete(link)\r\n\u001b[?2004l\r\u001b[?2004h"]
[334.633243, "o", "> "]
[334.633316, "o", "            session.commit()\r\n\u001b[?2004l\r\u001b[?2004h"]
[334.633335, "o", "> "]
[334.633418, "o", "            session.delete(note)\r\n\u001b[?2004l\r\u001b[?2004h"]
[334.633437, "o", "> "]
[334.633519, "o", "            session.commit()\r\n\u001b[?2004l\r\u001b[?2004h"]
[334.633539, "o", "> "]
[334.633624, "o", "        self.load_notes()\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[334.633642, "o", "\u001b[?2004h> "]
[334.633739, "o", "    def toggle_tag(self, name: str):\r\n\u001b[?2004l\r"]
[334.633758, "o", "\u001b[?2004h> "]
[334.633884, "o", "        \"\"\"Toggle a tag name in selected_tags.\"\"\"\r\n\u001b[?2004l\r\u001b[?2004h"]
[334.633902, "o", "> "]
[334.634, "o", "        if name in self.selected_tags:\r\n\u001b[?2004l\r"]
[334.63402, "o", "\u001b[?2004h> "]
[334.634208, "o", "            self.selected_tags = [t for t in self.selected_tags if t != name]\r\n\u001b[?2004l\r\u001b[?2004h"]
[334.634227, "o", "> "]
[334.634264, "o", "        else:\r\n\u001b[?2004l\r"]
[334.634283, "o", "\u001b[?2004h> "]
[334.634477, "o", "            self.selected_tags = sorted(list(set(self.selected_tags + [name])))\r\n\u001b[?2004l\r\u001b[?2004h"]
[334.634562, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[334.634594, "o", "    def clear_filter(self):\r\n\u001b[?2004l\r\u001b[?2004h"]
[334.634613, "o", "> "]
[334.63471, "o", "        \"\"\"Clear all selected tags.\"\"\"\r\n\u001b[?2004l\r"]
[334.634728, "o", "\u001b[?2004h> "]
[334.634809, "o", "        self.selected_tags = []\r\n\u001b[?2004l\r\u001b[?2004h"]
[334.634828, "o", "> \r\n\u001b[?2004l\r"]
[334.634867, "o", "\u001b[?2004h> "]
[334.634971, "o", "    def note_matches(self, note: dict) -> bool:\r\n\u001b[?2004l\r"]
[334.63499, "o", "\u001b[?2004h> "]
[334.635144, "o", "        \"\"\"Check whether a note matches the current filter.\"\"\"\r\n\u001b[?2004l\r"]
[334.635164, "o", "\u001b[?2004h> "]
[334.635293, "o", "        if not self.selected_tags:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[334.635336, "o", "            return True\r\n\u001b[?2004l\r"]
[334.635354, "o", "\u001b[?2004h> "]
[334.635552, "o", "        return any(t in self.selected_tags for t in note.get(\"tags\", []))\r\n\u001b[?2004l\r\u001b[?2004h"]
[334.635573, "o", "> "]
