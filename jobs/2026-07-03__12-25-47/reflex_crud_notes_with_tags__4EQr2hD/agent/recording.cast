[334.616917, "o", "\u001b[?2004h> "]
[334.617016, "o", "    def all_tags(self) -> List[str]:\r\n\u001b[?2004l\r"]
[334.617049, "o", "\u001b[?2004h> "]
[334.617277, "o", "        \"\"\"Return the sorted union of tag names attached to at least one note.\"\"\"\r\n\u001b[?2004l\r"]
[334.617302, "o", "\u001b[?2004h> "]
[334.617419, "o", "        with rx.session() as session:\r\n\u001b[?2004l\r"]
[334.617451, "o", "\u001b[?2004h> "]
[334.617715, "o", "            stmt = select(Tag.name).join(NoteTagLink, NoteTagLink.tag_id == Tag.id).distinct()\r\n\u001b[?2004l\r"]
[334.617771, "o", "\u001b[?2004h> "]
[334.61787, "o", "            rows = session.exec(stmt).all()\r\n\u001b[?2004l\r"]
[334.617905, "o", "\u001b[?2004h> "]
[334.618007, "o", "            return sorted(list(rows))\r\n\u001b[?2004l\r"]
[334.618042, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[334.618075, "o", "> "]
[334.618143, "o", "    def load_notes(self):\r\n\u001b[?2004l\r"]
[334.618175, "o", "\u001b[?2004h> "]
[334.618313, "o", "        \"\"\"Load all notes (sorted by id) with their tags.\"\"\"\r\n\u001b[?2004l\r"]
[334.618345, "o", "\u001b[?2004h> "]
[334.618433, "o", "        with rx.session() as session:\r\n\u001b[?2004l\r"]
[334.618465, "o", "\u001b[?2004h> "]
[334.618743, "o", "            db_notes = session.exec(select(Note).order_by(Note.id)).all()\r\n\u001b[?2004l\r\u001b[?2004h>             result = []\r\n\u001b[?2004l\r\u001b[?2004h"]
[334.618791, "o", "> "]
[334.61883, "o", "            for n in db_notes:\r\n\u001b[?2004l\r"]
[334.618865, "o", "\u001b[?2004h> "]
[334.619195, "o", "                tags = session.exec(select(Tag).join(NoteTagLink, NoteTagLink.tag_id == Tag.id).where(NoteTagLink.note_id == n.id)).all()\r\n\u001b[?2004l\r\u001b[?2004h> "]
[334.619285, "o", "                result.append({\r\n\u001b[?2004l\r"]
[334.619307, "o", "\u001b[?2004h> "]
[334.619384, "o", "                    \"id\": n.id,\r\n\u001b[?2004l\r"]
[334.619406, "o", "\u001b[?2004h> "]
[334.619596, "o", "                    \"content\": n.content,\r\n\u001b[?2004l\r"]
[334.619628, "o", "\u001b[?2004h> "]
[334.619925, "o", "                    \"tags\": sorted([t.name for t in tags]),\r\n\u001b[?2004l\r"]
[334.619956, "o", "\u001b[?2004h"]
[334.619975, "o", "> "]
[334.620069, "o", "                })\r\n\u001b[?2004l\r"]
[334.620099, "o", "\u001b[?2004h"]
[334.620121, "o", "> "]
