[85.406049, "o", "encore app --help\r\n\u001b[?2004l\r"]
[85.500664, "o", "Commands to create and link Encore apps\r\n"]
[85.501084, "o", "\r\n"]
[85.502499, "o", "Usage:\r\n  encore app [command]\r\n\r\nAvailable Commands:\r\n  clone       Clone an existing Encore app from Encore Cloud to your computer\r\n  create      Create a new Encore app\r\n  init        Register an existing local repo as a new app on Encore Cloud\r\n  link        Link an existing local repo to an existing Encore Cloud app\r\n\r\nFlags:\r\n  -h, --help   help for app\r\n\r\nGlobal Flags:\r\n      --trace string    file to write execution trace data to\r\n  -v, --verbose count   verbose output\r\n\r\nUse \"encore app [command] --help\" for more information about a command.\r\n"]
[85.502833, "o", "\u001b[?2004h"]
[85.503014, "o", "root@b7374e82-6a3a-4129-8436-c50cf6af7338:/home/user/helloworld# "]
[88.594816, "i", "encore app create --help\n"]
[88.596715, "o", "encore app create --help\r\n\u001b[?2004l\r"]
[88.686857, "o", "Create a new Encore app\r\n\r\n"]
[88.688723, "o", "Usage:\r\n  encore app create [name]\r\n\r\nFlags:\r\n      --example string     URL to example code to use.\r\n  -h, --help               help for create\r\n  -l, --lang string        Programming language to use for the app. One of (\"go\" or \"ts\").\r\n  -r, --llm-rules string   Initialize the app with llm rules for a specific tool. One of (\"cursor\", \"claudecode\", \"vscode\", \"agentsmd\", or \"zed\").\r\n      --platform           whether to create the app with the Encore Platform (default true)\r\n\r\nGlobal Flags:\r\n      --trace string    file to write execution trace data to\r\n  -v, --verbose count   verbose output\r\n"]
[88.689135, "o", "\u001b[?2004h"]
