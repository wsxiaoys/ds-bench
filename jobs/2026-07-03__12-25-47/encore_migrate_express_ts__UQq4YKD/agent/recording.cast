[442.247623, "i", "encore app info\n"]
[442.249581, "o", "encore app info\r\n\u001b[?2004l\r"]
[442.346475, "o", "Commands to create and link Encore apps\r\n"]
[442.346665, "o", "\r\n"]
[442.346873, "o", "Usage:\r\n  encore app [command]\r\n\r\nAvailable Commands:\r\n  clone       Clone an existing Encore app from Encore Cloud to your computer\r\n  create      Create a new Encore app\r\n  init        Register an existing local repo as a new app on Encore Cloud\r\n  link        Link an existing local repo to an existing Encore Cloud app\r\n\r\nFlags:\r\n  -h, --help   help for app\r\n\r\nGlobal Flags:\r\n      --trace string    file to write execution trace data to\r\n  -v, --verbose count   verbose output\r\n\r\nUse \"encore app [command] --help\" for more information about a command.\r\n"]
[442.348764, "o", "\u001b[?2004h"]
[442.348859, "o", "root@b7374e82-6a3a-4129-8436-c50cf6af7338:/home/user/helloworld# "]
[450.658332, "i", "encore --help\n"]
[450.659594, "o", "encore --help\r\n\u001b[?2004l\r"]
[450.769371, "o", "encore is the fastest way of developing backend applications\r\n\r\n"]
[450.770918, "o", "Usage:\r\n  encore [command]\r\n\r\nAvailable Commands:\r\n  app                             Commands to create and link Encore apps\r\n  auth                            Commands to authenticate with Encore\r\n  build                           build provides ways to build your application for deployment\r\n  check                           Runs a list of HTTP requests against a fresh app instance\r\n  config                          Get or set a configuration value\r\n  daemon                          Starts the encore daemon\r\n  db                              Database management commands\r\n  exec                            Runs executable scripts against the local Encore app\r\n  gen                             Code generation commands\r\n  help                            Help about any command\r\n  kubernetes                      Kubernetes management commands\r\n  llm-rules                       Commands to create LLM rules for apps\r\n  logs                            Streams logs from your application\r\n  mcp                             MCP (Message Context Provider) commands\r\n  namespace                       Manage infrastructure namespaces\r\n  rand                            Utilities for generating cryptographically secure random data\r\n  run                             Runs your application\r\n  secret                          Secret management commands\r\n  telemetry                       Reports the current telemetry status\r\n  test                            Tests your application\r\n  version                         Reports the current version of the encore application\r\n\r\nFlags:\r\n  -h, --help            help for encore\r\n      --trace string    file to write execution trace data to\r\n  -v, --verbose count   verbose output\r\n\r\nUse \"encore [command] --help\" for more information about a command.\r\n"]
[450.771526, "o", "\u001b[?2004h"]
