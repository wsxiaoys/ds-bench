[99.881344, "o", "\u001b[2K\u001b[1A\u001b[2K\u001b[1A\u001b[2K\u001b[1A\u001b[2K\u001b[1A\u001b[2K\u001b[1A\u001b[2K\u001b[1A\u001b[2K\u001b[1A\u001b[2K\u001b[1A\u001b[2K\u001b[1A\u001b[2K\u001b[1A\u001b[2K\u001b[1A\u001b[2K\u001b[1A\u001b[2K\u001b[1A\u001b[2K\u001b[1A\u001b[2K\u001b[1A\u001b[2K\u001b[1A\u001b[2K\u001b[1A\u001b[2K\u001b[1A\u001b[2K\u001b[1A\u001b[2K\u001b[1A\u001b[2K\u001b[1A\u001b[2K\u001b[1A\u001b[2K\u001b[1A\u001b[2K\u001b[1A\u001b[2K\u001b[1A\u001b[2K\u001b[1A\u001b[2K\u001b[1A\u001b[2K\u001b[1A\u001b[2K\u001b[1A\u001b[2K\u001b[1A\u001b[2K\u001b[1A\u001b[2K\u001b[1A\u001b[2K\u001b[1A\u001b[2K\u001b[1A\u001b[2K\u001b[1A\u001b[2K\u001b[1A\u001b[2K\u001b[1A\u001b[2K\u001b[1A\u001b[2K\u001b[1A\u001b[160D\u001b[2K  \u001b[38;5;34m✔ App Name: \u001b[0mhelloworld                                  \r\r\n  \u001b[38;5;34m✔ Language: \u001b[0mTypeScript                                  \r\r\n                                                          \r\r\n  \u001b[38;5;69mTemplate\u001b[0m\u001b[38;5;150m [Use arrows to move]\u001b[0m                           \r\r\n    \u001b[38;5;188mIntro to Encore.ts\u001b[0m                                    \r\r\n    \u001b[38;5;102mAn interactive tutorial\u001b[0m                               \r\r\n                                                          \r\r\n    \u001b[38;5;188mHello World\u001b[0m                                           \r\r\n    \u001b[38;5;102mA simple REST API\u001b[0m                                     \r\r\n                                                          \r\r\n    \u001b[38;5;188mUptime Monitor\u001b[0m                                        \r\r\n    \u001b[38;5;102mMicroservices, SQL Databases, Pub/Sub, Cron Jobs\u001b[0m      \r\r\n                                                          \r\r\n    \u001b[38;5;188mURL Shortener\u001b[0m                                         \r\r\n    \u001b[38;5;102mREST API, SQL Database\u001b[0m                                \r\r\n   