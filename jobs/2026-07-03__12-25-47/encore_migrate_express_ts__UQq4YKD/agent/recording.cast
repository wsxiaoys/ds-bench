[1013.374126, "o", "\u001b[?2004l\r"]
[1013.38114, "o", "import { api } from \"encore.dev/api\";\r\n\r\ninterface GreetParams {\r\n  name: string;\r\n}\r\n\r\ninterface GreetResponse {\r\n  message: string;\r\n}\r\n\r\nexport const get = api<GreetParams, GreetResponse>(\r\n  { method: \"GET\", path: \"/greet/:name\", expose: true },\r\n  async ({ name }) => {\r\n    return { message: `Hello, ${name}!` };\r\n  }\r\n);\r\n"]
