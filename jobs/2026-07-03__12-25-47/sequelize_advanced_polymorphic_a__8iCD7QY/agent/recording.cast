[55.396124, "o", "  }\r\n\u001b[?2004l\r\u001b[?2004h> });\r\n\u001b[?2004l\r"]
[55.396237, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[55.396308, "o", "app.post('/images', async (req, res) => {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[55.396373, "o", "  try {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[55.396463, "o", "    const image = await Image.create({\r\n\u001b[?2004l\r\u001b[?2004h"]
[55.396511, "o", "> "]
[55.396601, "o", "      url: req.body.url,\r\n\u001b[?2004l\r\u001b[?2004h> "]
[55.396672, "o", "      imageableId: req.body.imageableId,\r\n\u001b[?2004l\r\u001b[?2004h> "]
[55.396797, "o", "      imageableType: req.body.imageableType\r\n\u001b[?2004l\r\u001b[?2004h> "]
[55.396844, "o", "    });\r\n\u001b[?2004l\r\u001b[?2004h> "]
[55.396943, "o", "    res.status(201).json(image);\r\n\u001b[?2004l\r\u001b[?2004h> "]
[55.397009, "o", "  } catch (err) {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[55.397166, "o", "    res.status(400).json({ error: err.message });\r\n\u001b[?2004l\r\u001b[?2004h> "]
[55.397216, "o", "  }\r\n\u001b[?2004l\r\u001b[?2004h> });\r\n\u001b[?2004l\r"]
[55.397314, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[55.397389, "o", "app.get('/users/:id', async (req, res) => {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[55.397458, "o", "  try {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[55.397582, "o", "    const user = await User.findByPk(req.params.id, {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[55.397743, "o", "      include: [{ model: Image, as: 'profilePictures' }]\r\n\u001b[?2004l\r\u001b[?2004h"]
[55.397791, "o", ">     });\r\n\u001b[?2004l\r\u001b[?2004h> "]
[55.397862, "o", "    if (!user) {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[55.398034, "o", "      return res.status(404).json({ error: 'User not found' });\r\n\u001b[?2004l\r\u001b[?2004h> "]
[55.398105, "o", "    }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[55.39818, "o", "    res.status(200).json(user);\r\n\u001b[?2004l\r\u001b[?2004h> "]
[55.398252, "o", "  } catch (err) {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[55.398387, "o", "    res.status(400).json({ error: err.message });\r\n\u001b[?2004l\r\u001b[?2004h> "]
