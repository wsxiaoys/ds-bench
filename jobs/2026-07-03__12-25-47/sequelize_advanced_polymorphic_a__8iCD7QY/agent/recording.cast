[55.399744, "o", "\u001b[?2004h> "]
[55.399853, "o", "app.get('/images/:id', async (req, res) => {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[55.399899, "o", "  try {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[55.40005, "o", "    const image = await Image.findByPk(req.params.id);\r\n\u001b[?2004l\r\u001b[?2004h> "]
[55.40012, "o", "    if (!image) {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[55.400301, "o", "      return res.status(404).json({ error: 'Image not found' });\r\n\u001b[?2004l\r\u001b[?2004h> "]
[55.400347, "o", "    }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[55.400429, "o", "    let imageable = null;\r\n\u001b[?2004l\r\u001b[?2004h> "]
[55.400548, "o", "    if (image.imageableType === 'user') {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[55.400712, "o", "      imageable = await User.findByPk(image.imageableId);\r\n\u001b[?2004l\r\u001b[?2004h> "]
[55.400858, "o", "    } else if (image.imageableType === 'product') {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[55.401029, "o", "      imageable = await Product.findByPk(image.imageableId);\r\n\u001b[?2004l\r\u001b[?2004h> "]
[55.401075, "o", "    }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[55.401185, "o", "    const result = image.toJSON();\r\n\u001b[?2004l\r\u001b[?2004h> "]
[55.401284, "o", "    result.imageable = imageable;\r\n\u001b[?2004l\r\u001b[?2004h> "]
[55.401386, "o", "    res.status(200).json(result);\r\n\u001b[?2004l\r\u001b[?2004h> "]
[55.401454, "o", "  } catch (err) {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[55.401595, "o", "    res.status(400).json({ error: err.message });\r\n\u001b[?2004l\r\u001b[?2004h> "]
[55.401664, "o", "  }\r\n\u001b[?2004l\r\u001b[?2004h> });\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[55.401713, "o", "\u001b[?2004h> "]
