[55.398522, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[55.398612, "o", "app.get('/products/:id', async (req, res) => {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[55.39866, "o", "  try {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[55.398822, "o", "    const product = await Product.findByPk(req.params.id, {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[55.398976, "o", "      include: [{ model: Image, as: 'productPhotos' }]\r\n\u001b[?2004l\r\u001b[?2004h"]
[55.399021, "o", ">     });\r\n\u001b[?2004l\r\u001b[?2004h> "]
[55.399109, "o", "    if (!product) {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[55.399278, "o", "      return res.status(404).json({ error: 'Product not found' });\r\n\u001b[?2004l\r\u001b[?2004h> "]
[55.399327, "o", "    }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[55.399424, "o", "    res.status(200).json(product);\r\n\u001b[?2004l\r\u001b[?2004h> "]
[55.399492, "o", "  } catch (err) {\r\n\u001b[?2004l\r\u001b[?2004h> "]
