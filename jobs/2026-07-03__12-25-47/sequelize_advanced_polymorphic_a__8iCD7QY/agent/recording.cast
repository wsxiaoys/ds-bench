[55.394691, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[55.394787, "o", "app.post('/users', async (req, res) => {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[55.394835, "o", "  try {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[55.395003, "o", "    const user = await User.create({ name: req.body.name });\r\n\u001b[?2004l\r\u001b[?2004h> "]
[55.3951, "o", "    res.status(201).json(user);\r\n\u001b[?2004l\r\u001b[?2004h> "]
[55.395187, "o", "  } catch (err) {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[55.395317, "o", "    res.status(400).json({ error: err.message });\r\n\u001b[?2004l\r\u001b[?2004h> "]
[55.395362, "o", "  }\r\n\u001b[?2004l\r\u001b[?2004h> });\r\n\u001b[?2004l\r"]
[55.395456, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[55.395531, "o", "app.post('/products', async (req, res) => {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[55.395579, "o", "  try {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[55.395763, "o", "    const product = await Product.create({ title: req.body.title });\r\n\u001b[?2004l\r\u001b[?2004h> "]
[55.395869, "o", "    res.status(201).json(product);\r\n\u001b[?2004l\r\u001b[?2004h> "]
[55.395942, "o", "  } catch (err) {\r\n\u001b[?2004l\r\u001b[?2004h> "]
