[23.57558, "o", "\u001b[1G\u001b[0K\r\n2 \u001b[33m\u001b[1mmoderate\u001b[22m\u001b[39m severity vulnerabilities\r\n\r\nTo address all issues, run:\r\n  npm audit fix\r\n\r\nRun `npm audit` for details.\r\n⠏"]
[23.576166, "o", "\u001b[1G\u001b[0K\u001b[1mnpm\u001b[22m \u001b[33mwarn\u001b[39m \u001b[94mallow-scripts\u001b[39m 1 package has install scripts not yet covered by allowScripts:\r\n\u001b[1mnpm\u001b[22m \u001b[33mwarn\u001b[39m \u001b[94mallow-scripts\u001b[39m   sqlite3@6.0.1 (install: prebuild-install -r napi || node-gyp rebuild)\r\n\u001b[1mnpm\u001b[22m \u001b[33mwarn\u001b[39m \u001b[94mallow-scripts\u001b[39m\r\n\u001b[1mnpm\u001b[22m \u001b[33mwarn\u001b[39m \u001b[94mallow-scripts\u001b[39m Run `npm approve-scripts --allow-scripts-pending` to review, or `npm approve-scripts <pkg>` to allow.\r\n"]
