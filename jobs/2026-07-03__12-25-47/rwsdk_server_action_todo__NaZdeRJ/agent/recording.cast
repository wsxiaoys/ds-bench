[316.501012, "i", "cat > src/app/actions.ts << 'EOF'\n\"use server\";\n\nimport { serverAction } from \"rwsdk/worker\";\n\nexport interface Todo {\n  id: string;\n  title: string;\n  done: boolean;\n  createdAt: number;\n}\n\nconst KV_PREFIX = \"todo:\";\n\nasync function getKV() {\n  const { env } = await import(\"cloudflare:workers\");\n  return env.TODOS;\n}\n\nexport async function getAllTodos(): Promise<Todo[]> {\n  const kv = await getKV();\n  const list = await kv.list({ prefix: KV_PREFIX });\n  const todos: Todo[] = [];\n  for (const key of list.keys) {\n    const value = await kv.get(key.name);\n    if (value) {\n      todos.push(JSON.parse(value));\n    }\n  }\n  todos.sort((a, b) => a.createdAt - b.createdAt);\n  return todos;\n}\n\nexport const addTodo = serverAction(async (formData: FormData) => {\n  const title = String(formData.get(\"title\") || \"\").trim();\n  if (!title) return;\n  const kv = await getKV();\n  const todo: Todo = {\n    id: crypto.randomUUID(),\n    title,\n    done: false,\n    createdAt: Date.now(),\n  };\n  await kv.put(`${KV_PREFIX}${todo.id}`, JSON.stringify(todo));\n  return todo;\n});\n\nexport const toggleTodo = serverAction(async (formData: FormData) => {\n  const id = String(formData.get(\"id\") || \"\");\n  const done = formData.get(\"done\") === \"on\" || formData.get(\"done\") === \"true\";\n  if (!id) return;\n  const kv = await getKV();\n  const value = await kv.get(`${KV_PREFIX}${id}`);\n  if (!value) return;\n  const todo: Todo = JSON.parse(value);\n  todo.done = done;\n  await kv.put(`${KV_PREFIX}${id}`, JSON.stringify(todo));\n  return todo;\n});\n\nexport const deleteTodo = serverAction(async (formData: FormData) => {\n  const id = String(formData.get(\"id\") || \"\");\n  if (!id) return;\n  const kv = await getKV();\n  await kv.delete(`${KV_PREFIX}${id}`);\n  return { id };\n});\nEOF\n"]
