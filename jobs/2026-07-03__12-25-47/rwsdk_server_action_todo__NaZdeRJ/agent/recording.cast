[107.325704, "o", "import { RwContext } from \"../lib/types.js\";\r\nexport interface DefaultAppContext {\r\n}\r\nexport interface RequestInfo<Params = any, AppContext = DefaultAppContext> {\r\n    request: Request;\r\n    path: string;\r\n    params: Params;\r\n    ctx: AppContext;\r\n    rw: RwContext;\r\n    cf: ExecutionContext;\r\n    response: ResponseInit & {\r\n        headers: Headers;\r\n    };\r\n    isAction: boolean;\r\n}\r\nexport type PartialRequestInfo<Params = any, AppContext = DefaultAppContext> = Omit<Partial<RequestInfo<Params, AppContext>>, \"rw\"> & {\r\n    rw?: Partial<RwContext>;\r\n};\r\n"]
[107.325913, "o", "\u001b[?2004hroot@10853911-07db-4b61-ba16-e4bd95e351aa:~/todo-app# "]
[110.715188, "i", "cat node_modules/rwsdk/dist/runtime/lib/types.d.ts\n"]
[110.715509, "o", "cat node_modules/rwsdk/dist/runtime/lib/types.d.ts\r\n\u001b[?2004l\r"]
[110.716649, "o", "import { type Kysely } from \"kysely\";\r\nimport React from \"react\";\r\nimport { type RequestInfo } from \"../requestInfo/types.js\";\r\nexport type RwContext = {\r\n    nonce: string;\r\n    Document: React.FC<DocumentProps<any>>;\r\n    rscPayload: boolean;\r\n    ssr: boolean;\r\n    layouts?: React.FC<LayoutProps<any>>[];\r\n    databases: Map<string, Kysely<any>>;\r\n    scriptsToBeLoaded: Set<string>;\r\n    entryScripts: Set<string>;\r\n    inlineScripts: Set<string>;\r\n    pageRouteResolved: PromiseWithResolvers<void> | undefined;\r\n    actionResult?: unknown;\r\n    renderError?: unknown;\r\n};\r\nexport type DocumentProps<T extends RequestInfo = RequestInfo> = T & {\r\n    children: React.ReactNode;\r\n};\r\nexport type LayoutProps<T extends RequestInfo = RequestInfo> = {\r\n    children?: React.ReactNode;\r\n    requestInfo?: T;\r\n};\r\n"]
[110.716809, "o", "\u001b[?2004hroot@10853911-07db-4b61-ba16-e4bd95e351aa:~/todo-app# "]
