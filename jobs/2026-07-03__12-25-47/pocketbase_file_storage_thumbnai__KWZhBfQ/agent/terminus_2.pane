[?2004l[?2004h> const PocketBase = require('pocketbase');
[?2004l[?2004h> const fs = require('fs');
[?2004l[?2004h> const path = require('path');
[?2004l[?2004h> 
[?2004l[?2004h> (async () => {
[?2004l[?2004h>   const pb = new PocketBase('http://127.0.0.1:8090');
[?2004l[?2004h> 
[?2004l[?2004h>   try {
[?2004l[?2004h>     // 1. Authenticate as the admin
[?2004l[?2004h>     await pb.admins.authWithPassword('admin@example.com', 'adminpassword');
[?2004l[?2004h>     console.log('Admin authenticated');
[?2004l[?2004h> 
[?2004l[?2004h>     // 2. Upload input.jpg to create a new record in the gallery collection
[?2004l[?2004h>     const formData = new FormData();
[?2004l[?2004h>     const fileBuffer = fs.readFileSync(path.join(__dirname, 'input.jpg'));
[?2004l[?2004h>     const blob = new Blob([fileBuffer], { type: 'image/jpeg' });
[?2004l[?2004h>     formData.append('image', blob, 'input.jpg');
[?2004l[?2004h> 
[?2004l[?2004h>     const record = await pb.collection('gallery').create(formData);
[?2004l[?2004h>     console.log('Created record:', record.id);
[?2004l[?2004h> 
[?2004l[?2004h>     // 3. Get the URL for the 100x100 thumbnail
[?2004l[?2004h>     const thumbUrl = pb.files.getUrl(record, record.image, { 'thumb': '100x100' });
[?2004l[?2004h>     console.log('Thumbnail URL:', thumbUrl);
[?2004l[?2004h> 
[?2004l[?2004h>     // 4. Download the thumbnail and save it as thumbnail.jpg
[?2004l[?2004h>     const response = await fetch(thumbUrl);
[?2004l[?2004h>     const arrayBuffer = await response.arrayBuffer();
[?2004l[?2004h>     const buffer = Buffer.from(arrayBuffer);
[?2004l[?2004h>     fs.writeFileSync(path.join(__dirname, 'thumbnail.jpg'), buffer);
[?2004l[?2004h>     console.log('Thumbnail saved');
[?2004l[?2004h> 
[?2004l[?2004h>     // Verify thumbnail is smaller than original
[?2004l[?2004h>     const originalSize = fs.statSync(path.join(__dirname, 'input.jpg')).size;
[?2004l[?2004h>     const thumbSize = fs.statSync(path.join(__dirname, 'thumbnail.jpg')).size;
[?2004l[?2004h>     console.log(`Original: ${originalSize} bytes, Thumbnail: ${thumbSize} bytes`);
[?2004l[?2004h> 
[?2004l[?2004h>     // 5. Write the record ID to output.log
[?2004l[?2004h>     fs.writeFileSync(path.join(__dirname, 'output.log'), `Record ID: ${record.id}\n`);
[?2004l[?2004h>     console.log('Record ID written to output.log');
[?2004l[?2004h>   } catch (err) {
[?2004l[?2004h>     console.error('Error:', err);
[?2004l[?2004h>     if (err.response) {
[?2004l[?2004h>       console.error('Response:', await err.response.text());
[?2004l[?2004h>     }
[?2004l[?2004h>     process.exit(1);
[?2004l[?2004h>   }
[?2004l[?2004h> })();
