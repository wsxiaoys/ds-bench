[172.247389, "i", "cat > /tmp/create_gallery2.js << 'EOF'\nconst PocketBase = require('/home/user/pb-task/node_modules/pocketbase').default || require('/home/user/pb-task/node_modules/pocketbase');\nconst pb = new PocketBase('http://127.0.0.1:8090');\npb.admins.authWithPassword('admin@example.com', 'adminpassword').then(async (admin) => {\n  try {\n    // Delete the existing one\n    await pb.collections.delete('gallery');\n    console.log('Deleted gallery');\n  } catch (err) {\n    console.log('Delete error (ignored):', err.message);\n  }\n  try {\n    const collection = await pb.collections.create({\n      name: 'gallery',\n      type: 'base',\n      fields: [\n        {\n          name: 'image',\n          type: 'file',\n          required: false,\n          options: {\n            maxSelect: 1,\n            maxSize: 0,\n            mimeTypes: [],\n            thumbs: ['100x100'],\n            protected: false\n          }\n        }\n      ],\n      listRule: '',\n      viewRule: '',\n      createRule: '',\n      updateRule: '',\n      deleteRule: '',\n      indexes: []\n    });\n    console.log('Created collection:', JSON.stringify(collection, null, 2));\n  } catch (err) {\n    console.log('Create Error:', err.message);\n    console.log(JSON.stringify(err.response, null, 2));\n  }\n}).catch(err => {\n  console.log('Login Error:', err.message);\n});\nEOF\nnode /tmp/create_gallery2.js\n"]
