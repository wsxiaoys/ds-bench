[172.422055, "o", "Created collection: {\r\n  \"id\": \"pbc_3598190544\",\r\n  \"listRule\": \"\",\r\n  \"viewRule\": \"\",\r\n  \"createRule\": \"\",\r\n  \"updateRule\": \"\",\r\n  \"deleteRule\": \"\",\r\n  \"name\": \"gallery\",\r\n  \"type\": \"base\",\r\n  \"fields\": [\r\n    {\r\n      \"REDACTEDgeneratePattern\": \"[a-z0-9]{15}\",\r\n      \"hidden\": false,\r\n      \"id\": \"text3208210256\",\r\n      \"max\": 15,\r\n      \"min\": 15,\r\n      \"name\": \"id\",\r\n      \"pattern\": \"^[a-z0-9]+$\",\r\n      \"presentable\": false,\r\n      \"primaryKey\": true,\r\n      \"required\": true,\r\n      \"system\": true,\r\n      \"type\": \"text\"\r\n    },\r\n    {\r\n      \"hidden\": false,\r\n      \"id\": \"file3309110367\",\r\n      \"maxSelect\": 0,\r\n      \"maxSize\": 0,\r\n      \"mimeTypes\": null,\r\n      \"name\": \"image\",\r\n      \"presentable\": false,\r\n      \"protected\": false,\r\n      \"required\": false,\r\n      \"system\": false,\r\n      \"thumbs\": null,\r\n      \"type\": \"file\"\r\n    }\r\n  ],\r\n  \"indexes\": [],\r\n  \"created\": \"2026-07-03 13:54:03.553Z\",\r\n  \"updated\": \"2026-07-03 13:54:03.553Z\",\r\n  \"system\": false\r\n}\r\n"]
