[179.888159, "i", "cat > /tmp/update_gallery.js << 'EOF'\nconst PocketBase = require('/home/user/pb-task/node_modules/pocketbase').default || require('/home/user/pb-task/node_modules/pocketbase');\nconst pb = new PocketBase('http://127.0.0.1:8090');\npb.admins.authWithPassword('admin@example.com', 'adminpassword').then(async (admin) => {\n  try {\n    const collection = await pb.collections.getOne('gallery');\n    // Update the image field options\n    const newFields = collection.fields.map(f => {\n      if (f.name === 'image') {\n        return {\n          ...f,\n          options: {\n            maxSelect: 1,\n            maxSize: 0,\n            mimeTypes: [],\n            thumbs: ['100x100'],\n            protected: false\n          }\n        };\n      }\n      return f;\n    });\n    const updated = await pb.collections.update(collection, {\n      fields: newFields\n    });\n    console.log('Updated collection:', JSON.stringify(updated, null, 2));\n  } catch (err) {\n    console.log('Error:', err.message);\n    console.log(JSON.stringify(err.response, null, 2));\n  }\n}).catch(err => {\n  console.log('Login Error:', err.message);\n});\nEOF\nnode /tmp/update_gallery.js\n"]
