[756.704508, "o", "Streams logs from your application\r\n\r\nUsage:\r\n  encore logs [--env=prod] [--json]\r\n\r\nFlags:\r\n  -e, --env string   Environment name to stream logs from (defaults to the primary environment)\r\n  -h, --help         help for logs\r\n      --json         Whether to print logs in raw JSON format\r\n  -q, --quiet        Whether to print initial message when the command is waiting for logs\r\n\r\nGlobal Flags:\r\n      --trace string    file to write execution trace data to\r\n  -v, --verbose count   verbose output\r\n"]
[756.707099, "o", "\u001b[?2004hroot@37ee94c5-5f17-4b63-a2ee-a711f7440c29:/home/user/cron-app-zrz2ku2n82# "]
