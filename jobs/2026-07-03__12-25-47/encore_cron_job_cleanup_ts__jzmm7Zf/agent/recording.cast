[88.155913, "i", "encore app init --help\n"]
[88.156085, "o", "encore app init --help\r\n\u001b[?2004l\r"]
[88.196184, "o", "Register an existing local repo as a new app on Encore Cloud\r\n\r\nUsage:\r\n  encore app init [name]\r\n\r\nFlags:\r\n  -h, --help          help for init\r\n  -l, --lang string   Programming language to use for the app. One of (\"go\" or \"ts\").\r\n\r\nGlobal Flags:\r\n      --trace string    file to write execution trace data to\r\n  -v, --verbose count   verbose output\r\n"]
[88.200289, "o", "\u001b[?2004hroot@37ee94c5-5f17-4b63-a2ee-a711f7440c29:/home/user# "]
[102.093696, "i", "encore --help\n"]
[102.094086, "o", "encore --help\r\n\u001b[?2004l\r"]
[102.118995, "o", "encore is the fastest way of developing backend applications\r\n\r\nUsage:\r\n  encore [command]\r\n\r\nAvailable Commands:\r\n  app                             Commands to create and link Encore apps\r\n  auth                            Commands to authenticate with Encore\r\n  build                           build provides ways to build your application for deployment\r\n  check                           Runs a list of HTTP requests against a fresh app instance\r\n  config                          Get or set a configuration value\r\n  daemon                          Starts the encore daemon\r\n  db                              Database management commands\r\n  exec                            Runs executable scripts against the local Encore app\r\n  gen                             Code generation commands\r\n  help                            Help about any command\r\n  kubernetes                      Kubernetes management commands\r\n  llm-rules                       Commands to create LLM rules for apps\r\n  logs                            Streams logs from your application\r\n  mcp                             MCP (Message Context Provider) commands\r\n  namespace                       Manage infrastructure namespaces\r\n  rand                            Utilities for generating cryptographically secure random data\r\n  run                             Runs your application\r\n  secret                          Secret management commands\r\n  telemetry                       Reports the current telemetry status\r\n  test                            Tests your application\r\n  version                         Reports the current version of the encore application\r\n\r\nFlags:\r\n  -h, --help            help for encore\r\n      --trace string    file to write execution trace data to\r\n  -v, --verbose count   verbose output\r\n\r\nUse \"encore [command] --help\" for more information about a command.\r\n"]
[102.121662, "o", "\u001b[?2004hroot@37ee94c5-5f17-4b63-a2ee-a711f7440c29:/home/user# "]
[104.980303, "i", "encore app --help\n"]
[104.980567, "o", "encore app --help\r\n\u001b[?2004l\r"]
[105.021438, "o", "Commands to create and link Encore apps\r\n\r\nUsage:\r\n  encore app [command]\r\n\r\nAvailable Commands:\r\n  clone       Clone an existing Encore app from Encore Cloud to your computer\r\n  create      Create a new Encore app\r\n  init        Register an existing local repo as a new app on Encore Cloud\r\n  link        Link an existing local repo to an existing Encore Cloud app\r\n\r\nFlags:\r\n  -h, --help   help for app\r\n\r\nGlobal Flags:\r\n      --trace string    file to write execution trace data to\r\n  -v, --verbose count   verbose output\r\n\r\nUse \"encore app [command] --help\" for more information about a command.\r\n"]
[105.025625, "o", "\u001b[?2004hroot@37ee94c5-5f17-4b63-a2ee-a711f7440c29:/home/user# "]
[107.844427, "i", "encore app create --help\n"]
[107.844844, "o", "encore app create --help\r\n\u001b[?2004l\r"]
[107.873948, "o", "Create a new Encore app\r\n\r\nUsage:\r\n  encore app create [name]\r\n\r\nFlags:\r\n      --example string     URL to example code to use.\r\n  -h, --help               help for create\r\n  -l, --lang string        Programming language to use for the app. One of (\"go\" or \"ts\").\r\n  -r, --llm-rules string   Initialize the app with llm rules for a specific tool. One of (\"cursor\", \"claudecode\", \"vscode\", \"agentsmd\", or \"zed\").\r\n      --platform           whether to create the app with the Encore Platform (default true)\r\n\r\nGlobal Flags:\r\n      --trace string    file to write execution trace data to\r\n  -v, --verbose count   verbose output\r\n"]
[107.876418, "o", "\u001b[?2004hroot@37ee94c5-5f17-4b63-a2ee-a711f7440c29:/home/user# "]
