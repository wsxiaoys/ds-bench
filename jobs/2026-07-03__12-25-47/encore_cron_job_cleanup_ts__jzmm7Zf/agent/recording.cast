[288.082863, "o", "    id SERIAL PRIMARY KEY,\r\n\u001b[?2004l\r\u001b[?2004h> "]
[288.082939, "o", "    data TEXT NOT NULL,\r\n\u001b[?2004l\r\u001b[?2004h> "]
