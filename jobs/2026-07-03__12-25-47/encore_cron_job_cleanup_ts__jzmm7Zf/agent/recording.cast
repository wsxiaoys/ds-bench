[406.62413, "o", "> );\r\n\u001b[?2004l\r\u001b[?2004h"]
[406.624158, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h"]
[406.624235, "o", "> "]
[406.624275, "o", "export const cleanupRecords = api(\r\n\u001b[?2004l\r"]
[406.624301, "o", "\u001b[?2004h> "]
[406.624403, "o", "  { method: \"POST\", path: \"/cleanup\" },\r\n\u001b[?2004l\r"]
[406.62443, "o", "\u001b[?2004h> "]
[406.62453, "o", "  async (): Promise<CleanupResponse> => {\r\n\u001b[?2004l\r"]
[406.624556, "o", "\u001b[?2004h> "]
[406.624729, "o", "    const row = await recordsDB.queryRow<{ count: number }>`\r\n\u001b[?2004l\r"]
[406.624784, "o", "\u001b[?2004h> "]
[406.624842, "o", "      WITH deleted AS (\r\n\u001b[?2004l\r"]
[406.624868, "o", "\u001b[?2004h> "]
[406.625049, "o", "        DELETE FROM records WHERE created_at < NOW() - INTERVAL '1 hour'\r\n\u001b[?2004l\r"]
[406.625075, "o", "\u001b[?2004h> "]
[406.625136, "o", "        RETURNING 1\r\n\u001b[?2004l\r\u001b[?2004h> "]
[406.625174, "o", "      )\r\n\u001b[?2004l\r"]
[406.625197, "o", "\u001b[?2004h> "]
[406.625333, "o", "      SELECT COUNT(*)::int AS count FROM deleted\r\n\u001b[?2004l\r"]
[406.625359, "o", "\u001b[?2004h> "]
[406.625426, "o", "    `;\r\n\u001b[?2004l\r\u001b[?2004h> "]
[406.625498, "o", "    return { deleted: row?.count ?? 0 };\r\n\u001b[?2004l\r"]
[406.625524, "o", "\u001b[?2004h>   }\r\n\u001b[?2004l\r"]
[406.625575, "o", "\u001b[?2004h> );\r\n\u001b[?2004l\r\u001b[?2004h> "]
[406.625601, "o", "EOF\r\n\u001b[?2004l\r"]
