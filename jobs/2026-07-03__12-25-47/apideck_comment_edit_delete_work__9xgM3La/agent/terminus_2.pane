[?2004l[?2004h> #!/usr/bin/env python3
[?2004l[?2004h> import os
[?2004l[?2004h> import json
[?2004l[?2004h> import urllib.request
[?2004l[?2004h> import urllib.parse
[?2004l[?2004h> import urllib.error
[?2004l[?2004h> 
[?2004l[?2004h> API_KEY = os.environ['APIDECK_API_KEY']
[?2004l[?2004h> APP_ID = os.environ['APIDECK_APP_ID']
[?2004l[?2004h> CONSUMER_ID = os.environ['APIDECK_CONSUMER_ID']
[?2004l[?2004h> COLLECTION_ID = os.environ['APIDECK_ISSUE_TRACKING_COLLECTION_ID']
[?2004l[?2004h> SERVICE_ID = 'github'
[?2004l[?2004h> 
[?2004l[?2004h> with open('/logs/artifacts/run-id') as f:
[?2004l[?2004h>     RUN_ID = f.read().strip()
[?2004l[?2004h> 
[?2004l[?2004h> BASE = 'https://unify.apideck.com'
[?2004l[?2004h> 
[?2004l[?2004h> def request(method, path, body=None, query=None):
[?2004l[?2004h>     url = BASE + path
[?2004l[?2004h>     if query:
[?2004l[?2004h>         url += '?' + urllib.parse.urlencode(query)
[?2004l[?2004h>     data = None
[?2004l[?2004h>     headers = {
[?2004l[?2004h>         'Authorization': 'Bearer ' + API_KEY,
[?2004l[?2004h>         'x-apideck-app-id': APP_ID,
[?2004l[?2004h>         'x-apideck-consumer-id': CONSUMER_ID,
[?2004l[?2004h>         'x-apideck-service-id': SERVICE_ID,
[?2004l[?2004h>         'Accept': 'application/json',
[?2004l[?2004h>     }
[?2004l[?2004h>     if body is not None:
[?2004l[?2004h>         data = json.dumps(body).encode('utf-8')
[?2004l[?2004h>         headers['Content-Type'] = 'application/json'
[?2004l[?2004h>     req = urllib.request.Request(url, data=data, method=method, headers=headers)
[?2004l[?2004h>     try:
[?2004l[?2004h>         with urllib.request.urlopen(req) as resp:
[?2004l[?2004h>             return resp.status, json.loads(resp.read().decode('utf-8'))
[?2004l[?2004h>     except urllib.error.HTTPError as e:
[?2004l[?2004h>         return e.code, e.read().decode('utf-8')
[?2004l[?2004h> 
[?2004l[?2004h> # 1. Create ticket
[?2004l[?2004h> subject = f'[COMMENT-EDIT-DELETE] {RUN_ID}'
[?2004l[?2004h> print(f'Creating ticket with subject: {subject}')
[?2004l[?2004h> status, resp = request('POST', f'/issue-tracking/collections/{COLLECTION_ID}/tickets', {
[?2004l[?2004h>     'subject': subject,
[?2004l[?2004h>     'status': 'open',
[?2004l[?2004h>     'description': f'Ticket for comment edit/delete workflow. run-id={RUN_ID}',
[?2004l[?2004h> })
[?2004l[?2004h> print('Create ticket status:', status)
[?2004l[?2004h> print('Create ticket response:', json.dumps(resp, indent=2) if isinstance(resp, dict) else resp)
[?2004l[?2004h> 
[?2004l[?2004h> if status not in (200, 201):
[?2004l[?2004h>     raise SystemExit('Failed to create ticket')
[?2004l[?2004h> 
[?2004l[?2004h> ticket_id = resp['data']['id']
[?2004l[?2004h> print(f'Ticket ID: {ticket_id}')
[?2004l[?2004h> 
[?2004l[?2004h> # Log ticket ID
[?2004l[?2004h> with open('/home/user/apideck_task/output.log', 'w') as f:
[?2004l[?2004h>     f.write(f'Ticket ID: {ticket_id}\n')
[?2004l[?2004h> 
[?2004l[?2004h> # 2. Add 4 comments
[?2004l[?2004h> comment_ids = {}
[?2004l[?2004h> for label in ['A', 'B', 'C', 'D']:
[?2004l[?2004h>     body = f'{label}-{RUN_ID}'
[?2004l[?2004h>     print(f'Creating comment {body}')
[?2004l[?2004h>     status, resp = request('POST', f'/issue-tracking/collections/{COLLECTION_ID}/tickets/{ticket_id}/comments', {
[?2004l[?2004h>         'body': body,
[?2004l[?2004h>     })
[?2004l[?2004h>     print(f'  status={status}')
[?2004l[?2004h>     if isinstance(resp, dict):
[?2004l[?2004h>         cid = resp.get('data', {}).get('id')
[?2004l[?2004h>         comment_ids[body] = cid
[?2004l[?2004h>         print(f'  id={cid}')
[?2004l[?2004h>     else:
[?2004l[?2004h>         print(f'  resp={resp}')
[?2004l[?2004h>     if status not in (200, 201):
[?2004l[?2004h>         raise SystemExit(f'Failed to create comment {body}')
[?2004l[?2004h> 
[?2004l[?2004h> # 3. Edit comment B
[?2004l[?2004h> b_body = f'B-{RUN_ID}'
[?2004l[?2004h> b_id = comment_ids[b_body]
[?2004l[?2004h> b_new = f'B-EDITED-{RUN_ID}'
[?2004l[?2004h> print(f'Editing comment {b_id} -> {b_new}')
[?2004l[?2004h> status, resp = request('PATCH', f'/issue-tracking/collections/{COLLECTION_ID}/tickets/{ticket_id}/comments/{b_id}', {
[?2004l[?2004h>     'body': b_new,
[?2004l[?2004h> })
[?2004l[?2004h> print(f'  status={status}')
[?2004l[?2004h> print(f'  resp={json.dumps(resp, indent=2) if isinstance(resp, dict) else resp}')
[?2004l[?2004h> 
[?2004l[?2004h> # 4. Delete comment C
[?2004l[?2004h> c_body = f'C-{RUN_ID}'
[?2004l[?2004h> c_id = comment_ids[c_body]
[?2004l[?2004h> print(f'Deleting comment {c_id}')
[?2004l[?2004h> status, resp = request('DELETE', f'/issue-tracking/collections/{COLLECTION_ID}/tickets/{ticket_id}/comments/{c_id}')
[?2004l[?2004h> print(f'  status={status}')
[?2004l[?2004h> print(f'  resp={json.dumps(resp, indent=2) if isinstance(resp, dict) else resp}')
[?2004l[?2004h> 
[?2004l[?2004h> # 5. Verify by listing comments
[?2004l[?2004h> print('\nVerifying comments...')
[?2004l[?2004h> all_comments = []
[?2004l[?2004h> cursor = None
[?2004l[?2004h> while True:
[?2004l[?2004h>     query = {'limit': 100}
[?2004l[?2004h>     if cursor:
[?2004l[?2004h>         query['cursor'] = cursor
[?2004l[?2004h>     status, resp = request('GET', f'/issue-tracking/collections/{COLLECTION_ID}/tickets/{ticket_id}/comments', query=query)
[?2004l[?2004h>     if status != 200 or not isinstance(resp, dict):
[?2004l[?2004h>         print('List status:', status, resp)
[?2004l[?2004h>         break
[?2004l[?2004h>     all_comments.extend(resp.get('data', []))
[?2004l[?2004h>     cursor = resp.get('meta', {}).get('cursors', {}).get('next')
[?2004l[?2004h>     if not cursor:
[?2004l[?2004h>         break
[?2004l[?2004h> 
[?2004l[?2004h> print(f'Total comments: {len(all_comments)}')
[?2004l[?2004h> for c in all_comments:
[?2004l[?2004h>     print(f'  id={c.get("id")} body={c.get("body")!r}')
