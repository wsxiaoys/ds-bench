[40.91762, "o", "Deleting comment 4876902924\r\n"]
[41.819279, "o", "  status=200\r\n  resp={\r\n  \"status_code\": 200,\r\n  \"status\": \"OK\",\r\n  \"service\": \"github\",\r\n  \"resource\": \"collection-ticket-comments\",\r\n  \"operation\": \"delete\",\r\n  \"data\": {}\r\n}\r\n\r\nVerifying comments...\r\n"]
[42.599018, "o", "Total comments: 3\r\n  id=4876902716 body='A-zr4rm91n5t'\r\n  id=4876902827 body='B-EDITED-zr4rm91n5t'\r\n  id=4876903039 body='D-zr4rm91n5t'\r\n\r\nLogged ticket ID: 270\r\n"]
