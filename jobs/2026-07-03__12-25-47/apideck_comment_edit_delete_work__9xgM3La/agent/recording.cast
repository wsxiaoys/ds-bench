[34.229714, "o", "    except urllib.error.HTTPError as e:\r\n\u001b[?2004l\r"]
[34.229739, "o", "\u001b[?2004h> "]
[34.229898, "o", "        return e.code, e.read().decode('utf-8')\r\n\u001b[?2004l\r"]
[34.229922, "o", "\u001b[?2004h> "]
[34.229975, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[34.230042, "o", "# 1. Create ticket\r\n\u001b[?2004l\r"]
[34.230086, "o", "\u001b[?2004h> "]
[34.230225, "o", "subject = f'[COMMENT-EDIT-DELETE] {RUN_ID}'\r\n\u001b[?2004l\r"]
[34.230277, "o", "\u001b[?2004h> "]
[34.23042, "o", "print(f'Creating ticket with subject: {subject}')\r\n\u001b[?2004l\r\u001b[?2004h"]
[34.23047, "o", "> "]
[34.230713, "o", "status, resp = request('POST', f'/issue-tracking/collections/{COLLECTION_ID}/tickets', {\r\n\u001b[?2004l\r\u001b[?2004h"]
[34.230751, "o", "> "]
[34.230805, "o", "    'subject': subject,\r\n\u001b[?2004l\r"]
[34.230827, "o", "\u001b[?2004h> "]
[34.230906, "o", "    'status': 'open',\r\n\u001b[?2004l\r"]
[34.230929, "o", "\u001b[?2004h> "]
[34.231185, "o", "    'description': f'Ticket for comment edit/delete workflow. run-id={RUN_ID}',\r\n\u001b[?2004l\r"]
[34.231224, "o", "\u001b[?2004h> })\r\n\u001b[?2004l\r"]
[34.231247, "o", "\u001b[?2004h> "]
[34.231374, "o", "print('Create ticket status:', status)\r\n\u001b[?2004l\r"]
[34.231398, "o", "\u001b[?2004h> "]
[34.231707, "o", "print('Create ticket response:', json.dumps(resp, indent=2) if isinstance(resp, dict) else resp)\r\n\u001b[?2004l\r"]
[34.23175, "o", "\u001b[?2004h> "]
[34.231774, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[34.231875, "o", "if status not in (200, 201):\r\n\u001b[?2004l\r"]
[34.231916, "o", "\u001b[?2004h> "]
[34.232055, "o", "    raise SystemExit('Failed to create ticket')\r\n\u001b[?2004l\r"]
[34.232091, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[34.232114, "o", "> "]
[34.232219, "o", "ticket_id = resp['data']['id']\r\n\u001b[?2004l\r"]
[34.232244, "o", "\u001b[?2004h> "]
[34.232351, "o", "print(f'Ticket ID: {ticket_id}')\r\n\u001b[?2004l\r"]
[34.232376, "o", "\u001b[?2004h> "]
[34.232427, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[34.232481, "o", "# Log ticket ID\r\n\u001b[?2004l\r"]
[34.232503, "o", "\u001b[?2004h> "]
[34.2327, "o", "with open('/home/user/apideck_task/output.log', 'w') as f:\r\n\u001b[?2004l\r"]
[34.232742, "o", "\u001b[?2004h> "]
[34.232858, "o", "    f.write(f'Ticket ID: {ticket_id}\\n')\r\n\u001b[?2004l\r"]
[34.232896, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[34.23292, "o", "> "]
[34.232987, "o", "# 2. Add 4 comments\r\n\u001b[?2004l\r"]
[34.23303, "o", "\u001b[?2004h> "]
[34.233072, "o", "comment_ids = {}\r\n\u001b[?2004l\r"]
[34.233112, "o", "\u001b[?2004h> "]
[34.233217, "o", "for label in ['A', 'B', 'C', 'D']:\r\n\u001b[?2004l\r"]
[34.233281, "o", "\u001b[?2004h> "]
[34.233342, "o", "    body = f'{label}-{RUN_ID}'\r\n\u001b[?2004l\r"]
[34.233368, "o", "\u001b[?2004h> "]
[34.233498, "o", "    print(f'Creating comment {body}')\r\n\u001b[?2004l\r"]
[34.233522, "o", "\u001b[?2004h> "]
[34.233879, "o", "    status, resp = request('POST', f'/issue-tracking/collections/{COLLECTION_ID}/tickets/{ticket_id}/comments', {\r\n\u001b[?2004l\r"]
[34.233941, "o", "\u001b[?2004h> "]
[34.234, "o", "        'body': body,\r\n\u001b[?2004l\r\u001b[?2004h> "]
[34.23406, "o", "    })\r\n\u001b[?2004l\r\u001b[?2004h"]
[34.234109, "o", "> "]
[34.234159, "o", "    print(f'  status={status}')\r\n\u001b[?2004l\r"]
[34.234231, "o", "\u001b[?2004h> "]
[34.234294, "o", "    if isinstance(resp, dict):\r\n\u001b[?2004l\r"]
[34.23435, "o", "\u001b[?2004h> "]
[34.234462, "o", "        cid = resp.get('data', {}).get('id')\r\n\u001b[?2004l\r\u001b[?2004h"]
[34.23451, "o", "> "]
[34.234593, "o", "        comment_ids[body] = cid\r\n\u001b[?2004l\r"]
[34.234658, "o", "\u001b[?2004h> "]
[34.234717, "o", "        print(f'  id={cid}')\r\n\u001b[?2004l\r"]
[34.234772, "o", "\u001b[?2004h> "]
[34.234818, "o", "    else:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[34.234901, "o", "        print(f'  resp={resp}')\r\n\u001b[?2004l\r"]
[34.234957, "o", "\u001b[?2004h> "]
[34.235071, "o", "    if status not in (200, 201):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[34.235283, "o", "        raise SystemExit(f'Failed to create comment {body}')\r\n\u001b[?2004l\r\u001b[?2004h"]
[34.235336, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[34.235405, "o", "# 3. Edit comment B\r\n\u001b[?2004l\r\u001b[?2004h"]
[34.235453, "o", "> "]
[34.235505, "o", "b_body = f'B-{RUN_ID}'\r\n\u001b[?2004l\r\u001b[?2004h"]
[34.235557, "o", "> "]
[34.235624, "o", "b_id = comment_ids[b_body]\r\n\u001b[?2004l\r\u001b[?2004h"]
[34.235671, "o", "> "]
[34.235739, "o", "b_new = f'B-EDITED-{RUN_ID}'\r\n\u001b[?2004l\r\u001b[?2004h"]
[34.235788, "o", "> "]
[34.235902, "o", "print(f'Editing comment {b_id} -> {b_new}')\r\n\u001b[?2004l\r\u001b[?2004h"]
[34.235948, "o", "> "]
[34.236296, "o", "status, resp = request('PATCH', f'/issue-tracking/collections/{COLLECTION_ID}/tickets/{ticket_id}/comments/{b_id}', {\r\n\u001b[?2004l\r\u001b[?2004h"]
[34.236328, "o", "> "]
[34.236378, "o", "    'body': b_new,\r\n\u001b[?2004l\r\u001b[?2004h"]
[34.236441, "o", "> })\r\n\u001b[?2004l\r\u001b[?2004h> "]
[34.236535, "o", "print(f'  status={status}')\r\n\u001b[?2004l\r\u001b[?2004h"]
[34.236583, "o", "> "]
[34.236816, "o", "print(f'  resp={json.dumps(resp, indent=2) if isinstance(resp, dict) else resp}')\r\n\u001b[?2004l\r\u001b[?2004h"]
[34.236864, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[34.236944, "o", "# 4. Delete comment C\r\n\u001b[?2004l\r\u001b[?2004h"]
[34.236993, "o", "> "]
[34.237045, "o", "c_body = f'C-{RUN_ID}'\r\n\u001b[?2004l\r\u001b[?2004h"]
[34.23709, "o", "> "]
[34.237158, "o", "c_id = comment_ids[c_body]\r\n\u001b[?2004l\r\u001b[?2004h"]
[34.237205, "o", "> "]
[34.237322, "o", "print(f'Deleting comment {c_id}')\r\n\u001b[?2004l\r\u001b[?2004h> "]
[34.237687, "o", "status, resp = request('DELETE', f'/issue-tracking/collections/{COLLECTION_ID}/tickets/{ticket_id}/comments/{c_id}')\r\n\u001b[?2004l\r\u001b[?2004h"]
[34.237732, "o", "> "]
[34.237797, "o", "print(f'  status={status}')\r\n\u001b[?2004l\r"]
[34.237842, "o", "\u001b[?2004h> "]
[34.238078, "o", "print(f'  resp={json.dumps(resp, indent=2) if isinstance(resp, dict) else resp}')\r\n\u001b[?2004l\r\u001b[?2004h"]
[34.238123, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[34.238243, "o", "# 5. Verify by listing comments\r\n\u001b[?2004l\r"]
[34.238308, "o", "\u001b[?2004h> "]
[34.238377, "o", "print('\\nVerifying comments...')\r\n\u001b[?2004l\r"]
[34.238423, "o", "\u001b[?2004h> "]
[34.238472, "o", "all_comments = []\r\n\u001b[?2004l\r"]
[34.238518, "o", "\u001b[?2004h> "]
[34.238564, "o", "cursor = None\r\n\u001b[?2004l\r\u001b[?2004h"]
[34.238607, "o", "> while True:\r\n\u001b[?2004l\r"]
[34.23865, "o", "\u001b[?2004h> "]
[34.238737, "o", "    query = {'limit': 100}\r\n\u001b[?2004l\r\u001b[?2004h"]
[34.238781, "o", "> "]
[34.238823, "o", "    if cursor:\r\n\u001b[?2004l\r\u001b[?2004h"]
[34.238866, "o", "> "]
[34.238946, "o", "        query['cursor'] = cursor\r\n\u001b[?2004l\r\u001b[?2004h"]
[34.238993, "o", "> "]
[34.239383, "o", "    status, resp = request('GET', f'/issue-tracking/collections/{COLLECTION_ID}/tickets/{ticket_id}/comments', query=query)\r\n\u001b[?2004l\r"]
[34.239422, "o", "\u001b[?2004h> "]
[34.239585, "o", "    if status != 200 or not isinstance(resp, dict):\r\n\u001b[?2004l\r\u001b[?2004h"]
[34.239635, "o", "> "]
[34.239754, "o", "        print('List status:', status, resp)\r\n\u001b[?2004l\r\u001b[?2004h"]
[34.239798, "o", "> "]
[34.239841, "o", "        break\r\n\u001b[?2004l\r\u001b[?2004h> "]
[34.240002, "o", "    all_comments.extend(resp.get('data', []))\r\n\u001b[?2004l\r"]
[34.240045, "o", "\u001b[?2004h> "]
[34.240242, "o", "    cursor = resp.get('meta', {}).get('cursors', {}).get('next')\r\n\u001b[?2004l\r"]
[34.24029, "o", "\u001b[?2004h> "]
[34.240338, "o", "    if not cursor:\r\n\u001b[?2004l\r\u001b[?2004h"]
[34.240382, "o", "> "]
[34.240425, "o", "        break\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[34.24047, "o", "\u001b[?2004h> "]
[34.240615, "o", "print(f'Total comments: {len(all_comments)}')\r\n\u001b[?2004l\r\u001b[?2004h"]
[34.240662, "o", "> "]
[34.24071, "o", "for c in all_comments:\r\n\u001b[?2004l\r"]
[34.240758, "o", "\u001b[?2004h> "]
[34.24092, "o", "    print(f'  id={c.get(\"id\")} body={c.get(\"body\")!r}')\r\n\u001b[?2004l\r"]
[34.240966, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[34.241112, "o", "print(f'\\nLogged ticket ID: {ticket_id}')\r\n\u001b[?2004l\r"]
[34.241157, "o", "\u001b[?2004h> EOF\r\n\u001b[?2004l\r"]
[34.242894, "o", "\u001b[?2004hroot@a567651f-5c90-4592-99d5-a62c048cd72f:~# "]
[34.242971, "o", "echo 'Script created'\r\n\u001b[?2004l\r"]
[34.243018, "o", "Script created\r\n\u001b[?2004hroot@a567651f-5c90-4592-99d5-a62c048cd72f:~# "]
[34.617713, "i", "python3 /home/user/apideck_task/workflow.py\n"]
[34.617974, "o", "python3 /home/user/apideck_task/workflow.py\r\n\u001b[?2004l\r"]
