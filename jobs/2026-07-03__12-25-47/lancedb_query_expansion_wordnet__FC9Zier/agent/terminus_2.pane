[?2004l[?2004h>         db = lancedb.connect(os.environ['LANCEDB_URI'])
[?2004l[?2004h>         _TABLE = db.open_table(os.environ['LANCEDB_TABLE'])
[?2004l[?2004h>     return _TABLE
[?2004l[?2004h> 
[?2004l[?2004h> 
[?2004l[?2004h> def _ensure_fts_index():
[?2004l[?2004h>     global _IDX_BUILT
[?2004l[?2004h>     if _IDX_BUILT:
[?2004l[?2004h>         return
[?2004l[?2004h>     table = _get_table()
[?2004l[?2004h>     # Check if an FTS index on 'content' already exists; only create if not present.
[?2004l[?2004h>     has_fts = False
[?2004l[?2004h>     try:
[?2004l[?2004h>         indices = table.list_indices()
[?2004l[?2004h>     except Exception:
[?2004l[?2004h>         indices = []
[?2004l[?2004h>     for idx in indices:
[?2004l[?2004h>         try:
[?2004l[?2004h>             cols = getattr(idx, 'columns', None)
[?2004l[?2004h>             idx_type = str(getattr(idx, 'index_type', '') or getattr(idx, 'type', '') or '')
[?2004l[?2004h>         except Exception:
[?2004l[?2004h>             continue
[?2004l[?2004h>         if cols is None:
[?2004l[?2004h>             continue
[?2004l[?2004h>         col_names = [c if isinstance(c, str) else getattr(c, 'name', str(c)) for c in cols]
[?2004l[?2004h>         if any(name == 'content' or name.endswith('content') for name in col_names):
[?2004l[?2004h>             if 'FTS' in idx_type.upper() or 'INVERTED' in idx_type.upper() or not idx_type:
[?2004l[?2004h>                 has_fts = True
[?2004l[?2004h>                 break
[?2004l[?2004h>     if not has_fts:
[?2004l[?2004h>         try:
[?2004l[?2004h>             table.create_fts_index("content", use_tantivy=False, replace=False)
[?2004l[?2004h>         except Exception as e:
[?2004l[?2004h>             # Tolerate "already exists" cases since some lancedb versions raise.
[?2004l[?2004h>             if 'already exists' not in str(e).lower() and 'duplicate' not in str(e).lower():
[?2004l[?2004h>                 raise
[?2004l[?2004h>     _IDX_BUILT = True
[?2004l[?2004h> 
[?2004l[?2004h> 
[?2004l[?2004h> def _expand_token(token: str) -> list[str]:
[?2004l[?2004h>     """Return the lowercase token plus up to 3 single-word WordNet synonyms."""
[?2004l[?2004h>     token = token.lower()
[?2004l[?2004h>     out = []
[?2004l[?2004h>     seen = {token}
[?2004l[?2004h>     # wn.synonyms returns a list of lists (per sense) of lemma names.
[?2004l[?2004h>     groups = []
[?2004l[?2004h>     try:
[?2004l[?2004h>         groups = wn.synonyms(token) or []
[?2004l[?2004h>     except Exception:
[?2004l[?2004h>         groups = []
[?2004l[?2004h>     if not groups:
[?2004l[?2004h>         # Fallback: derive from synsets directly.
[?2004l[?2004h>         try:
[?2004l[?2004h>             for syn in wn.synsets(token):
[?2004l[?2004h>                 groups.append([n.replace('_', ' ').replace('-', ' ') for n in syn.lemma_names()])
[?2004l[?2004h>         except Exception:
[?2004l[?2004h>             groups = []
[?2004l[?2004h>     for group in groups:
[?2004l[?2004h>         for lemma in group:
[?2004l[?2004h>             lemma = lemma.lower().strip()
[?2004l[?2004h>             if not lemma or lemma in seen:
[?2004l[?2004h>                 continue
[?2004l[?2004h>             # Keep only single-token synonyms (no '_' or whitespace).
[?2004l[?2004h>             if any(ch in lemma for ch in ('_', ' ', '\t', '\n')):
[?2004l[?2004h>                 continue
[?2004l[?2004h>             seen.add(lemma)
[?2004l[?2004h>             out.append(lemma)
[?2004l[?2004h>             if len(out) >= 3:
[?2004l[?2004h>                 break
[?2004l[?2004h>         if len(out) >= 3:
[?2004l[?2004h>             break
[?2004l[?2004h>     return [token] + out
[?2004l[?2004h> 
[?2004l[?2004h> 
[?2004l[?2004h> def expanded_search(query: str, k: int = 10) -> list[int]:
[?2004l[?2004h>     tokens = query.lower().split()
[?2004l[?2004h>     expansion_tokens = []
[?2004l[?2004h>     for t in tokens:
[?2004l[?2004h>         expansion_tokens.extend(_expand_token(t))
[?2004l[?2004h>     # Deduplicate while preserving order.
[?2004l[?2004h>     seen = set()
[?2004l[?2004h>     uniq = []
[?2004l[?2004h>     for t in expansion_tokens:
[?2004l[?2004h>         if t not in seen:
[?2004l[?2004h>             seen.add(t)
[?2004l[?2004h>             uniq.append(t)
[?2004l[?2004h> 
[?2004l[?2004h>     table = _get_table()
[?2004l[?2004h>     _ensure_fts_index()
[?2004l[?2004h> 
[?2004l[?2004h>     # Space-separated terms query is the simplest OR semantics and is deterministic.
[?2004l[?2004h>     fts_query = ' '.join(uniq)
[?2004l[?2004h>     results = table.search(fts_query, query_type="fts").limit(k).to_list()
[?2004l[?2004h>     return [r['id'] for r in results]
