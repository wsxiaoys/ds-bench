[?2004l[?2004h> import lancedb  # noqa: E402
[?2004l[?2004h> 
[?2004l[?2004h> _TABLE = None
[?2004l[?2004h> _IDX_BUILT = False
[?2004l[?2004h> 
[?2004l[?2004h> 
[?2004l[?2004h> def _get_table():
[?2004l[?2004h>     global _TABLE
