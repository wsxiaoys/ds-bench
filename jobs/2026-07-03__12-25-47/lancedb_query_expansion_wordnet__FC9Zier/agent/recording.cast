[56.314403, "o", "> "]
[56.314497, "o", "df = table.to_pandas()\r\n\u001b[?2004l\r\u001b[?2004h"]
[56.314583, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
