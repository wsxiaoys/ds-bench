[20.735023, "o", "EOF\r\n\u001b[?2004l\r"]
[21.978049, "o", "Tables: ['docs']\r\n"]
[21.978929, "o", "Schema: id: int64\r\ncontent: string\r\n"]
[21.982267, "o", "Total rows: 100\r\n"]
[21.984345, "o", "   id                                            content\r\n0   0  She drove her car to the airport very early on...\r\n1   1  My friend's car broke down on the busy highway...\r\n2   2  He parked his car in front of the small bakery...\r\n3   3  The blue car raced past the finish line in abs...\r\n4   4  Repairing a car engine often requires expensiv...\r\n---\r\nShe drove her car to the airport very early on Monday morning.\r\n"]
