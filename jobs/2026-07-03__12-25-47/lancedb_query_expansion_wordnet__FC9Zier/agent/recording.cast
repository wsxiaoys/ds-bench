[56.314919, "o", "> "]
[56.315016, "o", "print('Top results:')\r\n\u001b[?2004l\r"]
[56.3151, "o", "\u001b[?2004h> "]
[56.315277, "o", "for i, id_ in enumerate(result):\r\n\u001b[?2004l\r"]
[56.315361, "o", "\u001b[?2004h> "]
[56.315565, "o", "    row = df[df['id'] == id_].iloc[0]\r\n\u001b[?2004l\r"]
[56.315649, "o", "\u001b[?2004h> "]
[56.315975, "o", "    print(f'  rank {i}: id={id_}: {row[\\\"content\\\"][:80]}')\r\n\u001b[?2004l\r"]
[56.31606, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[56.316143, "o", "> print()\r\n\u001b[?2004l\r\u001b[?2004h"]
[56.316224, "o", "> "]
[56.316437, "o", "print('=== Test 2: Calling again ===')\r\n\u001b[?2004l\r\u001b[?2004h"]
