[121.869922, "o", "    tokens = query.lower().split()\r\n\u001b[?2004l\r"]
[121.869985, "o", "\u001b[?2004h> "]
[121.870117, "o", "    expansion_tokens = []\r\n\u001b[?2004l\r"]
[121.870181, "o", "\u001b[?2004h> "]
[121.870297, "o", "    for t in tokens:\r\n\u001b[?2004l\r"]
[121.870348, "o", "\u001b[?2004h> "]
[121.870603, "o", "        expansion_tokens.extend(_expand_token(t))\r\n\u001b[?2004l\r"]
[121.870678, "o", "\u001b[?2004h> "]
[121.870859, "o", "    # Deduplicate while preserving order.\r\n\u001b[?2004l\r"]
[121.870921, "o", "\u001b[?2004h> "]
[121.870998, "o", "    seen = set()\r\n\u001b[?2004l\r"]
[121.871062, "o", "\u001b[?2004h> "]
[121.871131, "o", "    uniq = []\r\n\u001b[?2004l\r"]
[121.871193, "o", "\u001b[?2004h> "]
[121.871364, "o", "    for t in expansion_tokens:\r\n\u001b[?2004l\r"]
[121.871413, "o", "\u001b[?2004h> "]
[121.871547, "o", "        if t not in seen:\r\n\u001b[?2004l\r"]
[121.871597, "o", "\u001b[?2004h> "]
[121.871719, "o", "            seen.add(t)\r\n\u001b[?2004l\r"]
[121.871767, "o", "\u001b[?2004h> "]
[121.871914, "o", "            uniq.append(t)\r\n\u001b[?2004l\r"]
[121.87196, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[121.872044, "o", "> "]
[121.872157, "o", "    table = _get_table()\r\n\u001b[?2004l\r\u001b[?2004h"]
[121.872202, "o", "> "]
[121.872349, "o", "    _ensure_fts_index()\r\n\u001b[?2004l\r"]
[121.872425, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[121.872889, "o", "    # Space-separated terms query is the simplest OR semantics and is deterministic.\r\n\u001b[?2004l\r\u001b[?2004h> "]
[121.873066, "o", "    fts_query = ' '.join(uniq)\r\n\u001b[?2004l\r"]
[121.873143, "o", "\u001b[?2004h> "]
[121.873511, "o", "    results = table.search(fts_query, query_type=\"fts\").limit(k).to_list()\r\n\u001b[?2004l\r"]
[121.873572, "o", "\u001b[?2004h> "]
[121.873759, "o", "    return [r['id'] for r in results]\r\n\u001b[?2004l\r"]
[121.873818, "o", "\u001b[?2004h> PYEOF\r\n"]
[121.873872, "o", "\u001b[?2004l\r"]
[121.87578, "o", "\u001b[?2004hroot@fc2ffc99-f6cb-4248-a726-8c98273b5829:/home/user/myproject# "]
[121.875891, "o", "echo 'written'\r\n\u001b[?2004l\r"]
[121.875957, "o", "written\r\n"]
[121.876022, "o", "\u001b[?2004hroot@fc2ffc99-f6cb-4248-a726-8c98273b5829:/home/user/myproject# "]
