[42.617002, "o", "\u001b[?2004h> "]
[42.617142, "o", "    return _TABLE\r\n\u001b[?2004l\r"]
[42.617187, "o", "\u001b[?2004h> "]
[42.617284, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[42.617351, "o", "\u001b[?2004h> "]
[42.617531, "o", "def _ensure_fts_index():\r\n\u001b[?2004l\r"]
[42.617576, "o", "\u001b[?2004h> "]
[42.617749, "o", "    global _IDX_BUILT\r\n\u001b[?2004l\r"]
[42.617794, "o", "\u001b[?2004h> "]
[42.617945, "o", "    if _IDX_BUILT:\r\n\u001b[?2004l\r"]
[42.617991, "o", "\u001b[?2004h> "]
[42.618115, "o", "        return\r\n\u001b[?2004l\r"]
[42.61816, "o", "\u001b[?2004h> "]
[42.618365, "o", "    table = _get_table()\r\n\u001b[?2004l\r"]
[42.61841, "o", "\u001b[?2004h> "]
[42.618804, "o", "    # Check if an FTS index on 'content' already exists\r\n\u001b[?2004l\r"]
[42.618849, "o", "\u001b[?2004h> "]
[42.619006, "o", "    has_fts = False\r\n\u001b[?2004l\r"]
[42.619052, "o", "\u001b[?2004h> "]
[42.619143, "o", "    try:\r\n\u001b[?2004l\r"]
[42.619189, "o", "\u001b[?2004h> "]
[42.619492, "o", "        for idx in table.list_indices():\r\n\u001b[?2004l\r"]
[42.619537, "o", "\u001b[?2004h> "]
[42.620228, "o", "            # idx columns dict and details vary between lancedb versions; just attempt create if not.\r\n\u001b[?2004l\r"]
[42.62028, "o", "\u001b[?2004h> "]
[42.620435, "o", "            try:\r\n\u001b[?2004l\r"]
[42.62048, "o", "\u001b[?2004h> "]
[42.620975, "o", "                cols = idx.columns if hasattr(idx, 'columns') else None\r\n\u001b[?2004l\r"]
[42.621021, "o", "\u001b[?2004h> "]
[42.621262, "o", "            except Exception:\r\n\u001b[?2004l\r"]
[42.621307, "o", "\u001b[?2004h> "]
[42.621523, "o", "                cols = None\r\n\u001b[?2004l\r"]
[42.621568, "o", "\u001b[?2004h> "]
[42.621795, "o", "            if cols is None:\r\n\u001b[?2004l\r"]
[42.621875, "o", "\u001b[?2004h> "]
[42.622017, "o", "                continue\r\n\u001b[?2004l\r"]
[42.622062, "o", "\u001b[?2004h> "]
[42.622735, "o", "            col_names = [c if isinstance(c, str) else getattr(c, 'name', str(c)) for c in cols]\r\n\u001b[?2004l\r"]
[42.62278, "o", "\u001b[?2004h> "]
[42.623402, "o", "            if any(name == 'content' or name.endswith('content') for name in col_names):\r\n\u001b[?2004l\r"]
[42.623448, "o", "\u001b[?2004h> "]
[42.623995, "o", "                # Roughly check if it is an FTS index; if type info available\r\n\u001b[?2004l\r"]
[42.62404, "o", "\u001b[?2004h> "]
[42.624679, "o", "                idx_type = getattr(idx, 'index_type', None) or getattr(idx, 'type', None)\r\n\u001b[?2004l\r"]
[42.624724, "o", "\u001b[?2004h> "]
[42.62548, "o", "                if idx_type is None or 'FTS' in str(idx_type).upper() or 'INVERTED' in str(idx_type).upper():\r\n\u001b[?2004l\r"]
[42.625525, "o", "\u001b[?2004h> "]
[42.625772, "o", "                    has_fts = True\r\n\u001b[?2004l\r"]
[42.625817, "o", "\u001b[?2004h> "]
[42.626005, "o", "                    break\r\n\u001b[?2004l\r"]
[42.62605, "o", "\u001b[?2004h> "]
[42.62622, "o", "    except Exception:\r\n\u001b[?2004l\r"]
[42.626276, "o", "\u001b[?2004h> "]
[42.626463, "o", "        has_fts = False\r\n\u001b[?2004l\r"]
[42.626508, "o", "\u001b[?2004h> "]
[42.626667, "o", "    if not has_fts:\r\n\u001b[?2004l\r"]
[42.626712, "o", "\u001b[?2004h> "]
[42.626822, "o", "        try:\r\n\u001b[?2004l\r"]
[42.626867, "o", "\u001b[?2004h> "]
[42.627429, "o", "            table.create_fts_index(\"content\", use_tantivy=False, replace=False)\r\n\u001b[?2004l\r"]
[42.627474, "o", "\u001b[?2004h> "]
[42.627705, "o", "        except Exception as e:\r\n\u001b[?2004l\r"]
[42.627751, "o", "\u001b[?2004h> "]
[42.628186, "o", "            # If the index already exists in some form, ignore\r\n\u001b[?2004l\r"]
[42.628237, "o", "\u001b[?2004h> "]
[42.628877, "o", "            if 'already exists' not in str(e).lower() and 'duplicate' not in str(e).lower():\r\n\u001b[?2004l\r"]
[42.628921, "o", "\u001b[?2004h> "]
[42.629092, "o", "                raise\r\n\u001b[?2004l\r"]
[42.629138, "o", "\u001b[?2004h"]
[42.629226, "o", "> "]
[42.629334, "o", "    _IDX_BUILT = True\r\n\u001b[?2004l\r"]
[42.629382, "o", "\u001b[?2004h> "]
[42.629469, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> \r\n"]
[42.629537, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[42.629839, "o", "def _expand_token(token: str) -> list[str]:\r\n\u001b[?2004l\r"]
[42.629887, "o", "\u001b[?2004h> "]
[42.630524, "o", "    \"\"\"Return the token itself plus up to 3 single-word lowercase synonyms from WordNet.\"\"\"\r\n\u001b[?2004l\r"]
[42.630572, "o", "\u001b[?2004h> "]
[42.630761, "o", "    token = token.lower()\r\n\u001b[?2004l\r"]
[42.630809, "o", "\u001b[?2004h> "]
[42.63091, "o", "    out = []\r\n\u001b[?2004l\r"]
[42.630958, "o", "\u001b[?2004h> "]
[42.6311, "o", "    seen = {token}\r\n\u001b[?2004l\r"]
[42.631148, "o", "\u001b[?2004h> "]
[42.631589, "o", "    # Use wn.synonyms which returns synonyms grouped by sense\r\n\u001b[?2004l\r"]
[42.631638, "o", "\u001b[?2004h> "]
[42.631728, "o", "    try:\r\n\u001b[?2004l\r"]
[42.631777, "o", "\u001b[?2004h> "]
[42.632064, "o", "        groups = wn.synonyms(token) or []\r\n\u001b[?2004l\r"]
[42.632112, "o", "\u001b[?2004h> "]
[42.632286, "o", "    except Exception:\r\n\u001b[?2004l\r"]
[42.632334, "o", "\u001b[?2004h> "]
[42.632503, "o", "        groups = []\r\n\u001b[?2004l\r"]
[42.632551, "o", "\u001b[?2004h> "]
[42.632711, "o", "    if not groups:\r\n\u001b[?2004l\r"]
[42.63276, "o", "\u001b[?2004h> "]
[42.633056, "o", "        # Fallback: walk synsets ourselves\r\n\u001b[?2004l\r"]
[42.633104, "o", "\u001b[?2004h> "]
[42.633256, "o", "        groups = []\r\n\u001b[?2004l\r"]
[42.633305, "o", "\u001b[?2004h> "]
[42.633577, "o", "        for syn in wn.synsets(token):\r\n\u001b[?2004l\r"]
[42.633626, "o", "\u001b[?2004h> "]
[42.634206, "o", "            names = [n.replace('_', ' ').replace('-', ' ') for n in syn.lemma_names()]\r\n\u001b[?2004l\r"]
[42.634259, "o", "\u001b[?2004h> "]
[42.634495, "o", "            groups.append(names)\r\n\u001b[?2004l\r"]
[42.634544, "o", "\u001b[?2004h> "]
[42.634722, "o", "    for group in groups:\r\n\u001b[?2004l\r"]
[42.63477, "o", "\u001b[?2004h> "]
[42.63497, "o", "        for lemma in group:\r\n\u001b[?2004l\r"]
[42.635018, "o", "\u001b[?2004h> "]
[42.635336, "o", "            lemma = lemma.lower().strip()\r\n\u001b[?2004l\r\u001b[?2004h"]
[42.635386, "o", "> "]
[42.635663, "o", "            if not lemma or lemma in seen:\r\n\u001b[?2004l\r"]
[42.635711, "o", "\u001b[?2004h> "]
[42.635891, "o", "                continue\r\n\u001b[?2004l\r"]
[42.635936, "o", "\u001b[?2004h> "]
[42.636324, "o", "            # Single token only (no '_' or whitespace)\r\n\u001b[?2004l\r"]
[42.636372, "o", "\u001b[?2004h> "]
[42.636897, "o", "            if '_' in lemma or ' ' in lemma or '\\t' in lemma or '\\n' in lemma:\r\n\u001b[?2004l\r"]
[42.636945, "o", "\u001b[?2004h> "]
[42.637124, "o", "                continue\r\n\u001b[?2004l\r"]
[42.637172, "o", "\u001b[?2004h> "]
[42.637376, "o", "            seen.add(lemma)\r\n\u001b[?2004l\r"]
[42.637425, "o", "\u001b[?2004h> "]
[42.637636, "o", "            out.append(lemma)\r\n\u001b[?2004l\r"]
[42.637684, "o", "\u001b[?2004h> "]
[42.637894, "o", "            if len(out) >= 3:\r\n\u001b[?2004l\r"]
[42.637942, "o", "\u001b[?2004h> "]
[42.638101, "o", "                break\r\n\u001b[?2004l\r"]
[42.638149, "o", "\u001b[?2004h> "]
[42.638349, "o", "        if len(out) >= 3:\r\n\u001b[?2004l\r"]
[42.638397, "o", "\u001b[?2004h> "]
[42.638529, "o", "            break\r\n\u001b[?2004l\r"]
[42.638577, "o", "\u001b[?2004h> "]
[42.638757, "o", "    return [token] + out\r\n\u001b[?2004l\r"]
[42.638805, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[42.638895, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[42.638943, "o", "> "]
[42.639338, "o", "def expanded_search(query: str, k: int = 10) -> list[int]:\r\n\u001b[?2004l\r"]
[42.639386, "o", "\u001b[?2004h> "]
[42.639628, "o", "    tokens = query.lower().split()\r\n\u001b[?2004l\r"]
[42.639676, "o", "\u001b[?2004h> "]
[42.639859, "o", "    expansion_tokens = []\r\n\u001b[?2004l\r"]
[42.639907, "o", "\u001b[?2004h> "]
[42.640066, "o", "    for t in tokens:\r\n\u001b[?2004l\r"]
[42.640113, "o", "\u001b[?2004h> "]
[42.640466, "o", "        expansion_tokens.extend(_expand_token(t))\r\n\u001b[?2004l\r"]
[42.640515, "o", "\u001b[?2004h> "]
[42.640796, "o", "    # Deduplicate while preserving order\r\n\u001b[?2004l\r"]
[42.640844, "o", "\u001b[?2004h> "]
[42.640969, "o", "    seen = set()\r\n\u001b[?2004l\r"]
[42.641018, "o", "\u001b[?2004h> "]
[42.641126, "o", "    uniq = []\r\n\u001b[?2004l\r"]
[42.641175, "o", "\u001b[?2004h> "]
[42.641401, "o", "    for t in expansion_tokens:\r\n\u001b[?2004l\r"]
[42.64145, "o", "\u001b[?2004h> "]
[42.641633, "o", "        if t not in seen:\r\n\u001b[?2004l\r"]
[42.64168, "o", "\u001b[?2004h> "]
[42.641856, "o", "            seen.add(t)\r\n\u001b[?2004l\r"]
[42.641903, "o", "\u001b[?2004h> "]
[42.642096, "o", "            uniq.append(t)\r\n\u001b[?2004l\r"]
[42.642143, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[42.642227, "o", "\u001b[?2004h> "]
[42.642383, "o", "    table = _get_table()\r\n\u001b[?2004l\r"]
[42.642477, "o", "\u001b[?2004h> "]
[42.642613, "o", "    _ensure_fts_index()\r\n\u001b[?2004l\r"]
[42.642657, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[42.642747, "o", "\u001b[?2004h> "]
[42.642989, "o", "    # Build a SHOULD/OR boolean query\r\n\u001b[?2004l\r"]
[42.643034, "o", "\u001b[?2004h> "]
[42.643203, "o", "    if len(uniq) == 1:\r\n\u001b[?2004l\r"]
[42.643262, "o", "\u001b[?2004h> "]
[42.64361, "o", "        search_q = MatchQuery(uniq[0], \"content\")\r\n\u001b[?2004l\r"]
[42.643658, "o", "\u001b[?2004h> "]
[42.643734, "o", "    else:\r\n\u001b[?2004l\r"]
[42.643781, "o", "\u001b[?2004h> "]
[42.644296, "o", "        clauses = [(Occur.SHOULD, MatchQuery(t, \"content\")) for t in uniq]\r\n\u001b[?2004l\r"]
[42.64434, "o", "\u001b[?2004h> "]
[42.644629, "o", "        search_q = BooleanQuery(clauses)\r\n\u001b[?2004l\r"]
[42.64475, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[42.644825, "o", "\u001b[?2004h> "]
[42.645244, "o", "    results = table.search(search_q, query_type=\"fts\").limit(k).to_list()\r\n\u001b[?2004l\r"]
[42.645294, "o", "\u001b[?2004h> "]
[42.645563, "o", "    return [r['id'] for r in results]\r\n\u001b[?2004l\r"]
[42.645613, "o", "\u001b[?2004h> "]
[42.645718, "o", "PYEOF\r\n\u001b[?2004l\r"]
[42.649116, "o", "\u001b[?2004hroot@fc2ffc99-f6cb-4248-a726-8c98273b5829:~# "]
[42.649561, "o", "echo '---' && cat /home/user/myproject/solution.py | head -20\r\n\u001b[?2004l\r"]
[42.649611, "o", "---\r\n"]
[42.65146, "o", "import os\r\nimport nltk\r\n\r\n# Ensure WordNet corpora are present\r\nfor pkg in ('wordnet', 'omw-1.4'):\r\n    try:\r\n        nltk.data.find(f'corpora/{pkg}')\r\n    except LookupError:\r\n        nltk.download(pkg, quiet=True)\r\n\r\nfrom nltk.corpus import wordnet as wn  # noqa: E402\r\n\r\nimport lancedb  # noqa: E402\r\nfrom lancedb.query import MatchQuery, BooleanQuery, Occur  # noqa: E402\r\n\r\n_TABLE = None"]
[42.651512, "o", "\r\n_IDX_BUILT = False\r\n\r\n\r\ndef _get_table():\r\n"]
[42.651802, "o", "\u001b[?2004hroot@fc2ffc99-f6cb-4248-a726-8c98273b5829:~# "]
[45.987688, "i", "cd /home/user/myproject && python3 -c \"\nimport os\nos.environ['LANCEDB_URI'] = '/app/lancedb_data'\nos.environ['LANCEDB_TABLE'] = 'docs'\nfrom solution import expanded_search\nresult = expanded_search('car', k=20)\nprint('Results for car (k=20):', result)\nprint('Count:', len(result))\n\"\n"]
[45.988111, "o", "cd /home/user/myproject && python3 -c \"\r\n\u001b[?2004l\r"]
[45.988215, "o", "\u001b[?2004h> "]
