[91.618278, "i", "python3 << 'EOF'\nimport os\nos.environ['LANCEDB_URI'] = '/app/lancedb_data'\nos.environ['LANCEDB_TABLE'] = 'docs'\nimport lancedb\n\ndb = lancedb.connect(os.environ['LANCEDB_URI'])\ntable = db.open_table(os.environ['LANCEDB_TABLE'])\n\n# Plain FTS baseline\nprint('=== Plain FTS for car ===')\nr1 = table.search('car', query_type='fts').limit(20).to_list()\nfor i, row in enumerate(r1):\n    print(f'  rank {i}: id={row[\"id\"]} score={row.get(\"_score\")}  {row[\"content\"][:60]}')\n\nprint()\nprint('=== Run plain FTS twice ===')\nr2 = table.search('car', query_type='fts').limit(20).to_list()\nfor i, row in enumerate(r2):\n    print(f'  rank {i}: id={row[\"id\"]} score={row.get(\"_score\")}')\nEOF\n"]
