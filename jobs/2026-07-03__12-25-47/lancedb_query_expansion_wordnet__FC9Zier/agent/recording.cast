[56.312811, "o", "os.environ['LANCEDB_URI'] = '/app/lancedb_data'\r\n\u001b[?2004l\r"]
[56.312877, "o", "\u001b[?2004h> "]
[56.313075, "o", "os.environ['LANCEDB_TABLE'] = 'docs'\r\n\u001b[?2004l\r"]
