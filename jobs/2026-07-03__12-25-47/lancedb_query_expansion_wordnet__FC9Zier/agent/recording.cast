[209.392208, "i", "python3 << 'EOF'\nimport os\nos.environ['LANCEDB_URI'] = '/app/lancedb_data'\nos.environ['LANCEDB_TABLE'] = 'docs'\nimport lancedb\n\ndb = lancedb.connect(os.environ['LANCEDB_URI'])\ntable = db.open_table(os.environ['LANCEDB_TABLE'])\n\n# Run with expanded query and check scores\ntokens = ['car', 'REDACTED', 'REDACTEDmobile', 'machine']\nq = ' '.join(tokens)\nprint(f'Expanded query: {q!r}')\nresults = table.search(q, query_type='fts').limit(20).to_list()\nprint('\\nAll results with scores:')\nfor r in results:\n    print(f'  id={r[\"id\"]:3d} score={r[\"_score\"]:.3f}  {r[\"content\"][:70]}')\nEOF\n"]
