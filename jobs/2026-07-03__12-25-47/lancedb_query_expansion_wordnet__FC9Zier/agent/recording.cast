[104.837956, "i", "python3 << 'EOF'\nimport os\nos.environ['LANCEDB_URI'] = '/app/lancedb_data'\nos.environ['LANCEDB_TABLE'] = 'docs'\nimport lancedb\nfrom lancedb.query import MatchQuery, BooleanQuery, Occur\n\ndb = lancedb.connect(os.environ['LANCEDB_URI'])\ntable = db.open_table(os.environ['LANCEDB_TABLE'])\n\n# Run with BooleanQuery multiple times\ntokens = ['car', 'REDACTED', 'REDACTEDmobile', 'motorcar']\nq = BooleanQuery([(Occur.SHOULD, MatchQuery(t, 'content')) for t in tokens])\n\nprint('=== MatchQuery/BooleanQuery runs ===')\nfor run in range(3):\n    rs = table.search(q, query_type='fts').limit(15).to_list()\n    ids = [r['id'] for r in rs]\n    print(f'Run {run}: {ids}')\n\nprint()\nprint('=== Space-separated string runs ===')\nfor run in range(3):\n    rs = table.search(' '.join(tokens), query_type='fts').limit(15).to_list()\n    ids = [r['id'] for r in rs]\n    print(f'Run {run}: {ids}')\nEOF\n"]
