[45.988376, "o", "\u001b[?2004h> "]
[45.988659, "o", "os.environ['LANCEDB_URI'] = '/app/lancedb_data'\r\n\u001b[?2004l\r"]
[45.988731, "o", "\u001b[?2004h> "]
[45.988942, "o", "os.environ['LANCEDB_TABLE'] = 'docs'\r\n\u001b[?2004l\r"]
[45.989014, "o", "\u001b[?2004h> "]
[45.989227, "o", "from solution import expanded_search\r\n\u001b[?2004l\r"]
[45.989316, "o", "\u001b[?2004h> "]
[45.989579, "o", "result = expanded_search('car', k=20)\r\n\u001b[?2004l\r"]
[45.989647, "o", "\u001b[?2004h> "]
[45.989882, "o", "print('Results for car (k=20):', result)\r\n\u001b[?2004l\r"]
[45.98995, "o", "\u001b[?2004h> "]
[45.990119, "o", "print('Count:', len(result))\r\n\u001b[?2004l\r"]
[45.990187, "o", "\u001b[?2004h> \"\r\n\u001b[?2004l\r"]
[49.115015, "o", "Results for car (k=20): [2, 5, 0, 4, 3, 8, 1, 7, 6, 12, 13, 10, 11, 9]\r\nCount: 14\r\n"]
[49.545935, "o", "\u001b[?2004hroot@fc2ffc99-f6cb-4248-a726-8c98273b5829:/home/user/myproject# "]
[56.312007, "i", "python3 -c \"\nimport os\nos.environ['LANCEDB_URI'] = '/app/lancedb_data'\nos.environ['LANCEDB_TABLE'] = 'docs'\nfrom solution import expanded_search\nimport lancedb\n\ndb = lancedb.connect(os.environ['LANCEDB_URI'])\ntable = db.open_table(os.environ['LANCEDB_TABLE'])\ndf = table.to_pandas()\n\nresult = expanded_search('car', k=15)\nprint('Top results:')\nfor i, id_ in enumerate(result):\n    row = df[df['id'] == id_].iloc[0]\n    print(f'  rank {i}: id={id_}: {row[\\\"content\\\"][:80]}')\n\nprint()\nprint('=== Test 2: Calling again ===')\nresult2 = expanded_search('vehicle', k=10)\nprint('Results for vehicle (k=10):', result2)\nfor id_ in result2:\n    row = df[df['id'] == id_].iloc[0]\n    print(f'  id={id_}: {row[\\\"content\\\"][:80]}')\n\nprint()\nprint('=== Test 3: multi-word query ===')\nresult3 = expanded_search('car vehicle', k=10)\nprint('Results for car vehicle (k=10):', result3)\n\"\n"]
[56.312301, "o", "python3 -c \"\r\n\u001b[?2004l\r"]
[56.312419, "o", "\u001b[?2004h> "]
