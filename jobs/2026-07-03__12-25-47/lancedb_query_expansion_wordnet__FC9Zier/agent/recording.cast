[28.050856, "i", "python3 << 'EOF'\nimport lancedb\nimport os\n\ndb = lancedb.connect(os.environ['LANCEDB_URI'])\ntable = db.open_table(os.environ['LANCEDB_TABLE'])\ndf = table.to_pandas()\n# Find documents that don't contain 'car' but contain 'REDACTEDmobile' or 'motorcar'\nimport re\ncontains_car = df['content'].str.contains(r'\\bcar\\b', case=False, regex=True)\ncontains_syn = df['content'].str.contains(r'\\b(REDACTEDmobile|motorcar|vehicle)\\b', case=True, regex=True)\nprint('Docs with car:', contains_car.sum())\nprint('Docs with synonym:', contains_syn.sum())\nprint('Docs with car AND synonym:', (contains_car & contains_syn).sum())\nprint('Docs with NEITHER:', ((~contains_car) & (~contains_syn)).sum())\nprint()\n# Show some synonym-only docs\nsyn_only = df[~contains_car & contains_syn]\nfor _, row in syn_only.head(5).iterrows():\n    print(f\"id={row['id']}: {row['content']}\")\nprint()\n# Check if FTS index exists\nfor idx in table.list_indices():\n    print(idx)\nEOF\n"]
