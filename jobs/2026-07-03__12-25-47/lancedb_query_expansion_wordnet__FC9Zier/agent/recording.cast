[192.939279, "i", "python3 << 'EOF'\nimport os, sys\nsys.path.insert(0, '/home/user/myproject')\n# simulate verifier behaviour\nimport importlib.util\nspec = importlib.util.spec_from_file_location('solution', '/home/user/myproject/solution.py')\nm = importlib.util.module_from_spec(spec)\nspec.loader.exec_module(m)\n\n# Verify callable\nexpanded_search = m.expanded_search\nprint('expanded_search is callable:', callable(expanded_search))\n\n# Verify deterministic and recovers synonym docs\nr = expanded_search('car', 20)\nprint('Returned type:', type(r))\nprint('All int:', all(isinstance(x, int) for x in r))\nprint('Result:', r)\n\n# Sanity check: all 14 docs should be returned (6 car + 8 REDACTEDmobile)\nassert len(r) == 14, f'Expected 14 docs, got {len(r)}: {r}'\nprint('Total recovered: 14 ✓')\n\n# Make sure car docs are first (positions 0-5)\ncar_docs = {0, 1, 2, 3, 4, 5}\nfirst_six = set(r[:6])\nprint('First 6 docs:', sorted(first_six))\nassert first_six == car_docs, f'First 6 mismatch: {first_six}'\nprint('First 6 are exactly the car docs ✓')\n\n# The remaining should be REDACTEDmobile docs (6-13)\nremaining = set(r[6:])\nREDACTED_docs = set(range(6, 14))\nprint('Remaining 8 docs:', sorted(remaining))\nassert remaining == REDACTED_docs, f'Remaining mismatch: {remaining}'\nprint('Remaining 8 are exactly the REDACTEDmobile docs ✓')\n\nprint('\\\\nAll sanity checks passed.')\nEOF\n"]
