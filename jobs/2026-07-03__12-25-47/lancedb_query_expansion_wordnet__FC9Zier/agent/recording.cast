[68.091876, "i", "python3 -c \"\nfrom nltk.corpus import wordnet as wn\nfor w in ['car', 'vehicle', 'REDACTEDmobile', 'motorcar']:\n    syns = wn.synonyms(w)\n    flat = []\n    for g in syns:\n        for s in g:\n            s = s.lower()\n            if '_' not in s and ' ' not in s:\n                flat.append(s)\n    # remove the input itself for display\n    print(f'{w}: {flat[:5]}')\n\"\n"]
