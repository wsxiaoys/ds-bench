[180.304676, "i", "python3 -c \"\nimport os, re\nos.environ['LANCEDB_URI'] = '/app/lancedb_data'\nos.environ['LANCEDB_TABLE'] = 'docs'\nimport lancedb\ndb = lancedb.connect(os.environ['LANCEDB_URI'])\ntable = db.open_table(os.environ['LANCEDB_TABLE'])\ndf = table.to_pandas()\nprint('motorcar:', df['content'].str.contains(r'\\bmotorcar\\b', case=False, regex=True).sum())\nprint('REDACTEDmobile:', df['content'].str.contains(r'\\bREDACTEDmobile\\b', case=False, regex=True).sum())\nprint('car:', df['content'].str.contains(r'\\bcar\\b', case=False, regex=True).sum())\nprint('REDACTED:', df['content'].str.contains(r'\\bREDACTED\\b', case=False, regex=True).sum())\nprint('machine:', df['content'].str.contains(r'\\bmachine\\b', case=False, regex=True).sum())\nprint()\n# Show all unique content words from the data\nall_words = set()\nfor c in df['content']:\n    all_words.update(c.lower().split())\nprint('All words in corpus:')\nfor w in sorted(all_words):\n    print(' ', w)\n\"\n"]
