[80.299122, "o", "\"\"\"Bytewax stateful moving average pipeline.\"\"\"\r\n\r\nfrom collections import deque\r\nfrom pathlib import Path\r\nfrom typing import Optional, Tuple\r\n\r\nfrom bytewax.dataflow import Dataflow\r\nfrom bytewax import operators as op\r\nfrom bytewax.connectors.files import FileSource, FileSink\r\n\r\n# Ensure output file exists before running (FileSink requires this).\r\nOUTPUT_PATH = Path(\"output.csv\")\r\nOUTPUT_PATH.touch(exist_ok=True)\r\n\r\nflow = Dataflow(\"moving_average\")\r\n\r\n# Read sensor lines from input.csv.\r\ninp = op.input(\"inp\", flow, FileSource(\"input.csv\"))\r\n\r\n\r\ndef parse_line(line: str) -> Tuple[str, float]:\r\n    \"\"\"Parse a `sensor_id,temperature` line into a tuple.\"\"\"\r\n    sensor_id, temp_str = line.strip().split(\",\", 1)\r\n    return (sensor_id, float(temp_str))\r\n\r\n\r\n# Parse each line into a (sensor_id, temperature) tuple.\r\nparsed = op.map_value(\"parse\", inp, parse_line)\r\n\r\n# Key on sensor ID so each sensor's state is tracked independently.\r\nkeyed = op.key_on(\"key_on_sensor_id\", parsed, lambda x: x[0])\r\n\r\n\r\ndef moving_avg(state: Optional[deque], item: Tuple[str, float]) -> Tuple[deque, Tuple[str, float]]:\r\n    \"\"\"Stateful step that maintains the last 3 temperatures per sensor.\r\n\r\n    Returns a new state object (do not mutate in-place) for snapshot\r\n    compatibility.\r\n    \"\"\"\r\n    sensor_id, temp = item\r\n    if state is None:\r\n        state = deque(maxlen=3)\r\n    else:\r\n        # Create a new deque with the same elements to avoid in-place mutation.\r\n        state = deque(state, maxlen=3)\r\n    state.append(temp)\r\n    avg = sum(state) / len(state)\r\n"]
[80.299174, "o", "    return (state, (sensor_id, round(avg, 2)))\r\n\r\n\r\n# Maintain per-key state and compute moving average.\r\nstateful = op.stateful_map(\"moving_avg\", keyed, moving_avg)\r\n\r\n\r\ndef format_output(item: Tuple[str, float]) -> str:\r\n    \"\"\"Format output as `sensor_id,moving_average` with 2 decimal places.\"\"\"\r\n    sensor_id, avg = item\r\n    return f\"{sensor_id},{avg:.2f}\"\r\n\r\n\r\n# Format the output as a CSV line.\r\nformatted = op.map_value(\"format\", stateful, format_output)\r\n\r\n# Remove the key so we can write to a string-only sink.\r\nunkeyed = op.key_rm(\"remove_key\", formatted)\r\n\r\n# Output to file.\r\nop.output(\"output\", unkeyed, FileSink(\"output.csv\"))\r\n"]
