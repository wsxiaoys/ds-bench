[307.762167, "i", "cat client.ts\n"]
[307.762534, "o", "\u001b[?2004l\r\r\n"]
[307.764188, "o", "import { createTRPCProxyClient, httpBatchLink } from '@trpc/client';\r\nimport type { AppRouter } from './server';\r\nimport superjson from 'superjson';\r\n\r\nconst client = createTRPCProxyClient<AppRouter>({\r\n  links: [\r\n    httpBatchLink({\r\n      url: 'http://localhost:3000',\r\n      transformer: superjson,\r\n    }),\r\n  ],\r\n});\r\n\r\nasync function main() {\r\n  const result = await client.getTime.query();\r\n  console.log('Response:', result);\r\n}\r\n\r\nmain().catch(console.error);\r\n"]
[307.764504, "o", "\u001b[?2004hroot@6e323858-f25d-4bb5-8535-159736a322cc:/home/user/project# "]
