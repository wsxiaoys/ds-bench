[12.547668, "o", "cat package.json\r\n\u001b[?2004l\r"]
[12.549495, "o", "{\r\n  \"name\": \"trpc-v10-project\",\r\n  \"version\": \"1.0.0\",\r\n  \"scripts\": {\r\n    \"start:server\": \"ts-node server.ts\",\r\n    \"start:client\": \"ts-node client.ts\"\r\n  },\r\n  \"dependencies\": {\r\n    \"@trpc/server\": \"^10.45.0\",\r\n    \"@trpc/client\": \"^10.45.0\",\r\n    \"zod\": \"^3.22.4\",\r\n    \"superjson\": \"^2.2.1\",\r\n    \"express\": \"^4.18.2\",\r\n    \"cors\": \"^2.8.5\"\r\n  },\r\n  \"devDependencies\": {\r\n    \"typescript\": \"^5.3.3\",\r\n    \"ts-node\": \"^10.9.2\",\r\n    \"@types/express\": \"^4.17.21\",\r\n    \"@types/cors\": \"^2.8.17\"\r\n  }\r\n}\r\n"]
[12.549762, "o", "\u001b[?2004h"]
[12.549835, "o", "root@6e323858-f25d-4bb5-8535-159736a322cc:/home/user/project# "]
[13.492267, "i", "cat client.ts\n"]
[13.492536, "o", "cat client.ts\r\n\u001b[?2004l\r"]
[13.49466, "o", "import { createTRPCProxyClient, httpBatchLink } from '@trpc/client';\r\nimport type { AppRouter } from './server';\r\nimport superjson from 'superjson';\r\n\r\nconst client = createTRPCProxyClient<AppRouter>({\r\n  transformer: superjson,\r\n  links: [\r\n    httpBatchLink({\r\n      url: 'http://localhost:3000',\r\n    }),\r\n  ],\r\n});\r\n\r\nasync function main() {\r\n  const result = await client.getTime.query();\r\n  console.log('Response:', result);\r\n}\r\n\r\nmain().catch(console.error);\r\n"]
[13.495021, "o", "\u001b[?2004hroot@6e323858-f25d-4bb5-8535-159736a322cc:/home/user/project# "]
[14.611499, "i", "cat server.ts\n"]
[14.611762, "o", "cat server.ts\r\n\u001b[?2004l\r"]
[14.613261, "o", "import { initTRPC } from '@trpc/server';\r\nimport { createHTTPServer } from '@trpc/server/adapters/standalone';\r\nimport superjson from 'superjson';\r\nimport { z } from 'zod';\r\n\r\nconst t = initTRPC.create({\r\n  transformer: superjson,\r\n});\r\n\r\nconst appRouter = t.router({\r\n  getTime: t.procedure.query(() => {\r\n    return { status: 'success', time: new Date() };\r\n  }),\r\n});\r\n\r\nexport type AppRouter = typeof appRouter;\r\n\r\nconst server = createHTTPServer({\r\n  router: appRouter,\r\n});\r\n\r\nserver.listen(3000);\r\nconsole.log('Server running on port 3000');\r\n"]
[14.613492, "o", "\u001b[?2004h"]
