[323.158555, "i", "cat > convex/schema.ts << 'EOF'\nimport { defineSchema, defineTable } from \"convex/server\";\nimport { v } from \"convex/values\";\n\nexport default defineSchema({\n  accounts: defineTable({\n    name: v.string(),\n    balance: v.number(),\n  }).index(\"by_name\", [\"name\"]),\n});\nEOF\n"]
