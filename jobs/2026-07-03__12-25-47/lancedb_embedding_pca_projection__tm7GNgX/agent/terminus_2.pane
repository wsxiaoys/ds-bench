[?2004hroot@a14c8882-5670-418c-b96c-833ebbda8b50:/home/user/myproject# cat > /home/user/myproject/solution.py << 'EOF'
[?2004l[?2004h> """PCA-projected LanceDB vector search."""
[?2004l[?2004h> import os
[?2004l[?2004h> import numpy as np
[?2004l[?2004h> import lancedb
[?2004l[?2004h> 
[?2004l[?2004h> DB_DIR = '/home/user/myproject/lancedb/'
[?2004l[?2004h> MODEL_PATH = '/app/pca_model.npz'
[?2004l[?2004h> 
[?2004l[?2004h> _RUN_ID = None
[?2004l[?2004h> _TABLE_NAME = None
[?2004l[?2004h> _COMPONENTS = None
[?2004l[?2004h> _MEAN = None
[?2004l[?2004h> _TABLE = None
[?2004l[?2004h> 
[?2004l[?2004h> 
[?2004l[?2004h> def _ensure_loaded():
[?2004l[?2004h>     global _RUN_ID, _TABLE_NAME, _COMPONENTS, _MEAN, _TABLE
[?2004l[?2004h>     if _TABLE is not None:
[?2004l[?2004h>         return
[?2004l[?2004h>     with open('/logs/artifacts/run-id', 'r') as f:
[?2004l[?2004h>         _RUN_ID = f.read().strip()
[?2004l[?2004h>     _TABLE_NAME = f'articles_pca_{_RUN_ID}'
[?2004l[?2004h>     model = np.load(MODEL_PATH)
[?2004l[?2004h>     _COMPONENTS = model['components'].astype(np.float64)
[?2004l[?2004h>     _MEAN = model['mean'].astype(np.float64)
[?2004l[?2004h>     db = lancedb.connect(DB_DIR)
[?2004l[?2004h>     _TABLE = db[_TABLE_NAME]
[?2004l[?2004h> 
[?2004l[?2004h> 
[?2004l[?2004h> def _project(q: np.ndarray) -> np.ndarray:
[?2004l[?2004h>     """Project 128-d vector to 16-d using sklearn convention:
[?2004l[?2004h>     projected = (q - mean) @ components.T
[?2004l[?2004h>     """
[?2004l[?2004h>     q = np.asarray(q, dtype=np.float64).reshape(-1)
[?2004l[?2004h>     if q.shape[0] != _MEAN.shape[0]:
[?2004l[?2004h>         raise ValueError(
[?2004l[?2004h>             f'query_vec must be {_MEAN.shape[0]}-d, got {q.shape[0]}'
[?2004l[?2004h>         )
[?2004l[?2004h>     return ((q - _MEAN) @ _COMPONENTS.T).astype(np.float32)
[?2004l[?2004h> 
[?2004l[?2004h> 
[?2004l[?2004h> def search(query_vec, k):
[?2004l[?2004h>     """Search for the k nearest neighbours of `query_vec` in the PCA-projected table.
[?2004l[?2004h> 
[?2004l[?2004h>     Parameters
[?2004l[?2004h>     ----------
[?2004l[?2004h>     query_vec : sequence of 128 floats
[?2004l[?2004h>         Input vector in the original embedding space.
[?2004l[?2004h>     k : int
[?2004l[?2004h>         Number of neighbours to return.
[?2004l[?2004h> 
[?2004l[?2004h>     Returns
[?2004l[?2004h>     -------
[?2004l[?2004h>     list of dict
[?2004l[?2004h>         Each dict has keys ``id`` (int), ``title`` (str), ``original_id`` (int),
[?2004l[?2004h>         ordered from most to least similar.
[?2004l[?2004h>     """
[?2004l[?2004h>     _ensure_loaded()
[?2004l[?2004h>     proj = _project(query_vec)
[?2004l[?2004h>     results = _TABLE.search(proj.tolist()).limit(int(k)).to_list()
[?2004l[?2004h>     out = []
[?2004l[?2004h>     for r in results:
[?2004l[?2004h>         out.append({
[?2004l[?2004h>             'id': int(r['id']),
[?2004l[?2004h>             'title': str(r['title']),
[?2004l[?2004h>             'original_id': int(r['original_id']),
[?2004l[?2004h>         })
[?2004l[?2004h>     return out
[?2004l[?2004h> EOF
