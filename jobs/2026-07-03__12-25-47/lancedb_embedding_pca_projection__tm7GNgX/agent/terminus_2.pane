[?2004hroot@a14c8882-5670-418c-b96c-833ebbda8b50:/home/user/myproject# python3 -c "
[?2004l[?2004h> import numpy as np
[?2004l[?2004h> # Simulate verifier: load model, project a query, check it works
[?2004l[?2004h> d = np.load('/app/pca_model.npz')
[?2004l[?2004h> components = d['components']
[?2004l[?2004h> mean = d['mean']
[?2004l[?2004h> print('components shape:', components.shape, 'dtype:', components.dtype)
[?2004l[?2004h> print('mean shape:', mean.shape, 'dtype:', mean.dtype)
[?2004l[?2004h> 
[?2004l[?2004h> # Verify sklearn convention: sklearn stores components_ as (n_components, n_features)
[?2004l[?2004h> # and transform computes X @ components_.T - mean (broadcast)
[?2004l[?2004h> # Actually sklearn stores mean_ as the per-feature mean, and projects:
[?2004l[?2004h> # X_pca = (X - mean_) @ components_.T
[?2004l[?2004h> # Let's verify by reconstructing
