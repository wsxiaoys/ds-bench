[113.667803, "i", "python3 -c \"\nimport numpy as np\n# Simulate verifier: load model, project a query, check it works\nd = np.load('/app/pca_model.npz')\ncomponents = d['components']\nmean = d['mean']\nprint('components shape:', components.shape, 'dtype:', components.dtype)\nprint('mean shape:', mean.shape, 'dtype:', mean.dtype)\n\n# Verify sklearn convention: sklearn stores components_ as (n_components, n_features)\n# and transform computes X @ components_.T - mean (broadcast)\n# Actually sklearn stores mean_ as the per-feature mean, and projects:\n# X_pca = (X - mean_) @ components_.T\n# Let's verify by reconstructing\nimport lancedb\ndb = lancedb.connect('/home/user/myproject/lancedb/')\nsrc = db['articles'].to_pandas()\nX = np.stack([np.asarray(v, dtype=np.float64) for v in src['embedding'].values])\nprint('X shape:', X.shape)\nproj = (X - mean) @ components.T\nprint('proj shape:', proj.shape)\n\n# Check rows in new table match\ntbl = db['articles_pca_zr0037uzmb'].to_pandas()\nXnew = np.stack([np.asarray(v, dtype=np.float64) for v in tbl['embedding'].values])\nprint('new table X shape:', Xnew.shape)\ndiff = np.abs(proj - Xnew).max()\nprint('max diff:', diff)\nassert diff < 1e-3, 'PCA projection mismatch!'\nprint('OK: PCA projection matches')\n\"\n"]
