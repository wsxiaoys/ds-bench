[81.794965, "i", "cd /home/user/myproject && python3 -c \"\nimport solution\nimport lancedb\nimport numpy as np\nimport json\n\ndb = lancedb.connect('/home/user/myproject/lancedb/')\nsrc = db['articles']\ndf = src.to_pandas()\n\n# Test with id=0\nv0 = df['embedding'].iloc[0]\nprint('query first 5:', v0[:5])\n\nres = solution.search(v0.tolist(), 5)\nprint('search result type:', type(res))\nprint('len:', len(res))\nfor r in res:\n    print(r)\nprint('first result id should be 0:', res[0]['id'] == 0)\n\n# Test with id=42\nv42 = df['embedding'].iloc[42]\nres2 = solution.search(v42.tolist(), 3)\nprint('id=42 search top result:', res2[0]['id'], 'expected 42:', res2[0]['id'] == 42)\n\n# Test JSON serializable\nprint(json.dumps(res))\n\"\n"]
