[142.10214, "o", "{\r\n  \"invoice_a.pdf\": {\r\n    \"vendor_name\": \"Acme Office Supplies, Inc.\",\r\n    \"invoice_number\": \"INV-2024-00042\",\r\n    \"total_amount\": 1308.08,\r\n    \"line_items\": [\r\n      \"Ergonomic Office Chair - $245.00\",\r\n      \"Standing Desk (Adjustable) - $499.00\",\r\n      \"Wireless Keyboard and Mouse Combo - $89.50\",\r\n      \"27\\\" 4K Monitor - $389.00\"\r\n    ]\r\n  },\r\n  \"invoice_b.pdf\": {\r\n    \"vendor_name\": \"Bluewave Logistics LLC\",\r\n    \"invoice_number\": \"INV-2024-00777\",\r\n    \"total_amount\": 1632.18,\r\n    \"line_items\": [\r\n      \"Pallet Shipping (5 pallets) - $1,250.00\",\r\n      \"Customs Clearance Fee - $180.00\",\r\n      \"Cargo Insurance - $95.40\"\r\n    ]\r\n  },\r\n  \"invoice_c.pdf\": {\r\n    \"vendor_name\": \"Citrus Catering Co.\",\r\n    \"invoice_number\": \"INV-2024-01231\",\r\n    \"total_amount\": 1492.65,\r\n    \"line_items\": [\r\n      \"Corporate Lunch (50 guests) - $850.00\",\r\n      \"Beverage Station - $220.00\",\r\n      \"Dessert Platter - $145.00\",\r\n      \"Service Staff (2 servers, 3h) - $180.00\"\r\n    ]\r\n  }\r\n}"]
