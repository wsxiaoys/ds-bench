[146.768986, "o", "from llama_cloud import \u001b[01;31m\u001b[KAsyncLlamaCloud\u001b[m\u001b[K\r\n    client: \u001b[01;31m\u001b[KAsyncLlamaCloud\u001b[m\u001b[K,\r\n"]
[146.769049, "o", "    semaphore: asyncio.\u001b[01;31m\u001b[KSemaphore\u001b[m\u001b[K,\r\n"]
[146.769101, "o", "    \u001b[01;31m\u001b[Kexternal_file_id\u001b[m\u001b[K = f\"{filepath.stem}-{run_id}\"\r\n                \u001b[01;31m\u001b[Kexternal_file_id\u001b[m\u001b[K=\u001b[01;31m\u001b[Kexternal_file_id\u001b[m\u001b[K,\r\n"]
[146.769328, "o", "            \u001b[01;31m\u001b[Kfile_input\u001b[m\u001b[K=file_id,\r\n            \u001b[01;31m\u001b[Kconfiguration\u001b[m\u001b[K={\r\n                \"\u001b[01;31m\u001b[Kextraction_target\u001b[m\u001b[K\": \"per_doc\",\r\n                \"tier\": \"\u001b[01;31m\u001b[Kcost_effective\u001b[m\u001b[K\",\r\n                \"\u001b[01;31m\u001b[Kdata_schema\u001b[m\u001b[K\": InvoiceSchema.model_json_schema(),\r\n    client = \u001b[01;31m\u001b[KAsyncLlamaCloud\u001b[m\u001b[K(api_key=os.environ[\"LLAMA_CLOUD_API_KEY\"])\r\n    semaphore = asyncio.\u001b[01;31m\u001b[KSemaphore\u001b[m\u001b[K(3)\r\n"]
[146.769804, "o", "\u001b[?2004hroot@fc83f711-c5a7-4bc2-8d42-cbf3f0b65bee:/home/user/myproject# "]
