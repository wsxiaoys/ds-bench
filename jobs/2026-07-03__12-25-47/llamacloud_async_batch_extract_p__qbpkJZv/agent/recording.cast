[35.335166, "o", "                \"total_amount\": data.get(\"total_amount\") if isinstance(data, dict) else None,\r\n\u001b[?2004l\r\u001b[?2004h> "]
[35.335417, "o", "                \"line_items\": data.get(\"line_items\") if isinstance(data, dict) else [],\r\n\u001b[?2004l\r\u001b[?2004h> "]
[35.335481, "o", "            }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[35.335641, "o", "        else:\r\n\u001b[?2004l\r\u001b[?2004h>             record = {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[35.335749, "o", "                \"vendor_name\": None,\r\n\u001b[?2004l\r\u001b[?2004h> "]
[35.335926, "o", "                \"invoice_number\": None,\r\n\u001b[?2004l\r\u001b[?2004h"]
[35.336048, "o", ">                 \"total_amount\": None,\r\n\u001b[?2004l\r\u001b[?2004h> "]
[35.336104, "o", "                \"line_items\": [],\r\n\u001b[?2004l\r\u001b[?2004h> "]
[35.336221, "o", "            }\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[35.336323, "o", "        return filepath.name, record\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[35.336386, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[35.336499, "o", "async def main():\r\n\u001b[?2004l\r\u001b[?2004h> "]
[35.336586, "o", "    run_id = RUN_ID_PATH.read_text().strip()\r\n\u001b[?2004l\r\u001b[?2004h"]
[35.336641, "o", "> "]
[35.336812, "o", "    client = AsyncLlamaCloud(api_key=os.environ[\"LLAMA_CLOUD_API_KEY\"])\r\n\u001b[?2004l\r\u001b[?2004h> "]
[35.336939, "o", "    semaphore = asyncio.Semaphore(3)\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[35.337002, "o", "\u001b[?2004h> "]
[35.337116, "o", "    files = sorted(DATA_DIR.glob(\"invoice_*.pdf\"))\r\n\u001b[?2004l\r\u001b[?2004h> "]
[35.337321, "o", "    tasks = [process_file(client, semaphore, f, run_id) for f in files]\r\n\u001b[?2004l\r\u001b[?2004h> "]
[35.337465, "o", "    results_list = await asyncio.gather(*tasks)\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[35.337545, "o", "\u001b[?2004h> "]
[35.337676, "o", "    results = {name: rec for name, rec in results_list}\r\n\u001b[?2004l\r\u001b[?2004h> "]
[35.33792, "o", "    # If an existing results.json exists, merge - but spec says \"persist\", so we overwrite\r\n\u001b[?2004l\r\u001b[?2004h> "]
[35.338094, "o", "    RESULTS_PATH.write_text(json.dumps(results, indent=2))\r\n\u001b[?2004l\r\u001b[?2004h> "]
[35.33824, "o", "    print(f\"Wrote {RESULTS_PATH}\")\r\n\u001b[?2004l\r\u001b[?2004h> \r\n"]
[35.338298, "o", "\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[35.338405, "o", "if __name__ == \"__main__\":\r\n\u001b[?2004l\r\u001b[?2004h> "]
[35.338489, "o", "    asyncio.run(main())\r\n\u001b[?2004l\r\u001b[?2004h> "]
[35.338566, "o", "PYEOF\r\n\u001b[?2004l\r"]
[35.343756, "o", "\u001b[?2004hroot@fc83f711-c5a7-4bc2-8d42-cbf3f0b65bee:~# "]
