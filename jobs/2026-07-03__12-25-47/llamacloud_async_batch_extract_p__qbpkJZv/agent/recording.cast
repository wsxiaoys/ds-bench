[146.451841, "o", "cat /home/user/myproject/extract.py\r\n\u001b[?2004l\r"]
[146.454389, "o", "#!/usr/bin/env python3\r\n\"\"\"Async batch extraction with LlamaCloud v2 SDK.\"\"\"\r\nimport asyncio\r\nimport json\r\nimport os\r\nfrom pathlib import Path\r\nfrom typing import List, Optional\r\n\r\nfrom pydantic import BaseModel\r\nfrom llama_cloud import AsyncLlamaCloud\r\n\r\n\r\nclass LineItem(BaseModel):\r\n    description: str\r\n    quantity: Optional[float] = None\r\n    unit_price: Optional[float] = None\r\n    amount: Optional[float] = None\r\n\r\n\r\nclass InvoiceSchema(BaseModel):\r\n    vendor_name: str\r\n    invoice_number: str\r\n    total_amount: float\r\n    line_items: List[str]\r\n\r\n\r\nDATA_DIR = Path(\"/home/user/myproject/data\")\r\nRESULTS_PATH = Path(\"/home/user/myproject/results.json\")\r\n"]
[146.454512, "o", "LOG_PATH = Path(\"/home/user/myproject/output.log\")\r\nRUN_ID_PATH = Path(\"/logs/artifacts/run-id\")\r\n\r\n\r\nasync def process_file(\r\n    client: AsyncLlamaCloud,\r\n    semaphore: asyncio.Semaphore,\r\n    filepath: Path,\r\n    run_id: str,\r\n):\r\n    external_file_id = f\"{filepath.stem}-{run_id}\"\r\n    async with semaphore:\r\n        # Upload\r\n        with open(filepath, \"rb\") as f:\r\n            uploaded = await client.files.create(\r\n                file=f,\r\n                purpose=\"extract\",\r\n                external_file_id=external_file_id,\r\n            )\r\n\r\n        file_id = uploaded.id\r\n\r\n        # Create extract job\r\n"]
[146.454663, "o", "        job = await client.extract.create(\r\n            file_input=file_id,\r\n            configuration={\r\n                \"extraction_target\": \"per_doc\",\r\n                \"tier\": \"cost_effective\",\r\n                \"data_schema\": InvoiceSchema.model_json_schema(),\r\n            },\r\n        )\r\n\r\n        # Poll\r\n        while True:\r\n            job = await client.extract.get(job.id)\r\n            if job.status in (\"COMPLETED\", \"FAILED\", \"CANCELED\"):\r\n                break\r\n            await asyncio.sleep(2)\r\n\r\n        # Log line\r\n        with open(LOG_PATH, \"a\") as logf:\r\n            logf.write(f\"Extract Job: {filepath.name} {job.id} {job.status}\\n\")\r\n\r\n        record = {}\r\n        if job.status == \"COMPLETED\" and getattr(job, \"extract_result\", None) is not None:\r\n            er = job.extract_result\r\n            # try common shapes\r\n            if isinstance(er, dict):\r\n                data = er.get(\"data\", er)\r\n            else:\r\n                data = er\r\n            record = {\r\n                \"vendor_name\": data.get(\"vendor_name\") if isinstance(data, dict) else None,\r\n                \"invoice_number\": data.get(\"invoice_number\") if isinstance(data, dict) else None,\r\n                \"total_amount\": data.get(\"total_amount\") if isinstance(data, dict) else None,\r\n                \"line_items\": data.get(\"line_items\") if isinstance(data, dict) else [],\r\n            }\r\n        else:\r\n            record = {\r\n                \"vendor_name\": None,\r\n                \"invoice_number\": None,\r\n                \"total_amount\": None,\r\n                \"line_items\": [],\r\n            }\r\n\r\n        return filepath.name, record\r\n\r\n\r\nasync def main():\r\n    run_id = RUN_ID_PATH.read_text().strip()\r\n    client = AsyncLlamaCloud(api_key=os.environ[\"LLAMA_CLOUD_API_KEY\"])\r\n    semaphore = asyncio.Semaphore(3)\r\n\r\n    files = sorted(DATA_DIR.glob(\"invoice_*.pdf\"))\r\n    tasks = [process_file(client, semaphore, f, run_id) for f in files]\r\n    results_list = await asyncio.gather(*tasks)\r\n\r\n    results = {name: rec for name, rec in results_list}\r\n    # If an existing results.json exists, merge - but spec says \"persist\", so we overwrite\r\n    RESULTS_PATH.write_text(json.dumps(results, indent=2))\r\n    print(f\"Wrote {RESULTS_PATH}\")\r\n\r\n\r\nif __name__ == \"__main__\":\r\n    asyncio.run(main())\r\n"]
