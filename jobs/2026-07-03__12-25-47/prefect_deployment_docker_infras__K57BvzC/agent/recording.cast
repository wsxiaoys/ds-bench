[151.355789, "o", "\u001b[3m                                                                          Deployments                                                                           \u001b[0m\r\n┏━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━┳━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━┳━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━┓\r\n┃\u001b[1m \u001b[0m\u001b[1mName                                                         \u001b[0m\u001b[1m \u001b[0m┃\u001b[1m \u001b[0m\u001b[1mID                                                          \u001b[0m\u001b[1m \u001b[0m┃\u001b[1m \u001b[0m\u001b[1mWork Pool                    \u001b[0m\u001b[1m \u001b[0m┃\r\n┡━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━╇━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━╇━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━┩\r\n│\u001b[34m \u001b[0m\u001b[34mhello-docker-flow/\u001b[0m\u001b[1;34mdocker-deployment\u001b[0m\u001b[34m                          \u001b[0m\u001b[34m \u001b[0m│\u001b[36m \u001b[0m\u001b[36m3689fbfc-fa80-4cf9-a048-c954fd3c136c                        \u001b[0m\u001b[36m \u001b[0m│\u001b[32m \u001b[0m\u001b[32mmy-docker-pool               \u001b[0m\u001b[32m \u001b[0m│\r\n└───────────────────────────────────────────────────────────────┴──────────────────────────────────────────────────────────────┴───────────────────────────────┘\r\n"]
