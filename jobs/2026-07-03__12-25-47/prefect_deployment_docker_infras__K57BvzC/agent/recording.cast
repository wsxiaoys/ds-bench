[142.124305, "i", "n\n"]
[142.12443, "o", "n\r\n"]
[142.132724, "o", "\r\nTo execute flow runs from these deployments, start a worker in a separate terminal that pulls work from the 'my-docker-pool' work pool:\r\n"]
[142.132931, "o", "\r\n\u001b[34m        $ prefect worker start --pool 'my-docker-pool'\u001b[0m\r\n"]
[142.133039, "o", "\r\nTo schedule a run for this deployment, use the following command:\r\n"]
[142.133173, "o", "\r\n\u001b[34m        $ prefect deployment run 'hello-docker-flow/docker-deployment'\u001b[0m\r\n\r\n"]
