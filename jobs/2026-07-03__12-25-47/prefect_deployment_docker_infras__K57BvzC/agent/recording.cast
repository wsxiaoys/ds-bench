[129.485348, "o", "\u001b[32m╭──────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────╮\u001b[0m\r\n\u001b[32m│\u001b[0m\u001b[32m \u001b[0m\u001b[32mDeployment 'hello-docker-flow/docker-deployment' successfully created with id '3689fbfc-fa80-4cf9-a048-c954fd3c136c'.\u001b[0m\u001b[32m                                       \u001b[0m\u001b[32m \u001b[0m\u001b[32m│\u001b[0m\r\n\u001b[32m╰──────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────╯\u001b[0m\r\n"]
