[73.053542, "o", "prefect work-pool inspect my-docker-pool\r\n\u001b[?2004l\r"]
[73.915268, "o", "\u001b[1;35mWorkPool\u001b[0m\u001b[1m(\u001b[0m\r\n    \u001b[33mid\u001b[0m=\u001b[32m'deb20afa-ca19-436e-b658-54cb553f6891'\u001b[0m,\r\n    \u001b[33mcreated\u001b[0m=\u001b[1;35mDateTime\u001b[0m\u001b[1m(\u001b[0m\u001b[1;36m2026\u001b[0m, \u001b[1;36m7\u001b[0m, \u001b[1;36m3\u001b[0m, \u001b[1;36m14\u001b[0m, \u001b[1;36m44\u001b[0m, \u001b[1;36m39\u001b[0m, \u001b[1;36m37245\u001b[0m, \u001b[33mtzinfo\u001b[0m=\u001b[1;35mTimezone\u001b[0m\u001b[1m(\u001b[0m\u001b[32m'UTC'\u001b[0m\u001b[1m)\u001b[0m\u001b[1m)\u001b[0m,\r\n    \u001b[33mupdated\u001b[0m=\u001b[1;35mDateTime\u001b[0m\u001b[1m(\u001b[0m\u001b[1;36m2026\u001b[0m, \u001b[1;36m7\u001b[0m, \u001b[1;36m3\u001b[0m, \u001b[1;36m14\u001b[0m, \u001b[1;36m44\u001b[0m, \u001b[1;36m39\u001b[0m, \u001b[1;36m45000\u001b[0m, \u001b[33mtzinfo\u001b[0m=\u001b[1;35mTimezone\u001b[0m\u001b[1m(\u001b[0m\u001b[32m'UTC'\u001b[0m\u001b[1m)\u001b[0m\u001b[1m)\u001b[0m,\r\n    \u001b[33mname\u001b[0m=\u001b[32m'my-docker-pool'\u001b[0m,\r\n    \u001b[33mtype\u001b[0m=\u001b[32m'docker'\u001b[0m,\r\n    \u001b[33mbase_job_template\u001b[0m=\u001b[1m{\u001b[0m\r\n        \u001b[32m'job_configuration'\u001b[0m: \u001b[1m{\u001b[0m\r\n            \u001b[32m'command'\u001b[0m: \u001b[32m'\u001b[0m\u001b[32m{\u001b[0m\u001b[32m{\u001b[0m\u001b[32m command \u001b[0m\u001b[32m}\u001b[0m\u001b[32m}\u001b[0m\u001b[32m'\u001b[0m,\r\n            \u001b[32m'env'\u001b[0m: \u001b[32m'\u001b[0m\u001b[32m{\u001b[0m\u001b[32m{\u001b[0m\u001b[32m env \u001b[0m\u001b[32m}\u001b[0m\u001b[32m}\u001b[0m\u001b[32m'\u001b[0m,\r\n            \u001b[32m'labels'\u001b[0m: \u001b[32m'\u001b[0m\u001b[32m{\u001b[0m\u001b[32m{\u001b[0m\u001b[32m labels \u001b[0m\u001b[32m}\u001b[0m\u001b[32m}\u001b[0m\u001b[32m'\u001b[0m,\r\n            \u001b[32m'name'\u001b[0m: \u001b[32m'\u001b[0m\u001b[32m{\u001b[0m\u001b[32m{\u001b[0m\u001b[32m name \u001b[0m\u001b[32m}\u001b[0m\u001b[32m}\u001b[0m\u001b[32m'\u001b[0m,\r\n            \u001b[32m'image'\u001b[0m: \u001b[32m'\u001b[0m\u001b[32m{\u001b[0m\u001b[32m{\u001b[0m\u001b[32m image \u001b[0m\u001b[32m}\u001b[0m\u001b[32m}\u001b[0m\u001b[32m'\u001b[0m,\r\n            \u001b[32m'registry_credentials'\u001b[0m: \u001b[32m'\u001b[0m\u001b[32m{\u001b[0m\u001b[32m{\u001b[0m\u001b[32m registry_credentials \u001b[0m\u001b[32m}\u001b[0m\u001b[32m}\u001b[0m\u001b[32m'\u001b[0m,\r\n            \u001b[32m'image_pull_policy'\u001b[0m: \u001b[32m'\u001b[0m\u001b[32m{\u001b[0m\u001b[32m{\u001b[0m\u001b[32m image_pull_policy \u001b[0m\u001b[32m}\u001b[0m\u001b[32m}\u001b[0m\u001b[32m'\u001b[0m,\r\n            \u001b[32m'networks'\u001b[0m: \u001b[32m'\u001b[0m\u001b[32m{\u001b[0m\u001b[32m{\u001b[0m\u001b[32m networks \u001b[0m\u001b[32m}\u001b[0m\u001b[32m}\u001b[0m\u001b[32m'\u001b[0m,\r\n            \u001b[32m'network_mode'\u001b[0m: \u001b[32m'\u001b[0m\u001b[32m{\u001b[0m\u001b[32m{\u001b[0m\u001b[32m network_mode \u001b[0m\u001b[32m}\u001b[0m\u001b[32m}\u001b[0m\u001b[32m'\u001b[0m,\r\n            \u001b[32m'REDACTED_remove'\u001b[0m: \u001b[32m'\u001b[0m\u001b[32m{\u001b[0m\u001b[32m{\u001b[0m\u001b[32m REDACTED_remove \u001b[0m\u001b[32m}\u001b[0m\u001b[32m}\u001b[0m\u001b[32m'\u001b[0m,\r\n            \u001b[32m'volumes'\u001b[0m: \u001b[32m'\u001b[0m\u001b[32m{\u001b[0m\u001b[32m{\u001b[0m\u001b[32m volumes \u001b[0m\u001b[32m}\u001b[0m\u001b[32m}\u001b[0m\u001b[32m'\u001b[0m,\r\n            \u001b[32m'stream_output'\u001b[0m: \u001b[32m'\u001b[0m\u001b[32m{\u001b[0m\u001b[32m{\u001b[0m\u001b[32m stream_output \u001b[0m\u001b[32m}\u001b[0m\u001b[32m}\u001b[0m\u001b[32m'\u001b[0m,\r\n            \u001b[32m'mem_limit'\u001b[0m: \u001b[32m'\u001b[0m\u001b[32m{\u001b[0m\u001b[32m{\u001b[0m\u001b[32m mem_limit \u001b[0m\u001b[32m}\u001b[0m\u001b[32m}\u001b[0m\u001b[32m'\u001b[0m,\r\n            \u001b[32m'memswap_limit'\u001b[0m: \u001b[32m'\u001b[0m\u001b[32m{\u001b[0m\u001b[32m{\u001b[0m\u001b[32m memswap_limit \u001b[0m\u001b[32m}\u001b[0m\u001b[32m}\u001b[0m\u001b[32m'\u001b[0m,\r\n            \u001b[32m'privileged'\u001b[0m: \u001b[32m'\u001b[0m\u001b[32m{\u001b[0m\u001b[32m{\u001b[0m\u001b[32m privileged \u001b[0m\u001b[32m}\u001b[0m\u001b[32m}\u001b[0m\u001b[32m'\u001b[0m,\r\n            \u001b[32m'container_create_kwargs'\u001b[0m: \u001b[32m'\u001b[0m\u001b[32m{\u001b[0m\u001b[32m{\u001b[0m\u001b[32m container_create_kwargs \u001b[0m\u001b[32m}\u001b[0m\u001b[32m}\u001b[0m\u001b[32m'\u001b[0m\r\n        \u001b[1m}\u001b[0m,\r\n        \u001b[32m'variables'\u001b[0m: \u001b[1m{\u001b[0m\r\n            \u001b[32m'$defs'\u001b[0m: \u001b[1m{\u001b[0m\r\n                \u001b[32m'DockerRegistryCredentials'\u001b[0m: \u001b[1m{\u001b[0m\r\n                    \u001b[32m'additionalProperties'\u001b[0m: \u001b[3;92mTrue\u001b[0m,\r\n                    \u001b[32m'block_schema_references'\u001b[0m: \u001b[1m{\u001b[0m\u001b[1m}\u001b[0m,\r\n                    \u001b[32m'block_type_slug'\u001b[0m: \u001b[32m'docker-registry-credentials'\u001b[0m,\r\n                    \u001b[32m'description'\u001b[0m: \u001b[32m'Store credentials for interacting with a Docker Registry.'\u001b[0m,\r\n                    \u001b[32m'properties'\u001b[0m: \u001b[1m{\u001b[0m\r\n                        \u001b[32m'username'\u001b[0m: \u001b[1m{\u001b[0m\u001b[32m'description'\u001b[0m: \u001b[32m'The username to log into the registry with.'\u001b[0m, \u001b[32m'title'\u001b[0m: \u001b[32m'Username'\u001b[0m, \u001b[32m'type'\u001b[0m: \u001b[32m'string'\u001b[0m\u001b[1m}\u001b[0m,\r\n                        \u001b[32m'password'\u001b[0m: \u001b[1m{\u001b[0m\r\n                            \u001b[32m'description'\u001b[0m: \u001b[32m'The password to log into the registry with.'\u001b[0m,\r\n                            \u001b[32m'format'\u001b[0m: \u001b[32m'password'\u001b[0m,\r\n                            \u001b[32m'title'\u001b[0m: \u001b[32m'Password'\u001b[0m,\r\n                            \u001b[32m'type'\u001b[0m: \u001b[32m'string'\u001b[0m,\r\n                            \u001b[32m'writeOnly'\u001b[0m: \u001b[3;92mTrue\u001b[0m\r\n                        \u001b[1m}\u001b[0m,\r\n                        \u001b[32m'registry_url'\u001b[0m: \u001b[1m{\u001b[0m\r\n                            \u001b[32m'description'\u001b[0m: \u001b[32m'The URL to the registry. Generally, \"http\" or \"https\" can be omitted.'\u001b[0m,\r\n                            \u001b[32m'examples'\u001b[0m: \u001b[1m[\u001b[0m\u001b[32m'index.docker.io'\u001b[0m\u001b[1m]\u001b[0m,\r\n                            \u001b[32m'title'\u001b[0m: \u001b[32m'Registry Url'\u001b[0m,\r\n                            \u001b[32m'type'\u001b[0m: \u001b[32m'string'\u001b[0m\r\n                        \u001b[1m}\u001b[0m,\r\n                        \u001b[32m'reauth'\u001b[0m: \u001b[1m{\u001b[0m\r\n                            \u001b[32m'default'\u001b[0m: \u001b[3;92mTrue\u001b[0m,\r\n                            \u001b[32m'description'\u001b[0m: \u001b[32m'Whether or not to reauthenticate on each interaction.'\u001b[0m,\r\n                            \u001b[32m'title'\u001b[0m: \u001b[32m'Reauth'\u001b[0m,\r\n                            \u001b[32m'type'\u001b[0m: \u001b[32m'boolean'\u001b[0m\r\n                        \u001b[1m}\u001b[0m\r\n                    \u001b[1m}\u001b[0m,\r\n                    \u001b[32m'required'\u001b[0m: \u001b[1m[\u001b[0m\u001b[32m'username'\u001b[0m, \u001b[32m'password'\u001b[0m, \u001b[32m'registry_url'\u001b[0m\u001b[1m]\u001b[0m,\r\n                    \u001b[32m'secret_fields'\u001b[0m: \u001b[1m[\u001b[0m\u001b[32m'password'\u001b[0m\u001b[1m]\u001b[0m,\r\n                    \u001b[32m'title'\u001b[0m: \u001b[32m'DockerRegistryCredentials'\u001b[0m,\r\n                    \u001b[32m'type'\u001b[0m: \u001b[32m'object'\u001b[0m\r\n                \u001b[1m}\u001b[0m\r\n            \u001b[1m}\u001b[0m,\r\n            \u001b[32m'description'\u001b[0m: \u001b[32m\"Configuration class used by the Docker worker.\\n\\nAn instance of this class is passed to the Docker worker's `run` method\\nfor each \u001b[0m\r\n\u001b[32mflow run. It contains all the information necessary to execute the\\nflow run as a Docker container.\\n\\nAttributes:\\n    name: The name to give to created Docker\u001b[0m\r\n\u001b[32mcontainers.\\n    command: The command executed in created Docker containers to kick off\\n        flow run execution.\\n    env: The environment variables to set \u001b[0m\r\n\u001b[32min created Docker containers.\\n    labels: The labels to set on created Docker containers.\\n    image: The image reference of a container image to use for \u001b[0m\r\n\u001b[32mcreated jobs.\\n        If not set, the latest Prefect image will be used.\\n    image_pull_policy: The image pull policy to use when pulling images.\\n    \u001b[0m\r\n\u001b[32mnetworks: Docker networks that created containers should be connected to.\\n    network_mode: The network mode for the created containers \u001b[0m\u001b[32m(\u001b[0m\u001b[32me.g. host, bridge\u001b[0m\u001b[32m)\u001b[0m\u001b[32m.\\n \u001b[0m\r\n\u001b[32mIf 'networks' is set, this cannot be set.\\n    REDACTED_remove: If set, containers will be deleted on completion.\\n    volumes: Docker volumes that should be \u001b[0m\r\n\u001b[32mmounted in created containers.\\n    stream_output: If set, the output from created containers will be streamed\\n        to local standard output.\\n    \u001b[0m\r\n\u001b[32mmem_limit: Memory limit of created containers. Accepts a value\\n        with a unit identifier \u001b[0m\u001b[32m(\u001b[0m\u001b[32me.g. 100000b, 1000k, 128m, 1g.\u001b[0m\u001b[32m)\u001b[0m\u001b[32m If a value is\\n        given \u001b[0m\r\n\u001b[32mwithout a unit, bytes are assumed.\\n    memswap_limit: Total memory \u001b[0m\u001b[32m(\u001b[0m\u001b[32mmemory + swap\u001b[0m\u001b[32m)\u001b[0m\u001b[32m, -1 to disable swap. Should only be\\n        set if `mem_limit` is also set.\u001b[0m\r\n\u001b[32mIf `mem_limit` is set, this defaults to\\n        allowing the container to use as much swap as memory. For example, if\\n        `mem_limit` is 300m and \u001b[0m\r\n\u001b[32m`memswap_limit` is not set, containers can use\\n        600m in total of memory and swap.\\n    privileged: Give extended privileges to created containers.\\n    \u001b[0m\r\n\u001b[32mcontainer_create_kwargs: Extra args for docker py when creating container.\"\u001b[0m,\r\n            \u001b[32m'properties'\u001b[0m: \u001b[1m{\u001b[0m\r\n                \u001b[32m'command'\u001b[0m: \u001b[1m{\u001b[0m\r\n                    \u001b[32m'anyOf'\u001b[0m: \u001b[1m[\u001b[0m\u001b[1m{\u001b[0m\u001b[32m'type'\u001b[0m: \u001b[32m'string'\u001b[0m\u001b[1m}\u001b[0m, \u001b[1m{\u001b[0m\u001b[32m'type'\u001b[0m: \u001b[32m'null'\u001b[0m\u001b[1m}\u001b[0m\u001b[1m]\u001b[0m,\r\n                    \u001b[32m'default'\u001b[0m: \u001b[3;35mNone\u001b[0m,\r\n                    \u001b[32m'description'\u001b[0m: \u001b[32m'The command to use when starting a flow run. In most cases, this should be left blank and the command will be REDACTEDmatically \u001b[0m\r\n\u001b[32mgenerated by the worker.'\u001b[0m,\r\n                    \u001b[32m'title'\u001b[0m: \u001b[32m'Command'\u001b[0m\r\n                \u001b[1m}\u001b[0m,\r\n                \u001b[32m'env'\u001b[0m: \u001b[1m{\u001b[0m\r\n                    \u001b[32m'additionalProperties'\u001b[0m: \u001b[1m{\u001b[0m\u001b[32m'anyOf'\u001b[0m: \u001b[1m[\u001b[0m\u001b[1m{\u001b[0m\u001b[32m'type'\u001b[0m: \u001b[32m'string'\u001b[0m\u001b[1m}\u001b[0m, \u001b[1m{\u001b[0m\u001b[32m'type'\u001b[0m: \u001b[32m'null'\u001b[0m\u001b[1m}\u001b[0m\u001b[1m]\u001b[0m\u001b[1m}\u001b[0m,\r\n                    \u001b[32m'description'\u001b[0m: \u001b[32m'Environment variables to set when starting a flow run.'\u001b[0m,\r\n                    \u001b[32m'title'\u001b[0m: \u001b[32m'Environment Variables'\u001b[0m,\r\n                    \u001b[32m'type'\u001b[0m: \u001b[32m'object'\u001b[0m\r\n                \u001b[1m}\u001b[0m,\r\n                \u001b[32m'labels'\u001b[0m: \u001b[1m{\u001b[0m\r\n                    \u001b[32m'additionalProperties'\u001b[0m: \u001b[1m{\u001b[0m\u001b[32m'type'\u001b[0m: \u001b[32m'string'\u001b[0m\u001b[1m}\u001b[0m,\r\n                    \u001b[32m'description'\u001b[0m: \u001b[32m'Labels applied to infrastructure created by the worker using this job configuration.'\u001b[0m,\r\n                    \u001b[32m'title'\u001b[0m: \u001b[32m'Labels'\u001b[0m,\r\n                    \u001b[32m'type'\u001b[0m: \u001b[32m'object'\u001b[0m\r\n                \u001b[1m}\u001b[0m,\r\n                \u001b[32m'name'\u001b[0m: \u001b[1m{\u001b[0m\r\n                    \u001b[32m'anyOf'\u001b[0m: \u001b[1m[\u001b[0m\u001b[1m{\u001b[0m\u001b[32m'type'\u001b[0m: \u001b[32m'string'\u001b[0m\u001b[1m}\u001b[0m, \u001b[1m{\u001b[0m\u001b[32m'type'\u001b[0m: \u001b[32m'null'\u001b[0m\u001b[1m}\u001b[0m\u001b[1m]\u001b[0m,\r\n                    \u001b[32m'default'\u001b[0m: \u001b[3;35mNone\u001b[0m,\r\n                    \u001b[32m'description'\u001b[0m: \u001b[32m'Name given to infrastructure created by the worker using this job configuration. Supports templates using \u001b[0m\u001b[32m{\u001b[0m\u001b[32m{\u001b[0m\u001b[32m ctx.flow.* \u001b[0m\u001b[32m}\u001b[0m\u001b[32m}\u001b[0m\u001b[32m \u001b[0m\r\n\u001b[32mand \u001b[0m\u001b[32m{\u001b[0m\u001b[32m{\u001b[0m\u001b[32m ctx.flow_run.* \u001b[0m\u001b[32m}\u001b[0m\u001b[32m}\u001b[0m\u001b[32m when prepared for a flow run.'\u001b[0m,\r\n                    \u001b[32m'title'\u001b[0m: \u001b[32m'Name'\u001b[0m\r\n                \u001b[1m}\u001b[0m,\r\n                \u001b[32m'image'\u001b[0m: \u001b[1m{\u001b[0m\r\n                    \u001b[32m'description'\u001b[0m: \u001b[32m'The image reference of a container image to use for created jobs. If not set, the latest Prefect image will be used.'\u001b[0m,\r\n                    \u001b[32m'examples'\u001b[0m: \u001b[1m[\u001b[0m\u001b[32m'docker.io/prefecthq/prefect:3-latest'\u001b[0m\u001b[1m]\u001b[0m,\r\n                    \u001b[32m'title'\u001b[0m: \u001b[32m'Image'\u001b[0m,\r\n                    \u001b[32m'type'\u001b[0m: \u001b[32m'string'\u001b[0m\r\n                \u001b[1m}\u001b[0m,\r\n                \u001b[32m'registry_credentials'\u001b[0m: \u001b[1m{\u001b[0m\r\n                    \u001b[32m'anyOf'\u001b[0m: \u001b[1m[\u001b[0m\u001b[1m{\u001b[0m\u001b[32m'$ref'\u001b[0m: \u001b[32m'#/$defs/DockerRegistryCredentials'\u001b[0m\u001b[1m}\u001b[0m, \u001b[1m{\u001b[0m\u001b[32m'type'\u001b[0m: \u001b[32m'null'\u001b[0m\u001b[1m}\u001b[0m\u001b[1m]\u001b[0m,\r\n                    \u001b[32m'default'\u001b[0m: \u001b[3;35mNone\u001b[0m,\r\n                    \u001b[32m'description'\u001b[0m: \u001b[32m'Credentials for logging into a Docker registry to pull images from.'\u001b[0m\r\n                \u001b[1m}\u001b[0m,\r\n                \u001b[32m'image_pull_policy'\u001b[0m: \u001b[1m{\u001b[0m\r\n"]
[73.91539, "o", "                    \u001b[32m'anyOf'\u001b[0m: \u001b[1m[\u001b[0m\u001b[1m{\u001b[0m\u001b[32m'enum'\u001b[0m: \u001b[1m[\u001b[0m\u001b[32m'IfNotPresent'\u001b[0m, \u001b[32m'Always'\u001b[0m, \u001b[32m'Never'\u001b[0m\u001b[1m]\u001b[0m, \u001b[32m'type'\u001b[0m: \u001b[32m'string'\u001b[0m\u001b[1m}\u001b[0m, \u001b[1m{\u001b[0m\u001b[32m'type'\u001b[0m: \u001b[32m'null'\u001b[0m\u001b[1m}\u001b[0m\u001b[1m]\u001b[0m,\r\n                    \u001b[32m'default'\u001b[0m: \u001b[3;35mNone\u001b[0m,\r\n                    \u001b[32m'description'\u001b[0m: \u001b[32m'The image pull policy to use when pulling images.'\u001b[0m,\r\n                    \u001b[32m'title'\u001b[0m: \u001b[32m'Image Pull Policy'\u001b[0m\r\n                \u001b[1m}\u001b[0m,\r\n                \u001b[32m'networks'\u001b[0m: \u001b[1m{\u001b[0m\r\n                    \u001b[32m'description'\u001b[0m: \u001b[32m'Docker networks that created containers should be connected to.'\u001b[0m,\r\n                    \u001b[32m'items'\u001b[0m: \u001b[1m{\u001b[0m\u001b[32m'type'\u001b[0m: \u001b[32m'string'\u001b[0m\u001b[1m}\u001b[0m,\r\n                    \u001b[32m'title'\u001b[0m: \u001b[32m'Networks'\u001b[0m,\r\n                    \u001b[32m'type'\u001b[0m: \u001b[32m'array'\u001b[0m\r\n                \u001b[1m}\u001b[0m,\r\n                \u001b[32m'network_mode'\u001b[0m: \u001b[1m{\u001b[0m\r\n                    \u001b[32m'anyOf'\u001b[0m: \u001b[1m[\u001b[0m\u001b[1m{\u001b[0m\u001b[32m'type'\u001b[0m: \u001b[32m'string'\u001b[0m\u001b[1m}\u001b[0m, \u001b[1m{\u001b[0m\u001b[32m'type'\u001b[0m: \u001b[32m'null'\u001b[0m\u001b[1m}\u001b[0m\u001b[1m]\u001b[0m,\r\n                    \u001b[32m'default'\u001b[0m: \u001b[3;35mNone\u001b[0m,\r\n                    \u001b[32m'description'\u001b[0m: \u001b[32m\"The network mode for the created containers \u001b[0m\u001b[32m(\u001b[0m\u001b[32me.g. host, bridge\u001b[0m\u001b[32m)\u001b[0m\u001b[32m. If 'networks' is set, this cannot be set.\"\u001b[0m,\r\n                    \u001b[32m'title'\u001b[0m: \u001b[32m'Network Mode'\u001b[0m\r\n                \u001b[1m}\u001b[0m,\r\n                \u001b[32m'REDACTED_remove'\u001b[0m: \u001b[1m{\u001b[0m\r\n                    \u001b[32m'default'\u001b[0m: \u001b[3;91mFalse\u001b[0m,\r\n                    \u001b[32m'description'\u001b[0m: \u001b[32m'If set, containers will be deleted on completion.'\u001b[0m,\r\n                    \u001b[32m'title'\u001b[0m: \u001b[32m'Auto Remove'\u001b[0m,\r\n                    \u001b[32m'type'\u001b[0m: \u001b[32m'boolean'\u001b[0m\r\n                \u001b[1m}\u001b[0m,\r\n                \u001b[32m'volumes'\u001b[0m: \u001b[1m{\u001b[0m\r\n                    \u001b[32m'description'\u001b[0m: \u001b[32m'A list of volume to mount into created containers.'\u001b[0m,\r\n                    \u001b[32m'examples'\u001b[0m: \u001b[1m[\u001b[0m\u001b[32m'/my/local/path:/path/in/container'\u001b[0m\u001b[1m]\u001b[0m,\r\n                    \u001b[32m'items'\u001b[0m: \u001b[1m{\u001b[0m\u001b[32m'type'\u001b[0m: \u001b[32m'string'\u001b[0m\u001b[1m}\u001b[0m,\r\n                    \u001b[32m'title'\u001b[0m: \u001b[32m'Volumes'\u001b[0m,\r\n                    \u001b[32m'type'\u001b[0m: \u001b[32m'array'\u001b[0m\r\n                \u001b[1m}\u001b[0m,\r\n                \u001b[32m'stream_output'\u001b[0m: \u001b[1m{\u001b[0m\r\n                    \u001b[32m'default'\u001b[0m: \u001b[3;92mTrue\u001b[0m,\r\n                    \u001b[32m'description'\u001b[0m: \u001b[32m'If set, the output from created containers will be streamed to local standard output.'\u001b[0m,\r\n                    \u001b[32m'title'\u001b[0m: \u001b[32m'Stream Output'\u001b[0m,\r\n                    \u001b[32m'type'\u001b[0m: \u001b[32m'boolean'\u001b[0m\r\n                \u001b[1m}\u001b[0m,\r\n                \u001b[32m'mem_limit'\u001b[0m: \u001b[1m{\u001b[0m\r\n                    \u001b[32m'anyOf'\u001b[0m: \u001b[1m[\u001b[0m\u001b[1m{\u001b[0m\u001b[32m'type'\u001b[0m: \u001b[32m'string'\u001b[0m\u001b[1m}\u001b[0m, \u001b[1m{\u001b[0m\u001b[32m'type'\u001b[0m: \u001b[32m'null'\u001b[0m\u001b[1m}\u001b[0m\u001b[1m]\u001b[0m,\r\n                    \u001b[32m'default'\u001b[0m: \u001b[3;35mNone\u001b[0m,\r\n                    \u001b[32m'description'\u001b[0m: \u001b[32m'Memory limit of created containers. Accepts a value with a unit identifier \u001b[0m\u001b[32m(\u001b[0m\u001b[32me.g. 100000b, 1000k, 128m, 1g.\u001b[0m\u001b[32m)\u001b[0m\u001b[32m If a value is \u001b[0m\r\n\u001b[32mgiven without a unit, bytes are assumed.'\u001b[0m,\r\n                    \u001b[32m'title'\u001b[0m: \u001b[32m'Memory Limit'\u001b[0m\r\n                \u001b[1m}\u001b[0m,\r\n                \u001b[32m'memswap_limit'\u001b[0m: \u001b[1m{\u001b[0m\r\n                    \u001b[32m'anyOf'\u001b[0m: \u001b[1m[\u001b[0m\u001b[1m{\u001b[0m\u001b[32m'type'\u001b[0m: \u001b[32m'string'\u001b[0m\u001b[1m}\u001b[0m, \u001b[1m{\u001b[0m\u001b[32m'type'\u001b[0m: \u001b[32m'null'\u001b[0m\u001b[1m}\u001b[0m\u001b[1m]\u001b[0m,\r\n                    \u001b[32m'default'\u001b[0m: \u001b[3;35mNone\u001b[0m,\r\n                    \u001b[32m'description'\u001b[0m: \u001b[32m'Total memory \u001b[0m\u001b[32m(\u001b[0m\u001b[32mmemory + swap\u001b[0m\u001b[32m)\u001b[0m\u001b[32m, -1 to disable swap. Should only be set if `mem_limit` is also set. If `mem_limit` is set, this\u001b[0m\r\n\u001b[32mdefaults toallowing the container to use as much swap as memory. For example, if `mem_limit` is 300m and `memswap_limit` is not set, containers can use 600m in \u001b[0m\r\n\u001b[32mtotal of memory and swap.'\u001b[0m,\r\n             "]
[73.915442, "o", "       \u001b[32m'title'\u001b[0m: \u001b[32m'Memory Swap Limit'\u001b[0m\r\n                \u001b[1m}\u001b[0m,\r\n                \u001b[32m'privileged'\u001b[0m: \u001b[1m{\u001b[0m\u001b[32m'default'\u001b[0m: \u001b[3;91mFalse\u001b[0m, \u001b[32m'description'\u001b[0m: \u001b[32m'Give extended privileges to created container.'\u001b[0m, \u001b[32m'title'\u001b[0m: \u001b[32m'Privileged'\u001b[0m, \u001b[32m'type'\u001b[0m: \u001b[32m'boolean'\u001b[0m\u001b[1m}\u001b[0m,\r\n                \u001b[32m'container_create_kwargs'\u001b[0m: \u001b[1m{\u001b[0m\r\n                    \u001b[32m'anyOf'\u001b[0m: \u001b[1m[\u001b[0m\u001b[1m{\u001b[0m\u001b[32m'additionalProperties'\u001b[0m: \u001b[3;92mTrue\u001b[0m, \u001b[32m'type'\u001b[0m: \u001b[32m'object'\u001b[0m\u001b[1m}\u001b[0m, \u001b[1m{\u001b[0m\u001b[32m'type'\u001b[0m: \u001b[32m'null'\u001b[0m\u001b[1m}\u001b[0m\u001b[1m]\u001b[0m,\r\n                    \u001b[32m'default'\u001b[0m: \u001b[3;35mNone\u001b[0m,\r\n                    \u001b[32m'description'\u001b[0m: \u001b[32m'Configuration for containers created by workers. See the \u001b[0m\u001b[32m[\u001b[0m\u001b[32m`docker-py` \u001b[0m\r\n\u001b[32mdocumentation\u001b[0m\u001b[32m]\u001b[0m\u001b[32m(\u001b[0m\u001b[32mhttps://docker-py.readthedocs.io/en/stable/containers.html\u001b[0m\u001b[32m)\u001b[0m\u001b[32m for accepted values.'\u001b[0m,\r\n                    \u001b[32m'title'\u001b[0m: \u001b[32m'Container Configuration'\u001b[0m\r\n                \u001b[1m}\u001b[0m\r\n            \u001b[1m}\u001b[0m,\r\n            \u001b[32m'type'\u001b[0m: \u001b[32m'object'\u001b[0m\r\n        \u001b[1m}\u001b[0m\r\n    \u001b[1m}\u001b[0m,\r\n    \u001b[33mstatus\u001b[0m=\u001b[35mWorkPoolStatus\u001b[0m.NOT_READY,\r\n    \u001b[33mstorage_configuration\u001b[0m=\u001b[1;35mWorkPoolStorageConfiguration\u001b[0m\u001b[1m(\u001b[0m\u001b[1m)\u001b[0m,\r\n    \u001b[33mdefault_queue_id\u001b[0m=\u001b[32m'a61d3521-869b-4b2d-967c-e9e9da19e410'\u001b[0m\r\n\u001b[1m)\u001b[0m\r\n"]
