db/index.d.ts\",\r\n      \"default\": \"./dist/runtime/lib/db/index.js\"\r\n    },\r\n    \"./debug\": {\r\n      \"types\": \"./dist/runtime/lib/debug.d.ts\",\r\n      \"default\": \"./dis"]
