[118.991593, "o", "  expiresAt: number;\r\n\u001b[?2004l\r\u001b[?2004h> }\r\n"]
[118.99165, "o", "\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[118.991707, "o", "\u001b[?2004h> "]
[118.991934, "o", "function generateSessionId(): string {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[118.992156, "o", "  const bytes = new Uint8Array(16);\r\n\u001b[?2004l\r\u001b[?2004h"]
[118.992208, "o", "> "]
[118.992373, "o", "  crypto.getRandomValues(bytes);\r\n\u001b[?2004l\r\u001b[?2004h"]
[118.992427, "o", "> "]
[118.992545, "o", "  let hex = \"\";\r\n\u001b[?2004l\r\u001b[?2004h> "]
[118.992775, "o", "  for (let i = 0; i < bytes.length; i++) {\r\n\u001b[?2004l\r\u001b[?2004h"]
[118.992829, "o", "> "]
[118.993101, "o", "    hex += bytes[i].toString(16).padStart(2, \"0\");\r\n\u001b[?2004l\r\u001b[?2004h"]
[118.993158, "o", ">   }\r\n\u001b[?2004l\r\u001b[?2004h"]
[118.993212, "o", "> "]
[118.993263, "o", "  return hex;\r\n\u001b[?2004l\r"]
[118.993434, "o", "\u001b[?2004h> }\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[118.993799, "o", "function parseCookies(header: string | null): Record<string, string> {\r\n\u001b[?2004l\r\u001b[?2004h"]
[118.993852, "o", "> "]
[118.9941, "o", "  const cookies: Record<string, string> = {};\r\n\u001b[?2004l\r\u001b[?2004h"]
[118.994153, "o", "> "]
[118.994305, "o", "  if (!header) return cookies;\r\n\u001b[?2004l\r\u001b[?2004h"]
[118.994359, "o", "> "]
[118.994604, "o", "  for (const part of header.split(\";\")) {\r\n\u001b[?2004l\r\u001b[?2004h"]
[118.994709, "o", "> "]
[118.994828, "o", "    const trimmed = part.trim();\r\n\u001b[?2004l\r\u001b[?2004h"]
[118.994902, "o", "> "]
[118.99504, "o", "    if (!trimmed) continue;\r\n\u001b[?2004l\r\u001b[?2004h"]
[118.995097, "o", "> "]
[118.99528, "o", "    const eq = trimmed.indexOf(\"=\");\r\n\u001b[?2004l\r\u001b[?2004h"]
[118.995339, "o", "> "]
[118.995473, "o", "    if (eq === -1) continue;\r\n\u001b[?2004l\r\u001b[?2004h"]
[118.995567, "o", "> "]
[118.99572, "o", "    const key = trimmed.slice(0, eq);\r\n\u001b[?2004l\r"]
[118.995816, "o", "\u001b[?2004h> "]
[118.995969, "o", "    const value = trimmed.slice(eq + 1);\r\n\u001b[?2004l\r\u001b[?2004h"]
[118.996021, "o", "> "]
[118.996144, "o", "    cookies[key] = value;\r\n\u001b[?2004l\r\u001b[?2004h> "]
[118.996198, "o", "  }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[118.996301, "o", "  return cookies;\r\n\u001b[?2004l\r\u001b[?2004h"]
[118.996358, "o", "> }\r\n\u001b[?2004l\r\u001b[?2004h"]
[118.996495, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[118.996762, "o", "function jsonResponse(body: unknown, init: ResponseInit = {}): Response {\r\n\u001b[?2004l\r\u001b[?2004h"]
[118.996815, "o", "> "]
[118.99701, "o", "  const headers = new Headers(init.headers);\r\n\u001b[?2004l\r\u001b[?2004h"]
[118.997064, "o", "> "]
[118.997279, "o", "  headers.set(\"Content-Type\", \"application/json\");\r\n\u001b[?2004l\r\u001b[?2004h"]
[118.997332, "o", "> "]
[118.997523, "o", "  return new Response(JSON.stringify(body), {\r\n\u001b[?2004l\r\u001b[?2004h"]
[118.997577, "o", "> "]
[118.997627, "o", "    ...init,\r\n\u001b[?2004l\r\u001b[?2004h> "]
[118.997719, "o", "    headers,\r\n\u001b[?2004l\r\u001b[?2004h"]
[118.997772, "o", ">   });\r\n\u001b[?2004l\r"]
[118.997833, "o", "\u001b[?2004h> }\r\n\u001b[?2004l\r\u001b[?2004h"]
[118.997902, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[118.998179, "o", "function getSidCookie(request: Request): string | null {\r\n\u001b[?2004l\r\u001b[?2004h"]
[118.998235, "o", "> "]
[118.998455, "o", "  const cookieHeader = request.headers.get(\"Cookie\");\r\n\u001b[?2004l\r\u001b[?2004h"]
[118.99851, "o", "> "]
[118.998694, "o", "  const cookies = parseCookies(cookieHeader);\r\n\u001b[?2004l\r\u001b[?2004h"]
[118.998749, "o", "> "]
[118.998873, "o", "  const sid = cookies[\"sid\"];\r\n\u001b[?2004l\r\u001b[?2004h"]
[118.998931, "o", "> "]
[118.999032, "o", "  if (!sid) return null;\r\n\u001b[?2004l\r\u001b[?2004h"]
[118.999086, "o", "> "]
[118.999246, "o", "  // 32-character lowercase hex string\r\n\u001b[?2004l\r\u001b[?2004h"]
[118.999301, "o", "> "]
[118.999499, "o", "  if (!/^[0-9a-f]{32}$/.test(sid)) return null;\r\n\u001b[?2004l\r\u001b[?2004h"]
[118.999553, "o", "> "]
[118.999604, "o", "  return sid;\r\n\u001b[?2004l\r\u001b[?2004h"]
[118.999655, "o", "> }\r\n\u001b[?2004l\r\u001b[?2004h"]
[118.999706, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[119.000035, "o", "async function handlePost(request: Request): Promise<Response> {\r\n\u001b[?2004l\r\u001b[?2004h"]
[119.00009, "o", "> "]
[119.000221, "o", "  let body: { userId?: unknown };\r\n\u001b[?2004l\r\u001b[?2004h"]
[119.000275, "o", ">   try {\r\n\u001b[?2004l\r"]
[119.000325, "o", "\u001b[?2004h> "]
[119.000602, "o", "    body = (await request.json()) as { userId?: unknown };\r\n\u001b[?2004l\r\u001b[?2004h"]
[119.000658, "o", ">   } catch {\r\n"]
[119.000707, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[119.001047, "o", "    return jsonResponse({ error: \"Invalid JSON\" }, { status: 400 });\r\n\u001b[?2004l\r\u001b[?2004h"]
[119.001104, "o", ">   }\r\n\u001b[?2004l\r\u001b[?2004h"]
[119.001153, "o", "> "]
[119.001446, "o", "  if (typeof body.userId !== \"string\" || body.userId.length === 0) {\r\n\u001b[?2004l\r\u001b[?2004h"]
[119.001501, "o", "> "]
[119.001884, "o", "    return jsonResponse({ error: \"userId must be a non-empty string\" }, { status: 400 });\r\n\u001b[?2004l\r\u001b[?2004h"]
[119.001941, "o", ">   }\r\n\u001b[?2004l\r\u001b[?2004h"]
[119.00199, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[119.002224, "o", "  const sessionId = generateSessionId();\r\n\u001b[?2004l\r\u001b[?2004h> "]
[119.002427, "o", "  const now = Math.floor(Date.now() / 1000);\r\n\u001b[?2004l\r"]
[119.00247, "o", "\u001b[?2004h> "]
[119.00267, "o", "  const expiresAt = now + SESSION_TTL_SECONDS;\r\n\u001b[?2004l\r"]
[119.002709, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[119.002747, "o", "\u001b[?2004h> "]
[119.002918, "o", "  const record: SessionRecord = {\r\n\u001b[?2004l\r\u001b[?2004h"]
[119.002959, "o", "> "]
[119.003063, "o", "    userId: body.userId,\r\n\u001b[?2004l\r"]
[119.003126, "o", "\u001b[?2004h> "]
[119.003204, "o", "    createdAt: now,\r\n\u001b[?2004l\r"]
[119.003262, "o", "\u001b[?2004h> "]
[119.003328, "o", "    expiresAt,\r\n\u001b[?2004l\r"]
[119.003387, "o", "\u001b[?2004h>   };\r\n\u001b[?2004l\r"]
[119.003448, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[119.003506, "o", "> "]
[119.00361, "o", "  await env.SESSIONS.put(\r\n\u001b[?2004l\r"]
[119.003668, "o", "\u001b[?2004h> "]
[119.003846, "o", "    `${SESSION_KEY_PREFIX}${sessionId}`,\r\n\u001b[?2004l\r"]
[119.00391, "o", "\u001b[?2004h> "]
[119.004033, "o", "    JSON.stringify(record),\r\n\u001b[?2004l\r"]
[119.004092, "o", "\u001b[?2004h> "]
[119.004287, "o", "    { expirationTtl: SESSION_TTL_SECONDS },\r\n\u001b[?2004l\r"]
[119.004345, "o", "\u001b[?2004h>   );\r\n\u001b[?2004l\r"]
[119.004406, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[119.004466, "o", "\u001b[?2004h> "]
[119.004606, "o", "  const headers = new Headers();\r\n\u001b[?2004l\r"]
[119.004667, "o", "\u001b[?2004h> "]
[119.004925, "o", "  headers.set(\"Content-Type\", \"application/json\");\r\n\u001b[?2004l\r\u001b[?2004h> "]
[119.005009, "o", "  headers.set(\r\n\u001b[?2004l\r"]
[119.005071, "o", "\u001b[?2004h> "]
[119.005141, "o", "    \"Set-Cookie\",\r\n\u001b[?2004l\r"]
[119.005201, "o", "\u001b[?2004h> "]
[119.005536, "o", "    `sid=${sessionId}; HttpOnly; Path=/; Max-Age=${SESSION_TTL_SECONDS}`,\r\n\u001b[?2004l\r"]
[119.005598, "o", "\u001b[?2004h>   );\r\n\u001b[?2004l\r"]
[119.005657, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[119.005718, "o", "\u001b[?2004h> "]
[119.005813, "o", "  return new Response(\r\n\u001b[?2004l\r"]
[119.005853, "o", "\u001b[?2004h> "]
[119.006088, "o", "    JSON.stringify({ sessionId, expiresAt }),\r\n\u001b[?2004l\r"]
[119.006151, "o", "\u001b[?2004h> "]
[119.006271, "o", "    { status: 201, headers },\r\n\u001b[?2004l\r"]
[119.006331, "o", "\u001b[?2004h>   );\r\n\u001b[?2004l\r"]
[119.006389, "o", "\u001b[?2004h> }\r\n\u001b[?2004l\r"]
[119.00645, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[119.006508, "o", "> "]
[119.006798, "o", "async function handleGetMe(request: Request): Promise<Response> {\r\n\u001b[?2004l\r"]
[119.006892, "o", "\u001b[?2004h> "]
[119.007059, "o", "  const sid = getSidCookie(request);\r\n\u001b[?2004l\r"]
[119.007121, "o", "\u001b[?2004h> "]
[119.007185, "o", "  if (!sid) {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[119.007539, "o", "    return jsonResponse({ error: \"Unauthorized\" }, { status: 401 });\r\n\u001b[?2004l\r"]
[119.0076, "o", "\u001b[?2004h>   }\r\n\u001b[?2004l\r"]
[119.007658, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[119.007698, "o", "> "]
[119.008029, "o", "  const raw = await env.SESSIONS.get(`${SESSION_KEY_PREFIX}${sid}`);\r\n\u001b[?2004l\r"]
[119.008069, "o", "\u001b[?2004h> "]
[119.008144, "o", "  if (!raw) {\r\n\u001b[?2004l\r"]
[119.008205, "o", "\u001b[?2004h> "]
[119.008516, "o", "    return jsonResponse({ error: \"Unauthorized\" }, { status: 401 });\r\n\u001b[?2004l\r"]
[119.008557, "o", "\u001b[?2004h>   }\r\n"]
[119.008594, "o", "\u001b[?2004l\r\u001b[?2004h"]
[119.008632, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h"]
[119.008669, "o", "> "]
[119.008814, "o", "  let record: SessionRecord;\r\n\u001b[?2004l\r"]
[119.008879, "o", "\u001b[?2004h>   try {\r\n"]
[119.008941, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[119.009168, "o", "    record = JSON.parse(raw) as SessionRecord;\r\n\u001b[?2004l\r"]
[119.009208, "o", "\u001b[?2004h> "]
[119.009276, "o", "  } catch {\r\n\u001b[?2004l\r"]
[119.009314, "o", "\u001b[?2004h> "]
[119.009644, "o", "    return jsonResponse({ error: \"Unauthorized\" }, { status: 401 });\r\n\u001b[?2004l\r"]
[119.009705, "o", "\u001b[?2004h>   }\r\n\u001b[?2004l\r"]
[119.009765, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[119.009826, "o", "> "]
[119.009919, "o", "  return jsonResponse({\r\n\u001b[?2004l\r"]
[119.009959, "o", "\u001b[?2004h> "]
[119.010095, "o", "    userId: record.userId,\r\n\u001b[?2004l\r"]
[119.010135, "o", "\u001b[?2004h> "]
[119.010298, "o", "    createdAt: record.createdAt,\r\n\u001b[?2004l\r"]
[119.010338, "o", "\u001b[?2004h> "]
[119.010498, "o", "    expiresAt: record.expiresAt,\r\n\u001b[?2004l\r"]
[119.01056, "o", "\u001b[?2004h>   });\r\n\u001b[?2004l\r"]
[119.010619, "o", "\u001b[?2004h> }\r\n\u001b[?2004l\r"]
[119.010681, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[119.01074, "o", "> "]
[119.011055, "o", "async function handleDeleteMe(request: Request): Promise<Response> {\r\n\u001b[?2004l\r"]
[119.011114, "o", "\u001b[?2004h> "]
[119.011274, "o", "  const sid = getSidCookie(request);\r\n\u001b[?2004l\r"]
[119.011334, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[119.011396, "o", "> "]
[119.011454, "o", "  if (sid) {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[119.011764, "o", "    await env.SESSIONS.delete(`${SESSION_KEY_PREFIX}${sid}`);\r\n\u001b[?2004l\r"]
[119.011821, "o", "\u001b[?2004h>   }\r\n\u001b[?2004l\r"]
[119.011892, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[119.011953, "o", "> "]
[119.01208, "o", "  const headers = new Headers();\r\n\u001b[?2004l\r"]
[119.012138, "o", "\u001b[?2004h> "]
[119.01244, "o", "  headers.set(\"Set-Cookie\", \"sid=; HttpOnly; Path=/; Max-Age=0\");\r\n\u001b[?2004l\r"]
[119.0125, "o", "\u001b[?2004h> "]
[119.012746, "o", "  return new Response(null, { status: 204, headers });\r\n\u001b[?2004l\r"]
[119.012806, "o", "\u001b[?2004h> }\r\n\u001b[?2004l\r"]
[119.012875, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[119.012935, "o", "> "]
[119.013154, "o", "async function handleGetCount(): Promise<Response> {\r\n\u001b[?2004l\r"]
[119.013215, "o", "\u001b[?2004h> "]
[119.013281, "o", "  let count = 0;\r\n\u001b[?2004l\r"]
[119.01334, "o", "\u001b[?2004h> "]
[119.013545, "o", "  let cursor: string | undefined = undefined;\r\n\u001b[?2004l\r"]
[119.013604, "o", "\u001b[?2004h> "]
[119.013673, "o", "  while (true) {\r\n\u001b[?2004l\r"]
[119.013731, "o", "\u001b[?2004h> "]
[119.014117, "o", "    const page = await env.SESSIONS.list({ prefix: SESSION_KEY_PREFIX, cursor });\r\n\u001b[?2004l\r"]
[119.014177, "o", "\u001b[?2004h> "]
[119.014311, "o", "    count += page.keys.length;\r\n\u001b[?2004l\r"]
[119.01437, "o", "\u001b[?2004h> "]
[119.0145, "o", "    if (page.list_complete) {\r\n\u001b[?2004l\r"]
[119.014559, "o", "\u001b[?2004h> "]
[119.01462, "o", "      break;\r\n\u001b[?2004l\r\u001b[?2004h"]
[119.014678, "o", ">     }\r\n\u001b[?2004l\r"]
[119.014738, "o", "\u001b[?2004h> "]
[119.014849, "o", "    cursor = page.cursor;\r\n\u001b[?2004l\r"]
[119.014894, "o", "\u001b[?2004h> "]
[119.015018, "o", "    if (!cursor) break;\r\n\u001b[?2004l\r"]
[119.015079, "o", "\u001b[?2004h>   }\r\n\u001b[?2004l\r"]
[119.015139, "o", "\u001b[?2004h> "]
[119.01529, "o", "  return jsonResponse({ count });\r\n\u001b[?2004l\r"]
[119.015348, "o", "\u001b[?2004h> }\r\n\u001b[?2004l\r\u001b[?2004h"]
[119.015389, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h"]
[119.015427, "o", "> "]
[119.015773, "o", "async function sessionsHandler(request: Request): Promise<Response> {\r\n\u001b[?2004l\r"]
[119.015833, "o", "\u001b[?2004h> "]
[119.015994, "o", "  const url = new URL(request.url);\r\n\u001b[?2004l\r"]
[119.016055, "o", "\u001b[?2004h> "]
[119.016313, "o", "  const path = url.pathname.replace(/\\\\/+$/, \"\") || \"/\";\r\n\u001b[?2004l\r"]
[119.016378, "o", "\u001b[?2004h> "]
[119.016582, "o", "  const method = request.method.toUpperCase();\r\n\u001b[?2004l\r"]
[119.016641, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[119.016702, "o", "> "]
[119.016833, "o", "  if (path === \"/api/sessions\") {\r\n\u001b[?2004l\r"]
[119.016898, "o", "\u001b[?2004h> "]
[119.017145, "o", "    if (method === \"POST\") return handlePost(request);\r\n\u001b[?2004l\r"]
[119.017206, "o", "\u001b[?2004h> "]
[119.017492, "o", "    return new Response(\"Method Not Allowed\", { status: 405 });\r\n\u001b[?2004l\r"]
[119.017532, "o", "\u001b[?2004h>   }\r\n"]
[119.01757, "o", "\u001b[?2004l\r\u001b[?2004h"]
[119.017607, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h"]
[119.017644, "o", "> "]
[119.01783, "o", "  if (path === \"/api/sessions/me\") {\r\n\u001b[?2004l\r"]
[119.017899, "o", "\u001b[?2004h> "]
[119.018139, "o", "    if (method === \"GET\") return handleGetMe(request);\r\n\u001b[?2004l\r"]
[119.018197, "o", "\u001b[?2004h> "]
[119.018477, "o", "    if (method === \"DELETE\") return handleDeleteMe(request);\r\n\u001b[?2004l\r"]
[119.018535, "o", "\u001b[?2004h> "]
[119.018823, "o", "    return new Response(\"Method Not Allowed\", { status: 405 });\r\n\u001b[?2004l\r"]
[119.018977, "o", "\u001b[?2004h>   }\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[119.019178, "o", "  if (path === \"/api/sessions/count\") {\r\n\u001b[?2004l\r"]
[119.019237, "o", "\u001b[?2004h> "]
[119.019483, "o", "    if (method === \"GET\") return handleGetCount();\r\n\u001b[?2004l\r"]
