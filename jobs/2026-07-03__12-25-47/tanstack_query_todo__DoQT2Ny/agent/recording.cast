[111.972419, "o", "  const mutation = useMutation({\r\n\u001b[?2004l\r\u001b[?2004h> "]
[111.972679, "o", "    mutationFn: createTodo,\r\n\u001b[?2004l\r\u001b[?2004h> "]
[111.975971, "o", "    onSuccess: () => {\r\n\u001b[?2004l\r\u001b[?2004h>       queryClient.invalidateQueries({ queryKey: ['todos'] });\r\n\u001b[?2004l\r\u001b[?2004h>     },\r\n\u001b[?2004l\r\u001b[?2004h>   });\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h>   const handleSubmit = (e) => {\r\n\u001b[?2004l\r\u001b[?2004h>     e.preventDefault();\r\n\u001b[?2004l\r\u001b[?2004h>     const trimmed = text.trim();\r\n\u001b[?2004l\r\u001b[?2004h>     if (!trimmed) return;\r\n\u001b[?2004l\r\u001b[?2004h>     mutation.mutate(trimmed);\r\n\u001b[?2004l\r\u001b[?2004h>     setText('');\r\n\u001b[?2004l\r"]
[111.978388, "o", "\u001b[?2004h>   };\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h>   return (\r\n\u001b[?2004l\r\u001b[?2004h>     <div>\r\n\u001b[?2004l\r\u001b[?2004h>       <h1>Todo List</h1>\r\n\u001b[?2004l\r\u001b[?2004h> "]
[111.978503, "o", "      <form onSubmit={handleSubmit}>\r\n\u001b[?2004l\r\u001b[?2004h>         <input\r\n\u001b[?2004l\r\u001b[?2004h>           id=\"todo-input\"\r\n\u001b[?2004l\r\u001b[?2004h>           type=\"text\"\r\n\u001b[?2004l\r\u001b[?2004h>           value={text}\r\n\u001b[?2004l\r\u001b[?2004h>           onChange={(e) => setText(e.target.value)}\r\n\u001b[?2004l\r\u001b[?2004h>           placeholder=\"Enter a todo\"\r\n\u001b[?2004l\r\u001b[?2004h>         />\r\n\u001b[?2004l\r"]
[111.978567, "o", "\u001b[?2004h> "]
[111.979358, "o", "        <button id=\"todo-submit\" type=\"submit\" disabled={mutation.isPending}>\r\n\u001b[?2004l\r\u001b[?2004h> "]
[111.97944, "o", "          Add\r\n\u001b[?2004l\r\u001b[?2004h"]
[111.979497, "o", "> "]
[111.979698, "o", "        </button>\r\n\u001b[?2004l\r"]
[111.979776, "o", "\u001b[?2004h> "]
[111.980343, "o", "      </form>\r\n\u001b[?2004l\r\u001b[?2004h>       {isLoading && <p>Loading...</p>}\r\n\u001b[?2004l\r\u001b[?2004h"]
[111.980796, "o", "> "]
[111.98129, "o", "      {error && <p>Error loading todos</p>}\r\n\u001b[?2004l\r\u001b[?2004h>       <ul id=\"todo-list\">\r\n\u001b[?2004l\r\u001b[?2004h>         {todos.map((todo) => (\r\n\u001b[?2004l\r\u001b[?2004h> "]
[111.981715, "o", "          <li key={todo.id}>{todo.text}</li>\r\n\u001b[?2004l\r\u001b[?2004h> "]
[111.98179, "o", "        ))}\r\n\u001b[?2004l\r\u001b[?2004h"]
[111.981943, "o", ">       </ul>\r\n\u001b[?2004l\r\u001b[?2004h> "]
[111.982045, "o", "    </div>\r\n\u001b[?2004l\r"]
[111.982104, "o", "\u001b[?2004h> "]
[111.982212, "o", "  );\r\n\u001b[?2004l\r\u001b[?2004h> }\r\n\u001b[?2004l\r"]
[111.982271, "o", "\u001b[?2004h> EOF\r\n"]
[111.982382, "o", "\u001b[?2004l\r"]
[111.985187, "o", "\u001b[?2004hroot@8e5da714-1f8e-4fc8-b01b-1b0853a4834c:/home/user/tanstack-query-todo# "]
[119.488228, "i", "cat > server.js << 'EOF'\nimport express from 'express';\nimport path from 'path';\nimport { fileURLToPath } from 'url';\n\nconst __filename = fileURLToPath(import.meta.url);\nconst __dirname = path.dirname(__filename);\n\nconst app = express();\nconst PORT = 4821;\n\napp.use(express.json());\n\n// In-memory todo store\nlet todos = [];\nlet nextId = 1;\n\n// GET /api/todos\napp.get('/api/todos', (req, res) => {\n  res.status(200).json(todos);\n});\n\n// POST /api/todos\napp.post('/api/todos', (req, res) => {\n  const { text } = req.body || {};\n  if (typeof text !== 'string') {\n    return res.status(400).json({ error: 'Invalid text' });\n  }\n  const todo = { id: nextId++, text, completed: false };\n  todos.push(todo);\n  res.status(201).json(todo);\n});\n\n// Serve static files from dist\nconst distPath = path.join(__dirname, 'dist');\napp.use(express.static(distPath));\n\n// SPA fallback - serve index.html for non-API routes\napp.get(/^(?!\\/api\\/).*/, (req, res) => {\n  res.sendFile(path.join(distPath, 'index.html'), (err) => {\n    if (err) {\n      res.status(404).send('Frontend not built. Run \"npm run build\" first.');\n    }\n  });\n});\n\napp.listen(PORT, () => {\n  console.log(`Server is running on http://localhost:${PORT}`);\n});\nEOF\n"]
