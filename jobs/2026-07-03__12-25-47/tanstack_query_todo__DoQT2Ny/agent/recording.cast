[204.44366, "o", "{\r\n  \"name\": \"tanstack-query-todo\",\r\n  \"version\": \"1.0.0\",\r\n  \"private\": true,\r\n  \"type\": \"module\",\r\n  \"scripts\": {\r\n    \"dev:client\": \"vite\",\r\n    \"build:client\": \"vite build\",\r\n    \"start\": \"npm run build && node server.js\",\r\n    \"build\": \"vite build\"\r\n  },\r\n  \"dependencies\": {\r\n    \"express\": \"^4.21.2\",\r\n    \"@tanstack/react-query\": \"^5.62.7\",\r\n    \"react\": \"^18.3.1\",\r\n    \"react-dom\": \"^18.3.1\"\r\n  },\r\n  \"devDependencies\": {\r\n    \"@vitejs/plugin-react\": \"^4.3.4\",\r\n    \"vite\": \"^5.4.11\"\r\n  }\r\n}\r\n"]
