[334.859992, "o", "Approach 1 works: <ref *1> ArkErrors(2) [\r\n  ArkError {\r\n    ' arkKind': 'error',\r\n    path: ReadonlyPath(1) [ 'left', cache: [Object] ],\r\n    data: { value: 1 },\r\n    nodeConfig: {\r\n      description: [Function: description],\r\n      expected: [Function: expected],\r\n      actual: [Function: actual],\r\n      problem: [Function (anonymous)],\r\n      message: [Function (anonymous)]\r\n    },\r\n    input: {\r\n      code: 'required',\r\n      missingValueDescription: 'an object',\r\n      meta: {}\r\n    },\r\n    ctx: Traversal {\r\n      path: [],\r\n      errors: [Circular *1],\r\n      root: [Object],\r\n      config: [Object],\r\n      queuedMorphs: [],\r\n      branches: [],\r\n      seen: {}\r\n    },\r\n    code: 'required',\r\n    missingValueDescription: 'an object',\r\n    meta: {}\r\n  },\r\n  ArkError {\r\n    ' arkKind': 'error',\r\n    path: ReadonlyPath(1) [ 'right', cache: [Object] ],\r\n    data: { value: 1 },\r\n    nodeConfig: {\r\n      description: [Function: description],\r\n      expected: [Function: expected],\r\n      actual: [Function: actual],\r\n      problem: [Function (anonymous)],\r\n      message: [Function (anonymous)]\r\n"]
