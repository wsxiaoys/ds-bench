[347.807896, "i", "cat > explore.ts << 'EXPLOREEOF'\nimport { type, scope } from \"arktype\"\n\n// Approach 1: Use scope with reference\ntry {\n  const types = scope({\n    tree: { value: \"number\", \"left?\": \"tree\", \"right?\": \"tree\" }\n  }).export()\n  const t = types.tree\n  console.log(\"Approach 1 leaf:\", t({ value: 1 }))\n  console.log(\"Approach 1 nested:\", t({ value: 1, left: { value: 2 } }))\n} catch (e) {\n  console.log(\"Approach 1 failed:\", e instanceof Error ? e.message : e)\n}\n\n// Approach 2: Use scope with simpler structure\ntry {\n  const types2 = scope({\n    node: { name: \"string\", \"children?\": \"node[]\" }\n  }).export()\n  console.log(\"Approach 2 leaf:\", types2.node({ name: \"root\" }))\n  console.log(\"Approach 2 nested:\", types2.node({ name: \"root\", children: [{ name: \"a\" }] }))\n} catch (e) {\n  console.log(\"Approach 2 failed:\", e instanceof Error ? e.message : e)\n}\nEXPLOREEOF\n"]
