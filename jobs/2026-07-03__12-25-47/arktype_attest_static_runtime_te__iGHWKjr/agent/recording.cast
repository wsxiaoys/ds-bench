[386.854322, "i", "cat > explore2.ts << 'EXPLOREEOF'\nimport { type, scope, define } from \"arktype\"\n\n// Test 1: built-in string.upper\ntry {\n  const T = type(\"string.upper\")\n  console.log(\"string.upper:\", T(\"hi\"))\n} catch (e) { console.log(\"err1:\", e instanceof Error ? e.message : e) }\n\n// Test 2: pipe with multiple morphs\ntry {\n  const T = type(\"string.trim |> string.upper\")\n  console.log(\"pipe:\", T(\"  hi  \"))\n} catch (e) { console.log(\"err2:\", e instanceof Error ? e.message : e) }\n\n// Test 3: tuple form for morph pipe\ntry {\n  const T = type([\"string.trim\", \"|>\", \"string.upper\"])\n  console.log(\"tuple:\", T(\"  hi  \"))\n} catch (e) { console.log(\"err3:\", e instanceof Error ? e.message : e) }\n\n// Test 4: standalone pipe using .pipe() on scope or with define\ntry {\n  const $ = scope({})\n  const T = $.type(\"string\").pipe((s: string) => s.toUpperCase())\n  console.log(\"pipeMethod:\", T(\"hi\"))\n} catch (e) { console.log(\"err4:\", e instanceof Error ? e.message : e) }\n\n// Test 5: Using scope.define + pipe\ntry {\n  const $ = scope({ x: \"string\" }).export()\n  console.log(\"x:\", $.x(\"hi\"))\n} catch (e) { console.log(\"err5:\", e instanceof Error ? e.message : e) }\nEXPLOREEOF\n"]
