[333.843155, "i", "cat > explore.ts << 'EXPLOREEOF'\nimport { type, scope } from \"arktype\"\n\n// Try various recursive approaches\n\n// Approach 1: Use scope with reference\ntry {\n  const types = scope({\n    tree: { value: \"number\", left: \"tree\", right: \"tree\" }\n  }).export()\n  console.log(\"Approach 1 works:\", types.tree({ value: 1 }))\n} catch (e) {\n  console.log(\"Approach 1 failed:\", e instanceof Error ? e.message : e)\n}\n\n// Approach 2: Use scope with simpler structure\ntry {\n  const types2 = scope({\n    node: { name: \"string\", \"children?\": \"node[]\" }\n  }).export()\n  console.log(\"Approach 2 works:\", types2.node({ name: \"root\", children: [] }))\n} catch (e) {\n  console.log(\"Approach 2 failed:\", e instanceof Error ? e.message : e)\n}\n\n// Approach 3: try 'tree' as keyword\ntry {\n  const types3 = scope({\n    tree: { name: \"string\", \"kids?\": \"tree[]\" }\n  }).export()\n  console.log(\"Approach 3 works:\", types3.tree({ name: \"x\" }))\n} catch (e) {\n  console.log(\"Approach 3 failed:\", e instanceof Error ? e.message : e)\n}\nEXPLOREEOF\n"]
