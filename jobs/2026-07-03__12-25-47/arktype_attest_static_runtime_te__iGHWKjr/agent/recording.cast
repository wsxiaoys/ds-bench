[542.606088, "i", "python3 << 'PYEOF'\ncontent = '''import { describe, it, expect } from \"vitest\"\nimport { type } from \"arktype\"\nimport { attest } from \"@arktype/attest\"\nimport {\n\\tRole,\n\\tCategory,\n\\tEvent,\n\\tTrimmedEmail,\n\\tUpperName\n} from \"../src/schemas.ts\"\n\ndescribe(\"ArkType schemas with @arktype/attest\", () => {\n\\tit(\"Role is a literal-string union\", () => {\n\\t\\t// (2) attest(<literal string union>).type.toString.snap(...)\n\\t\\tattest(Role.infer).type.toString.snap(\"'admin' | 'editor' | 'guest' | 'viewer'\")\n\\t\\t// (1) Pure compile-time type-equality check (no runtime actual passed)\n\\t\\tattest<\"admin\" | \"editor\" | \"viewer\" | \"guest\", typeof Role.infer>()\n\n\\t\\t// Runtime sanity\n\\t\\tconst ok = Role(\"admin\")\n\\t\\tattest(ok).snap(\"admin\")\n\n\\t\\t// (3) Runtime throws — invalid literal should reject\n\\t\\tconst err = Role(\"notarole\")\n\\t\\tattest(err).throws.snap(\n\\t\\t\\t'must be \"admin\", \"editor\", \"guest\" or \"viewer\" (was a string)'\n\\t\\t)\n\\t})\n\n\\tit(\"Category is a recursive scope-exported type\", () => {\n\\t\\t// (4) toString snapshot for the recursive alias\n\\t\\tattest(Category.infer).type.toString.snap(\n\\t\\t\\t\"{ name: string; children?: Category[]; }\"\n\\t\\t)\n\n\\t\\t// Runtime value works for nested recursive input\n\\t\\tconst nested = Category({\n\\t\\t\\tname: \"root\",\n\\t\\t\\tchildren: [{ name: \"a\" }, { name: \"b\", children: [{ name: \"c\" }] }]\n\\t\\t})\n\\t\\tattest(nested).snap({\n\\t\\t\\tname: \"root\",\n\\t\\t\\tchildren: [\n\\t\\t\\t\\t{ name: \"a\" },\n\\t\\t\\t\\t{ name: \"b\", children: [{ name: \"c\" }] }\n\\t\\t\\t]\n\\t\\t})\n\n\\t\\t// Missing required `name` should error at runtime\n\\t\\tconst catErr = Category({ name: 5 } as { name: string })\n\\t\\tattest(catErr).throws.snap(\"name must be a string (was a number)\")\n\\t})\n\n\\tit(\"Event is a discriminated union on `kind`\", () => {\n\\t\\t// (5) Type toString snap\n\\t\\tattest(Event.infer).type.toString.snap(\n\\t\\t\\t`{\\n\\t\\t\\t\\tamount: number\\n\\t\\t\\t\\tkind: \"purchase\"\\n\\t\\t\\t}\\n\\t\\t\\t& {\\n\\t\\t\\t\\t\\tkind: \"logout\"\\n\\t\\t\\t}\\n\\t\\t\\t& {\\n\\t\\t\\t\\t\\tkind: \"login\"\\n\\t\\t\\t}`\n\\t\\t)\n\n\\t\\t// Runtime: each tag should be validated correctly\n\\t\\tattest(Event({ kind: \"login\" })).snap({ kind: \"login\" })\n\\t\\tattest(Event({ kind: \"purchase\", amount: 9.99 })).snap({\n\\t\\t\\tkind: \"purchase\",\n\\t\\t\\tamount: 9.99\n\\t\\t})\n\n\\t\\t// Throwing assertion: a `purchase` event missing amount\n\\t\\tconst evErr = Event({ kind: \"purchase\" })\n\\t\\tattest(evErr).throws.snap(\"amount must be a number (was undefined)\")\n\\t})\n\n\\tit(\"TrimmedEmail — built-in morph pipe on `string.trim`\", () => {\n\\t\\t// Runtime: morph trims surrounding whitespace\n\\t\\tconst trimmed = TrimmedEmail(\"   hello@example.com   \")\n\\t\\tattest(trimmed).snap(\"hello@example.com\")\n\\t\\tattest(TrimmedEmail(\"plain\")).snap(\"plain\")\n\n\\t\\t// Non-string should throw\n\\t\\tconst e = TrimmedEmail(123)\n\\t\\tattest(e).throws.snap(\"must be a string (was a number)\")\n\\t})\n\n\\tit(\"UpperName — morph pipe with `|>` operator\", () => {\n\\t\\t// Trim+upper output\n\\t\\tattest(UpperName(\"  alice  \")).snap(\"ALICE\")\n\\t\\tattest(UpperName(\"bob\")).snap(\"BOB\")\n\n\\t\\t// Pure compile-time type equality check\n\\t\\tattest<string, typeof UpperName.infer>()\n\n\\t\\t// Negative compile-time assertion guarded by @ts-expect-error:\n\\t\\t// the morph output type is `string`, not the literal `\"ALICE\"`.\n\\t\\t// @ts-expect-error — output type does not narrow to a string literal\n\\t\\tattest(() => UpperName(\"  alice  \")).throwsAndHasTypeError(\n\\t\\t\\t/Type 'string' is not assignable to type '\"ALICE\"'\"/\n\\t\\t)\n\\t})\n\n\\tit(\"completion snapshots are populated with @ts-expect-error\", () => {\n\\t\\t// (6) Completions: snapshot the builtin keywords completions for a `type` parser.\n\\t\\t// The deliberately-broken type expression below is guarded by @ts-expect-error.\n\\t\\t// @ts-expect-error — `number%0` is a divider-by-zero error in arktype\n\\t\\tattest(() => type(\"number%0\")).completions({\n\\t\\t\\t\"0\": [\"0%\", \"0..\", \"0d\"]\n\\t\\t})\n\\t})\n})\n'''\nwith open('tests/schemas.test.ts', 'w') as f:\n    f.write(content)\nprint('written')\nPYEOF\n"]
