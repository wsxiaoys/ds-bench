[46.660906, "i", "cat > /home/user/myproject/index.js << 'EOF'\nconst express = require('express');\nconst cookieParser = require('cookie-parser');\nconst PocketBase = require('pocketbase');\n\nconst app = express();\nconst PORT = 3000;\nconst PB_URL = 'http://127.0.0.1:8090';\n\napp.use(cookieParser());\napp.use(express.json());\n\n// Middleware to synchronize PocketBase auth state via cookies\napp.use((req, res, next) => {\n    const pb = new PocketBase(PB_URL);\n\n    // Load the initial auth state from the request's cookie header\n    try {\n        pb.authStore.loadFromCookie(req.headers.cookie || '');\n    } catch (_) {\n        pb.authStore.clear();\n    }\n\n    // Attach the pb instance to the request for use in route handlers\n    req.pb = pb;\n\n    // Refresh the auth state asynchronously\n    (async () => {\n        try {\n            if (pb.authStore.isValid) {\n                await pb.collection('users').authRefresh();\n            }\n        } catch (_) {\n            pb.authStore.clear();\n        }\n\n        // Export the (possibly updated) auth state as a cookie and set in response\n        try {\n            const cookie = pb.authStore.exportToCookie();\n            if (cookie) {\n                // append so we don't overwrite other Set-Cookie headers\n                res.append('Set-Cookie', cookie);\n            }\n        } catch (_) {}\n\n        // Mark that the auth sync has completed for this request\n        req._authSynced = true;\n    })();\n\n    next();\n});\n\n// Protected route GET /profile\napp.get('/profile', async (req, res) => {\n    // Wait until the auth sync middleware has finished writing the cookie\n    while (!req._authSynced) {\n        await new Promise((resolve) => setTimeout(resolve, 5));\n    }\n\n    const pb = req.pb;\n\n    if (pb.authStore.isValid && pb.authStore.record) {\n        return res.status(200).json({\n            id: pb.authStore.record.id,\n            email: pb.authStore.record.email,\n        });\n    }\n\n    return res.status(401).json({ error: 'Unauthorized' });\n});\n\napp.listen(PORT, () => {\n    console.log(`Server running on http://127.0.0.1:${PORT}`);\n});\nEOF\n"]
