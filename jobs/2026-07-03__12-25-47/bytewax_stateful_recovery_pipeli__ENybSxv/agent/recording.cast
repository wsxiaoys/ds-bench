[398.035712, "i", "cd /root/project && python3 -c '\nimport pickle\nfrom pipeline import builder, folder, merger, stats, parse_ts, to_iso\n\n# Test all state components\nprint(\"Testing picklability of state...\")\nacc = builder()\nfor v in [20.0, 22.0, 21.0, 19.0, 23.0]:\n    acc = folder(acc, v)\n    print(f\"After {v}: {acc}\")\n    # Verify picklable\n    p = pickle.dumps(acc)\n    restored = pickle.loads(p)\n    assert restored == acc\n\nacc2 = merger(builder(), acc)\nprint(f\"Merged: {acc2}\")\npickle.dumps(acc2)\n\n# Test the stats function\nprint(f\"Stats: {stats(acc)}\")\nprint(\"All state is fully picklable.\")\n'\n"]
