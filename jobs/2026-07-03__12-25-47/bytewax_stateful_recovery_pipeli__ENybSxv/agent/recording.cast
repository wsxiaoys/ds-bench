[295.952548, "o", "\r\n@overload\r\ndef join_window(\r\n    step_id: str,\r\n    clock: Clock[V, Any],\r\n    windower: Windower[Any],\r\n    side1: KeyedStream[V],\r\n    /,\r\n    *,\r\n    insert_mode: JoinInsertMode = ...,\r\n    emit_mode: Literal[\"complete\"],\r\n    ordered: bool = ...,\r\n) -> WindowOut[V, Tuple[V]]: ...\r\n\r\n\r\n@overload\r\ndef join_window(\r\n    step_id: str,\r\n    clock: Clock[Union[U, V], SC],\r\n    windower: Windower[Any],\r\n    side1: KeyedStream[U],\r\n    side2: KeyedStream[V],\r\n    /,\r\n    *,\r\n    insert_mode: JoinInsertMode = ...,\r\n    emit_mode: Literal[\"complete\"],\r\n    ordered: bool = ...,\r\n) -> WindowOut[Union[U, V], Tuple[U, V]]: ...\r\n\r\n\r\n@overload\r\ndef join_window(\r\n    step_id: str,\r\n    clock: Clock[Union[U, V, W], SC],\r\n    windower: Windower[Any],\r\n    side1: KeyedStream[U],\r\n    side2: KeyedStream[V],\r\n    side3: KeyedStream[W],\r\n    /,\r\n    *,\r\n    insert_mode: JoinInsertMode = ...,\r\n    emit_mode: Literal[\"complete\"],\r\n    ordered: bool = ...,\r\n) -> WindowOut[Union[U, V, W], Tuple[U, V, W]]: ...\r\n\r\n\r\n@overload\r\ndef join_window(\r\n    step_id: str,\r\n    clock: Clock[Union[U, V, W, X], SC],\r\n    windower: Windower[Any],\r\n    side1: KeyedStream[U],\r\n    side2: KeyedStream[V],\r\n    side3: KeyedStream[W],\r\n    side4: KeyedStream[X],\r\n    /,\r\n    *,\r\n    insert_mode: JoinInsertMode = ...,\r\n    emit_mode: Literal[\"complete\"],\r\n    ordered: bool = ...,\r\n) -> WindowOut[Union[U, V, W, X], Tuple[U, V, W, X]]: ...\r\n\r\n\r\n@overload\r\ndef join_window(\r\n    step_id: str,\r\n    clock: Clock[V, Any],\r\n    windower: Windower[Any],\r\n    side1: KeyedStream[V],\r\n    /,\r\n    *,\r\n    insert_mode: JoinInsertMode = ...,\r\n    emit_mode: JoinEmitMode = ...,\r\n    ordered: bool = ...,\r\n) -> WindowOut[V, Tuple[Optional[V]]]: ...\r\n\r\n\r\n@overload\r\ndef join_window(\r\n    step_id: str,\r\n    clock: Clock[Union[U, V], SC],\r\n    windower: Windower[Any],\r\n    side1: KeyedStream[U],\r\n    side2: KeyedStream[V],\r\n    /,\r\n    *,\r\n    insert_mode: JoinInsertMode = ...,\r\n    emit_mode: JoinEmitMode = ...,\r\n    ordered: bool = ...,\r\n) -> WindowOut[Union[U, V], Tuple[Optional[U], Optional[V]]]: ...\r\n\r\n\r\n@overload\r\ndef join_window(\r\n    step_id: str,\r\n    clock: Clock[Union[U, V, W], SC],\r\n    windower: Windower[Any],\r\n    side1: KeyedStream[U],\r\n    side2: KeyedStream[V],\r\n    side3: KeyedStream[W],\r\n"]
[295.952856, "o", "\u001b[?2004hroot@2eacb342-88a4-4e90-86f7-a5580b74af48:/tmp# "]
[307.643076, "i", "cat > /tmp/test3.py << 'PYEOF'\n\"\"\"Test re-keying windowed.down and windowed.meta.\"\"\"\nimport json\nfrom datetime import datetime, timedelta, timezone\nfrom pathlib import Path\nfrom bytewax.dataflow import Dataflow\nimport bytewax.operators as op\nfrom bytewax.operators.windowing import EventClock, SlidingWindower, fold_window\nfrom bytewax.testing import TestingSource, run_main\n\nflow = Dataflow(\"test\")\n\ndata = [\n    json.dumps({\"sensor_id\": \"a\", \"time\": \"2026-01-01T00:00:10Z\", \"temp\": 20.0}),\n    json.dumps({\"sensor_id\": \"a\", \"time\": \"2026-01-01T00:00:25Z\", \"temp\": 22.0}),\n    json.dumps({\"sensor_id\": \"a\", \"time\": \"2026-01-01T00:00:40Z\", \"temp\": 21.0}),\n]\n\ninp = op.input(\"in\", flow, TestingSource(data))\nparsed = op.map(\"parse\", inp, lambda l: json.loads(l))\nkeyed = op.key_on(\"key\", parsed, lambda x: x[\"sensor_id\"])\n\ndef to_event(item):\n    t = item[\"time\"]\n    if t.endswith(\"Z\"):\n        t = t[:-1] + \"+00:00\"\n    return {\"sensor_id\": item[\"sensor_id\"], \"temp\": float(item[\"temp\"]), \"time\": datetime.fromisoformat(t)}\n\nevents = op.map_value(\"to_event\", keyed, to_event)\n\nclock = EventClock(ts_getter=lambda e: e[\"time\"], wait_for_system_duration=timedelta(0))\nwindower = SlidingWindower(length=timedelta(seconds=60), offset=timedelta(seconds=30), align_to=datetime(2026,1,1,tzinfo=timezone.utc))\n\nwindowed = fold_window(\"fold\", events, clock, windower,\n                       builder=lambda: {\"count\":0, \"sum\":0.0, \"sumsq\":0.0},\n                       folder=lambda acc, e: (acc.update({\"count\":acc[\"count\"]+1, \"sum\":acc[\"sum\"]+e[\"temp\"], \"sumsq\":acc[\"sumsq\"]+e[\"temp\"]**2}) or acc),\n                       merger=lambda a, b: {\"count\":a[\"count\"]+b[\"count\"], \"sum\":a[\"sum\"]+b[\"sum\"], \"sumsq\":a[\"sumsq\"]+b[\"sumsq\"]})\n\n# Re-key by (sensor_id, window_id) so we can join properly\n# windowed.down items: (sensor_id, (window_id, value))\n# windowed.meta items: (sensor_id, (window_id, WindowMetadata))\n\ndown_rekeyed = op.key_on(\"down_rekey\", windowed.down, lambda item: (item[0], item[1][0]))\nmeta_rekeyed = op.key_on(\"meta_rekey\", windowed.meta, lambda item: (item[0], item[1][0]))\n\nop.inspect(\"down_rekey\", down_rekeyed)\nop.inspect(\"meta_rekey\", meta_rekeyed)\n\njoined = op.join(\"join\", down_rekeyed, meta_rekeyed)\nop.inspect(\"joined\", joined)\n\nrun_main(flow)\nPYEOF\ncd /tmp && python3 test3.py 2>&1 | head -30\n"]
