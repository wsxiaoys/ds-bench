[180.786733, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[180.786928, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> def merger(a, b):\r\n\u001b[?2004l\r"]
[180.786983, "o", "\u001b[?2004h> "]
[180.787383, "o", "    \"\"\"Merge two accumulators when a window is merged.\"\"\"\r\n\u001b[?2004l\r"]
[180.787437, "o", "\u001b[?2004h> "]
[180.787521, "o", "    return {\r\n\u001b[?2004l\r"]
[180.787572, "o", "\u001b[?2004h> "]
[180.787836, "o", "        \"count\": a[\"count\"] + b[\"count\"],\r\n\u001b[?2004l\r"]
[180.787889, "o", "\u001b[?2004h> "]
[180.788104, "o", "        \"sum\": a[\"sum\"] + b[\"sum\"],\r\n\u001b[?2004l\r"]
[180.788158, "o", "\u001b[?2004h> "]
[180.788411, "o", "        \"sumsq\": a[\"sumsq\"] + b[\"sumsq\"],\r\n\u001b[?2004l\r"]
[180.788465, "o", "\u001b[?2004h> "]
[180.788572, "o", "    }\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[180.788623, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h"]
[180.788735, "o", "> "]
[180.78879, "o", "def stats(acc):\r\n\u001b[?2004l\r\u001b[?2004h"]
[180.788893, "o", "> "]
[180.789219, "o", "    \"\"\"Return mean and population stddev from the accumulator.\"\"\"\r\n\u001b[?2004l\r"]
[180.789275, "o", "\u001b[?2004h> "]
[180.789404, "o", "    n = acc[\"count\"]\r\n\u001b[?2004l\r"]
[180.78946, "o", "\u001b[?2004h> "]
[180.789563, "o", "    if n == 0:\r\n\u001b[?2004l\r\u001b[?2004h"]
[180.789619, "o", "> "]
[180.789762, "o", "        return 0.0, 0.0\r\n\u001b[?2004l\r"]
[180.789818, "o", "\u001b[?2004h> "]
[180.789969, "o", "    mean = acc[\"sum\"] / n\r\n\u001b[?2004l\r"]
[180.790026, "o", "\u001b[?2004h> "]
[180.790309, "o", "    # Population variance from E[x^2] - E[x]^2\r\n\u001b[?2004l\r"]
[180.790365, "o", "\u001b[?2004h> "]
[180.790632, "o", "    var = (acc[\"sumsq\"] / n) - (mean * mean)\r\n\u001b[?2004l\r"]
[180.790689, "o", "\u001b[?2004h> "]
[180.790806, "o", "    if var < 0.0:\r\n\u001b[?2004l\r"]
[180.790863, "o", "\u001b[?2004h> "]
[180.791253, "o", "        # Guard against tiny negative numbers caused by FP error.\r\n\u001b[?2004l\r"]
[180.791309, "o", "\u001b[?2004h> "]
[180.791415, "o", "        var = 0.0\r\n\u001b[?2004l\r"]
[180.791471, "o", "\u001b[?2004h> "]
[180.791616, "o", "    stddev = var ** 0.5\r\n\u001b[?2004l\r"]
[180.791671, "o", "\u001b[?2004h> "]
[180.791826, "o", "    return mean, stddev\r\n\u001b[?2004l\r"]
[180.791882, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[180.791985, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[180.792203, "o", "flow = Dataflow(\"sensor_windowing\")\r\n\u001b[?2004l\r"]
[180.792253, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[180.792404, "o", "\u001b[?2004h> "]
[180.792833, "o", "# --- Input: read JSON lines from input.jsonl ---------------------------------\r\n\u001b[?2004l\r\u001b[?2004h"]
[180.792951, "o", "> "]
[180.79309, "o", "src = FileSource(str(INPUT_PATH))\r\n\u001b[?2004l\r"]
[180.793199, "o", "\u001b[?2004h> "]
[180.793356, "o", "inp = op.input(\"input\", flow, src)\r\n\u001b[?2004l\r"]
[180.793463, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[180.793675, "o", "# Parse the JSON lines into dicts.\r\n\u001b[?2004l\r"]
[180.793747, "o", "\u001b[?2004h> "]
[180.794129, "o", "parsed = op.map(\"parse_json\", inp, lambda line: json.loads(line))\r\n\u001b[?2004l\r"]
[180.794186, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[180.79429, "o", "> "]
[180.794413, "o", "# Key the stream by sensor_id.\r\n\u001b[?2004l\r"]
[180.794467, "o", "\u001b[?2004h> "]
[180.794914, "o", "keyed = op.key_on(\"key_on_sensor\", parsed, lambda x: x[\"sensor_id\"])\r\n\u001b[?2004l\r"]
[180.79497, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[180.795076, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[180.795214, "o", "def to_event(item):\r\n\u001b[?2004l\r"]
[180.795268, "o", "\u001b[?2004h> "]
[180.795417, "o", "    return {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[180.795647, "o", "        \"sensor_id\": item[\"sensor_id\"],\r\n\u001b[?2004l\r"]
[180.795692, "o", "\u001b[?2004h> "]
[180.795934, "o", "        \"temp\": float(item[\"temp\"]),\r\n\u001b[?2004l\r"]
[180.795985, "o", "\u001b[?2004h> "]
[180.796223, "o", "        \"time\": parse_ts(item[\"time\"]),\r\n\u001b[?2004l\r"]
[180.796268, "o", "\u001b[?2004h> "]
[180.796363, "o", "    }\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[180.796407, "o", "\u001b[?2004h> "]
[180.796746, "o", "events = op.map_value(\"to_event\", keyed, to_event)\r\n\u001b[?2004l\r\u001b[?2004h"]
[180.796792, "o", "> \r\n\u001b[?2004l\r"]
[180.796891, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[180.797043, "o", "def extract_ts(event):\r\n\u001b[?2004l\r"]
[180.797151, "o", "\u001b[?2004h> "]
[180.797256, "o", "    return event[\"time\"]\r\n\u001b[?2004l\r"]
[180.797304, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[180.797396, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[180.797535, "o", "clock = EventClock(\r\n\u001b[?2004l\r"]
[180.797583, "o", "\u001b[?2004h> "]
[180.797762, "o", "    ts_getter=extract_ts,\r\n\u001b[?2004l\r"]
[180.79781, "o", "\u001b[?2004h> "]
[180.798111, "o", "    wait_for_system_duration=timedelta(seconds=0),\r\n\u001b[?2004l\r"]
[180.798156, "o", "\u001b[?2004h> )\r\n\u001b[?2004l\r"]
[180.798211, "o", "\u001b[?2004h> "]
[180.798325, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[180.798483, "o", "windower = SlidingWindower(\r\n\u001b[?2004l\r\u001b[?2004h"]
[180.798584, "o", "> "]
[180.798733, "o", "    length=timedelta(seconds=60),\r\n\u001b[?2004l\r"]
[180.798785, "o", "\u001b[?2004h> "]
[180.799012, "o", "    offset=timedelta(seconds=30),\r\n\u001b[?2004l\r"]
[180.799114, "o", "\u001b[?2004h> "]
[180.799238, "o", "    align_to=WINDOW_ALIGN,\r\n\u001b[?2004l\r"]
[180.799289, "o", "\u001b[?2004h> )\r\n\u001b[?2004l\r"]
[180.799402, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[180.799503, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[180.79967, "o", "def folder_value(acc, event):\r\n\u001b[?2004l\r\u001b[?2004h"]
[180.800001, "o", ">     return folder(acc, event[\"temp\"])\r\n"]
[180.800059, "o", "\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[180.800206, "o", "> "]
[180.800254, "o", "windowed = fold_window(\r\n\u001b[?2004l\r"]
[180.800354, "o", "\u001b[?2004h> "]
[180.800436, "o", "    \"fold_window\",\r\n\u001b[?2004l\r"]
[180.800509, "o", "\u001b[?2004h> "]
[180.800555, "o", "    events,\r\n\u001b[?2004l\r"]
[180.800649, "o", "\u001b[?2004h> "]
[180.800695, "o", "    clock,\r\n\u001b[?2004l\r\u001b[?2004h"]
[180.800803, "o", "> "]
[180.80085, "o", "    windower,\r\n\u001b[?2004l\r\u001b[?2004h> "]
[180.801011, "o", "    builder=builder,\r\n\u001b[?2004l\r"]
[180.801106, "o", "\u001b[?2004h> "]
[180.801231, "o", "    folder=folder_value,\r\n\u001b[?2004l\r"]
[180.80128, "o", "\u001b[?2004h> "]
[180.801397, "o", "    merger=merger,\r\n\u001b[?2004l\r"]
[180.801443, "o", "\u001b[?2004h> )\r\n\u001b[?2004l\r"]
[180.801535, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[180.801583, "o", "> "]
[180.802064, "o", "# --- Merge window values with metadata so we have open/close times -----------\r\n\u001b[?2004l\r"]
[180.802111, "o", "\u001b[?2004h> "]
[180.802436, "o", "# windowed.down keys: (sensor_id, (window_id, acc))\r\n\u001b[?2004l\r"]
[180.802482, "o", "\u001b[?2004h> "]
[180.802874, "o", "# windowed.meta keys: (sensor_id, (window_id, WindowMetadata))\r\n\u001b[?2004l\r"]
[180.802922, "o", "\u001b[?2004h> "]
[180.803037, "o", "joined = op.join(\r\n\u001b[?2004l\r"]
[180.803084, "o", "\u001b[?2004h> "]
[180.803199, "o", "    \"join_meta\",\r\n\u001b[?2004l\r"]
[180.803253, "o", "\u001b[?2004h> "]
[180.803409, "o", "    windowed.down,\r\n\u001b[?2004l\r\u001b[?2004h> "]
[180.80355, "o", "    windowed.meta,\r\n\u001b[?2004l\r"]
[180.803644, "o", "\u001b[?2004h> )\r\n\u001b[?2004l\r\u001b[?2004h> "]
[180.80376, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[180.803904, "o", "\u001b[?2004h> "]
[180.804006, "o", "def format_output(item):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[180.804352, "o", "    # op.join emits ((key, (left_value, right_value)),).\r\n\u001b[?2004l\r\u001b[?2004h"]
[180.804453, "o", "> "]
[180.804617, "o", "    (sensor_id, _window_id) = item[0]\r\n\u001b[?2004l\r"]
[180.804674, "o", "\u001b[?2004h> "]
[180.804853, "o", "    left = item[1][0]\r\n\u001b[?2004l\r\u001b[?2004h> "]
[180.805006, "o", "    right = item[1][1]\r\n\u001b[?2004l\r"]
[180.805155, "o", "\u001b[?2004h> "]
[180.805246, "o", "    acc = left[1]\r\n\u001b[?2004l\r\u001b[?2004h> "]
[180.805348, "o", "    meta = right[1]\r\n\u001b[?2004l\r"]
[180.805404, "o", "\u001b[?2004h> "]
[180.805579, "o", "    mean, stddev = stats(acc)\r\n\u001b[?2004l\r"]
[180.805637, "o", "\u001b[?2004h> "]
[180.805774, "o", "    return {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[180.805972, "o", "        \"sensor_id\": sensor_id,\r\n\u001b[?2004l\r"]
[180.806032, "o", "\u001b[?2004h> "]
[180.806318, "o", "        \"window_start\": to_iso(meta.open_time),\r\n\u001b[?2004l\r"]
[180.806379, "o", "\u001b[?2004h> "]
[180.806666, "o", "        \"window_end\": to_iso(meta.close_time),\r\n\u001b[?2004l\r"]
[180.806785, "o", "\u001b[?2004h> "]
[180.806872, "o", "        \"mean\": mean,\r\n\u001b[?2004l\r"]
[180.806934, "o", "\u001b[?2004h> "]
[180.80707, "o", "        \"stddev\": stddev,\r\n\u001b[?2004l\r"]
[180.80713, "o", "\u001b[?2004h>     }\r\n"]
[180.807188, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[180.807234, "o", "\r\n\u001b[?2004l\r\u001b[?2004h"]
[180.807279, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h"]
[180.80732, "o", "> "]
[180.807671, "o", "formatted = op.map(\"format_output\", joined, format_output)\r\n\u001b[?2004l\r"]
[180.80772, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[180.807772, "o", "\u001b[?2004h> "]
[180.807812, "o", "\r\n\u001b[?2004l\r\u001b[?2004h"]
[180.807856, "o", "> "]
[180.807957, "o", "def to_kv(record):\r\n\u001b[?2004l\r"]
[180.808001, "o", "\u001b[?2004h> "]
[180.829095, "o", "    # FileSink is partitioned, so items must be (key, value) tuples.\r\n\u001b[?2004l\r\u001b[?2004h>     # We use the sensor_id as the partition key and the JSON string as\r\n\u001b[?2004l\r\u001b[?2004h>     # the value. The sensor_id is preserved in the JSON itself.\r\n\u001b[?2004l\r\u001b[?2004h>     return (record[\"sensor_id\"], json.dumps(record))\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> kv_stream = op.map(\"to_kv\", formatted, to_kv)\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> # --- Output: write JSON lines to output.jsonl --------------------------------\r\n\u001b[?2004l\r\u001b[?2004h> # FileSink requires the file to already exist; it's created by the runner.\r\n\u001b[?2004l\r\u001b[?2004h> op.output(\r\n\u001b[?2004l\r\u001b[?2004h>     \"output\",\r\n\u001b[?2004l\r\u001b[?2004h>     kv_stream,\r\n\u001b[?2004l\r\u001b[?2004h"]
[180.829198, "o", "> "]
[180.829283, "o", "    FileSink(str(OUTPUT_PATH)),\r\n\u001b[?2004l\r"]
[180.829342, "o", "\u001b[?2004h> )\r\n\u001b[?2004l\r"]
[180.829405, "o", "\u001b[?2004h> PYEOF\r\n"]
[180.829465, "o", "\u001b[?2004l\r"]
[180.832246, "o", "\u001b[?2004hroot@2eacb342-88a4-4e90-86f7-a5580b74af48:~/project# "]
[181.622114, "i", "cd /root/project && python3 -m bytewax.run pipeline:flow 2>&1 | tail -30\n"]
