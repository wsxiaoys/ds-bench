[349.880958, "o", "\u001b[?2004h> "]
[349.881196, "o", "    if value.endswith(\"Z\"):\r\n\u001b[?2004l\r"]
[349.881256, "o", "\u001b[?2004h> "]
[349.881603, "o", "        value = value[:-1] + \"+00:00\"\r\n\u001b[?2004l\r"]
[349.881668, "o", "\u001b[?2004h> "]
[349.88203, "o", "    dt = datetime.fromisoformat(value)\r\n\u001b[?2004l\r"]
[349.882102, "o", "\u001b[?2004h> "]
[349.882323, "o", "    if dt.tzinfo is None:\r\n\u001b[?2004l\r"]
[349.882385, "o", "\u001b[?2004h> "]
[349.882808, "o", "        dt = dt.replace(tzinfo=timezone.utc)\r\n\u001b[?2004l\r"]
[349.882882, "o", "\u001b[?2004h> "]
[349.88295, "o", "    else:\r\n\u001b[?2004l\r"]
[349.883069, "o", "\u001b[?2004h> "]
[349.883307, "o", "        dt = dt.astimezone(timezone.utc)\r\n\u001b[?2004l\r"]
[349.883357, "o", "\u001b[?2004h> "]
[349.883465, "o", "    return dt\r\n\u001b[?2004l\r"]
[349.883523, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[349.883576, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[349.883691, "o", "\u001b[?2004h> "]
[349.883749, "o", "def to_iso(dt):\r\n\u001b[?2004l\r"]
[349.883844, "o", "\u001b[?2004h> "]
[349.884267, "o", "    \"\"\"Format a datetime as an ISO8601 string in UTC with `Z` suffix.\"\"\"\r\n\u001b[?2004l\r"]
[349.884319, "o", "\u001b[?2004h> "]
[349.884763, "o", "    return dt.astimezone(timezone.utc).strftime(\"%Y-%m-%dT%H:%M:%SZ\")\r\n\u001b[?2004l\r"]
[349.884822, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[349.884913, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[349.884965, "o", "> "]
[349.885048, "o", "def builder():\r\n\u001b[?2004l\r"]
[349.885098, "o", "\u001b[?2004h> "]
[349.885413, "o", "    \"\"\"Build the initial accumulator for a window.\r\n\u001b[?2004l\r"]
[349.885468, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[349.885619, "o", "\u001b[?2004h> "]
[349.885812, "o", "    A plain dict is fully picklable.\r\n\u001b[?2004l\r\u001b[?2004h"]
[349.885925, "o", ">     \"\"\"\r\n\u001b[?2004l\r\u001b[?2004h> "]
[349.886231, "o", "    return {\"count\": 0, \"sum\": 0.0, \"sumsq\": 0.0}\r\n\u001b[?2004l\r"]
[349.886285, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[349.886341, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[349.886395, "o", "\u001b[?2004h> "]
[349.886555, "o", "def folder(acc, value):\r\n\u001b[?2004l\r"]
[349.886608, "o", "\u001b[?2004h> "]
[349.886996, "o", "    \"\"\"Fold a new temperature value into the accumulator.\"\"\"\r\n\u001b[?2004l\r"]
[349.887047, "o", "\u001b[?2004h> "]
[349.887186, "o", "    acc[\"count\"] += 1\r\n\u001b[?2004l\r"]
[349.887238, "o", "\u001b[?2004h> "]
[349.8874, "o", "    acc[\"sum\"] += value\r\n\u001b[?2004l\r"]
[349.887452, "o", "\u001b[?2004h> "]
[349.887676, "o", "    acc[\"sumsq\"] += value * value\r\n\u001b[?2004l\r"]
[349.887739, "o", "\u001b[?2004h> "]
[349.887854, "o", "    return acc\r\n\u001b[?2004l\r\u001b[?2004h"]
[349.887907, "o", "> \r\n\u001b[?2004l\r"]
[349.88796, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[349.888093, "o", "\u001b[?2004h> "]
[349.888147, "o", "def merger(a, b):\r\n\u001b[?2004l\r"]
[349.888199, "o", "\u001b[?2004h> "]
[349.888543, "o", "    \"\"\"Merge two accumulators when a window is merged.\"\"\"\r\n\u001b[?2004l\r"]
[349.888669, "o", "\u001b[?2004h> "]
[349.888788, "o", "    return {\r\n\u001b[?2004l\r"]
[349.88884, "o", "\u001b[?2004h> "]
[349.889099, "o", "        \"count\": a[\"count\"] + b[\"count\"],\r\n\u001b[?2004l\r"]
[349.889154, "o", "\u001b[?2004h> "]
[349.889385, "o", "        \"sum\": a[\"sum\"] + b[\"sum\"],\r\n\u001b[?2004l\r"]
[349.889438, "o", "\u001b[?2004h> "]
[349.889696, "o", "        \"sumsq\": a[\"sumsq\"] + b[\"sumsq\"],\r\n\u001b[?2004l\r"]
[349.889757, "o", "\u001b[?2004h> "]
[349.889875, "o", "    }\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[349.889926, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[349.889979, "o", "\u001b[?2004h> "]
[349.890116, "o", "def stats(acc):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[349.890521, "o", "    \"\"\"Return mean and population stddev from the accumulator.\"\"\"\r\n\u001b[?2004l\r"]
[349.890573, "o", "\u001b[?2004h> "]
[349.890724, "o", "    n = acc[\"count\"]\r\n\u001b[?2004l\r"]
[349.890782, "o", "\u001b[?2004h> "]
[349.890894, "o", "    if n == 0:\r\n\u001b[?2004l\r"]
[349.890981, "o", "\u001b[?2004h> "]
[349.891092, "o", "        return 0.0, 0.0\r\n\u001b[?2004l\r"]
[349.891139, "o", "\u001b[?2004h> "]
[349.891322, "o", "    mean = acc[\"sum\"] / n\r\n\u001b[?2004l\r"]
[349.891379, "o", "\u001b[?2004h> "]
[349.891669, "o", "    # Population variance from E[x^2] - E[x]^2\r\n\u001b[?2004l\r"]
[349.891741, "o", "\u001b[?2004h> "]
[349.89202, "o", "    var = (acc[\"sumsq\"] / n) - (mean * mean)\r\n\u001b[?2004l\r"]
[349.892079, "o", "\u001b[?2004h> "]
[349.892191, "o", "    if var < 0.0:\r\n\u001b[?2004l\r"]
[349.892249, "o", "\u001b[?2004h> "]
[349.892649, "o", "        # Guard against tiny negative numbers caused by FP error.\r\n\u001b[?2004l\r"]
[349.892764, "o", "\u001b[?2004h> "]
[349.892843, "o", "        var = 0.0\r\n\u001b[?2004l\r"]
[349.892927, "o", "\u001b[?2004h> "]
[349.893031, "o", "    stddev = var ** 0.5\r\n\u001b[?2004l\r"]
[349.893083, "o", "\u001b[?2004h> "]
[349.893239, "o", "    return mean, stddev\r\n\u001b[?2004l\r"]
[349.89329, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[349.893342, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[349.893395, "o", "\u001b[?2004h> "]
[349.893652, "o", "flow = Dataflow(\"sensor_windowing\")\r\n\u001b[?2004l\r"]
[349.893715, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[349.893772, "o", "\u001b[?2004h> "]
[349.894269, "o", "# --- Input: read JSON lines from input.jsonl ---------------------------------\r\n\u001b[?2004l\r"]
[349.89432, "o", "\u001b[?2004h> "]
[349.894532, "o", "src = FileSource(str(INPUT_PATH))\r\n\u001b[?2004l\r"]
[349.894583, "o", "\u001b[?2004h> "]
[349.894817, "o", "inp = op.input(\"input\", flow, src)\r\n\u001b[?2004l\r"]
[349.894869, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[349.894922, "o", "\u001b[?2004h> "]
[349.895156, "o", "# Parse the JSON lines into dicts.\r\n\u001b[?2004l\r"]
[349.895206, "o", "\u001b[?2004h> "]
[349.895612, "o", "parsed = op.map(\"parse_json\", inp, lambda line: json.loads(line))\r\n\u001b[?2004l\r"]
[349.895673, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[349.895736, "o", "\u001b[?2004h> "]
[349.895932, "o", "# Key the stream by sensor_id.\r\n\u001b[?2004l\r"]
[349.895984, "o", "\u001b[?2004h> "]
[349.896499, "o", "keyed = op.key_on(\"key_on_sensor\", parsed, lambda x: x[\"sensor_id\"])\r\n\u001b[?2004l\r"]
[349.896549, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[349.896606, "o", "\u001b[?2004h> "]
[349.89666, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[349.896824, "o", "def to_event(item):\r\n\u001b[?2004l\r"]
[349.896878, "o", "\u001b[?2004h> "]
[349.896982, "o", "    return {\r\n\u001b[?2004l\r"]
[349.897035, "o", "\u001b[?2004h> "]
[349.897304, "o", "        \"sensor_id\": item[\"sensor_id\"],\r\n\u001b[?2004l\r"]
[349.897357, "o", "\u001b[?2004h> "]
[349.897616, "o", "        \"temp\": float(item[\"temp\"]),\r\n\u001b[?2004l\r"]
[349.897719, "o", "\u001b[?2004h> "]
[349.897968, "o", "        \"time\": parse_ts(item[\"time\"]),\r\n\u001b[?2004l\r"]
[349.898022, "o", "\u001b[?2004h> "]
[349.89813, "o", "    }\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[349.898182, "o", "\u001b[?2004h> "]
[349.89857, "o", "events = op.map_value(\"to_event\", keyed, to_event)\r\n\u001b[?2004l\r"]
[349.898652, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[349.898789, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[349.898899, "o", "def extract_ts(event):\r\n\u001b[?2004l\r"]
[349.89897, "o", "\u001b[?2004h> "]
[349.899146, "o", "    return event[\"time\"]\r\n\u001b[?2004l\r"]
[349.899214, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[349.899278, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[349.899343, "o", "\u001b[?2004h> "]
[349.899469, "o", "clock = EventClock(\r\n\u001b[?2004l\r"]
[349.899527, "o", "\u001b[?2004h> "]
[349.899721, "o", "    ts_getter=extract_ts,\r\n\u001b[?2004l\r"]
[349.899789, "o", "\u001b[?2004h> "]
[349.900257, "o", "    wait_for_system_duration=timedelta(seconds=0),\r\n\u001b[?2004l\r\u001b[?2004h"]
[349.900372, "o", "> )\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[349.900433, "o", "\u001b[?2004h> "]
[349.900785, "o", "windower = SlidingWindower(\r\n\u001b[?2004l\r\u001b[?2004h> "]
[349.901004, "o", "    length=timedelta(seconds=60),\r\n\u001b[?2004l\r\u001b[?2004h"]
[349.901057, "o", "> "]
[349.9013, "o", "    offset=timedelta(seconds=30),\r\n\u001b[?2004l\r"]
[349.901373, "o", "\u001b[?2004h> "]
[349.901562, "o", "    align_to=WINDOW_ALIGN,\r\n\u001b[?2004l\r\u001b[?2004h"]
[349.901633, "o", "> )\r\n\u001b[?2004l\r\u001b[?2004h"]
[349.901711, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h"]
[349.901782, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h"]
[349.901879, "o", "> "]
[349.902051, "o", "def folder_value(acc, event):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[349.902355, "o", "    return folder(acc, event[\"temp\"])\r\n\u001b[?2004l\r\u001b[?2004h"]
[349.902475, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[349.902583, "o", "> "]
[349.902692, "o", "windowed = fold_window(\r\n\u001b[?2004l\r\u001b[?2004h"]
[349.90282, "o", "> "]
[349.902927, "o", "    \"fold_window\",\r\n\u001b[?2004l\r\u001b[?2004h> "]
[349.903031, "o", "    events,\r\n\u001b[?2004l\r\u001b[?2004h"]
[349.903136, "o", ">     clock,\r\n\u001b[?2004l\r"]
[349.903239, "o", "\u001b[?2004h> "]
[349.903342, "o", "    windower,\r\n\u001b[?2004l\r\u001b[?2004h> "]
[349.9035, "o", "    builder=builder,\r\n\u001b[?2004l\r\u001b[?2004h"]
[349.903601, "o", "> "]
[349.903729, "o", "    folder=folder_value,\r\n\u001b[?2004l\r"]
[349.903839, "o", "\u001b[?2004h> "]
[349.903941, "o", "    merger=merger,\r\n\u001b[?2004l\r\u001b[?2004h> "]
[349.904051, "o", ")\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[349.90417, "o", "\u001b[?2004h> "]
[349.904609, "o", "# --- Re-key both streams so we can join them by (sensor_id, window_id) ------\r\n\u001b[?2004l\r\u001b[?2004h> "]
[349.904837, "o", "# windowed.down: (sensor_id, (window_id, acc))\r\n\u001b[?2004l\r\u001b[?2004h"]
[349.904894, "o", "> "]
[349.905123, "o", "# windowed.meta: (sensor_id, (window_id, WindowMetadata))\r\n\u001b[?2004l\r\u001b[?2004h"]
[349.905178, "o", "> "]
[349.905491, "o", "# The downstream `op.join` requires string keys, so we combine them into a\r\n\u001b[?2004l\r\u001b[?2004h"]
[349.905545, "o", "> "]
[349.905862, "o", "# composite string key. The original (sensor_id, window_id) is preserved\r\n\u001b[?2004l\r\u001b[?2004h"]
[349.905915, "o", "> "]
[349.906195, "o", "# inside the value tuple, so we can still extract it.\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[349.906294, "o", "\u001b[?2004h> "]
[349.906388, "o", "down_rekeyed = op.key_on(\r\n\u001b[?2004l\r\u001b[?2004h> "]
[349.906477, "o", "    \"down_rekey\",\r\n\u001b[?2004l\r\u001b[?2004h"]
[349.906528, "o", "> "]
[349.906604, "o", "    windowed.down,\r\n\u001b[?2004l\r\u001b[?2004h"]
[349.906727, "o", "> "]
[349.906862, "o", "    lambda item: f\"{item[0]}_{item[1][0]}\",\r\n\u001b[?2004l\r\u001b[?2004h"]
[349.906951, "o", "> )\r\n\u001b[?2004l\r\u001b[?2004h> "]
[349.907078, "o", "meta_rekeyed = op.key_on(\r\n\u001b[?2004l\r\u001b[?2004h"]
[349.907127, "o", "> "]
[349.907232, "o", "    \"meta_rekey\",\r\n\u001b[?2004l\r\u001b[?2004h> "]
[349.907338, "o", "    windowed.meta,\r\n\u001b[?2004l\r"]
[349.907423, "o", "\u001b[?2004h> "]
[349.907585, "o", "    lambda item: f\"{item[0]}_{item[1][0]}\",\r\n\u001b[?2004l\r"]
[349.90768, "o", "\u001b[?2004h> )\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[349.907759, "o", "\u001b[?2004h> "]
[349.907947, "o", "# Join the window values with their metadata.\r\n\u001b[?2004l\r\u001b[?2004h"]
[349.908034, "o", "> "]
[349.908117, "o", "joined = op.join(\r\n\u001b[?2004l\r\u001b[?2004h> "]
[349.908202, "o", "    \"join_meta\",\r\n\u001b[?2004l\r\u001b[?2004h> "]
[349.908304, "o", "    down_rekeyed,\r\n\u001b[?2004l\r\u001b[?2004h"]
[349.908354, "o", "> "]
[349.908437, "o", "    meta_rekeyed,\r\n\u001b[?2004l\r\u001b[?2004h"]
[349.908553, "o", "> )\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[349.908634, "o", "\u001b[?2004h> "]
[349.908742, "o", "def format_output(item):\r\n\u001b[?2004l\r\u001b[?2004h"]
[349.908796, "o", "> "]
[349.909074, "o", "    # item is (new_key, (down_value, meta_value)) where\r\n\u001b[?2004l\r\u001b[?2004h> "]
[349.909318, "o", "    # down_value = (sensor_id, (window_id, acc))\r\n\u001b[?2004l\r\u001b[?2004h"]
[349.909378, "o", "> "]
[349.90963, "o", "    # meta_value = (sensor_id, (window_id, WindowMetadata))\r\n\u001b[?2004l\r\u001b[?2004h"]
[349.909693, "o", "> "]
[349.928792, "o", "    down_value = item[1][0]\r\n\u001b[?2004l\r\u001b[?2004h>     meta_value = item[1][1]\r\n\u001b[?2004l\r\u001b[?2004h>     sensor_id = down_value[0]\r\n\u001b[?2004l\r\u001b[?2004h>     acc = down_value[1][1]\r\n\u001b[?2004l\r\u001b[?2004h>     meta = meta_value[1][1]\r\n\u001b[?2004l\r\u001b[?2004h>     mean, stddev = stats(acc)\r\n\u001b[?2004l\r\u001b[?2004h>     return {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[349.928836, "o", "        \"sensor_id\": sensor_id,\r\n\u001b[?2004l\r\u001b[?2004h> "]
[349.9289, "o", "        \"window_start\": to_iso(meta.open_time),\r\n\u001b[?2004l\r"]
[349.928922, "o", "\u001b[?2004h> "]
[349.929037, "o", "        \"window_end\": to_iso(meta.close_time),\r\n\u001b[?2004l\r"]
[349.929059, "o", "\u001b[?2004h> "]
[349.929111, "o", "        \"mean\": mean,\r\n\u001b[?2004l\r"]
[349.929131, "o", "\u001b[?2004h> "]
[349.929201, "o", "        \"stddev\": stddev,\r\n\u001b[?2004l\r"]
[349.929222, "o", "\u001b[?2004h> "]
[349.929263, "o", "    }\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[349.929291, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[349.929315, "o", "> "]
[349.92945, "o", "formatted = op.map(\"format_output\", joined, format_output)\r\n\u001b[?2004l\r"]
[349.929473, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[349.929512, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[349.929534, "o", "> "]
[349.929573, "o", "def to_kv(record):\r\n\u001b[?2004l\r"]
[349.929595, "o", "\u001b[?2004h> "]
[349.929765, "o", "    # FileSink is partitioned, so items must be (key, value) tuples.\r\n\u001b[?2004l\r"]
[349.929787, "o", "\u001b[?2004h> "]
[349.929954, "o", "    # Use the sensor_id as the partition key and the JSON string as\r\n\u001b[?2004l\r"]
[349.929974, "o", "\u001b[?2004h> "]
[349.930133, "o", "    # the value. The sensor_id is preserved in the JSON itself.\r\n\u001b[?2004l\r"]
[349.93018, "o", "\u001b[?2004h> "]
