[157.001592, "o", "grep -B 2 -A 50 'class FileSink' /usr/local/lib/python3.12/dist-packages/bytewax/connectors/files.py | head -80\r\n\u001b[?2004l\r"]
[157.003544, "o", "\r\n\r\nclass FileSink(FixedPartitionedSink[str, int]):\r\n    \"\"\"Write to a single file line-by-line on the filesystem.\r\n\r\n    Items consumed from the dataflow must look like a string. Use a\r\n    proceeding map step to do custom formatting.\r\n\r\n    The file must exist and be identical on all workers.\r\n\r\n    There is no parallelism; only one worker will actually write to\r\n    the file.\r\n\r\n    Can support exactly-once processing in a batch context. The file\r\n    will be truncated during resume so duplicates are\r\n    prevented. Tailing the output file will result in undefined\r\n    behavior.\r\n    \"\"\"\r\n\r\n    def __init__(self, path: Path, end: str = \"\\n\"):\r\n        \"\"\"Init.\r\n\r\n        :arg path: Path to file.\r\n\r\n        :arg end: String to write after each item. Defaults to\r\n            newline.\r\n\r\n        \"\"\"\r\n        self._path = path\r\n        self._end = end\r\n\r\n    @override\r\n    def list_parts(self) -> List[str]:\r\n        return [str(self._path)]\r\n\r\n    @override"]
[157.00357, "o", "\r\n    def part_fn(self, item_key: str) -> int:\r\n        return 0\r\n\r\n    @override\r\n    def build_part(\r\n        self, step_id: str, for_part: str, resume_state: Optional[int]\r\n    ) -> _FileSinkPartition:\r\n"]
[157.003653, "o", "        # TODO: Warn and return None. Then we could support\r\n        # continuation from a different file.\r\n        assert for_part == str(self._path), \"Can't resume writing to different file\"\r\n        return _FileSinkPartition(self._path, resume_state, self._end)\r\n"]
[157.003967, "o", "\u001b[?2004h"]
[157.003991, "o", "root@2eacb342-88a4-4e90-86f7-a5580b74af48:~/project# "]
[161.779592, "i", "grep -B 2 -A 50 'class FixedPartitionedSink' /usr/local/lib/python3.12/dist-packages/bytewax/outputs.py | head -80\n"]
[161.780463, "o", "grep -B 2 -A 50 'class FixedPartitionedSink' /usr/local/lib/python3.12/dist-packages/bytewax/outputs.py | head -80\r\n\u001b[?2004l\r"]
[161.782078, "o", "\r\n\r\nclass FixedPartitionedSink(Sink[Tuple[str, X]], Generic[X, S]):\r\n    \"\"\"An output sink with a fixed number of independent partitions.\r\n\r\n    Will maintain the state of each partition and re-build using it during\r\n    resume. If the sink supports seeking and overwriting, this output\r\n    can support exactly-once processing.\r\n\r\n    \"\"\"\r\n\r\n    @abstractmethod\r\n    def list_parts(self) -> List[str]:\r\n        \"\"\"List all local partitions this worker has access to.\r\n\r\n        You do not need to list all partitions globally.\r\n\r\n        :returns: Local partition keys.\r\n\r\n        \"\"\"\r\n        ...\r\n\r\n    def part_fn(self, item_key: str) -> int:\r\n        \"\"\"Route incoming `(key, value)` pairs to partitions.\r\n\r\n        Defaults to {py:obj}`zlib.adler32` as a simple consistent\r\n        function.\r\n\r\n        This must be globally consistent across workers and executions\r\n        and return the same hash on every call.\r\n\r\n        A specific partition is chosen by wrapped indexing this value\r\n        into the ordered global set of partitions. (Not just\r\n        partitions local to this worker.)\r\n\r\n        :::{caution}\r\n\r\n        Do not use Python's built in {py:obj}`hash` function here! It\r\n        is [_not consistent between processes by\r\n        default_](inv:python:std:cmdoption#-R) and using it will cause\r\n        incorrect partitioning in cluster executions.\r\n\r\n        :::\r\n\r\n        :arg item_key: Key for the value that is about to be written.\r\n\r\n        :returns: Integer hash value that is used to assign partition.\r\n\r\n        \"\"\"\r\n        return adler32(item_key.encode())\r\n\r\n    @abstractmethod\r\n    def build_part(\r\n"]
[161.78231, "o", "\u001b[?2004hroot@2eacb342-88a4-4e90-86f7-a5580b74af48:~/project# "]
[180.770554, "i", "cat > /root/project/pipeline.py << 'PYEOF'\n\"\"\"Bytewax sliding window temperature processing pipeline.\n\nReads JSON lines from `input.jsonl`, computes sliding-window statistics\n(mean and population standard deviation) of sensor temperatures using\nevent-time windows, and writes JSON lines to `output.jsonl`.\n\nAll state used in windowing is composed of plain Python primitives so\nthat it is fully picklable and can be snapshotted by Bytewax's SQLite\nrecovery mechanism.\n\"\"\"\n\nimport json\nfrom datetime import datetime, timedelta, timezone\nfrom pathlib import Path\n\nfrom bytewax.dataflow import Dataflow\nimport bytewax.operators as op\nfrom bytewax.connectors.files import FileSource, FileSink\nfrom bytewax.operators.windowing import (\n    EventClock,\n    SlidingWindower,\n    fold_window,\n)\n\n\nINPUT_PATH = Path(__file__).parent / \"input.jsonl\"\nOUTPUT_PATH = Path(__file__).parent / \"output.jsonl\"\n\nWINDOW_ALIGN = datetime(2026, 1, 1, 0, 0, 0, tzinfo=timezone.utc)\n\n\ndef parse_ts(value):\n    \"\"\"Parse an ISO8601 string into a timezone-aware UTC datetime.\"\"\"\n    # Handle trailing 'Z' as UTC.\n    if value.endswith(\"Z\"):\n        value = value[:-1] + \"+00:00\"\n    dt = datetime.fromisoformat(value)\n    if dt.tzinfo is None:\n        dt = dt.replace(tzinfo=timezone.utc)\n    else:\n        dt = dt.astimezone(timezone.utc)\n    return dt\n\n\ndef to_iso(dt):\n    \"\"\"Format a datetime as an ISO8601 string in UTC with `Z` suffix.\"\"\"\n    return dt.astimezone(timezone.utc).strftime(\"%Y-%m-%dT%H:%M:%SZ\")\n\n\ndef builder():\n    \"\"\"Build the initial accumulator for a window.\n\n    A plain dict is fully picklable.\n    \"\"\"\n    return {\"count\": 0, \"sum\": 0.0, \"sumsq\": 0.0}\n\n\ndef folder(acc, value):\n    \"\"\"Fold a new temperature value into the accumulator.\"\"\"\n    acc[\"count\"] += 1\n    acc[\"sum\"] += value\n    acc[\"sumsq\"] += value * value\n    return acc\n\n\ndef merger(a, b):\n    \"\"\"Merge two accumulators when a window is merged.\"\"\"\n    return {\n        \"count\": a[\"count\"] + b[\"count\"],\n        \"sum\": a[\"sum\"] + b[\"sum\"],\n        \"sumsq\": a[\"sumsq\"] + b[\"sumsq\"],\n    }\n\n\ndef stats(acc):\n    \"\"\"Return mean and population stddev from the accumulator.\"\"\"\n    n = acc[\"count\"]\n    if n == 0:\n        return 0.0, 0.0\n    mean = acc[\"sum\"] / n\n    # Population variance from E[x^2] - E[x]^2\n    var = (acc[\"sumsq\"] / n) - (mean * mean)\n    if var < 0.0:\n        # Guard against tiny negative numbers caused by FP error.\n        var = 0.0\n    stddev = var ** 0.5\n    return mean, stddev\n\n\nflow = Dataflow(\"sensor_windowing\")\n\n# --- Input: read JSON lines from input.jsonl ---------------------------------\nsrc = FileSource(str(INPUT_PATH))\ninp = op.input(\"input\", flow, src)\n\n# Parse the JSON lines into dicts.\nparsed = op.map(\"parse_json\", inp, lambda line: json.loads(line))\n\n# Key the stream by sensor_id.\nkeyed = op.key_on(\"key_on_sensor\", parsed, lambda x: x[\"sensor_id\"])\n\n\ndef to_event(item):\n    return {\n        \"sensor_id\": item[\"sensor_id\"],\n        \"temp\": float(item[\"temp\"]),\n        \"time\": parse_ts(item[\"time\"]),\n    }\n\nevents = op.map_value(\"to_event\", keyed, to_event)\n\n\ndef extract_ts(event):\n    return event[\"time\"]\n\n\nclock = EventClock(\n    ts_getter=extract_ts,\n    wait_for_system_duration=timedelta(seconds=0),\n)\n\nwindower = SlidingWindower(\n    length=timedelta(seconds=60),\n    offset=timedelta(seconds=30),\n    align_to=WINDOW_ALIGN,\n)\n\n\ndef folder_value(acc, event):\n    return folder(acc, event[\"temp\"])\n\n\nwindowed = fold_window(\n    \"fold_window\",\n    events,\n    clock,\n    windower,\n    builder=builder,\n    folder=folder_value,\n    merger=merger,\n)\n\n# --- Merge window values with metadata so we have open/close times -----------\n# windowed.down keys: (sensor_id, (window_id, acc))\n# windowed.meta keys: (sensor_id, (window_id, WindowMetadata))\njoined = op.join(\n    \"join_meta\",\n    windowed.down,\n    windowed.meta,\n)\n\n\ndef format_output(item):\n    # op.join emits ((key, (left_value, right_value)),).\n    (sensor_id, _window_id) = item[0]\n    left = item[1][0]\n    right = item[1][1]\n    acc = left[1]\n    meta = right[1]\n    mean, stddev = stats(acc)\n    return {\n        \"sensor_"]
[180.770638, "i", "id\": sensor_id,\n        \"window_start\": to_iso(meta.open_time),\n        \"window_end\": to_iso(meta.close_time),\n        \"mean\": mean,\n        \"stddev\": stddev,\n    }\n\n\nformatted = op.map(\"format_output\", joined, format_output)\n\n\ndef to_kv(record):\n    # FileSink is partitioned, so items must be (key, value) tuples.\n    # We use the sensor_id as the partition key and the JSON string as\n    # the value. The sensor_id is preserved in the JSON itself.\n    return (record[\"sensor_id\"], json.dumps(record))\n\n\nkv_stream = op.map(\"to_kv\", formatted, to_kv)\n\n# --- Output: write JSON lines to output.jsonl --------------------------------\n# FileSink requires the file to already exist; it's created by the runner.\nop.output(\n    \"output\",\n    kv_stream,\n    FileSink(str(OUTPUT_PATH)),\n)\nPYEOF\n"]
