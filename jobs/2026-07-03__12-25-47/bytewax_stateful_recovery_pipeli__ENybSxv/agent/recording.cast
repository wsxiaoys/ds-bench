[248.915798, "o", "test.down: ('a', (-1, 3.0))\r\ntest.meta: ('a', (-1, WindowMetadata(open_time=datetime.datetime(2025, 12, 31, 23, 59, 30, tzinfo=datetime.timezone.utc), close_time=datetime.datetime(2026, 1, 1, 0, 0, 30, tzinfo=datetime.timezone.utc), merged_ids=set())))\r\ntest.joined: ('a', ((-1, 3.0), (-1, WindowMetadata(open_time=datetime.datetime(2025, 12, 31, 23, 59, 30, tzinfo=datetime.timezone.utc), close_time=datetime.datetime(2026, 1, 1, 0, 0, 30, tzinfo=datetime.timezone.utc), merged_ids=set()))))\r\n"]
[248.915932, "o", "test.down: ('a', (0, 6.0))\r\ntest.down: ('a', (1, 3.0))\r\ntest.meta: ('a', (0, WindowMetadata(open_time=datetime.datetime(2026, 1, 1, 0, 0, tzinfo=datetime.timezone.utc), close_time=datetime.datetime(2026, 1, 1, 0, 1, tzinfo=datetime.timezone.utc), merged_ids=set())))\r\ntest.meta: ('a', (1, WindowMetadata(open_time=datetime.datetime(2026, 1, 1, 0, 0, 30, tzinfo=datetime.timezone.utc), close_time=datetime.datetime(2026, 1, 1, 0, 1, 30, tzinfo=datetime.timezone.utc), merged_ids=set())))\r\ntest.joined: ('a', ((1, 3.0), (0, WindowMetadata(open_time=datetime.datetime(2026, 1, 1, 0, 0, tzinfo=datetime.timezone.utc), close_time=datetime.datetime(2026, 1, 1, 0, 1, tzinfo=datetime.timezone.utc), merged_ids=set()))))\r\n"]
