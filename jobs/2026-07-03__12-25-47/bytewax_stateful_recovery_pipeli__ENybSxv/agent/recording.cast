[326.929848, "o", "test.down_rekey: ('a_0', ('a', (0, {'count': 3, 'sum': 63.0, 'sumsq': 1325.0})))\r\ntest.down_rekey: ('a_1', ('a', (1, {'count': 1, 'sum': 21.0, 'sumsq': 441.0})))\r\ntest.meta_rekey: ('a_0', ('a', (0, WindowMetadata(open_time=datetime.datetime(2026, 1, 1, 0, 0, tzinfo=datetime.timezone.utc), close_time=datetime.datetime(2026, 1, 1, 0, 1, tzinfo=datetime.timezone.utc), merged_ids=set()))))\r\ntest.meta_rekey: ('a_1', ('a', (1, WindowMetadata(open_time=datetime.datetime(2026, 1, 1, 0, 0, 30, tzinfo=datetime.timezone.utc), close_time=datetime.datetime(2026, 1, 1, 0, 1, 30, tzinfo=datetime.timezone.utc), merged_ids=set()))))\r\n"]
