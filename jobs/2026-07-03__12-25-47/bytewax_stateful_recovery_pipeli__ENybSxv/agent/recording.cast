[326.94384, "o", "\u001b[?2004hroot@2eacb342-88a4-4e90-86f7-a5580b74af48:/tmp# "]
[349.869543, "i", "cat > /root/project/pipeline.py << 'PYEOF'\n\"\"\"Bytewax sliding window temperature processing pipeline.\n\nReads JSON lines from `input.jsonl`, computes sliding-window statistics\n(mean and population standard deviation) of sensor temperatures using\nevent-time windows, and writes JSON lines to `output.jsonl`.\n\nAll state used in windowing is composed of plain Python primitives so\nthat it is fully picklable and can be snapshotted by Bytewax's SQLite\nrecovery mechanism.\n\"\"\"\n\nimport json\nfrom datetime import datetime, timedelta, timezone\nfrom pathlib import Path\n\nfrom bytewax.dataflow import Dataflow\nimport bytewax.operators as op\nfrom bytewax.connectors.files import FileSource, FileSink\nfrom bytewax.operators.windowing import (\n    EventClock,\n    SlidingWindower,\n    fold_window,\n)\n\n\nINPUT_PATH = Path(__file__).parent / \"input.jsonl\"\nOUTPUT_PATH = Path(__file__).parent / \"output.jsonl\"\n\nWINDOW_ALIGN = datetime(2026, 1, 1, 0, 0, 0, tzinfo=timezone.utc)\n\n\ndef parse_ts(value):\n    \"\"\"Parse an ISO8601 string into a timezone-aware UTC datetime.\"\"\"\n    # Handle trailing 'Z' as UTC.\n    if value.endswith(\"Z\"):\n        value = value[:-1] + \"+00:00\"\n    dt = datetime.fromisoformat(value)\n    if dt.tzinfo is None:\n        dt = dt.replace(tzinfo=timezone.utc)\n    else:\n        dt = dt.astimezone(timezone.utc)\n    return dt\n\n\ndef to_iso(dt):\n    \"\"\"Format a datetime as an ISO8601 string in UTC with `Z` suffix.\"\"\"\n    return dt.astimezone(timezone.utc).strftime(\"%Y-%m-%dT%H:%M:%SZ\")\n\n\ndef builder():\n    \"\"\"Build the initial accumulator for a window.\n\n    A plain dict is fully picklable.\n    \"\"\"\n    return {\"count\": 0, \"sum\": 0.0, \"sumsq\": 0.0}\n\n\ndef folder(acc, value):\n    \"\"\"Fold a new temperature value into the accumulator.\"\"\"\n    acc[\"count\"] += 1\n    acc[\"sum\"] += value\n    acc[\"sumsq\"] += value * value\n    return acc\n\n\ndef merger(a, b):\n    \"\"\"Merge two accumulators when a window is merged.\"\"\"\n    return {\n        \"count\": a[\"count\"] + b[\"count\"],\n        \"sum\": a[\"sum\"] + b[\"sum\"],\n        \"sumsq\": a[\"sumsq\"] + b[\"sumsq\"],\n    }\n\n\ndef stats(acc):\n    \"\"\"Return mean and population stddev from the accumulator.\"\"\"\n    n = acc[\"count\"]\n    if n == 0:\n        return 0.0, 0.0\n    mean = acc[\"sum\"] / n\n    # Population variance from E[x^2] - E[x]^2\n    var = (acc[\"sumsq\"] / n) - (mean * mean)\n    if var < 0.0:\n        # Guard against tiny negative numbers caused by FP error.\n        var = 0.0\n    stddev = var ** 0.5\n    return mean, stddev\n\n\nflow = Dataflow(\"sensor_windowing\")\n\n# --- Input: read JSON lines from input.jsonl ---------------------------------\nsrc = FileSource(str(INPUT_PATH))\ninp = op.input(\"input\", flow, src)\n\n# Parse the JSON lines into dicts.\nparsed = op.map(\"parse_json\", inp, lambda line: json.loads(line))\n\n# Key the stream by sensor_id.\nkeyed = op.key_on(\"key_on_sensor\", parsed, lambda x: x[\"sensor_id\"])\n\n\ndef to_event(item):\n    return {\n        \"sensor_id\": item[\"sensor_id\"],\n        \"temp\": float(item[\"temp\"]),\n        \"time\": parse_ts(item[\"time\"]),\n    }\n\nevents = op.map_value(\"to_event\", keyed, to_event)\n\n\ndef extract_ts(event):\n    return event[\"time\"]\n\n\nclock = EventClock(\n    ts_getter=extract_ts,\n    wait_for_system_duration=timedelta(seconds=0),\n)\n\nwindower = SlidingWindower(\n    length=timedelta(seconds=60),\n    offset=timedelta(seconds=30),\n    align_to=WINDOW_ALIGN,\n)\n\n\ndef folder_value(acc, event):\n    return folder(acc, event[\"temp\"])\n\n\nwindowed = fold_window(\n    \"fold_window\",\n    events,\n    clock,\n    windower,\n    builder=builder,\n    folder=folder_value,\n    merger=merger,\n)\n\n# --- Re-key both streams so we can join them by (sensor_id, window_id) ------\n# windowed.down: (sensor_id, (window_id, acc))\n# windowed.meta: (sensor_id, (window_id, WindowMetadata))\n# The downstream `op.join` requires string keys, so we combine them into a\n# composite string key. The original (sensor_id, window_id) is preserved\n# inside the value tuple, so we can still extract it.\n\ndown_rekeyed = op.key_on(\n    \"down_rekey\",\n    windowed.down,\n    lambda item: f\"{item[0]}_{item[1][0]}\",\n)\nmeta_rekeyed = op.key_on(\n    \"meta_re"]
[349.86973, "i", "key\",\n    windowed.meta,\n    lambda item: f\"{item[0]}_{item[1][0]}\",\n)\n\n# Join the window values with their metadata.\njoined = op.join(\n    \"join_meta\",\n    down_rekeyed,\n    meta_rekeyed,\n)\n\n\ndef format_output(item):\n    # item is (new_key, (down_value, meta_value)) where\n    # down_value = (sensor_id, (window_id, acc))\n    # meta_value = (sensor_id, (window_id, WindowMetadata))\n    down_value = item[1][0]\n    meta_value = item[1][1]\n    sensor_id = down_value[0]\n    acc = down_value[1][1]\n    meta = meta_value[1][1]\n    mean, stddev = stats(acc)\n    return {\n        \"sensor_id\": sensor_id,\n        \"window_start\": to_iso(meta.open_time),\n        \"window_end\": to_iso(meta.close_time),\n        \"mean\": mean,\n        \"stddev\": stddev,\n    }\n\n\nformatted = op.map(\"format_output\", joined, format_output)\n\n\ndef to_kv(record):\n    # FileSink is partitioned, so items must be (key, value) tuples.\n    # Use the sensor_id as the partition key and the JSON string as\n    # the value. The sensor_id is preserved in the JSON itself.\n    return (record[\"sensor_id\"], json.dumps(record))\n\n\nkv_stream = op.map(\"to_kv\", formatted, to_kv)\n\n# --- Output: write JSON lines to output.jsonl --------------------------------\nop.output(\n    \"output\",\n    kv_stream,\n    FileSink(str(OUTPUT_PATH)),\n)\nPYEOF\n"]
