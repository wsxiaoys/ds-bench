[92.186007, "o", "{\"sensor_id\": \"sensor_a\", \"time\": \"2026-01-01T00:00:10Z\", \"temp\": 20.0}\r\n{\"sensor_id\": \"sensor_a\", \"time\": \"2026-01-01T00:00:25Z\", \"temp\": 22.0}\r\n{\"sensor_id\": \"sensor_a\", \"time\": \"2026-01-01T00:00:40Z\", \"temp\": 21.0}\r\n{\"sensor_id\": \"sensor_a\", \"time\": \"2026-01-01T00:00:55Z\", \"temp\": 19.0}\r\n{\"sensor_id\": \"sensor_a\", \"time\": \"2026-01-01T00:01:10Z\", \"temp\": 23.0}\r\n{\"sensor_id\": \"sensor_b\", \"time\": \"2026-01-01T00:00:15Z\", \"temp\": 10.0}\r\n{\"sensor_id\": \"sensor_b\", \"time\": \"2026-01-01T00:00:45Z\", \"temp\": 12.0}\r\n{\"sensor_id\": \"sensor_b\", \"time\": \"2026-01-01T00:01:05Z\", \"temp\": 11.0}\r\n{\"sensor_id\": \"sensor_b\", \"time\": \"2026-01-01T00:01:30Z\", \"temp\": 13.0}\r\n"]
