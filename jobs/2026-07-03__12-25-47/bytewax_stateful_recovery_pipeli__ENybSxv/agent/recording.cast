[111.67005, "o", "    return dt.astimezone(timezone.utc).strftime(\"%Y-%m-%dT%H:%M:%SZ\")\r\n"]
[111.670074, "o", "\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[111.670102, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[111.670126, "o", "\u001b[?2004h> "]
[111.670194, "o", "def builder():\r\n\u001b[?2004l\r\u001b[?2004h> "]
[111.670312, "o", "    \"\"\"Build the initial accumulator for a window.\r\n\u001b[?2004l\r"]
[111.670335, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[111.670358, "o", "\u001b[?2004h> "]
[111.67045, "o", "    A plain dict is fully picklable.\r\n\u001b[?2004l\r"]
[111.670473, "o", "\u001b[?2004h> "]
[111.670498, "o", "    \"\"\"\r\n\u001b[?2004l\r"]
[111.67052, "o", "\u001b[?2004h> "]
[111.670643, "o", "    return {\"count\": 0, \"sum\": 0.0, \"sumsq\": 0.0}\r\n\u001b[?2004l\r"]
[111.67068, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[111.670706, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[111.670783, "o", "def folder(acc, value):\r\n\u001b[?2004l\r"]
[111.670819, "o", "\u001b[?2004h> "]
[111.670947, "o", "    \"\"\"Fold a new temperature value into the accumulator.\"\"\"\r\n\u001b[?2004l\r"]
[111.67097, "o", "\u001b[?2004h> "]
[111.671027, "o", "    acc[\"count\"] += 1\r\n\u001b[?2004l\r"]
[111.671051, "o", "\u001b[?2004h> "]
[111.671113, "o", "    acc[\"sum\"] += value\r\n\u001b[?2004l\r"]
[111.671137, "o", "\u001b[?2004h> "]
[111.671222, "o", "    acc[\"sumsq\"] += value * value\r\n\u001b[?2004l\r"]
[111.671245, "o", "\u001b[?2004h> "]
[111.671291, "o", "    return acc\r\n\u001b[?2004l\r\u001b[?2004h"]
[111.671314, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h"]
[111.671337, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h"]
[111.671362, "o", "> "]
[111.671424, "o", "def merger(a, b):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[111.671569, "o", "    \"\"\"Merge two accumulators when a window is merged.\"\"\"\r\n\u001b[?2004l\r"]
[111.671608, "o", "\u001b[?2004h> "]
[111.671642, "o", "    return {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[111.671759, "o", "        \"count\": a[\"count\"] + b[\"count\"],\r\n\u001b[?2004l\r"]
[111.671783, "o", "\u001b[?2004h> "]
[111.671869, "o", "        \"sum\": a[\"sum\"] + b[\"sum\"],\r\n\u001b[?2004l\r"]
[111.671892, "o", "\u001b[?2004h> "]
[111.671996, "o", "        \"sumsq\": a[\"sumsq\"] + b[\"sumsq\"],\r\n\u001b[?2004l\r"]
[111.672018, "o", "\u001b[?2004h> "]
[111.672068, "o", "    }\r\n\u001b[?2004l\r\u001b[?2004h"]
[111.672101, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[111.672146, "o", "def stats(acc):\r\n\u001b[?2004l\r"]
[111.672169, "o", "\u001b[?2004h> "]
[111.672329, "o", "    \"\"\"Return mean and population stddev from the accumulator.\"\"\"\r\n\u001b[?2004l\r"]
[111.672352, "o", "\u001b[?2004h> "]
[111.672407, "o", "    n = acc[\"count\"]\r\n\u001b[?2004l\r"]
[111.672431, "o", "\u001b[?2004h> "]
[111.672476, "o", "    if n == 0:\r\n\u001b[?2004l\r\u001b[?2004h"]
[111.672499, "o", "> "]
[111.672555, "o", "        return 0.0, 0.0\r\n\u001b[?2004l\r"]
[111.672578, "o", "\u001b[?2004h> "]
[111.672644, "o", "    mean = acc[\"sum\"] / n\r\n\u001b[?2004l\r"]
[111.672667, "o", "\u001b[?2004h> "]
[111.672791, "o", "    # population variance from E[x^2] - E[x]^2\r\n\u001b[?2004l\r"]
[111.672815, "o", "\u001b[?2004h> "]
[111.67292, "o", "    var = (acc[\"sumsq\"] / n) - (mean * mean)\r\n\u001b[?2004l\r"]
[111.672944, "o", "\u001b[?2004h> "]
[111.672992, "o", "    if var < 0.0:\r\n\u001b[?2004l\r"]
[111.673016, "o", "\u001b[?2004h> "]
[111.673178, "o", "        # Guard against tiny negative numbers caused by FP error.\r\n\u001b[?2004l\r"]
[111.673221, "o", "\u001b[?2004h> "]
[111.673255, "o", "        var = 0.0\r\n\u001b[?2004l\r\u001b[?2004h"]
[111.673291, "o", "> "]
[111.673335, "o", "    stddev = var ** 0.5\r\n\u001b[?2004l\r"]
[111.673358, "o", "\u001b[?2004h> "]
[111.67342, "o", "    return mean, stddev\r\n\u001b[?2004l\r"]
[111.673444, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[111.673466, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[111.673491, "o", "\u001b[?2004h> "]
[111.673582, "o", "flow = Dataflow(\"sensor_windowing\")\r\n\u001b[?2004l\r"]
[111.673605, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[111.673629, "o", "\u001b[?2004h> "]
[111.673829, "o", "# --- Input: read JSON lines from input.jsonl ---------------------------------\r\n\u001b[?2004l\r"]
[111.673856, "o", "\u001b[?2004h> "]
[111.673935, "o", "src = FileSource(str(INPUT_PATH))\r\n\u001b[?2004l\r"]
[111.673958, "o", "\u001b[?2004h> "]
[111.674045, "o", "inp = op.input(\"input\", flow, src)\r\n\u001b[?2004l\r"]
[111.674068, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[111.674092, "o", "\u001b[?2004h> "]
[111.674175, "o", "# Parse the JSON lines into dicts.\r\n\u001b[?2004l\r"]
[111.674199, "o", "\u001b[?2004h> "]
[111.674363, "o", "parsed = op.map(\"parse_json\", inp, lambda line: json.loads(line))\r\n\u001b[?2004l\r\u001b[?2004h"]
[111.674408, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h"]
[111.674441, "o", "> "]
[111.674477, "o", "# Key the stream by sensor_id.\r\n\u001b[?2004l\r"]
[111.6745, "o", "\u001b[?2004h> "]
[111.674702, "o", "keyed = op.key_on(\"key_on_sensor\", parsed, lambda x: x[\"sensor_id\"])\r\n\u001b[?2004l\r"]
[111.674751, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[111.674778, "o", "\u001b[?2004h> "]
[111.674952, "o", "# Convert the ISO8601 string to a timezone-aware UTC datetime in a separate\r\n\u001b[?2004l\r"]
[111.674975, "o", "\u001b[?2004h> "]
[111.675155, "o", "# value field so that downstream ts_getter can extract it.\r\n\u001b[?2004l\r\u001b[?2004h> "]
[111.675298, "o", "# We keep the sensor_id on the value as (temp, time_dt).\r\n\u001b[?2004l\r"]
[111.675324, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[111.675401, "o", "> def to_event(item):\r\n\u001b[?2004l\r\u001b[?2004h"]
[111.675453, "o", "> "]
[111.675479, "o", "    return {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[111.675574, "o", "        \"sensor_id\": item[\"sensor_id\"],\r\n\u001b[?2004l\r"]
[111.675596, "o", "\u001b[?2004h> "]
[111.675683, "o", "        \"temp\": float(item[\"temp\"]),\r\n\u001b[?2004l\r"]
[111.67571, "o", "\u001b[?2004h> "]
[111.675815, "o", "        \"time\": parse_ts(item[\"time\"]),\r\n\u001b[?2004l\r"]
[111.675834, "o", "\u001b[?2004h> "]
[111.675878, "o", "    }\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[111.675898, "o", "\u001b[?2004h> "]
[111.676029, "o", "events = op.map_value(\"to_event\", keyed, to_event)\r\n\u001b[?2004l\r"]
[111.676049, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[111.676091, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[111.676149, "o", "def extract_ts(event):\r\n\u001b[?2004l\r"]
[111.676173, "o", "\u001b[?2004h> "]
[111.676233, "o", "    return event[\"time\"]\r\n\u001b[?2004l\r"]
[111.676252, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[111.676295, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[111.676345, "o", "clock = EventClock(\r\n\u001b[?2004l\r"]
[111.676365, "o", "\u001b[?2004h> "]
[111.67643, "o", "    ts_getter=extract_ts,\r\n\u001b[?2004l\r"]
[111.67645, "o", "\u001b[?2004h> "]
[111.676575, "o", "    wait_for_system_duration=timedelta(seconds=0),\r\n\u001b[?2004l\r"]
[111.676594, "o", "\u001b[?2004h> )\r\n\u001b[?2004l\r"]
[111.676637, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[111.676718, "o", "windower = SlidingWindower(\r\n\u001b[?2004l\r"]
[111.676737, "o", "\u001b[?2004h> "]
[111.676822, "o", "    length=timedelta(seconds=60),\r\n\u001b[?2004l\r"]
[111.67684, "o", "\u001b[?2004h> "]
[111.676923, "o", "    offset=timedelta(seconds=30),\r\n\u001b[?2004l\r"]
[111.676942, "o", "\u001b[?2004h> "]
[111.677012, "o", "    align_to=WINDOW_ALIGN,\r\n\u001b[?2004l\r"]
[111.677034, "o", "\u001b[?2004h> )\r\n\u001b[?2004l\r"]
[111.677057, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[111.67708, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[111.677144, "o", "\u001b[?2004h> "]
[111.677187, "o", "def folder_value(acc, event):\r\n\u001b[?2004l\r"]
[111.677207, "o", "\u001b[?2004h> "]
[111.677312, "o", "    return folder(acc, event[\"temp\"])\r\n\u001b[?2004l\r"]
[111.677331, "o", "\u001b[?2004h> "]
[111.677376, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[111.67744, "o", "windowed = fold_window(\r\n\u001b[?2004l\r"]
[111.677474, "o", "\u001b[?2004h> "]
[111.677516, "o", "    \"fold_window\",\r\n\u001b[?2004l\r"]
[111.677535, "o", "\u001b[?2004h> "]
[111.677572, "o", "    events,\r\n\u001b[?2004l\r"]
[111.677592, "o", "\u001b[?2004h> "]
[111.677622, "o", "    clock,\r\n\u001b[?2004l\r"]
[111.677662, "o", "\u001b[?2004h> "]
[111.677683, "o", "    windower,\r\n\u001b[?2004l\r"]
[111.677731, "o", "\u001b[?2004h> "]
[111.677766, "o", "    builder=builder,\r\n\u001b[?2004l\r\u001b[?2004h"]
[111.677786, "o", "> "]
[111.677846, "o", "    folder=folder_value,\r\n\u001b[?2004l\r"]
[111.677867, "o", "\u001b[?2004h> "]
[111.677918, "o", "    merger=merger,\r\n\u001b[?2004l\r"]
[111.677938, "o", "\u001b[?2004h> )\r\n"]
[111.677982, "o", "\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[111.678002, "o", "> "]
[111.678188, "o", "# --- Merge window values with metadata so we have open/close times -----------\r\n\u001b[?2004l\r"]
[111.678226, "o", "\u001b[?2004h> "]
[111.678363, "o", "# windowed.down keys: (sensor_id, (window_id, acc))\r\n\u001b[?2004l\r"]
[111.678381, "o", "\u001b[?2004h> "]
[111.678574, "o", "# windowed.meta keys: (sensor_id, (window_id, WindowMetadata))\r\n\u001b[?2004l\r"]
[111.678592, "o", "\u001b[?2004h> "]
[111.678639, "o", "joined = op.join(\r\n\u001b[?2004l\r"]
[111.678656, "o", "\u001b[?2004h> "]
[111.678716, "o", "    \"join_meta\",\r\n\u001b[?2004l\r"]
[111.678735, "o", "\u001b[?2004h> "]
[111.678784, "o", "    windowed.down,\r\n\u001b[?2004l\r"]
[111.678801, "o", "\u001b[?2004h> "]
[111.678858, "o", "    windowed.meta,\r\n\u001b[?2004l\r"]
[111.678877, "o", "\u001b[?2004h> )\r\n"]
[111.678915, "o", "\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[111.678941, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[111.67896, "o", "> "]
[111.67902, "o", "def format_output(item):\r\n\u001b[?2004l\r"]
[111.679039, "o", "\u001b[?2004h> "]
[111.679188, "o", "    # item is a tuple (key, (down_value, meta_value)) where\r\n\u001b[?2004l\r"]
[111.679207, "o", "\u001b[?2004h> "]
[111.679296, "o", "    # key = (sensor_id, window_id)\r\n\u001b[?2004l\r"]
[111.679315, "o", "\u001b[?2004h> "]
[111.679406, "o", "    # down_value = (window_id, acc)\r\n\u001b[?2004l\r"]
[111.679425, "o", "\u001b[?2004h> "]
[111.679545, "o", "    # meta_value = (window_id, WindowMetadata)\r\n\u001b[?2004l\r"]
[111.679565, "o", "\u001b[?2004h> "]
[111.679723, "o", "    # op.join emits (key, (left_value, right_value)) tuples.\r\n\u001b[?2004l\r"]
[111.679746, "o", "\u001b[?2004h> "]
[111.679807, "o", "    sensor_id = item[0][0]\r\n\u001b[?2004l\r"]
[111.679827, "o", "\u001b[?2004h> "]
[111.679885, "o", "    left = item[1][0]\r\n\u001b[?2004l\r"]
[111.679903, "o", "\u001b[?2004h> "]
[111.679965, "o", "    right = item[1][1]\r\n\u001b[?2004l\r"]
[111.679984, "o", "\u001b[?2004h> "]
[111.680033, "o", "    acc = left[1]\r\n\u001b[?2004l\r"]
[111.680052, "o", "\u001b[?2004h> "]
[111.680107, "o", "    meta = right[1]\r\n\u001b[?2004l\r"]
[111.680126, "o", "\u001b[?2004h> "]
[111.680204, "o", "    mean, stddev = stats(acc)\r\n\u001b[?2004l\r"]
[111.680223, "o", "\u001b[?2004h> "]
[111.680261, "o", "    return {\r\n\u001b[?2004l\r"]
[111.68028, "o", "\u001b[?2004h> "]
[111.680383, "o", "        \"sensor_id\": sensor_id,\r\n\u001b[?2004l\r\u001b[?2004h"]
[111.680428, "o", "> "]
[111.68051, "o", "        \"window_start\": to_iso(meta.open_time),\r\n\u001b[?2004l\r"]
[111.680535, "o", "\u001b[?2004h> "]
[111.680662, "o", "        \"window_end\": to_iso(meta.close_time),\r\n\u001b[?2004l\r\u001b[?2004h"]
[111.68069, "o", "> "]
[111.680773, "o", "        \"mean\": mean,\r\n\u001b[?2004l\r\u001b[?2004h> "]
[111.68083, "o", "        \"stddev\": stddev,\r\n\u001b[?2004l\r\u001b[?2004h"]
[111.680854, "o", ">     }\r\n"]
[111.680877, "o", "\u001b[?2004l\r\u001b[?2004h"]
[111.68093, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[111.68095, "o", "> "]
[111.681089, "o", "formatted = op.map(\"format_output\", joined, format_output)\r\n\u001b[?2004l\r"]
[111.681107, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[111.681125, "o", "\u001b[?2004h> "]
[111.681202, "o", "\r\n\u001b[?2004l\r\u001b[?2004h"]
[111.681223, "o", "> def to_json_line(d):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[111.681297, "o", "    return json.dumps(d)\r\n\u001b[?2004l\r"]
[111.681317, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[111.681337, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[111.681392, "o", "\u001b[?2004h> "]
[111.681523, "o", "json_lines = op.map(\"to_json_line\", formatted, to_json_line)\r\n\u001b[?2004l\r"]
[111.681545, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[111.681565, "o", "> "]
[111.681775, "o", "# --- Output: write JSON lines to output.jsonl --------------------------------\r\n\u001b[?2004l\r"]
[111.681797, "o", "\u001b[?2004h> "]
[111.681984, "o", "# FileSink requires the file to already exist; it's created by the runner.\r\n\u001b[?2004l\r"]
[111.682003, "o", "\u001b[?2004h> "]
[111.682035, "o", "op.output(\r\n\u001b[?2004l\r"]
[111.682054, "o", "\u001b[?2004h> "]
[111.682106, "o", "    \"output\",\r\n\u001b[?2004l\r\u001b[?2004h"]
[111.682126, "o", "> "]
[111.682173, "o", "    json_lines,\r\n\u001b[?2004l\r\u001b[?2004h"]
[111.682193, "o", "> "]
[111.682276, "o", "    FileSink(str(OUTPUT_PATH)),\r\n\u001b[?2004l\r"]
[111.682296, "o", "\u001b[?2004h> )\r\n"]
[111.682319, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[111.682373, "o", "PYEOF\r\n\u001b[?2004l\r"]
[111.683453, "o", "\u001b[?2004hroot@2eacb342-88a4-4e90-86f7-a5580b74af48:~/project# "]
[112.229197, "i", "ls -la /root/project/\n"]
[112.22935, "o", "ls -la /root/project/\r\n\u001b[?2004l\r"]
[112.230882, "o", "total 12\r\n"]
[112.230968, "o", "drwxr-xr-x 2 root root   64 Jul  3 14:15 \u001b[0m\u001b[01;34m.\u001b[0m\r\ndrwx------ 1 root root   68 Jul  3 14:14 \u001b[01;34m..\u001b[0m\r\n-rw-r--r-- 1 root root  648 Jul  3 14:14 input.jsonl\r\n-rw-r--r-- 1 root root    0 Jul  3 14:14 output.jsonl\r\n-rw-r--r-- 1 root root 5013 Jul  3 14:15 pipeline.py\r\n"]
[112.231136, "o", "\u001b[?2004hroot@2eacb342-88a4-4e90-86f7-a5580b74af48:~/project# "]
[117.144067, "i", "cd /root/project && python3 -c '\nimport pickle\nfrom pipeline import builder, folder, merger\nacc = builder()\nacc = folder(acc, 20.0)\nacc = folder(acc, 22.0)\nprint(\"acc:\", acc)\nprint(\"pickled:\", pickle.dumps(acc)[:50])\n\nacc2 = merger(builder(), acc)\nprint(\"merged:\", acc2)\nprint(\"merged pickled:\", pickle.dumps(acc2)[:50])\n'\n"]
[117.144294, "o", "cd /root/project && python3 -c '\r\n\u001b[?2004l\r"]
[117.144341, "o", "\u001b[?2004h> "]
