def format_output(item):
    # op.join emits ((key, (left_value, right_value)),).
    (sensor_id, _window_id) = item[0]
    left = item[1][0]
    right = item[1][1]
    acc = left[1]
    meta = right[1]
    mean, stddev = stats(acc)
    return {
        "sensor_id": sensor_id,
        "window_start": to_iso(meta.open_time),
        "window_end": to_iso(meta.close_time),
        "mean": mean,
        "stddev": stddev,
    }


formatted = op.map("format_output", joined, format_output)


