[?2004hroot@2eacb342-88a4-4e90-86f7-a5580b74af48:~/project# cat > /root/project/pipeline.py << 'PYEOF'
[?2004l[?2004h> """Bytewax sliding window temperature processing pipeline.
[?2004l[?2004h> 
[?2004l[?2004h> Reads JSON lines from `input.jsonl`, computes sliding-window statistics
[?2004l[?2004h> (mean and population standard deviation) of sensor temperatures using
[?2004l[?2004h> event-time windows, and writes JSON lines to `output.jsonl`.
[?2004l[?2004h> 
[?2004l[?2004h> All state used in windowing is composed of plain Python primitives so
[?2004l[?2004h> that it is fully picklable and can be snapshotted by Bytewax's SQLite
[?2004l[?2004h> recovery mechanism.
[?2004l[?2004h> """
[?2004l[?2004h> 
[?2004l[?2004h> import json
[?2004l[?2004h> from datetime import datetime, timedelta, timezone
[?2004l[?2004h> from pathlib import Path
[?2004l[?2004h> from statistics import pstdev
[?2004l[?2004h> 
[?2004lp[?2004h> from bytewax.dataflow import Dataflow
[?2004l[?2004h> import bytewax.operators as op
[?2004l[?2004h> from bytewax.connectors.files import FileSource, FileSink
[?2004l[?2004h> from bytewax.operators.windowing import (
[?2004l[?2004h>     EventClock,
[?2004l[?2004h>     SlidingWindower,
[?2004l[?2004h>     fold_window,
[?2004l[?2004h> )
[?2004l[?2004h> 
[?2004l[?2004h> 
[?2004l[?2004h> INPUT_PATH = Path(__file__).parent / "input.jsonl"
[?2004l[?2004h> OUTPUT_PATH = Path(__file__).parent / "output.jsonl"
[?2004l[?2004h> 
[?2004l[?2004h> WINDOW_ALIGN = datetime(2026, 1, 1, 0, 0, 0, tzinfo=timezone.utc)
[?2004l[?2004h> 
[?2004l[?2004h> 
[?2004l[?2004h> def parse_ts(value):
[?2004l[?2004h>     """Parse an ISO8601 string into a timezone-aware UTC datetime."""
[?2004l[?2004h>     # Handle trailing 'Z' as UTC.
[?2004l[?2004h>     if value.endswith("Z"):
[?2004l[?2004h>         value = value[:-1] + "+00:00"
[?2004l[?2004h>     dt = datetime.fromisoformat(value)
[?2004l[?2004h>     if dt.tzinfo is None:
[?2004l[?2004h>         dt = dt.replace(tzinfo=timezone.utc)
[?2004l[?2004h>     else:
[?2004l[?2004h>         dt = dt.astimezone(timezone.utc)
[?2004l[?2004h>     return dt
[?2004l[?2004h> 
[?2004l[?2004h> 
[?2004l[?2004h> def to_iso(dt):
[?2004l[?2004h>     """Format a datetime as an ISO8601 string in UTC with `Z` suffix."""
[?2004l[?2004h>     return dt.astimezone(timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ")
[?2004l[?2004h> 
[?2004l[?2004h> 
[?2004l[?2004h> def builder():
[?2004l[?2004h>     """Build the initial accumulator for a window.
[?2004l[?2004h> 
[?2004l[?2004h>     A plain dict is fully picklable.
[?2004l[?2004h>     """
[?2004l[?2004h>     return {"count": 0, "sum": 0.0, "sumsq": 0.0}
[?2004l[?2004h> 
[?2004l[?2004h> 
[?2004l[?2004h> def folder(acc, value):
[?2004l[?2004h>     """Fold a new temperature value into the accumulator."""
[?2004l[?2004h>     acc["count"] += 1
[?2004l[?2004h>     acc["sum"] += value
[?2004l[?2004h>     acc["sumsq"] += value * value
[?2004l[?2004h>     return acc
[?2004l[?2004h> 
[?2004l[?2004h> 
[?2004l[?2004h> def merger(a, b):
[?2004l[?2004h>     """Merge two accumulators when a window is merged."""
[?2004l[?2004h>     return {
[?2004l[?2004h>         "count": a["count"] + b["count"],
[?2004l[?2004h>         "sum": a["sum"] + b["sum"],
[?2004l[?2004h>         "sumsq": a["sumsq"] + b["sumsq"],
[?2004l[?2004h>     }
[?2004l[?2004h> 
[?2004l[?2004h> 
[?2004l[?2004h> def stats(acc):
[?2004l[?2004h>     """Return mean and population stddev from the accumulator."""
[?2004l[?2004h>     n = acc["count"]
[?2004l[?2004h>     if n == 0:
[?2004l[?2004h>         return 0.0, 0.0
[?2004l[?2004h>     mean = acc["sum"] / n
[?2004l[?2004h>     # population variance from E[x^2] - E[x]^2
[?2004l[?2004h>     var = (acc["sumsq"] / n) - (mean * mean)
[?2004l[?2004h>     if var < 0.0:
[?2004l[?2004h>         # Guard against tiny negative numbers caused by FP error.
[?2004l[?2004h>         var = 0.0
[?2004l[?2004h>     stddev = var ** 0.5
[?2004l[?2004h>     return mean, stddev
[?2004l[?2004h> 
[?2004l[?2004h> 
[?2004l[?2004h> flow = Dataflow("sensor_windowing")
[?2004l[?2004h> 
[?2004l[?2004h> # --- Input: read JSON lines from input.jsonl ---------------------------------
[?2004l[?2004h> src = FileSource(str(INPUT_PATH))
[?2004l[?2004h> inp = op.input("input", flow, src)
[?2004l[?2004h> 
[?2004l[?2004h> # Parse the JSON lines into dicts.
[?2004l[?2004h> parsed = op.map("parse_json", inp, lambda line: json.loads(line))
[?2004l[?2004h> 
[?2004l[?2004h> # Key the stream by sensor_id.
[?2004l[?2004h> keyed = op.key_on("key_on_sensor", parsed, lambda x: x["sensor_id"])
[?2004l[?2004h> 
[?2004l[?2004h> # Convert the ISO8601 string to a timezone-aware UTC datetime in a separate
[?2004l[?2004h> # value field so that downstream ts_getter can extract it.
[?2004l[?2004h> # We keep the sensor_id on the value as (temp, time_dt).
[?2004l[?2004h> 
[?2004l[?2004h> def to_event(item):
[?2004l[?2004h>     return {
[?2004l[?2004h>         "sensor_id": item["sensor_id"],
[?2004l[?2004h>         "temp": float(item["temp"]),
[?2004l[?2004h>         "time": parse_ts(item["time"]),
[?2004l[?2004h>     }
[?2004l[?2004h> 
[?2004l[?2004h> events = op.map_value("to_event", keyed, to_event)
[?2004l[?2004h> 
[?2004l[?2004h> 
[?2004l[?2004h> def extract_ts(event):
[?2004l[?2004h>     return event["time"]
[?2004l[?2004h> 
[?2004l[?2004h> 
[?2004l[?2004h> clock = EventClock(
[?2004l[?2004h>     ts_getter=extract_ts,
[?2004l[?2004h>     wait_for_system_duration=timedelta(seconds=0),
[?2004l[?2004h> )
[?2004l[?2004h> 
[?2004l[?2004h> windower = SlidingWindower(
[?2004l[?2004h>     length=timedelta(seconds=60),
[?2004l[?2004h>     offset=timedelta(seconds=30),
[?2004l[?2004h>     align_to=WINDOW_ALIGN,
[?2004l[?2004h> )
[?2004l[?2004h> 
[?2004l[?2004h> 
[?2004l[?2004h> def folder_value(acc, event):
[?2004l[?2004h>     return folder(acc, event["temp"])
[?2004l[?2004h> 
[?2004l[?2004h> 
[?2004l[?2004h> windowed = fold_window(
[?2004l[?2004h>     "fold_window",
[?2004l[?2004h>     events,
[?2004l[?2004h>     clock,
[?2004l[?2004h>     windower,
[?2004l[?2004h>     builder=builder,
[?2004l[?2004h>     folder=folder_value,
[?2004l[?2004h>     merger=merger,
[?2004l[?2004h> )
[?2004l[?2004h> 
[?2004l[?2004h> # --- Merge window values with metadata so we have open/close times -----------
[?2004l[?2004h> # windowed.down keys: (sensor_id, (window_id, acc))
[?2004l[?2004h> # windowed.meta keys: (sensor_id, (window_id, WindowMetadata))
[?2004l[?2004h> joined = op.join(
[?2004l[?2004h>     "join_meta",
[?2004l[?2004h>     windowed.down,
[?2004l[?2004h>     windowed.meta,
[?2004l[?2004h> )
[?2004l[?2004h> 
[?2004l[?2004h> 
[?2004l[?2004h> def format_output(item):
[?2004l[?2004h>     # item is a tuple (key, (down_value, meta_value)) where
[?2004l[?2004h>     # key = (sensor_id, window_id)
[?2004l[?2004h>     # down_value = (window_id, acc)
[?2004l[?2004h>     # meta_value = (window_id, WindowMetadata)
[?2004l[?2004h>     # op.join emits (key, (left_value, right_value)) tuples.
[?2004l[?2004h>     sensor_id = item[0][0]
[?2004l[?2004h>     left = item[1][0]
[?2004l[?2004h>     right = item[1][1]
[?2004l[?2004h>     acc = left[1]
[?2004l[?2004h>     meta = right[1]
[?2004l[?2004h>     mean, stddev = stats(acc)
[?2004l[?2004h>     return {
[?2004l[?2004h>         "sensor_id": sensor_id,
[?2004l[?2004h>         "window_start": to_iso(meta.open_time),
[?2004l[?2004h>         "window_end": to_iso(meta.close_time),
[?2004l[?2004h>         "mean": mean,
[?2004l[?2004h>         "stddev": stddev,
[?2004l[?2004h>     }
[?2004l[?2004h> 
[?2004l[?2004h> 
[?2004l[?2004h> formatted = op.map("format_output", joined, format_output)
[?2004l[?2004h> 
[?2004l[?2004h> 
[?2004l[?2004h> def to_json_line(d):
[?2004l[?2004h>     return json.dumps(d)
[?2004l[?2004h> 
[?2004l[?2004h> 
[?2004l[?2004h> json_lines = op.map("to_json_line", formatted, to_json_line)
[?2004l[?2004h> 
[?2004l[?2004h> # --- Output: write JSON lines to output.jsonl --------------------------------
[?2004l[?2004h> # FileSink requires the file to already exist; it's created by the runner.
[?2004l[?2004h> op.output(
[?2004l[?2004h>     "output",
[?2004l[?2004h>     json_lines,
[?2004l[?2004h>     FileSink(str(OUTPUT_PATH)),
[?2004l[?2004h> )
[?2004l[?2004h> PYEOF
