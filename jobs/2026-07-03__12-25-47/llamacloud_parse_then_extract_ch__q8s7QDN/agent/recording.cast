[101.166903, "o", "    # ------------------------------------------------------------------\r\n\u001b[?2004l\r"]
[101.166971, "o", "\u001b[?2004h> "]
[101.167538, "o", "    # Initialise the client (LLAMA_CLOUD_API_KEY read from env)\r\n\u001b[?2004l\r"]
[101.167593, "o", "\u001b[?2004h> "]
[101.168246, "o", "    # ------------------------------------------------------------------\r\n\u001b[?2004l\r"]
[101.168301, "o", "\u001b[?2004h> "]
[101.168539, "o", "    client = LlamaCloud()\r\n\u001b[?2004l\r"]
[101.168594, "o", "\u001b[?2004h> "]
[101.168645, "o", "\r\n\u001b[?2004l\r"]
[101.168729, "o", "\u001b[?2004h> "]
[101.16911, "o", "    run_id = RUN_ID_PATH.read_text().strip()\r\n\u001b[?2004l\r"]
[101.169164, "o", "\u001b[?2004h> "]
[101.169547, "o", "    external_file_id = f\"invoice-{run_id}\"\r\n\u001b[?2004l\r"]
[101.169598, "o", "\u001b[?2004h> "]
[101.169726, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[101.170326, "o", "    # ------------------------------------------------------------------\r\n\u001b[?2004l\r"]
[101.17038, "o", "\u001b[?2004h> "]
[101.170794, "o", "    # 1) Upload the file with purpose=\"parse\"\r\n\u001b[?2004l\r"]
[101.170845, "o", "\u001b[?2004h"]
[101.170957, "o", "> "]
[101.171497, "o", "    # ------------------------------------------------------------------\r\n\u001b[?2004l\r"]
[101.171549, "o", "\u001b[?2004h> "]
[101.171896, "o", "    with open(PDF_PATH, \"rb\") as fh:\r\n\u001b[?2004l\r"]
[101.171968, "o", "\u001b[?2004h> "]
[101.172335, "o", "        uploaded = client.files.create(\r\n\u001b[?2004l\r"]
[101.172405, "o", "\u001b[?2004h> "]
[101.172604, "o", "            file=fh,\r\n\u001b[?2004l\r"]
[101.172656, "o", "\u001b[?2004h"]
[101.172761, "o", "> "]
[101.172979, "o", "            purpose=\"parse\",\r\n\u001b[?2004l\r"]
[101.173034, "o", "\u001b[?2004h"]
[101.173154, "o", "> "]
[101.173502, "o", "            external_file_id=external_file_id,\r\n\u001b[?2004l\r"]
[101.173553, "o", "\u001b[?2004h> "]
[101.173681, "o", "        )\r\n\u001b[?2004l\r"]
[101.173738, "o", "\u001b[?2004h"]
[101.173845, "o", "> "]
[101.17455, "o", "    print(f\"Uploaded file id={uploaded.id} external_id={uploaded.external_file_id}\")\r\n\u001b[?2004l\r"]
[101.174667, "o", "\u001b[?2004h"]
[101.174742, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[101.175432, "o", "    # ------------------------------------------------------------------\r\n\u001b[?2004l\r"]
[101.175487, "o", "\u001b[?2004h> "]
[101.176202, "o", "    # 2) Run a Parse job (tier=agentic, version=latest) requesting markdown\r\n\u001b[?2004l\r"]
[101.176287, "o", "\u001b[?2004h"]
[101.176341, "o", "> "]
[101.177001, "o", "    # ------------------------------------------------------------------\r\n\u001b[?2004l\r"]
[101.177054, "o", "\u001b[?2004h"]
[101.177109, "o", "> "]
[101.17745, "o", "    parse_job = client.parsing.create(\r\n\u001b[?2004l\r"]
[101.177501, "o", "\u001b[?2004h"]
[101.177612, "o", "> "]
[101.177764, "o", "        tier=\"agentic\",\r\n\u001b[?2004l\r"]
[101.177815, "o", "\u001b[?2004h"]
[101.177862, "o", "> "]
[101.178114, "o", "        version=\"latest\",\r\n\u001b[?2004l\r"]
[101.178174, "o", "\u001b[?2004h"]
[101.178305, "o", "> "]
[101.178467, "o", "        file_id=uploaded.id,\r\n\u001b[?2004l\r"]
[101.178521, "o", "\u001b[?2004h"]
[101.178629, "o", "> "]
[101.17893, "o", "        output_options={\"markdown\": {}},\r\n\u001b[?2004l\r"]
[101.179031, "o", "\u001b[?2004h> "]
[101.179126, "o", "    )\r\n\u001b[?2004l\r\u001b[?2004h"]
[101.179178, "o", "> "]
[101.179473, "o", "    parse_job_id = parse_job.id\r\n\u001b[?2004l\r"]
[101.179524, "o", "\u001b[?2004h"]
[101.179628, "o", "> "]
[101.179911, "o", "    print(f\"Created parse job {parse_job_id}\")\r\n\u001b[?2004l\r"]
[101.179972, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[101.180078, "o", "\u001b[?2004h> "]
[101.180573, "o", "    completed_parse = client.parsing.wait_for_completion(parse_job_id, verbose=True)\r\n\u001b[?2004l\r"]
[101.180643, "o", "\u001b[?2004h> "]
[101.181116, "o", "    print(f\"Parse job {completed_parse.id} status={completed_parse.status}\")\r\n\u001b[?2004l\r"]
[101.181178, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[101.181255, "o", "\u001b[?2004h> "]
[101.181623, "o", "    # Fetch expanded content (markdown) for the completed job\r\n\u001b[?2004l\r"]
[101.181677, "o", "\u001b[?2004h> "]
[101.182177, "o", "    parse_result = client.parsing.get(completed_parse.id, expand=[\"markdown\"])\r\n\u001b[?2004l\r"]
[101.182229, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[101.182336, "o", "\u001b[?2004h> "]
[101.18274, "o", "    # ------------------------------------------------------------------\r\n\u001b[?2004l\r"]
[101.182793, "o", "\u001b[?2004h> "]
[101.183091, "o", "    # 3) Save the markdown of the first page\r\n\u001b[?2004l\r"]
[101.183145, "o", "\u001b[?2004h> "]
[101.183599, "o", "    # ------------------------------------------------------------------\r\n\u001b[?2004l\r"]
[101.183653, "o", "\u001b[?2004h> "]
[101.183808, "o", "    first_page_md = \"\"\r\n\u001b[?2004l\r"]
[101.183878, "o", "\u001b[?2004h> "]
[101.184263, "o", "    if parse_result.markdown and parse_result.markdown.pages:\r\n\u001b[?2004l\r"]
[101.184308, "o", "\u001b[?2004h> "]
[101.184604, "o", "        page1 = parse_result.markdown.pages[0]\r\n\u001b[?2004l\r"]
[101.184705, "o", "\u001b[?2004h> "]
[101.184952, "o", "        if getattr(page1, \"success\", True):\r\n\u001b[?2004l\r"]
[101.18501, "o", "\u001b[?2004h> "]
[101.185273, "o", "            first_page_md = page1.markdown\r\n\u001b[?2004l\r"]
[101.185327, "o", "\u001b[?2004h> "]
[101.185435, "o", "        else:\r\n\u001b[?2004l\r\u001b[?2004h"]
[101.185518, "o", "> "]
[101.186024, "o", "            first_page_md = f\"_parse failed_: {getattr(page1, 'error', '')}\"\r\n\u001b[?2004l\r"]
[101.186142, "o", "\u001b[?2004h> "]
[101.186283, "o", "    PARSED_MD_PATH.write_text(first_page_md)\r\n\u001b[?2004l\r"]
[101.186339, "o", "\u001b[?2004h> "]
[101.186849, "o", "    print(f\"Wrote {len(first_page_md)} chars of markdown to {PARSED_MD_PATH}\")\r\n\u001b[?2004l\r\u001b[?2004h"]
[101.186903, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h"]
[101.18703, "o", "> "]
[101.187403, "o", "    # ------------------------------------------------------------------\r\n\u001b[?2004l\r"]
[101.187454, "o", "\u001b[?2004h> "]
[101.18786, "o", "    # 4) Reuse the parse-job ID as file_input for the Extract job\r\n\u001b[?2004l\r"]
[101.187911, "o", "\u001b[?2004h> "]
[101.188374, "o", "    # ------------------------------------------------------------------\r\n\u001b[?2004l\r"]
[101.188425, "o", "\u001b[?2004h> "]
[101.188579, "o", "    extract_config = {\r\n\u001b[?2004l\r"]
[101.188632, "o", "\u001b[?2004h> "]
[101.189, "o", "        \"data_schema\": InvoiceSchema.model_json_schema(),\r\n\u001b[?2004l\r"]
[101.189053, "o", "\u001b[?2004h> "]
[101.189219, "o", "        \"tier\": \"agentic\",\r\n\u001b[?2004l\r"]
[101.18927, "o", "\u001b[?2004h> "]
[101.189453, "o", "        \"version\": \"latest\",\r\n\u001b[?2004l\r"]
[101.189525, "o", "\u001b[?2004h>     }\r\n\u001b[?2004l\r"]
[101.189635, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[101.189687, "o", "> "]
[101.189918, "o", "    extract_job = client.extract.create(\r\n\u001b[?2004l\r"]
[101.18998, "o", "\u001b[?2004h> "]
[101.190226, "o", "        file_input=completed_parse.id,\r\n\u001b[?2004l\r"]
[101.190277, "o", "\u001b[?2004h> "]
[101.190516, "o", "        configuration=extract_config,\r\n\u001b[?2004l\r"]
[101.190571, "o", "\u001b[?2004h> "]
[101.190679, "o", "    )\r\n\u001b[?2004l\r\u001b[?2004h> "]
[101.190884, "o", "    extract_job_id = extract_job.id\r\n\u001b[?2004l\r"]
[101.191, "o", "\u001b[?2004h> "]
[101.191275, "o", "    print(f\"Created extract job {extract_job_id}\")\r\n\u001b[?2004l\r"]
[101.19133, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[101.191389, "o", "\u001b[?2004h> "]
[101.191988, "o", "    completed_extract = client.extract.wait_for_completion(extract_job_id, verbose=True)\r\n\u001b[?2004l\r\u001b[?2004h"]
[101.19204, "o", "> "]
[101.192528, "o", "    print(f\"Extract job {completed_extract.id} status={completed_extract.status}\")\r\n\u001b[?2004l\r"]
[101.192579, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[101.192683, "o", "\u001b[?2004h> "]
[101.193099, "o", "    # ------------------------------------------------------------------\r\n\u001b[?2004l\r"]
[101.193209, "o", "\u001b[?2004h> "]
[101.193489, "o", "    # 5) Persist the structured extraction result\r\n\u001b[?2004l\r"]
[101.193543, "o", "\u001b[?2004h> "]
[101.194048, "o", "    # ------------------------------------------------------------------\r\n\u001b[?2004l\r\u001b[?2004h> "]
[101.194617, "o", "    EXTRACTED_JSON_PATH.write_text(json.dumps(completed_extract.extract_result, indent=2))\r\n\u001b[?2004l\r"]
[101.194674, "o", "\u001b[?2004h> "]
[101.195062, "o", "    print(f\"Wrote extract result to {EXTRACTED_JSON_PATH}\")\r\n\u001b[?2004l\r"]
[101.195114, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[101.195224, "o", "\u001b[?2004h> "]
[101.195636, "o", "    # ------------------------------------------------------------------\r\n\u001b[?2004l\r"]
[101.195818, "o", "\u001b[?2004h> "]
[101.196025, "o", "    # 6) Append summary lines to output.log\r\n\u001b[?2004l\r"]
[101.196083, "o", "\u001b[?2004h> "]
[101.19653, "o", "    # ------------------------------------------------------------------\r\n\u001b[?2004l\r"]
[101.196584, "o", "\u001b[?2004h> "]
[101.196757, "o", "    with open(LOG_PATH, \"a\") as logf:\r\n\u001b[?2004l\r\u001b[?2004h"]
[101.196811, "o", "> "]
[101.197019, "o", "        logf.write(f\"Parse Job ID: {completed_parse.id}\\n\")\r\n\u001b[?2004l\r\u001b[?2004h> "]
[101.19725, "o", "        logf.write(f\"Extract Job ID: {completed_extract.id}\\n\")\r\n\u001b[?2004l\r\u001b[?2004h> "]
[101.197453, "o", "    print(f\"Appended summary lines to {LOG_PATH}\")\r\n\u001b[?2004l\r\u001b[?2004h> \r\n"]
[101.19751, "o", "\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[101.197621, "o", "\u001b[?2004h> if __name__ == \"__main__\":\r\n\u001b[?2004l\r"]
[101.197679, "o", "\u001b[?2004h> "]
[101.197785, "o", "    main()\r\n\u001b[?2004l\r\u001b[?2004h> PYEOF\r\n\u001b[?2004l\r"]
[101.201472, "o", "\u001b[?2004hroot@8f6fc158-7c17-4657-9015-32ba31bc16db:~# "]
[102.047363, "i", "cat /home/user/myproject/run.py | head -20\n"]
[102.047818, "o", "cat /home/user/myproject/run.py | head -20\r\n\u001b[?2004l\r"]
[102.049257, "o", "#!/usr/bin/env python3\r\n\"\"\"Parse-then-Extract chain with LlamaCloud (v2 SDK).\"\"\"\r\n\r\n"]
[102.04934, "o", "import json\r\nimport os\r\nfrom pathlib import Path\r\nfrom typing import List\r\n\r\nfrom pydantic import BaseModel\r\n\r\nfrom llama_cloud import LlamaCloud\r\n"]
[102.049404, "o", "\r\n\r\n# ------------------------------------------------------------------\r\n# Paths / config\r\n# ------------------------------------------------------------------\r\nPROJECT_DIR = Path(\"/home/user/myproject\")\r\nPDF_PATH = PROJECT_DIR / \"data\" / \"invoice.pdf\"\r\nPARSED_MD_PATH = PROJECT_DIR / \"parsed.md\"\r\nEXTRACTED_JSON_PATH = PROJECT_DIR / \"extracted.json\"\r\n"]
[102.049753, "o", "\u001b[?2004h"]
[102.049807, "o", "root@8f6fc158-7c17-4657-9015-32ba31bc16db:~# "]
[106.00935, "i", "python3 -m py_compile /home/user/myproject/run.py && echo OK\n"]
[106.010276, "o", "python3 -m py_compile /home/user/myproject/run.py && echo OK\r\n\u001b[?2004l\r"]
[106.03983, "o", "OK\r\n"]
[106.039897, "o", "\u001b[?2004hroot@8f6fc158-7c17-4657-9015-32ba31bc16db:~# "]
[107.046458, "i", "cd /home/user/myproject && python3 run.py 2>&1 | tee /tmp/run.log\n"]
[107.046914, "o", "cd /home/user/myproject && python3 run.py 2>&1 | tee /tmp/run.log\r\n\u001b[?2004l\r"]
[127.709976, "o", "Uploaded file id=db244754-5ee3-4fcf-b4b7-3cc649326d3e external_id=invoice-zrmvgag9w6\r\nCreated parse job pjb-oyaufntw4ujul1t9vd8lckvsjmlj\r\nParse job pjb-oyaufntw4ujul1t9vd8lckvsjmlj status=COMPLETED\r\nWrote 415 chars of markdown to /home/user/myproject/parsed.md\r\nCreated extract job ext-otdrldnc8w0ghvbvi8b7zm2j9q7m\r\nExtract job ext-otdrldnc8w0ghvbvi8b7zm2j9q7m status=COMPLETED\r\nWrote extract result to /home/user/myproject/extracted.json\r\nAppended summary lines to /home/user/myproject/output.log\r\n"]
[127.776191, "o", "\u001b[?2004hroot@8f6fc158-7c17-4657-9015-32ba31bc16db:/home/user/myproject# "]
