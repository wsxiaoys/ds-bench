[170.906924, "o", "drwxr-xr-x 1 root root   31 Jul  3 14:20 \u001b[01;34m..\u001b[0m\r\ndrwxr-xr-x 2 root root   41 Jul  3 14:23 \u001b[01;34m__pycache__\u001b[0m\r\ndrwxr-xr-x 1 root root   33 Jul  3 14:20 \u001b[01;34mdata\u001b[0m\r\n-rw-r--r-- 1 root root  298 Jul  3 14:23 extracted.json\r\n-rw-r--r-- 1 root root   96 Jul  3 14:23 output.log\r\n-rw-r--r-- 1 root root  415 Jul  3 14:23 parsed.md\r\n-rw-r--r-- 1 root root 4680 Jul  3 14:23 run.py\r\n"]
