[171.320235, "o", "cat /home/user/myproject/parsed.md\r\n\u001b[?2004l\r"]
[171.32198, "o", "# INVOICE\r\n\r\n**Vendor**: Acme Office Supplies, Inc.\r\n**Invoice Number**: INV-2024-00042\r\n**Invoice Date**: 2024-08-15\r\n**Bill To**: Globex Corporation, 1 Main St., Springfield\r\n\r\n## Line Items\r\n\r\n1. Ergonomic Office Chair - $245.00\r\n\r\n2. Standing Desk (Adjustable) - $499.00\r\n\r\n3. Wireless Keyboard and Mouse Combo - $89.50\r\n\r\n4. 27\" 4K Monitor - $389.00\r\n\r\n**Subtotal: $1,222.50**\r\n\r\n**Tax (7%): $85.58**\r\n\r\n**Total Amount: $1,308.08**"]
[171.322289, "o", "\u001b[?2004hroot@8f6fc158-7c17-4657-9015-32ba31bc16db:/home/user/myproject# "]
[171.762797, "i", "cat /home/user/myproject/extracted.json\n"]
[171.76306, "o", "cat /home/user/myproject/extracted.json\r\n\u001b[?2004l\r"]
[171.764102, "o", "{\r\n  \"vendor\": \"Acme Office Supplies, Inc.\",\r\n  \"invoice_number\": \"INV-2024-00042\",\r\n  \"total_amount\": 1308.08,\r\n  \"line_items\": [\r\n    \"Ergonomic Office Chair - $245.00\",\r\n    \"Standing Desk (Adjustable) - $499.00\",\r\n    \"Wireless Keyboard and Mouse Combo - $89.50\",\r\n    \"27\\\" 4K Monitor - $389.00\"\r\n  ]\r\n}"]
[171.764277, "o", "\u001b[?2004hroot@8f6fc158-7c17-4657-9015-32ba31bc16db:/home/user/myproject# "]
