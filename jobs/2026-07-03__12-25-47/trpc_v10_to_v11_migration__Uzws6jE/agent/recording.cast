[26.03952, "o", "import * as trpcNext from '@trpc/server/adapters/next';\r\nimport { appRouter } from '../../../server/routers/_app';\r\n\r\nexport default trpcNext.createNextApiHandler({\r\n  router: appRouter,\r\n  createContext: () => ({}),\r\n});\r\n"]
