[193.112885, "i", "cat src/server/routers/_app.ts\n"]
[193.113165, "o", "cat src/server/routers/_app.ts\r\n\u001b[?2004l\r"]
[193.114263, "o", "import { initTRPC } from '@trpc/server';\r\nimport superjson from 'superjson';\r\nimport { z } from 'zod';\r\n\r\nconst t = initTRPC.create({\r\n  transformer: superjson,\r\n});\r\n\r\nexport const appRouter = t.router({\r\n  hello: t.procedure\r\n    .input(z.object({ text: z.string() }))\r\n    .query(({ input }) => {\r\n      return {\r\n        greeting: `Hello from tRPC v11 ${input.text}`,\r\n      };\r\n    }),\r\n});\r\n\r\nexport type AppRouter = typeof appRouter;\r\n"]
[193.114487, "o", "\u001b[?2004h"]
[193.114519, "o", "root@f6e79c1c-5152-4328-9773-2e61d4159210:/home/user/project# "]
[193.989892, "i", "cat src/pages/api/trpc/*.ts 2>/dev/null\n"]
[193.990366, "o", "cat src/pages/api/trpc/*.ts 2>/dev/null\r\n\u001b[?2004l\r"]
[193.992098, "o", "import * as trpcNext from '@trpc/server/adapters/next';\r\nimport { appRouter } from '../../../server/routers/_app';\r\n\r\nexport default trpcNext.createNextApiHandler({\r\n  router: appRouter,\r\n  createContext: () => ({}),\r\n});\r\n"]
[193.992392, "o", "\u001b[?2004h"]
