[80.230579, "o", "    # Write batched metrics to SQLite using a custom DynamicSink.\r\n\u001b[?2004l\r"]
[80.230604, "o", "\u001b[?2004h> "]
[80.230773, "o", "    op.output(\"sqlite_sink\", batched, SQLiteSink())\r\n\u001b[?2004l\r"]
