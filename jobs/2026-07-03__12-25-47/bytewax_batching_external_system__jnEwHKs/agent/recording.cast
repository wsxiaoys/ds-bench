[151.214324, "o", "def parse_line(line: str):\r\n\u001b[?2004l\r"]
[151.214426, "o", "\u001b[?2004h> "]
[151.214892, "o", "    \"\"\"Parse a single JSONL line into a metric dict.\"\"\"\r\n\u001b[?2004l\r"]
[151.214997, "o", "\u001b[?2004h> "]
[151.215202, "o", "    line = line.strip()\r\n\u001b[?2004l\r"]
[151.215296, "o", "\u001b[?2004h> "]
[151.215469, "o", "    if not line:\r\n\u001b[?2004l\r"]
[151.215564, "o", "\u001b[?2004h> "]
[151.215746, "o", "        return None\r\n\u001b[?2004l\r"]
[151.21584, "o", "\u001b[?2004h> "]
[151.216081, "o", "    return json.loads(line)\r\n\u001b[?2004l\r"]
[151.216169, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[151.216255, "o", "\u001b[?2004h> "]
[151.216343, "o", "\r\n\u001b[?2004l\r\u001b[?2004h"]
[151.216493, "o", "> "]
[151.216585, "o", "def build_flow():\r\n\u001b[?2004l\r"]
[151.216681, "o", "\u001b[?2004h> "]
[151.217258, "o", "    # Ensure the SQLite table exists before the dataflow starts writing.\r\n\u001b[?2004l\r"]
[151.217346, "o", "\u001b[?2004h> "]
[151.217535, "o", "    ensure_table()\r\n\u001b[?2004l\r"]
[151.217582, "o", "\u001b[?2004h> "]
[151.217607, "o", "\r\n\u001b[?2004l\r"]
[151.217666, "o", "\u001b[?2004h> "]
[151.218025, "o", "    flow = Dataflow(\"device_metrics_batching\")\r\n\u001b[?2004l\r"]
[151.21807, "o", "\u001b[?2004h"]
[151.218106, "o", "> \r\n\u001b[?2004l\r"]
[151.218145, "o", "\u001b[?2004h"]
[151.218166, "o", "> "]
[151.21854, "o", "    # Read device metrics from the JSONL file.\r\n\u001b[?2004l\r"]
[151.21859, "o", "\u001b[?2004h"]
[151.21864, "o", "> "]
[151.218888, "o", "    source = FileSource(INPUT_PATH)\r\n\u001b[?2004l\r"]
[151.218939, "o", "\u001b[?2004h"]
[151.218965, "o", "> "]
[151.219347, "o", "    metrics = op.input(\"metrics_in\", flow, source)\r\n\u001b[?2004l\r"]
[151.219394, "o", "\u001b[?2004h"]
[151.219464, "o", "> \r\n\u001b[?2004l\r"]
[151.219546, "o", "\u001b[?2004h> "]
[151.219841, "o", "    # Parse the JSON string into a dict.\r\n\u001b[?2004l\r"]
[151.219916, "o", "\u001b[?2004h> "]
[151.220292, "o", "    parsed = op.map(\"parse\", metrics, parse_line)\r\n\u001b[?2004l\r"]
[151.22037, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[151.220456, "o", "\u001b[?2004h> "]
[151.220936, "o", "    # Filter out any metrics where metric_value is less than 0.\r\n\u001b[?2004l\r"]
[151.221015, "o", "\u001b[?2004h> "]
[151.221207, "o", "    filtered = op.filter(\r\n\u001b[?2004l\r"]
[151.221284, "o", "\u001b[?2004h> "]
[151.221473, "o", "        \"non_negative\",\r\n\u001b[?2004l\r"]
[151.221553, "o", "\u001b[?2004h> "]
[151.221639, "o", "        parsed,\r\n\u001b[?2004l\r"]
[151.221723, "o", "\u001b[?2004h> "]
[151.222088, "o", "        lambda r: r is not None and r[\"metric_value\"] >= 0,\r\n\u001b[?2004l\r\u001b[?2004h> "]
[151.222168, "o", "    )\r\n\u001b[?2004l\r"]
[151.222249, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[151.222324, "o", "\u001b[?2004h> "]
[151.222585, "o", "    # Group the metrics by device_id.\r\n\u001b[?2004l\r"]
[151.222669, "o", "\u001b[?2004h> "]
[151.223082, "o", "    keyed = op.key_on(\"by_device\", filtered, lambda r: r[\"device_id\"])\r\n\u001b[?2004l\r"]
[151.22316, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[151.223236, "o", "\u001b[?2004h> "]
[151.223653, "o", "    # Batch the metrics for each device using max batch size of 10 and\r\n\u001b[?2004l\r"]
[151.223731, "o", "\u001b[?2004h> "]
[151.223888, "o", "    # a timeout of 1 second.\r\n\u001b[?2004l\r"]
[151.223963, "o", "\u001b[?2004h> "]
[151.224102, "o", "    batched = op.collect(\r\n\u001b[?2004l\r"]
[151.224176, "o", "\u001b[?2004h> "]
[151.224273, "o", "        \"batch\",\r\n\u001b[?2004l\r"]
[151.224348, "o", "\u001b[?2004h> "]
[151.224442, "o", "        keyed,\r\n\u001b[?2004l\r"]
[151.22451, "o", "\u001b[?2004h> "]
[151.224739, "o", "        timeout=timedelta(seconds=1),\r\n\u001b[?2004l\r"]
[151.224808, "o", "\u001b[?2004h> "]
[151.224926, "o", "        max_size=10,\r\n\u001b[?2004l\r"]
[151.224989, "o", "\u001b[?2004h> "]
[151.225052, "o", "    )\r\n\u001b[?2004l\r\u001b[?2004h"]
[151.225115, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h"]
[151.225178, "o", "> "]
[151.225559, "o", "    # Write batched metrics to SQLite using a custom DynamicSink.\r\n\u001b[?2004l\r"]
[151.225629, "o", "\u001b[?2004h> "]
[151.225933, "o", "    op.output(\"sqlite_sink\", batched, SQLiteSink())\r\n\u001b[?2004l\r"]
[151.226005, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[151.22607, "o", "\u001b[?2004h> "]
[151.226179, "o", "    return flow\r\n\u001b[?2004l\r"]
[151.226215, "o", "\u001b[?2004h> "]
[151.226245, "o", "\r\n\u001b[?2004l\r"]
[151.226277, "o", "\u001b[?2004h> "]
[151.226307, "o", "\r\n\u001b[?2004l\r"]
[151.22635, "o", "\u001b[?2004h> "]
[151.226489, "o", "def main():\r\n\u001b[?2004l\r"]
[151.226558, "o", "\u001b[?2004h> "]
[151.22668, "o", "    flow = build_flow()\r\n\u001b[?2004l\r"]
[151.226742, "o", "\u001b[?2004h> "]
[151.226974, "o", "    # Run the dataflow to completion.\r\n\u001b[?2004l\r"]
[151.227036, "o", "\u001b[?2004h> "]
[151.227145, "o", "    run_main(flow)\r\n\u001b[?2004l\r"]
[151.227235, "o", "\u001b[?2004h> "]
[151.227653, "o", "    # After the dataflow completes successfully, write the log message.\r\n\u001b[?2004l\r"]
[151.227732, "o", "\u001b[?2004h> "]
[151.227937, "o", "    with open(OUTPUT_LOG, \"w\") as f:\r\n\u001b[?2004l\r"]
[151.228009, "o", "\u001b[?2004h> "]
[151.228252, "o", "        f.write(\"Pipeline finished.\\n\")\r\n\u001b[?2004l\r"]
[151.228338, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[151.228432, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[151.228612, "o", "if __name__ == \"__main__\":\r\n\u001b[?2004l\r"]
[151.228691, "o", "\u001b[?2004h> "]
[151.228772, "o", "    main()\r\n\u001b[?2004l\r\u001b[?2004h"]
[151.228853, "o", "> PYEOF\r\n\u001b[?2004l\r"]
[151.231033, "o", "\u001b[?2004h"]
[151.231115, "o", "root@18d2f3f7-b4a2-412c-b9af-2792ebfb4d90:/home/user/bytewax_batching# "]
[151.657468, "i", "rm -f /home/user/bytewax_batching/metrics-*.db /home/user/bytewax_batching/output.log\n"]
[151.657882, "o", "rm -f /home/user/bytewax_batching/metrics-*.db /home/user/bytewax_batching/output.log\r\n\u001b[?2004l\r"]
[151.659027, "o", "\u001b[?2004hroot@18d2f3f7-b4a2-412c-b9af-2792ebfb4d90:/home/user/bytewax_batching# "]
