[28.951984, "o", "Help on function collect in module bytewax.operators:\r\n\r\n"]
[28.952046, "o", "c\bco\bol\bll\ble\bec\bct\bt(step_id: str, up: bytewax.dataflow.Stream[typing.Tuple[str, ~V]], timeout: datetime.timedelta, max_size: int) -> bytewax.dataflow.Stream[typing.Tuple[st\r\nr, typing.List[~V]]]\r\n    Collect items into a list up to a size or a timeout.\r\n\r\n    ```{testcode}\r\n"]
[28.952186, "o", "    # This dataflow will collect items into lists of size 2 or\r\n    # every second, whichever comes first.\r\n    from bytewax.dataflow import Dataflow\r\n    import bytewax.operators as op\r\n    from bytewax.testing import TestingSource\r\n"]
[28.95222, "o", "    from datetime import timedelta\r\n\r\n    flow = Dataflow(\"collect_eg\")\r\n    source = [\r\n"]
[28.952332, "o", "        {\"key\": \"a\", \"val\": 1},\r\n        {\"key\": \"b\", \"val\": 2},\r\n        {\"key\": \"a\", \"val\": 3},\r\n        {\"key\": \"b\", \"val\": 4},\r\n        {\"key\": \"a\", \"val\": 5},\r\n        {\"key\": \"b\", \"val\": 6},\r\n"]
[28.952363, "o", "        {\"key\": \"a\", \"val\": 7},\r\n        {\"key\": \"b\", \"val\": 8},\r\n    ]\r\n"]
[28.952454, "o", "    nums = op.input(\"nums\", flow, TestingSource(source))\r\n\r\n    keyed = op.key_on(\"key\", nums, lambda x: x['key'])\r\n\r\n"]
[28.952504, "o", "    collected = op.collect(\"collect\", keyed, timedelta(seconds=1), max_size=2)\r\n\r\n    op.inspect(\"out\", collected)\r\n    ```\r\n\r\n"]
[28.952533, "o", "    ```{testcode}\r\n    :hide:\r\n"]
[28.952603, "o", "    from bytewax.testing import run_main\r\n\r\n    run_main(flow)\r\n\u001b[7m--More--\u001b[27m"]
