[?2004l[?2004h> class SQLiteSink(DynamicSink):
[?2004l[?2004h>     """Custom Bytewax Sink that bulk-inserts batches into SQLite using executemany."""
[?2004l[?2004h> 
[?2004l[?2004h>     def build(self, step_id, worker_index, worker_count):
