[?2004l[?2004h> class _SQLiteSinkPartition(StatelessSinkPartition):
[?2004l[?2004h>     def __init__(self):
[?2004l[?2004h>         self._conn = sqlite3.connect(DB_PATH)
[?2004l[?2004h> 
[?2004l[?2004h>     def write_batch(self, items):
