[?2004l[?2004h>                     (
[?2004l[?2004h>                         record["device_id"],
[?2004l[?2004h>                         record["timestamp"],
[?2004l[?2004h>                         record["metric_value"],
[?2004l[?2004h>                     )
[?2004l[?2004h>                 )
[?2004l[?2004h>         if rows:
[?2004l[?2004h>             self._conn.executemany(
[?2004l[?2004h>                 "INSERT INTO device_metrics (device_id, timestamp, metric_value) "
[?2004l[?2004h>                 "VALUES (?, ?, ?)",
[?2004l[?2004h>                 rows,
[?2004l[?2004h>             )
[?2004l[?2004h>             self._conn.commit()
[?2004l[?2004h> 
