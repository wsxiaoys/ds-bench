# Read run-id
RUN_ID_FILE = "/logs/artifacts/run-id"
with open(RUN_ID_FILE, "r") as f:
    RUN_ID = f.read().strip()

DB_PATH = f"/home/user/bytewax_batching/metrics-{RUN_ID}.db"
INPUT_PATH = "/home/user/bytewax_batching/input.jsonl"
OUTPUT_LOG = "/home/user/bytewax_batching/output.log"


def ensure_table():
    """Create the SQLite database and the device_metrics table if it doesn't exist."""
    conn = sqlite3.connect(DB_PATH)
    try:
        conn.execute(
            """
            CREATE TABLE IF NOT EXISTS device_metrics (
                device_id TEXT,
                timestamp TEXT,
                metric_value REAL
            )
            """
        )
        conn.commit()
    finally:
        conn.close()


class SQLiteSink(DynamicSink):
