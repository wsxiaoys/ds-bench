[?2004l[?2004h>             )
[?2004l[?2004h>             self._conn.commit()
[?2004l[?2004h> 
[?2004l[?2004h>     def close(self):
[?2004l[?2004h>         try:
[?2004l[?2004h>             self._conn.commit()
[?2004l[?2004h>         finally:
[?2004l[?2004h>             self._conn.close()
[?2004l[?2004h> 
[?2004l[?2004h> 
[?2004l[?2004h> def parse_line(line: str):
[?2004l[?2004h>     """Parse a single JSONL line into a metric dict."""
[?2004l[?2004h>     line = line.strip()
[?2004l[?2004h>     if not line:
[?2004l[?2004h>         return None
[?2004l[?2004h>     return json.loads(line)
[?2004l[?2004h> 
[?2004l[?2004h> 
[?2004l[?2004h> def build_flow():
[?2004l[?2004h>     # Ensure the SQLite table exists before the dataflow starts writing.
[?2004l[?2004h>     ensure_table()
[?2004l[?2004h> 
[?2004l[?2004h>     flow = Dataflow("device_metrics_batching")
[?2004l[?2004h> 
[?2004l[?2004h>     # Read device metrics from the JSONL file.
[?2004l[?2004h>     source = FileSource(INPUT_PATH)
[?2004l[?2004h>     metrics = op.input("metrics_in", flow, source)
[?2004l[?2004h> 
[?2004l[?2004h>     # Parse the JSON string into a dict.
[?2004l[?2004h>     parsed = op.map("parse", metrics, parse_line)
[?2004l[?2004h> 
[?2004l[?2004h>     # Filter out any metrics where metric_value is less than 0.
[?2004l[?2004h>     filtered = op.filter(
[?2004l[?2004h>         "non_negative",
[?2004l[?2004h>         parsed,
[?2004l[?2004h>         lambda r: r is not None and r["metric_value"] >= 0,
[?2004l[?2004h>     )
[?2004l[?2004h> 
[?2004l[?2004h>     # Group the metrics by device_id.
[?2004l[?2004h>     keyed = op.key_on("by_device", filtered, lambda r: r["device_id"])
[?2004l[?2004h> 
[?2004l[?2004h>     # Batch the metrics for each device using max batch size of 10 and
[?2004l[?2004h>     # a timeout of 1 second.
[?2004l[?2004h>     batched = op.collect(
[?2004l[?2004h>         "batch",
[?2004l[?2004h>         keyed,
[?2004l[?2004h>         timeout=timedelta(seconds=1),
[?2004l[?2004h>         max_size=10,
[?2004l[?2004h>     )
[?2004l[?2004h> 
[?2004l[?2004h>     # Write batched metrics to SQLite using a custom DynamicSink.
[?2004l[?2004h>     op.output("sqlite_sink", batched, SQLiteSink())
[?2004l[?2004h> 
[?2004l[?2004h>     return flow
[?2004l[?2004h> 
[?2004l[?2004h> 
[?2004l[?2004h> def main():
[?2004l[?2004h>     flow = build_flow()
[?2004l[?2004h>     # Run the dataflow to completion.
[?2004l[?2004h>     run_main(flow)
[?2004l[?2004h>     # After the dataflow completes successfully, write the log message.
[?2004l[?2004h>     with open(OUTPUT_LOG, "w") as f:
[?2004l[?2004h>         f.write("Pipeline finished.\n")
[?2004l[?2004h> 
[?2004l[?2004h> 
[?2004l[?2004h> if __name__ == "__main__":
[?2004l[?2004h>     main()
