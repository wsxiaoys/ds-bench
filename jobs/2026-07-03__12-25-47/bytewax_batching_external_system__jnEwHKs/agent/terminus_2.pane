[?2004l    # Read device metrics from the JSONL file.
    source = FileSource(INPUT_PATH)
    metrics = op.input("metrics_in", flow, source)

    # Parse the JSON string into a dict.
    parsed = op.map("parse", metrics, parse_line)

    # Filter out any metrics where metric_value is less than 0.
    filtered = op.filter("non_negative", parsed, lambda r: r is not None and r["metric_value"] >= 0)

    # Group the metrics by device_id.
    keyed = op.key_on("by_device", filtered, lambda r: r["device_id"])

    # Batch the metrics for each device using max batch size of 10 and timeout of 1 second.
    batched = op.collect(
        "batch",
        keyed,
        timeout=timedelta(seconds=1),
        max_size=10,
    )

    # Write batched metrics to SQLite using a custom DynamicSink.
    op.output("sqlite_sink", batched, SQLiteSink())


if __name__ == "__main__":
    main()
    # After the dataflow completes successfully, write the log message.
    with open(OUTPUT_LOG, "w") as f:
        f.write("Pipeline finished.\n")
