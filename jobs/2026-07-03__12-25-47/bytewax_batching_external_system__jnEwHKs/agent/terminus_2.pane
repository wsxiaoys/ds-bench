[?2004l[?2004h> def main():
[?2004l[?2004h>     # Ensure the SQLite table exists before the dataflow starts writing.
[?2004l[?2004h>     ensure_table()
[?2004l[?2004h> 
[?2004l[?2004h>     flow = Dataflow("device_metrics_batching")
[?2004l[?2004h> 
[?2004l[?2004h>     # Read device metrics from the JSONL file.
[?2004l[?2004h>     source = FileSource(INPUT_PATH)
[?2004l[?2004h>     metrics = op.input("metrics_in", flow, source)
[?2004l[?2004h> 
[?2004l[?2004h>     # Parse the JSON string into a dict.
[?2004l[?2004h>     parsed = op.map("parse", metrics, parse_line)
[?2004l[?2004h> 
[?2004l[?2004h>     # Filter out any metrics where metric_value is less than 0.
[?2004l[?2004h>     filtered = op.filter("non_negative", parsed, lambda r: r is not None and r["metric_value"] >= 0)
[?2004l[?2004h> 
[?2004l[?2004h>     # Group the metrics by device_id.
[?2004l[?2004h>     keyed = op.key_on("by_device", filtered, lambda r: r["device_id"])
