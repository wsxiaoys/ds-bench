[195.437503, "o", "[{\"data\":\"short\",\"path\":[\"confirm\"],\"code\":\"minLength\",\"description\":\"at least length 13\",\"meta\":{},\"rule\":13,\"expected\":\"at least length 13\",\"actual\":\"<redacted>\",\"problem\":\"<redacted>\",\"message\":\"<redacted>\"},{\"data\":\"short\",\"path\":[\"password\"],\"code\":\"minLength\",\"description\":\"at least length 13\",\"meta\":{},\"rule\":13,\"expected\":\"at least length 13\",\"actual\":\"<redacted>\",\"problem\":\"<redacted>\",\"message\":\"<redacted>\"},{\"data\":\"123-45-678\",\"path\":[\"ssn\"],\"code\":\"pattern\",\"description\":\"matched by ^\\\\d{3}-\\\\d{2}-\\\\d{4}$\",\"meta\":{},\"rule\":\"^\\\\d{3}-\\\\d{2}-\\\\d{4}$\",\"expected\":\"matched by ^\\\\d{3}-\\\\d{2}-\\\\d{4}$\",\"actual\":\"<redacted>\",\"problem\":\"<redacted>\",\"message\":\"<redacted>\"}]\r\n"]
