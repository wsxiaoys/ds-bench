[336.901668, "i", "cat > /home/user/myproject/test.mjs << 'EOF'\nimport { type } from 'arktype';\n\nconst passwordType = type('12<string<=128').narrow((data, ctx) => {\n  if (!/[a-z]/.test(data)) return ctx.mustBe('lowercase letter');\n  if (!/[A-Z]/.test(data)) return ctx.mustBe('uppercase letter');\n  if (!/\\d/.test(data)) return ctx.mustBe('digit');\n  if (!/[^a-zA-Z0-9]/.test(data)) return ctx.mustBe('symbol');\n  return true;\n}).configure({\n  actual: () => '<redacted>',\n  problem: () => '<redacted>',\n  message: () => '<redacted>',\n});\n\nconst ssnType = type(/^\\d{3}-\\d{2}-\\d{4}$/).configure({\n  actual: () => '<redacted>',\n  problem: () => '<redacted>',\n  message: () => '<redacted>',\n});\n\nconst Signup = type({\n  username: '3<string<=20',\n  password: passwordType,\n  confirm: passwordType,\n  ssn: ssnType,\n}).narrow((data, ctx) => {\n  if (data.password !== data.confirm) return ctx.mustBe('equal to password');\n  return true;\n}).configure({\n  predicate: {\n    actual: () => '<redacted>',\n    problem: () => '<redacted>',\n    message: () => '<redacted>',\n  },\n});\n\nconst result = Signup({ username: 'alice', password: 'Abcdefgh1@xyz', confirm: 'Abcdefgh1@abc', ssn: '123-45-6789' });\nconsole.log(JSON.stringify(result, null, 2));\nEOF\ncd /home/user/myproject && npx tsx test.mjs\n"]
