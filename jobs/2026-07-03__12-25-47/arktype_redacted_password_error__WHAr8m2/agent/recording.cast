[207.91249, "i", "cat > /home/user/myproject/test.mjs << 'EOF'\nimport { type } from 'arktype';\n\nconst passwordType = type('12<string<=128').narrow((data, ctx) => {\n  if (!/[a-z]/.test(data)) return ctx.mustBe('lowercase letter');\n  if (!/[A-Z]/.test(data)) return ctx.mustBe('uppercase letter');\n  if (!/\\d/.test(data)) return ctx.mustBe('digit');\n  if (!/[^a-zA-Z0-9]/.test(data)) return ctx.mustBe('symbol');\n  return true;\n}).configure({\n  actual: () => '<redacted>',\n  problem: () => '<redacted>',\n  message: () => '<redacted>',\n});\n\nconst ssnType = type(/^\\d{3}-\\d{2}-\\d{4}$/).configure({\n  actual: () => '<redacted>',\n  problem: () => '<redacted>',\n  message: () => '<redacted>',\n});\n\nconst Signup = type({\n  username: '3<string<=20',\n  password: passwordType,\n  confirm: passwordType,\n  ssn: ssnType,\n}).narrow((data, ctx) => {\n  if (data.password !== data.confirm) return ctx.mustBe('equal to password');\n  return true;\n});\n\nconst result = Signup({ username: 'alice', password: 'short', confirm: 'short', ssn: '123-45-6789' });\nconsole.log('Raw errors:', JSON.stringify(result));\n\nif (result instanceof Error || (result && typeof result === 'object' && 'byPath' in result)) {\n  // It's ArkErrors\n  const redacted = result.transform(e => {\n    const path = e.path;\n    const isSensitive = path.length > 0 && ['password', 'confirm', 'ssn'].includes(path[0]);\n    if (isSensitive) {\n      return e.transform(input => ({ ...input, data: '<redacted>' }));\n    }\n    return e;\n  });\n  console.log('Redacted:', JSON.stringify(redacted));\n}\nEOF\ncd /home/user/myproject && npx tsx test.mjs\n"]
