[328.786515, "o", "\r\n30:export type ClosedNodeKind = Exclude<NodeKind, OpenNodeKind>;\r\n31:export type PrimitiveKind = Exclude<RefinementKind | BasisKind, \"structure\">;\r\n32:export type CompositeKind = Exclude<NodeKind, PrimitiveKind>;\r\n33:export type OrderedNodeKinds = typeof nodeKinds;\r\n35:export declare const structureKeys: keySetOf<Structure.Inner>;\r\n36:type RightsByKind = accumulateRightKinds<OrderedNodeKinds, {}>;\r\n37:export type kindOrRightOf<kind extends NodeKind> = kind | kindRightOf<kind>;\r\n38:export type kindLeftOf<kind extends NodeKind> = Exclude<NodeKind, kindOrRightOf<kind>>;\r\n"]
