    divisor: \u001b[36m[Object]\u001b[39m,\r\n      domain: \u001b[36m[Object]\u001b[39m,\r\n      exactLength: \u001b[36m[Object]\u001b[39m,\r\n      exactOptionalPropertyTypes: \u001b[33mtrue\u001b[39m,\r\n      index: \u001b[36m[Object]\u001b[39m,\r\n      intersection: \u001b[36m[Object]\u001b[39m,\r\n      jitless: \u001b[33mfalse\u001b[39m,\r\n      keywords: {},\r\n      max: \u001b[36m[Object]\u001b[39m,\r\n      maxLength: \u001b[36m[Object]\u001b[39m,\r\n      min: \u001b[36m[Object]\u001b[39m,\r\n      minLength: \u001b[36m[Object]\u001b[39m,\r\n      morph: \u001b[36m[Object]\u001b[39m,\r\n      numberAllowsNaN: \u001b[33mfalse\u001b[39m,\r\n      onFail: \u001b[1mnull\u001b[22m,\r\n      onUndeclaredKey: \u001b[32m'ignore'\u001b[39m,\r\n      optional: \u001b[36m[Object]\u001b[39m,\r\n      pattern: \u001b[36m[Object]\u001b[39m,\r\n      predicate: \u001b[36m[Object]\u001b[39m,\r\n      proto: \u001b[36m[Object]\u001b[39m,\r\n      required: \u001b[36m[Object]\u001b[39m,\r\n      sequence: \u001b[36m[Object]\u001b[39m,\r\n      structure: \u001b[36m[Object]\u001b[39m,\r\n      toJsonSchema: \u001b[36m[Object]\u001b[39m,\r\n      union: \u001b[36m[Object]\u001b[39m,\r\n      unit: \u001b[36m[Object]\u001b[39m,\r\n      prereducedAliases: \u001b[33mtrue\u001b[39m,\r\n      name: \u001b[32m'ark'\u001b[39m\r\n    },\r\n    queuedMorphs: [],\r\n    branches: [],\r\n    seen: {}\r\n  },\r\n  byPath: [Object: null prototype] {\r\n    \u001b[32m''\u001b[39m: ArkError {\r\n      \u001b[32m' arkKind'\u001b[39m: \u001b[32m'error'\u001b[39m,\r\n      path: \u001b[36m[ReadonlyPath]\u001b[39m,\r\n      data: \u001b[32m'abc'\u001b[39m,\r\n      nodeConfig: \u001b[36m[Object]\u001b[39m,\r\n      input: \u001b[36m[Object]\u001b[39m,\r\n      ctx: \u001b[36m[Traversal]\u001b[39m,\r\n      code: \u001b[32m'pattern'\u001b[39m,\r\n      description: \u001b[32m'matched by ^\\\\d{3}-\\\\d{2}-\\\\d{4}$'\u001b[39m,\r\n      meta: \u001b[36m[Object]\u001b[39m,\r\n      rule: \u001b[32m'^\\\\d{3}-\\\\d{2}-\\\\d{4}$'\u001b[39m\r\n    }\r\n  },\r\n  byAncestorPath: [Object: null prototype] { \u001b[32m''\u001b[39m: [ \u001b[36m[ArkError]\u001b[39m ] },\r\n  count: \u001b[33m1\u001b[39m,\r\n  mutable: \u001b[36m[Circular *1]\u001b[39m\r\n]\r\n"]
