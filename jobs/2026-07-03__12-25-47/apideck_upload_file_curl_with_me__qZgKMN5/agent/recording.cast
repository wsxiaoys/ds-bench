[85.341525, "o", "python3 -c 'import sys; open(sys.argv[1], \"wb\").write(b\"Uploaded via Apideck File Storage direct upload curl test\\n\")' \"${FILE_PATH}\"\r\n\u001b[?2004l\r"]
[85.341572, "o", "\u001b[?2004h> "]
[85.341822, "o", "echo \"File size: $(wc -c < \"${FILE_PATH}\") bytes\"\r\n\u001b[?2004l\r\u001b[?2004h"]
[85.34187, "o", "> "]
[85.341999, "o", "od -c \"${FILE_PATH}\" | head\r\n\u001b[?2004l\r"]
[85.342046, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[85.342143, "o", "> "]
[85.342457, "o", "# Build the metadata JSON string. Pass it via the x-apideck-metadata header.\r\n\u001b[?2004l\r"]
[85.342501, "o", "\u001b[?2004h> "]
[85.343346, "o", "METADATA_JSON=\"$(python3 -c 'import sys, json; print(json.dumps({\"name\": sys.argv[1], \"parent_folder_id\": \"root\", \"drive_id\": sys.argv[2]}))' \"${FILE_NAME}\" \"${DRIVE_ID}\")\"\r\n\u001b[?2004l\r\u001b[?2004h"]
[85.343395, "o", "> "]
[85.343552, "o", "echo \"Metadata: ${METADATA_JSON}\"\r\n\u001b[?2004l\r"]
[85.343601, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[85.343689, "o", "> "]
[85.344083, "o", "# Upload to upload.apideck.com (NOT unify.apideck.com). Body is raw binary, not multipart.\r\n\u001b[?2004l\r"]
[85.344129, "o", "\u001b[?2004h> "]
[85.344529, "o", "RESPONSE=\"$(curl -sS -X POST 'https://upload.apideck.com/file-storage/files' \\\r\n\u001b[?2004l\r"]
[85.344576, "o", "\u001b[?2004h> "]
[85.344784, "o", "  -H \"Authorization: Bearer ${API_KEY}\" \\\r\n\u001b[?2004l\r"]
[85.344863, "o", "\u001b[?2004h> "]
[85.345009, "o", "  -H \"x-apideck-app-id: ${APP_ID}\" \\\r\n\u001b[?2004l\r"]
[85.345055, "o", "\u001b[?2004h> "]
[85.34528, "o", "  -H \"x-apideck-consumer-id: ${CONSUMER_ID}\" \\\r\n\u001b[?2004l\r"]
[85.345325, "o", "\u001b[?2004h> "]
[85.345511, "o", "  -H \"x-apideck-service-id: onedrive\" \\\r\n\u001b[?2004l\r"]
[85.345558, "o", "\u001b[?2004h> "]
[85.345719, "o", "  -H 'Content-Type: text/plain' \\\r\n\u001b[?2004l\r"]
[85.345775, "o", "\u001b[?2004h> "]
[85.345996, "o", "  -H \"x-apideck-metadata: ${METADATA_JSON}\" \\\r\n\u001b[?2004l\r"]
[85.346042, "o", "\u001b[?2004h> "]
[85.346202, "o", "  --data-binary \"@${FILE_PATH}\")\"\r\n\u001b[?2004l\r"]
[85.346248, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[85.346347, "o", "> "]
[85.346464, "o", "echo \"Upload response: ${RESPONSE}\"\r\n\u001b[?2004l\r"]
[85.346514, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[85.346613, "o", "\u001b[?2004h> "]
[85.347114, "o", "FILE_ID=\"$(printf '%s' \"${RESPONSE}\" | python3 -c 'import sys, json; print(json.load(sys.stdin)[\"data\"][\"id\"])')\"\r\n\u001b[?2004l\r"]
[85.34716, "o", "\u001b[?2004h> "]
[85.347293, "o", "echo \"File id: ${FILE_ID}\"\r\n\u001b[?2004l\r"]
[85.347344, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[85.347446, "o", "> "]
[85.34772, "o", "# Write the unified file id as the only non-empty line in output.log.\r\n\u001b[?2004l\r\u001b[?2004h"]
[85.347773, "o", "> "]
[85.348065, "o", "printf '%s\\n' \"${FILE_ID}\" > /home/user/myproject/output.log\r\n\u001b[?2004l\r\u001b[?2004h"]
[85.348111, "o", "> "]
[85.348232, "o", "echo '--- output.log ---'\r\n\u001b[?2004l\r\u001b[?2004h"]
[85.348281, "o", "> "]
[85.348464, "o", "cat /home/user/myproject/output.log\r\n\u001b[?2004l\r\u001b[?2004h"]
[85.348513, "o", "> "]
[85.348606, "o", "echo '--- end ---'\r\n\u001b[?2004l\r\u001b[?2004h"]
[85.348676, "o", "> SCRIPT_EOF\r\n"]
[85.348722, "o", "\u001b[?2004l\r"]
[85.351176, "o", "\u001b[?2004hroot@dc00ee62-7663-4d79-aaf4-c6091b67a761:~# "]
[85.351395, "o", "chmod +x /home/user/myproject/upload.sh\r\n\u001b[?2004l\r"]
[85.353209, "o", "\u001b[?2004hroot@dc00ee62-7663-4d79-aaf4-c6091b67a761:~# "]
[85.353531, "o", "rm -f /tmp/apideck-curl-*.txt /home/user/myproject/output.log\r\n\u001b[?2004l\r"]
[85.35517, "o", "\u001b[?2004hroot@dc00ee62-7663-4d79-aaf4-c6091b67a761:~# "]
