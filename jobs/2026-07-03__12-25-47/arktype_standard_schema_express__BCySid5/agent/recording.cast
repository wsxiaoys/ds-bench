[167.625705, "i", "cat > /home/user/myproject/test11.ts << 'EOF'\nimport { type } from \"arktype\";\n\nconst SearchSchema = type({\n  q: \"string >= 1 <= 100\",\n  page: \"string.numeric.parse |> number >= 1\",\n  limit: \"string.numeric.parse |> 1 <= number <= 50\"\n});\n\n// Use Standard Schema interface\nconst std = SearchSchema[\"~standard\"];\nconsole.log(\"vendor:\", std.vendor);\nconsole.log(\"version:\", std.version);\n\n// Test validate\nconst r1 = std.validate({ q: \"hello\", page: \"2\", limit: \"10\" });\nconsole.log(\"success result:\", r1);\n\nconst r2 = std.validate({ q: \"\", page: \"0\", limit: \"100\" });\nconsole.log(\"fail result keys:\", Object.keys(r2));\nconsole.log(\"fail issues:\", (r2 as any).issues);\nEOF\nnpx tsx /home/user/myproject/test11.ts\n"]
