[176.430552, "i", "cat > /home/user/myproject/test12.ts << 'EOF'\nimport { type } from \"arktype\";\n\nconst SearchSchema = type({\n  q: \"string >= 1 <= 100\",\n  page: \"string.numeric.parse |> number >= 1\",\n  limit: \"string.numeric.parse |> 1 <= number <= 50\"\n});\n\n// Use Standard Schema interface\nconst std = SearchSchema[\"~standard\"];\n\n// Test validate (ensure we get a Promise since could be async)\nconst r1 = std.validate({ q: \"hello\", page: \"2\", limit: \"10\" });\nconsole.log(\"success:\", r1, \"value:\", (r1 as any).value);\n\nconst r2 = std.validate({ q: \"\", page: \"0\", limit: \"100\" });\nconst r2resolved = await (r2 as any);\nconsole.log(\"failure issues:\", (r2resolved as any).issues);\nEOF\nnpx tsx /home/user/myproject/test12.ts\n"]
