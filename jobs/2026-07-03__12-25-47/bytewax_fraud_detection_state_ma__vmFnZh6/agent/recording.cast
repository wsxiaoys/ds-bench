[198.715557, "o", "sed -i 's|serialized = op.map(\"to_json_str\", alert_values, lambda alert: json.dumps(alert))|keyed_alerts = op.key_on(\"alert_key\", alert_values, lambda alert: alert[\"user_id\"])\\n    serialized = op.map(\"to_json_str\", keyed_alerts, lambda kv: json.dumps(kv[1]))|' /home/user/fraud_detection/run.py\r\n\u001b[?2004l\r"]
