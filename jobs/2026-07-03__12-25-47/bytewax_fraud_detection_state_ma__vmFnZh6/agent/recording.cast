[170.711719, "o", "\u001b[32m\u001b[K37\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[01;31m\u001b[Kclass \u001b[m\u001b[K_FileSourcePartition(StatefulSourcePartition[str, int]):\r\n\u001b[32m\u001b[K58\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[01;31m\u001b[Kclass \u001b[m\u001b[KDirSource(FixedPartitionedSource[str, int]):\r\n\u001b[32m\u001b[K136\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[01;31m\u001b[Kclass \u001b[m\u001b[KFileSource(FixedPartitionedSource[str, int]):\r\n\u001b[32m\u001b[K202\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[01;31m\u001b[Kclass \u001b[m\u001b[K_CSVPartition(StatefulSourcePartition[Dict[str, str], int]):\r\n\u001b[32m\u001b[K231\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[01;31m\u001b[Kclass \u001b[m\u001b[KCSVSource(FixedPartitionedSource[Dict[str, str], int]):\r\n\u001b[32m\u001b[K325\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[01;31m\u001b[Kclass \u001b[m\u001b[K_FileSinkPartition(StatefulSinkPartition[str, int]):\r\n\u001b[32m\u001b[K350\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[01;31m\u001b[Kclass \u001b[m\u001b[KDirSink(FixedPartitionedSink[str, int]):\r\n\u001b[32m\u001b[K419\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[01;31m\u001b[Kclass \u001b[m\u001b[KFileSink(FixedPartitionedSink[str, int]):\r\n"]
[170.71204, "o", "\u001b[?2004hroot@be5de8b4-2ef7-4b40-aa15-0c4ba857c283:/home/user/fraud_detection# "]
