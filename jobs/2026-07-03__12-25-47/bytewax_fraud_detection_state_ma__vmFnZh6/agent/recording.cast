[83.349156, "o", "        return _JSONLinesSinkPartition(self._path)\r\n\u001b[?2004l\r"]
[83.349192, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[83.349278, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[83.349423, "o", "class _JSONLinesSinkPartition(StatelessSinkPartition):\r\n\u001b[?2004l\r\u001b[?2004h"]
[83.349459, "o", "> "]
[83.349564, "o", "    def __init__(self, path: str):\r\n\u001b[?2004l\r\u001b[?2004h"]
[83.349598, "o", "> "]
[83.349674, "o", "        self._path = path\r\n\u001b[?2004l\r"]
[83.349709, "o", "\u001b[?2004h> "]
[83.34991, "o", "        self._fh = open(self._path, \"w\", encoding=\"utf-8\")\r\n\u001b[?2004l\r"]
[83.349945, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[83.350038, "o", "\u001b[?2004h> "]
[83.350148, "o", "    def write_batch(self, items: List[dict]) -> None:\r\n\u001b[?2004l\r"]
[83.350183, "o", "\u001b[?2004h> "]
[83.350267, "o", "        for item in items:\r\n\u001b[?2004l\r\u001b[?2004h"]
[83.350303, "o", "> "]
[83.35046, "o", "            self._fh.write(json.dumps(item) + \"\\n\")\r\n\u001b[?2004l\r\u001b[?2004h"]
[83.350494, "o", "> "]
[83.350569, "o", "        self._fh.flush()\r\n\u001b[?2004l\r\u001b[?2004h"]
[83.350604, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h"]
[83.350647, "o", "> "]
[83.350722, "o", "    def close(self) -> None:\r\n\u001b[?2004l\r\u001b[?2004h"]
[83.350757, "o", "> "]
[83.350832, "o", "        try:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[83.350918, "o", "            self._fh.close()\r\n\u001b[?2004l\r"]
[83.350956, "o", "\u001b[?2004h> "]
[83.351035, "o", "        except Exception:\r\n\u001b[?2004l\r\u001b[?2004h"]
[83.35107, "o", "> "]
[83.351141, "o", "            pass\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[83.351177, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[83.351245, "o", "\u001b[?2004h> "]
[83.351326, "o", "# ---------- State Machine ----------\r\n\u001b[?2004l\r"]
[83.351362, "o", "\u001b[?2004h> "]
[83.351454, "o", "def initial_state() -> dict:\r\n\u001b[?2004l\r\u001b[?2004h"]
[83.351489, "o", "> "]
[83.351559, "o", "    return {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[83.351641, "o", "        \"state\": LOGGED_OUT,\r\n\u001b[?2004l\r"]
[83.351677, "o", "\u001b[?2004h> "]
[83.351763, "o", "        \"login_time\": None,\r\n\u001b[?2004l\r\u001b[?2004h"]
[83.3518, "o", "> "]
[83.351891, "o", "        \"large_tx_count\": 0,\r\n\u001b[?2004l\r"]
[83.351927, "o", "\u001b[?2004h>     }\r\n\u001b[?2004l\r"]
[83.351962, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[83.352049, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[83.352296, "o", "def update_state(state: Optional[dict], event: dict) -> Tuple[dict, Optional[dict]]:\r\n\u001b[?2004l\r"]
[83.352331, "o", "\u001b[?2004h> "]
[83.352575, "o", "    \"\"\"Apply the event to the state, returning (new_state, alert_or_None).\r\n\u001b[?2004l\r\u001b[?2004h"]
[83.35261, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[83.35287, "o", "    State is treated as immutable: we build a brand new dict each call.\r\n\u001b[?2004l\r"]
[83.352905, "o", "\u001b[?2004h>     \"\"\"\r\n\u001b[?2004l\r"]
[83.352937, "o", "\u001b[?2004h> "]
[83.35302, "o", "    if state is None:\r\n\u001b[?2004l\r\u001b[?2004h"]
[83.353058, "o", "> "]
[83.353151, "o", "        state = initial_state()\r\n\u001b[?2004l\r\u001b[?2004h"]
[83.353185, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h"]
[83.353258, "o", "> "]
[83.353337, "o", "    event_type = event.get(\"event_type\")\r\n\u001b[?2004l\r"]
[83.353404, "o", "\u001b[?2004h> "]
[83.35349, "o", "    timestamp = event.get(\"timestamp\")\r\n\u001b[?2004l\r"]
[83.353525, "o", "\u001b[?2004h> "]
[83.353651, "o", "    amount = event.get(\"amount\", 0) or 0\r\n\u001b[?2004l\r"]
[83.353687, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[83.353764, "o", "> "]
[83.353832, "o", "    # Always honor logout immediately.\r\n\u001b[?2004l\r"]
[83.353879, "o", "\u001b[?2004h> "]
[83.353972, "o", "    if event_type == \"logout\":\r\n\u001b[?2004l\r\u001b[?2004h"]
[83.354007, "o", "> "]
[83.354114, "o", "        new_state = initial_state()\r\n\u001b[?2004l\r"]
[83.354151, "o", "\u001b[?2004h> "]
[83.354246, "o", "        return new_state, None\r\n\u001b[?2004l\r\u001b[?2004h"]
[83.35428, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h"]
[83.354354, "o", "> "]
[83.354421, "o", "    if event_type == \"login\":\r\n\u001b[?2004l\r\u001b[?2004h> "]
[83.354496, "o", "        new_state = {\r\n\u001b[?2004l\r"]
[83.354547, "o", "\u001b[?2004h> "]
[83.354627, "o", "            \"state\": LOGGED_IN,\r\n\u001b[?2004l\r"]
[83.354662, "o", "\u001b[?2004h> "]
[83.35478, "o", "            \"login_time\": timestamp,\r\n\u001b[?2004l\r\u001b[?2004h"]
[83.354817, "o", "> "]
[83.354923, "o", "            \"large_tx_count\": 0,\r\n\u001b[?2004l\r\u001b[?2004h"]
[83.354961, "o", "> "]
[83.355039, "o", "        }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[83.355105, "o", "        return new_state, None\r\n\u001b[?2004l\r"]
[83.355139, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[83.355219, "o", "> "]
[83.355281, "o", "    if event_type == \"transaction\":\r\n\u001b[?2004l\r"]
[83.355318, "o", "\u001b[?2004h> "]
[83.355418, "o", "        current = state[\"state\"]\r\n\u001b[?2004l\r\u001b[?2004h"]
[83.355455, "o", "> "]
[83.355579, "o", "        login_time = state[\"login_time\"]\r\n\u001b[?2004l\r\u001b[?2004h"]
[83.355614, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h"]
[83.355686, "o", "> "]
[83.355878, "o", "        # If we're not currently logged in (LOGGED_OUT) or the login window\r\n\u001b[?2004l\r"]
[83.355916, "o", "\u001b[?2004h> "]
[83.356155, "o", "        # has expired (>300 seconds since login), the transaction is ignored\r\n\u001b[?2004l\r\u001b[?2004h"]
[83.35619, "o", "> "]
[83.3563, "o", "        # and we reset to LOGGED_OUT.\r\n\u001b[?2004l\r"]
[83.356336, "o", "\u001b[?2004h> "]
[83.356674, "o", "        if current == LOGGED_OUT or login_time is None or timestamp - login_time > LARGE_TX_WINDOW_SECONDS:\r\n\u001b[?2004l\r\u001b[?2004h"]
[83.356709, "o", "> "]
[83.35684, "o", "            new_state = initial_state()\r\n\u001b[?2004l\r\u001b[?2004h"]
[83.356904, "o", "> "]
[83.356983, "o", "            return new_state, None\r\n\u001b[?2004l\r"]
[83.357018, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[83.357093, "o", "> "]
[83.357245, "o", "        # We are within the 300-second login window.\r\n\u001b[?2004l\r\u001b[?2004h> "]
[83.357412, "o", "        new_large_tx_count = state[\"large_tx_count\"]\r\n\u001b[?2004l\r"]
[83.35745, "o", "\u001b[?2004h> "]
[83.357533, "o", "        new_status = current\r\n\u001b[?2004l\r"]
[83.357569, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[83.357648, "o", "> "]
[83.357749, "o", "        if amount >= LARGE_TRANSACTION_THRESHOLD:\r\n\u001b[?2004l\r"]
[83.357783, "o", "\u001b[?2004h> "]
[83.357923, "o", "            new_large_tx_count += 1\r\n\u001b[?2004l\r\u001b[?2004h"]
[83.357966, "o", "> "]
[83.358066, "o", "            new_status = SUSPICIOUS\r\n\u001b[?2004l\r"]
[83.358126, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[83.358184, "o", "        new_state = {\r\n\u001b[?2004l\r"]
[83.358221, "o", "\u001b[?2004h> "]
[83.358325, "o", "            \"state\": new_status,\r\n\u001b[?2004l\r\u001b[?2004h"]
[83.358358, "o", "> "]
[83.358472, "o", "            \"login_time\": login_time,\r\n\u001b[?2004l\r\u001b[?2004h"]
[83.358508, "o", "> "]
[83.358661, "o", "            \"large_tx_count\": new_large_tx_count,\r\n\u001b[?2004l\r\u001b[?2004h"]
[83.358697, "o", "> "]
[83.358762, "o", "        }\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[83.358798, "o", "> "]
[83.358958, "o", "        # Did we just cross the fraud threshold?\r\n\u001b[?2004l\r\u001b[?2004h"]
[83.358999, "o", "> "]
[83.359161, "o", "        if new_large_tx_count >= LARGE_TX_COUNT_THRESHOLD:\r\n\u001b[?2004l\r\u001b[?2004h"]
[83.359197, "o", "> "]
[83.359421, "o", "            alert = {\"user_id\": event[\"user_id\"], \"alert\": \"FRAUD_ALERT\"}\r\n\u001b[?2004l\r\u001b[?2004h"]
[83.359457, "o", "> "]
[83.359635, "o", "            # Reset to LOGGED_OUT after emitting the alert.\r\n\u001b[?2004l\r\u001b[?2004h"]
[83.35967, "o", "> "]
[83.359797, "o", "            reset_state = initial_state()\r\n\u001b[?2004l\r\u001b[?2004h"]
[83.359832, "o", "> "]
[83.359966, "o", "            return reset_state, alert\r\n\u001b[?2004l\r\u001b[?2004h"]
[83.360007, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[83.360122, "o", "        return new_state, None\r\n\u001b[?2004l\r\u001b[?2004h"]
[83.360166, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[83.360371, "o", "    # Unknown event types are ignored; state is unchanged.\r\n\u001b[?2004l\r\u001b[?2004h> "]
[83.360479, "o", "    return dict(state), None\r\n\u001b[?2004l\r\u001b[?2004h"]
[83.360521, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[83.3606, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[83.360675, "o", "# ---------- Dataflow ----------\r\n\u001b[?2004l\r\u001b[?2004h"]
[83.360715, "o", "> "]
[83.36093, "o", "def build_dataflow(input_path: str, output_path: str) -> Dataflow:\r\n\u001b[?2004l\r\u001b[?2004h"]
[83.36097, "o", "> "]
[83.361079, "o", "    flow = Dataflow(\"fraud_detection\")\r\n\u001b[?2004l\r\u001b[?2004h"]
[83.361123, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[83.361336, "o", "    raw = op.input(\"input\", flow, JSONLinesSource(input_path))\r\n\u001b[?2004l\r\u001b[?2004h"]
[83.361375, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[83.361584, "o", "    # Key by user_id so that state is maintained per user.\r\n\u001b[?2004l\r\u001b[?2004h"]
[83.361624, "o", "> "]
[83.361826, "o", "    keyed = op.key_on(\"key_user\", raw, lambda kv: kv[1][\"user_id\"])\r\n\u001b[?2004l\r\u001b[?2004h"]
[83.361877, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[83.362004, "o", "    # Value is the event payload.\r\n\u001b[?2004l\r\u001b[?2004h"]
[83.362044, "o", "> "]
[83.362217, "o", "    events = op.map(\"value_only\", keyed, lambda kv: kv[1])\r\n\u001b[?2004l\r\u001b[?2004h"]
[83.362257, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[83.362417, "o", "    # Stateful map: state machine per user.\r\n\u001b[?2004l\r\u001b[?2004h"]
[83.362456, "o", "> "]
[83.362655, "o", "    alerts = op.stateful_map(\"fraud_state\", events, update_state)\r\n\u001b[?2004l\r\u001b[?2004h"]
[83.362719, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[83.362944, "o", "    # Keep only the alert value (None events are dropped at the sink).\r\n\u001b[?2004l\r\u001b[?2004h"]
[83.362984, "o", "> "]
[83.363063, "o", "    def to_sink(kv):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[83.363138, "o", "        alert = kv[1]\r\n\u001b[?2004l\r\u001b[?2004h"]
[83.363183, "o", "> "]
[83.363265, "o", "        return alert\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[83.363308, "o", "\u001b[?2004h> "]
[83.363547, "o", "    only_alerts = op.filter(\"drop_none\", alerts, lambda kv: kv[1] is not None)\r\n\u001b[?2004l\r\u001b[?2004h"]
[83.363588, "o", "> "]
[83.363749, "o", "    cleaned = op.map(\"to_alert\", only_alerts, to_sink)\r\n\u001b[?2004l\r\u001b[?2004h"]
[83.363792, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[83.364027, "o", "    op.output(\"alerts_out\", cleaned, JSONLinesSink(output_path))\r\n\u001b[?2004l\r\u001b[?2004h"]
[83.36407, "o", "> "]
[83.364164, "o", "    return flow\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[83.364206, "o", "> "]
[83.364354, "o", "def main(argv: Optional[List[str]] = None) -> int:\r\n\u001b[?2004l\r\u001b[?2004h"]
[83.364395, "o", "> "]
[83.364623, "o", "    parser = argparse.ArgumentParser(description=\"Bytewax Fraud Detection\")\r\n\u001b[?2004l\r\u001b[?2004h"]
[83.364664, "o", "> "]
[83.364905, "o", "    parser.add_argument(\"--input\", required=True, help=\"Input JSONlines file\")\r\n\u001b[?2004l\r\u001b[?2004h"]
[83.364938, "o", "> "]
[83.365188, "o", "    parser.add_argument(\"--output\", required=True, help=\"Output JSONlines file\")\r\n\u001b[?2004l\r\u001b[?2004h"]
[83.365232, "o", "> "]
[83.365325, "o", "    args = parser.parse_args(argv)\r\n\u001b[?2004l\r\u001b[?2004h"]
[83.36537, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[83.36555, "o", "    flow = build_dataflow(args.input, args.output)\r\n\u001b[?2004l\r\u001b[?2004h"]
[83.365596, "o", "> "]
[83.365634, "o", "    run_main(flow)\r\n\u001b[?2004l\r"]
[83.365673, "o", "\u001b[?2004h> "]
[83.3658, "o", "    return 0\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[83.365901, "o", "if __name__ == \"__main__\":\r\n\u001b[?2004l\r\u001b[?2004h"]
[83.365945, "o", "> "]
[83.366038, "o", "    sys.exit(main())\r\n\u001b[?2004l\r\u001b[?2004h> EOF\r\n\u001b[?2004l\r"]
[83.369139, "o", "\u001b[?2004hroot@be5de8b4-2ef7-4b40-aa15-0c4ba857c283:/home/user/fraud_detection# "]
[84.206836, "i", "ls -la\n"]
[84.207987, "o", "ls -la\r\n"]
[84.208598, "o", "\u001b[?2004l\r"]
[84.210018, "o", "total 8\r\n"]
[84.210081, "o", "drwxr-xr-x 1 root root   28 Jul  3 12:51 \u001b[0m\u001b[01;34m.\u001b[0m\r\ndrwxr-xr-x 1 root root   37 Jul  3 12:49 \u001b[01;34m..\u001b[0m\r\n-rw-r--r-- 1 root root 7210 Jul  3 12:51 run.py\r\n"]
[84.210376, "o", "\u001b[?2004hroot@be5de8b4-2ef7-4b40-aa15-0c4ba857c283:/home/user/fraud_detection# "]
[93.600788, "i", "chmod +x /home/user/fraud_detection/run.py\n"]
[93.601408, "o", "chmod +x /home/user/fraud_detection/run.py\r\n\u001b[?2004l\r"]
[93.603827, "o", "\u001b[?2004hroot@be5de8b4-2ef7-4b40-aa15-0c4ba857c283:/home/user/fraud_detection# "]
[94.763701, "i", "cat > /home/user/fraud_detection/input.jsonl << 'EOF'\n{\"user_id\": \"alice\", \"event_type\": \"login\", \"timestamp\": 0}\n{\"user_id\": \"alice\", \"event_type\": \"transaction\", \"amount\": 500, \"timestamp\": 10}\n{\"user_id\": \"alice\", \"event_type\": \"transaction\", \"amount\": 1500, \"timestamp\": 20}\n{\"user_id\": \"alice\", \"event_type\": \"transaction\", \"amount\": 2000, \"timestamp\": 30}\n{\"user_id\": \"alice\", \"event_type\": \"transaction\", \"amount\": 1200, \"timestamp\": 40}\n{\"user_id\": \"bob\", \"event_type\": \"transaction\", \"amount\": 5000, \"timestamp\": 50}\n{\"user_id\": \"bob\", \"event_type\": \"login\", \"timestamp\": 100}\n{\"user_id\": \"bob\", \"event_type\": \"transaction\", \"amount\": 1500, \"timestamp\": 110}\n{\"user_id\": \"bob\", \"event_type\": \"transaction\", \"amount\": 2500, \"timestamp\": 120}\n{\"user_id\": \"bob\", \"event_type\": \"transaction\", \"amount\": 3000, \"timestamp\": 130}\n{\"user_id\": \"bob\", \"event_type\": \"transaction\", \"amount\": 900, \"timestamp\": 140}\n{\"user_id\": \"carol\", \"event_type\": \"login\", \"timestamp\": 200}\n{\"user_id\": \"carol\", \"event_type\": \"transaction\", \"amount\": 1500, \"timestamp\": 250}\n{\"user_id\": \"carol\", \"event_type\": \"transaction\", \"amount\": 2500, \"timestamp\": 600}\n{\"user_id\": \"carol\", \"event_type\": \"transaction\", \"amount\": 1800, \"timestamp\": 650}\n{\"user_id\": \"carol\", \"event_type\": \"transaction\", \"amount\": 1600, \"timestamp\": 700}\n{\"user_id\": \"dave\", \"event_type\": \"login\", \"timestamp\": 1000}\n{\"user_id\": \"dave\", \"event_type\": \"transaction\", \"amount\": 1500, \"timestamp\": 1010}\n{\"user_id\": \"dave\", \"event_type\": \"transaction\", \"amount\": 1500, \"timestamp\": 1020}\n{\"user_id\": \"dave\", \"event_type\": \"transaction\", \"amount\": 1500, \"timestamp\": 1030}\n{\"user_id\": \"eve\", \"event_type\": \"login\", \"timestamp\": 2000}\n{\"user_id\": \"eve\", \"event_type\": \"transaction\", \"amount\": 2000, \"timestamp\": 2100}\n{\"user_id\": \"eve\", \"event_type\": \"transaction\", \"amount\": 2000, \"timestamp\": 2200}\n{\"user_id\": \"eve\", \"event_type\": \"logout\", \"timestamp\": 2250}\n{\"user_id\": \"eve\", \"event_type\": \"login\", \"timestamp\": 2300}\n{\"user_id\": \"eve\", \"event_type\": \"transaction\", \"amount\": 2000, \"timestamp\": 2400}\n{\"user_id\": \"eve\", \"event_type\": \"transaction\", \"amount\": 2000, \"timestamp\": 2500}\n{\"user_id\": \"eve\", \"event_type\": \"transaction\", \"amount\": 2000, \"timestamp\": 2600}\nEOF\n"]
