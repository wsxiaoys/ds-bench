[200.594929, "o", "\r\nTraceback (most recent call last):\r\n  File \"/home/user/fraud_detection/run.py\", line 143, in <module>\r\n    sys.exit(main())\r\n             ^^^^^^\r\n  File \"/home/user/fraud_detection/run.py\", line 138, in main\r\n    run_main(flow)\r\nTypeError: (src/operators.rs:395:38) step \"fraud_detection.alerts_out\" requires `(key, value)` 2-tuple from upstream for routing; got a `str` instead\r\nCaused by => TypeError: 'str' object cannot be converted to 'PyTuple'\r\n"]
[200.610047, "o", "\u001b[?2004hroot@be5de8b4-2ef7-4b40-aa15-0c4ba857c283:/home/user/fraud_detection# "]
[209.970949, "i", "sed -n '95,130p' /home/user/fraud_detection/run.py\n"]
[209.971301, "o", "sed -n '95,130p' /home/user/fraud_detection/run.py\r\n"]
[209.971337, "o", "\u001b[?2004l\r"]
[209.972717, "o", "        return new_state, None\r\n\r\n    # Unknown events are ignored; state remains unchanged (immutable copy).\r\n    return dict(state), None\r\n\r\n\r\n# ---------- Dataflow ----------\r\ndef build_dataflow(input_path: str, output_path: str) -> Dataflow:\r\n"]
[209.972745, "o", "    flow = Dataflow(\"fraud_detection\")\r\n\r\n    # Read raw lines from the input file.\r\n    raw_lines = op.input(\"input\", flow, FileSource(Path(input_path)))\r\n\r\n    # Parse each line into a dict, dropping any blank lines.\r\n    parsed = op.map(\"parse_json\", raw_lines, lambda line: json.loads(line))\r\n\r\n    # Key by user_id so that state is maintained per user.\r\n    keyed = op.key_on(\"key_user\", parsed, lambda event: event[\"user_id\"])\r\n\r\n    # Run the state machine. stateful_map returns (new_state, alert_or_None).\r\n"]
[209.972771, "o", "    processed = op.stateful_map(\"fraud_state\", keyed, update_state)\r\n\r\n    # Drop the (key, None) tuples, keep only alerts.\r\n    only_alerts = op.filter(\"drop_none\", processed, lambda kv: kv[1] is not None)\r\n\r\n    # Strip the key so the sink only sees the alert dict.\r\n    alert_values = op.map(\"strip_key\", only_alerts, lambda kv: kv[1])\r\n\r\n    # Serialize the alert dict to a JSON string for the file sink.\r\n"]
[209.972849, "o", "    keyed_alerts = op.key_on(\"alert_key\", alert_values, lambda alert: alert[\"user_id\"])\r\n    serialized = op.map(\"to_json_str\", keyed_alerts, lambda kv: json.dumps(kv[1]))\r\n\r\n    op.output(\"alerts_out\", serialized, FileSink(Path(output_path)))\r\n    return flow\r\n\r\n\r\n"]
