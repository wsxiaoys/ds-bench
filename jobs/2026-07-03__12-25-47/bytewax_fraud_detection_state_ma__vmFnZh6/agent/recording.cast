[46.078065, "o", "python3 -c \"from bytewax.outputs import StatelessSinkPartition, Sink; import inspect; print(inspect.getsource(StatelessSinkPartition))\" 2>&1 | head -80\r\n\u001b[?2004l\r"]
[46.11158, "o", "class StatelessSinkPartition(ABC, Generic[X]):\r\n    \"\"\"Output partition that is stateless.\"\"\"\r\n\r\n    @abstractmethod\r\n    def write_batch(self, items: List[X]) -> None:\r\n        \"\"\"Write a batch of output items.\r\n\r\n        Called multiple times whenever new items are seen at this\r\n        point in the dataflow.\r\n\r\n        :arg items: Items in the dataflow. Non-deterministically\r\n            batched.\r\n\r\n        \"\"\"\r\n        ...\r\n\r\n    def close(self) -> None:\r\n"]
[46.111783, "o", "        \"\"\"Cleanup this partition when the dataflow completes.\r\n\r\n        This is not guaranteed to be called. It will only be called\r\n        when the dataflow finishes on finite input. It will not be\r\n        called during an abrupt or abort shutdown.\r\n\r\n        \"\"\"\r\n        return\r\n\r\n"]
[46.116039, "o", "\u001b[?2004hroot@be5de8b4-2ef7-4b40-aa15-0c4ba857c283:~# "]
[50.659961, "i", "python3 -c \"from bytewax.inputs import Source; import inspect; print(inspect.getsource(Source))\" 2>&1 | head -60\n"]
