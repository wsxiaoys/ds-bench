[74.201793, "o", "    page_screenshots.sort(key=lambda img: img.index)\r\n\u001b[?2004l\r\u001b[?2004h"]
[74.201843, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[74.201894, "o", "    image_count = 0\r\n\u001b[?2004l\r\u001b[?2004h"]
[74.201936, "o", "> "]
[74.20203, "o", "    with httpx.Client(timeout=60.0) as http:\r\n\u001b[?2004l\r\u001b[?2004h"]
[74.202071, "o", "> "]
[74.202223, "o", "        for page_idx, img in enumerate(page_screenshots, start=1):\r\n\u001b[?2004l\r\u001b[?2004h"]
[74.202265, "o", "> "]
[74.202346, "o", "            if not img.presigned_url:\r\n\u001b[?2004l\r\u001b[?2004h"]
[74.202388, "o", "> "]
[74.20256, "o", "                print(f\"  No presigned_url for {img.filename}\", flush=True)\r\n\u001b[?2004l\r\u001b[?2004h"]
[74.202584, "o", "> "]
[74.202655, "o", "                continue\r\n\u001b[?2004l\r\u001b[?2004h"]
[74.202713, "o", "> "]
[74.202802, "o", "            resp = http.get(img.presigned_url)\r\n\u001b[?2004l\r"]
[74.202845, "o", "\u001b[?2004h> "]
[74.202917, "o", "            resp.raise_for_status()\r\n\u001b[?2004l\r\u001b[?2004h"]
[74.202962, "o", "> "]
[74.20309, "o", "            out_path = IMAGES_DIR / f\"page_{page_idx}.png\"\r\n\u001b[?2004l\r\u001b[?2004h"]
[74.203132, "o", "> "]
[74.203232, "o", "            out_path.write_bytes(resp.content)\r\n\u001b[?2004l\r\u001b[?2004h"]
[74.203274, "o", "> "]
[74.203334, "o", "            image_count += 1\r\n\u001b[?2004l\r\u001b[?2004h"]
[74.203359, "o", "> "]
[74.20356, "o", "            print(f\"  Wrote {out_path} ({len(resp.content)} bytes)\", flush=True)\r\n\u001b[?2004l\r\u001b[?2004h"]
[74.203604, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[74.203681, "o", "    # 5. Write the log file.\r\n\u001b[?2004l\r\u001b[?2004h"]
[74.203717, "o", "> "]
[74.2038, "o", "    md_chars = len(markdown_text)\r\n\u001b[?2004l\r\u001b[?2004h"]
[74.203825, "o", "> "]
[74.203875, "o", "    log_lines = [\r\n\u001b[?2004l\r\u001b[?2004h"]
[74.203919, "o", "> "]
[74.204001, "o", "        f\"Parse job ID: {result.job.id}\",\r\n\u001b[?2004l\r\u001b[?2004h"]
[74.204043, "o", "> "]
[74.204124, "o", "        f\"Markdown chars: {md_chars}\",\r\n\u001b[?2004l\r\u001b[?2004h"]
[74.204166, "o", "> "]
[74.204246, "o", "        f\"Image count: {image_count}\",\r\n\u001b[?2004l\r"]
[74.20427, "o", "\u001b[?2004h>     ]\r\n\u001b[?2004l\r"]
[74.204292, "o", "\u001b[?2004h> "]
[74.204495, "o", "    LOG_PATH.write_text(\"\\n\".join(log_lines) + \"\\n\", encoding=\"utf-8\")\r\n\u001b[?2004l\r\u001b[?2004h"]
[74.20454, "o", "> "]
[74.204645, "o", "    print(f\"Wrote log to {LOG_PATH}\", flush=True)\r\n\u001b[?2004l\r\u001b[?2004h"]
[74.204667, "o", "> "]
[74.204755, "o", "    print(\"DONE\", flush=True)\r\n\u001b[?2004l\r\u001b[?2004h"]
[74.204799, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[74.204842, "o", "\u001b[?2004h> "]
[74.204896, "o", "if __name__ == \"__main__\":\r\n\u001b[?2004l\r\u001b[?2004h"]
[74.204938, "o", ">     try:\r\n\u001b[?2004l\r"]
[74.204981, "o", "\u001b[?2004h> "]
[74.205024, "o", "        main()\r\n\u001b[?2004l\r\u001b[?2004h> "]
[74.205102, "o", "    except Exception as e:\r\n\u001b[?2004l\r\u001b[?2004h"]
[74.205144, "o", "> "]
[74.205278, "o", "        print(f\"ERROR: {e}\", file=sys.stderr, flush=True)\r\n\u001b[?2004l\r\u001b[?2004h"]
[74.205319, "o", "> "]
[74.205362, "o", "        raise\r\n\u001b[?2004l\r\u001b[?2004h> "]
[74.205404, "o", "PYEOF\r\n\u001b[?2004l\r"]
[74.206732, "o", "\u001b[?2004hroot@3d379b3e-ff64-4863-a6a6-ce1714e102dd:~# "]
[74.573457, "i", "cat /home/user/myproject/parse_pdf.py | head -30\n"]
[74.573724, "o", "cat /home/user/myproject/parse_pdf.py | head -30\r\n\u001b[?2004l\r"]
[74.575095, "o", "import os\r\nimport sys\r\nimport httpx\r\nfrom pathlib import Path\r\nfrom llama_cloud import LlamaCloud\r\n\r\nINPUT_PDF = \"/home/user/myproject/input.pdf\"\r\nOUTPUT_DIR = Path(\"/home/user/myproject/output\")\r\nMARKDOWN_PATH = OUTPUT_DIR / \"markdown.md\"\r\nIMAGES_DIR = OUTPUT_DIR / \"images\"\r\nLOG_PATH = OUTPUT_DIR / \"output.log\"\r\n\r\n\r\ndef main():\r\n"]
[74.575149, "o", "    OUTPUT_DIR.mkdir(parents=True, exist_ok=True)\r\n    IMAGES_DIR.mkdir(parents=True, exist_ok=True)\r\n\r\n    client = LlamaCloud()\r\n\r\n    # 1. Upload the PDF as a parse source file\r\n    with open(INPUT_PDF, \"rb\") as f:\r\n        uploaded = client.files.create(file=f, purpose=\"parse\")\r\n    print(f\"Uploaded file id: {uploaded.id}\", flush=True)\r\n\r\n    # 2. Submit a parse job with screenshots and markdown, polling until done.\r\n    result = client.parsing.parse(\r\n        tier=\"agentic\",\r\n        version=\"latest\",\r\n        file_id=uploaded.id,\r\n        expand=[\"markdown\", \"images_content_metadata\"],\r\n"]
[74.575348, "o", "\u001b[?2004hroot@3d379b3e-ff64-4863-a6a6-ce1714e102dd:~# "]
[79.546028, "i", "cd /home/user/myproject && python3 parse_pdf.py 2>&1 | tee parse_run.log\n"]
[79.546393, "o", "cd /home/user/myproject && python3 parse_pdf.py 2>&1 | tee parse_run.log\r\n\u001b[?2004l\r"]
