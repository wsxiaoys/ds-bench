[99.423422, "o", "Register an existing local repo as a new app on Encore Cloud\r\n\r\nUsage:\r\n  encore app init [name]\r\n\r\nFlags:\r\n  -h, --help          help for init\r\n  -l, --lang string   Programming language to use for the app. One of (\"go\" or \"ts\").\r\n\r\nGlobal Flags:\r\n      --trace string    file to write execution trace data to\r\n  -v, --verbose count   verbose output\r\n"]
[99.428772, "o", "\u001b[?2004hroot@c06041aa-5d4c-4edc-8aff-bad24b93687d:/home/user# "]
