[349.516812, "o", "      ['sign', 'verify'],\r\n\u001b[?2004l\r"]
[349.517011, "o", "\u001b[?2004h> "]
[349.517235, "o", "    );\r\n\u001b[?2004l\r"]
[349.517389, "o", "\u001b[?2004h> "]
[349.517892, "o", "  }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[349.518361, "o", "  return keyPromise;\r\n\u001b[?2004l\r"]
[349.51872, "o", "\u001b[?2004h> }\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[349.518999, "o", "\u001b[?2004h> "]
[349.520283, "o", "async function hmacSign(data: Uint8Array): Promise<Uint8Array> {\r\n\u001b[?2004l\r\u001b[?2004h"]
[349.520425, "o", "> "]
[349.521048, "o", "  const key = await getHmacKey();\r\n\u001b[?2004l\r"]
[349.521197, "o", "\u001b[?2004h> "]
[349.522384, "o", "  const sig = await crypto.subtle.sign('HMAC', key, data);\r\n\u001b[?2004l\r"]
[349.522624, "o", "\u001b[?2004h> "]
[349.523254, "o", "  return new Uint8Array(sig);\r\n\u001b[?2004l\r"]
[349.523462, "o", "\u001b[?2004h> }\r\n\u001b[?2004l\r"]
[349.523708, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[349.523879, "o", "\u001b[?2004h> "]
[349.525334, "o", "function timingSafeEqual(a: Uint8Array, b: Uint8Array): boolean {\r\n\u001b[?2004l\r"]
[349.525694, "o", "\u001b[?2004h> "]
[349.526929, "o", "  if (a.length !== b.length) return false;\r\n\u001b[?2004l\r"]
[349.527245, "o", "\u001b[?2004h> "]
[349.52774, "o", "  let diff = 0;\r\n\u001b[?2004l\r"]
[349.528047, "o", "\u001b[?2004h> "]
[349.529136, "o", "  for (let i = 0; i < a.length; i++) {\r\n\u001b[?2004l\r"]
[349.529344, "o", "\u001b[?2004h> "]
[349.529679, "o", "    diff |= a[i] ^ b[i];\r\n\u001b[?2004l\r"]
[349.529937, "o", "\u001b[?2004h>   }\r\n\u001b[?2004l\r"]
[349.530055, "o", "\u001b[?2004h> "]
[349.590372, "o", "  return diff === 0;\r\n\u001b[?2004l\r\u001b[?2004h> }\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[349.590738, "o", "> "]
[349.591961, "o", "export async function createSessionToken(username: string): Promise<string> {\r\n\u001b[?2004l\r\u001b[?2004h"]
[349.592187, "o", "> "]
[349.59332, "o", "  const payload = encoder.encode(JSON.stringify({ u: username }));\r\n\u001b[?2004l\r\u001b[?2004h"]
[349.593736, "o", "> "]
[349.5942, "o", "  const payloadB64 = toBase64Url(payload);\r\n\u001b[?2004l\r"]
[349.59449, "o", "\u001b[?2004h> "]
[349.595662, "o", "  const sig = await hmacSign(encoder.encode(payloadB64));\r\n\u001b[?2004l\r"]
[349.595941, "o", "\u001b[?2004h> "]
[349.597025, "o", "  const sigB64 = toBase64Url(sig);\r\n\u001b[?2004l\r"]
[349.597228, "o", "\u001b[?2004h> "]
[349.597836, "o", "  return `${payloadB64}.${sigB64}`;\r\n\u001b[?2004l\r"]
[349.598118, "o", "\u001b[?2004h> }\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[349.598415, "o", "\u001b[?2004h> "]
[349.599117, "o", "export async function verifySessionToken(\r\n\u001b[?2004l\r\u001b[?2004h"]
[349.599329, "o", "> "]
[349.599836, "o", "  token: string,\r\n\u001b[?2004l\r"]
[349.600201, "o", "\u001b[?2004h> ): Promise<string | null> {\r\n\u001b[?2004l\r"]
[349.600477, "o", "\u001b[?2004h> "]
[349.60161, "o", "  if (!token || typeof token !== 'string') return null;\r\n\u001b[?2004l\r"]
[349.601943, "o", "\u001b[?2004h> "]
[349.602339, "o", "  const dot = token.indexOf('.');\r\n\u001b[?2004l\r"]
[349.602686, "o", "\u001b[?2004h> "]
[349.602998, "o", "  if (dot < 0) return null;\r\n\u001b[?2004l\r"]
[349.603273, "o", "\u001b[?2004h> "]
[349.603888, "o", "  const payloadB64 = token.slice(0, dot);\r\n\u001b[?2004l\r"]
[349.604073, "o", "\u001b[?2004h> "]
[349.60473, "o", "  const sigB64 = token.slice(dot + 1);\r\n\u001b[?2004l\r"]
[349.605051, "o", "\u001b[?2004h> "]
[349.605454, "o", "  let payloadBytes: Uint8Array;\r\n\u001b[?2004l\r\u001b[?2004h"]
[349.605637, "o", "> "]
[349.606106, "o", "  let sigBytes: Uint8Array;\r\n\u001b[?2004l\r"]
[349.606221, "o", "\u001b[?2004h> "]
[349.606606, "o", "  try {\r\n\u001b[?2004l\r\u001b[?2004h"]
[349.60684, "o", "> "]
[349.60787, "o", "    payloadBytes = fromBase64Url(payloadB64);\r\n\u001b[?2004l\r"]
[349.607986, "o", "\u001b[?2004h> "]
[349.608995, "o", "    sigBytes = fromBase64Url(sigB64);\r\n\u001b[?2004l\r"]
[349.609112, "o", "\u001b[?2004h"]
[349.609329, "o", "> "]
[349.609831, "o", "  } catch {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[349.610128, "o", "    return null;\r\n\u001b[?2004l\r\u001b[?2004h"]
[349.610354, "o", ">   }\r\n\u001b[?2004l\r"]
[349.610574, "o", "\u001b[?2004h> "]
[349.611567, "o", "  const expected = await hmacSign(encoder.encode(payloadB64));\r\n\u001b[?2004l\r"]
[349.611781, "o", "\u001b[?2004h> "]
[349.612741, "o", "  if (!timingSafeEqual(expected, sigBytes)) return null;\r\n\u001b[?2004l\r\u001b[?2004h"]
[349.612955, "o", "> "]
[349.613163, "o", "  try {\r\n\u001b[?2004l\r"]
[349.613688, "o", "\u001b[?2004h> "]
[349.614916, "o", "    const json = new TextDecoder().decode(payloadBytes);\r\n\u001b[?2004l\r\u001b[?2004h"]
[349.615169, "o", "> "]
[349.61608, "o", "    const data = JSON.parse(json) as { u?: string };\r\n\u001b[?2004l\r\u001b[?2004h"]
[349.616432, "o", "> "]
[349.617285, "o", "    if (typeof data.u !== 'string' || !data.u) return null;\r\n\u001b[?2004l\r\u001b[?2004h"]
[349.617658, "o", "> "]
[349.617996, "o", "    return data.u;\r\n\u001b[?2004l\r\u001b[?2004h> "]
[349.618327, "o", "  } catch {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[349.618758, "o", "    return null;\r\n\u001b[?2004l\r\u001b[?2004h>   }"]
[349.618975, "o", "\r\n\u001b[?2004l\r\u001b[?2004h"]
[349.619413, "o", "> }\r\n\u001b[?2004l\r"]
[349.619796, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[349.620834, "o", "export function readSessionCookie(request: Request): string | null {\r\n\u001b[?2004l\r\u001b[?2004h"]
[349.621073, "o", "> "]
[349.621937, "o", "  const cookieHeader = request.headers.get('Cookie');\r\n\u001b[?2004l\r\u001b[?2004h"]
[349.62216, "o", "> "]
[349.622691, "o", "  if (!cookieHeader) return null;\r\n\u001b[?2004l\r"]
[349.622923, "o", "\u001b[?2004h> "]
[349.623774, "o", "  for (const cookie of cookieHeader.split(';')) {\r\n\u001b[?2004l\r\u001b[?2004h"]
[349.624083, "o", "> "]
[349.624496, "o", "    const trimmed = cookie.trim();\r\n\u001b[?2004l\r\u001b[?2004h"]
[349.624785, "o", "> "]
[349.625333, "o", "    const eq = trimmed.indexOf('=');\r\n\u001b[?2004l\r"]
[349.62572, "o", "\u001b[?2004h> "]
[349.626046, "o", "    if (eq < 0) continue;\r\n\u001b[?2004l\r\u001b[?2004h> "]
[349.626815, "o", "    const key = trimmed.slice(0, eq);\r\n\u001b[?2004l\r\u001b[?2004h"]
[349.627025, "o", "> "]
[349.627688, "o", "    const value = trimmed.slice(eq + 1);\r\n\u001b[?2004l\r\u001b[?2004h"]
[349.627903, "o", "> "]
[349.62838, "o", "    if (key === 'session') {\r\n\u001b[?2004l\r\u001b[?2004h"]
[349.690697, "o", ">       try {\r\n\u001b[?2004l\r\u001b[?2004h>         return decodeURIComponent(value);\r\n\u001b[?2004l\r\u001b[?2004h>       } catch {\r\n\u001b[?2004l\r\u001b[?2004h>         return value;\r\n\u001b[?2004l\r\u001b[?2004h> "]
[349.691785, "o", "      }\r\n\u001b[?2004l\r"]
[349.693373, "o", "\u001b[?2004h>     }\r\n\u001b[?2004l\r\u001b[?2004h>   }\r\n\u001b[?2004l\r\u001b[?2004h>   return null;\r\n"]
[349.693756, "o", "\u001b[?2004l\r\u001b[?2004h> }\r\n\u001b[?2004l\r\u001b[?2004h"]
[349.694066, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h"]
[349.694375, "o", "> "]
[349.696066, "o", "export function buildSessionCookie(value: string): string {\r\n\u001b[?2004l\r"]
[349.696447, "o", "\u001b[?2004h> "]
[349.698616, "o", "  // HttpOnly + Path=/ as required; do not set Secure so it works over http in dev.\r\n\u001b[?2004l\r"]
[349.698939, "o", "\u001b[?2004h> "]
[349.700225, "o", "  return `session=${encodeURIComponent(value)}; Path=/; HttpOnly; SameSite=Lax`;\r\n\u001b[?2004l\r"]
[349.700458, "o", "\u001b[?2004h> }\r\n"]
[349.700855, "o", "\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[349.701133, "o", "> "]
[349.702076, "o", "export function buildClearSessionCookie(): string {\r\n\u001b[?2004l\r\u001b[?2004h"]
[349.702297, "o", "> "]
[349.703751, "o", "  return `session=; Path=/; HttpOnly; SameSite=Lax; Max-Age=0`;\r\n\u001b[?2004l\r\u001b[?2004h"]
[349.703963, "o", "> }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[349.704407, "o", "EOF\r\n\u001b[?2004l\r"]
