[564.215009, "i", "# Tamper with the middle of the signature\nCOOKIE=$(grep -oP 'session\\s+\\K.*' /tmp/cookies.txt)\nTAMPERED=$(echo \"$COOKIE\" | sed 's/^\\(.......\\).\\(.....\\)/\\1X\\2/')\necho \"Tampered: $TAMPERED\"\nprintf 'localhost\\tFALSE\\t/\\tFALSE\\t0\\tsession %s\\n' \"$TAMPERED\" > /tmp/tampered3.txt\ncurl -sS -i -b /tmp/tampered3.txt http://localhost:5173/dashboard | head -5\n"]
