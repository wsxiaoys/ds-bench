[23.489416, "o", "export const Document: React.FC<{ children: React.ReactNode }> = ({\r\n  children,\r\n}) => (\r\n  <html lang=\"en\">\r\n    <head>\r\n      <meta charSet=\"utf-8\" />\r\n      <meta name=\"viewport\" content=\"width=device-width, initial-scale=1\" />\r\n      <title>@redwoodjs/starter-minimal</title>\r\n      <link rel=\"preconnect\" href=\"https://fonts.googleapis.com\" />\r\n      <link\r\n        rel=\"preconnect\"\r\n        href=\"https://fonts.gstatic.com\"\r\n        crossOrigin=\"\"\r\n      />\r\n      <link\r\n        rel=\"stylesheet\"\r\n        href=\"https://fonts.googleapis.com/css2?family=Noto+Sans:ital,wght@0,100..900;1,100..900&family=Playfair+Display:ital,wght@0,400..900;1,400..900&display=optional\"\r\n        precedence=\"first\"\r\n      />\r\n      <link rel=\"modulepreload\" href=\"/src/client.tsx\" />\r\n"]
[23.489667, "o", "    </head>\r\n    <body>\r\n      {children}\r\n      <script>import(\"/src/client.tsx\")</script>\r\n    </body>\r\n  </html>\r\n);\r\n"]
[23.490531, "o", "\u001b[?2004hroot@cdcee175-d6b4-4fb7-82d4-3785b160d7ce:/home/user/myproject# "]
