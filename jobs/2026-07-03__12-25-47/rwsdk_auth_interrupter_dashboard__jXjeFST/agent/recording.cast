[115.595125, "i", "cat > src/app/auth/session.ts << 'EOF'\n// Session handling using Web Crypto API for HMAC-SHA256 signing.\n// The session cookie value is `base64(payload).base64(signature)`.\nimport { readFileSync } from 'node:fs';\nimport { join } from 'node:path';\n\nconst SECRET_PATH = '/home/user/session_secret.txt';\n\nlet cachedSecret: string | null = null;\n\nfunction getSecret(): string {\n  if (cachedSecret !== null) return cachedSecret;\n  const buf = readFileSync(SECRET_PATH);\n  cachedSecret = buf.toString('utf8').trim();\n  if (!cachedSecret) {\n    throw new Error('Session secret is empty');\n  }\n  return cachedSecret;\n}\n\nconst encoder = new TextEncoder();\n\nfunction toBase64Url(bytes: Uint8Array): string {\n  let binary = '';\n  for (let i = 0; i < bytes.length; i++) {\n    binary += String.fromCharCode(bytes[i]);\n  }\n  const b64 = btoa(binary);\n  return b64.replace(/\\+/g, '-').replace(/\\//g, '_').replace(/=+$/, '');\n}\n\nfunction fromBase64Url(s: string): Uint8Array {\n  const padded = s + '='.repeat((4 - (s.length % 4)) % 4);\n  const b64 = padded.replace(/-/g, '+').replace(/_/g, '/');\n  const binary = atob(b64);\n  const bytes = new Uint8Array(binary.length);\n  for (let i = 0; i < binary.length; i++) {\n    bytes[i] = binary.charCodeAt(i);\n  }\n  return bytes;\n}\n\nasync function getHmacKey(secret: string): Promise<CryptoKey> {\n  return crypto.subtle.importKey(\n    'raw',\n    encoder.encode(secret),\n    { name: 'HMAC', hash: 'SHA-256' },\n    false,\n    ['sign', 'verify'],\n  );\n}\n\nasync function hmacSign(data: Uint8Array): Promise<Uint8Array> {\n  const key = await getHmacKey(getSecret());\n  const sig = await crypto.subtle.sign('HMAC', key, data);\n  return new Uint8Array(sig);\n}\n\n// Constant-time comparison.\nfunction timingSafeEqual(a: Uint8Array, b: Uint8Array): boolean {\n  if (a.length !== b.length) return false;\n  let diff = 0;\n  for (let i = 0; i < a.length; i++) {\n    diff |= a[i] ^ b[i];\n  }\n  return diff === 0;\n}\n\nexport async function createSessionToken(username: string): Promise<string> {\n  const payload = encoder.encode(JSON.stringify({ u: username, t: Date.now() }));\n  const payloadB64 = toBase64Url(payload);\n  const sig = await hmacSign(encoder.encode(payloadB64));\n  const sigB64 = toBase64Url(sig);\n  return `${payloadB64}.${sigB64}`;\n}\n\nexport async function verifySessionToken(\n  token: string,\n): Promise<string | null> {\n  if (!token || typeof token !== 'string') return null;\n  const dot = token.indexOf('.');\n  if (dot < 0) return null;\n  const payloadB64 = token.slice(0, dot);\n  const sigB64 = token.slice(dot + 1);\n  let payloadBytes: Uint8Array;\n  let sigBytes: Uint8Array;\n  try {\n    payloadBytes = fromBase64Url(payloadB64);\n    sigBytes = fromBase64Url(sigB64);\n  } catch {\n    return null;\n  }\n  const expected = await hmacSign(encoder.encode(payloadB64));\n  if (!timingSafeEqual(expected, sigBytes)) return null;\n  try {\n    const json = new TextDecoder().decode(payloadBytes);\n    const data = JSON.parse(json) as { u?: string };\n    if (typeof data.u !== 'string' || !data.u) return null;\n    return data.u;\n  } catch {\n    return null;\n  }\n}\n\nexport function readSessionCookie(request: Request): string | null {\n  const cookieHeader = request.headers.get('Cookie');\n  if (!cookieHeader) return null;\n  for (const cookie of cookieHeader.split(';')) {\n    const trimmed = cookie.trim();\n    const eq = trimmed.indexOf('=');\n    if (eq < 0) continue;\n    const key = trimmed.slice(0, eq);\n    const value = trimmed.slice(eq + 1);\n    if (key === 'session') {\n      try {\n        return decodeURIComponent(value);\n      } catch {\n        return value;\n      }\n    }\n  }\n  return null;\n}\n\nexport function buildSessionCookie(value: string): string {\n  // HttpOnly + Path=/ as required; do not set Secure in dev over http.\n  return `session=${encodeURIComponent(value)}; Path=/; HttpOnly; SameSite=Lax`;\n}\n\nexport function buildClearSessionCookie(): string {\n  return `session=; Path=/; HttpOnly; SameSite=Lax; Max-Age=0`;\n}\nEOF\n"]
