[180.324389, "i", "cat > src/app/pages/home.tsx << 'EOF'\nconst LANDING_HTML = `<!doctype html>\n<html lang=\"en\">\n  <head>\n    <meta charset=\"utf-8\" />\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1\" />\n    <title>RedwoodSDK Auth Demo</title>\n    <style>\n      body { font-family: system-ui, -apple-system, Segoe UI, Roboto, sans-serif; max-width: 640px; margin: 4rem REDACTED; padding: 0 1rem; }\n      h1 { font-size: 1.8rem; margin-bottom: 0.5rem; }\n      p { color: #333; }\n      a { color: #1f6feb; text-decoration: none; }\n      a:hover { text-decoration: underline; }\n      .cta { display: inline-block; margin-top: 1rem; padding: 0.6rem 1rem; background: #1f6feb; color: #fff; border-radius: 4px; }\n      .cta:hover { background: #1858c4; text-decoration: none; }\n    </style>\n  </head>\n  <body>\n    <h1>RedwoodSDK Auth Demo</h1>\n    <p>This is a public landing page.</p>\n    <p>Sign in to view the protected dashboard.</p>\n    <a class=\"cta\" href=\"/login\">Go to login</a>\n  </body>\n</html>`;\n\nexport const homeHandler = (): Response => {\n  return new Response(LANDING_HTML, {\n    status: 200,\n    headers: { 'Content-Type': 'text/html; charset=utf-8' },\n  });\n};\nEOF\n"]
