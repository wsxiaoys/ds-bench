[160.893692, "o", "export const loginHandler = async (\r\n\u001b[?2004l\r\u001b[?2004h>   requestInfo: RequestInfo,\r\n\u001b[?2004l\r\u001b[?2004h> ): Promise<Response> => {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[160.894193, "o", "  const { request } = requestInfo;\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[160.895062, "o", "  if (request.method === 'GET') {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[160.895877, "o", "    return new Response(renderLoginPage(null), {\r\n\u001b[?2004l\r\u001b[?2004h"]
[160.896609, "o", ">       status: 200,\r\n\u001b[?2004l\r\u001b[?2004h"]
[160.897103, "o", "> "]
[160.89772, "o", "      headers: { 'Content-Type': 'text/html; charset=utf-8' },\r\n\u001b[?2004l\r\u001b[?2004h> "]
[160.897926, "o", "    });\r\n\u001b[?2004l\r\u001b[?2004h> "]
[160.898109, "o", "  }\r\n\u001b[?2004l\r"]
[160.898895, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[160.899245, "o", "  if (request.method === 'POST') {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[160.899881, "o", "    const form = await request.formData();\r\n\u001b[?2004l\r\u001b[?2004h"]
[160.900199, "o", "> "]
[160.901015, "o", "    const username = String(form.get('username') ?? '');\r\n\u001b[?2004l\r\u001b[?2004h"]
[160.901247, "o", "> "]
[160.902141, "o", "    const password = String(form.get('password') ?? '');\r\n\u001b[?2004l\r\u001b[?2004h"]
[160.902535, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[160.903253, "o", "    const user = findUser(username, password);\r\n\u001b[?2004l\r"]
[160.90369, "o", "\u001b[?2004h>     if (!user) {\r\n"]
[160.904018, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[160.905318, "o", "      // Invalid credentials: re-render login with status 401, no session cookie.\r\n\u001b[?2004l\r"]
[160.906773, "o", "\u001b[?2004h>       return new Response(\r\n\u001b[?2004l\r\u001b[?2004h> "]
[160.907483, "o", "        renderLoginPage('Invalid username or password. Please try again.'),\r\n\u001b[?2004l\r\u001b[?2004h"]
[160.907783, "o", ">         {\r\n\u001b[?2004l\r"]
[160.907967, "o", "\u001b[?2004h> "]
[160.908342, "o", "          status: 401,\r\n\u001b[?2004l\r\u001b[?2004h"]
[160.908577, "o", "> "]
[160.909683, "o", "          headers: { 'Content-Type': 'text/html; charset=utf-8' },\r\n\u001b[?2004l\r\u001b[?2004h"]
[160.9099, "o", ">         },\r\n"]
[160.91008, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[160.910275, "o", "      );\r\n\u001b[?2004l\r"]
[160.910531, "o", "\u001b[?2004h>     }\r\n\u001b[?2004l\r"]
[160.912133, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h>     const token = await createSessionToken(user.username);\r\n\u001b[?2004l\r\u001b[?2004h> "]
[160.913284, "o", "    return new Response(null, {\r\n\u001b[?2004l\r\u001b[?2004h>       status: 302,\r\n\u001b[?2004l\r\u001b[?2004h> "]
[160.913532, "o", "      headers: {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[160.914542, "o", "        Location: '/dashboard',\r\n\u001b[?2004l\r\u001b[?2004h> "]
[160.915359, "o", "        'Set-Cookie': buildSessionCookie(token),\r\n\u001b[?2004l\r"]
[160.917415, "o", "\u001b[?2004h>       },\r\n\u001b[?2004l\r\u001b[?2004h>     });\r\n\u001b[?2004l\r"]
[160.917737, "o", "\u001b[?2004h>   }\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h>   return new Response('Method Not Allowed', {\r\n"]
[160.917882, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[160.918276, "o", "    status: 405,\r\n\u001b[?2004l\r"]
[160.918494, "o", "\u001b[?2004h> "]
[160.919165, "o", "    headers: { Allow: 'GET, POST' },\r\n\u001b[?2004l\r"]
[160.919381, "o", "\u001b[?2004h"]
[160.919632, "o", ">   });\r\n\u001b[?2004l\r"]
[160.91985, "o", "\u001b[?2004h> };"]
[160.920076, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[160.920293, "o", "EOF\r\n\u001b[?2004l\r"]
[160.932333, "o", "\u001b[?2004hroot@cdcee175-d6b4-4fb7-82d4-3785b160d7ce:/home/user/myproject# "]
[171.12446, "i", "cat > src/app/pages/dashboard.tsx << 'EOF'\nimport type { RequestInfo } from 'rwsdk/router';\nimport { buildClearSessionCookie } from '@/app/auth/session';\n\nfunction escapeHtml(s: string): string {\n  return s\n    .replace(/&/g, '&amp;')\n    .replace(/</g, '&lt;')\n    .replace(/>/g, '&gt;')\n    .replace(/\"/g, '&quot;')\n    .replace(/'/g, '&#39;');\n}\n\nfunction renderDashboard(username: string): string {\n  return `<!doctype html>\n<html lang=\"en\">\n  <head>\n    <meta charset=\"utf-8\" />\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1\" />\n    <title>Dashboard</title>\n    <style>\n      body { font-family: system-ui, -apple-system, Segoe UI, Roboto, sans-serif; max-width: 640px; margin: 4rem REDACTED; padding: 0 1rem; }\n      h1 { font-size: 1.6rem; margin-bottom: 0.5rem; }\n      p { color: #333; }\n      .user { font-weight: 600; }\n      form { margin-top: 1.5rem; }\n      button { padding: 0.5rem 1rem; font-size: 1rem; background: #d9534f; color: #fff; border: 0; border-radius: 4px; cursor: pointer; }\n      button:hover { background: #b52a26; }\n    </style>\n  </head>\n  <body>\n    <h1>Dashboard</h1>\n    <p>Welcome, <span class=\"user\">${escapeHtml(username)}</span>!</p>\n    <p>You are signed in.</p>\n    <form method=\"post\" action=\"/logout\">\n      <button type=\"submit\">Sign out</button>\n    </form>\n  </body>\n</html>`;\n}\n\n// Handler that runs AFTER the isAuthenticated interrupter.\n// The interrupter sets ctx.username before this runs.\nexport const dashboardHandler = (requestInfo: RequestInfo): Response => {\n  const username = (requestInfo.ctx as { username?: string }).username ?? '';\n  return new Response(renderDashboard(username), {\n    status: 200,\n    headers: { 'Content-Type': 'text/html; charset=utf-8' },\n  });\n};\n\nexport const logoutHandler = (): Response => {\n  return new Response(null, {\n    status: 302,\n    headers: {\n      Location: '/login',\n      'Set-Cookie': buildClearSessionCookie(),\n    },\n  });\n};\nEOF\n"]
