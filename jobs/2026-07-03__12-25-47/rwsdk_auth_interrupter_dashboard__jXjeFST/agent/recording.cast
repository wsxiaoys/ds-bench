[138.501139, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[138.501409, "o", "\u001b[?2004h> "]
[138.502578, "o", "export function buildSessionCookie(value: string): string {\r\n\u001b[?2004l\r"]
[138.502856, "o", "\u001b[?2004h> "]
[138.504384, "o", "  // HttpOnly + Path=/ as required; do not set Secure so it works over http in dev.\r\n\u001b[?2004l\r"]
[138.504688, "o", "\u001b[?2004h> "]
[138.506171, "o", "  return `session=${encodeURIComponent(value)}; Path=/; HttpOnly; SameSite=Lax`;\r\n\u001b[?2004l\r"]
[138.506451, "o", "\u001b[?2004h> }\r\n\u001b[?2004l\r"]
[138.506829, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[138.507104, "o", "> "]
[138.508095, "o", "export function buildClearSessionCookie(): string {\r\n\u001b[?2004l\r"]
[138.508304, "o", "\u001b[?2004h> "]
[138.509727, "o", "  return `session=; Path=/; HttpOnly; SameSite=Lax; Max-Age=0`;\r\n\u001b[?2004l\r"]
[138.509938, "o", "\u001b[?2004h> }\r\n\u001b[?2004l\r"]
