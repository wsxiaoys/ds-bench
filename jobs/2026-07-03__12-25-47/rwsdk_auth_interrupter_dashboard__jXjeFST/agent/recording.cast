[138.491688, "o", "    const eq = trimmed.indexOf('=');\r\n\u001b[?2004l\r"]
[138.49197, "o", "\u001b[?2004h> "]
[138.492488, "o", "    if (eq < 0) continue;\r\n\u001b[?2004l\r"]
[138.492748, "o", "\u001b[?2004h> "]
[138.493561, "o", "    const key = trimmed.slice(0, eq);\r\n\u001b[?2004l\r"]
[138.493836, "o", "\u001b[?2004h> "]
[138.494695, "o", "    const value = trimmed.slice(eq + 1);\r\n\u001b[?2004l\r"]
[138.49498, "o", "\u001b[?2004h> "]
[138.495574, "o", "    if (key === 'session') {\r\n\u001b[?2004l\r"]
[138.495845, "o", "\u001b[?2004h> "]
[138.496161, "o", "      try {\r\n\u001b[?2004l\r"]
[138.496352, "o", "\u001b[?2004h> "]
[138.497259, "o", "        return decodeURIComponent(value);\r\n\u001b[?2004l\r"]
[138.497483, "o", "\u001b[?2004h> "]
[138.497937, "o", "      } catch {\r\n\u001b[?2004l\r"]
