[549.86529, "i", "# Get the original cookie value, then tamper a single character in the signature\nCOOKIE=$(grep -oP 'session\\s+\\K.*' /tmp/cookies.txt)\necho \"Original: $COOKIE\"\n# Flip one character in the signature part (after the dot)\n# Cookie format: payload.signature\nTAMPERED=$(echo \"$COOKIE\" | sed 's/.$/X/')\necho \"Tampered: $TAMPERED\"\nprintf 'localhost\\tFALSE\\t/\\tFALSE\\t0\\tsession %s\\n' \"$TAMPERED\" > /tmp/tampered2.txt\ncat /tmp/tampered2.txt\n"]
