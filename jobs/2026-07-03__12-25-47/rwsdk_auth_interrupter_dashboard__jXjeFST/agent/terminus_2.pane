[?2004l// Session handling using Web Crypto API for HMAC-SHA256 signing.
// The session cookie value is `base64(payload).base64(signature)`.
import { readFileSync } from 'node:fs';
import { join } from 'node:path';

const SECRET_PATH = '/home/user/session_secret.txt';

let cachedSecret: string | null = null;

function getSecret(): string {
  if (cachedSecret !== null) return cachedSecret;
  const buf = readFileSync(SECRET_PATH);
  cachedSecret = buf.toString('utf8').trim();
  if (!cachedSecret) {
    throw new Error('Session secret is empty');
  }
  return cachedSecret;
}

const encoder = new TextEncoder();

function toBase64Url(bytes: Uint8Array): string {
  let binary = '';
  for (let i = 0; i < bytes.length; i++) {
    binary += String.fromCharCode(bytes[i]);
  }
  const b64 = btoa(binary);
  return b64.replace(/\+/g, '-').replace(/\//g, '_').replace(/=+$/, '');
}

