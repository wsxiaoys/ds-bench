[400.850845, "i", "cat > src/App.tsx << 'APPEOF'\nimport { useState } from 'react'\nimport { useForm } from '@tanstack/react-form'\nimport { zodValidator } from '@tanstack/zod-form-adapter'\nimport { z } from 'zod'\nimport './App.css'\n\nconst userInfoSchema = z.object({\n  firstName: z.string().min(2, 'First name must be at least 2 characters'),\n  lastName: z.string().min(2, 'Last name must be at least 2 characters'),\n})\n\nconst accountInfoSchema = z.object({\n  email: z.string().email('Invalid email address'),\n  password: z.string().min(6, 'Password must be at least 6 characters'),\n})\n\nconst fullSchema = userInfoSchema.merge(accountInfoSchema)\n\ntype FormData = z.infer<typeof fullSchema>\n\nfunction App() {\n  const [step, setStep] = useState<1 | 2>(1)\n  const [submittedData, setSubmittedData] = useState<FormData | null>(null)\n\n  const form = useForm({\n    defaultValues: {\n      firstName: '',\n      lastName: '',\n      email: '',\n      password: '',\n    } as FormData,\n    validators: {\n      onChange: zodValidator(),\n    },\n    onSubmit: async ({ value }) => {\n      setSubmittedData(value)\n    },\n  })\n\n  const handleNext = async () => {\n    // Validate only the user info fields for step 1\n    const result = userInfoSchema.safeParse(form.state.values)\n    if (result.success) {\n      setStep(2)\n    } else {\n      // Trigger validation on the step 1 fields\n      await form.validateAllFields('change')\n    }\n  }\n\n  const handleBack = () => {\n    setStep(1)\n  }\n\n  if (submittedData) {\n    return (\n      <div className=\"app\">\n        <h1>Registration Successful!</h1>\n        <div id=\"success-message\" data-testid=\"success-message\">\n          <p>\n            <strong>First Name:</strong> {submittedData.firstName}\n          </p>\n          <p>\n            <strong>Last Name:</strong> {submittedData.lastName}\n          </p>\n          <p>\n            <strong>Email:</strong> {submittedData.email}\n          </p>\n          <p>\n            <strong>Password:</strong> {submittedData.password}\n          </p>\n        </div>\n        <pre id=\"success-data\" style={{ display: 'none' }}>\n          {JSON.stringify(submittedData)}\n        </pre>\n      </div>\n    )\n  }\n\n  return (\n    <div className=\"app\">\n      <h1>Multi-step Registration Form</h1>\n      <p>Step {step} of 2</p>\n      <form\n        onSubmit={(e) => {\n          e.preventDefault()\n          e.stopPropagation()\n          form.handleSubmit()\n        }}\n      >\n        {step === 1 && (\n          <div data-testid=\"step-1\">\n            <h2>User Info</h2>\n            <form.Field\n              name=\"firstName\"\n              validators={{\n                onChange: ({ value }) => {\n                  const v = zodValidator()()\n                  return v.validate({ value, validationSource: 'field' }, z.string().min(2, 'First name must be at least 2 characters'))\n                },\n              }}\n            >\n              {(field) => (\n                <div className=\"field\">\n                  <label htmlFor={field.name}>First Name</label>\n                  <input\n                    id={field.name}\n                    name={field.name}\n                    type=\"text\"\n                    value={field.state.value}\n                    onBlur={field.handleBlur}\n                    onChange={(e) => field.handleChange(e.target.value)}\n                  />\n                  {field.state.meta.errors.length > 0 && (\n                    <div className=\"error\" data-testid={`${field.name}-error`}>\n                      {field.state.meta.errors[0]?.toString()}\n                    </div>\n                  )}\n                </div>\n              )}\n            </form.Field>\n            <form.Field\n              name=\"lastName\"\n              validators={{\n                onChange: ({ value }) => {\n                  const v = zodValidator()()\n                  return v.validate({ value, validationSource: 'field' }, z.string().min(2, 'Last name must be at least 2 characters'))\n                },\n              }}\n            >\n              {(field) => (\n                <div className=\"field\">\n                  <label htmlFor={field.name}>Las"]
[400.850948, "i", "t Name</label>\n                  <input\n                    id={field.name}\n                    name={field.name}\n                    type=\"text\"\n                    value={field.state.value}\n                    onBlur={field.handleBlur}\n                    onChange={(e) => field.handleChange(e.target.value)}\n                  />\n                  {field.state.meta.errors.length > 0 && (\n                    <div className=\"error\" data-testid={`${field.name}-error`}>\n                      {field.state.meta.errors[0]?.toString()}\n                    </div>\n                  )}\n                </div>\n              )}\n            </form.Field>\n            <div className=\"actions\">\n              <button type=\"button\" onClick={handleNext} data-testid=\"next-button\">\n                Next\n              </button>\n            </div>\n          </div>\n        )}\n\n        {step === 2 && (\n          <div data-testid=\"step-2\">\n            <h2>Account Info</h2>\n            <form.Field\n              name=\"email\"\n              validators={{\n                onChange: ({ value }) => {\n                  const v = zodValidator()()\n                  return v.validate({ value, validationSource: 'field' }, z.string().email('Invalid email address'))\n                },\n              }}\n            >\n              {(field) => (\n                <div className=\"field\">\n                  <label htmlFor={field.name}>Email</label>\n                  <input\n                    id={field.name}\n                    name={field.name}\n                    type=\"email\"\n                    value={field.state.value}\n                    onBlur={field.handleBlur}\n                    onChange={(e) => field.handleChange(e.target.value)}\n                  />\n                  {field.state.meta.errors.length > 0 && (\n                    <div className=\"error\" data-testid={`${field.name}-error`}>\n                      {field.state.meta.errors[0]?.toString()}\n                    </div>\n                  )}\n                </div>\n              )}\n            </form.Field>\n            <form.Field\n              name=\"password\"\n              validators={{\n                onChange: ({ value }) => {\n                  const v = zodValidator()()\n                  return v.validate({ value, validationSource: 'field' }, z.string().min(6, 'Password must be at least 6 characters'))\n                },\n              }}\n            >\n              {(field) => (\n                <div className=\"field\">\n                  <label htmlFor={field.name}>Password</label>\n                  <input\n                    id={field.name}\n                    name={field.name}\n                    type=\"password\"\n                    value={field.state.value}\n                    onBlur={field.handleBlur}\n                    onChange={(e) => field.handleChange(e.target.value)}\n                  />\n                  {field.state.meta.errors.length > 0 && (\n                    <div className=\"error\" data-testid={`${field.name}-error`}>\n                      {field.state.meta.errors[0]?.toString()}\n                    </div>\n                  )}\n                </div>\n              )}\n            </form.Field>\n            <div className=\"actions\">\n              <button type=\"button\" onClick={handleBack} data-testid=\"back-button\">\n                Back\n              </button>\n              <button type=\"submit\" data-testid=\"submit-button\">\n                Submit\n              </button>\n            </div>\n          </div>\n        )}\n      </form>\n    </div>\n  )\n}\n\nexport default App\nAPPEOF\n"]
