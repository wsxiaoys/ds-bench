[10.875791, "o", "{\r\n  \"name\": \"tanstack-form-wizard\",\r\n  \"private\": true,\r\n  \"version\": \"0.0.0\",\r\n  \"type\": \"module\",\r\n  \"scripts\": {\r\n    \"dev\": \"vite\",\r\n    \"build\": \"tsc -b && vite build\",\r\n    \"lint\": \"oxlint\",\r\n    \"preview\": \"vite preview\"\r\n  },\r\n  \"dependencies\": {\r\n    \"@tanstack/react-form\": \"^1.33.0\",\r\n    \"@tanstack/zod-form-adapter\": \"^0.42.1\",\r\n    \"react\": \"^19.2.7\",\r\n    \"react-dom\": \"^19.2.7\",\r\n    \"zod\": \"^3.25.76\"\r\n  },\r\n  \"devDependencies\": {\r\n    \"@types/node\": \"^24.13.2\",\r\n    \"@types/react\": \"^19.2.17\",\r\n    \"@types/react-dom\": \"^19.2.3\",\r\n    \"@vitejs/plugin-react\": \"^6.0.3\",\r\n    \"oxlint\": \"^1.71.0\",\r\n    \"typescript\": \"~6.0.2\",\r\n    \"vite\": \"^8.1.1\"\r\n  }\r\n}\r\n"]
