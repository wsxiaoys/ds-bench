[82.786337, "o", ".counter {\r\n  font-size: 16px;\r\n  padding: 5px 10px;\r\n  border-radius: 5px;\r\n  color: var(--accent);\r\n  background: var(--accent-bg);\r\n  border: 2px solid transparent;\r\n  transition: border-color 0.3s;\r\n  margin-bottom: 24px;\r\n\r\n  &:hover {\r\n    border-color: var(--accent-border);\r\n  }\r\n  &:focus-visible {\r\n    outline: 2px solid var(--accent);\r\n    outline-offset: 2px;\r\n  }\r\n}\r\n\r\n.hero {\r\n"]
[82.786371, "o", "  position: relative;\r\n\r\n  .base,\r\n  .framework,\r\n  .vite {\r\n    inset-inline: 0;\r\n    margin: 0 REDACTED;\r\n  }\r\n\r\n  .base {\r\n"]
