[158.521981, "o", "cat /home/user/tanstack-form-wizard/node_modules/zod/package.json | head -20\r\n\u001b[?2004l\r"]
[158.522831, "o", "{\r\n  \"name\": \"zod\",\r\n  \"version\": \"3.25.76\",\r\n  \"type\": \"module\",\r\n  \"author\": \"Colin McDonnell <zod@colinhacks.com>\",\r\n  \"description\": \"TypeScript-first schema declaration and validation library with static type inference\",\r\n"]
[158.522878, "o", "  \"files\": [\r\n    \"src\",\r\n    \"**/*.js\",\r\n    \"**/*.mjs\",\r\n    \"**/*.cjs\",\r\n    \"**/*.d.ts\",\r\n    \"**/*.d.mts\",\r\n    \"**/*.d.cts\"\r\n  ],\r\n"]
[158.522895, "o", "  \"funding\": \"https://github.com/sponsors/colinhacks\",\r\n  \"homepage\": \"https://zod.dev\",\r\n  \"keywords\": [\r\n    \"typescript\",\r\n    \"schema\",\r\n"]
[158.523086, "o", "\u001b[?2004hroot@c98027d0-8e94-483a-a9fe-703d5f8a9de7:/home/user/tanstack-form-wizard# "]
