[479.166257, "o", "    <div className=\"app\">\r\n\u001b[?2004l\r\u001b[?2004h>       <h1>Multi-step Registration Form</h1>\r\n\u001b[?2004l\r\u001b[?2004h>       <p>Step {step} of 2</p>\r\n\u001b[?2004l\r\u001b[?2004h>       <form\r\n\u001b[?2004l\r\u001b[?2004h>         onSubmit={(e) => {\r\n\u001b[?2004l\r\u001b[?2004h>           e.preventDefault()\r\n\u001b[?2004l\r\u001b[?2004h>           e.stopPropagation()\r\n\u001b[?2004l\r\u001b[?2004h>           form.handleSubmit()\r\n\u001b[?2004l\r\u001b[?2004h>         }}\r\n\u001b[?2004l\r\u001b[?2004h>       >\r\n\u001b[?2004l\r\u001b[?2004h>         {step === 1 && (\r\n\u001b[?2004l\r\u001b[?2004h>           <div data-testid=\"step-1\">\r\n\u001b[?2004l\r\u001b[?2004h>             <h2>User Info</h2>\r\n\u001b[?2004l\r\u001b[?2004h>             <form.Field\r\n\u001b[?2004l\r\u001b[?2004h>               name=\"firstName\"\r\n\u001b[?2004l\r\u001b[?2004h>               validators={{\r\n\u001b[?2004l\r\u001b[?2004h>                 onChange: zodValidate(\r\n\u001b[?2004l\r\u001b[?2004h>                   z.string().min(2, 'First name must be at least 2 characters'),\r\n\u001b[?2004l\r\u001b[?2004h>                 ),\r\n\u001b[?2004l\r\u001b[?2004h>               }}\r\n\u001b[?2004l\r\u001b[?2004h>             >\r\n\u001b[?2004l\r\u001b[?2004h>               {(field) => (\r\n\u001b[?2004l\r\u001b[?2004h>                 <div className=\"field\">\r\n\u001b[?2004l\r\u001b[?2004h>                   <label htmlFor={field.name}>First Name</label>\r\n\u001b[?2004l\r\u001b[?2004h>                   <input\r\n\u001b[?2004l\r\u001b[?2004h>                     id={field.name}\r\n\u001b[?2004l\r\u001b[?2004h>                     name={field.name}\r\n\u001b[?2004l\r\u001b[?2004h>                     type=\"text\"\r\n\u001b[?2004l\r\u001b[?2004h>                     value={field.state.value}\r\n\u001b[?2004l\r\u001b[?2004h>                     onBlur={field.handleBlur}\r\n\u001b[?2004l\r\u001b[?2004h>                     onChange={(e) => field.handleChange(e.target.value)}\r\n\u001b[?2004l\r\u001b[?2004h>                   />\r\n\u001b[?2004l\r\u001b[?2004h>                   {field.state.meta.errors.length > 0 && (\r\n\u001b[?2004l\r\u001b[?2004h>                     <div className=\"error\" data-testid={`${field.name}-error`}>\r\n\u001b[?2004l\r\u001b[?2004h>                       {String(field.state.meta.errors[0] ?? '')}\r\n\u001b[?2004l\r\u001b[?2004h>                     </div>\r\n\u001b[?2004l\r\u001b[?2004h>                   )}\r\n\u001b[?2004l\r\u001b[?2004h>                 </div>\r\n\u001b[?2004l\r\u001b[?2004h>               )}\r\n\u001b[?2004l\r\u001b[?2004h>             </form.Field>\r\n\u001b[?2004l\r\u001b[?2004h>             <form.Field\r\n\u001b[?2004l\r\u001b[?2004h>               name=\"lastName\"\r\n\u001b[?2004l\r\u001b[?2004h>               validators={{\r\n\u001b[?2004l\r\u001b[?2004h>                 onChange: zodValidate(\r\n\u001b[?2004l\r\u001b[?2004h>                   z.string().min(2, 'Last name must be at least 2 characters'),\r\n\u001b[?2004l\r\u001b[?2004h>                 ),\r\n\u001b[?2004l\r\u001b[?2004h>               }}\r\n\u001b[?2004l\r\u001b[?2004h>             >\r\n\u001b[?2004l\r\u001b[?2004h>               {(field) => (\r\n\u001b[?2004l\r\u001b[?2004h>                 <div className=\"field\">\r\n\u001b[?2004l\r\u001b[?2004h>                   <label htmlFor={field.name}>Last Name</label>\r\n\u001b[?2004l\r\u001b[?2004h>                   <input\r\n\u001b[?2004l\r\u001b[?2004h>                     id={field.name}\r\n\u001b[?2004l\r\u001b[?2004h>                     name={field.name}\r\n\u001b[?2004l\r\u001b[?2004h>                     type=\"text\"\r\n\u001b[?2004l\r\u001b[?2004h>                     value={field.state.value}\r\n\u001b[?2004l\r\u001b[?2004h>                     onBlur={field.handleBlur}\r\n\u001b[?2004l\r\u001b[?2004h>                     onChange={(e) => field.handleChange(e.target.value)}\r\n\u001b[?2004l\r\u001b[?2004h>          