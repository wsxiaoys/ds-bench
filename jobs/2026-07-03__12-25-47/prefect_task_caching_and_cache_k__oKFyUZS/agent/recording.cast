[7.113426, "o", "\u001b[?2004hroot@978e2ef5-beb8-42ad-bc6d-5694f0f0aa5a:/home/user/project# "]
[11.756432, "i", "cat > /home/user/project/flow.py << 'EOF'\nfrom prefect import task, flow\n\n\ndef cache_key(context, parameters):\n    return \"fetch-\" + parameters[\"url\"]\n\n\n@task(cache_key_fn=cache_key)\ndef fetch_data(url: str) -> str:\n    return \"Data from \" + url\n\n\n@flow\ndef process_data():\n    result1 = fetch_data(\"http://example.com\")\n    print(result1)\n    result2 = fetch_data(\"http://example.com\")\n    print(result2)\n\n\nif __name__ == \"__main__\":\n    process_data()\nEOF\n"]
