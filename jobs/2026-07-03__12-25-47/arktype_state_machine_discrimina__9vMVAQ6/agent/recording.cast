[129.76749, "o", "    // defined as an arrow function since it is often detached, e.g. when passing to tRPC\r\n    // otherwise, would run into issues with this binding\r\n    assert = (data, pipedFromCtx) => this(data, pipedFromCtx, errors => errors.throw());\r\n    traverse(data, pipedFromCtx) {\r\n        return this(data, pipedFromCtx, null);\r\n    }\r\n    /** rawIn should be used internally instead */\r\n    get in() {\r\n        // ensure the node has been finalized if in is being used externally\r\n        return this.cacheGetter(\"in\", this.rawIn.isRoot() ? this.$.finalize(this.rawIn) : this.rawIn);\r\n    }\r\n    get rawIn() {\r\n        return this.cacheGetter(\"rawIn\", this.getIo(\"in\"));\r\n    }\r\n    /** rawOut should be used internally instead */\r\n    get out() {\r\n        // ensure the node has been finalized if out is being used externally\r\n        return this.cacheGetter(\"out\", this.rawOut.isRoot() ? this.$.finalize(this.rawOut) : this.rawOut);\r\n    }\r\n    get rawOut() {\r\n        return this.cacheGetter(\"rawOut\", this.getIo(\"out\"));\r\n    }\r\n    // Should be refactored to use transform\r\n"]
[129.767694, "o", "\u001b[?2004hroot@cf6d50dc-0a55-42a9-8458-8fd68761a741:/home/user/myproject# "]
[143.607075, "i", "cat > /home/user/myproject/arktest3.ts << 'EOF'\nimport { type, fn } from \"arktype\";\n\nconst Idle = type({ status: \"'idle'\" });\nconst Loading = type({ status: \"'loading'\", startedAt: \"number >= 0\" });\nconst Success = type({ status: \"'success'\", data: \"unknown\", fetchedAt: \"number >= 0\" });\nconst Failure = type({ status: \"'failure'\", code: \"400 <= number <= 599\", reason: \"1 <= string <= 200\" });\n\nconst State = Idle.or(Loading).or(Success).or(Failure);\n\n// Define events\nconst Start = type({ type: \"'start'\", at: \"number\" });\nconst Resolve = type({ type: \"'resolve'\", data: \"unknown\", at: \"number\" });\nconst Reject = type({ type: \"'reject'\", code: \"integer\", reason: \"string\", at: \"number\" });\nconst Reset = type({ type: \"'reset'\" });\n\nconst Event = Start.or(Resolve).or(Reject).or(Reset);\n\nconsole.log(\"Event test:\");\nconsole.log(Event({ type: \"start\", at: 100 }));\nconsole.log(Event({ type: \"resolve\", data: { foo: 1 }, at: 200 }));\nconsole.log(Event({ type: \"reject\", code: 500, reason: \"oops\", at: 300 }));\nconsole.log(Event({ type: \"reset\" }));\nconsole.log(Event({ type: \"invalid\" }));\nconsole.log(Event({ type: \"start\", at: \"bad\" }));\n\n// Test array\nconst Events = type({ initial: State, events: Event.array() });\n\nconsole.log(\"Document test:\");\nconsole.log(Events({ initial: { status: \"idle\" }, events: [{ type: \"start\", at: 100 }] }));\nconsole.log(Events({ initial: { status: \"loading\", startedAt: 5 }, events: [{ type: \"start\", at: 100 }] }));\nconsole.log(Events({ initial: \"bad\" }));\n\n// Now test the function wrapper\nconst transition = fn(\n  State,\n  Event,\n  \":\",\n  State\n)((state, event) => {\n  if (event.type === \"reset\") return { status: \"idle\" };\n  if (state.status === \"idle\" && event.type === \"start\") {\n    return { status: \"loading\", startedAt: Math.trunc(event.at) };\n  }\n  if (state.status === \"loading\" && event.type === \"resolve\") {\n    return { status: \"success\", data: event.data, fetchedAt: Math.trunc(event.at) };\n  }\n  if (state.status === \"loading\" && event.type === \"reject\") {\n    return { status: \"failure\", code: event.code, reason: event.reason };\n  }\n  return state;\n});\n\nconsole.log(\"Transition tests:\");\ntry {\n  console.log(transition({ status: \"idle\" }, { type: \"start\", at: 100 }));\n} catch(e) { console.log(\"ERROR:\", String(e).substring(0, 200)); }\n\ntry {\n  console.log(transition({ status: \"idle\" }, { type: \"reset\" }));\n} catch(e) { console.log(\"ERROR:\", String(e).substring(0, 200)); }\n\ntry {\n  console.log(transition({ status: \"loading\", startedAt: 5 }, { type: \"resolve\", data: \"hello\", at: 200 }));\n} catch(e) { console.log(\"ERROR:\", String(e).substring(0, 200)); }\n\ntry {\n  console.log(transition({ status: \"loading\", startedAt: 5 }, { type: \"reject\", code: 500, reason: \"oops\", at: 200 }));\n} catch(e) { console.log(\"ERROR:\", String(e).substring(0, 200)); }\n\ntry {\n  console.log(transition({ status: \"loading\", startedAt: 5 }, { type: \"start\", at: 200 }));\n} catch(e) { console.log(\"ERROR:\", String(e).substring(0, 200)); }\n\ntry {\n  console.log(transition({ status: \"bad\" }, { type: \"start\", at: 100 }));\n} catch(e) { console.log(\"ERROR:\", String(e).substring(0, 200)); }\nEOF\ncd /home/user/myproject && npx --no-install tsx arktest3.ts 2>&1 | head -100\n"]
