[97.772961, "i", "cat > /home/user/myproject/arktest2.ts << 'EOF'\nimport { type, fn } from \"arktype\";\n\n// Test 1: tuple form for unions\nconst Idle = type({ status: \"'idle'\" });\nconst Loading = type({ status: \"'loading'\", startedAt: \"0 <= number\" });\nconst Success = type({ status: \"'success'\", data: \"unknown\", fetchedAt: \"0 <= number\" });\nconst Failure = type({ status: \"'failure'\", code: \"400 <= number <= 599\", reason: \"1 <= string <= 200\" });\n\nconst State = Idle.or(Loading).or(Success).or(Failure);\n\nconsole.log(\"Tuple form...\");\nconsole.log(State({ status: \"idle\" }));\nconsole.log(State({ status: \"loading\", startedAt: 5 }));\nconsole.log(State({ status: \"success\", data: { foo: 1 }, fetchedAt: 100 }));\nconsole.log(State({ status: \"failure\", code: 500, reason: \"oops\" }));\nconsole.log(State({ status: \"idle\", startedAt: 1 }));\n\n// Test 2: a function\nconst Increment = fn({\n  args: [\"0 <= number\"],\n  returns: \"0 <= number\",\n})((n) => n + 1);\n\nconsole.log(\"Function test:\");\nconsole.log(Increment(5));\nconsole.log(Increment(\"bad\"));\n\n// Test 3: tuple form for fn\nconst Increment2 = fn(\"0 <= number\", \":\", \"0 <= number\")((n) => n + 1);\n\nconsole.log(\"Function test 2:\");\nconsole.log(Increment2(5));\nconsole.log(Increment2(\"bad\"));\n\n// Test 4: a more complex fn\nconst T = fn(\n  { status: \"'idle'\" },\n  \"or\",\n  { status: \"'loading'\", startedAt: \"0 <= number\" },\n  \":\",\n  { status: \"'loading'\", startedAt: \"0 <= number\" }\n)((s) => s);\n\nconsole.log(\"More complex fn test:\");\nconsole.log(T({ status: \"idle\" }));\nconsole.log(T({ status: \"loading\", startedAt: 1 }));\nconsole.log(T({ status: \"bad\" }));\nEOF\ncd /home/user/myproject && npx --no-install tsx arktest2.ts 2>&1 | head -50\n"]
