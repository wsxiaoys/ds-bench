[?2004l[?2004h> # Build a Godot 4 .tscn file manually.
[?2004l[?2004h> # The structure:
[?2004l[?2004h> # NavWorld (Node2D, script nav_world.gd)
[?2004l[?2004h> #   Region (NavigationRegion2D)
[?2004l[?2004h> #   Agent (CharacterBody2D, script nav_agent.gd)
[?2004l[?2004h> #     NavigationAgent2D
[?2004l[?2004h> #   Obstacles (Node2D)
[?2004l[?2004h> #     Obstacle1 (NavigationObstacle2D, vertices=PackedVector2Array)
[?2004l[?2004h> #     Obstacle2 (NavigationObstacle2D, vertices=PackedVector2Array)
[?2004l[?2004h> #   Goal (Marker2D)
[?2004l[?2004h> 
[?2004l[?2004h> def vec(v):
[?2004l[?2004h>     return "Vector2(%g, %g)" % (v[0], v[1])
[?2004l[?2004h> 
[?2004l[?2004h> def packed_vec_array(arr):
[?2004l[?2004h>     parts = ", ".join("Vector2(%g, %g)" % (x, y) for x, y in arr)
[?2004l[?2004h>     return "PackedVector2Array(" + parts + ")"
[?2004l[?2004h> 
[?2004l[?2004h> # Obstacle1: rectangular outline in local coords. Position at (400, 220)
[?2004l[?2004h> # Obstacle2: rectangular outline at (400, 380)
[?2004l[?2004h> # Together with the agent path going through (80,300)->(720,300),
[?2004l[?2004h> # they should block the straight line.
[?2004l[?2004h> 
