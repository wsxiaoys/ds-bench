[280.850097, "o", "extends CharacterBody2D\r\n\r\nsignal reached\r\n\r\n@export var movement_speed: float = 200.0\r\n@export var arrival_distance: float = 8.0\r\n\r\nvar reached: bool = false\r\n\r\n@onready var nav_agent: NavigationAgent2D = $NavigationAgent2D\r\n\r\nfunc _ready() -> void:\r\n.nav_agent.target_reached.connect(_on_target_reached)\r\n\r\nfunc set_destination(target: Vector2) -> void:\r\n.reached = false\r\n.nav_agent.target_position = target\r\n\r\nfunc _on_target_reached() -> void:\r\n.reached = true\r\n.reached.emit()\r\n\r\nfunc _physics_process(_delta: float) -> void:\r\n.if reached:\r\n.velocity = Vector2.ZERO\r\n.move_and_slide()\r\n.return\r\n.if nav_agent.is_navigation_finished():\r\n.velocity = Vector2.ZERO\r\n.move_and_slide()\r\n.return\r\n.var map_rid: RID = get_world_2d().navigation_map\r\n.if NavigationServer2D.map_get_iteration_id(map_rid) == 0:\r\n.velocity = Vector2.ZERO\r\n.move_and_slide()\r\n.return\r\n.var next_pos: Vector2 = nav_agent.get_next_path_position()\r\n.var dir: Vector2 = next_pos - global_position\r\n.if dir.length() > arrival_distance:\r\n.velocity = dir.normalized() * movement_speed\r\n.else:\r\n.velocity = dir\r\n.move_and_slide()\r\n"]
[280.850287, "o", "\u001b[?2004hroot@5c0d60c3-1f39-40b4-8fa1-2272d6e9ddcc:~# "]
[287.513843, "i", "python3 << 'PYEOF'\nscript = '''extends CharacterBody2D\n\nsignal reached\n\n@export var movement_speed: float = 200.0\n@export var arrival_distance: float = 8.0\n\nvar reached: bool = false\n\n@onready var nav_agent: NavigationAgent2D = $NavigationAgent2D\n\nfunc _ready() -> void:\n\\tnav_agent.target_reached.connect(_on_target_reached)\n\nfunc set_destination(target: Vector2) -> void:\n\\treached = false\n\\tnav_agent.target_position = target\n\nfunc _on_target_reached() -> void:\n\\treached = true\n\\treached.emit()\n\nfunc _physics_process(_delta: float) -> void:\n\\tif reached:\n\\t\\tvelocity = Vector2.ZERO\n\\t\\tmove_and_slide()\n\\t\\treturn\n\\tif nav_agent.is_navigation_finished():\n\\t\\tvelocity = Vector2.ZERO\n\\t\\tmove_and_slide()\n\\t\\treturn\n\\tvar map_rid: RID = get_world_2d().navigation_map\n\\tif NavigationServer2D.map_get_iteration_id(map_rid) == 0:\n\\t\\tvelocity = Vector2.ZERO\n\\t\\tmove_and_slide()\n\\t\\treturn\n\\tvar next_pos: Vector2 = nav_agent.get_next_path_position()\n\\tvar dir: Vector2 = next_pos - global_position\n\\tif dir.length() > arrival_distance:\n\\t\\tvelocity = dir.normalized() * movement_speed\n\\telse:\n\\t\\tvelocity = dir\n\\tmove_and_slide()\n'''\nwith open('/home/user/godot_project/scripts/nav_agent.gd', 'w') as f:\n    f.write(script)\nprint('done')\nPYEOF\n"]
