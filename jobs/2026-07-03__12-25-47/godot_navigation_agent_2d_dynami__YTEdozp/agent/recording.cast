[542.70943, "i", "cat > /tmp/write_world2.py << 'PYEOF'\nscript = '''extends Node2D\n\n@onready var region: NavigationRegion2D = $Region\n@onready var agent: CharacterBody2D = $Agent\n@onready var obstacles: Node2D = $Obstacles\n@onready var goal: Marker2D = $Goal\n\nconst WALKABLE_MIN := Vector2(0, 0)\nconst WALKABLE_MAX := Vector2(800, 600)\n\nfunc _ready() -> void:\n\\trebake_navigation()\n\nfunc rebake_navigation() -> void:\n\\tvar nav_poly := NavigationPolygon.new()\n\\tvar outline := PackedVector2Array([\n\\t\\tWALKABLE_MIN,\n\\t\\tVector2(WALKABLE_MAX.x, WALKABLE_MIN.y),\n\\t\\tWALKABLE_MAX,\n\\t\\tVector2(WALKABLE_MIN.x, WALKABLE_MAX.y),\n\\t])\n\\tnav_poly.add_outline(outline)\n\n\\tvar geom := NavigationMeshSourceGeometryData2D.new()\n\\tgeom.add_traversable_outline(outline)\n\n\\tfor child in obstacles.get_children():\n\\t\\tif child is NavigationObstacle2D and child.vertices.size() >= 3:\n\\t\\t\\tvar world_outline := PackedVector2Array()\n\\t\\t\\tfor v in child.vertices:\n\\t\\t\\t\\tworld_outline.push_back(v + child.global_position)\n\\t\\t\\tgeom.add_obstruction_outline(world_outline)\n\n\\tvar nav_map_rid := region.get_world_2d().navigation_map\n\\tNavigationServer2D.bake_from_source_geometry_data(nav_poly, geom, nav_map_rid)\n\\tregion.navigation_polygon = nav_poly\n\n\\tNavigationServer2D.map_force_update(nav_map_rid)\n\nfunc move_obstacle(name: String, new_position: Vector2) -> void:\n\\tvar node := obstacles.get_node_or_null(name)\n\\tif node == null:\n\\t\\treturn\n\\tnode.global_position = new_position\n\\trebake_navigation()\n\nfunc start_navigation() -> void:\n\\tvar nav_agent: NavigationAgent2D = agent.get_node(\"NavigationAgent2D\")\n\\tnav_agent.target_position = goal.global_position\n\\tagent.set(\"reached\", false)\n\\tagent.set_destination(goal.global_position)\n'''\nwith open('/home/user/godot_project/scripts/nav_world.gd', 'w') as f:\n    f.write(script)\nprint('done')\nPYEOF\npython3 /tmp/write_world2.py\ncat /home/user/godot_project/scripts/nav_world.gd\n"]
