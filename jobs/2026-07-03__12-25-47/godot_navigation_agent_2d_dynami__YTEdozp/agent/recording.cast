[304.653347, "o", "extends Node2D\r\n\r\n@onready var region: NavigationRegion2D = $Region\r\n@onready var agent: CharacterBody2D = $Agent\r\n@onready var obstacles: Node2D = $Obstacles\r\n@onready var goal: Marker2D = $Goal\r\n\r\nconst WALKABLE_MIN := Vector2(0, 0)\r\nconst WALKABLE_MAX := Vector2(800, 600)\r\n\r\nfunc _ready() -> void:\r\n\trebake_navigation()\r\n\r\nfunc rebake_navigation() -> void:\r\n\tvar nav_poly := NavigationPolygon.new()\r\n\tvar outline := PackedVector2Array([\r\n\t\tWALKABLE_MIN,\r\n\t\tVector2(WALKABLE_MAX.x, WALKABLE_MIN.y),\r\n\t\tWALKABLE_MAX,\r\n\t\tVector2(WALKABLE_MIN.x, WALKABLE_MAX.y),\r\n\t])\r\n\tnav_poly.add_outline(outline)\r\n\r\n\tfor child in obstacles.get_children():\r\n\t\tif child is NavigationObstacle2D and child.vertices.size() >= 3:\r\n\t\t\tvar world_outline := PackedVector2Array()\r\n\t\t\tfor v in child.vertices:\r\n\t\t\t\tworld_outline.push_back(v + child.global_position)\r\n\t\t\tnav_poly.add_obstruction_outline(world_outline)\r\n\r\n\tnav_poly.make_polygons_from_outlines()\r\n\tregion.navigation_polygon = nav_poly\r\n\r\n\tvar map_rid: RID = region.get_world_2d().navigation_map\r\n\tNavigationServer2D.map_force_update(map_rid)\r\n\r\nfunc move_obstacle(name: String, new_position: Vector2) -> void:\r\n\tvar node := obstacles.get_node_or_null(name)\r\n\tif node == null:\r\n\t\treturn\r\n\tnode.global_position = new_position\r\n\trebake_navigation()\r\n\r\nfunc start_navigation() -> void:\r\n\tvar nav_agent: NavigationAgent2D = agent.get_node(\"NavigationAgent2D\")\r\n\tnav_agent.target_position = goal.global_position\r\n\tagent.set(\"reached\", false)\r\n\tagent.set_destination(goal.global_position)\r\n"]
[304.653545, "o", "\u001b[?2004hroot@5c0d60c3-1f39-40b4-8fa1-2272d6e9ddcc:~# "]
[318.511654, "i", "cat > /tmp/write_scene.py << 'PYEOF'\nimport json\n\n# Build a Godot 4 .tscn file manually.\n# The structure:\n# NavWorld (Node2D, script nav_world.gd)\n#   Region (NavigationRegion2D)\n#   Agent (CharacterBody2D, script nav_agent.gd)\n#     NavigationAgent2D\n#   Obstacles (Node2D)\n#     Obstacle1 (NavigationObstacle2D, vertices=PackedVector2Array)\n#     Obstacle2 (NavigationObstacle2D, vertices=PackedVector2Array)\n#   Goal (Marker2D)\n\ndef vec(v):\n    return \"Vector2(%g, %g)\" % (v[0], v[1])\n\ndef packed_vec_array(arr):\n    parts = \", \".join(\"Vector2(%g, %g)\" % (x, y) for x, y in arr)\n    return \"PackedVector2Array(\" + parts + \")\"\n\n# Obstacle1: rectangular outline in local coords. Position at (400, 220)\n# Obstacle2: rectangular outline at (400, 380)\n# Together with the agent path going through (80,300)->(720,300),\n# they should block the straight line.\n\n# Use rectangle vertices around (0,0) in local space.\n# Local rectangle: 60x40\nob1_local = [\n    (-30, -20), (30, -20), (30, 20), (-30, 20)\n]\nob2_local = [\n    (-30, -20), (30, -20), (30, 20), (-30, 20)\n]\n\nlines = []\nlines.append('[gd_scene load_steps=4 format=3 uid=\"uid://bnavworlddemo01\"]')\nlines.append('')\nlines.append('[ext_resource type=\"Script\" path=\"res://scripts/nav_world.gd\" id=\"1_world\"]')\nlines.append('[ext_resource type=\"Script\" path=\"res://scripts/nav_agent.gd\" id=\"2_agent\"]')\nlines.append('')\nlines.append('[node name=\"NavWorld\" type=\"Node2D\"]')\nlines.append('script = ExtResource(\"1_world\")')\nlines.append('')\nlines.append('[node name=\"Region\" type=\"NavigationRegion2D\" parent=\".\"]')\nlines.append('')\nlines.append('[node name=\"Agent\" type=\"CharacterBody2D\" parent=\".\"]')\nlines.append('position = Vector2(80, 300)')\nlines.append('script = ExtResource(\"2_agent\")')\nlines.append('')\nlines.append('[node name=\"NavigationAgent2D\" type=\"NavigationAgent2D\" parent=\"Agent\"]')\nlines.append('path_desired_distance = 4.0')\nlines.append('target_desired_distance = 8.0')\nlines.append('')\nlines.append('[node name=\"Obstacles\" type=\"Node2D\" parent=\".\"]')\nlines.append('')\n\n# Obstacle1 at (400, 220) -- above the corridor\nlines.append('[node name=\"Obstacle1\" type=\"NavigationObstacle2D\" parent=\"Obstacles\"]')\nlines.append('position = Vector2(400, 220)')\nlines.append('vertices = ' + packed_vec_array(ob1_local))\nlines.append('affect_navigation_mesh = true')\nlines.append('carve_navigation_mesh = true')\nlines.append('')\n\n# Obstacle2 at (400, 380) -- below the corridor\nlines.append('[node name=\"Obstacle2\" type=\"NavigationObstacle2D\" parent=\"Obstacles\"]')\nlines.append('position = Vector2(400, 380)')\nlines.append('vertices = ' + packed_vec_array(ob2_local))\nlines.append('affect_navigation_mesh = true')\nlines.append('carve_navigation_mesh = true')\nlines.append('')\n\n# Goal at (720, 300)\nlines.append('[node name=\"Goal\" type=\"Marker2D\" parent=\".\"]')\nlines.append('position = Vector2(720, 300)')\n\ncontent = '\\n'.join(lines) + '\\n'\nwith open('/home/user/godot_project/scenes/nav_world.tscn', 'w') as f:\n    f.write(content)\nprint('done')\nPYEOF\npython3 /tmp/write_scene.py\n"]
