[240.466959, "o", "File uploaded: id=b11f1f78-33c4-46bc-a54c-0d4201c113fc\r\n"]
[240.580995, "o", "Status code: 200\r\nHeaders: {'date': 'Fri, 03 Jul 2026 14:50:39 GMT', 'content-type': 'application/json', 'content-length': '920', 'connection': 'keep-alive', 'server': 'uvicorn', 'x-correlation-id': 'ffae4a09-600e-4120-8a50-357c72cc2a9e', 'x-session-id': 'b6531e85-dff4-4066-8c11-1623ced17a9c'}\r\nTraceback (most recent call last):\r\n"]
[240.581038, "o", "  File \"/home/user/llamacloud-task/test_extract3.py\", line 43, in <module>\r\n"]
[240.581122, "o", "    print(f\"Body: {job.content.decode()}\")\r\n                   ^^^^^^^^^^^\r\n"]
[240.581146, "o", "AttributeError: 'APIResponse' object has no attribute 'content'\r\n"]
[240.623779, "o", "\u001b[?2004hroot@604f2903-8062-433e-ba00-0e800c51381c:/home/user/llamacloud-task# "]
[304.889662, "i", "cat > test_extract3.py << 'EOF'\nimport os\nimport sys\nimport json\nimport time\n\nfrom llama_cloud import LlamaCloud\n\n# Read run-id\nwith open('/logs/artifacts/run-id', 'r') as f:\n    run_id = f.read().strip()\n\nclient = LlamaCloud()\n\n# Upload file\nexternal_file_id = f\"invoice-{run_id}-v4.txt\"\nwith open('/home/user/llamacloud-task/sample_invoice.txt', 'rb') as f:\n    file_resp = client.files.create(file=f, purpose=\"extract\", external_file_id=external_file_id)\nprint(f\"File uploaded: id={file_resp.id}\")\n\n# Run extraction with raw response\ndata_schema = {\n    \"type\": \"object\",\n    \"properties\": {\n        \"company_name\": {\"type\": \"string\"},\n        \"invoice_number\": {\"type\": \"string\"},\n        \"total_amount\": {\"type\": \"number\"},\n    },\n    \"required\": [\"company_name\", \"invoice_number\", \"total_amount\"],\n}\n\nconfiguration = {\n    \"extraction_target\": \"per_doc\",\n    \"tier\": \"agentic\",\n    \"cite_sources\": True,\n    \"data_schema\": data_schema,\n}\n\nresp = client.extract.create(file_input=file_resp.id, configuration=configuration)\nprint(f\"Job ID: {resp.id}\")\n\n# Poll\nfor i in range(30):\n    job = client.extract.get(resp.id)\n    print(f\"[{i}] Status: {job.status}\")\n    if job.status in (\"COMPLETED\", \"FAILED\", \"CANCELLED\"):\n        # Wait a bit more for metadata\n        time.sleep(3)\n        job = client.extract.get(resp.id)\n        break\n    time.sleep(2)\n\nprint()\nprint(\"--- Job model dump ---\")\nprint(json.dumps(job.model_dump(mode='json'), indent=2, default=str))\n\n# Also check raw HTTP response\nprint()\nprint(\"--- Raw HTTP response ---\")\nimport httpx\nheaders, raw_body = client.get(f'/extract/{resp.id}')\nprint(raw_body.decode())\nEOF\npython3 test_extract3.py\n"]
