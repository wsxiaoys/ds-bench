[587.39437, "o", "    external_file_id = f\"invoice-{run_id}.txt\"\r\n\u001b[?2004l\r"]
[587.394496, "o", "\u001b[?2004h> "]
[587.394738, "o", "    with INVOICE_PATH.open(\"rb\") as fh:\r\n\u001b[?2004l\r"]
[587.394791, "o", "\u001b[?2004h> "]
[587.395112, "o", "        uploaded = client.files.create(\r\n\u001b[?2004l\r"]
[587.395167, "o", "\u001b[?2004h> "]
[587.395341, "o", "            file=fh,\r\n\u001b[?2004l\r"]
[587.395406, "o", "\u001b[?2004h> "]
[587.395655, "o", "            purpose=\"extract\",\r\n\u001b[?2004l\r"]
[587.395711, "o", "\u001b[?2004h> "]
[587.396073, "o", "            external_file_id=external_file_id,\r\n\u001b[?2004l\r"]
[587.396129, "o", "\u001b[?2004h> "]
[587.396231, "o", "        )\r\n\u001b[?2004l\r"]
[587.396282, "o", "\u001b[?2004h> "]
[587.396498, "o", "    file_id = uploaded.id\r\n\u001b[?2004l\r"]
[587.39655, "o", "\u001b[?2004h> "]
[587.397288, "o", "    print(f\"[extract_invoice] Uploaded file id={file_id} external_file_id={external_file_id}\")\r\n\u001b[?2004l\r"]
[587.397339, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[587.397443, "o", "\u001b[?2004h> "]
[587.39765, "o", "    # 2. Define the schema.\r\n\u001b[?2004l\r"]
[587.397702, "o", "\u001b[?2004h> "]
[587.397888, "o", "    data_schema = {\r\n\u001b[?2004l\r"]
[587.397976, "o", "\u001b[?2004h> "]
[587.398201, "o", "        \"type\": \"object\",\r\n\u001b[?2004l\r"]
[587.398311, "o", "\u001b[?2004h> "]
[587.398564, "o", "        \"properties\": {\r\n\u001b[?2004l\r"]
[587.398693, "o", "\u001b[?2004h> "]
[587.398976, "o", "            \"company_name\": {\"type\": \"string\"},\r\n\u001b[?2004l\r"]
[587.399061, "o", "\u001b[?2004h> "]
[587.399499, "o", "            \"invoice_number\": {\"type\": \"string\"},\r\n\u001b[?2004l\r\u001b[?2004h> "]
[587.399896, "o", "            \"total_amount\": {\"type\": \"number\"},\r\n\u001b[?2004l\r\u001b[?2004h"]
[587.399998, "o", "> "]
[587.400079, "o", "        },\r\n\u001b[?2004l\r\u001b[?2004h> "]
[587.400645, "o", "        \"required\": [\"company_name\", \"invoice_number\", \"total_amount\"],\r\n\u001b[?2004l\r"]
[587.4007, "o", "\u001b[?2004h> "]
[587.400753, "o", "    }\r\n\u001b[?2004l\r"]
[587.400807, "o", "\u001b[?2004h> "]
[587.400955, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[587.401071, "o", "    configuration = {\r\n\u001b[?2004l\r"]
[587.401123, "o", "\u001b[?2004h"]
[587.401174, "o", "> "]
[587.401466, "o", "        \"extraction_target\": \"per_doc\",\r\n\u001b[?2004l\r"]
[587.401517, "o", "\u001b[?2004h> "]
[587.401742, "o", "        \"tier\": \"agentic\",\r\n\u001b[?2004l\r"]
[587.401835, "o", "\u001b[?2004h> "]
[587.402068, "o", "        \"cite_sources\": True,\r\n\u001b[?2004l\r"]
[587.402165, "o", "\u001b[?2004h> "]
[587.402458, "o", "        \"data_schema\": data_schema,\r\n\u001b[?2004l\r"]
[587.402516, "o", "\u001b[?2004h> "]
[587.402662, "o", "    }\r\n\u001b[?2004l\r\u001b[?2004h"]
[587.402778, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[587.40305, "o", "    # 3. Create the extraction job.\r\n\u001b[?2004l\r"]
[587.403147, "o", "\u001b[?2004h> "]
[587.4034, "o", "    job = client.extract.create(\r\n\u001b[?2004l\r"]
[587.4035, "o", "\u001b[?2004h> "]
[587.4037, "o", "        file_input=file_id,\r\n\u001b[?2004l\r"]
[587.403752, "o", "\u001b[?2004h> "]
[587.404071, "o", "        configuration=configuration,\r\n\u001b[?2004l\r"]
[587.404125, "o", "\u001b[?2004h> "]
[587.404244, "o", "    )\r\n\u001b[?2004l\r\u001b[?2004h"]
[587.404344, "o", "> "]
[587.404475, "o", "    job_id = job.id\r\n\u001b[?2004l\r"]
[587.404569, "o", "\u001b[?2004h> "]
[587.405044, "o", "    print(f\"[extract_invoice] Created extract job id={job_id}\")\r\n\u001b[?2004l\r"]
[587.40514, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[587.405233, "o", "\u001b[?2004h> "]
[587.405451, "o", "    # 4. Poll until terminal.\r\n\u001b[?2004l\r"]
[587.405539, "o", "\u001b[?2004h> "]
[587.40569, "o", "    final_status = None\r\n\u001b[?2004l\r"]
[587.405771, "o", "\u001b[?2004h> "]
[587.405983, "o", "    for attempt in range(MAX_POLLS):\r\n\u001b[?2004l\r"]
[587.406065, "o", "\u001b[?2004h> "]
[587.406327, "o", "        current = client.extract.get(job_id)\r\n\u001b[?2004l\r"]
[587.406422, "o", "\u001b[?2004h> "]
[587.40664, "o", "        final_status = current.status\r\n\u001b[?2004l\r"]
[587.406727, "o", "\u001b[?2004h> "]
[587.407154, "o", "        print(f\"[extract_invoice] poll {attempt}: status={final_status}\")\r\n\u001b[?2004l\r"]
[587.40724, "o", "\u001b[?2004h> "]
[587.407514, "o", "        if final_status in TERMINAL_STATUSES:\r\n\u001b[?2004l\r"]
[587.407631, "o", "\u001b[?2004h> "]
[587.407732, "o", "            break\r\n\u001b[?2004l\r\u001b[?2004h"]
[587.407818, "o", "> "]
[587.408036, "o", "        time.sleep(POLL_INTERVAL_SECONDS)\r\n\u001b[?2004l\r"]
[587.408118, "o", "\u001b[?2004h> "]
[587.408199, "o", "    else:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[587.408319, "o", "        print(\r\n\u001b[?2004l\r"]
[587.408424, "o", "\u001b[?2004h> "]
[587.408908, "o", "            f\"[extract_invoice] ERROR: job {job_id} did not reach a terminal status \"\r\n\u001b[?2004l\r"]
[587.40896, "o", "\u001b[?2004h> "]
[587.409532, "o", "            f\"within {MAX_POLLS * POLL_INTERVAL_SECONDS:.0f}s (last status={final_status})\",\r\n\u001b[?2004l\r"]
[587.409584, "o", "\u001b[?2004h> "]
[587.409779, "o", "            file=sys.stderr,\r\n\u001b[?2004l\r"]
[587.409832, "o", "\u001b[?2004h> "]
[587.409972, "o", "        )\r\n\u001b[?2004l\r\u001b[?2004h> "]
[587.410076, "o", "        return 1\r\n\u001b[?2004l\r"]
[587.41013, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[587.410181, "o", "\u001b[?2004h> "]
[587.410428, "o", "    if final_status == \"FAILED\":\r\n\u001b[?2004l\r"]
[587.410481, "o", "\u001b[?2004h> "]
[587.410774, "o", "        detail = client.extract.get(job_id)\r\n\u001b[?2004l\r\u001b[?2004h"]
[587.410865, "o", "> "]
[587.410952, "o", "        print(\r\n\u001b[?2004l\r\u001b[?2004h"]
[587.411035, "o", "> "]
[587.411446, "o", "            f\"[extract_invoice] ERROR: extract job {job_id} FAILED: \"\r\n\u001b[?2004l\r\u001b[?2004h"]
[587.411525, "o", "> "]
[587.411836, "o", "            f\"{getattr(detail, 'error_message', None)}\",\r\n\u001b[?2004l\r"]
[587.411886, "o", "\u001b[?2004h> "]
[587.412085, "o", "            file=sys.stderr,\r\n\u001b[?2004l\r"]
[587.412135, "o", "\u001b[?2004h> "]
[587.412212, "o", "        )\r\n\u001b[?2004l\r"]
[587.412305, "o", "\u001b[?2004h> "]
[587.412399, "o", "        return 1\r\n\u001b[?2004l\r"]
[587.41245, "o", "\u001b[?2004h> "]
[587.412695, "o", "    if final_status == \"CANCELLED\":\r\n\u001b[?2004l\r"]
[587.412746, "o", "\u001b[?2004h> "]
[587.412861, "o", "        print(\r\n\u001b[?2004l\r"]
[587.412911, "o", "\u001b[?2004h> "]
[587.413422, "o", "            f\"[extract_invoice] ERROR: extract job {job_id} was CANCELLED\",\r\n\u001b[?2004l\r\u001b[?2004h"]
[587.413508, "o", "> "]
[587.413647, "o", "            file=sys.stderr,\r\n\u001b[?2004l\r"]
[587.413734, "o", "\u001b[?2004h> "]
[587.41382, "o", "        )\r\n\u001b[?2004l\r\u001b[?2004h> "]
[587.413943, "o", "        return 1\r\n\u001b[?2004l\r"]
[587.414029, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[587.414113, "o", "> "]
[587.414502, "o", "    # 5. Re-fetch with metadata expanded so citations are populated.\r\n\u001b[?2004l\r"]
[587.414601, "o", "\u001b[?2004h> "]
[587.414998, "o", "    full_job = client.extract.get(job_id, expand=[\"extract_metadata\"])\r\n\u001b[?2004l\r"]
[587.415085, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[587.415173, "o", "> "]
[587.415501, "o", "    extract_result = _dump(full_job.extract_result) or {}\r\n\u001b[?2004l\r"]
[587.415602, "o", "\u001b[?2004h> "]
[587.415952, "o", "    extract_metadata_obj = _dump(full_job.extract_metadata) or {}\r\n\u001b[?2004l\r"]
[587.416028, "o", "\u001b[?2004h> "]
[587.416505, "o", "    raw_field_metadata = extract_metadata_obj.get(\"field_metadata\") or {}\r\n\u001b[?2004l\r"]
[587.416594, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[587.41712, "o", "    # The API returns per-field entries under field_metadata.document_metadata.\r\n\u001b[?2004l\r"]
[587.417208, "o", "\u001b[?2004h> "]
[587.417729, "o", "    # Restructure so each leaf field has its own entry directly under field_metadata,\r\n\u001b[?2004l\r\u001b[?2004h"]
[587.417835, "o", "> "]
[587.417972, "o", "    # as required by the task.\r\n\u001b[?2004l\r"]
[587.418084, "o", "\u001b[?2004h> "]
[587.418478, "o", "    document_metadata = raw_field_metadata.get(\"document_metadata\") or {}\r\n\u001b[?2004l\r\u001b[?2004h"]
[587.418577, "o", "> "]
[587.418725, "o", "    restructured_field_metadata = {\r\n\u001b[?2004l\r\u001b[?2004h"]
[587.41882, "o", "> "]
[587.419005, "o", "        field: document_metadata[field]\r\n\u001b[?2004l\r"]
[587.419067, "o", "\u001b[?2004h> "]
[587.419465, "o", "        for field in (\"company_name\", \"invoice_number\", \"total_amount\")\r\n\u001b[?2004l\r"]
[587.419525, "o", "\u001b[?2004h> "]
[587.41973, "o", "        if field in document_metadata\r\n\u001b[?2004l\r"]
[587.419788, "o", "\u001b[?2004h> "]
[587.419893, "o", "    }\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[587.419951, "o", "\u001b[?2004h> "]
[587.42006, "o", "    artifact = {\r\n\u001b[?2004l\r"]
[587.420117, "o", "\u001b[?2004h> "]
[587.420224, "o", "        \"data\": {\r\n\u001b[?2004l\r"]
[587.420283, "o", "\u001b[?2004h> "]
[587.420655, "o", "            \"company_name\": extract_result.get(\"company_name\"),\r\n\u001b[?2004l\r"]
[587.420713, "o", "\u001b[?2004h> "]
[587.421117, "o", "            \"invoice_number\": extract_result.get(\"invoice_number\"),\r\n\u001b[?2004l\r\u001b[?2004h"]
[587.421213, "o", "> "]
[587.421545, "o", "            \"total_amount\": extract_result.get(\"total_amount\"),\r\n\u001b[?2004l\r\u001b[?2004h"]
[587.421642, "o", ">         },\r\n\u001b[?2004l\r"]
[587.421736, "o", "\u001b[?2004h> "]
[587.421904, "o", "        \"extract_metadata\": {\r\n\u001b[?2004l\r\u001b[?2004h"]
[587.421999, "o", "> "]
[587.422288, "o", "            \"field_metadata\": restructured_field_metadata,\r\n\u001b[?2004l\r\u001b[?2004h"]
[587.42248, "o", ">         },\r\n\u001b[?2004l\r"]
[587.422606, "o", "\u001b[?2004h>     }\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[587.422989, "o", "    RESULT_PATH.write_text(json.dumps(artifact, indent=2) + \"\\n\")\r\n\u001b[?2004l\r"]
[587.423105, "o", "\u001b[?2004h> "]
[587.423338, "o", "    print(f\"[extract_invoice] Wrote {RESULT_PATH}\")\r\n\u001b[?2004l\r"]
[587.471783, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h>     _write_output_log(job_id)\r\n\u001b[?2004l\r\u001b[?2004h>     print(f\"[extract_invoice] Wrote {OUTPUT_LOG_PATH}\")\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h>     return 0\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> if __name__ == \"__main__\":\r\n\u001b[?2004l\r\u001b[?2004h>     raise SystemExit(main())\r\n\u001b[?2004l\r\u001b[?2004h> PYEOF\r\n\u001b[?2004l\r"]
