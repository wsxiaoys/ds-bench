[156.038069, "i", "cat > test_extract2.py << 'EOF'\nimport os\nimport sys\nimport json\nimport time\n\nsys.path.insert(0, '/usr/local/lib/python3.12/dist-packages')\nfrom llama_cloud import LlamaCloud\n\n# Read run-id\nwith open('/logs/artifacts/run-id', 'r') as f:\n    run_id = f.read().strip()\n\nclient = LlamaCloud()\n\n# Upload file\nexternal_file_id = f\"invoice-{run_id}-v2.txt\"\nwith open('/home/user/llamacloud-task/sample_invoice.txt', 'rb') as f:\n    file_resp = client.files.create(file=f, purpose=\"extract\", external_file_id=external_file_id)\nprint(f\"File uploaded: id={file_resp.id}\")\n\n# Run extraction with version\ndata_schema = {\n    \"type\": \"object\",\n    \"properties\": {\n        \"company_name\": {\"type\": \"string\"},\n        \"invoice_number\": {\"type\": \"string\"},\n        \"total_amount\": {\"type\": \"number\"},\n    },\n    \"required\": [\"company_name\", \"invoice_number\", \"total_amount\"],\n}\n\nconfiguration = {\n    \"extraction_target\": \"per_doc\",\n    \"tier\": \"agentic\",\n    \"cite_sources\": True,\n    \"data_schema\": data_schema,\n    \"version\": \"v2\",\n}\n\njob = client.extract.create(file_input=file_resp.id, configuration=configuration)\nprint(f\"Job created: {job.id}\")\n\n# Poll with longer wait\nfor i in range(30):\n    job = client.extract.get(job.id)\n    print(f\"[{i}] Status: {job.status}\")\n    if job.status in (\"COMPLETED\", \"FAILED\", \"CANCELLED\"):\n        # Wait a bit more for metadata\n        time.sleep(2)\n        job = client.extract.get(job.id)\n        break\n    time.sleep(2)\n\nprint()\nprint(\"--- Job model dump ---\")\nprint(json.dumps(job.model_dump(mode='json'), indent=2, default=str))\nEOF\npython3 test_extract2.py\n"]
