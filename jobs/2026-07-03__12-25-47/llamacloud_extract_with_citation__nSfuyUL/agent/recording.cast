[592.996793, "o", "    uploaded = client.files.create(\r\n               ^^^^^^^^^^^^^^^^^^^^\r\n  File \"/usr/local/lib/python3.12/dist-packages/llama_cloud/resources/files.py\", line 106, in create\r\n    return self._post(\r\n           ^^^^^^^^^^^\r\n"]
