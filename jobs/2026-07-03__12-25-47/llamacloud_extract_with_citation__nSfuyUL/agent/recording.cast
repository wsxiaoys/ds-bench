[592.997166, "o", "llama_cloud.BadRequestError: Error code: 400 - {'detail': 'Failed to upload file: (sqlalchemy.dialects.postgresql.asyncpg.IntegrityError) <class \\'asyncpg.exceptions.UniqueViolationError\\'>: duplicate key value violates unique constraint \"project_ds_external_id_uc\"\\nDETAIL:  Key (project_id, data_source_id, external_file_id)=(b420cea9-2ed0-451d-8ebc-617151ec45f6, null, invoice-zrguzpi4ht.txt) already exists.\\n[SQL: INSERT INTO file (name, file_size, last_modified_at, resource_info, permission_info, storage_metadata, expires_at, external_file_id, data_source_id, id, project_id) VALUES ($1::VARCHAR, $2::INTEGER, $3::TIMESTAMP WITHOUT TIME ZONE, $4::JSONB, $5::JSONB, $6::JSONB, $7::TIMESTAMP WITH TIME ZONE, $8::VARCHAR, $9::UUID, uuid_generate_v4(), $10::UUID) RETURNING file.id, file.created_at, file.updated_at]\\n[parameters: (\\'sample_invoice.txt\\', 989, None, \\'null\\', \\'null\\', \\'{\"purpose\": \"extract\"}\\', datetime.datetime(2026, 7, 5, 14, 56, 32, 153245, tzinfo=datetime.timezone.utc), \\'invoice-zrguzpi4ht.txt\\', None, UUID(\\'b420cea9-2ed0-451d-8ebc-617151ec45f6\\'))]\\n(Background on this error at: https://sqlalche.me/e/20/gkpj)'}\r\n"]
