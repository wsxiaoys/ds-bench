[517.577864, "o", "{\r\n  \"id\": \"ext-ylashte4edvk69s1j4i9s1sldee8\",\r\n  \"created_at\": \"2026-07-03T14:55:14.561068Z\",\r\n  \"file_input\": \"6db8ea24-2941-4486-9166-0e00408b3cab\",\r\n  \"project_id\": \"b420cea9-2ed0-451d-8ebc-617151ec45f6\",\r\n  \"status\": \"COMPLETED\",\r\n  \"updated_at\": \"2026-07-03T14:55:15.476255Z\",\r\n  \"configuration\": null,\r\n  \"configuration_id\": null,\r\n  \"error_message\": null,\r\n  \"extract_metadata\": {\r\n    \"field_metadata\": {\r\n      \"document_metadata\": {\r\n        \"company_name\": {\r\n          \"citation\": [\r\n            {\r\n              \"page\": 1,\r\n              \"matching_text\": \"Vendor: Acme Robotics, Inc.\"\r\n            }\r\n          ]\r\n        },\r\n        \"invoice_number\": {\r\n          \"citation\": [\r\n            {\r\n              \"page\": 1,\r\n              \"matching_text\": \"Invoice Number: INV-2024-9876\"\r\n            }\r\n          ]\r\n        },\r\n        \"total_amount\": {\r\n          \"citation\": [\r\n            {\r\n              \"page\": 1,\r\n              \"matching_text\": \"Subtotal                          1499.99\"\r\n            }\r\n          ]\r\n        }"]
