[239.073441, "o", "\u001b[?2004h> "]
[239.073532, "o", "    \"cite_sources\": True,\r\n\u001b[?2004l\r\u001b[?2004h"]
[239.073583, "o", "> "]
[239.073663, "o", "    \"data_schema\": data_schema,\r\n\u001b[?2004l\r"]
[239.073696, "o", "\u001b[?2004h> }\r\n\u001b[?2004l\r"]
[239.073729, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[239.073761, "o", "\u001b[?2004h> "]
[239.073914, "o", "# Use raw response to see what API returns\r\n\u001b[?2004l\r\u001b[?2004h"]
[239.073992, "o", "> "]
