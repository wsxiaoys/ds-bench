[239.075461, "o", "\u001b[?2004h> "]
[239.07557, "o", "    body = job_raw.content.decode()\r\n\u001b[?2004l\r"]
[239.075605, "o", "\u001b[?2004h> "]
[239.075729, "o", "    print(f\"[{i}] Body: {body[:500]}\")\r\n\u001b[?2004l\r"]
[239.075763, "o", "\u001b[?2004h> "]
[239.075993, "o", "    if '\"COMPLETED\"' in body or '\"FAILED\"' in body or '\"CANCELLED\"' in body:\r\n\u001b[?2004l\r"]
[239.076027, "o", "\u001b[?2004h> "]
[239.076095, "o", "        time.sleep(2)\r\n\u001b[?2004l\r"]
[239.076128, "o", "\u001b[?2004h> "]
[239.07628, "o", "        job_raw = raw_client.extract.get(resp.id)\r\n\u001b[?2004l\r"]
[239.076314, "o", "\u001b[?2004h> "]
[239.076446, "o", "        body = job_raw.content.decode()\r\n\u001b[?2004l\r"]
[239.076472, "o", "\u001b[?2004h> "]
[239.076602, "o", "        print(f\"[final] Body: {body}\")\r\n\u001b[?2004l\r"]
[239.076636, "o", "\u001b[?2004h> "]
[239.076679, "o", "        break\r\n\u001b[?2004l\r"]
[239.076713, "o", "\u001b[?2004h> "]
[239.076769, "o", "    time.sleep(2)\r\n\u001b[?2004l\r"]
[239.076802, "o", "\u001b[?2004h> "]
[239.076835, "o", "EOF\r\n\u001b[?2004l\r"]
