[239.074092, "o", "\u001b[?2004h> "]
[239.074341, "o", "job = raw_client.extract.create(file_input=file_resp.id, configuration=configuration)\r\n\u001b[?2004l\r"]
[239.074388, "o", "\u001b[?2004h> "]
[239.07451, "o", "print(f\"Status code: {job.status_code}\")\r\n\u001b[?2004l\r"]
[239.074543, "o", "\u001b[?2004h> "]
