[440.026715, "i", "cat > test_raw.py << 'EOF'\nimport os\nimport sys\nimport json\nimport time\nimport httpx\n\nfrom llama_cloud import LlamaCloud\n\nwith open('/logs/artifacts/run-id', 'r') as f:\n    run_id = f.read().strip()\n\nclient = LlamaCloud()\n\nexternal_file_id = f\"invoice-{run_id}-v6.txt\"\nwith open('/home/user/llamacloud-task/sample_invoice.txt', 'rb') as f:\n    file_resp = client.files.create(file=f, purpose=\"extract\", external_file_id=external_file_id)\n\ndata_schema = {\n    \"type\": \"object\",\n    \"properties\": {\n        \"company_name\": {\"type\": \"string\"},\n        \"invoice_number\": {\"type\": \"string\"},\n        \"total_amount\": {\"type\": \"number\"},\n    },\n    \"required\": [\"company_name\", \"invoice_number\", \"total_amount\"],\n}\n\nconfiguration = {\n    \"extraction_target\": \"per_doc\",\n    \"tier\": \"agentic\",\n    \"cite_sources\": True,\n    \"data_schema\": data_schema,\n}\n\nresp = client.extract.create(file_input=file_resp.id, configuration=configuration)\nprint(f\"Job ID: {resp.id}\")\n\n# Poll\nfor i in range(30):\n    job = client.extract.get(resp.id)\n    print(f\"[{i}] Status: {job.status}\")\n    if job.status in (\"COMPLETED\", \"FAILED\", \"CANCELLED\"):\n        time.sleep(2)\n        break\n    time.sleep(2)\n\n# Query the raw HTTP response\nbase = str(client.base_url).rstrip(\"/\")\nurl = f'{base}/extract/{resp.id}'\nprint(f\"\\nURL: {url}\")\nwith httpx.Client() as hclient:\n    r = hclient.get(url, headers=dict(client.auth_headers))\n    print(f\"Status: {r.status_code}\")\n    print(f\"Body:\\n{r.text}\")\nEOF\npython3 test_raw.py\n"]
