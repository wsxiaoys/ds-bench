[239.069402, "i", "cat > test_extract3.py << 'EOF'\nimport os\nimport sys\nimport json\nimport time\n\nfrom llama_cloud import LlamaCloud\n\n# Read run-id\nwith open('/logs/artifacts/run-id', 'r') as f:\n    run_id = f.read().strip()\n\nclient = LlamaCloud()\n\n# Upload file\nexternal_file_id = f\"invoice-{run_id}-v3.txt\"\nwith open('/home/user/llamacloud-task/sample_invoice.txt', 'rb') as f:\n    file_resp = client.files.create(file=f, purpose=\"extract\", external_file_id=external_file_id)\nprint(f\"File uploaded: id={file_resp.id}\")\n\n# Run extraction with raw response\ndata_schema = {\n    \"type\": \"object\",\n    \"properties\": {\n        \"company_name\": {\"type\": \"string\"},\n        \"invoice_number\": {\"type\": \"string\"},\n        \"total_amount\": {\"type\": \"number\"},\n    },\n    \"required\": [\"company_name\", \"invoice_number\", \"total_amount\"],\n}\n\nconfiguration = {\n    \"extraction_target\": \"per_doc\",\n    \"tier\": \"agentic\",\n    \"cite_sources\": True,\n    \"data_schema\": data_schema,\n}\n\n# Use raw response to see what API returns\nraw_client = client.with_raw_response\njob = raw_client.extract.create(file_input=file_resp.id, configuration=configuration)\nprint(f\"Status code: {job.status_code}\")\nprint(f\"Headers: {dict(job.headers)}\")\nprint(f\"Body: {job.content.decode()}\")\n\nresp = job.parse()\nprint(f\"Job ID: {resp.id}\")\n\n# Poll\nfor i in range(30):\n    job_raw = raw_client.extract.get(resp.id)\n    body = job_raw.content.decode()\n    print(f\"[{i}] Body: {body[:500]}\")\n    if '\"COMPLETED\"' in body or '\"FAILED\"' in body or '\"CANCELLED\"' in body:\n        time.sleep(2)\n        job_raw = raw_client.extract.get(resp.id)\n        body = job_raw.content.decode()\n        print(f\"[final] Body: {body}\")\n        break\n    time.sleep(2)\nEOF\npython3 test_extract3.py\n"]
