[239.074872, "o", "\u001b[?2004h> "]
[239.074948, "o", "resp = job.parse()\r\n\u001b[?2004l\r"]
[239.074982, "o", "\u001b[?2004h> "]
[239.075065, "o", "print(f\"Job ID: {resp.id}\")\r\n\u001b[?2004l\r"]
[239.075091, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[239.075115, "o", "\u001b[?2004h"]
[239.07514, "o", "> # Poll\r\n"]
[239.075206, "o", "\u001b[?2004l\r\u001b[?2004h"]
[239.075243, "o", "> for i in range(30):\r\n\u001b[?2004l\r"]
[239.075278, "o", "\u001b[?2004h> "]
