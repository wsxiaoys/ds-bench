[?2004l[?2004h> 
[?2004l[?2004h> def _dump(value):
[?2004l[?2004h>     """Serialize Pydantic models, dicts, lists, and primitives for JSON output."""
[?2004l[?2004h>     if hasattr(value, "model_dump"):
[?2004l[?2004h>         return value.model_dump(mode="json")
[?2004l[?2004h>     if isinstance(value, dict):
[?2004l[?2004h>         return {k: _dump(v) for k, v in value.items()}
[?2004l[?2004h>     if isinstance(value, list):
[?2004l[?2004h>         return [_dump(v) for v in value]
[?2004l[?2004h>     return value
[?2004l[?2004h> 
[?2004l[?2004h> 
[?2004l[?2004h> def main() -> int:
