[?2004hroot@7d1bb788-98dc-4be8-ae6c-9328c582230c:/home/user/myproject# cat > /home/user/myproject/solution.py << 'PYEOF'
[?2004l[?2004h> """LoggedSearcher: LanceDB query logger.
[?2004l[?2004h> 
[?2004l[?2004h> Wraps a LanceDB articles table's `search` method and persists an audit row
[?2004l[?2004h> to a configurable `query_logs` LanceDB table for every retrieval.
[?2004l[?2004h> """
[?2004l[?2004h> 
[?2004l[?2004h> from __future__ import annotations
[?2004l[?2004h> 
[?2004l[?2004h> import datetime
[?2004l[?2004h> import time
[?2004l[?2004h> from typing import Any, List, Sequence
[?2004l[?2004h> 
[?2004l[?2004h> import lancedb
[?2004l[?2004h> import pyarrow as pa
[?2004l[?2004h> 
[?2004l[?2004h> 
[?2004l[?2004h> # Logical schema for the audit/log table.
[?2004l[?2004h> # - query_id   : string  -- caller-supplied identifier for the query
[?2004l[?2004h> # - user_id    : string  -- caller-supplied identifier of the issuing user
[?2004l[?2004h> # - query_text : string  -- optional free-form text describing the query
[?2004l[?2004h> # - ts         : timestamp64 (microseconds, UTC) -- logged at write time
[?2004l[?2004h> # - latency_ms : float64 -- wall-clock latency in milliseconds, strictly > 0
[?2004l[?2004h> # - hit_count  : int64   -- number of returned hits
[?2004l[?2004h> # - top_ids    : list<int64> -- returned ids in rank order
[?2004l[?2004h> _QUERY_LOGS_SCHEMA = pa.schema(
[?2004l[?2004h>     [
[?2004l[?2004h>         pa.field("query_id", pa.string(), nullable=False),
[?2004l[?2004h>         pa.field("user_id", pa.string(), nullable=False),
[?2004l[?2004h>         pa.field("query_text", pa.string(), nullable=True),
[?2004l[?2004h>         pa.field("ts", pa.timestamp("us", tz="UTC"), nullable=False),
[?2004l[?2004h>         pa.field("latency_ms", pa.float64(), nullable=False),
[?2004l[?2004h>         pa.field("hit_count", pa.int64(), nullable=False),
[?2004l[?2004h>         pa.field("top_ids", pa.list_(pa.int64()), nullable=False),
[?2004l[?2004h>     ]
[?2004l[?2004h> )
[?2004l[?2004h> 
[?2004l[?2004h> 
[?2004l[?2004h> def _coerce_int_ids(values: Sequence[Any]) -> List[int]:
[?2004l[?2004h>     """Convert each value in `values` to a plain Python int."""
[?2004l[?2004h>     return [int(v) for v in values]
[?2004l[?2004h> 
[?2004l[?2004h> 
[?2004l[?2004h> class LoggedSearcher:
[?2004l[?2004h>     """Wrap a LanceDB vector table and log every search to an audit table.
[?2004l[?2004h> 
[?2004l[?2004h>     Parameters
[?2004l[?2004h>     ----------
[?2004l[?2004h>     db_uri : str
[?2004l[?2004h>         Filesystem path to the LanceDB database directory.
[?2004l[?2004h>     articles_table : str
[?2004l[?2004h>         Name of the table containing precomputed 64-d vectors to search.
[?2004l[?2004h>     logs_table : str
[?2004l[?2004h>         Name of the table where audit rows are persisted. Created lazily.
[?2004l[?2004h>     """
[?2004l[?2004h> 
[?2004l[?2004h>     def __init__(self, db_uri: str, articles_table: str, logs_table: str) -> None:
[?2004l[?2004h>         self._db_uri = db_uri
[?2004l[?2004h>         self._articles_table_name = articles_table
[?2004l[?2004h>         self._logs_table_name = logs_table
[?2004l[?2004h> 
[?2004l[?2004h>         self._db = lancedb.connect(db_uri)
[?2004l[?2004h>         self._articles = self._db.open_table(articles_table)
[?2004l[?2004h> 
[?2004l[?2004h>         # Make sure the logs table exists with the correct schema.
[?2004l[?2004h>         if self._logs_table_name not in self._db.table_names():
[?2004l[?2004h>             self._logs = self._db.create_table(
[?2004l[?2004h>                 self._logs_table_name, schema=_QUERY_LOGS_SCHEMA
[?2004l[?2004h>             )
[?2004l[?2004h>         else:
[?2004l[?2004h>             self._logs = self._db.open_table(self._logs_table_name)
[?2004l[?2004h> 
[?2004l[?2004h>     # ------------------------------------------------------------------ #
[?2004l[?2004h>     # Public API                                                          #
[?2004l[?2004h>     # ------------------------------------------------------------------ #
[?2004l[?2004h>     def search(
[?2004l[?2004h>         self,
[?2004l[?2004h>         query_vector: Sequence[float],
[?2004l[?2004h>         top_k: int,
[?2004l[?2004h>         query_id: str,
[?2004l[?2004h>         user_id: str,
[?2004l[?2004h>         query_text: str = "",
[?2004l[?2004h>     ) -> List[dict]:
[?2004l[?2004h>         """Search `articles_table` and write one audit row to `logs_table`.
[?2004l[?2004h> 
[?2004l[?2004h>         Returns the list of hits in the same shape as
[?2004l[?2004h>         ``table.search(query_vector).limit(top_k).to_list()``.
[?2004l[?2004h>         """
[?2004l[?2004h>         # -- 1. Run the vector search and time it. ------------------------ #
[?2004l[?2004h>         start = time.perf_counter()
[?2004l[?2004h>         hits: List[dict] = (
[?2004l[?2004h>             self._articles.search(query_vector).limit(top_k).to_list()
[?2004l[?2004h>         )
[?2004l[?2004h>         elapsed_seconds = time.perf_counter() - start
[?2004l[?2004h>         latency_ms = float(elapsed_seconds) * 1000.0
[?2004l[?2004h>         # Defensive: guarantee a strictly positive latency even on extremely
[?2004l[?2004h>         # fast machines where perf_counter may return 0.
[?2004l[?2004h>         if latency_ms <= 0.0:
[?2004l[?2004h>             latency_ms = 1e-6
[?2004l[?2004h> 
[?2004l[?2004h>         # -- 2. Build the audit record. ---------------------------------- #
[?2004l[?2004h>         top_ids = _coerce_int_ids([h["id"] for h in hits])
[?2004l[?2004h>         now_utc = datetime.datetime.now(datetime.timezone.utc)
[?2004l[?2004h> 
[?2004l[?2004h>         record = {
[?2004l[?2004h>             "query_id": str(query_id),
[?2004l[?2004h>             "user_id": str(user_id),
[?2004l[?2004h>             "query_text": "" if query_text is None else str(query_text),
[?2004l[?2004h>             "ts": now_utc,
[?2004l[?2004h>             "latency_ms": latency_ms,
[?2004l[?2004h>             "hit_count": int(len(hits)),
[?2004l[?2004h>             "top_ids": top_ids,
[?2004l[?2004h>         }
[?2004l[?2004h> 
[?2004l[?2004h>         # -- 3. Persist the audit row via PyArrow to keep the schema. ---- #
[?2004l[?2004h>         audit_table = pa.table(
[?2004l[?2004h>             {
[?2004l[?2004h>                 "query_id": [record["query_id"]],
[?2004l[?2004h>                 "user_id": [record["user_id"]],
[?2004l[?2004h>                 "query_text": [record["query_text"]],
[?2004l[?2004h>                 "ts": [record["ts"]],
[?2004l[?2004h>                 "latency_ms": [record["latency_ms"]],
[?2004l[?2004h>                 "hit_count": [record["hit_count"]],
[?2004l[?2004h>                 "top_ids": [record["top_ids"]],
[?2004l[?2004h>             },
[?2004l[?2004h>             schema=_QUERY_LOGS_SCHEMA,
[?2004l[?2004h>         )
[?2004l[?2004h>         self._logs.add(audit_table)
[?2004l[?2004h> 
[?2004l[?2004h>         # -- 4. Return hits as-is to the caller. ------------------------- #
[?2004l[?2004h>         return hits
[?2004l[?2004h> PYEOF
