90849924087524, 0.22857797145843506, 0.22311803698539734, -0.054506298154592514, -0.33898988366127014, 1.6710466146469116, 0.5277268886566162, -0.2581789493560791, 0.3303133249282837, -0.9343386292457581, 1.0118132829666138, -1.7461985349655151, 0.7249765396118164, -0.2053908109664917, 1.5124623775482178, 0.40115872025489807, 0.7765721678733826, -1.2339489459991455, -0.6044131517410278, 0.5157844424247742, -0.3380208909511566, 0.006341021507978439, 2.4276516437530518, -1.0683616399765015, -0.9444339275360107, -0.5856158137321472, -0.43713122606277466, 0.213056743144989, -0.5419345498085022, 0.04387108236551285, -0.6714136600494385, -0.2127896249294281, 1.0035128593444824, -0.35368016362190247, -0.8793039917945862, 0.8851312398910522, -0.25938695669174194, 0.2987583577632904, -0.1022958979010582], '_distance': 42.26229476928711}\r\n"]
