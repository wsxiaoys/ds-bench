[35.245315, "o", "    \"\"\"Wrap a LanceDB vector table and log every search to an audit table.\r\n\u001b[?2004l\r"]
[35.245355, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[35.245409, "o", "    Parameters\r\n\u001b[?2004l\r"]
[35.245445, "o", "\u001b[?2004h> "]
