[80.527916, "i", "python3 << 'EOF'\nimport lancedb\nimport shutil\nimport os\n\n# Backup existing DB\ndb_path = '/home/user/myproject/data.lancedb'\nbackup_path = '/home/user/myproject/data.lancedb.bak'\nif not os.path.exists(backup_path):\n    shutil.copytree(db_path, backup_path)\n\nfrom solution import LoggedSearcher\n\n# Use a temp log name to not pollute original DB\nsearcher = LoggedSearcher(db_path, 'articles', 'audit_logs_test')\n\nimport random\nrandom.seed(42)\nfor i in range(3):\n    qv = [random.gauss(0,1) for _ in range(64)]\n    hits = searcher.search(qv, 10, query_id=f'test-{i}', user_id='tester', query_text=f'query {i}')\n    print(f'Query {i}: {len(hits)} hits, first id={hits[0][\"id\"]}, title={hits[0][\"title\"]}')\n\n# Verify\nlog_tbl = lancedb.connect(db_path).open_table('audit_logs_test')\nat = log_tbl.to_arrow()\nprint()\nprint('Audit schema:', at.schema)\nprint('Audit rows:', at.num_rows)\nfor r in at.to_pylist():\n    print(r)\n\n# Cleanup the test table\nimport shutil\nfor entry in os.listdir(db_path):\n    if entry.startswith('audit_logs_test'):\n        full = os.path.join(db_path, entry)\n        if os.path.isdir(full):\n            shutil.rmtree(full)\n        else:\n            os.remove(full)\nprint('Cleanup done.')\nEOF\n"]
