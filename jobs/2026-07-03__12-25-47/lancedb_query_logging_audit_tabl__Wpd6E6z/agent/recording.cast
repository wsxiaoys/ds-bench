[35.245502, "o", "\u001b[?2004h> "]
[35.245553, "o", "    db_uri : str\r\n\u001b[?2004l\r\u001b[?2004h"]
[35.24559, "o", "> "]
[35.245727, "o", "        Filesystem path to the LanceDB database directory.\r\n\u001b[?2004l\r"]
[35.245754, "o", "\u001b[?2004h> "]
[35.245818, "o", "    articles_table : str\r\n\u001b[?2004l\r"]
[35.245855, "o", "\u001b[?2004h> "]
[35.246024, "o", "        Name of the table containing precomputed 64-d vectors to search.\r\n\u001b[?2004l\r"]
[35.246061, "o", "\u001b[?2004h> "]
[35.246121, "o", "    logs_table : str\r\n\u001b[?2004l\r"]
[35.246158, "o", "\u001b[?2004h> "]
[35.246324, "o", "        Name of the table where audit rows are persisted. Created lazily.\r\n\u001b[?2004l\r"]
[35.246349, "o", "\u001b[?2004h> "]
[35.246397, "o", "    \"\"\"\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[35.246433, "o", "\u001b[?2004h> "]
[35.246627, "o", "    def __init__(self, db_uri: str, articles_table: str, logs_table: str) -> None:\r\n\u001b[?2004l\r"]
[35.246652, "o", "\u001b[?2004h> "]
[35.246731, "o", "        self._db_uri = db_uri\r\n\u001b[?2004l\r"]
[35.24677, "o", "\u001b[?2004h> "]
[35.246891, "o", "        self._articles_table_name = articles_table\r\n\u001b[?2004l\r"]
[35.246916, "o", "\u001b[?2004h> "]
[35.247032, "o", "        self._logs_table_name = logs_table\r\n\u001b[?2004l\r"]
[35.247069, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[35.247198, "o", "        self._db = lancedb.connect(db_uri)\r\n\u001b[?2004l\r"]
[35.247226, "o", "\u001b[?2004h> "]
[35.247377, "o", "        self._articles = self._db.open_table(articles_table)\r\n\u001b[?2004l\r\u001b[?2004h"]
[35.247404, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h"]
[35.24745, "o", "> "]
[35.247589, "o", "        # Make sure the logs table exists with the correct schema.\r\n\u001b[?2004l\r"]
[35.247614, "o", "\u001b[?2004h> "]
[35.247771, "o", "        if self._logs_table_name not in self._db.table_names():\r\n\u001b[?2004l\r"]
[35.247809, "o", "\u001b[?2004h> "]
[35.24792, "o", "            self._logs = self._db.create_table(\r\n\u001b[?2004l\r"]
[35.247947, "o", "\u001b[?2004h> "]
[35.248119, "o", "                self._logs_table_name, schema=_QUERY_LOGS_SCHEMA\r\n\u001b[?2004l\r"]
[35.248145, "o", "\u001b[?2004h> "]
[35.248197, "o", "            )\r\n\u001b[?2004l\r\u001b[?2004h> "]
[35.248245, "o", "        else:\r\n\u001b[?2004l\r"]
[35.248281, "o", "\u001b[?2004h> "]
[35.248445, "o", "            self._logs = self._db.open_table(self._logs_table_name)\r\n\u001b[?2004l\r"]
[35.248469, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[35.248518, "o", "\u001b[?2004h> "]
[35.248688, "o", "    # ------------------------------------------------------------------ #\r\n\u001b[?2004l\r"]
[35.248713, "o", "\u001b[?2004h> "]
[35.248908, "o", "    # Public API                                                          #\r\n\u001b[?2004l\r"]
[35.248932, "o", "\u001b[?2004h> "]
[35.249128, "o", "    # ------------------------------------------------------------------ #\r\n\u001b[?2004l\r"]
[35.249153, "o", "\u001b[?2004h> "]
[35.249203, "o", "    def search(\r\n\u001b[?2004l\r\u001b[?2004h"]
[35.24924, "o", "> "]
[35.249264, "o", "        self,\r\n\u001b[?2004l\r\u001b[?2004h"]
[35.24931, "o", "> "]
[35.249381, "o", "        query_vector: Sequence[float],\r\n\u001b[?2004l\r"]
[35.249407, "o", "\u001b[?2004h> "]
[35.24946, "o", "        top_k: int,\r\n\u001b[?2004l\r"]
[35.249486, "o", "\u001b[?2004h> "]
[35.249545, "o", "        query_id: str,\r\n\u001b[?2004l\r"]
[35.249582, "o", "\u001b[?2004h> "]
[35.249629, "o", "        user_id: str,\r\n\u001b[?2004l\r"]
[35.249652, "o", "\u001b[?2004h> "]
[35.249736, "o", "        query_text: str = \"\",\r\n\u001b[?2004l\r"]
[35.24976, "o", "\u001b[?2004h> "]
[35.249818, "o", "    ) -> List[dict]:\r\n\u001b[?2004l\r"]
[35.249865, "o", "\u001b[?2004h> "]
[35.250043, "o", "        \"\"\"Search `articles_table` and write one audit row to `logs_table`.\r\n\u001b[?2004l\r"]
[35.250069, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[35.250125, "o", "> "]
[35.25023, "o", "        Returns the list of hits in the same shape as\r\n\u001b[?2004l\r"]
[35.25025, "o", "\u001b[?2004h> "]
[35.250422, "o", "        ``table.search(query_vector).limit(top_k).to_list()``.\r\n\u001b[?2004l\r\u001b[?2004h"]
[35.250446, "o", "> "]
[35.250497, "o", "        \"\"\"\r\n\u001b[?2004l\r\u001b[?2004h> "]
[35.250719, "o", "        # -- 1. Run the vector search and time it. ------------------------ #\r\n\u001b[?2004l\r"]
[35.250743, "o", "\u001b[?2004h> "]
[35.250851, "o", "        start = time.perf_counter()\r\n\u001b[?2004l\r"]
[35.250873, "o", "\u001b[?2004h> "]
[35.250969, "o", "        hits: List[dict] = (\r\n\u001b[?2004l\r"]
[35.250992, "o", "\u001b[?2004h> "]
[35.251188, "o", "            self._articles.search(query_vector).limit(top_k).to_list()\r\n\u001b[?2004l\r"]
[35.25121, "o", "\u001b[?2004h> "]
[35.251258, "o", "        )\r\n\u001b[?2004l\r\u001b[?2004h> "]
[35.251414, "o", "        elapsed_seconds = time.perf_counter() - start\r\n\u001b[?2004l\r"]
[35.251437, "o", "\u001b[?2004h> "]
[35.251585, "o", "        latency_ms = float(elapsed_seconds) * 1000.0\r\n\u001b[?2004l\r"]
[35.251608, "o", "\u001b[?2004h> "]
[35.251818, "o", "        # Defensive: guarantee a strictly positive latency even on extremely\r\n\u001b[?2004l\r"]
[35.251841, "o", "\u001b[?2004h> "]
[35.252002, "o", "        # fast machines where perf_counter may return 0.\r\n\u001b[?2004l\r"]
[35.252025, "o", "\u001b[?2004h> "]
[35.252127, "o", "        if latency_ms <= 0.0:\r\n"]
[35.252152, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[35.252245, "o", "            latency_ms = 1e-6\r\n\u001b[?2004l\r"]
[35.252268, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[35.252316, "o", "\u001b[?2004h> "]
[35.252505, "o", "        # -- 2. Build the audit record. ---------------------------------- #\r\n\u001b[?2004l\r"]
[35.252526, "o", "\u001b[?2004h> "]
[35.252689, "o", "        top_ids = _coerce_int_ids([h[\"id\"] for h in hits])\r\n\u001b[?2004l\r"]
[35.252711, "o", "\u001b[?2004h> "]
[35.252887, "o", "        now_utc = datetime.datetime.now(datetime.timezone.utc)\r\n\u001b[?2004l\r"]
[35.25291, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[35.252935, "o", "\u001b[?2004h> "]
[35.252993, "o", "        record = {\r\n\u001b[?2004l\r"]
[35.253015, "o", "\u001b[?2004h> "]
[35.25315, "o", "            \"query_id\": str(query_id),\r\n\u001b[?2004l\r"]
[35.253173, "o", "\u001b[?2004h> "]
[35.253285, "o", "            \"user_id\": str(user_id),\r\n\u001b[?2004l\r"]
[35.253308, "o", "\u001b[?2004h> "]
[35.253532, "o", "            \"query_text\": \"\" if query_text is None else str(query_text),\r\n\u001b[?2004l\r\u001b[?2004h"]
[35.253578, "o", "> "]
[35.253628, "o", "            \"ts\": now_utc,\r\n\u001b[?2004l\r"]
[35.253659, "o", "\u001b[?2004h> "]
[35.253763, "o", "            \"latency_ms\": latency_ms,\r\n\u001b[?2004l\r\u001b[?2004h"]
[35.253804, "o", "> "]
[35.253899, "o", "            \"hit_count\": int(len(hits)),\r\n\u001b[?2004l\r"]
[35.253935, "o", "\u001b[?2004h> "]
[35.25402, "o", "            \"top_ids\": top_ids,\r\n\u001b[?2004l\r"]
[35.254043, "o", "\u001b[?2004h> "]
[35.254114, "o", "        }\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[35.254138, "o", "> "]
[35.254337, "o", "        # -- 3. Persist the audit row via PyArrow to keep the schema. ---- #\r\n\u001b[?2004l\r"]
[35.25436, "o", "\u001b[?2004h> "]
[35.254453, "o", "        audit_table = pa.table(\r\n\u001b[?2004l\r"]
[35.254475, "o", "\u001b[?2004h> "]
[35.254531, "o", "            {\r\n\u001b[?2004l\r\u001b[?2004h"]
[35.254571, "o", "> "]
[35.254674, "o", "                \"query_id\": [record[\"query_id\"]],\r\n\u001b[?2004l\r"]
[35.254698, "o", "\u001b[?2004h> "]
[35.254816, "o", "                \"user_id\": [record[\"user_id\"]],\r\n\u001b[?2004l\r"]
[35.254839, "o", "\u001b[?2004h> "]
[35.254973, "o", "                \"query_text\": [record[\"query_text\"]],\r\n\u001b[?2004l\r"]
[35.254993, "o", "\u001b[?2004h> "]
[35.255135, "o", "                \"ts\": [record[\"ts\"]],\r\n\u001b[?2004l\r"]
[35.255162, "o", "\u001b[?2004h> "]
[35.255295, "o", "                \"latency_ms\": [record[\"latency_ms\"]],\r\n\u001b[?2004l\r"]
[35.255314, "o", "\u001b[?2004h> "]
[35.255455, "o", "                \"hit_count\": [record[\"hit_count\"]],\r\n\u001b[?2004l\r"]
[35.255476, "o", "\u001b[?2004h> "]
[35.255604, "o", "                \"top_ids\": [record[\"top_ids\"]],\r\n\u001b[?2004l\r"]
[35.255624, "o", "\u001b[?2004h> "]
[35.255669, "o", "            },\r\n\u001b[?2004l\r"]
[35.25569, "o", "\u001b[?2004h> "]
[35.2558, "o", "            schema=_QUERY_LOGS_SCHEMA,\r\n\u001b[?2004l\r"]
[35.255821, "o", "\u001b[?2004h> "]
[35.255866, "o", "        )\r\n\u001b[?2004l\r\u001b[?2004h> "]
[35.255971, "o", "        self._logs.add(audit_table)\r\n\u001b[?2004l\r"]
[35.255994, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[35.256034, "o", "\u001b[?2004h> "]
[35.256234, "o", "        # -- 4. Return hits as-is to the caller. ------------------------- #\r\n\u001b[?2004l\r"]
[35.256254, "o", "\u001b[?2004h> "]
[35.256318, "o", "        return hits\r\n\u001b[?2004l\r"]
[35.256339, "o", "\u001b[?2004h> "]
[35.25638, "o", "PYEOF\r\n\u001b[?2004l\r"]
[35.258143, "o", "\u001b[?2004h"]
[35.258165, "o", "root@7d1bb788-98dc-4be8-ae6c-9328c582230c:/home/user/myproject# "]
[35.711152, "i", "ls -la /home/user/myproject/solution.py\n"]
[35.711451, "o", "ls -la /home/user/myproject/solution.py\r\n\u001b[?2004l\r"]
[35.712818, "o", "-rw-r--r-- 1 root root 4877 Jul  3 13:19 /home/user/myproject/solution.py\r\n"]
[35.713052, "o", "\u001b[?2004hroot@7d1bb788-98dc-4be8-ae6c-9328c582230c:/home/user/myproject# "]
[44.352599, "i", "cd /home/user/myproject && python3 << 'EOF'\nimport lancedb\nimport pyarrow as pa\nimport random\nimport shutil\nimport os\n\n# Use a fresh DB for the test\ntest_db = '/tmp/test_audit.lancedb'\nif os.path.exists(test_db):\n    shutil.rmtree(test_db)\n\nfrom solution import LoggedSearcher\n\nrandom.seed(0)\n\n# 1. Create a fresh db with the same articles schema\ndb = lancedb.connect(test_db)\nschema = pa.schema([\n    pa.field('id', pa.int64()),\n    pa.field('title', pa.string()),\n    pa.field('embedding', pa.list_(pa.float32(), 64)),\n])\nrows = []\nfor i in range(50):\n    rows.append({'id': i, 'title': f'Article #{i:03d}', 'embedding': [random.gauss(0,1) for _ in range(64)]})\ndb.create_table('articles', data=rows, schema=schema)\n\n# 2. Try the LoggedSearcher\nsearcher = LoggedSearcher(test_db, 'articles', 'query_logs')\n\n# 3. Run a search\nqv = [random.gauss(0,1) for _ in range(64)]\nhits = searcher.search(qv, 5, query_id='q-1', user_id='alice', query_text='hello')\nprint('Hits returned:', len(hits))\nprint('First hit keys:', list(hits[0].keys()))\nassert 'id' in hits[0]\nassert 'title' in hits[0]\nprint('First hit:', hits[0]['id'], hits[0]['title'])\n\n# 4. Run a few more searches\nfor i in range(3):\n    qv = [random.gauss(0,1) for _ in range(64)]\n    searcher.search(qv, 3, query_id=f'q-{i+2}', user_id='bob', query_text=f'text {i}')\n\n# 5. Check query_logs\ndb2 = lancedb.connect(test_db)\nprint('Tables:', db2.table_names())\nassert 'query_logs' in db2.table_names()\nlog_tbl = db2.open_table('query_logs')\nprint('Log schema:', log_tbl.schema)\nprint('Log rows:', log_tbl.count_rows())\nrows = log_tbl.to_pylist()\nfor r in rows:\n    print(r)\n\n# 6. Verify fields\nassert len(rows) == 4\nfor r in rows:\n    assert isinstance(r['query_id'], str)\n    assert isinstance(r['user_id'], str)\n    assert isinstance(r['query_text'], str)\n    assert r['latency_ms'] > 0\n    assert isinstance(r['hit_count'], int)\n    assert all(isinstance(x, int) for x in r['top_ids'])\n\nprint('ALL TESTS PASSED')\nEOF\n"]
