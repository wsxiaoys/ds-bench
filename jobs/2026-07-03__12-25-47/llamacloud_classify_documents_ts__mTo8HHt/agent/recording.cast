esPaginatedCursor = PaginatedCursor<FileListResponse>;\r\n/**\r\n * Schema for a file.\r\n */\r\nexport interface File {\r\n    /**\r\n     * Unique identifier\r\n     */\r\n    id: string;\r\n    name: string;\r\n    /**\r\n     * The ID of the project that the file belongs to\r\n     */\r\n    project_id: string;\r\n    /**\r\n     * Creation datetime\r\n     */\r\n    created_at?: string | null;\r\n    /**"]
