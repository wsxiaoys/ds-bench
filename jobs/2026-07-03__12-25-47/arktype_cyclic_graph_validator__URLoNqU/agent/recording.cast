[170.249601, "i", "cat > src/validator.ts << 'EOF'\nimport { scope, type } from \"arktype\";\n\n/**\n * Recursive schema definitions for Node and Graph.\n *\n * `Node` references itself via `edges`, which is what requires the use of\n * `scope({...}).export()` instead of a single inline `type({...})`.\n *\n * Cross-node structural constraints (unique ids, edge target existence,\n * rootId existence) are enforced via `.narrow(...)` predicates attached to\n * the `Graph` type.\n */\nconst graphModule = scope({\n  Node: {\n    id: \"number.integer >= 0\",\n    label: \"1 <= string <= 40\",\n    edges: \"Node[]\",\n  },\n  Graph: {\n    rootId: \"number.integer >= 0\",\n    nodes: \"1 <= Node[] <= 1000\",\n  },\n})\n  .export();\n\nconst Node = graphModule.Node;\nconst Graph = graphModule.Graph.narrow((g, ctx) => {\n  if (typeof g !== \"object\" || g === null) {\n    return ctx.mustBe(\"an object\");\n  }\n  const graph = g as {\n    rootId: number;\n    nodes: Array<{ id: number; edges: Array<{ id: number }> }>;\n  };\n  const ids = new Set<number>();\n  for (const n of graph.nodes) {\n    if (ids.has(n.id)) {\n      return ctx.mustBe(\"a graph with unique node ids\");\n    }\n    ids.add(n.id);\n  }\n  if (!ids.has(graph.rootId)) {\n    return ctx.mustBe(\"a graph whose rootId exists in nodes\");\n  }\n  const stack: Array<{ id: number; edges: Array<{ id: number }> }> = [\n    ...graph.nodes,\n  ];\n  while (stack.length > 0) {\n    const current = stack.pop()!;\n    for (const edge of current.edges) {\n      if (!ids.has(edge.id)) {\n        return ctx.mustBe(\n          \"a graph where every edge target id exists in nodes\"\n        );\n      }\n    }\n  }\n  return true;\n});\n\nexport type Graph = typeof Graph.infer;\nexport type Node = typeof Node.infer;\n\n/**\n * Validate an unknown input against the `Graph` schema.\n * Returns the validated `Graph` on success, throws an `Error` on failure.\n */\nexport function validateGraph(input: unknown): Graph {\n  const result = Graph(input);\n  if (result instanceof type.errors) {\n    throw new Error(result.summary);\n  }\n  if (result instanceof Error) {\n    throw result;\n  }\n  return result as Graph;\n}\nEOF\n"]
