[226.620176, "i", "cat > /tmp/test_vol.py << 'PYEOF'\nimport os\nfrom daytona import Daytona, DaytonaConfig\n\nconfig = DaytonaConfig(\n    api_key=os.environ.get('DAYTONA_API_KEY'),\n    organization_id=os.environ.get('DAYTONA_ORGANIZATION_ID'),\n)\ndaytona = Daytona(config)\n\n# Try listing volumes\nprint(\"Trying list volumes...\")\ntry:\n    vols = daytona.volume.list()\n    print(f\"Got: {vols}\")\n    if hasattr(vols, '__iter__'):\n        v_list = list(vols)\n        print(f\"Count: {len(v_list)}\")\n        for v in v_list:\n            print(f\" - {v}\")\nexcept Exception as e:\n    print(f\"Error: {type(e).__name__}: {e}\")\nPYEOF\npython3 /tmp/test_vol.py 2>&1 | head -40\n"]
