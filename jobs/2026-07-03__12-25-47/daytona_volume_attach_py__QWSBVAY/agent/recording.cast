[305.771512, "i", "cat > /tmp/test_create_vol.py << 'PYEOF'\nimport os\nfrom daytona import Daytona, DaytonaConfig\n\nconfig = DaytonaConfig(\n    api_key=os.environ.get('DAYTONA_API_KEY'),\n    organization_id=os.environ.get('DAYTONA_ORGANIZATION_ID'),\n)\ndaytona = Daytona(config)\n\n# Try creating a volume\nprint(\"Trying create volume...\")\ntry:\n    vol = daytona.volume.create(\"test-vol-x1y2z\")\n    print(f\"Created: {vol}\")\nexcept Exception as e:\n    print(f\"Error: {type(e).__name__}: {e}\")\nPYEOF\npython3 /tmp/test_create_vol.py 2>&1 | head -40\n"]
