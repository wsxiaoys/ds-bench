[432.090723, "i", "cat > /tmp/test_sb_vol.py << 'PYEOF'\nimport os\nfrom daytona import Daytona, DaytonaConfig, VolumeMount, CreateSandboxFromSnapshotParams\n\nconfig = DaytonaConfig(\n    api_key=os.environ.get('DAYTONA_API_KEY'),\n    organization_id=os.environ.get('DAYTONA_ORGANIZATION_ID'),\n)\ndaytona = Daytona(config)\n\nrun_id = open('/logs/artifacts/run-id').read().strip()\nvolume_name = f\"vol-{run_id}\"\nsandbox_name = f\"vol-py-{run_id}\"\n\nprint(f\"Trying to create sandbox {sandbox_name} with volume {volume_name}\")\n\n# Try passing volume_id as the name (which may be REDACTED-resolved/created)\nparams = CreateSandboxFromSnapshotParams(\n    name=sandbox_name,\n    volumes=[VolumeMount(volume_id=volume_name, mount_path=\"/data\")],\n)\ntry:\n    sb = daytona.create(params, timeout=120)\n    print(f\"Created sandbox: {sb.id}\")\n    print(f\"Volumes: {sb.volumes}\")\nexcept Exception as e:\n    print(f\"Error: {type(e).__name__}: {e}\")\n    import traceback\n    traceback.print_exc()\nPYEOF\npython3 /tmp/test_sb_vol.py 2>&1 | head -50\n"]
