[228.252964, "o", "\u001b[?2004h> "]
[228.253534, "o", "    'Usage: node dist/main.js --thresholds <csv>\\n' +\r\n\u001b[?2004l\r"]
[228.253602, "o", "\u001b[?2004h> "]
[228.254558, "o", "      '  --thresholds   Comma-separated list of similarity_threshold values in [0, 1]\\n' +\r\n\u001b[?2004l\r"]
[228.254634, "o", "\u001b[?2004h> "]
[228.255268, "o", "      '                 Example: --thresholds 0.5,0.7,0.9\\n'\r\n\u001b[?2004l\r"]
[228.255343, "o", "\u001b[?2004h> "]
[228.255493, "o", "  );\r\n\u001b[?2004l\r\u001b[?2004h> }\r\n\u001b[?2004l\r"]
[228.255571, "o", "\u001b[?2004h> "]
[228.255725, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[228.256143, "o", "function sleep(ms: number): Promise<void> {\r\n\u001b[?2004l\r"]
[228.256354, "o", "\u001b[?2004h> "]
[228.256761, "o", "  return new Promise((res) => setTimeout(res, ms));\r\n\u001b[?2004l\r"]
[228.256832, "o", "\u001b[?2004h> }"]
[228.256965, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[228.25703, "o", "\u001b[?2004h> "]
[228.257423, "o", "async function addContextWithRetry(\r\n\u001b[?2004l\r"]
[228.257485, "o", "\u001b[?2004h> "]
[228.257742, "o", "  client: AlchemystAI,\r\n\u001b[?2004l\r"]
[228.257804, "o", "\u001b[?2004h> "]
[228.258366, "o", "  body: Parameters<typeof client.v1.context.add>[0]\r\n\u001b[?2004l\r"]
[228.258458, "o", "\u001b[?2004h> "]
[228.25864, "o", "): Promise<void> {\r\n\u001b[?2004l\r"]
[228.258703, "o", "\u001b[?2004h> "]
[228.259525, "o", "  // Idempotency: the SDK REDACTED-retries 409s twice, but we still wrap in case\r\n\u001b[?2004l\r"]
[228.259586, "o", "\u001b[?2004h> "]
[228.260465, "o", "  // the retries are exhausted or we want to treat persistent conflict as success.\r\n\u001b[?2004l\r"]
[228.260529, "o", "\u001b[?2004h> "]
[228.260661, "o", "  try {\r\n\u001b[?2004l\r"]
[228.260725, "o", "\u001b[?2004h> "]
[228.261125, "o", "    await client.v1.context.add(body);\r\n\u001b[?2004l\r"]
[228.261186, "o", "\u001b[?2004h> "]
[228.261395, "o", "  } catch (err) {\r\n\u001b[?2004l\r"]
[228.261457, "o", "\u001b[?2004h> "]
[228.26189, "o", "    if (err instanceof ConflictError) {\r\n\u001b[?2004l\r"]
[228.261962, "o", "\u001b[?2004h> "]
[228.262826, "o", "      // 409: documents with the same file_name already stored; treat as success.\r\n\u001b[?2004l\r"]
[228.262893, "o", "\u001b[?2004h> "]
[228.26393, "o", "      process.stderr.write(`[warn] ingest returned 409 Conflict (already stored); continuing\\n`);\r\n\u001b[?2004l\r"]
[228.263994, "o", "\u001b[?2004h> "]
[228.264171, "o", "      return;\r\n\u001b[?2004l\r"]
[228.264238, "o", "\u001b[?2004h> "]
[228.264306, "o", "    }\r\n\u001b[?2004l\r"]
[228.264458, "o", "\u001b[?2004h> "]
[228.264861, "o", "    if (err instanceof RateLimitError) {\r\n\u001b[?2004l\r"]
[228.264925, "o", "\u001b[?2004h"]
[228.265041, "o", "> "]
[228.265769, "o", "      process.stderr.write(`[warn] ingest rate limited; backing off\\n`);\r\n\u001b[?2004l\r"]
[228.265831, "o", "\u001b[?2004h> "]
[228.266143, "o", "      await sleep(2000);\r\n\u001b[?2004l\r"]
[228.266205, "o", "\u001b[?2004h> "]
[228.266367, "o", "      try {\r\n\u001b[?2004l\r"]
[228.266422, "o", "\u001b[?2004h> "]
[228.266884, "o", "        await client.v1.context.add(body);\r\n\u001b[?2004l\r"]
[228.266982, "o", "\u001b[?2004h> "]
[228.267282, "o", "      } catch (err2) {\r\n\u001b[?2004l\r"]
[228.267339, "o", "\u001b[?2004h> "]
[228.267949, "o", "        if (err2 instanceof ConflictError) {\r\n\u001b[?2004l\r"]
[228.268005, "o", "\u001b[?2004h> "]
[228.269308, "o", "          process.stderr.write(`[warn] ingest returned 409 Conflict after retry; continuing\\n`);\r\n\u001b[?2004l\r"]
[228.269366, "o", "\u001b[?2004h> "]
[228.269621, "o", "          return;\r\n\u001b[?2004l\r"]
[228.269678, "o", "\u001b[?2004h> "]
[228.269827, "o", "        }\r\n\u001b[?2004l\r"]
[228.269892, "o", "\u001b[?2004h> "]
[228.27014, "o", "        throw err2;\r\n\u001b[?2004l\r"]
[228.270243, "o", "\u001b[?2004h> "]
[228.270307, "o", "      }\r\n\u001b[?2004l\r"]
[228.270366, "o", "\u001b[?2004h> "]
[228.270587, "o", "      return;\r\n\u001b[?2004l\r"]
[228.270644, "o", "\u001b[?2004h> "]
[228.270772, "o", "    }\r\n\u001b[?2004l\r\u001b[?2004h"]
[228.270835, "o", "> "]
[228.270965, "o", "    throw err;\r\n\u001b[?2004l\r"]
[228.27102, "o", "\u001b[?2004h> "]
[228.2711, "o", "  }\r\n\u001b[?2004l\r"]
[228.271243, "o", "\u001b[?2004h> }\r\n\u001b[?2004l\r\u001b[?2004h"]
[228.271318, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h"]
[228.271445, "o", "> "]
[228.271564, "o", "interface CorpusDoc {\r\n\u001b[?2004l\r"]
[228.271649, "o", "\u001b[?2004h> "]
[228.271796, "o", "  idx: number;\r\n\u001b[?2004l\r"]
[228.271861, "o", "\u001b[?2004h> "]
[228.272216, "o", "  content: string;\r\n\u001b[?2004l\r\u001b[?2004h> "]
[228.272576, "o", "  relevance: 'high' | 'medium' | 'low';\r\n\u001b[?2004l\r"]
[228.27264, "o", "\u001b[?2004h> }"]
[228.272751, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[228.272816, "o", "\u001b[?2004h> "]
[228.273221, "o", "function buildCorpus(): CorpusDoc[] {\r\n\u001b[?2004l\r"]
[228.273281, "o", "\u001b[?2004h> "]
[228.273996, "o", "  // Query topic: \"Quantum error correction in superconducting qubits\".\r\n\u001b[?2004l\r"]
[228.274061, "o", "\u001b[?2004h> "]
[228.27489, "o", "  // The corpus mixes clearly on-topic, tangentially related, and clearly off-topic\r\n\u001b[?2004l\r"]
[228.274947, "o", "\u001b[?2004h> "]
[228.275791, "o", "  // documents so that varying similarity_threshold visibly changes the result count.\r\n\u001b[?2004l\r"]
[228.275851, "o", "\u001b[?2004h> "]
[228.275984, "o", "  return [\r\n\u001b[?2004l\r"]
[228.276046, "o", "\u001b[?2004h> "]
[228.27618, "o", "    {\r\n\u001b[?2004l\r\u001b[?2004h"]
[228.276239, "o", "> "]
[228.276358, "o", "      idx: 0,\r\n\u001b[?2004l\r"]
[228.276418, "o", "\u001b[?2004h> "]
[228.276676, "o", "      relevance: 'high',\r\n\u001b[?2004l\r"]
[228.276737, "o", "\u001b[?2004h> "]
[228.276898, "o", "      content:\r\n\u001b[?2004l\r"]
[228.276959, "o", "\u001b[?2004h> "]
[228.277881, "o", "        'Quantum error correction protects logical qubits in superconducting processors. ' +\r\n\u001b[?2004l\r"]
[228.277937, "o", "\u001b[?2004h> "]
[228.278915, "o", "        'Surface codes encode a logical qubit in a two-dimensional lattice of physical qubits ' +\r\n\u001b[?2004l\r"]
[228.278976, "o", "\u001b[?2004h> "]
[228.279896, "o", "        'with stabilizer measurements that detect bit-flip and phase-flip errors without ' +\r\n\u001b[?2004l\r"]
[228.279952, "o", "\u001b[?2004h> "]
[228.280442, "o", "        'disturbing the encoded information.',\r\n\u001b[?2004l\r"]
[228.280497, "o", "\u001b[?2004h> "]
[228.280586, "o", "    },\r\n\u001b[?2004l\r"]
[228.280706, "o", "\u001b[?2004h>     {\r\n"]
[228.280764, "o", "\u001b[?2004l\r\u001b[?2004h"]
[228.280878, "o", "> "]
[228.280939, "o", "      idx: 1,\r\n\u001b[?2004l\r"]
[228.281116, "o", "\u001b[?2004h> "]
[228.281278, "o", "      relevance: 'high',\r\n\u001b[?2004l\r"]
[228.281336, "o", "\u001b[?2004h> "]
[228.281504, "o", "      content:\r\n\u001b[?2004l\r"]
[228.281562, "o", "\u001b[?2004h> "]
[228.28253, "o", "        'In superconducting qubit hardware, transmon qubits are coupled to readout resonators ' +\r\n\u001b[?2004l\r"]
[228.28259, "o", "\u001b[?2004h> "]
[228.283313, "o", "        'and used to implement surface-code quantum error correction. Repeated stabilizer ' +\r\n\u001b[?2004l\r"]
[228.283375, "o", "\u001b[?2004h> "]
[228.28403, "o", "        'measurements produce a syndrome stream that a classical decoder uses to infer and ' +\r\n\u001b[?2004l\r"]
[228.284096, "o", "\u001b[?2004h> "]
[228.284375, "o", "        'correct errors in real time.',\r\n\u001b[?2004l\r"]
[228.284437, "o", "\u001b[?2004h> "]
[228.284556, "o", "    },\r\n\u001b[?2004l\r\u001b[?2004h>     {\r\n\u001b[?2004l\r"]
[228.284621, "o", "\u001b[?2004h> "]
[228.28474, "o", "      idx: 2,\r\n\u001b[?2004l\r"]
[228.2848, "o", "\u001b[?2004h> "]
[228.284947, "o", "      relevance: 'high',\r\n\u001b[?2004l\r\u001b[?2004h> "]
[228.285028, "o", "      content:\r\n\u001b[?2004l\r\u001b[?2004h"]
[228.285088, "o", "> "]
[228.285427, "o", "        'Topological quantum error correction schemes such as the surface code and the color ' +\r\n\u001b[?2004l\r"]
[228.28548, "o", "\u001b[?2004h> "]
[228.285824, "o", "        'code are leading candidates for fault-tolerant quantum computing on superconducting ' +\r\n\u001b[?2004l\r"]
[228.285877, "o", "\u001b[?2004h> "]
[228.286254, "o", "        'qubit platforms. They require physical error rates well below the surface-code threshold.',\r\n\u001b[?2004l\r\u001b[?2004h"]
[228.286308, "o", ">     },\r\n\u001b[?2004l\r\u001b[?2004h> "]
[228.286426, "o", "    {\r\n\u001b[?2004l\r\u001b[?2004h>       idx: 3,\r\n\u001b[?2004l\r"]
[228.28648, "o", "\u001b[?2004h> "]
[228.286592, "o", "      relevance: 'high',\r\n\u001b[?2004l\r:\u001b[?2004h> "]
[228.286646, "o", "      content:\r\n\u001b[?2004l\r\u001b[?2004h"]
[228.286783, "o", "> "]
[228.287081, "o", "        'Syndrome extraction for a distance-d surface code on superconducting qubits requires ' +\r\n\u001b[?2004l\r\u001b[?2004h"]
[228.287139, "o", "> "]
[228.287502, "o", "        'entangling gates between data and ancilla qubits. Low-latency classical decoding of the ' +\r\n\u001b[?2004l\r\u001b[?2004h> "]
[228.287855, "o", "        'syndrome enables real-time quantum error correction within a coherence time.',\r\n\u001b[?2004l\r\u001b[?2004h"]
[228.287914, "o", ">     },\r\n\u001b[?2004l\r\u001b[?2004h> "]
[228.288027, "o", "    {\r\n\u001b[?2004l\r\u001b[?2004h>       idx: 4,\r\n\u001b[?2004l\r"]
[228.288084, "o", "\u001b[?2004h> "]
[228.288213, "o", "      relevance: 'medium',\r\n\u001b[?2004l\r\u001b[?2004h> "]
[228.288269, "o", "      content:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[228.288662, "o", "        'Superconducting qubits are fabricated using lithographic processes similar to those used ' +\r\n\u001b[?2004l\r\u001b[?2004h"]
[228.28872, "o", "> "]
[228.289135, "o", "        'in classical CMOS technology. They operate at millikelvin temperatures inside dilution ' +\r\n\u001b[?2004l\r\u001b[?2004h"]
[228.289198, "o", "> "]
[228.289464, "o", "        'refrigerators and are controlled by microwave pulses delivered through attenuator chains.',\r\n\u001b[?2004l\r\u001b[?2004h> "]
[228.289518, "o", "    },\r\n\u001b[?2004l\r\u001b[?2004h> "]
[228.289626, "o", "    {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[228.28968, "o", "      idx: 5,\r\n\u001b[?2004l\r\u001b[?2004h> "]
[228.289793, "o", "      relevance: 'medium',\r\n\u001b[?2004l\r\u001b[?2004h"]
[228.289851, "o", "> "]
[228.28995, "o", "      content:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[228.290399, "o", "        'Quantum computing promises speedups for certain problems such as integer factorization ' +\r\n\u001b[?2004l\r\u001b[?2004h> "]
[228.290892, "o", "        'and quantum simulation. Implementations exist on superconducting, trapped-ion, photonic, ' +\r\n\u001b[?2004l\r\u001b[?2004h"]
[228.290978, "o", "> "]
[228.291087, "o", "        'and neutral-atom platforms.',\r\n\u001b[?2004l\r\u001b[?2004h"]
[228.291143, "o", ">     },\r\n\u001b[?2004l\r\u001b[?2004h"]
[228.291263, "o", ">     {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[228.291332, "o", "      idx: 6,\r\n\u001b[?2004l\r\u001b[?2004h> "]
[228.291471, "o", "      relevance: 'medium',\r\n\u001b[?2004l\r\u001b[?2004h> "]
[228.291526, "o", "      content:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[228.29193, "o", "        'Decoherence is the dominant source of errors in quantum hardware. Material imperfections, ' +\r\n\u001b[?2004l\r\u001b[?2004h"]
[228.291985, "o", "> "]
[228.292318, "o", "        'flux noise, and cosmic rays can flip qubits and degrade gate fidelity over time.',\r\n\u001b[?2004l\r\u001b[?2004h"]
[228.292371, "o", ">     },\r\n\u001b[?2004l\r\u001b[?2004h> "]
[228.292501, "o", "    {\r\n\u001b[?2004l\r\u001b[?2004h>       idx: 7,\r\n\u001b[?2004l\r"]
[228.292555, "o", "\u001b[?2004h> "]
[228.29268, "o", "      relevance: 'low',\r\n\u001b[?2004l\r\u001b[?2004h> "]
[228.292775, "o", "      content:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[228.293125, "o", "        'A classic chocolate cake recipe calls for flour, sugar, cocoa powder, eggs, butter, and ' +\r\n\u001b[?2004l\r\u001b[?2004h"]
[228.293182, "o", "> "]
[228.29352, "o", "        'baking powder. The dry ingredients are sifted together before being folded into a wet ' +\r\n\u001b[?2004l\r\u001b[?2004h"]
[228.293624, "o", ">         'batter.',\r\n\u001b[?2004l\r\u001b[?2004h"]
[228.293681, "o", ">     },\r\n\u001b[?2004l\r\u001b[?2004h"]
[228.293794, "o", ">     {\r\n\u001b[?2004l\ra\u001b[?2004h> "]
[228.293848, "o", "      idx: 8,\r\n\u001b[?2004l\r\u001b[?2004h> "]
[228.293992, "o", "      relevance: 'low',\r\n\u001b[?2004l\r\u001b[?2004h> "]
[228.2941, "o", "      content:\r\n\u001b[?2004l\r \u001b[?2004h"]
[228.294153, "o", "> "]
[228.294538, "o", "        'Modern soccer tactics emphasize high pressing, positional rotations, and quick ' +\r\n\u001b[?2004l\r\u001b[?2004h"]
[228.294635, "o", "> "]
[228.294884, "o", "        'transitions from defense to attack. Wing-backs stretch the field and create numerical ' +\r\n\u001b[?2004l\r\u001b[?2004h"]
[228.29494, "o", "> "]
[228.295043, "o", "        'advantages in wide areas.',\r\n\u001b[?2004l\r\u001b[?2004h> "]
[228.295172, "o", "    },\r\n\u001b[?2004l\r\u001b[?2004h>     {\r\n"]
[228.295253, "o", "\u001b[?2004l\r\u001b[?2004h>       idx: 9,\r\n\u001b[?2004l\r\u001b[?2004h> "]
[228.295349, "o", "      relevance: 'low',\r\n\u001b[?2004l\r\u001b[?2004h> "]
[228.295429, "o", "      content:\r\n\u001b[?2004l\r\u001b[?2004h"]
[228.295487, "o", "> "]
[228.29577, "o", "        'A list of popular tourist destinations in Iceland includes the Blue Lagoon, the Golden ' +\r\n\u001b[?2004l\r\u001b[?2004h"]
[228.295828, "o", "> "]
[228.296193, "o", "        'Circle, the waterfalls of the south coast, and the black sand beaches of Reynisfjara.',\r\n\u001b[?2004l\r\u001b[?2004h>     },\r\n\u001b[?2004l\r\u001b[?2004h>   ];\r\n\u001b[?2004l\r"]
[228.296252, "o", "\u001b[?2004h> }\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[228.296364, "o", "\u001b[?2004h> "]
[228.296444, "o", "async function main(): Promise<void> {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[228.296621, "o", "  const args = parseArgs(process.argv.slice(2));\r\n\u001b[?2004l\r\u001b[?2004h"]
[228.296675, "o", ">   if (args.help) {\r\n\u001b[?2004l\r"]
[228.296775, "o", "\u001b[?2004h>     printHelp();\r\n"]
[228.296831, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[228.296934, "o", "    process.exit(0);\r\n\u001b[?2004l\r\u001b[?2004h>   }\r\n\u001b[?2004l\r"]
[228.296989, "o", "\u001b[?2004h> "]
[228.29711, "o", "  if (args.thresholds.length === 0) {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[228.297337, "o", "    process.stderr.write('Error: --thresholds is required\\n');\r\n\u001b[?2004l\r\u001b[?2004h"]
[228.297431, "o", ">     printHelp();\r\n\u001b[?2004l\r"]
[228.297492, "o", "\u001b[?2004h>     process.exit(2);\r\n\u001b[?2004l\r"]
[228.297552, "o", "\u001b[?2004h>   }\r\n\u001b[?2004l\r\u001b[?2004h"]
[228.297685, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[228.297792, "o", "  const apiKey = process.env.ALCHEMYST_AI_API_KEY;\r\n\u001b[?2004l\r\u001b[?2004h"]
[228.297849, "o", "> "]
[228.297972, "o", "  if (!apiKey || apiKey.trim() === '') {\r\n\u001b[?2004l\r\u001b[?2004h"]
[228.298065, "o", "> "]
[228.298303, "o", "    process.stderr.write('Error: ALCHEMYST_AI_API_KEY environment variable is not set\\n');\r\n\u001b[?2004l\r\u001b[?2004h"]
[228.29836, "o", "> "]
[228.298419, "o", "    process.exit(1);\r\n\u001b[?2004l\r\u001b[?2004h> "]
[228.29855, "o", "  }\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[228.298679, "o", "  const runIdPath = '/logs/artifacts/run-id';\r\n\u001b[?2004l\r\u001b[?2004h"]
[228.29876, "o", "> "]
[228.298838, "o", "  if (!fs.existsSync(runIdPath)) {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[228.29911, "o", "    process.stderr.write(`Error: run-id file not found at ${runIdPath}\\n`);\r\n\u001b[?2004l\r\u001b[?2004h> "]
[228.299202, "o", "    process.exit(1);\r\n\u001b[?2004l\r\u001b[?2004h"]
[228.29926, "o", ">   }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[228.299464, "o", "  const runId = fs.readFileSync(runIdPath, 'utf8').trim();\r\n\u001b[?2004l\r\u001b[?2004h"]
[228.299519, "o", ">   if (!runId) {\r\n\u001b[?2004l\r"]
[228.299619, "o", "\u001b[?2004h> "]
[228.299806, "o", "    process.stderr.write(`Error: run-id file at ${runIdPath} is empty\\n`);\r\n\u001b[?2004l\r\u001b[?2004h"]
[228.299858, "o", "> "]
[228.299958, "o", "    process.exit(1);\r\n\u001b[?2004l\r\u001b[?2004h>   }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[228.300038, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[228.300174, "o", "  const client = new AlchemystAI({ apiKey });\r\n\u001b[?2004l\r\u001b[?2004h> \r\n"]
[228.300227, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[228.300464, "o", "  const query = 'Quantum error correction in superconducting qubits';\r\n\u001b[?2004l\r\u001b[?2004h> "]
[228.300601, "o", "  const scope = 'internal' as const;\r\n\u001b[?2004l\r\u001b[?2004h"]
[228.300657, "o", "> "]
[228.30082, "o", "  const source = 'platform.api.threshold-sensitivity-cli';\r\n\u001b[?2004l\r\u001b[?2004h"]
[228.300878, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[228.301, "o", "  const corpus = buildCorpus();\r\n\u001b[?2004l\r\u001b[?2004h"]
[228.301088, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[228.301323, "o", "  // Ingest documents. We chunk them into small batches so that any single\r\n\u001b[?2004l\r\u001b[?2004h"]
[228.30138, "o", "> "]
[228.301609, "o", "  // add call cannot blow past rate limits, and so that an individual 409 on\r\n\u001b[?2004l\r\u001b[?2004h"]
[228.301666, "o", "> "]
[228.301875, "o", "  // one batch is handled cleanly without re-ingesting the whole corpus.\r\n\u001b[?2004l\r\u001b[?2004h> "]
[228.301976, "o", "  const batchSize = 5;\r\n\u001b[?2004l\r\u001b[?2004h> "]
[228.302186, "o", "  for (let i = 0; i < corpus.length; i += batchSize) {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[228.302368, "o", "    const batch = corpus.slice(i, i + batchSize);\r\n\u001b[?2004l\r\u001b[?2004h> "]
[228.302528, "o", "    const documents = batch.map((d) => ({\r\n\u001b[?2004l\r\u001b[?2004h"]
[228.302584, "o", "> "]
[228.302694, "o", "      content: d.content,\r\n\u001b[?2004l\r\u001b[?2004h> "]
[228.302915, "o", "      // The metadata.fileName is the canonical 'file_name' on this endpoint\r\n\u001b[?2004l\r\u001b[?2004h> "]
[228.303198, "o", "      // and must include the run-id so concurrent runs do not collide.\r\n\u001b[?2004l\r\u001b[?2004h> "]
[228.303381, "o", "      fileName: `threshold_doc_${d.idx}_${runId}.md`,\r\n\u001b[?2004l\r\u001b[?2004h> "]
[228.30351, "o", "      fileType: 'text/markdown',\r\n\u001b[?2004l\r\u001b[?2004h"]
[228.303566, "o", ">     }));\r\n\u001b[?2004l\r\u001b[?2004h"]
[228.30367, "o", "> "]
[228.30373, "o", "    await addContextWithRetry(client, {\r\n\u001b[?2004l\r\u001b[?2004h"]
[228.303834, "o", "> "]
[228.303918, "o", "      context_type: 'resource',\r\n\u001b[?2004l\r\u001b[?2004h> "]
[228.303976, "o", "      documents,\r\n\u001b[?2004l\r\u001b[?2004h"]
[228.304098, "o", ">       scope,\r\n\u001b[?2004l\r\u001b[?2004h> "]
[228.304153, "o", "      source,\r\n\u001b[?2004l\r\u001b[?2004h> "]
[228.30427, "o", "      metadata: {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[228.304462, "o", "        fileName: `threshold_sensitivity_batch_${i}_${runId}.md`,\r\n\u001b[?2004l\r\u001b[?2004h"]
[228.304519, "o", "> "]
[228.304601, "o", "        fileType: 'text/markdown',\r\n\u001b[?2004l\r\u001b[?2004h> "]
[228.304833, "o", "        groupName: ['threshold-sensitivity', `run-${runId}`],\r\n\u001b[?2004l\r\u001b[?2004h> "]
[228.305008, "o", "        lastModified: new Date().toISOString(),\r\n\u001b[?2004l\r\u001b[?2004h"]
[228.305068, "o", ">       },\r\n\u001b[?2004l\r\u001b[?2004h"]
[228.305127, "o", ">     });\r\n\u001b[?2004l\r"]
[228.305253, "o", "\u001b[?2004h> "]
[228.3054, "o", "    // Small gap between batches to be polite to the ingest pipeline.\r\n\u001b[?2004l\r\u001b[?2004h"]
[228.305454, "o", "> "]
[228.305576, "o", "    await sleep(250);\r\n\u001b[?2004l\r\u001b[?2004h>   }\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[228.305632, "o", "> "]
[228.305863, "o", "  // Allow a brief window for ingested documents to be indexed and searchable.\r\n\u001b[?2004l\r\u001b[?2004h> "]
[228.305955, "o", "  await sleep(1500);\r\n\u001b[?2004l\r\u001b[?2004h> \r\n"]
[228.306007, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[228.306237, "o", "  const results: Array<{ threshold: number; count: number }> = [];\r\n\u001b[?2004l\r\u001b[?2004h> "]
[228.306403, "o", "  for (const threshold of args.thresholds) {\r\n\u001b[?2004l\r\u001b[?2004h"]
[228.306459, "o", "> "]
[228.306694, "o", "    // minimum_similarity_threshold must be <= similarity_threshold; use 0 so the\r\n\u001b[?2004l\r\u001b[?2004h> "]
[228.306935, "o", "    // upper bound is the only thing that constrains the result set.\r\n\u001b[?2004l\r\u001b[?2004h> "]
[228.307109, "o", "    const minimum_similarity_threshold = 0;\r\n\u001b[?2004l\r\u001b[?2004h"]
[228.307167, "o", "> "]
[228.307301, "o", "    let contexts: unknown[] | undefined;\r\n\u001b[?2004l\r\u001b[?2004h> "]
[228.307461, "o", "    for (let attempt = 0; attempt < 4; attempt++) {\r\n\u001b[?2004l\r\u001b[?2004h"]
[228.30752, "o", ">       try {\r\n\u001b[?2004l\r"]
[228.307623, "o", "\u001b[?2004h> "]
[228.307732, "o", "        const resp = await client.v1.context.search({\r\n\u001b[?2004l\r\u001b[?2004h"]
[228.307787, "o", "> "]
[228.30789, "o", "          minimum_similarity_threshold,\r\n\u001b[?2004l\r\u001b[?2004h> "]
[228.307983, "o", "          query,\r\n\u001b[?2004l\r\u001b[?2004h> "]
[228.308142, "o", "          similarity_threshold: threshold,\r\n\u001b[?2004l\r\u001b[?2004h"]
[228.3082, "o", ">           scope,\r\n\u001b[?2004l\r"]
[228.308309, "o", "\u001b[?2004h>         });\r\n\u001b[?2004l\r\u001b[?2004h> "]
[228.308434, "o", "        contexts = resp.contexts;\r\n\u001b[?2004l\r\u001b[?2004h> "]
[228.308516, "o", "        break;\r\n\u001b[?2004l\r\u001b[?2004h> "]
[228.308609, "o", "      } catch (err) {\r\n\u001b[?2004l\r\u001b[?2004h"]
[228.308663, "o", "> "]
[228.308785, "o", "        if (err instanceof RateLimitError) {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[228.309146, "o", "          process.stderr.write(`[warn] search rate limited at threshold=${threshold}; backing off\\n`);\r\n\u001b[?2004l\r\u001b[?2004h"]
[228.309204, "o", "> "]
[228.309325, "o", "          await sleep(1500 * (attempt + 1));\r\n\u001b[?2004l\r\u001b[?2004h> "]
[228.309411, "o", "          continue;\r\n\u001b[?2004l\r\u001b[?2004h> "]
[228.309465, "o", "        }\r\n\u001b[?2004l\r\u001b[?2004h"]
[228.309569, "o", ">         throw err;\r\n\u001b[?2004l\r"]
[228.309623, "o", "\u001b[?2004h>       }\r\n\u001b[?2004l\r"]
[228.309736, "o", "\u001b[?2004h>     }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[228.309929, "o", "    const count = Array.isArray(contexts) ? contexts.length : 0;\r\n\u001b[?2004l\r\u001b[?2004h"]
[228.309986, "o", "> "]
[228.310117, "o", "    results.push({ threshold, count });\r\n\u001b[?2004l\r\u001b[?2004h> "]
[228.310304, "o", "    // Small gap between searches to respect rate limits.\r\n\u001b[?2004l\r\u001b[?2004h> "]
[228.310403, "o", "    await sleep(200);\r\n\u001b[?2004l\r\u001b[?2004h"]
[228.310459, "o", ">   }\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[228.310562, "o", "\u001b[?2004h> "]
[228.31062, "o", "  const out = { query, results };\r\n\u001b[?2004l\r\u001b[?2004h"]
[228.310722, "o", "> "]
[228.310817, "o", "  process.stdout.write(JSON.stringify(out) + '\\n');\r\n\u001b[?2004l\r\u001b[?2004h> "]
[228.310875, "o", "}\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[228.310998, "o", "\u001b[?2004h> main().catch((err) => {\r\n\u001b[?2004l\r\u001b[?2004h"]
[228.311166, "o", "> "]
[228.311302, "o", "  process.stderr.write(`Fatal: ${err && err.stack ? err.stack : String(err)}\\n`);\r\n\u001b[?2004l\r\u001b[?2004h> "]
[228.311395, "o", "  process.exit(1);\r\n\u001b[?2004l\r\u001b[?2004h> "]
[228.311441, "o", "});\r\n\u001b[?2004l\r\u001b[?2004h> EOF\r\n"]
[228.311486, "o", "\u001b[?2004l\r"]
