[34.330192, "o", "python3 /home/user/resynth.py\r\n\u001b[?2004l\r"]
[36.000767, "o", "Loaded: sr=22050, length=110250\r\n"]
[38.554747, "o", "Mel spectrogram shape: (128, 216), db range: -80.00..0.00\r\n"]
[44.871599, "o", "Reconstructed length: 110250\r\n"]
[44.872988, "o", "Wrote /home/user/reconstructed.wav\r\n"]
