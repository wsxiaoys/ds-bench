[410.763432, "o", "        S_rec = np.abs(librosa.stft(y_rec, n_fft=N_FFT, hop_length=512, win_length=N_FFT))\r\n\u001b[?2004l\r\u001b[?2004h> "]
[410.763617, "o", "        sc = np.linalg.norm(S_ref - S_rec) / np.linalg.norm(S_ref)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[410.763801, "o", "        print(f\"  n_iter={NI}: SNR={snr:.3f} dB, SC={sc:.4f}\")\r\n\u001b[?2004l\r\u001b[?2004h> "]
[410.763858, "o", "PYEOF\r\n\u001b[?2004l\r"]
