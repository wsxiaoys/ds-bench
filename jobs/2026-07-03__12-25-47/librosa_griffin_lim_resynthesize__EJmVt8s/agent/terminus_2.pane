[?2004hroot@b8d2b3cf-b24d-4bb9-98bb-067e9c3a9bdd:~# cat > /home/user/resynth.py << 'PYEOF'
[?2004l[?2004h> import json
[?2004l[?2004h> import numpy as np
[?2004l[?2004h> import soundfile as sf
[?2004l[?2004h> import librosa
[?2004l[?2004h> 
[?2004l[?2004h> INPUT_PATH = "/home/user/input.wav"
[?2004l[?2004h> OUTPUT_WAV = "/home/user/reconstructed.wav"
[?2004l[?2004h> OUTPUT_JSON = "/home/user/metrics.json"
[?2004l[?2004h> 
[?2004l[?2004h> # STFT parameters used for both analysis and metric computation
[?2004l[?2004h> N_FFT = 2048
[?2004l[?2004h> HOP_LENGTH = 512
[?2004l[?2004h> WIN_LENGTH = N_FFT  # default win_length is n_fft
[?2004l[?2004h> N_MELS = 128
[?2004l[?2004h> N_ITER = 64  # at least 32
[?2004l[?2004h> 
[?2004l[?2004h> # 1) Load mono audio at native sample rate
[?2004l[?2004h> y, sr = librosa.load(INPUT_PATH, sr=None, mono=True)
[?2004l[?2004h> print(f"Loaded: sr={sr}, length={len(y)}")
[?2004l[?2004h> 
[?2004l[?2004h> # 2) Compute 128-band power mel spectrogram (power=2.0 by default in feature.melspectrogram)
[?2004l[?2004h> M = librosa.feature.melspectrogram(
[?2004l[?2004h>     y=y,
[?2004l[?2004h>     sr=sr,
[?2004l[?2004h>     n_fft=N_FFT,
[?2004l[?2004h>     hop_length=HOP_LENGTH,
[?2004l[?2004h>     win_length=WIN_LENGTH,
[?2004l[?2004h>     n_mels=N_MELS,
[?2004l[?2004h>     power=2.0,
[?2004l[?2004h> )
[?2004l[?2004h> # Log-power representation (dB scale is a standard log-power form)
[?2004l[?2004h> M_db = librosa.power_to_db(M, ref=np.max)
[?2004l[?2004h> print(f"Mel spectrogram shape: {M.shape}, db range: {M_db.min():.2f}..{M_db.max():.2f}")
[?2004l[?2004h> 
[?2004l[?2004h> # 3) Resynthesize via Griffin-Lim, using log-power mel converted back to power mel
[?2004l[?2004h> # mel_to_audio expects a power mel spectrogram, so convert back from dB.
[?2004l[?2004h> M_power = librosa.db_to_power(M_db)
[?2004l[?2004h> 
[?2004l[?2004h> y_rec = librosa.feature.inverse.mel_to_audio(
[?2004l[?2004h>     M=M_power,
[?2004l[?2004h>     sr=sr,
[?2004l[?2004h>     n_fft=N_FFT,
[?2004l[?2004h>     hop_length=HOP_LENGTH,
[?2004l[?2004h>     win_length=WIN_LENGTH,
[?2004l[?2004h>     n_iter=N_ITER,
[?2004l[?2004h>     length=len(y),
[?2004l[?2004h> )
[?2004l[?2004h> print(f"Reconstructed length: {len(y_rec)}")
[?2004l[?2004h> 
[?2004l[?2004h> # 4) Write reconstructed WAV at same SR
[?2004l[?2004h> sf.write(OUTPUT_WAV, y_rec, sr, subtype="PCM_16")
[?2004l[?2004h> print(f"Wrote {OUTPUT_WAV}")
[?2004l[?2004h> 
[?2004l[?2004h> # 5) Compute metrics
[?2004l[?2004h> # Align lengths (within 2% so should match)
[?2004l[?2004h> min_len = min(len(y), len(y_rec))
[?2004l[?2004h> y_a = y[:min_len]
[?2004l[?2004h> y_r = y_rec[:min_len]
[?2004l[?2004h> 
[?2004l[?2004h> # Spectral convergence: || |S_ref| - |S_rec| ||_F / || |S_ref| ||_F
[?2004l[?2004h> S_ref = librosa.stft(y_a, n_fft=N_FFT, hop_length=HOP_LENGTH, win_length=WIN_LENGTH)
[?2004l[?2004h> S_rec = librosa.stft(y_r, n_fft=N_FFT, hop_length=HOP_LENGTH, win_length=WIN_LENGTH)
[?2004l[?2004h> mag_ref = np.abs(S_ref)
[?2004l[?2004h> mag_rec = np.abs(S_rec)
[?2004l[?2004h> spectral_convergence = float(np.linalg.norm(mag_ref - mag_rec) / np.linalg.norm(mag_ref))
[?2004l[?2004h> print(f"Spectral convergence: {spectral_convergence}")
[?2004l[?2004h> 
[?2004l[?2004h> # SNR: 10 * log10( sum(ref^2) / sum((ref - rec)^2) )
[?2004l[?2004h> ref_power = np.sum(y_a.astype(np.float64) ** 2)
[?2004l[?2004h> noise_power = np.sum((y_a - y_r).astype(np.float64) ** 2)
[?2004l[?2004h> snr_db = float(10.0 * np.log10(ref_power / noise_power))
[?2004l[?2004h> print(f"SNR (dB): {snr_db}")
[?2004l[?2004h> 
[?2004l[?2004h> # Confirm reconstructed file sample count
[?2004l[?2004h> recon_read, recon_sr = sf.read(OUTPUT_WAV)
[?2004l[?2004h> length_samples = int(recon_read.shape[0])
[?2004l[?2004h> 
[?2004l[?2004h> metrics = {
[?2004l[?2004h>     "spectral_convergence": spectral_convergence,
[?2004l[?2004h>     "snr_db": snr_db,
[?2004l[?2004h>     "length_samples": length_samples,
[?2004l[?2004h>     "sample_rate": int(recon_sr),
[?2004l[?2004h>     "n_mels": N_MELS,
[?2004l[?2004h>     "n_iter": N_ITER,
[?2004l[?2004h> }
[?2004l[?2004h> 
[?2004l[?2004h> with open(OUTPUT_JSON, "w") as f:
[?2004l[?2004h>     json.dump(metrics, f, indent=2)
[?2004l[?2004h> print(f"Wrote {OUTPUT_JSON}: {metrics}")
