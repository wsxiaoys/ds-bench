[?2004l[?2004h> y, sr = librosa.load(INPUT_PATH, sr=None, mono=True)
[?2004l[?2004h> ref_power = np.sum(y.astype(np.float64) ** 2)
[?2004l[?2004h> 
[?2004l[?2004h> for HL in [128, 256, 512]:
[?2004l[?2004h>     M = librosa.feature.melspectrogram(
[?2004l[?2004h>         y=y, sr=sr, n_fft=N_FFT, hop_length=HL, win_length=N_FFT, n_mels=N_MELS, power=2.0,
[?2004l[?2004h>     )
[?2004l[?2004h>     print(f"\n--- hop_length={HL}, mel shape={M.shape} ---")
[?2004l[?2004h>     for NI in [32, 64, 128, 256]:
[?2004l[?2004h>         y_rec = librosa.feature.inverse.mel_to_audio(
[?2004l[?2004h>             M=M, sr=sr, n_fft=N_FFT, hop_length=HL, win_length=N_FFT,
[?2004l[?2004h>             n_iter=NI, length=len(y),
[?2004l[?2004h>         )
[?2004l[?2004h>         noise = np.sum((y[:len(y_rec)] - y_rec).astype(np.float64) ** 2)
[?2004l[?2004h>         snr = 10.0 * np.log10(ref_power / noise)
[?2004l[?2004h>         # Also compute spectral convergence with hop_length=512
[?2004l[?2004h>         S_ref = np.abs(librosa.stft(y[:len(y_rec)], n_fft=N_FFT, hop_length=512, win_length=N_FFT))
[?2004l[?2004h>         S_rec = np.abs(librosa.stft(y_rec, n_fft=N_FFT, hop_length=512, win_length=N_FFT))
[?2004l[?2004h>         sc = np.linalg.norm(S_ref - S_rec) / np.linalg.norm(S_ref)
[?2004l[?2004h>         print(f"  n_iter={NI}: SNR={snr:.3f} dB, SC={sc:.4f}")
