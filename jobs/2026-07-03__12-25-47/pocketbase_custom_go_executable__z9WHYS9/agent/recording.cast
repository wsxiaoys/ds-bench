[319.494167, "o", "package main\r\n\r\nimport (\r\ngo.\"log\"\r\ngo.\"strings\"\r\ngo.\"unicode\"\r\n\r\ngo.\"github.com/pocketbase/pocketbase\"\r\ngo.\"github.com/pocketbase/pocketbase/core\"\r\n)\r\n\r\n// slugify converts a string to a URL-friendly slug.\r\nfunc slugify(s string) string {\r\ngo.var b strings.Builder\r\ngo.for _, r := range s {\r\ngo.switch {\r\ngo.case unicode.IsLetter(r) || unicode.IsDigit(r):\r\ngo.b.WriteRune(unicode.ToLower(r))\r\ngo.case unicode.IsSpace(r) || r == '-' || r == '_':\r\ngo.b.WriteRune('-')\r\ngo.}\r\ngo.}\r\ngo.return strings.Trim(b.String(), \"-\")\r\n}\r\n\r\nfunc main() {\r\ngo.app := pocketbase.New()\r\n\r\ngo.app.OnRecordCreateRequest(\"posts\").BindFunc(func(e *core.RecordRequestEvent) error {\r\ngo.title := e.Record.GetString(\"title\")\r\ngo.if title == \"\" {\r\ngo.return e.BadRequestError(\"Title cannot be empty\", nil)\r\ngo.}\r\ngo.e.Record.Set(\"slug\", slugify(title))\r\ngo.return e.Next()\r\ngo.})\r\n\r\ngo.if err := app.Start(); err != nil {\r\ngo.log.Fatal(err)\r\ngo.}\r\n}\r\n"]
