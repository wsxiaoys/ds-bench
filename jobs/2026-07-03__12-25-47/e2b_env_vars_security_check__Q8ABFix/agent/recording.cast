[21.069432, "i", "cat > /tmp/setup_sandbox.py << 'EOF'\nimport json\nimport os\nfrom e2b import Sandbox\n\n# Create sandbox with environment variables\nsandbox = Sandbox.create(\n    envs={\n        \"SECRET_TOKEN\": \"super-secret-123\",\n        \"API_ENDPOINT\": \"https://api.example.com\",\n    }\n)\n\nsandbox_id = sandbox.sandbox_id\nprint(f\"Sandbox created with ID: {sandbox_id}\")\n\n# Write the environment variables to a file inside the sandbox\nresult = sandbox.commands.run(\n    'printf \"TOKEN=%s\\\\nENDPOINT=%s\\\\n\" \"$SECRET_TOKEN\" \"$API_ENDPOINT\" > /home/user/env_dump.txt'\n)\nprint(f\"Command stdout: {result.stdout}\")\nprint(f\"Command stderr: {result.stderr}\")\nprint(f\"Exit code: {result.exit_code}\")\n\n# Verify the file contents\nverify = sandbox.commands.run('cat /home/user/env_dump.txt')\nprint(f\"File contents:\\n{verify.stdout}\")\n\n# Save sandbox ID to host file\nwith open('/home/user/e2b_task_info.json', 'w') as f:\n    json.dump({\"sandbox_id\": sandbox_id}, f)\n\nprint(f\"Saved sandbox ID to /home/user/e2b_task_info.json\")\nEOF\n"]
