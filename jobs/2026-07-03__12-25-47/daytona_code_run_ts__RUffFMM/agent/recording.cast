[68.094542, "o", "163-/**\r\n164- * Main class for interacting with the Daytona API.\r\n165- * Provides methods for creating, managing, and interacting with Daytona Sandboxes.\r\n166- * Can be initialized either with explicit configuration or using environment variables.\r\n167- *\r\n168- * @property {VolumeService} volume - Service for managing Daytona Volumes\r\n169- * @property {SnapshotService} snapshot - Service for managing Daytona Snapshots\r\n170- * @property {SecretService} secret - Service for managing Daytona Secrets\r\n171- *\r\n172- * @example\r\n173- * // Using environment variables\r\n174- * // Uses DAYTONA_API_KEY, DAYTONA_API_URL, DAYTONA_TARGET\r\n175- * const daytona = new Daytona();\r\n176- * const sandbox = await daytona.create();\r\n177- *\r\n178- * @example\r\n179- * // Using explicit configuration\r\n180- * const config: DaytonaConfig = {\r\n181- *     apiKey: \"your-api-key\",\r\n182- *     apiUrl: \"https://your-api.com\",\r\n183- *     target: \"us\"\r\n184- * };\r\n185- * const daytona = new Daytona(config);\r\n186- *\r\n187- * @example\r\n188- * // Disposes daytona and flushes traces when done\r\n189- * await using daytona = new Daytona({\r\n190- *   otelEnabled: true,\r\n--\r\n221:     * @param {CreateSandboxFromSnapshotParams} [params] - Parameters for Sandbox creation from snapshot\r\n222-     * @param {object} [options] - Options for the create operation\r\n223-     * @param {number} [options.timeout] - Timeout in seconds (0 means no timeout, default is 60)\r\n224-     * @returns {Promise<Sandbox>} The created Sandbox instance\r\n225-     *\r\n226-     * @example\r\n227-     * const sandbox = await daytona.create();\r\n228-     *\r\n229-     * @example\r\n230-     * // Create a custom sandbox\r\n231:     * const params: CreateSandboxFromSnapshotParams = {\r\n232-     *     language: 'typescript',\r\n"]
[68.09463, "o", "233-     *     snapshot: 'my-snapshot-id',\r\n234-     *     envVars: {\r\n235-     *         NODE_ENV: 'development',\r\n236-     *         DEBUG: 'true'\r\n237-     *     },\r\n238-     *     REDACTEDStopInterval: 60,\r\n239-     *     REDACTEDArchiveInterval: 60,\r\n240-     *     REDACTEDDeleteInterval: 120\r\n241-     * };\r\n242-     * const sandbox = await daytona.create(params, { timeout: 100 });\r\n243-     */\r\n244:    create(params?: CreateSandboxFromSnapshotParams, options?: {\r\n245-        timeout?: number;\r\n246-    }): Promise<Sandbox>;\r\n247-    /**\r\n248-     * Creates Sandboxes from specified image available on some registry or declarative Daytona Image. You can specify various parameters,\r\n249-     * including resources, language, image, environment variables, and volumes. Daytona creates snapshot from\r\n250-     * provided image and uses it to create Sandbox.\r\n251-     *\r\n"]
[68.094927, "o", "\u001b[?2004hroot@6ff1f5db-90db-4197-8c51-bb03254d0207:/home/user/myproject# "]
[77.056072, "i", "cat > /home/user/myproject/run.js << 'EOF'\nconst { Daytona } = require('@daytonaio/sdk');\nconst fs = require('fs');\n\nasync function main() {\n  // Read run-id from the file\n  const runId = fs.readFileSync('/logs/artifacts/run-id', 'utf-8').trim();\n  const sandboxName = `code-run-ts-${runId}`;\n  console.log(`Using run-id: ${runId}, sandbox name: ${sandboxName}`);\n\n  const daytona = new Daytona();\n  let sandbox = null;\n  try {\n    // Create the sandbox\n    sandbox = await daytona.create({\n      name: sandboxName,\n      language: 'typescript',\n    }, { timeout: 120 });\n    console.log(`Sandbox created: ${sandbox.id}`);\n\n    // The code snippet computes factorial of 6\n    const snippet = `\nfunction factorial(n) {\n  if (n <= 1) return 1;\n  return n * factorial(n - 1);\n}\nconsole.log(factorial(6));\n`;\n\n    // Run the snippet\n    const response = await sandbox.process.codeRun(snippet);\n    console.log(`exitCode: ${response.exitCode}, result: ${JSON.stringify(response.result)}`);\n\n    if (response.exitCode !== 0) {\n      console.error(`Code run failed with exitCode ${response.exitCode}`);\n      process.exitCode = 1;\n      return;\n    }\n\n    // Get the result and trim whitespace\n    const value = String(response.result).trim();\n\n    // Write the output to the log file\n    const logLine = `Factorial: ${value}\\n`;\n    fs.writeFileSync('/home/user/myproject/output.log', logLine);\n    console.log(`Wrote log line: ${logLine.trim()}`);\n  } catch (err) {\n    console.error('Error during run:', err);\n    process.exitCode = 1;\n  } finally {\n    // Always delete the sandbox\n    if (sandbox) {\n      try {\n        await daytona.delete(sandbox);\n        console.log('Sandbox deleted');\n      } catch (delErr) {\n        console.error('Failed to delete sandbox:', delErr);\n        process.exitCode = 1;\n      }\n    }\n  }\n}\n\nmain().catch((err) => {\n  console.error('Unhandled error:', err);\n  process.exit(1);\n});\nEOF\n"]
