[152.748293, "o", "\u001b[?2004h> "]
[152.748433, "o", "        process.exitCode = 1;\r\n\u001b[?2004l\r"]
[152.7485, "o", "\u001b[?2004h>       }\r\n\u001b[?2004l\r"]
