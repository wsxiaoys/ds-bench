n     *\r\n     * @example\r\n     * const sandbox = await daytona.get('my-sandbox-id');\r\n     * const forked = await daytona._experimental_fork(sandbox, { name: 'my-fork' });\r\n     * console.log(`Forked sandbox: ${forked.i"]
