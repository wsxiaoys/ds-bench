[152.747349, "o", "      try {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[152.747529, "o", "        await daytona.delete(sandbox);\r\n\u001b[?2004l\r"]
[152.747618, "o", "\u001b[?2004h> "]
[152.747772, "o", "        console.log('Sandbox deleted');\r\n\u001b[?2004l\r"]
[152.747817, "o", "\u001b[?2004h> "]
[152.747931, "o", "      } catch (delErr) {\r\n\u001b[?2004l\r"]
[152.747974, "o", "\u001b[?2004h> "]
