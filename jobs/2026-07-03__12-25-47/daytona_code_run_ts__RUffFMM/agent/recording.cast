[152.73858, "o", "  const sandboxName = `code-run-ts-${runId}`;\r\n\u001b[?2004l\r"]
[152.738646, "o", "\u001b[?2004h> "]
[152.738965, "o", "  console.log(`Using run-id: ${runId}, sandbox name: ${sandboxName}`);\r\n\u001b[?2004l\r"]
[152.739025, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[152.739081, "o", "> "]
[152.739212, "o", "  const daytona = new Daytona();\r\n\u001b[?2004l\r"]
[152.739271, "o", "\u001b[?2004h> "]
[152.739359, "o", "  let sandbox = null;\r\n\u001b[?2004l\r"]
[152.739416, "o", "\u001b[?2004h> "]
[152.739474, "o", "  try {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[152.739616, "o", "    // Create the sandbox\r\n\u001b[?2004l\r\u001b[?2004h"]
[152.739681, "o", "> "]
[152.739824, "o", "    sandbox = await daytona.create({\r\n\u001b[?2004l\r"]
[152.739883, "o", "\u001b[?2004h> "]
[152.73999, "o", "      name: sandboxName,\r\n\u001b[?2004l\r"]
[152.740052, "o", "\u001b[?2004h> "]
