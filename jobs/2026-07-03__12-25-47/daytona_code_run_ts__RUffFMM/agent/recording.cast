[152.74023, "o", "\u001b[?2004h> "]
[152.740343, "o", "    }, { timeout: 120 });\r\n\u001b[?2004l\r"]
[152.740399, "o", "\u001b[?2004h> "]
[152.740632, "o", "    console.log(`Sandbox created: ${sandbox.id}`);\r\n\u001b[?2004l\r"]
[152.740694, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[152.740939, "o", "    // The code snippet computes factorial of 6\r\n\u001b[?2004l\r"]
[152.741002, "o", "\u001b[?2004h> "]
[152.741086, "o", "    const snippet = `\r\n\u001b[?2004l\r"]
[152.741148, "o", "\u001b[?2004h> "]
[152.741241, "o", "function factorial(n) {\r\n\u001b[?2004l\r"]
[152.741302, "o", "\u001b[?2004h> "]
[152.741398, "o", "  if (n <= 1) return 1;\r\n\u001b[?2004l\r"]
[152.741465, "o", "\u001b[?2004h> "]
[152.741592, "o", "  return n * factorial(n - 1);\r\n\u001b[?2004l\r"]
[152.741654, "o", "\u001b[?2004h> }\r\n\u001b[?2004l\r\u001b[?2004h"]
[152.741716, "o", "> "]
[152.741811, "o", "console.log(factorial(6));\r\n\u001b[?2004l\r"]
[152.741878, "o", "\u001b[?2004h> `;\r\n\u001b[?2004l\r"]
[152.741935, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[152.742064, "o", "    // Run the snippet\r\n\u001b[?2004l\r"]
[152.742126, "o", "\u001b[?2004h> "]
[152.74239, "o", "    const response = await sandbox.process.codeRun(snippet);\r\n\u001b[?2004l\r"]
[152.742451, "o", "\u001b[?2004h> "]
[152.742879, "o", "    console.log(`exitCode: ${response.exitCode}, result: ${JSON.stringify(response.result)}`);\r\n\u001b[?2004l\r"]
[152.742944, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[152.743002, "o", "> "]
[152.743134, "o", "    if (response.exitCode !== 0) {\r\n\u001b[?2004l\r"]
[152.743194, "o", "\u001b[?2004h> "]
[152.743528, "o", "      console.error(`Code run failed with exitCode ${response.exitCode}`);\r\n\u001b[?2004l\r"]
[152.7436, "o", "\u001b[?2004h> "]
[152.743711, "o", "      process.exitCode = 1;\r\n\u001b[?2004l\r"]
[152.743772, "o", "\u001b[?2004h> "]
[152.743835, "o", "      return;\r\n\u001b[?2004l\r\u001b[?2004h"]
[152.743905, "o", ">     }\r\n\u001b[?2004l\r"]
[152.743974, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[152.744487, "o", "    // Get the result, trim whitespace, then take only the first line (the integer printed by console.log)\r\n\u001b[?2004l\r\u001b[?2004h"]
[152.74453, "o", "> "]
[152.744737, "o", "    const raw = String(response.result);\r\n\u001b[?2004l\r\u001b[?2004h"]
[152.74481, "o", "> "]
[152.745016, "o", "    const firstLine = raw.split(/\\r?\\n/)[0].trim();\r\n\u001b[?2004l\r\u001b[?2004h"]
[152.745087, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[152.745284, "o", "    // Write the output to the log file\r\n\u001b[?2004l\r\u001b[?2004h"]
[152.745331, "o", "> "]
[152.745559, "o", "    const logLine = `Factorial: ${firstLine}\\n`;\r\n\u001b[?2004l\r"]
[152.745612, "o", "\u001b[?2004h> "]
[152.745922, "o", "    fs.writeFileSync('/home/user/myproject/output.log', logLine);\r\n\u001b[?2004l\r\u001b[?2004h"]
[152.745995, "o", "> "]
[152.746224, "o", "    console.log(`Wrote log line: ${logLine.trim()}`);\r\n\u001b[?2004l\r\u001b[?2004h"]
[152.746293, "o", "> "]
[152.746362, "o", "  } catch (err) {\r\n\u001b[?2004l\r\u001b[?2004h"]
[152.746428, "o", "> "]
[152.746611, "o", "    console.error('Error during run:', err);\r\n\u001b[?2004l\r"]
[152.746655, "o", "\u001b[?2004h> "]
[152.746775, "o", "    process.exitCode = 1;\r\n\u001b[?2004l\r\u001b[?2004h"]
[152.746819, "o", "> "]
[152.746876, "o", "  } finally {\r\n\u001b[?2004l\r"]
[152.746923, "o", "\u001b[?2004h> "]
[152.747085, "o", "    // Always delete the sandbox\r\n\u001b[?2004l\r\u001b[?2004h"]
[152.747155, "o", "> "]
