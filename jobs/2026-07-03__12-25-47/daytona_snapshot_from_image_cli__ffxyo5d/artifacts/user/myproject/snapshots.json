eName":"ubuntu:24.04","state":"active","size":0.02769534569233656,"entrypoint":null,"cpu":4,"gpu":0,"mem":16,"disk":20,"errorReason":null,"createdAt":"2026-07-03T09:35:30.390Z","updatedAt":"2026-07-03T12:33:30.126Z","lastUsedAt":"2026-07-03T12:33:30.107Z","skipValidation":false,"regionIds":[],"initialRunnerId":"519d56f8-419f-408d-9171-cd4eb00c736d","ref":"cr.app.daytona.io/sbox/daytona-52df9b1ee71626e0088f7d400d5c6b5f7bb916f8f0c82b474289a4ece6cf3faf:daytona","sandboxClass":"linux-vm"},{"id":"1477894e-1b04-4396-97c4-59e0b070093e","organizationId":"19336c5f-4f0c-4431-89b0-f42311305913","general":true,"name":"daytona-gpu","imageName":"","state":"active","size":null,"entrypoint":["sleep","infinity"],"cpu":1,"gpu":1,"gpuType":"H100","mem":1,"disk":1,"errorReason":null,"createdAt":"2026-05-28T20:57:59.655Z","updatedAt":"2026-07-03T11:53:21.748Z","lastUsedAt":"2026-07-03T11:53:21.739Z","buildInfo":{"dockerfileContent":"ARG SANDBOX_IMAGE=daytonaio/sandbox:latest\nFROM ${SANDBOX_IMAGE}\nUSER root\n\n# CUDA 13 toolkit (nvcc) via runfile -- NVIDIA's apt repo is unusable on Debian trixie.\n# --toolkit only; the host provides the driver. SHA-256 verified before executing as root.\nARG CUDA_RUN_SHA256=81a5d0d0870ba2022efb0a531dcc60adbdc2bbff7b3ef19d6fd6d8105406c775\nRUN curl -fsSL -o /tmp/cuda.run https://developer.download.nvidia.com/compute/cuda/13.0.2/local_installers/cuda_13.0.2_580.95.05_linux.run \\\n    && echo \"${CUDA_RUN_SHA256}  /tmp/cuda.run\" | sha256sum -c - \\\n    && sh /tmp/cuda.run --silent --toolkit --override \\\n    && rm -f /tmp/cuda.run\nENV CUDA_HOME=/usr/local/cuda\nENV PATH=/usr/local/cuda/bin:${PATH}\n# Put CUDA libs (libnvrtc.so.13) on the loader path, else vLLM's DeepGEMM warmup crashes.\nRUN printf '/usr/local/cuda/lib64\\n/usr/local/cuda/targets/x86_64-linux/lib\\n' > /etc/ld.so.conf.d/cuda.conf \\\n    && ldconfig\n\nRUN python3 -m pip install --no-cache-dir --break-system-packages \\\n      torch==2.11.0 torchvision==0.26.0 torchaudio==2.11.0 \\\n      --index-url https://download.pytorch.org/whl/cu130\n\nRUN python3 -m pip install --no-cache-dir --break-system-packages vllm==0.21.0\n\n# Pre-stage FlashInfer kernels, else vLLM JIT-compiles them on first serve (~60s cold start).\nRUN FIV=$(python3 -c \"import flashinfer; print(flashinfer.__version__)\") \\\n    && python3 -m pip install --no-cache-dir --break-system-packages \"flashinfer-jit-cache==${FIV}\" \\\n       --extra-index-url https://flashinfer.ai/whl/cu130\n\n# GPU/ML packages the base image lacks\nRUN python3 -m pip install --no-cache-dir --break-system-packages \\\n      accelerate==1.13.0 \\\n      datasets==4.8.5 \\\n      safetensors==0.7.0 \\\n      peft==0.19.1 \\\n      bitsandbytes==0.49.2 \\\n      trl==1.5.0 \\\n      einops==0.8.2 \\\n      sentencepiece==0.2.1 \\\n      sentence-transformers==5.5.1 \\\n      nvitop==1.7.0 \\\n      wandb==0.27.0 \\\n      tensorboard==2.20.0 \\\n      jupyterlab==4.5.7 \\\n      ipykernel==7.2.0 \\\n      ipywidgets==8.1.8 \\\n      transformers==5.9.0\n\nUSER daytona\n# Cache FlashInfer cubins as daytona so they land in a runtime-readable home.\nRUN flashinfer download-cubin\nRUN python3 -c \"import torch, vllm, flashinfer\"\nENTRYPOINT [\"sleep\", \"infinity\"]\n\n","contextHashes":[],"createdAt":"2026-05-28T16:24:15.388Z","updatedAt":"2026-05-28T16:57:59.649Z","snapshotRef":"daytona-5e321aea98b316a84b5baee6c32656b29a6caef03392ce109da10ba33f0dcbf7:daytona"},"skipValidation":false,"regionIds":["us"],"initialRunnerId":"54cade98-6404-4143-a5d1-ac626aeba5a8","ref":"cr.app.daytona.io/sbox/daytona-5e321aea98b316a84b5baee6c32656b29a6caef03392ce109da10ba33f0dcbf7:daytona","sandboxClass":"container"},{"id":"f49620c1-d1bb-470e-ad53-43f196d35cb4","organizationId":"3ae0ced2-f32b-4c06-ba3b-51e5bb22e6e6","general":true,"name":"daytona-vm-small","imageName":"daytonaio/sandbox:0.8.0","state":"active","size":7.5996876219287515,"entrypoint":["sleep","infinity"],"cpu":1,"gpu":0,"mem":1,"disk":3,"errorReason":null,"createdAt":"2026-05-18T14:19:42.239Z","updatedAt":"2026-07-03T11:47:24.721Z","lastUsedAt":"2026-07-03T11:47:24.712Z","skipValidation":false,"regionIds":[],"initialRunnerId":"8015b297-397a-40ea-bece-cbd184260aad","ref":"cr.app.daytona.io/sbox/daytona-edb66f95f2f09a28a029a0e03d516cf5482ef13a218e93ab1d80954f6ee7ebbb:daytona","sandboxClass":"linux-vm"},{"id":"67ad03c0-f92c-48a1-96e5-b0dac191750c","organizationId":"3ae0ced2-f32b-4c06-ba3b-51e5bb22e6e6","general":true,"name":"daytona-medium","imageName":"daytonaio/sandbox:0.8.0","state":"active","size":7.5996876219287515,"entrypoint":["sleep","infinity"],"cpu":2,"gpu":0,"mem":4,"disk":8,"errorReason":null,"createdAt":"2026-05-18T14:20:03.825Z","updatedAt":"2026-07-03T09:23:24.427Z","lastUsedAt":"2026-07-03T09:23:24.418Z","skipValidation":false,"regionIds":["us"],"initialRunnerId":"be590013-34d5-407b-b250-3bf6d7943d21","ref":"cr.app.daytona.io/sbox/daytona-edb66f95f2f09a28a029a0e03d516cf5482ef13a218e93ab1d80954f6ee7ebbb:daytona","sandboxClass":"container"},{"id":"6eaee55f-befe-4382-8757-3d1f071d3e65","organizationId":"3ae0ced2-f32b-4c06-ba3b-51e5bb22e6e6","general":true,"name":"daytona-vm-large","imageName":"daytonaio/sandbox:0.8.0","state":"active","size":7.5996876219287515,"entrypoint":null,"cpu":4,"gpu":0,"mem":8,"disk":10,"errorReason":null,"createdAt":"2026-05-18T14:20:23.387Z","updatedAt":"2026-07-03T09:01:45.343Z","lastUsedAt":"2026-07-03T09:01:45.330Z","skipValidation":false,"regionIds":[],"initialRunnerId":"1e54d446-4444-48f7-9597-08a4d7a1daaf","ref":"cr.app.daytona.io/sbox/daytona-edb66f95f2f09a28a029a0e03d516cf5482ef13a218e93ab1d80954f6ee7ebbb:daytona","sandboxClass":"linux-vm"},{"id":"4c37811b-309b-4aa2-86cc-e95ce87ecd46","organizationId":"00000000-0000-0000-0000-000000000000","general":true,"name":"windows-large","imageName":"windows-server-2025-cu-r1","state":"active","size":15,"entrypoint":[""],"cpu":4,"gpu":0,"mem":16,"disk":50,"errorReason":null,"createdAt":"2026-06-29T11:34:03.611Z","updatedAt":"2026-07-03T02