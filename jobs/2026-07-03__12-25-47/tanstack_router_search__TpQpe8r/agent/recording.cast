[413.301328, "o", "{\r\n  \"name\": \"tanstack-search\",\r\n  \"private\": true,\r\n  \"version\": \"0.0.0\",\r\n  \"type\": \"module\",\r\n  \"scripts\": {\r\n    \"dev\": \"vite\",\r\n    \"build\": \"tsc -b && vite build\",\r\n    \"preview\": \"vite preview\"\r\n  },\r\n  \"dependencies\": {\r\n    \"react\": \"^18.3.1\",\r\n    \"react-dom\": \"^18.3.1\",\r\n    \"@tanstack/react-router\": \"^1.95.0\",\r\n    \"zod\": \"^3.23.8\"\r\n  },\r\n  \"devDependencies\": {\r\n    \"@types/react\": \"^18.3.12\",\r\n    \"@types/react-dom\": \"^18.3.1\",\r\n    \"@vitejs/plugin-react\": \"^4.3.4\",\r\n    \"typescript\": \"^5.6.3\",\r\n    \"vite\": \"^6.0.1\"\r\n  }\r\n}\r\n"]
