[423.772536, "o", "import {\r\n  createRootRoute,\r\n  createRoute,\r\n  Outlet,\r\n} from '@tanstack/react-router'\r\nimport { z } from 'zod'\r\nimport { SearchPage } from './search'\r\n\r\nexport const rootRoute = createRootRoute({\r\n  component: () => <Outlet />,\r\n})\r\n\r\nconst searchSchema = z.object({\r\n  q: z.string().optional(),\r\n  category: z.string().optional(),\r\n  minPrice: z.number().optional(),\r\n  maxPrice: z.number().optional(),\r\n})\r\n\r\nexport const searchRoute = createRoute({\r\n  getParentRoute: () => rootRoute,\r\n  path: '/search',\r\n  validateSearch: searchSchema,\r\n  component: SearchPage,\r\n})\r\n"]
[423.772709, "o", "\u001b[?2004hroot@107771f7-cacf-4c89-a28b-c719f4612bb1:/home/user/project# "]
[424.11023, "i", "cat src/routeTree.ts\n"]
[424.110445, "o", "cat src/routeTree.ts\r\n\u001b[?2004l\r"]
[424.111546, "o", "import { rootRoute, searchRoute } from './routes'\r\n\r\nexport const routeTree = rootRoute.addChildren([searchRoute])\r\n"]
[424.111743, "o", "\u001b[?2004hroot@107771f7-cacf-4c89-a28b-c719f4612bb1:/home/user/project# "]
[424.497686, "i", "cat src/main.tsx\n"]
