[413.683806, "o", "import { defineConfig } from 'vite'\r\nimport react from '@vitejs/plugin-react'\r\n\r\nexport default defineConfig({\r\n  plugins: [react()],\r\n  server: {\r\n    port: 4821,\r\n    host: true,\r\n    strictPort: true,\r\n  },\r\n})\r\n"]
[413.684003, "o", "\u001b[?2004hroot@107771f7-cacf-4c89-a28b-c719f4612bb1:/home/user/project# "]
