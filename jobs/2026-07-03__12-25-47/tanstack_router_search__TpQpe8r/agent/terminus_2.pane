[?2004l[?2004h>   const search = useSearch({ from: '/search' }) as {
[?2004l[?2004h>     q?: string
[?2004l[?2004h>     category?: string
[?2004l[?2004h>     minPrice?: number
[?2004l[?2004h>     maxPrice?: number
[?2004l[?2004h>   }
[?2004l[?2004h>   const navigate = useNavigate({ from: '/search' })
[?2004l[?2004h> 
[?2004l[?2004h>   const updateSearch = (key: 'q' | 'category' | 'minPrice' | 'maxPrice', value: string) => {
[?2004l[?2004h>     const next: Record<string, unknown> = { ...search }
[?2004l[?2004h>     if (value === '' || value == null) {
[?2004l[?2004h>       delete next[key]
[?2004l[?2004h>     } else if (key === 'minPrice' || key === 'maxPrice') {
[?2004l[?2004h>       const num = Number(value)
[?2004l[?2004h>       if (Number.isNaN(num)) {
[?2004l[?2004h>         delete next[key]
[?2004l[?2004h>       } else {
[?2004l[?2004h>         next[key] = num
[?2004l[?2004h>       }
[?2004l[?2004h>     } else {
[?2004l[?2004h>       next[key] = value
[?2004l[?2004h>     }
[?2004l[?2004h>     navigate({ search: next, replace: true })
[?2004l[?2004h>   }
[?2004l[?2004h> 
[?2004l[?2004h>   return (
[?2004l[?2004h>     <div style={{ padding: '2rem', fontFamily: 'system-ui, sans-serif', maxWidth: 600 }}>
