[?2004l[?2004h>             type="text"
[?2004l[?2004h>             name="q"
[?2004l[?2004h>             value={search.q ?? ''}
[?2004l[?2004h>             onChange={(e) => updateSearch('q', e.target.value)}
[?2004l[?2004h>           />
[?2004l[?2004h>         </label>
[?2004l[?2004h>         <label>
[?2004l[?2004h>           Category (category):
[?2004l[?2004h>           <br />
[?2004l[?2004h>           <input
[?2004l[?2004h>             type="text"
[?2004l[?2004h>             name="category"
[?2004l[?2004h>             value={search.category ?? ''}
[?2004l[?2004h>             onChange={(e) => updateSearch('category', e.target.value)}
[?2004l[?2004h>           />
[?2004l[?2004h>         </label>
[?2004l[?2004h>         <label>
[?2004l[?2004h>           Min Price (minPrice):
[?2004l[?2004h>           <br />
[?2004l[?2004h>           <input
[?2004l[?2004h>             type="number"
[?2004l[?2004h>             name="minPrice"
[?2004l[?2004h>             value={search.minPrice ?? ''}
[?2004l[?2004h>             onChange={(e) => updateSearch('minPrice', e.target.value)}
[?2004l[?2004h>           />
[?2004l[?2004h>         </label>
