[304.787858, "i", "cat > app/globals.css << 'EOF'\n* {\n  box-sizing: border-box;\n  margin: 0;\n  padding: 0;\n}\n\nbody {\n  font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;\n  background: #f5f5f5;\n  min-height: 100vh;\n  padding: 2rem;\n}\n\nmain {\n  max-width: 600px;\n  margin: 0 REDACTED;\n  background: white;\n  padding: 2rem;\n  border-radius: 8px;\n  box-shadow: 0 2px 8px rgba(0,0,0,0.1);\n}\n\nh1 {\n  margin-bottom: 1.5rem;\n  color: #333;\n}\n\n.upload-form {\n  display: flex;\n  flex-direction: column;\n  gap: 1rem;\n}\n\ninput[type=\"file\"] {\n  padding: 0.5rem;\n  border: 2px dashed #ccc;\n  border-radius: 4px;\n  cursor: pointer;\n}\n\nbutton {\n  padding: 0.75rem 1.5rem;\n  background: #0070f3;\n  color: white;\n  border: none;\n  border-radius: 4px;\n  font-size: 1rem;\n  cursor: pointer;\n}\n\nbutton:disabled {\n  background: #999;\n  cursor: not-allowed;\n}\n\n.preview {\n  margin-top: 1.5rem;\n}\n\n.preview img {\n  max-width: 100%;\n  border-radius: 4px;\n  border: 1px solid #ddd;\n}\n\n.error {\n  color: #d00;\n  margin-top: 0.5rem;\n}\n\n.success {\n  color: #080;\n  margin-top: 0.5rem;\n}\nEOF\n"]
