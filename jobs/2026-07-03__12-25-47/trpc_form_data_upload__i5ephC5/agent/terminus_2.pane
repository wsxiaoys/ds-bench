[?2004l[?2004h> 
[?2004l[?2004h>   const uploadMutation = trpc.uploadFile.useMutation({
[?2004l[?2004h>     onSuccess: (data) => {
[?2004l[?2004h>       setPreviewUrl(data.url);
[?2004l[?2004h>       setError(null);
[?2004l[?2004h>     },
[?2004l[?2004h>     onError: (err) => {
[?2004l[?2004h>       setError(err.message);
[?2004l[?2004h>       setPreviewUrl(null);
[?2004l[?2004h>     },
[?2004l[?2004h>   });
[?2004l[?2004h> 
[?2004l[?2004h>   const handleSubmit = async (e: React.FormEvent<HTMLFormElement>) => {
[?2004l[?2004h>     e.preventDefault();
[?2004l[?2004h>     if (!file) {
[?2004l[?2004h>       setError('Please select a file');
[?2004l[?2004h>       return;
[?2004l[?2004h>     }
[?2004l[?2004h>     const formData = new FormData();
[?2004l[?2004h>     formData.append('file', file);
[?2004l[?2004h>     uploadMutation.mutate(formData);
[?2004l[?2004h>   };
[?2004l[?2004h> 
[?2004l[?2004h>   return (
[?2004l[?2004h>     <form className="upload-form" onSubmit={handleSubmit}>
[?2004l[?2004h>       <input
[?2004l[?2004h>         type="file"
[?2004l[?2004h>         onChange={(e) => setFile(e.target.files?.[0] ?? null)}
[?2004l[?2004h>         accept="image/*"
[?2004l[?2004h>       />
[?2004l[?2004h>       <button type="submit" disabled={uploadMutation.isPending}>
[?2004l[?2004h>         {uploadMutation.isPending ? 'Uploading...' : 'Upload File'}
[?2004l[?2004h>       </button>
