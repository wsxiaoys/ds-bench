[33.466694, "o", "import { registerPlugin } from '@capacitor/core';\r\n\r\nexport interface EchoPlugin {\r\n  echo(options: { value: string }): Promise<{ value: string }>;\r\n}\r\n\r\nconst Echo = registerPlugin<EchoPlugin>('Echo');\r\n\r\nexport default Echo;\r\n"]
