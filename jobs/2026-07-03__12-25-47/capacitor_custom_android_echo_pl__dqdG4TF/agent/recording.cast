[577.038456, "o", "=== Final verification ===\r\n\\n--- EchoPlugin.java ---\r\n"]
[577.039859, "o", "package com.example.myapp;\r\n\r\nimport com.getcapacitor.JSObject;\r\nimport com.getcapacitor.Plugin;\r\nimport com.getcapacitor.PluginCall;\r\nimport com.getcapacitor.PluginMethod;\r\nimport com.getcapacitor.annotation.CapacitorPlugin;\r\n\r\n@CapacitorPlugin(name = \"Echo\")\r\npublic class EchoPlugin extends Plugin {\r\n\r\n    @PluginMethod\r\n    public void echo(PluginCall call) {\r\n        String value = call.getString(\"value\");\r\n        JSObject ret = new JSObject();\r\n        ret.put(\"value\", value);\r\n        call.resolve(ret);\r\n    }\r\n}\r\n"]
[577.0401, "o", "\\n--- MainActivity.java ---\r\n"]
[577.041183, "o", "package com.example.myapp;\r\n\r\nimport android.os.Bundle;\r\n\r\nimport com.getcapacitor.BridgeActivity;\r\n\r\npublic class MainActivity extends BridgeActivity {\r\n    @Override\r\n    public void onCreate(Bundle savedInstanceState) {\r\n        registerPlugin(EchoPlugin.class);\r\n        super.onCreate(savedInstanceState);\r\n    }\r\n}\r\n"]
[577.041403, "o", "\\n--- src/echo.ts ---\r\n"]
[577.042522, "o", "import { registerPlugin } from '@capacitor/core';\r\n\r\nexport interface EchoPlugin {\r\n  echo(options: { value: string }): Promise<{ value: string }>;\r\n}\r\n\r\nconst Echo = registerPlugin<EchoPlugin>('Echo');\r\n\r\nexport default Echo;\r\n"]
[577.042719, "o", "\\n--- APK exists ---\r\n"]
