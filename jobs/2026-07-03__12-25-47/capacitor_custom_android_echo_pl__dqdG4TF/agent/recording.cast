[550.113975, "o", "import { registerPlugin } from '@capacitor/core';\r\n\r\nexport interface EchoPlugin {\r\n  echo(options: { value: string }): Promise<{ value: string }>;\r\n}\r\n\r\nconst Echo = registerPlugin<EchoPlugin>('Echo');\r\n\r\nexport default Echo;\r\n"]
[550.114143, "o", "\u001b[?2004hroot@ad4a03fb-3c32-4be2-887b-f3a52202434c:/tmp# "]
[550.588921, "i", "cat /home/user/myapp/android/app/src/main/java/com/example/myapp/EchoPlugin.java\n"]
[550.589505, "o", "cat /home/user/myapp/android/app/src/main/java/com/example/myapp/EchoPlugin.java\r\n\u001b[?2004l\r"]
[550.590529, "o", "package com.example.myapp;\r\n\r\nimport com.getcapacitor.JSObject;\r\nimport com.getcapacitor.Plugin;\r\nimport com.getcapacitor.PluginCall;\r\nimport com.getcapacitor.PluginMethod;\r\nimport com.getcapacitor.annotation.CapacitorPlugin;\r\n\r\n@CapacitorPlugin(name = \"Echo\")\r\npublic class EchoPlugin extends Plugin {\r\n\r\n    @PluginMethod\r\n    public void echo(PluginCall call) {\r\n        String value = call.getString(\"value\");\r\n        JSObject ret = new JSObject();\r\n        ret.put(\"value\", value);\r\n        call.resolve(ret);\r\n    }\r\n}\r\n"]
[550.590677, "o", "\u001b[?2004hroot@ad4a03fb-3c32-4be2-887b-f3a52202434c:/tmp# "]
[551.051178, "i", "cat /home/user/myapp/android/app/src/main/java/com/example/myapp/MainActivity.java\n"]
[551.051697, "o", "cat /home/user/myapp/android/app/src/main/java/com/example/myapp/MainActivity.java\r\n\u001b[?2004l\r"]
[551.053099, "o", "package com.example.myapp;\r\n\r\nimport android.os.Bundle;\r\n\r\nimport com.getcapacitor.BridgeActivity;\r\n\r\npublic class MainActivity extends BridgeActivity {\r\n    @Override\r\n    public void onCreate(Bundle savedInstanceState) {\r\n        registerPlugin(EchoPlugin.class);\r\n        super.onCreate(savedInstanceState);\r\n    }\r\n}\r\n"]
[551.053331, "o", "\u001b[?2004hroot@ad4a03fb-3c32-4be2-887b-f3a52202434c:/tmp# "]
