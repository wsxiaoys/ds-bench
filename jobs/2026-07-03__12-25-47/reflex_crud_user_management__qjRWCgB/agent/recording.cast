[179.170555, "o", "import reflex as rx\r\n\r\nconfig = rx.Config(\r\n    app_name=\"myproject\",\r\n    plugins=[\r\n        rx.plugins.SitemapPlugin(),\r\n        rx.plugins.TailwindV4Plugin(),\r\n    ]\r\n)"]
[179.170925, "o", "\u001b[?2004hroot@f9fc8de4-5a0a-4967-98d1-2f641efae7c6:/home/user/myproject# "]
[179.603887, "i", "cat main.py\n"]
[179.604153, "o", "cat main.py\r\n\u001b[?2004l\r"]
[179.605778, "o", "def main():\r\n    print(\"Hello from myproject!\")\r\n\r\n\r\nif __name__ == \"__main__\":\r\n    main()\r\n"]
[179.60605, "o", "\u001b[?2004hroot@f9fc8de4-5a0a-4967-98d1-2f641efae7c6:/home/user/myproject# "]
[180.01996, "i", "cat myproject/myproject.py\n"]
[180.020315, "o", "cat myproject/myproject.py\r\n\u001b[?2004l\r"]
[180.021617, "o", "\"\"\"Welcome to Reflex! This file outlines the steps to create a basic app.\"\"\"\r\n\r\nimport reflex as rx\r\n\r\nfrom rxconfig import config\r\n\r\n\r\nclass State(rx.State):\r\n    \"\"\"The app state.\"\"\"\r\n\r\n\r\ndef index() -> rx.Component:\r\n    # Welcome Page (Index)\r\n    return rx.container(\r\n        rx.color_mode.button(position=\"top-right\"),\r\n        rx.vstack(\r\n            rx.heading(\"Welcome to Reflex!\", size=\"9\"),\r\n            rx.text(\r\n                \"Get started by editing \",\r\n                rx.code(f\"{config.app_name}/{config.app_name}.py\"),\r\n                size=\"5\",\r\n            ),\r\n            rx.link(\r\n                rx.button(\"Check out our docs!\"),\r\n                href=\"https://reflex.dev/docs/getting-started/introduction/\",\r\n                is_external=True,\r\n            ),\r\n            spacing=\"5\",\r\n            justify=\"center\",\r\n            min_height=\"85vh\",\r\n        ),\r\n    )\r\n\r\n\r\napp = rx.App()\r\napp.add_page(index)\r\n"]
[180.021933, "o", "\u001b[?2004hroot@f9fc8de4-5a0a-4967-98d1-2f641efae7c6:/home/user/myproject# "]
