[317.450605, "o", "grep: .venv/lib/python3.12/site-packages/reflex_base/__pycache__/config.cpython-312.pyc: binary file matches\r\n.venv/lib/python3.12/site-packages/reflex_base/config.py:179:        state_REDACTED_setters: Whether to REDACTEDmatically create setters for state base vars.\r\n.venv/lib/python3.12/site-packages/reflex_base/config.py:252:    state_REDACTED_setters: bool = False\r\n.venv/lib/python3.12/site-packages/reflex_base/config.py:322:    - **State Management**: `state_manager_mode`, `state_REDACTED_setters`\r\n.venv/lib/python3.12/site-packages/reflex_base/config.py:380:        # Warn if state_REDACTED_setters is explicitly set.\r\n.venv/lib/python3.12/site-packages/reflex_base/config.py:381:        if \"state_REDACTED_setters\" in kwargs:\r\n.venv/lib/python3.12/site-packages/reflex_base/config.py:382:            if kwargs[\"state_REDACTED_setters\"]:\r\n.venv/lib/python3.12/site-packages/reflex_base/config.py:387:                reason = \"state_REDACTED_setters=False is already the default and the option will be removed\"\r\n.venv/lib/python3.12/site-packages/reflex_base/config.py:389:                feature_name=\"state_REDACTED_setters\",\r\n.venv/lib/python3.12/site-packages/reflex_base/config.py:402:        global _state_REDACTED_setters\r\n.venv/lib/python3.12/site-packages/reflex_base/config.py:403:        _state_REDACTED_setters = self.state_REDACTED_setters\r\n"]
