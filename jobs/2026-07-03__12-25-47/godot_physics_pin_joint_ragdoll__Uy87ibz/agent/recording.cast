[338.95806, "i", "cat > test_debug3.gd << 'EOF'\nextends SceneTree\n\nvar root_node: Node = null\nvar frame_count: int = 0\n\nfunc _init() -> void:\n    process_frame.connect(_on_process_frame)\n\nfunc _on_process_frame() -> void:\n    if Engine.get_physics_frames() < 2:\n        return\n    \n    if root_node == null:\n        var scene: PackedScene = load(\"res://scenes/Ragdoll.tscn\")\n        root_node = scene.instantiate()\n        get_root().add_child(root_node)\n        print(\"Scene instantiated and added\")\n    \n    frame_count += 1\n    if frame_count % 30 == 0:\n        var torso: RigidBody2D = root_node.get_part(&\"Torso\")\n        print(\"Frame \", frame_count, \" Torso pos: \", torso.global_position, \" lin_vel: \", torso.linear_velocity)\n    \n    if frame_count > 300:\n        quit()\nEOF\n"]
