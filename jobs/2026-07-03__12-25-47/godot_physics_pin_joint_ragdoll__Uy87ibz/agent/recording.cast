[449.084509, "o", "        failures.append(\"expected 6 RigidBody2D, got \" + str(rigid_body_count))\r\n\u001b[?2004l\r"]
[449.084557, "o", "\u001b[?2004h> "]
[449.084641, "o", "    \r\n\u001b[?2004l\r\u001b[?2004h> "]
[449.084796, "o", "    # Check pin joints\r\n\u001b[?2004l\r"]
[449.084856, "o", "\u001b[?2004h> "]
[449.085006, "o", "    var pin_count := 0\r\n\u001b[?2004l\r"]
[449.085073, "o", "\u001b[?2004h> "]
[449.085238, "o", "    var pin_pairs: Array = []\r\n\u001b[?2004l\r"]
[449.085303, "o", "\u001b[?2004h> "]
[449.085522, "o", "    for child in root.get_children():\r\n\u001b[?2004l\r"]
[449.085588, "o", "\u001b[?2004h> "]
[449.085782, "o", "        if child is PinJoint2D:\r\n\u001b[?2004l\r"]
[449.085829, "o", "\u001b[?2004h> "]
[449.086056, "o", "            pin_count += 1\r\n\u001b[?2004l\r"]
[449.086123, "o", "\u001b[?2004h> "]
[449.086391, "o", "            var pj: PinJoint2D = child\r\n\u001b[?2004l\r"]
[449.086438, "o", "\u001b[?2004h> "]
[449.086818, "o", "            var a_node: Node = pj.get_node_or_null(pj.node_a)\r\n\u001b[?2004l\r"]
[449.086894, "o", "\u001b[?2004h> "]
[449.087266, "o", "            var b_node: Node = pj.get_node_or_null(pj.node_b)\r\n\u001b[?2004l\r"]
[449.087333, "o", "\u001b[?2004h> "]
[449.087503, "o", "            if a_node == null:\r\n\u001b[?2004l\r"]
[449.087567, "o", "\u001b[?2004h> "]
[449.08819, "o", "                failures.append(\"PinJoint \" + child.name + \" node_a doesn't resolve\")\r\n\u001b[?2004l\r"]
[449.088236, "o", "\u001b[?2004h> "]
[449.088527, "o", "            elif not (a_node is RigidBody2D):\r\n\u001b[?2004l\r"]
[449.088593, "o", "\u001b[?2004h> "]
[449.089129, "o", "                failures.append(\"PinJoint \" + child.name + \" node_a is not RigidBody2D\")\r\n\u001b[?2004l\r"]
[449.089175, "o", "\u001b[?2004h> "]
[449.089374, "o", "            if b_node == null:\r\n\u001b[?2004l\r"]
[449.089441, "o", "\u001b[?2004h> "]
[449.089995, "o", "                failures.append(\"PinJoint \" + child.name + \" node_b doesn't resolve\")\r\n\u001b[?2004l\r"]
[449.090043, "o", "\u001b[?2004h> "]
[449.090407, "o", "            elif not (b_node is RigidBody2D):\r\n\u001b[?2004l\r"]
[449.090474, "o", "\u001b[?2004h> "]
[449.091002, "o", "                failures.append(\"PinJoint \" + child.name + \" node_b is not RigidBody2D\")\r\n\u001b[?2004l\r"]
[449.091048, "o", "\u001b[?2004h> "]
[449.091274, "o", "            if a_node and b_node:\r\n\u001b[?2004l\r"]
[449.091341, "o", "\u001b[?2004h> "]
[449.091896, "o", "                pin_pairs.append([String(a_node.name), String(b_node.name)])\r\n\u001b[?2004l\r"]
[449.091962, "o", "\u001b[?2004h>     "]
[449.092028, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[449.09218, "o", "    if pin_count != 5:\r\n\u001b[?2004l\r"]
[449.092225, "o", "\u001b[?2004h> "]
[449.092671, "o", "        failures.append(\"expected 5 PinJoint2D, got \" + str(pin_count))\r\n\u001b[?2004l\r"]
[449.092738, "o", "\u001b[?2004h>     \r\n"]
[449.092802, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[449.092994, "o", "    var required_pairs := [\r\n\u001b[?2004l\r"]
[449.093042, "o", "\u001b[?2004h> "]
[449.093223, "o", "        [\"Head\", \"Torso\"],\r\n\u001b[?2004l\r"]
[449.093271, "o", "\u001b[?2004h> "]
[449.093511, "o", "        [\"LeftArm\", \"Torso\"],\r\n\u001b[?2004l\r"]
[449.09356, "o", "\u001b[?2004h> "]
[449.0938, "o", "        [\"RightArm\", \"Torso\"],\r\n\u001b[?2004l\r"]
[449.093862, "o", "\u001b[?2004h> "]
[449.094056, "o", "        [\"LeftLeg\", \"Torso\"],\r\n\u001b[?2004l\r"]
[449.094122, "o", "\u001b[?2004h> "]
[449.094289, "o", "        [\"RightLeg\", \"Torso\"],\r\n\u001b[?2004l\r"]
[449.094338, "o", "\u001b[?2004h> "]
[449.094417, "o", "    ]\r\n\u001b[?2004l\r\u001b[?2004h> "]
[449.094619, "o", "    for rp in required_pairs:\r\n\u001b[?2004l\r"]
[449.094685, "o", "\u001b[?2004h> "]
[449.094939, "o", "        var found := false\r\n\u001b[?2004l\r\u001b[?2004h"]
[449.094987, "o", "> "]
[449.09519, "o", "        for pp in pin_pairs:\r\n\u001b[?2004l\r"]
[449.095236, "o", "\u001b[?2004h> "]
[449.09579, "o", "            if (pp[0] == rp[0] and pp[1] == rp[1]) or (pp[0] == rp[1] and pp[1] == rp[0]):\r\n\u001b[?2004l\r"]
[449.095864, "o", "\u001b[?2004h> "]
[449.096028, "o", "                found = true\r\n\u001b[?2004l\r"]
[449.096073, "o", "\u001b[?2004h> "]
[449.096217, "o", "                break\r\n\u001b[?2004l\r"]
[449.096282, "o", "\u001b[?2004h> "]
[449.096403, "o", "        if not found:\r\n\u001b[?2004l\r"]
[449.096449, "o", "\u001b[?2004h> "]
[449.096893, "o", "            failures.append(\"missing pin joint \" + str(rp))\r\n\u001b[?2004l\r"]
[449.096939, "o", "\u001b[?2004h> "]
[449.097041, "o", "    \r\n\u001b[?2004l\r\u001b[?2004h> "]
[449.097246, "o", "    # Check methods on root\r\n\u001b[?2004l\r"]
[449.097295, "o", "\u001b[?2004h> "]
[449.097565, "o", "    var ragdoll: Ragdoll = root as Ragdoll\r\n\u001b[?2004l\r"]
[449.097616, "o", "\u001b[?2004h> "]
[449.097763, "o", "    if ragdoll == null:\r\n\u001b[?2004l\r"]
[449.09781, "o", "\u001b[?2004h> "]
[449.098176, "o", "        failures.append(\"root is not Ragdoll instance\")\r\n\u001b[?2004l\r"]
[449.098222, "o", "\u001b[?2004h> "]
[449.098319, "o", "    else:\r\n\u001b[?2004l\r\u001b[?2004h"]
[449.098384, "o", "> "]
[449.098549, "o", "        # Check signal exists\r\n\u001b[?2004l\r"]
[449.098618, "o", "\u001b[?2004h> "]
[449.099036, "o", "        if not ragdoll.has_signal(\"ragdoll_collapsed\"):\r\n\u001b[?2004l\r"]
[449.099082, "o", "\u001b[?2004h> "]
[449.099475, "o", "            failures.append(\"missing ragdoll_collapsed signal\")\r\n\u001b[?2004l\r"]
[449.099542, "o", "\u001b[?2004h> "]
[449.099608, "o", "        \r\n\u001b[?2004l\r\u001b[?2004h"]
[449.099673, "o", "> "]
[449.099787, "o", "        # Check methods\r\n\u001b[?2004l\r"]
[449.099859, "o", "\u001b[?2004h> "]
[449.100186, "o", "        if not ragdoll.has_method(\"apply_impulse_to\"):\r\n\u001b[?2004l\r"]
[449.100231, "o", "\u001b[?2004h> "]
[449.100657, "o", "            failures.append(\"missing apply_impulse_to method\")\r\n\u001b[?2004l\r"]
[449.100725, "o", "\u001b[?2004h> "]
[449.101089, "o", "        if not ragdoll.has_method(\"freeze_all\"):\r\n\u001b[?2004l\r"]
[449.101134, "o", "\u001b[?2004h> "]
[449.101495, "o", "            failures.append(\"missing freeze_all method\")\r\n\u001b[?2004l\r"]
[449.10156, "o", "\u001b[?2004h> "]
[449.101832, "o", "        if not ragdoll.has_method(\"get_part\"):\r\n\u001b[?2004l\r"]
[449.101906, "o", "\u001b[?2004h> "]
[449.10224, "o", "            failures.append(\"missing get_part method\")\r\n\u001b[?2004l\r"]
[449.102285, "o", "\u001b[?2004h> "]
[449.102702, "o", "        if not ragdoll.has_method(\"get_average_position\"):\r\n\u001b[?2004l\r"]
[449.102766, "o", "\u001b[?2004h> "]
[449.103231, "o", "            failures.append(\"missing get_average_position method\")\r\n\u001b[?2004l\r"]
[449.103276, "o", "\u001b[?2004h> "]
[449.103323, "o", "    \r\n\u001b[?2004l\r"]
[449.10337, "o", "\u001b[?2004h> "]
[449.103554, "o", "    if failures.is_empty():\r\n\u001b[?2004l\r"]
[449.103618, "o", "\u001b[?2004h> "]
[449.10382, "o", "        print(\"ALL CHECKS PASSED\")\r\n\u001b[?2004l\r"]
[449.10389, "o", "\u001b[?2004h> "]
[449.103951, "o", "    else:\r\n\u001b[?2004l\r"]
[449.103997, "o", "\u001b[?2004h> "]
[449.104178, "o", "        print(\"FAILURES:\")\r\n\u001b[?2004l\r"]
[449.104243, "o", "\u001b[?2004h> "]
[449.104397, "o", "        for f in failures:\r\n\u001b[?2004l\r"]
[449.10446, "o", "\u001b[?2004h> "]
[449.104639, "o", "            print(\"  - \", f)\r\n\u001b[?2004l\r"]
[449.104703, "o", "\u001b[?2004h>     \r\n"]
[449.104767, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[449.104872, "o", "    quit()\r\n\u001b[?2004l\r"]
[449.104918, "o", "\u001b[?2004h> "]
[449.104965, "o", "EOF\r\n\u001b[?2004l\r"]
