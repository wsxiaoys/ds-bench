[294.232797, "i", "cat > test_debug.gd << 'EOF'\nextends SceneTree\n\nvar signal_received_count: int = 0\nvar root_node: Node = null\n\nfunc _init() -> void:\n    process_frame.connect(_on_process_frame)\n\nfunc _on_process_frame() -> void:\n    if Engine.get_physics_frames() < 2:\n        return\n    \n    # Create ground\n    var ground_body := StaticBody2D.new()\n    ground_body.position = Vector2(400, 600)\n    var ground_shape := CollisionShape2D.new()\n    var ground_rect := RectangleShape2D.new()\n    ground_rect.size = Vector2(800, 50)\n    ground_shape.shape = ground_rect\n    ground_body.add_child(ground_shape)\n    get_root().add_child(ground_body)\n    \n    var scene: PackedScene = load(\"res://scenes/Ragdoll.tscn\")\n    root_node = scene.instantiate()\n    \n    # Connect a debug process\n    root_node.set_meta(\"_debug_track\", true)\n    \n    get_root().add_child(root_node)\n    \n    # Wait some time\n    var t: SceneTreeTimer = create_timer(2.0)\n    await t.timeout\n    \n    # Print positions of all parts\n    for p in [\"Head\", \"Torso\", \"LeftArm\", \"RightArm\", \"LeftLeg\", \"RightLeg\"]:\n        var rb: RigidBody2D = root_node.get_part(StringName(p))\n        print(p, \" position: \", rb.global_position, \" frozen: \", rb.freeze)\n    \n    quit()\nEOF\n"]
