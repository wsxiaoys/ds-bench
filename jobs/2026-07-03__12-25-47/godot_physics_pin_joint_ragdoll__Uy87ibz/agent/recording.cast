[133.48188, "i", "cat > test_ragdoll.gd << 'EOF'\nextends SceneTree\n\nfunc _init() -> void:\n    var scene: PackedScene = load(\"res://scenes/Ragdoll.tscn\")\n    if scene == null:\n        print(\"FAIL: could not load scene\")\n        quit(1)\n        return\n    var root: Node = scene.instantiate()\n    if root == null:\n        print(\"FAIL: could not instantiate scene\")\n        quit(1)\n        return\n    \n    # Check root is Node2D with script\n    if not (root is Node2D):\n        print(\"FAIL: root is not Node2D\")\n        quit(1)\n        return\n    if not root.has_method(\"apply_impulse_to\"):\n        print(\"FAIL: missing apply_impulse_to method\")\n        quit(1)\n        return\n    \n    # Check required parts\n    var required_parts := [\"Head\", \"Torso\", \"LeftArm\", \"RightArm\", \"LeftLeg\", \"RightLeg\"]\n    for p in required_parts:\n        var node: Node = root.get_node_or_null(NodePath(p))\n        if node == null:\n            print(\"FAIL: missing part %s\" % p)\n            quit(1)\n            return\n        if not (node is RigidBody2D):\n            print(\"FAIL: %s is not RigidBody2D\" % p)\n            quit(1)\n            return\n        # Check mass\n        var rb: RigidBody2D = node\n        if rb.mass <= 0.0:\n            print(\"FAIL: %s has invalid mass\" % p)\n            quit(1)\n            return\n        # Check CollisionShape2D child\n        var col: CollisionShape2D = rb.get_node_or_null(\"CollisionShape2D\") as CollisionShape2D\n        if col == null:\n            print(\"FAIL: %s missing CollisionShape2D\" % p)\n            quit(1)\n            return\n        if col.shape == null:\n            print(\"FAIL: %s CollisionShape2D has no shape\" % p)\n            quit(1)\n            return\n        # Check visual\n        var visual: Node = null\n        for child in rb.get_children():\n            if child is ColorRect or child is Polygon2D:\n                visual = child\n                break\n        if visual == null:\n            print(\"FAIL: %s missing visual placeholder\" % p)\n            quit(1)\n            return\n    \n    # Check exactly 5 PinJoint2D nodes\n    var pin_joint_count := 0\n    var pin_pairs := []\n    for child in root.get_children():\n        if child is PinJoint2D:\n            pin_joint_count += 1\n            var pj: PinJoint2D = child\n            var a: String = String(pj.node_a)\n            var b: String = String(pj.node_b)\n            pin_pairs.append([a, b])\n            if pj.get_node_or_null(pj.node_a) == null:\n                print(\"FAIL: pin joint %s node_a doesn't resolve\" % child.name)\n                quit(1)\n                return\n            if pj.get_node_or_null(pj.node_b) == null:\n                print(\"FAIL: pin joint %s node_b doesn't resolve\" % child.name)\n                quit(1)\n                return\n    \n    if pin_joint_count != 5:\n        print(\"FAIL: expected 5 PinJoint2D nodes, found %d\" % pin_joint_count)\n        quit(1)\n        return\n    \n    var required_pairs := [\n        [\"Head\", \"Torso\"],\n        [\"LeftArm\", \"Torso\"],\n        [\"RightArm\", \"Torso\"],\n        [\"LeftLeg\", \"Torso\"],\n        [\"RightLeg\", \"Torso\"],\n    ]\n    for rp in required_pairs:\n        var found := false\n        for pp in pin_pairs:\n            if (pp[0] == rp[0] and pp[1] == rp[1]) or (pp[0] == rp[1] and pp[1] == rp[0]):\n                found = true\n                break\n        if not found:\n            print(\"FAIL: missing pin joint connecting %s\" % rp)\n            quit(1)\n            return\n    \n    print(\"PASS: All checks passed\")\n    quit(0)\nEOF\n"]
