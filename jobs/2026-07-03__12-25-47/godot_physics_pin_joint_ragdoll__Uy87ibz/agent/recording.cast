[259.158926, "i", "cat > test_collapse2.gd << 'EOF'\nextends SceneTree\n\nvar signal_received_count: int = 0\nvar signal_payload: Vector2 = Vector2.ZERO\nvar root_node: Node = null\n\nfunc _init() -> void:\n    process_frame.connect(_on_process_frame)\n\nfunc _on_process_frame() -> void:\n    if Engine.get_physics_frames() < 2:\n        return\n    \n    # Create ground\n    var ground_body := StaticBody2D.new()\n    ground_body.position = Vector2(400, 600)\n    var ground_shape := CollisionShape2D.new()\n    var ground_rect := RectangleShape2D.new()\n    ground_rect.size = Vector2(800, 50)\n    ground_shape.shape = ground_rect\n    ground_body.add_child(ground_shape)\n    get_root().add_child(ground_body)\n    \n    var scene: PackedScene = load(\"res://scenes/Ragdoll.tscn\")\n    root_node = scene.instantiate()\n    \n    root_node.ragdoll_collapsed.connect(_on_ragdoll_collapsed)\n    \n    get_root().add_child(root_node)\n    \n    # Wait for signal\n    var t: SceneTreeTimer = create_timer(10.0)\n    await t.timeout\n    \n    print(\"DEBUG: Signal received \", signal_received_count, \" times\")\n    if signal_received_count == 1:\n        print(\"DEBUG: Signal payload: \", signal_payload)\n        print(\"PASS: Signal received exactly once\")\n    elif signal_received_count == 0:\n        print(\"FAIL: Signal not received in 10 seconds\")\n    else:\n        print(\"FAIL: Signal received multiple times: \", signal_received_count)\n    \n    quit()\n\nfunc _on_ragdoll_collapsed(avg_pos: Vector2) -> void:\n    signal_received_count += 1\n    signal_payload = avg_pos\n    print(\"Signal received with payload: \", avg_pos)\nEOF\n"]
