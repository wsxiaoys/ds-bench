[209.333237, "i", "cat > test_ragdoll_behavior.gd << 'EOF'\nextends SceneTree\n\nfunc _init() -> void:\n    var scene: PackedScene = load(\"res://scenes/Ragdoll.tscn\")\n    if scene == null:\n        print(\"FAIL: could not load scene\")\n        quit(1)\n        return\n    var root: Node = scene.instantiate()\n    \n    # Add to scene so physics processing works\n    get_root().add_child(root)\n    \n    # Verify class_name\n    if not root.has_method(\"apply_impulse_to\"):\n        print(\"FAIL: missing apply_impulse_to method\")\n        quit(1)\n        return\n    if not root.has_method(\"freeze_all\"):\n        print(\"FAIL: missing freeze_all method\")\n        quit(1)\n        return\n    if not root.has_method(\"get_part\"):\n        print(\"FAIL: missing get_part method\")\n        quit(1)\n        return\n    if not root.has_method(\"get_average_position\"):\n        print(\"FAIL: missing get_average_position method\")\n        quit(1)\n        return\n    \n    # Test get_part\n    var head: RigidBody2D = root.get_part(&\"Head\")\n    if head == null:\n        print(\"FAIL: get_part(Head) returned null\")\n        quit(1)\n        return\n    if not (head is RigidBody2D):\n        print(\"FAIL: get_part returned non-RigidBody2D\")\n        quit(1)\n        return\n    \n    # Test get_average_position\n    var avg: Vector2 = root.get_average_position()\n    print(\"DEBUG: avg pos = \", avg)\n    \n    # Test apply_impulse_to\n    root.apply_impulse_to(&\"Head\", Vector2(100, 0))\n    \n    # Test freeze_all\n    root.freeze_all(true)\n    for p in [\"Head\", \"Torso\", \"LeftArm\", \"RightArm\", \"LeftLeg\", \"RightLeg\"]:\n        var rb: RigidBody2D = root.get_part(StringName(p))\n        if not rb.freeze:\n            print(\"FAIL: \", p, \" not frozen\")\n            quit(1)\n            return\n    root.freeze_all(false)\n    for p in [\"Head\", \"Torso\", \"LeftArm\", \"RightArm\", \"LeftLeg\", \"RightLeg\"]:\n        var rb: RigidBody2D = root.get_part(StringName(p))\n        if rb.freeze:\n            print(\"FAIL: \", p, \" still frozen\")\n            quit(1)\n            return\n    \n    # Test signal exists\n    var has_signal: bool = root.has_signal(\"ragdoll_collapsed\")\n    if not has_signal:\n        print(\"FAIL: ragdoll_collapsed signal not declared\")\n        quit(1)\n        return\n    \n    # Test signal connection and emission by waiting for settled state\n    var signal_received := [false]\n    var signal_payload: Array = [Vector2.ZERO]\n    root.ragdoll_collapsed.connect(func(avg_pos: Vector2):\n        signal_received[0] = true\n        signal_payload[0] = avg_pos\n    )\n    \n    # Wait some time for the ragdoll to settle - all parts will be frozen, so they should be stable\n    # But frozen means they won't move, so the settled state should be detected\n    # Actually freeze would prevent physics, but in headless we don't have physics running\n    # Let's just verify the signal can be received by simulating the state\n    \n    # Test class_name\n    if not (\"Ragdoll\" in ClassDB.get_class_list()):\n        # Try alternative way - check if root is a Ragdoll\n        if not (root.get_script().get_global_name() == \"Ragdoll\"):\n            print(\"FAIL: class_name Ragdoll not declared\")\n            quit(1)\n            return\n    \n    print(\"PASS: All behavior checks passed\")\n    quit(0)\nEOF\n"]
