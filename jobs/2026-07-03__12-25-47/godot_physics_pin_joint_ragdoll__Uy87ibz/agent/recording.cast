[365.440774, "i", "cat > test_freeze_signal.gd << 'EOF'\nextends SceneTree\n\nvar signal_received_count: int = 0\nvar signal_payload: Vector2 = Vector2.ZERO\nvar root_node: Node = null\n\nfunc _init() -> void:\n    process_frame.connect(_on_process_frame)\n\nfunc _on_process_frame() -> void:\n    if Engine.get_physics_frames() < 2:\n        return\n    \n    if root_node == null:\n        var scene: PackedScene = load(\"res://scenes/Ragdoll.tscn\")\n        root_node = scene.instantiate()\n        root_node.ragdoll_collapsed.connect(_on_ragdoll_collapsed)\n        get_root().add_child(root_node)\n        \n        # Freeze all bodies so they don't move\n        root_node.freeze_all(true)\n        print(\"Scene instantiated, all parts frozen\")\n    \n    # Wait some time for the signal\n    var t: SceneTreeTimer = create_timer(3.0)\n    await t.timeout\n    \n    print(\"Signal received \", signal_received_count, \" times\")\n    if signal_received_count == 1:\n        print(\"PASS: Signal received exactly once with payload: \", signal_payload)\n    elif signal_received_count == 0:\n        print(\"FAIL: Signal not received in 3 seconds\")\n    else:\n        print(\"FAIL: Signal received multiple times: \", signal_received_count)\n    \n    quit()\n\nfunc _on_ragdoll_collapsed(avg_pos: Vector2) -> void:\n    signal_received_count += 1\n    signal_payload = avg_pos\n    print(\"Signal received with payload: \", avg_pos)\nEOF\n"]
