[449.065238, "i", "cat > final_test.gd << 'EOF'\nextends SceneTree\n\nfunc _init() -> void:\n    process_frame.connect(_on_process_frame)\n\nfunc _on_process_frame() -> void:\n    if Engine.get_physics_frames() < 2:\n        return\n    \n    var failures: Array[String] = []\n    \n    # Load script\n    var script: GDScript = load(\"res://scripts/Ragdoll.gd\") as GDScript\n    if script == null:\n        print(\"FAIL: script not loaded\")\n        quit(1)\n        return\n    \n    # Check class name\n    if script.get_global_name() != \"Ragdoll\":\n        failures.append(\"class_name is not Ragdoll (got: \" + str(script.get_global_name()) + \")\")\n    \n    # Load and instantiate scene\n    var scene: PackedScene = load(\"res://scenes/Ragdoll.tscn\")\n    if scene == null:\n        print(\"FAIL: scene not loaded\")\n        quit(1)\n        return\n    var root: Node = scene.instantiate()\n    \n    # Check root is Node2D with Ragdoll script\n    if not (root is Node2D):\n        failures.append(\"root is not Node2D\")\n    \n    # Check root has Ragdoll script\n    if root.get_script() != script:\n        failures.append(\"root does not have Ragdoll script\")\n    \n    # Check 6 RigidBody2D parts\n    var required_parts := [\"Head\", \"Torso\", \"LeftArm\", \"RightArm\", \"LeftLeg\", \"RightLeg\"]\n    var rigid_body_count := 0\n    for child in root.get_children():\n        if child is RigidBody2D:\n            rigid_body_count += 1\n            var rb: RigidBody2D = child\n            if rb.mass <= 0.0:\n                failures.append(child.name + \" has invalid mass\")\n            var col: CollisionShape2D = rb.get_node_or_null(\"CollisionShape2D\") as CollisionShape2D\n            if col == null:\n                failures.append(child.name + \" missing CollisionShape2D\")\n            elif col.shape == null:\n                failures.append(child.name + \" CollisionShape2D has no shape\")\n            var has_visual := false\n            for c in rb.get_children():\n                if c is ColorRect or c is Polygon2D:\n                    has_visual = true\n            if not has_visual:\n                failures.append(child.name + \" missing visual placeholder\")\n    \n    if rigid_body_count != 6:\n        failures.append(\"expected 6 RigidBody2D, got \" + str(rigid_body_count))\n    \n    # Check pin joints\n    var pin_count := 0\n    var pin_pairs: Array = []\n    for child in root.get_children():\n        if child is PinJoint2D:\n            pin_count += 1\n            var pj: PinJoint2D = child\n            var a_node: Node = pj.get_node_or_null(pj.node_a)\n            var b_node: Node = pj.get_node_or_null(pj.node_b)\n            if a_node == null:\n                failures.append(\"PinJoint \" + child.name + \" node_a doesn't resolve\")\n            elif not (a_node is RigidBody2D):\n                failures.append(\"PinJoint \" + child.name + \" node_a is not RigidBody2D\")\n            if b_node == null:\n                failures.append(\"PinJoint \" + child.name + \" node_b doesn't resolve\")\n            elif not (b_node is RigidBody2D):\n                failures.append(\"PinJoint \" + child.name + \" node_b is not RigidBody2D\")\n            if a_node and b_node:\n                pin_pairs.append([String(a_node.name), String(b_node.name)])\n    \n    if pin_count != 5:\n        failures.append(\"expected 5 PinJoint2D, got \" + str(pin_count))\n    \n    var required_pairs := [\n        [\"Head\", \"Torso\"],\n        [\"LeftArm\", \"Torso\"],\n        [\"RightArm\", \"Torso\"],\n        [\"LeftLeg\", \"Torso\"],\n        [\"RightLeg\", \"Torso\"],\n    ]\n    for rp in required_pairs:\n        var found := false\n        for pp in pin_pairs:\n            if (pp[0] == rp[0] and pp[1] == rp[1]) or (pp[0] == rp[1] and pp[1] == rp[0]):\n                found = true\n                break\n        if not found:\n            failures.append(\"missing pin joint \" + str(rp))\n    \n    # Check methods on root\n    var ragdoll: Ragdoll = root as Ragdoll\n    if ragdoll == null:\n        failures.append(\"root is not Ragdoll instance\")\n    else:\n        # Check signal exists\n        if not ragdoll.has_signal(\"ragdoll_collapsed\"):\n            failures.append(\"missing ragdoll_collapsed signal\")\n        \n  "]
[449.065306, "i", "      # Check methods\n        if not ragdoll.has_method(\"apply_impulse_to\"):\n            failures.append(\"missing apply_impulse_to method\")\n        if not ragdoll.has_method(\"freeze_all\"):\n            failures.append(\"missing freeze_all method\")\n        if not ragdoll.has_method(\"get_part\"):\n            failures.append(\"missing get_part method\")\n        if not ragdoll.has_method(\"get_average_position\"):\n            failures.append(\"missing get_average_position method\")\n    \n    if failures.is_empty():\n        print(\"ALL CHECKS PASSED\")\n    else:\n        print(\"FAILURES:\")\n        for f in failures:\n            print(\"  - \", f)\n    \n    quit()\nEOF\n"]
