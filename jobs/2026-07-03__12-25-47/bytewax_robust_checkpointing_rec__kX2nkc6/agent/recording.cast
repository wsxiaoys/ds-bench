[461.307376, "o", "\u001b[?2004h"]
[461.307437, "o", "root@7f555f06-22fe-4fd0-95e4-d30ab2919f63:/tmp/test_bytewax# "]
[470.89388, "i", "sed -n '77,180p' /usr/local/lib/python3.12/dist-packages/bytewax/testing.py\n"]
[470.894554, "o", "sed -n '77,180p' /usr/local/lib/python3.12/dist-packages/bytewax/testing.py\r\n\u001b[?2004l\r"]
[470.89709, "o", "class _IterSourcePartition(StatefulSourcePartition[X, int]):\r\n    def __init__(\r\n        self,\r\n        ib: Iterable[\r\n            Union[\r\n                X,\r\n                \"TestingSource.EOF\",\r\n"]
[470.897142, "o", "                \"TestingSource.ABORT\",\r\n                \"TestingSource.PAUSE\",\r\n            ]\r\n        ],\r\n        batch_size: int,\r\n        resume_state: Optional[int],\r\n    ):\r\n"]
[470.897192, "o", "        self._start_idx = 0 if resume_state is None else resume_state\r\n        self._batch_size = batch_size\r\n        self._next_awake: Optional[datetime] = None\r\n        self._it = iter(ib)\r\n        # Resume to one after the last completed read index.\r\n        ffwd_iter(self._it, self._start_idx)\r\n        self._raise: Optional[Exception] = None\r\n\r\n"]
[470.897249, "o", "    @override\r\n    def next_batch(self) -> List[X]:\r\n        if self._raise is not None:\r\n            raise self._raise\r\n        if self._next_awake is not None:\r\n            self._next_awake = None\r\n\r\n"]
[470.897494, "o", "        batch = []\r\n        for item in self._it:\r\n            if isinstance(item, TestingSource.EOF):\r\n                self._raise = StopIteration()\r\n                # Skip over this on continuation.\r\n                self._start_idx += 1\r\n                # Batch is done early.\r\n                break\r\n            elif isinstance(item, TestingSource.ABORT):\r\n                if not item._triggered:\r\n                    self._raise = AbortExecution()\r\n                    # Don't trigger on next execution.\r\n                    item._triggered = True\r\n                    # Batch is done early.\r\n                    break\r\n            elif isinstance(item, TestingSource.PAUSE):\r\n                now = datetime.now(tz=timezone.utc)\r\n                self._next_awake = now + item.for_duration\r\n                # Batch is done early.\r\n                break\r\n            else:\r\n                batch.append(item)\r\n                if len(batch) >= self._batch_size:\r\n                    break\r\n\r\n        # If the last item was a sentinel, then don't say EOF, let the\r\n        # next batch raise the exception.\r\n        if len(batch) > 0 or self._raise is not None or self._next_awake is not None:\r\n            self._start_idx += len(batch)\r\n            return batch\r\n        else:\r\n            raise StopIteration()\r\n\r\n    @override\r\n"]
[470.897578, "o", "    def next_awake(self) -> Optional[datetime]:\r\n        return self._next_awake\r\n\r\n    @override\r\n    def snapshot(self) -> int:\r\n        return self._start_idx\r\n\r\n\r\nclass TestingSource(FixedPartitionedSource[X, int]):\r\n    \"\"\"Produce input from a Python iterable.\r\n\r\n    You only want to use this for unit testing.\r\n\r\n    The iterable must be identical on all workers.\r\n\r\n    There is no parallelism; only one worker will actually consume the\r\n    iterable.\r\n\r\n    Be careful using a generator as the iterable; if you fail and\r\n    attempt to resume the dataflow without rebuilding it, the\r\n"]
[470.897654, "o", "    half-consumed generator will be re-used on recovery and early\r\n    input will be lost so resume will see the correct data.\r\n\r\n    \"\"\"\r\n\r\n    __test__ = False\r\n\r\n    @dataclass\r\n    class EOF:\r\n        \"\"\"Signal the input to EOF.\r\n\r\n        The next execution will continue from the item after this.\r\n\r\n        \"\"\"\r\n\r\n        pass\r\n\r\n    # TODO: Find a way to use ABORT in a multi-worker scenario.\r\n    # Something like a back channel that one has aborted.\r\n    @dataclass\r\n    class ABORT:\r\n"]
[470.897945, "o", "\u001b[?2004hroot@7f555f06-22fe-4fd0-95e4-d30ab2919f63:/tmp/test_bytewax# "]
[492.422092, "i", "cat > /home/user/bytewax_recovery/dataflow.py << 'PYEOF'\n\"\"\"Bytewax dataflow that maintains running maximum per key with recovery.\"\"\"\n\nimport csv\nfrom pathlib import Path\nfrom typing import List, Optional\n\nfrom bytewax.connectors.files import FileSink\nfrom bytewax.dataflow import Dataflow\nfrom bytewax.inputs import FixedPartitionedSource, StatefulSourcePartition\nimport bytewax.operators as op\n\n\nclass _CsvPartition(StatefulSourcePartition[dict, int]):\n    def __init__(self, path: Path, resume_state: Optional[int]):\n        self._path = path\n        self._f = open(path, \"rt\", newline=\"\")\n        self._reader = csv.DictReader(self._f)\n        self._consumed = 0\n        self._exhausted = False\n        if resume_state is not None:\n            for _ in range(resume_state):\n                try:\n                    next(self._reader)\n                    self._consumed += 1\n                except StopIteration:\n                    self._exhausted = True\n                    break\n\n    def next_batch(self) -> List[dict]:\n        if self._exhausted:\n            raise StopIteration()\n        batch = []\n        try:\n            while True:\n                row = next(self._reader)\n                batch.append(row)\n        except StopIteration:\n            self._exhausted = True\n        self._consumed += len(batch)\n        if not batch:\n            raise StopIteration()\n        return batch\n\n    def snapshot(self) -> int:\n        return self._consumed\n\n    def close(self) -> None:\n        try:\n            self._f.close()\n        except Exception:\n            pass\n\n\nclass CsvSource(FixedPartitionedSource[dict, int]):\n    \"\"\"CSV file source. The partition key is the file path, so a different\n    input file across resumes is naturally handled.\"\"\"\n\n    def __init__(self, path):\n        self._path = Path(path)\n\n    def list_parts(self) -> List[str]:\n        if self._path.exists():\n            return [str(self._path)]\n        return []\n\n    def build_part(self, step_id: str, for_part: str, resume_state: Optional[int]):\n        return _CsvPartition(Path(for_part), resume_state)\n\n\ndef _running_max(state, item):\n    value = int(item[\"value\"])\n    if state is None:\n        new_state = value\n    elif state >= value:\n        new_state = state\n    else:\n        new_state = value\n    return (new_state, new_state)\n\n\ndef build_flow(input_file: str, output_file: str) -> Dataflow:\n    flow = Dataflow(\"running_max_recovery\")\n    inp = CsvSource(input_file)\n    s = op.input(\"in\", flow, inp)\n    keyed = op.key_on(\"key\", s, lambda item: item[\"key\"])\n    maxed = op.stateful_map(\"running_max\", keyed, _running_max)\n\n    # FileSink needs (key, value) tuples where value is a string.\n    formatted = op.map_value(\"format\", maxed, lambda v: f\"{v}\")\n    op.output(\"out\", formatted, FileSink(Path(output_file)))\n    return flow\nPYEOF\n"]
[492.422476, "o", "cat > /home/user/bytewax_recovery/dataflow.py << 'PYEOF'\r\n\u001b[?2004l\r"]
[492.422563, "o", "\u001b[?2004h> "]
[492.422722, "o", "\"\"\"Bytewax dataflow that maintains running maximum per key with recovery.\"\"\"\r\n\u001b[?2004l\r\u001b[?2004h"]
[492.422788, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> import csv\r\n\u001b[?2004l\r"]
[492.422849, "o", "\u001b[?2004h> "]
[492.422922, "o", "from pathlib import Path\r\n\u001b[?2004l\r\u001b[?2004h> "]
[492.42302, "o", "from typing import List, Optional\r\n\u001b[?2004l\r\u001b[?2004h> "]
[492.423088, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[492.423184, "o", "from bytewax.connectors.files import FileSink\r\n\u001b[?2004l\r\u001b[?2004h> "]
[492.423306, "o", "from bytewax.dataflow import Dataflow\r\n\u001b[?2004l\r\u001b[?2004h> "]
[492.423533, "o", "from bytewax.inputs import FixedPartitionedSource, StatefulSourcePartition\r\n\u001b[?2004l\r\u001b[?2004h> "]
[492.423627, "o", "import bytewax.operators as op\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[492.423697, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[492.423845, "o", "class _CsvPartition(StatefulSourcePartition[dict, int]):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[492.42402, "o", "    def __init__(self, path: Path, resume_state: Optional[int]):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[492.42411, "o", "        self._path = path\r\n\u001b[?2004l\r\u001b[?2004h> "]
[492.424246, "o", "        self._f = open(path, \"rt\", newline=\"\")\r\n\u001b[?2004l\r\u001b[?2004h> "]
[492.424414, "o", "        self._reader = csv.DictReader(self._f)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[492.424494, "o", "        self._consumed = 0\r\n\u001b[?2004l\r\u001b[?2004h> "]
[492.424584, "o", "        self._exhausted = False\r\n\u001b[?2004l\r\u001b[?2004h> "]
[492.424695, "o", "        if resume_state is not None:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[492.424822, "o", "            for _ in range(resume_state):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[492.424891, "o", "                try:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[492.425006, "o", "                    next(self._reader)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[492.425124, "o", "                    self._consumed += 1\r\n\u001b[?2004l\r\u001b[?2004h> "]
[492.425237, "o", "                except StopIteration:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[492.425376, "o", "                    self._exhausted = True\r\n\u001b[?2004l\r\u001b[?2004h> "]
[492.425456, "o", "                    break\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[492.425523, "o", "\u001b[?2004h> "]
[492.425592, "o", "    def next_batch(self) -> List[dict]:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[492.42568, "o", "        if self._exhausted:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[492.425783, "o", "            raise StopIteration()\r\n\u001b[?2004l\r\u001b[?2004h> "]
[492.425845, "o", "        batch = []\r\n\u001b[?2004l\r\u001b[?2004h"]
[492.425919, "o", ">         try:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[492.425986, "o", "            while True:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[492.426098, "o", "                row = next(self._reader)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[492.426201, "o", "                batch.append(row)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[492.426292, "o", "        except StopIteration:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[492.426417, "o", "            self._exhausted = True\r\n\u001b[?2004l\r\u001b[?2004h> "]
[492.426513, "o", "        self._consumed += len(batch)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[492.426588, "o", "        if not batch:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[492.426684, "o", "            raise StopIteration()\r\n\u001b[?2004l\r\u001b[?2004h> "]
[492.42676, "o", "        return batch\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[492.426823, "o", "\u001b[?2004h> "]
[492.426889, "o", "    def snapshot(self) -> int:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[492.426969, "o", "        return self._consumed\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[492.427031, "o", "\u001b[?2004h> "]
[492.427092, "o", "    def close(self) -> None:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[492.427153, "o", "        try:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[492.427217, "o", "            self._f.close()\r\n\u001b[?2004l\r\u001b[?2004h> "]
[492.427302, "o", "        except Exception:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[492.427376, "o", "            pass\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[492.427435, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[492.427556, "o", "class CsvSource(FixedPartitionedSource[dict, int]):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[492.427753, "o", "    \"\"\"CSV file source. The partition key is the file path, so a different\r\n\u001b[?2004l\r\u001b[?2004h> "]
[492.427912, "o", "    input file across resumes is naturally handled.\"\"\"\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[492.427989, "o", "\u001b[?2004h> "]
[492.42805, "o", "    def __init__(self, path):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[492.428121, "o", "        self._path = Path(path)\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[492.428179, "o", "\u001b[?2004h> "]
[492.428253, "o", "    def list_parts(self) -> List[str]:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[492.428361, "o", "        if self._path.exists():\r\n\u001b[?2004l\r\u001b[?2004h> "]
[492.428464, "o", "            return [str(self._path)]\r\n\u001b[?2004l\r\u001b[?2004h> "]
[492.428534, "o", "        return []\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[492.428594, "o", "\u001b[?2004h> "]
[492.428772, "o", "    def build_part(self, step_id: str, for_part: str, resume_state: Optional[int]):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[492.428934, "o", "        return _CsvPartition(Path(for_part), resume_state)\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[492.429, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[492.429073, "o", "def _running_max(state, item):\r\n\u001b[?2004l\r\u001b[?2004h"]
[492.429134, "o", "> "]
[492.429199, "o", "    value = int(item[\"value\"])\r\n\u001b[?2004l\r\u001b[?2004h> "]
[492.429258, "o", "    if state is None:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[492.429328, "o", "        new_state = value\r\n\u001b[?2004l\r\u001b[?2004h> "]
[492.429415, "o", "    elif state >= value:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[492.429497, "o", "        new_state = state\r\n\u001b[?2004l\r\u001b[?2004h> "]
[492.429554, "o", "    else:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[492.429622, "o", "        new_state = value\r\n\u001b[?2004l\r\u001b[?2004h> "]
[492.429731, "o", "    return (new_state, new_state)\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[492.42979, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[492.429933, "o", "def build_flow(input_file: str, output_file: str) -> Dataflow:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[492.430058, "o", "    flow = Dataflow(\"running_max_recovery\")\r\n\u001b[?2004l\r\u001b[?2004h> "]
[492.430152, "o", "    inp = CsvSource(input_file)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[492.430251, "o", "    s = op.input(\"in\", flow, inp)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[492.43042, "o", "    keyed = op.key_on(\"key\", s, lambda item: item[\"key\"])\r\n\u001b[?2004l\r\u001b[?2004h> "]
[492.43058, "o", "    maxed = op.stateful_map(\"running_max\", keyed, _running_max)\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[492.430642, "o", "\u001b[?2004h> "]
[492.430776, "o", "    # FileSink needs (key, value) tuples where value is a string.\r\n\u001b[?2004l\r\u001b[?2004h> "]
[492.430948, "o", "    formatted = op.map_value(\"format\", maxed, lambda v: f\"{v}\")\r\n\u001b[?2004l\r\u001b[?2004h> "]
[492.431115, "o", "    op.output(\"out\", formatted, FileSink(Path(output_file)))\r\n\u001b[?2004l\r\u001b[?2004h> "]
[492.431176, "o", "    return flow\r\n\u001b[?2004l\r\u001b[?2004h> "]
[492.431237, "o", "PYEOF\r\n\u001b[?2004l\r"]
[492.433059, "o", "\u001b[?2004hroot@7f555f06-22fe-4fd0-95e4-d30ab2919f63:/tmp/test_bytewax# "]
[493.55236, "i", "rm -rf /tmp/rec1 /tmp/test_bytewax/output1.csv && bash /home/user/bytewax_recovery/run.sh /tmp/test_bytewax/input1.csv /tmp/test_bytewax/output1.csv /tmp/rec1 2>&1 | tail -20\n"]
[493.553599, "o", "rm -rf /tmp/rec1 /tmp/test_bytewax/output1.csv && bash /home/user/bytewax_recovery/run.sh /tmp/test_bytewax/input1.csv /tmp/test_bytewax/output1.csv /tmp/rec1 2>&1 | tail -20\r\n\u001b[?2004l\r"]
[493.693635, "o", "\u001b[?2004hroot@7f555f06-22fe-4fd0-95e4-d30ab2919f63:/tmp/test_bytewax# "]
