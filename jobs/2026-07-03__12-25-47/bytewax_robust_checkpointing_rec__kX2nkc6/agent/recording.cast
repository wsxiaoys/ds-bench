[305.520837, "o", "class CsvSource(FixedPartitionedSource[dict, int]):\r\n\u001b[?2004l\r"]
[305.52089, "o", "\u001b[?2004h> "]
[305.52104, "o", "    \"\"\"CSV file source. The partition key is the file path, so a different\r\n\u001b[?2004l\r"]
[305.521092, "o", "\u001b[?2004h> "]
[305.521192, "o", "    input file across resumes is naturally handled.\"\"\"\r\n\u001b[?2004l\r\u001b[?2004h"]
[305.521239, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h"]
[305.521277, "o", "> "]
[305.521324, "o", "    def __init__(self, path):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[305.521416, "o", "        self._path = Path(path)\r\n\u001b[?2004l\r\u001b[?2004h"]
[305.521471, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[305.521547, "o", "    def list_parts(self) -> List[str]:\r\n\u001b[?2004l\r"]
[305.521602, "o", "\u001b[?2004h> "]
[305.521648, "o", "        if self._path.exists():\r\n\u001b[?2004l\r\u001b[?2004h"]
[305.521702, "o", "> "]
[305.521757, "o", "            return [str(self._path)]\r\n\u001b[?2004l\r"]
[305.52181, "o", "\u001b[?2004h> "]
[305.52186, "o", "        return []\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[305.521912, "o", "\u001b[?2004h> "]
[305.522057, "o", "    def build_part(self, step_id: str, for_part: str, resume_state: Optional[int]):\r\n\u001b[?2004l\r"]
[305.522108, "o", "\u001b[?2004h> "]
[305.522224, "o", "        return _CsvPartition(Path(for_part), resume_state)\r\n\u001b[?2004l\r\u001b[?2004h"]
[305.522275, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h"]
[305.522324, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[305.522381, "o", "def _running_max(state, item):\r\n\u001b[?2004l\r\u001b[?2004h"]
[305.522442, "o", "> "]
[305.522578, "o", "    value = int(item[\"value\"])\r\n\u001b[?2004l\r\u001b[?2004h> "]
[305.522658, "o", "    if state is None:\r\n\u001b[?2004l\r\u001b[?2004h>         new_state = value\r\n\u001b[?2004l\r\u001b[?2004h> "]
[305.522733, "o", "    elif state >= value:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[305.522818, "o", "        new_state = state\r\n\u001b[?2004l\r\u001b[?2004h> "]
[305.522867, "o", "    else:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[305.522948, "o", "        new_state = value\r\n\u001b[?2004l\r\u001b[?2004h> "]
[305.523045, "o", "    return (new_state, new_state)\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[305.523091, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[305.523266, "o", "def build_flow(input_file: str, output_file: str) -> Dataflow:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[305.523397, "o", "    flow = Dataflow(\"running_max_recovery\")\r\n\u001b[?2004l\r\u001b[?2004h> "]
[305.52349, "o", "    inp = CsvSource(input_file)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[305.523594, "o", "    s = op.input(\"in\", flow, inp)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[305.523762, "o", "    keyed = op.key_on(\"key\", s, lambda item: item[\"key\"])\r\n\u001b[?2004l\r\u001b[?2004h> "]
[305.52398, "o", "    maxed = op.stateful_map(\"running_max\", keyed, _running_max)\r\n\u001b[?2004l\r\u001b[?2004h"]
[305.524028, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[305.524417, "o", "    # FileSink needs (key, value) tuples where value is a string.\r\n\u001b[?2004l\r"]
[305.524466, "o", "\u001b[?2004h> "]
[305.524854, "o", "    formatted = op.map_value(\"format\", maxed, lambda v: f\"{v}\")\r\n\u001b[?2004l\r"]
[305.524927, "o", "\u001b[?2004h> "]
[305.525278, "o", "    op.output(\"out\", formatted, FileSink(Path(output_file)))\r\n\u001b[?2004l\r"]
[305.525325, "o", "\u001b[?2004h> "]
[305.52544, "o", "    return flow\r\n\u001b[?2004l\r"]
[305.525488, "o", "\u001b[?2004h> "]
[305.525577, "o", "PYEOF\r\n\u001b[?2004l\r"]
