[187.446909, "o", "def map(  # noqa: A001\r\n    step_id: str,\r\n    up: Stream[X],\r\n    mapper: Callable[[X], Y],\r\n) -> Stream[Y]:\r\n    \"\"\"Transform items one-by-one.\r\n\r\n    It is commonly used for:\r\n\r\n    - Serialization and deserialization.\r\n\r\n    - Selection of fields.\r\n\r\n    ```{testcode}\r\n    import bytewax.operators as op\r\n    from bytewax.testing import TestingSource\r\n    from bytewax.dataflow import Dataflow\r\n\r\n    flow = Dataflow(\"map_eg\")\r\n    s = op.input(\"inp\", flow, TestingSource(range(3)))\r\n\r\n    def add_one(item):\r\n        return item + 10\r\n\r\n"]
[187.446976, "o", "    s = op.map(\"add_one\", s, add_one)\r\n    _ = op.inspect(\"out\", s)\r\n    ```\r\n\r\n    ```{testcode}\r\n    :hide:\r\n\r\n    from bytewax.testing import run_main\r\n\r\n    run_main(flow)\r\n    ```\r\n\r\n    ```{testoutput}\r\n    map_eg.out: 10\r\n    map_eg.out: 11\r\n    map_eg.out: 12\r\n    ```\r\n\r\n    :arg step_id: Unique ID.\r\n\r\n    :arg up: Stream.\r\n\r\n    :arg mapper: Called on each item. Each return value is emitted\r\n        downstream.\r\n\r\n    :returns: A stream of items returned from the mapper.\r\n\r\n    \"\"\"\r\n\r\n    def shim_mapper(xs: List[X]) -> Iterable[Y]:\r\n        return (mapper(x) for x in xs)\r\n\r\n    return flat_map_batch(\"flat_map_batch\", up, shim_mapper)\r\n\r\n\r\n@operator\r\ndef map_value(\r\n    step_id: str, up: KeyedStream[V], mapper: Callable[[V], W]\r\n) -> KeyedStream[W]:\r\n"]
[187.447232, "o", "\u001b[?2004hroot@7f555f06-22fe-4fd0-95e4-d30ab2919f63:/home/user/bytewax_recovery# "]
[202.815212, "i", "cat > /home/user/bytewax_recovery/dataflow.py << 'PYEOF'\n\"\"\"Bytewax dataflow that maintains running maximum per key with recovery.\"\"\"\n\nimport csv\nfrom pathlib import Path\nfrom typing import List, Optional\n\nfrom bytewax.connectors.files import FileSink\nfrom bytewax.dataflow import Dataflow\nfrom bytewax.inputs import FixedPartitionedSource, StatefulSourcePartition\nimport bytewax.operators as op\n\n\nclass _CsvPartition(StatefulSourcePartition[dict, int]):\n    def __init__(self, path: Path, resume_state: Optional[int]):\n        self._path = path\n        self._f = open(path, \"rt\", newline=\"\")\n        self._reader = csv.DictReader(self._f)\n        self._consumed = 0\n        if resume_state is not None:\n            for _ in range(resume_state):\n                try:\n                    next(self._reader)\n                    self._consumed += 1\n                except StopIteration:\n                    break\n\n    def next_batch(self) -> List[dict]:\n        batch = []\n        try:\n            while True:\n                row = next(self._reader)\n                batch.append(row)\n        except StopIteration:\n            pass\n        self._consumed += len(batch)\n        return batch\n\n    def snapshot(self) -> int:\n        return self._consumed\n\n    def close(self) -> None:\n        try:\n            self._f.close()\n        except Exception:\n            pass\n\n\nclass CsvSource(FixedPartitionedSource[dict, int]):\n    \"\"\"CSV file source. The partition key is the file path, so a different\n    input file across resumes is naturally handled.\"\"\"\n\n    def __init__(self, path):\n        self._path = Path(path)\n\n    def list_parts(self) -> List[str]:\n        if self._path.exists():\n            return [str(self._path)]\n        return []\n\n    def build_part(self, step_id: str, for_part: str, resume_state: Optional[int]):\n        return _CsvPartition(Path(for_part), resume_state)\n\n\ndef _running_max(state, item):\n    value = int(item[\"value\"])\n    if state is None:\n        new_state = value\n    elif state >= value:\n        new_state = state\n    else:\n        new_state = value\n    return (new_state, new_state)\n\n\ndef build_flow(input_file: str, output_file: str) -> Dataflow:\n    flow = Dataflow(\"running_max_recovery\")\n    inp = CsvSource(input_file)\n    s = op.input(\"in\", flow, inp)\n    keyed = op.key_on(\"key\", s, lambda item: item[\"key\"])\n    maxed = op.stateful_map(\"running_max\", keyed, _running_max)\n    formatted = op.map_value(\"format\", maxed, lambda v: f\"{v}\")\n\n    def to_pair(kv):\n        return f\"{kv[0]},{kv[1]}\"\n\n    paired = op.map(\"pair\", formatted, to_pair)\n    op.output(\"out\", paired, FileSink(Path(output_file)))\n    return flow\nPYEOF\n"]
