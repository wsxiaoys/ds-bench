[537.611492, "i", "rm -rf /tmp/rec1 /tmp/test_bytewax/output1.csv && bash /home/user/bytewax_recovery/run.sh /tmp/test_bytewax/input1.csv /tmp/test_bytewax/output1.csv /tmp/rec1 2>&1 | tail -20\necho \"=== output1.csv ===\"\ncat /tmp/test_bytewax/output1.csv\n"]
[537.612759, "o", "rm -rf /tmp/rec1 /tmp/test_bytewax/output1.csv && bash /home/user/bytewax_recovery/run.sh /tmp/test_bytewax/input1.csv /tmp/test_bytewax/output1.csv /tmp/rec1 2>&1 | tail -20\r\n\u001b[?2004l\r"]
