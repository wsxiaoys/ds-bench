[461.304779, "o", "drwxr-xr-x 2 root root  77 Jul  3 14:09 \u001b[0m\u001b[01;34m.\u001b[0m\r\ndrwxrwxrwt 1 root root 170 Jul  3 14:09 \u001b[30;42m..\u001b[0m\r\n-rw-r--r-- 1 root root  33 Jul  3 14:07 input1.csv\r\n-rw-r--r-- 1 root root  24 Jul  3 14:07 input2.csv\r\n-rw-r--r-- 1 root root  13 Jul  3 14:09 output1.csv\r\n"]
[461.305009, "o", "\u001b[?2004hroot@7f555f06-22fe-4fd0-95e4-d30ab2919f63:/tmp/test_bytewax# "]
