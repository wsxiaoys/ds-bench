[536.736393, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[536.736586, "o", "def _running_max(state, item):\r\n\u001b[?2004l\r"]
[536.736646, "o", "\u001b[?2004h> "]
[536.736837, "o", "    value = int(item[\"value\"])\r\n\u001b[?2004l\r"]
[536.736898, "o", "\u001b[?2004h> "]
[536.73704, "o", "    if state is None:\r\n\u001b[?2004l\r"]
[536.737103, "o", "\u001b[?2004h> "]
[536.737252, "o", "        new_state = value\r\n\u001b[?2004l\r"]
[536.737315, "o", "\u001b[?2004h> "]
[536.737475, "o", "    elif state >= value:\r\n\u001b[?2004l\r"]
[536.737538, "o", "\u001b[?2004h> "]
[536.737694, "o", "        new_state = state\r\n\u001b[?2004l\r"]
[536.737752, "o", "\u001b[?2004h> "]
[536.73782, "o", "    else:\r\n\u001b[?2004l\r"]
[536.737909, "o", "\u001b[?2004h> "]
[536.738028, "o", "        new_state = value\r\n\u001b[?2004l\r\u001b[?2004h"]
[536.738108, "o", "> "]
[536.738275, "o", "    return (new_state, new_state)\r\n\u001b[?2004l\r"]
[536.738361, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[536.738442, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[536.738828, "o", "def build_flow(input_file: str, output_file: str) -> Dataflow:\r\n\u001b[?2004l\r"]
[536.738905, "o", "\u001b[?2004h> "]
[536.739137, "o", "    flow = Dataflow(\"running_max_recovery\")\r\n\u001b[?2004l\r"]
[536.73921, "o", "\u001b[?2004h> "]
[536.73956, "o", "    inp = CsvSource(input_file)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[536.739654, "o", "    s = op.input(\"in\", flow, inp)\r\n\u001b[?2004l\r\u001b[?2004h"]
[536.739744, "o", "> "]
[536.740027, "o", "    keyed = op.key_on(\"key\", s, lambda item: item[\"key\"])\r\n\u001b[?2004l\r"]
[536.740099, "o", "\u001b[?2004h> "]
[536.740469, "o", "    maxed = op.stateful_map(\"running_max\", keyed, _running_max)\r\n\u001b[?2004l\r"]
[536.740531, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[536.740591, "o", "> "]
[536.741016, "o", "    # FileSink receives (key, value) tuples; format into \"key,value\" strings.\r\n\u001b[?2004l\r"]
[536.741077, "o", "\u001b[?2004h> "]
[536.741468, "o", "    formatted = op.map_value(\"format\", maxed, lambda v: f\",{v}\")\r\n\u001b[?2004l\r"]
[536.741529, "o", "\u001b[?2004h> "]
[536.741885, "o", "    op.output(\"out\", formatted, FileSink(Path(output_file)))\r\n\u001b[?2004l\r"]
[536.741948, "o", "\u001b[?2004h> "]
