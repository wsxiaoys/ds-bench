[579.240852, "o", "\u001b[?2004h> "]
[579.240882, "o", "    else:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[579.240954, "o", "        new_state = value\r\n\u001b[?2004l\r"]
[579.240983, "o", "\u001b[?2004h> "]
[579.241058, "o", "    return (new_state, new_state)\r\n\u001b[?2004l\r"]
[579.241089, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[579.24112, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[579.241283, "o", "def build_flow(input_file: str, output_file: str) -> Dataflow:\r\n\u001b[?2004l\r\u001b[?2004h"]
[579.241314, "o", "> "]
[579.241416, "o", "    flow = Dataflow(\"running_max_recovery\")\r\n\u001b[?2004l\r\u001b[?2004h"]
[579.241447, "o", "> "]
[579.241512, "o", "    inp = CsvSource(input_file)\r\n\u001b[?2004l\r"]
[579.241542, "o", "\u001b[?2004h> "]
[579.241617, "o", "    s = op.input(\"in\", flow, inp)\r\n\u001b[?2004l\r"]
[579.241647, "o", "\u001b[?2004h> "]
[579.241778, "o", "    keyed = op.key_on(\"key\", s, lambda item: item[\"key\"])\r\n\u001b[?2004l\r"]
[579.241809, "o", "\u001b[?2004h> "]
[579.241953, "o", "    maxed = op.stateful_map(\"running_max\", keyed, _running_max)\r\n\u001b[?2004l\r"]
[579.241984, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[579.242013, "o", "> "]
[579.242175, "o", "    # FileSink uses key for routing only; the value is what gets written.\r\n\u001b[?2004l\r"]
[579.242206, "o", "\u001b[?2004h> "]
[579.242362, "o", "    # Format \"key,value\" so the file sink writes the full record.\r\n\u001b[?2004l\r"]
[579.242392, "o", "\u001b[?2004h> "]
[579.24244, "o", "    def to_record(kv):\r\n\u001b[?2004l\r"]
[579.242469, "o", "\u001b[?2004h> "]
[579.242524, "o", "        key, value = kv\r\n\u001b[?2004l\r"]
[579.242553, "o", "\u001b[?2004h> "]
[579.242621, "o", "        return f\"{key},{value}\"\r\n\u001b[?2004l\r"]
[579.242652, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[579.242683, "o", "\u001b[?2004h> "]
[579.242794, "o", "    records = op.map(\"record\", maxed, to_record)\r\n\u001b[?2004l\r"]
[579.242824, "o", "\u001b[?2004h> "]
[579.242966, "o", "    op.output(\"out\", records, FileSink(Path(output_file)))\r\n\u001b[?2004l\r\u001b[?2004h"]
[579.242997, "o", "> "]
[579.243027, "o", "    return flow\r\n\u001b[?2004l\r\u001b[?2004h"]
[579.243057, "o", "> PYEOF\r\n\u001b[?2004l\r"]
[579.244272, "o", "\u001b[?2004hroot@7f555f06-22fe-4fd0-95e4-d30ab2919f63:/tmp/test_bytewax# "]
