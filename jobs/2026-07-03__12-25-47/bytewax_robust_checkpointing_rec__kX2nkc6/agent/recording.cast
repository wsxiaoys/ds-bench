[305.520427, "o", "        try:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[305.520501, "o", "            self._f.close()\r\n\u001b[?2004l\r"]
[305.520552, "o", "\u001b[?2004h> "]
[305.520595, "o", "        except Exception:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[305.520648, "o", "            pass\r\n\u001b[?2004l\r"]
[305.520694, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
