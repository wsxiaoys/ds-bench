[164.225703, "i", "cat > /home/user/bytewax_recovery/dataflow.py << 'PYEOF'\n\"\"\"Bytewax dataflow that maintains running maximum per key with recovery.\"\"\"\n\nimport os\nimport sys\nfrom pathlib import Path\nfrom typing import List, Optional\n\nfrom bytewax.connectors.files import FileSink\nfrom bytewax.dataflow import Dataflow\nfrom bytewax.inputs import FixedPartitionedSource, StatefulSourcePartition\nfrom bytewax.operators import key_on, stateful_map, output\n\n\nclass _CsvPartition(StatefulSourcePartition[dict, int]):\n    def __init__(self, path: Path, resume_state: Optional[int]):\n        self._path = path\n        self._f = open(path, \"rt\", newline=\"\")\n        import csv\n\n        self._reader = csv.DictReader(self._f)\n        self._consumed = 0\n        if resume_state is not None:\n            # Skip already-consumed rows. DictReader does not support direct\n            # seek by line number cleanly, so re-read and skip.\n            for _ in range(resume_state):\n                try:\n                    next(self._reader)\n                except StopIteration:\n                    break\n                self._consumed += 1\n\n    def next_batch(self) -> List[dict]:\n        batch = []\n        try:\n            while True:\n                row = next(self._reader)\n                batch.append(row)\n        except StopIteration:\n            pass\n        self._consumed += len(batch)\n        return batch\n\n    def snapshot(self) -> int:\n        return self._consumed\n\n    def close(self) -> None:\n        try:\n            self._f.close()\n        except Exception:\n            pass\n\n\nclass CsvSource(FixedPartitionedSource[dict, int]):\n    \"\"\"A simple CSV source that allows the path to differ across resumes.\n\n    The partition key includes the file path so that a different input file\n    on resume is treated as a fresh partition (no stale resume_state is\n    applied).\n    \"\"\"\n\n    def __init__(self, path):\n        self._path = Path(path)\n\n    def list_parts(self):\n        if self._path.exists():\n            return [str(self._path)]\n        return []\n\n    def build_part(self, step_id: str, for_part: str, resume_state: Optional[int]):\n        return _CsvPartition(Path(for_part), resume_state)\n\n\ndef _running_max(state, item):\n    value = int(item[\"value\"])\n    if state is None:\n        new_state = value\n    else:\n        new_state = state if state >= value else value\n    return (new_state, new_state)\n\n\ndef build_flow(input_file: str, output_file: str) -> Dataflow:\n    flow = Dataflow(\"running_max_recovery\")\n    inp = CsvSource(input_file)\n    s = key_on(\"key\", flow, inp, lambda item: item[\"key\"])\n    s = stateful_map(\"running_max\", s, _running_max)\n\n    formatted = s.map(lambda kv: f\"{kv[0]},{kv[1]}\")\n    output(\"output\", formatted, FileSink(Path(output_file)))\n    return flow\nPYEOF\n"]
