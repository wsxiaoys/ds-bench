[305.517566, "o", "import bytewax.operators as op\r\n\u001b[?2004l\r\u001b[?2004h"]
[305.517614, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h"]
[305.517674, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[305.517761, "o", "class _CsvPartition(StatefulSourcePartition[dict, int]):\r\n\u001b[?2004l\r"]
[305.517816, "o", "\u001b[?2004h> "]
[305.517936, "o", "    def __init__(self, path: Path, resume_state: Optional[int]):\r\n\u001b[?2004l\r\u001b[?2004h"]
[305.517988, "o", "> "]
[305.51804, "o", "        self._path = path\r\n\u001b[?2004l\r"]
[305.518092, "o", "\u001b[?2004h> "]
[305.51815, "o", "        self._f = open(path, \"rt\", newline=\"\")\r\n\u001b[?2004l\r"]
[305.518197, "o", "\u001b[?2004h> "]
[305.518287, "o", "        self._reader = csv.DictReader(self._f)\r\n\u001b[?2004l\r\u001b[?2004h"]
[305.518343, "o", "> "]
[305.518391, "o", "        self._consumed = 0\r\n\u001b[?2004l\r\u001b[?2004h> "]
[305.518489, "o", "        if resume_state is not None:\r\n\u001b[?2004l\r\u001b[?2004h"]
[305.518532, "o", "> "]
[305.518608, "o", "            for _ in range(resume_state):\r\n\u001b[?2004l\r\u001b[?2004h"]
[305.518647, "o", "> "]
[305.518687, "o", "                try:\r\n\u001b[?2004l\r\u001b[?2004h"]
[305.518729, "o", "> "]
[305.518795, "o", "                    next(self._reader)\r\n\u001b[?2004l\r"]
[305.518842, "o", "\u001b[?2004h> "]
[305.518913, "o", "                    self._consumed += 1\r\n\u001b[?2004l\r\u001b[?2004h"]
[305.518941, "o", "> "]
[305.519026, "o", "                except StopIteration:\r\n\u001b[?2004l\r\u001b[?2004h"]
[305.519049, "o", "> "]
[305.519111, "o", "                    break\r\n\u001b[?2004l\r"]
[305.519154, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[305.519208, "o", "\u001b[?2004h> "]
[305.519251, "o", "    def next_batch(self) -> List[dict]:\r\n\u001b[?2004l\r"]
[305.519304, "o", "\u001b[?2004h> "]
[305.519365, "o", "        batch = []\r\n\u001b[?2004l\r\u001b[?2004h"]
[305.519422, "o", ">         try:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[305.519465, "o", "            while True:\r\n\u001b[?2004l\r\u001b[?2004h"]
[305.519517, "o", "> "]
[305.519579, "o", "                row = next(self._reader)\r\n\u001b[?2004l\r"]
[305.519621, "o", "\u001b[?2004h> "]
[305.519684, "o", "                batch.append(row)\r\n\u001b[?2004l\r"]
[305.519724, "o", "\u001b[?2004h> "]
[305.519779, "o", "        except StopIteration:\r\n\u001b[?2004l\r"]
[305.519834, "o", "\u001b[?2004h> "]
[305.519882, "o", "            pass\r\n\u001b[?2004l\r\u001b[?2004h> "]
[305.519952, "o", "        self._consumed += len(batch)\r\n\u001b[?2004l\r\u001b[?2004h"]
[305.520006, "o", "> "]
[305.520055, "o", "        return batch\r\n\u001b[?2004l\r\u001b[?2004h"]
[305.520082, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[305.520148, "o", "    def snapshot(self) -> int:\r\n\u001b[?2004l\r\u001b[?2004h"]
[305.520187, "o", "> "]
[305.520238, "o", "        return self._consumed\r\n\u001b[?2004l\r"]
[305.520279, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[305.520326, "o", "\u001b[?2004h> "]
