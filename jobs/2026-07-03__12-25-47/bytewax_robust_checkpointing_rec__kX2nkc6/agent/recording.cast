[537.756347, "o", ",10\r\n,20\r\n,5\r\n,15\r\n,7\r\n"]
[537.756646, "o", "\u001b[?2004hroot@7f555f06-22fe-4fd0-95e4-d30ab2919f63:/tmp/test_bytewax# "]
[560.136802, "i", "sed -n '325,360p' /usr/local/lib/python3.12/dist-packages/bytewax/connectors/files.py\n"]
[560.137555, "o", "sed -n '325,360p' /usr/local/lib/python3.12/dist-packages/bytewax/connectors/files.py\r\n\u001b[?2004l\r"]
[560.139799, "o", "class _FileSinkPartition(StatefulSinkPartition[str, int]):\r\n    def __init__(self, path: Path, resume_state: Optional[int], end: str):\r\n        resume_offset = 0 if resume_state is None else resume_state\r\n        self._f = open(path, \"at\")\r\n        self._f.seek(resume_offset)\r\n        self._f.truncate()\r\n        self._end = end\r\n\r\n"]
[560.139854, "o", "    @override\r\n    def write_batch(self, values: List[str]) -> None:\r\n        for value in values:\r\n            self._f.write(value)\r\n            self._f.write(self._end)\r\n        self._f.flush()\r\n        os.fsync(self._f.fileno())\r\n\r\n    @override\r\n    def snapshot(self) -> int:\r\n        return self._f.tell()\r\n\r\n    @override\r\n    def close(self) -> None:\r\n        self._f.close()\r\n\r\n\r\n"]
[560.139914, "o", "class DirSink(FixedPartitionedSink[str, int]):\r\n    \"\"\"Write to a set of files in a filesystem directory line-by-line.\r\n\r\n    Items consumed from the dataflow must look like two-tuples of\r\n    `(key, value)`, where the value must look like a string. Use a\r\n    proceeding map step to do custom formatting.\r\n\r\n    The directory must exist and contain identical data on all\r\n    workers, so either run on a single machine or use a shared mount.\r\n\r\n    Individual files are the unit of parallelism.\r\n"]
[560.140378, "o", "\u001b[?2004hroot@7f555f06-22fe-4fd0-95e4-d30ab2919f63:/tmp/test_bytewax# "]
[579.233456, "i", "cat > /home/user/bytewax_recovery/dataflow.py << 'PYEOF'\n\"\"\"Bytewax dataflow that maintains running maximum per key with recovery.\"\"\"\n\nimport csv\nfrom pathlib import Path\nfrom typing import List, Optional\n\nfrom bytewax.connectors.files import FileSink\nfrom bytewax.dataflow import Dataflow\nfrom bytewax.inputs import FixedPartitionedSource, StatefulSourcePartition\nimport bytewax.operators as op\n\n\nclass _CsvPartition(StatefulSourcePartition[dict, int]):\n    def __init__(self, path: Path, resume_state: Optional[int]):\n        self._path = path\n        self._f = open(path, \"rt\", newline=\"\")\n        self._reader = csv.DictReader(self._f)\n        self._consumed = 0\n        self._exhausted = False\n        if resume_state is not None:\n            for _ in range(resume_state):\n                try:\n                    next(self._reader)\n                    self._consumed += 1\n                except StopIteration:\n                    self._exhausted = True\n                    break\n\n    def next_batch(self) -> List[dict]:\n        if self._exhausted:\n            raise StopIteration()\n        batch = []\n        try:\n            while True:\n                row = next(self._reader)\n                batch.append(row)\n        except StopIteration:\n            self._exhausted = True\n        self._consumed += len(batch)\n        if not batch:\n            raise StopIteration()\n        return batch\n\n    def snapshot(self) -> int:\n        return self._consumed\n\n    def close(self) -> None:\n        try:\n            self._f.close()\n        except Exception:\n            pass\n\n\nclass CsvSource(FixedPartitionedSource[dict, int]):\n    \"\"\"CSV file source. The partition key is the file path, so a different\n    input file across resumes is naturally handled.\"\"\"\n\n    def __init__(self, path):\n        self._path = Path(path)\n\n    def list_parts(self) -> List[str]:\n        if self._path.exists():\n            return [str(self._path)]\n        return []\n\n    def build_part(self, step_id: str, for_part: str, resume_state: Optional[int]):\n        return _CsvPartition(Path(for_part), resume_state)\n\n\ndef _running_max(state, item):\n    value = int(item[\"value\"])\n    if state is None:\n        new_state = value\n    elif state >= value:\n        new_state = state\n    else:\n        new_state = value\n    return (new_state, new_state)\n\n\ndef build_flow(input_file: str, output_file: str) -> Dataflow:\n    flow = Dataflow(\"running_max_recovery\")\n    inp = CsvSource(input_file)\n    s = op.input(\"in\", flow, inp)\n    keyed = op.key_on(\"key\", s, lambda item: item[\"key\"])\n    maxed = op.stateful_map(\"running_max\", keyed, _running_max)\n\n    # FileSink uses key for routing only; the value is what gets written.\n    # Format \"key,value\" so the file sink writes the full record.\n    def to_record(kv):\n        key, value = kv\n        return f\"{key},{value}\"\n\n    records = op.map(\"record\", maxed, to_record)\n    op.output(\"out\", records, FileSink(Path(output_file)))\n    return flow\nPYEOF\n"]
[579.233734, "o", "cat > /home/user/bytewax_recovery/dataflow.py << 'PYEOF'\r\n\u001b[?2004l\r"]
