[116.71008, "i", "python3 << 'PYEOF'\nimport json\nimport numpy as np\n\n# Check JSON\nd = json.load(open('/home/user/spec_meta.json'))\nrequired_keys = {'n_frames', 'hop_length', 'sample_rate', 'stft_freqs', 'cqt_freqs', 'vqt_freqs', 'n_fft', 'cqt_n_bins', 'cqt_bins_per_octave', 'vqt_n_bins', 'vqt_bins_per_octave'}\nactual_keys = set(d.keys())\nprint('JSON has exactly required keys:', required_keys == actual_keys)\nprint('Missing:', required_keys - actual_keys)\nprint('Extra:', actual_keys - required_keys)\n\n# Check all values are JSON-serializable scalars/lists\nfor k, v in d.items():\n    if isinstance(v, list):\n        print(f'  {k}: list of {len(v)} numbers, first={v[0]}, last={v[-1]}')\n    else:\n        print(f'  {k}: {type(v).__name__} = {v}')\n\n# Check npz\narr = np.load('/home/user/spec_stack.npz')\nprint('NPZ keys:', list(arr.keys()))\nprint('stft_db:', arr['stft_db'].shape, 'min:', arr['stft_db'].min(), 'max:', arr['stft_db'].max())\nprint('cqt_db:', arr['cqt_db'].shape, 'min:', arr['cqt_db'].min(), 'max:', arr['cqt_db'].max())\nprint('vqt_db:', arr['vqt_db'].shape, 'min:', arr['vqt_db'].min(), 'max:', arr['vqt_db'].max())\nprint('All same n_frames:', arr['stft_db'].shape[1] == arr['cqt_db'].shape[1] == arr['vqt_db'].shape[1])\nprint('hop_length power of 2:', (d['hop_length'] & (d['hop_length']-1)) == 0)\nprint('512 / 64 =', 512/64, 'is integer:', 512 % 64 == 0)\nPYEOF\n"]
