[?2004hroot@b1f4b31f-281b-4cd7-b786-6e4b4228549e:/home/user/myproject# cat > /home/user/myproject/setup.sh << 'SCRIPT_EOF'
[?2004l[?2004h> #!/usr/bin/env bash
[?2004l[?2004h> #
[?2004l[?2004h> # setup.sh - Idempotent PocketBase v0.31.0 provisioning script.
[?2004l[?2004h> #
[?2004l[?2004h> # - Applies DB migrations (defining the `tasks` collection)
[?2004l[?2004h> # - Creates a single superuser (admin@example.com)
[?2004l[?2004h> # - Starts the PocketBase server in the background on the default port
[?2004l[?2004h> # - Seeds 5 predefined records into the `tasks` collection via the REST API
[?2004l[?2004h> #
[?2004l[?2004h> # The script is safe to run multiple times: it will not create duplicate
[?2004l[?2004h> # superusers, duplicate tasks, or error if the server is already running.
[?2004l[?2004h> 
[?2004l[?2004h> set -u
[?2004l[?2004h> 
[?2004l[?2004h> PROJECT_DIR="/home/user/myproject"
[?2004l[?2004h> PB_BIN="${PROJECT_DIR}/pocketbase"
[?2004l[?2004h> MIGRATIONS_DIR="${PROJECT_DIR}/pb_migrations"
[?2004l[?2004h> PB_DATA_DIR="${PROJECT_DIR}/pb_data"
[?2004l[?2004h> PB_LOG="${PROJECT_DIR}/pocketbase.log"
[?2004l[?2004h> PB_PIDFILE="${PROJECT_DIR}/pocketbase.pid"
[?2004l[?2004h> PB_URL="http://127.0.0.1:8090"
[?2004l[?2004h> HEALTH_URL="${PB_URL}/api/health"
[?2004l[?2004h> 
[?2004l[?2004h> SUPERUSER_EMAIL="admin@example.com"
[?2004l[?2004h> SUPERUSER_PASSWORD='Adm1n_passw0rd!'
[?2004l[?2004h> 
[?2004l[?2004h> TASK_TITLES=(
[?2004l[?2004h>   "Buy groceries"
[?2004l[?2004h>   "Walk the dog"
[?2004l[?2004h>   "Read a book"
[?2004l[?2004h>   "Write weekly report"
[?2004l[?2004h>   "Call mom"
[?2004l[?2004h> )
[?2004l[?2004h> 
[?2004l[?2004h> log() {
[?2004l[?2004h>   printf '[setup.sh] %s\n' "$*"
[?2004l[?2004h> }
[?2004l[?2004h> 
[?2004l[?2004h> # --- 1. Apply migrations (idempotent) -------------------------------------
[?2004l[?2004h> log "Applying migrations from ${MIGRATIONS_DIR} (if any)..."
[?2004l[?2004h> "${PB_BIN}" migrate up --migrationsDir="${MIGRATIONS_DIR}" >/dev/null 2>&1 || true
[?2004l[?2004h> 
[?2004l[?2004h> # --- 2. Ensure the superuser exists (idempotent upsert) --------------------
[?2004l[?2004h> log "Ensuring superuser ${SUPERUSER_EMAIL} exists..."
[?2004l[?2004h> "${PB_BIN}" superuser upsert "${SUPERUSER_EMAIL}" "${SUPERUSER_PASSWORD}" >/dev/null 2>&1 || true
[?2004l[?2004h> 
[?2004l[?2004h> # --- 3. Make sure the server is running in the background ------------------
[?2004l[?2004h> server_is_up() {
[?2004l[?2004h>   curl -s -o /dev/null -w '%{http_code}' --max-time 2 "${HEALTH_URL}" 2>/dev/null | grep -q '^200$'
[?2004l[?2004h> }
[?2004l[?2004h> 
[?2004l[?2004h> start_server() {
[?2004l[?2004h>   log "Starting PocketBase server in the background..."
[?2004l[?2004h>   cd "${PROJECT_DIR}"
[?2004l[?2004h>   nohup "${PB_BIN}" serve >>"${PB_LOG}" 2>&1 &
[?2004l[?2004h>   echo $! >"${PB_PIDFILE}"
[?2004l[?2004h>   disown 2>/dev/null || true
[?2004l[?2004h> }
[?2004l[?2004h> 
[?2004l[?2004h> # If a previous PID is recorded but the process is gone, clean up.
[?2004l[?2004h> if [[ -f "${PB_PIDFILE}" ]]; then
[?2004l[?2004h>   existing_pid="$(cat "${PB_PIDFILE}" 2>/dev/null || true)"
[?2004l[?2004h>   if [[ -n "${existing_pid}" ]] && kill -0 "${existing_pid}" 2>/dev/null; then
[?2004l[?2004h>     log "PocketBase already running (pid=${existing_pid})."
[?2004l[?2004h>   else
[?2004l[?2004h>     rm -f "${PB_PIDFILE}"
[?2004l[?2004h>   fi
[?2004l[?2004h> fi
[?2004l[?2004h> 
[?2004l[?2004h> # Check if server is responding. If not, attempt to start it.
[?2004l[?2004h> if server_is_up; then
[?2004l[?2004h>   log "PocketBase health check OK at ${HEALTH_URL}"
[?2004l[?2004h> else
[?2004l[?2004h>   start_server
[?2004l[?2004h>   # Wait for the server to become responsive (max ~15 seconds).
[?2004l[?2004h>   for _ in $(seq 1 30); do
[?2004l[?2004h>     if server_is_up; then
[?2004l[?2004h>       log "PocketBase is up at ${PB_URL}"
[?2004l[?2004h>       break
[?2004l[?2004h>     fi
[?2004l[?2004h>     sleep 0.5
[?2004l[?2004h>   done
[?2004l[?2004h>   if ! server_is_up; then
[?2004l[?2004h>     log "ERROR: PocketBase did not become healthy in time. Check ${PB_LOG}."
[?2004l[?2004h>     # Don't fail the script — keep it idempotent / non-fatal here.
[?2004l[?2004h>   fi
[?2004l[?2004h> fi
[?2004l[?2004h> 
[?2004l[?2004h> # --- 4. Authenticate and seed the tasks collection --------------------------
[?2004l[?2004h> log "Authenticating as ${SUPERUSER_EMAIL}..."
[?2004l[?2004h> auth_response="$(curl -s -X POST "${PB_URL}/api/collections/_superusers/auth-with-password" \
[?2004l[?2004h>   -H 'Content-Type: application/json' \
[?2004l[?2004h>   -d "{\"identity\":\"${SUPERUSER_EMAIL}\",\"password\":\"${SUPERUSER_PASSWORD}\"}")"
[?2004l[?2004h> 
[?2004l[?2004h> TOKEN="$(printf '%s' "${auth_response}" | jq -r '.token // empty' 2>/dev/null || true)"
[?2004l[?2004h> 
[?2004l[?2004h> if [[ -z "${TOKEN}" || "${TOKEN}" == "null" ]]; then
[?2004l[?2004h>   log "ERROR: Failed to obtain auth token. Response: ${auth_response}"
[?2004l[?2004h>   exit 0
[?2004l[?2004h> fi
[?2004l[?2004h> 
[?2004l[?2004h> # Fetch existing task titles to avoid creating duplicates.
[?2004l[?2004h> existing_titles="$(curl -s \
[?2004l[?2004h>   -H "Authorization: ${TOKEN}" \
[?2004l[?2004h>   "${PB_URL}/api/collections/tasks/records?perPage=500" \
[?2004l[?2004h>   | jq -r '.items[].title // empty' 2>/dev/null || true)"
[?2004l[?2004h> 
[?2004l[?2004h> seed_one() {
[?2004l[?2004h>   local title="$1"
[?2004l[?2004h>   # Skip if already present (exact, case-sensitive match).
[?2004l[?2004h>   if printf '%s\n' "${existing_titles}" | grep -Fxq "${title}"; then
[?2004l[?2004h>     log "Task already present, skipping: ${title}"
[?2004l[?2004h>     return 0
[?2004l[?2004h>   fi
[?2004l[?2004h>   local payload
[?2004l[?2004h>   payload="$(jq -n --arg t "${title}" '{title:$t}')"
[?2004l[?2004h>   local resp
[?2004l[?2004h>   resp="$(curl -s -X POST "${PB_URL}/api/collections/tasks/records" \
[?2004l[?2004h>     -H "Authorization: ${TOKEN}" \
[?2004l[?2004h>     -H 'Content-Type: application/json' \
[?2004l[?2004h>     -d "${payload}")"
[?2004l[?2004h>   if printf '%s' "${resp}" | jq -e '.id' >/dev/null 2>&1; then
[?2004l[?2004h>     log "Seeded task: ${title}"
[?2004l[?2004h>   else
[?2004l[?2004h>     log "ERROR seeding task '${title}': ${resp}"
[?2004l[?2004h>   fi
[?2004l[?2004h> }
[?2004l[?2004h> 
[?2004l[?2004h> log "Seeding tasks collection..."
[?2004l[?2004h> for t in "${TASK_TITLES[@]}"; do
[?2004l[?2004h>   seed_one "${t}"
[?2004l[?2004h> done
[?2004l[?2004h> 
[?2004l[?2004h> log "Done."
[?2004l[?2004h> exit 0
