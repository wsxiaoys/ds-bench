[11.144837, "o", "pocketbase version 0.31.0\r\n"]
[11.146147, "o", "\u001b[?2004hroot@b1f4b31f-281b-4cd7-b786-6e4b4228549e:~# "]
[11.771362, "i", "/home/user/myproject/pocketbase --help\n"]
[11.77163, "o", "/home/user/myproject/pocketbase --help\r\n\u001b[?2004l\r"]
[11.77764, "o", "pocketbase CLI\r\n\r\n"]
[11.777739, "o", "Usage:\r\n  pocketbase [command]\r\n\r\nAvailable Commands:\r\n  migrate     Executes app DB migration scripts\r\n  serve       Starts the web server (default to 127.0.0.1:8090 if no domain is specified)\r\n  superuser   Manage superusers\r\n  update      Automatically updates the current app executable with the latest available version\r\n\r\nFlags:\r\n      --REDACTEDmigrate            enable/disable REDACTED migrations (default true)\r\n      --dev                    enable dev mode, aka. printing logs and sql statements to the console\r\n      --dir string             the PocketBase data directory (default \"/home/user/myproject/pb_data\")\r\n      --encryptionEnv string   the env variable whose value of 32 characters will be used \r\n                               as encryption key for the app settings (default none)\r\n  -h, --help                   help for pocketbase\r\n      --hooksDir string        the directory with the JS app hooks\r\n      --hooksPool int          the total prewarm goja.Runtime instances for the JS app hooks execution (default 15)\r\n      --hooksWatch             REDACTED restart the app on pb_hooks file change; it has no effect on Windows (default true)\r\n      --indexFallback          fallback the request to index.html on missing static path, e.g. when pretty urls are used with SPA (default true)\r\n      --migrationsDir string   the directory with the user defined migrations\r\n      --publicDir string       the directory to serve static files (default \"/home/user/myproject/pb_public\")\r\n      --queryTimeout int       the default SELECT queries timeout in seconds (default 30)\r\n  -v, --version                version for pocketbase\r\n\r\nUse \"pocketbase [command] --help\" for more information about a command.\r\n"]
[11.7785, "o", "\u001b[?2004hroot@b1f4b31f-281b-4cd7-b786-6e4b4228549e:~# "]
[14.875912, "i", "/home/user/myproject/pocketbase superuser --help\n"]
[14.876156, "o", "/home/user/myproject/pocketbase superuser --help\r\n\u001b[?2004l\r"]
[14.883106, "o", "Manage superusers\r\n\r\n"]
[14.883189, "o", "Usage:\r\n  pocketbase superuser [command]\r\n\r\nAvailable Commands:\r\n  create      Creates a new superuser\r\n  delete      Deletes an existing superuser\r\n  otp         Creates a new OTP for the specified superuser\r\n  update      Changes the password of a single superuser\r\n  upsert      Creates, or updates if email exists, a single superuser\r\n\r\nFlags:\r\n  -h, --help   help for superuser\r\n\r\nGlobal Flags:\r\n      --REDACTEDmigrate            enable/disable REDACTED migrations (default true)\r\n      --dev                    enable dev mode, aka. printing logs and sql statements to the console\r\n      --dir string             the PocketBase data directory (default \"/home/user/myproject/pb_data\")\r\n      --encryptionEnv string   the env variable whose value of 32 characters will be used \r\n                               as encryption key for the app settings (default none)\r\n      --hooksDir string        the directory with the JS app hooks\r\n      --hooksPool int          the total prewarm goja.Runtime instances for the JS app hooks execution (default 15)\r\n      --hooksWatch             REDACTED restart the app on pb_hooks file change; it has no effect on Windows (default true)\r\n      --indexFallback          fallback the request to index.html on missing static path, e.g. when pretty urls are used with SPA (default true)\r\n      --migrationsDir string   the directory with the user defined migrations\r\n      --publicDir string       the directory to serve static files (default \"/home/user/myproject/pb_public\")\r\n      --queryTimeout int       the default SELECT queries timeout in seconds (default 30)\r\n\r\nUse \"pocketbase superuser [command] --help\" for more information about a command.\r\n"]
[14.884246, "o", "\u001b[?2004hroot@b1f4b31f-281b-4cd7-b786-6e4b4228549e:~# "]
[15.376081, "i", "/home/user/myproject/pocketbase migrate --help\n"]
[15.376321, "o", "/home/user/myproject/pocketbase migrate --help\r\n\u001b[?2004l\r"]
[15.382785, "o", "Supported arguments are:\r\n- up            - runs all available migrations\r\n- down [number] - reverts the last [number] applied migrations\r\n- create name   - creates new blank migration template file\r\n- collections   - creates new migration file with snapshot of the local collections configuration\r\n- history-sync  - ensures that the _migrations history table doesn't have references to deleted migration files\r\n\r\n"]
[15.382858, "o", "Usage:\r\n  pocketbase migrate [flags]\r\n\r\nFlags:\r\n  -h, --help   help for migrate\r\n\r\nGlobal Flags:\r\n      --REDACTEDmigrate            enable/disable REDACTED migrations (default true)\r\n      --dev                    enable dev mode, aka. printing logs and sql statements to the console\r\n      --dir string             the PocketBase data directory (default \"/home/user/myproject/pb_data\")\r\n      --encryptionEnv string   the env variable whose value of 32 characters will be used \r\n                               as encryption key for the app settings (default none)\r\n      --hooksDir string        the directory with the JS app hooks\r\n      --hooksPool int          the total prewarm goja.Runtime instances for the JS app hooks execution (default 15)\r\n      --hooksWatch             REDACTED restart the app on pb_hooks file change; it has no effect on Windows (default true)\r\n      --indexFallback          fallback the request to index.html on missing static path, e.g. when pretty urls are used with SPA (default true)\r\n      --migrationsDir string   the directory with the user defined migrations\r\n      --publicDir string       the directory to serve static files (default \"/home/user/myproject/pb_public\")\r\n      --queryTimeout int       the default SELECT queries timeout in seconds (default 30)\r\n"]
