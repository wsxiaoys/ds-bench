[220.391366, "i", "cat > /home/user/myproject/setup.sh << 'SCRIPT_EOF'\n#!/usr/bin/env bash\n#\n# setup.sh - Idempotent PocketBase v0.31.0 provisioning script.\n#\n# - Applies DB migrations (defining the `tasks` collection)\n# - Creates a single superuser (admin@example.com)\n# - Starts the PocketBase server in the background on the default port\n# - Seeds 5 predefined records into the `tasks` collection via the REST API\n#\n# The script is safe to run multiple times: it will not create duplicate\n# superusers, duplicate tasks, or error if the server is already running.\n\nset -u\n\nPROJECT_DIR=\"/home/user/myproject\"\nPB_BIN=\"${PROJECT_DIR}/pocketbase\"\nMIGRATIONS_DIR=\"${PROJECT_DIR}/pb_migrations\"\nPB_DATA_DIR=\"${PROJECT_DIR}/pb_data\"\nPB_LOG=\"${PROJECT_DIR}/pocketbase.log\"\nPB_PIDFILE=\"${PROJECT_DIR}/pocketbase.pid\"\nPB_URL=\"http://127.0.0.1:8090\"\nHEALTH_URL=\"${PB_URL}/api/health\"\n\nSUPERUSER_EMAIL=\"admin@example.com\"\nSUPERUSER_PASSWORD='Adm1n_passw0rd!'\n\nTASK_TITLES=(\n  \"Buy groceries\"\n  \"Walk the dog\"\n  \"Read a book\"\n  \"Write weekly report\"\n  \"Call mom\"\n)\n\nlog() {\n  printf '[setup.sh] %s\\n' \"$*\"\n}\n\n# --- 1. Apply migrations (idempotent) -------------------------------------\nlog \"Applying migrations from ${MIGRATIONS_DIR} (if any)...\"\n\"${PB_BIN}\" migrate up --migrationsDir=\"${MIGRATIONS_DIR}\" >/dev/null 2>&1 || true\n\n# --- 2. Ensure the superuser exists (idempotent upsert) --------------------\nlog \"Ensuring superuser ${SUPERUSER_EMAIL} exists...\"\n\"${PB_BIN}\" superuser upsert \"${SUPERUSER_EMAIL}\" \"${SUPERUSER_PASSWORD}\" >/dev/null 2>&1 || true\n\n# --- 3. Make sure the server is running in the background ------------------\nserver_is_up() {\n  curl -s -o /dev/null -w '%{http_code}' --max-time 2 \"${HEALTH_URL}\" 2>/dev/null | grep -q '^200$'\n}\n\nstart_server() {\n  log \"Starting PocketBase server in the background...\"\n  cd \"${PROJECT_DIR}\"\n  nohup \"${PB_BIN}\" serve >>\"${PB_LOG}\" 2>&1 &\n  echo $! >\"${PB_PIDFILE}\"\n  disown 2>/dev/null || true\n}\n\n# If a previous PID is recorded but the process is gone, clean up.\nif [[ -f \"${PB_PIDFILE}\" ]]; then\n  existing_pid=\"$(cat \"${PB_PIDFILE}\" 2>/dev/null || true)\"\n  if [[ -n \"${existing_pid}\" ]] && kill -0 \"${existing_pid}\" 2>/dev/null; then\n    log \"PocketBase already running (pid=${existing_pid}).\"\n  else\n    rm -f \"${PB_PIDFILE}\"\n  fi\nfi\n\n# Check if server is responding. If not, attempt to start it.\nif server_is_up; then\n  log \"PocketBase health check OK at ${HEALTH_URL}\"\nelse\n  start_server\n  # Wait for the server to become responsive (max ~15 seconds).\n  for _ in $(seq 1 30); do\n    if server_is_up; then\n      log \"PocketBase is up at ${PB_URL}\"\n      break\n    fi\n    sleep 0.5\n  done\n  if ! server_is_up; then\n    log \"ERROR: PocketBase did not become healthy in time. Check ${PB_LOG}.\"\n    # Don't fail the script — keep it idempotent / non-fatal here.\n  fi\nfi\n\n# --- 4. Authenticate and seed the tasks collection --------------------------\nlog \"Authenticating as ${SUPERUSER_EMAIL}...\"\nauth_response=\"$(curl -s -X POST \"${PB_URL}/api/collections/_superusers/auth-with-password\" \\\n  -H 'Content-Type: application/json' \\\n  -d \"{\\\"identity\\\":\\\"${SUPERUSER_EMAIL}\\\",\\\"password\\\":\\\"${SUPERUSER_PASSWORD}\\\"}\")\"\n\nTOKEN=\"$(printf '%s' \"${auth_response}\" | jq -r '.token // empty' 2>/dev/null || true)\"\n\nif [[ -z \"${TOKEN}\" || \"${TOKEN}\" == \"null\" ]]; then\n  log \"ERROR: Failed to obtain auth token. Response: ${auth_response}\"\n  exit 0\nfi\n\n# Fetch existing task titles to avoid creating duplicates.\nexisting_titles=\"$(curl -s \\\n  -H \"Authorization: ${TOKEN}\" \\\n  \"${PB_URL}/api/collections/tasks/records?perPage=500\" \\\n  | jq -r '.items[].title // empty' 2>/dev/null || true)\"\n\nseed_one() {\n  local title=\"$1\"\n  # Skip if already present (exact, case-sensitive match).\n  if printf '%s\\n' \"${existing_titles}\" | grep -Fxq \"${title}\"; then\n    log \"Task already present, skipping: ${title}\"\n    return 0\n  fi\n  local payload\n  payload=\"$(jq -n --arg t \"${title}\" '{title:$t}')\"\n  local resp\n  resp=\"$(curl -s -X POST \"${PB_URL}/api/collections/tasks/records\" \\\n    -H \"Authorization: ${TOKEN}\" \\\n    -H 'Content-Type: application/json' \\\n    -d \"${payload}"]
[220.391493, "i", "\")\"\n  if printf '%s' \"${resp}\" | jq -e '.id' >/dev/null 2>&1; then\n    log \"Seeded task: ${title}\"\n  else\n    log \"ERROR seeding task '${title}': ${resp}\"\n  fi\n}\n\nlog \"Seeding tasks collection...\"\nfor t in \"${TASK_TITLES[@]}\"; do\n  seed_one \"${t}\"\ndone\n\nlog \"Done.\"\nexit 0\nSCRIPT_EOF\n"]
[220.391826, "o", "cat > /home/user/myproject/setup.sh << 'SCRIPT_EOF'\r\n\u001b[?2004l\r"]
[220.391887, "o", "\u001b[?2004h> "]
[220.391943, "o", "#!/usr/bin/env bash\r\n\u001b[?2004l\r\u001b[?2004h"]
[220.392057, "o", "> #\r\n\u001b[?2004l\r\u001b[?2004h"]
[220.393745, "o", "> # setup.sh - Idempotent PocketBase v0.31.0 provisioning script.\r\n\u001b[?2004l\r\u001b[?2004h> #\r\n\u001b[?2004l\r\u001b[?2004h> # - Applies DB migrations (defining the `tasks` collection)\r\n\u001b[?2004l\r\u001b[?2004h> # - Creates a single superuser (admin@example.com)\r\n\u001b[?2004l\r\u001b[?2004h> # - Starts the PocketBase server in the background on the default port\r\n\u001b[?2004l\r\u001b[?2004h> # - Seeds 5 predefined records into the `tasks` collection via the REST API\r\n\u001b[?2004l\r\u001b[?2004h> #\r\n\u001b[?2004l\r\u001b[?2004h> # The script is safe to run multiple times: it will not create duplicate\r\n\u001b[?2004l\r\u001b[?2004h> # superusers, duplicate tasks, or error if the server is already running.\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> set -u\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[220.39381, "o", "PROJECT_DIR=\"/home/user/myproject\"\r\n\u001b[?2004l\r\u001b[?2004h> "]
[220.393885, "o", "PB_BIN=\"${PROJECT_DIR}/pocketbase\"\r\n\u001b[?2004l\r"]
[220.393913, "o", "\u001b[?2004h> "]
[220.394035, "o", "MIGRATIONS_DIR=\"${PROJECT_DIR}/pb_migrations\"\r\n\u001b[?2004l\r\u001b[?2004h"]
[220.394068, "o", "> "]
[220.394169, "o", "PB_DATA_DIR=\"${PROJECT_DIR}/pb_data\"\r\n\u001b[?2004l\r"]
[220.394195, "o", "\u001b[?2004h> "]
[220.394319, "o", "PB_LOG=\"${PROJECT_DIR}/pocketbase.log\"\r\n\u001b[?2004l\r"]
[220.394346, "o", "\u001b[?2004h> "]
[220.394465, "o", "PB_PIDFILE=\"${PROJECT_DIR}/pocketbase.pid\"\r\n\u001b[?2004l\r"]
[220.394493, "o", "\u001b[?2004h> "]
[220.394586, "o", "PB_URL=\"http://127.0.0.1:8090\"\r\n\u001b[?2004l\r"]
[220.394622, "o", "\u001b[?2004h> "]
[220.394724, "o", "HEALTH_URL=\"${PB_URL}/api/health\"\r\n\u001b[?2004l\r"]
[220.394747, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[220.394803, "o", "\u001b[?2004h> "]
[220.394888, "o", "SUPERUSER_EMAIL=\"admin@example.com\"\r\n\u001b[?2004l\r"]
[220.394914, "o", "\u001b[?2004h> "]
[220.395025, "o", "SUPERUSER_PASSWORD='Adm1n_passw0rd!'\r\n\u001b[?2004l\r"]
[220.395048, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[220.3951, "o", "\u001b[?2004h> "]
[220.395139, "o", "TASK_TITLES=(\r\n\u001b[?2004l\r\u001b[?2004h"]
[220.395167, "o", "> "]
[220.395217, "o", "  \"Buy groceries\"\r\n\u001b[?2004l\r"]
[220.395312, "o", "\u001b[?2004h>   \"Walk the dog\"\r\n\u001b[?2004l\r\u001b[?2004h"]
[220.395341, "o", "> "]
[220.395399, "o", "  \"Read a book\"\r\n\u001b[?2004l\r\u001b[?2004h> "]
[220.395471, "o", "  \"Write weekly report\"\r\n\u001b[?2004l\r"]
[220.395492, "o", "\u001b[?2004h> "]
[220.395552, "o", "  \"Call mom\"\r\n\u001b[?2004l\r"]
[220.395576, "o", "\u001b[?2004h> )\r\n\u001b[?2004l\r"]
[220.395604, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[220.395687, "o", "\u001b[?2004h> log() {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[220.395791, "o", "  printf '[setup.sh] %s\\n' \"$*\"\r\n\u001b[?2004l\r"]
[220.39582, "o", "\u001b[?2004h> }\r\n\u001b[?2004l\r"]
[220.395895, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[220.396087, "o", "# --- 1. Apply migrations (idempotent) -------------------------------------\r\n\u001b[?2004l\r\u001b[?2004h"]
[220.396118, "o", "> "]
[220.396276, "o", "log \"Applying migrations from ${MIGRATIONS_DIR} (if any)...\"\r\n\u001b[?2004l\r"]
[220.396314, "o", "\u001b[?2004h> "]
[220.396527, "o", "\"${PB_BIN}\" migrate up --migrationsDir=\"${MIGRATIONS_DIR}\" >/dev/null 2>&1 || true\r\n\u001b[?2004l\r"]
[220.396548, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[220.396603, "o", "\u001b[?2004h> "]
[220.396803, "o", "# --- 2. Ensure the superuser exists (idempotent upsert) --------------------\r\n\u001b[?2004l\r"]
[220.396827, "o", "\u001b[?2004h> "]
[220.396978, "o", "log \"Ensuring superuser ${SUPERUSER_EMAIL} exists...\"\r\n\u001b[?2004l\r"]
[220.397019, "o", "\u001b[?2004h> "]
[220.397281, "o", "\"${PB_BIN}\" superuser upsert \"${SUPERUSER_EMAIL}\" \"${SUPERUSER_PASSWORD}\" >/dev/null 2>&1 || true\r\n\u001b[?2004l\r"]
[220.397305, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[220.397354, "o", "\u001b[?2004h> "]
[220.39755, "o", "# --- 3. Make sure the server is running in the background ------------------\r\n\u001b[?2004l\r"]
[220.397576, "o", "\u001b[?2004h> "]
[220.397624, "o", "server_is_up() {\r\n\u001b[?2004l\r"]
[220.397647, "o", "\u001b[?2004h> "]
[220.397925, "o", "  curl -s -o /dev/null -w '%{http_code}' --max-time 2 \"${HEALTH_URL}\" 2>/dev/null | grep -q '^200$'\r\n\u001b[?2004l\r"]
[220.397952, "o", "\u001b[?2004h> }\r\n\u001b[?2004l\r"]
[220.398005, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[220.398032, "o", "> "]
[220.398071, "o", "start_server() {\r\n\u001b[?2004l\r"]
[220.398098, "o", "\u001b[?2004h> "]
[220.398266, "o", "  log \"Starting PocketBase server in the background...\"\r\n\u001b[?2004l\r"]
[220.398305, "o", "\u001b[?2004h> "]
[220.398358, "o", "  cd \"${PROJECT_DIR}\"\r\n\u001b[?2004l\r"]
[220.398383, "o", "\u001b[?2004h> "]
[220.398518, "o", "  nohup \"${PB_BIN}\" serve >>\"${PB_LOG}\" 2>&1 &\r\n\u001b[?2004l\r"]
[220.398544, "o", "\u001b[?2004h> "]
[220.398627, "o", "  echo $! >\"${PB_PIDFILE}\"\r\n\u001b[?2004l\r"]
[220.398651, "o", "\u001b[?2004h> "]
[220.39875, "o", "  disown 2>/dev/null || true\r\n\u001b[?2004l\r"]
[220.398775, "o", "\u001b[?2004h> }\r\n\u001b[?2004l\r"]
[220.398824, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[220.399014, "o", "# If a previous PID is recorded but the process is gone, clean up.\r\n\u001b[?2004l\r"]
[220.399035, "o", "\u001b[?2004h> "]
[220.399142, "o", "if [[ -f \"${PB_PIDFILE}\" ]]; then\r\n\u001b[?2004l\r"]
[220.399169, "o", "\u001b[?2004h> "]
[220.39933, "o", "  existing_pid=\"$(cat \"${PB_PIDFILE}\" 2>/dev/null || true)\"\r\n\u001b[?2004l\r"]
[220.399354, "o", "\u001b[?2004h> "]
[220.399587, "o", "  if [[ -n \"${existing_pid}\" ]] && kill -0 \"${existing_pid}\" 2>/dev/null; then\r\n\u001b[?2004l\r\u001b[?2004h"]
[220.399622, "o", "> "]
[220.399795, "o", "    log \"PocketBase already running (pid=${existing_pid}).\"\r\n\u001b[?2004l\r"]
[220.400722, "o", "\u001b[?2004h>   else\r\n\u001b[?2004l\r\u001b[?2004h>     rm -f \"${PB_PIDFILE}\"\r\n\u001b[?2004l\r\u001b[?2004h>   fi\r\n\u001b[?2004l\r\u001b[?2004h> fi\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> # Check if server is responding. If not, attempt to start it.\r\n\u001b[?2004l\r\u001b[?2004h> if server_is_up; then\r\n\u001b[?2004l\r\u001b[?2004h>   log \"PocketBase health check OK at ${HEALTH_URL}\"\r\n\u001b[?2004l\r\u001b[?2004h> else\r\n\u001b[?2004l\r\u001b[?2004h>   start_server\r\n\u001b[?2004l\r\u001b[?2004h> "]
[220.400878, "o", "  # Wait for the server to become responsive (max ~15 seconds).\r\n\u001b[?2004l\r"]
[220.400909, "o", "\u001b[?2004h> "]
[220.401002, "o", "  for _ in $(seq 1 30); do\r\n\u001b[?2004l\r\u001b[?2004h"]
[220.40105, "o", "> "]
[220.401108, "o", "    if server_is_up; then\r\n\u001b[?2004l\r\u001b[?2004h> "]
[220.401252, "o", "      log \"PocketBase is up at ${PB_URL}\"\r\n\u001b[?2004l\r\u001b[?2004h"]
[220.401299, "o", ">       break\r\n"]
[220.401328, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[220.401357, "o", "    fi\r\n\u001b[?2004l\r\u001b[?2004h"]
[220.401387, "o", "> "]
[220.401416, "o", "    sleep 0.5\r\n\u001b[?2004l\r"]
[220.401473, "o", "\u001b[?2004h>   done\r\n\u001b[?2004l\r\u001b[?2004h"]
[220.401499, "o", "> "]
[220.401591, "o", "  if ! server_is_up; then\r\n\u001b[?2004l\r"]
[220.401641, "o", "\u001b[?2004h> "]
[220.40185, "o", "    log \"ERROR: PocketBase did not become healthy in time. Check ${PB_LOG}.\"\r\n\u001b[?2004l\r\u001b[?2004h"]
[220.401902, "o", "> "]
[220.402076, "o", "    # Don't fail the script — keep it idempotent / non-fatal here.\r\n\u001b[?2004l\r\u001b[?2004h"]
[220.402128, "o", ">   fi\r\n\u001b[?2004l\r\u001b[?2004h"]
[220.402177, "o", "> fi\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[220.402223, "o", "\u001b[?2004h> "]
[220.402437, "o", "# --- 4. Authenticate and seed the tasks collection --------------------------\r\n\u001b[?2004l\r\u001b[?2004h"]
[220.402486, "o", "> "]
[220.402594, "o", "log \"Authenticating as ${SUPERUSER_EMAIL}...\"\r\n\u001b[?2004l\r\u001b[?2004h"]
[220.40264, "o", "> "]
[220.402893, "o", "auth_response=\"$(curl -s -X POST \"${PB_URL}/api/collections/_superusers/auth-with-password\" \\\r\n\u001b[?2004l\r\u001b[?2004h"]
[220.402924, "o", "> "]
[220.403055, "o", "  -H 'Content-Type: application/json' \\\r\n\u001b[?2004l\r\u001b[?2004h"]
[220.403107, "o", "> "]
[220.403321, "o", "  -d \"{\\\"identity\\\":\\\"${SUPERUSER_EMAIL}\\\",\\\"password\\\":\\\"${SUPERUSER_PASSWORD}\\\"}\")\"\r\n\u001b[?2004l\r\u001b[?2004h"]
[220.403372, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[220.403607, "o", "TOKEN=\"$(printf '%s' \"${auth_response}\" | jq -r '.token // empty' 2>/dev/null || true)\"\r\n\u001b[?2004l\r\u001b[?2004h"]
[220.403639, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[220.403815, "o", "if [[ -z \"${TOKEN}\" || \"${TOKEN}\" == \"null\" ]]; then\r\n\u001b[?2004l\r\u001b[?2004h"]
[220.403866, "o", "> "]
[220.404048, "o", "  log \"ERROR: Failed to obtain auth token. Response: ${auth_response}\"\r\n\u001b[?2004l\r\u001b[?2004h> "]
[220.404096, "o", "  exit 0\r\n\u001b[?2004l\r\u001b[?2004h"]
[220.404163, "o", "> fi\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[220.404354, "o", "# Fetch existing task titles to avoid creating duplicates.\r\n\u001b[?2004l\r\u001b[?2004h"]
[220.404409, "o", "> "]
[220.40447, "o", "existing_titles=\"$(curl -s \\\r\n\u001b[?2004l\r\u001b[?2004h"]
[220.404502, "o", "> "]
[220.40461, "o", "  -H \"Authorization: ${TOKEN}\" \\\r\n\u001b[?2004l\r"]
[220.404675, "o", "\u001b[?2004h> "]
[220.404826, "o", "  \"${PB_URL}/api/collections/tasks/records?perPage=500\" \\\r\n\u001b[?2004l\r"]
[220.404878, "o", "\u001b[?2004h> "]
[220.405016, "o", "  | jq -r '.items[].title // empty' 2>/dev/null || true)\"\r\n\u001b[?2004l\r"]
[220.405066, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[220.405134, "o", "> seed_one() {\r\n\u001b[?2004l\r\u001b[?2004h"]
[220.40519, "o", "> "]
[220.405241, "o", "  local title=\"$1\"\r\n\u001b[?2004l\r\u001b[?2004h"]
[220.405279, "o", "> "]
[220.405404, "o", "  # Skip if already present (exact, case-sensitive match).\r\n\u001b[?2004l\r"]
[220.405429, "o", "\u001b[?2004h> "]
[220.405624, "o", "  if printf '%s\\n' \"${existing_titles}\" | grep -Fxq \"${title}\"; then\r\n\u001b[?2004l\r\u001b[?2004h"]
[220.405648, "o", "> "]
[220.405798, "o", "    log \"Task already present, skipping: ${title}\"\r\n\u001b[?2004l\r"]
[220.405826, "o", "\u001b[?2004h> "]
[220.405864, "o", "    return 0\r\n\u001b[?2004l\r"]
[220.405899, "o", "\u001b[?2004h> "]
[220.405964, "o", "  fi\r\n\u001b[?2004l\r\u001b[?2004h> "]
[220.405989, "o", "  local payload\r\n\u001b[?2004l\r"]
[220.406017, "o", "\u001b[?2004h> "]
[220.406173, "o", "  payload=\"$(jq -n --arg t \"${title}\" '{title:$t}')\"\r\n\u001b[?2004l\r"]
[220.4062, "o", "\u001b[?2004h> "]
[220.406253, "o", "  local resp\r\n\u001b[?2004l\r\u001b[?2004h> "]
[220.406454, "o", "  resp=\"$(curl -s -X POST \"${PB_URL}/api/collections/tasks/records\" \\\r\n\u001b[?2004l\r"]
[220.406482, "o", "\u001b[?2004h> "]
[220.406585, "o", "    -H \"Authorization: ${TOKEN}\" \\\r\n\u001b[?2004l\r"]
[220.406614, "o", "\u001b[?2004h> "]
[220.406737, "o", "    -H 'Content-Type: application/json' \\\r\n\u001b[?2004l\r"]
[220.406763, "o", "\u001b[?2004h> "]
[220.406831, "o", "    -d \"${payload}\")\"\r\n\u001b[?2004l\r"]
[220.406858, "o", "\u001b[?2004h> "]
[220.407031, "o", "  if printf '%s' \"${resp}\" | jq -e '.id' >/dev/null 2>&1; then\r\n\u001b[?2004l\r"]
[220.407057, "o", "\u001b[?2004h> "]
[220.407148, "o", "    log \"Seeded task: ${title}\"\r\n\u001b[?2004l\r"]
[220.407174, "o", "\u001b[?2004h> "]
[220.407228, "o", "  else\r\n\u001b[?2004l\r\u001b[?2004h> "]
[220.407355, "o", "    log \"ERROR seeding task '${title}': ${resp}\"\r\n\u001b[?2004l\r"]
[220.407379, "o", "\u001b[?2004h>   fi\r\n"]
[220.407407, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[220.407467, "o", "}\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[220.407491, "o", "> "]
[220.407591, "o", "log \"Seeding tasks collection...\"\r\n\u001b[?2004l\r"]
[220.407615, "o", "\u001b[?2004h> "]
[220.407726, "o", "for t in \"${TASK_TITLES[@]}\"; do\r\n\u001b[?2004l\r"]
[220.407749, "o", "\u001b[?2004h> "]
[220.407811, "o", "  seed_one \"${t}\"\r\n\u001b[?2004l\r"]
[220.407839, "o", "\u001b[?2004h> done\r\n"]
[220.407914, "o", "\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[220.407959, "o", "log \"Done.\"\r\n\u001b[?2004l\r\u001b[?2004h> "]
[220.407983, "o", "exit 0\r\n\u001b[?2004l\r\u001b[?2004h"]
[220.408007, "o", "> "]
[220.408069, "o", "SCRIPT_EOF\r\n\u001b[?2004l\r"]
[220.40931, "o", "\u001b[?2004hroot@b1f4b31f-281b-4cd7-b786-6e4b4228549e:/home/user/myproject# "]
[220.717786, "i", "chmod +x /home/user/myproject/setup.sh\n"]
[220.719885, "o", "chmod +x /home/user/myproject/setup.sh\r\n\u001b[?2004l\r"]
[220.721085, "o", "\u001b[?2004hroot@b1f4b31f-281b-4cd7-b786-6e4b4228549e:/home/user/myproject# "]
[221.04056, "i", "ls -la /home/user/myproject/setup.sh\n"]
[221.040798, "o", "ls -la /home/user/myproject/setup.sh\r\n\u001b[?2004l\r"]
[221.042356, "o", "-rwxr-xr-x 1 root root 4316 Jul  3 12:54 \u001b[0m\u001b[01;32m/home/user/myproject/setup.sh\u001b[0m\r\n"]
[221.042625, "o", "\u001b[?2004hroot@b1f4b31f-281b-4cd7-b786-6e4b4228549e:/home/user/myproject# "]
[225.011398, "i", "ls /home/user/myproject/\n"]
[225.012194, "o", "ls /home/user/myproject/\r\n\u001b[?2004l\r"]
[225.013043, "o", "CHANGELOG.md  LICENSE.md  \u001b[0m\u001b[01;34mpb_migrations\u001b[0m  \u001b[01;32mpocketbase\u001b[0m  \u001b[01;32msetup.sh\u001b[0m\r\n"]
[225.013227, "o", "\u001b[?2004hroot@b1f4b31f-281b-4cd7-b786-6e4b4228549e:/home/user/myproject# "]
[225.316527, "i", "bash /home/user/myproject/setup.sh\n"]
[225.316808, "o", "bash /home/user/myproject/setup.sh\r\n\u001b[?2004l\r"]
[225.3181, "o", "[setup.sh] Applying migrations from /home/user/myproject/pb_migrations (if any)...\r\n"]
[225.358313, "o", "[setup.sh] Ensuring superuser admin@example.com exists...\r\n"]
[225.468718, "o", "[setup.sh] Starting PocketBase server in the background...\r\n"]
[225.489894, "o", "[setup.sh] PocketBase is up at http://127.0.0.1:8090\r\n"]
[225.507594, "o", "[setup.sh] Authenticating as admin@example.com...\r\n"]
[225.602583, "o", "[setup.sh] Seeding tasks collection...\r\n"]
[225.623965, "o", "[setup.sh] Seeded task: Buy groceries\r\n"]
[225.6467, "o", "[setup.sh] Seeded task: Walk the dog\r\n"]
[225.670721, "o", "[setup.sh] Seeded task: Read a book\r\n"]
[225.692369, "o", "[setup.sh] Seeded task: Write weekly report\r\n"]
[225.714536, "o", "[setup.sh] Seeded task: Call mom\r\n"]
[225.714579, "o", "[setup.sh] Done.\r\n"]
[225.714919, "o", "\u001b[?2004hroot@b1f4b31f-281b-4cd7-b786-6e4b4228549e:/home/user/myproject# "]
[238.459589, "i", "curl -s -o /dev/null -w \"%{http_code}\\n\" http://127.0.0.1:8090/api/health\n"]
