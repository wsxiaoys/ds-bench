[299.674144, "i", "python3 << 'EOF'\nimport re\ndata = open('/usr/local/bin/daytona','rb').read()\nmatches = set(re.findall(rb'[\\x20-\\x7e]{8,}', data))\nfor m in sorted(matches):\n    s = m.decode('latin-1')\n    if any(k in s.lower() for k in ['login', 'list', 'create ', 'creat', 'snap', 'class', 'subcomm', 'rootCmd', 'sandbox']):\n        print(s)\nEOF\n"]
