[414.893561, "i", "python3 << 'PYEOF'\nimport re\ndata = open('/usr/local/bin/daytona','rb').read()\n# Look for short strings\nmatches = set(re.findall(rb'[a-z_]{4,15}', data))\nkeywords = {'login', 'logout', 'create', 'list', 'delete', 'start', 'stop', 'exec', 'ssh', 'git', 'info', 'version', 'help', 'whoami', 'snapshot', 'apikey', 'api-key', 'serve', 'daemon', 'init'}\nfor m in sorted(matches):\n    s = m.decode('latin-1')\n    if s in keywords or (any(k in s for k in ['sandbox', 'command']) and len(s) < 20):\n        print(s)\nPYEOF\n"]
