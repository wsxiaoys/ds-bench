[391.118152, "o", "=== src/app/api/trpc/[trpc]/route.ts ===\r\n"]
[391.119387, "o", "import { fetchRequestHandler } from '@trpc/server/adapters/fetch';\r\nimport { appRouter } from '@/server';\r\n\r\nconst handler = (req: Request) =>\r\n  fetchRequestHandler({\r\n    endpoint: '/api/trpc',\r\n    req,\r\n    router: appRouter,\r\n    createContext: () => ({}),\r\n  });\r\n\r\nexport { handler as GET, handler as POST };\r\n"]
