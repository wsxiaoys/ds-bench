[388.49512, "o", "{\r\n  \"name\": \"trpc-streaming-project\",\r\n  \"version\": \"0.1.0\",\r\n  \"private\": true,\r\n  \"scripts\": {\r\n    \"dev\": \"next dev\",\r\n    \"build\": \"next build\",\r\n    \"start\": \"next start\",\r\n    \"lint\": \"next lint\"\r\n  },\r\n  \"dependencies\": {\r\n    \"next\": \"^15.0.0\",\r\n    \"react\": \"^18.3.1\",\r\n    \"react-dom\": \"^18.3.1\",\r\n    \"@trpc/server\": \"next\",\r\n    \"@trpc/client\": \"next\",\r\n    \"@trpc/react-query\": \"next\",\r\n    \"@tanstack/react-query\": \"^5.59.0\",\r\n    \"zod\": \"^3.23.8\"\r\n  },\r\n  \"devDependencies\": {\r\n    \"@types/node\": \"^20\",\r\n    \"@types/react\": \"^18\",\r\n    \"@types/react-dom\": \"^18\",\r\n    \"typescript\": \"^5\"\r\n  }\r\n}\r\n"]
