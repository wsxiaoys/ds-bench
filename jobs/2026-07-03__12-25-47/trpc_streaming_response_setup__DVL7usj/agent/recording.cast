[388.848127, "o", "\u001b[?2004l\r\r\n"]
[388.848177, "o", "=== src/server/trpc.ts ===\r\n"]
[388.849186, "o", "import { initTRPC } from '@trpc/server';\r\n\r\nconst t = initTRPC.create();\r\n\r\nexport const router = t.router;\r\nexport const publicProcedure = t.procedure;\r\n"]
[388.849389, "o", "\u001b[?2004hroot@fa43178d-cf4c-4e1a-9e5e-b55e43cf27fe:/home/user/project# "]
[389.24152, "i", "echo '=== src/server/index.ts ==='; cat /home/user/project/src/server/index.ts\n"]
[389.241852, "o", "\u001b[?2004l\r\r\n"]
[389.241924, "o", "=== src/server/index.ts ===\r\n"]
[389.242782, "o", "import { router, publicProcedure } from './trpc';\r\n\r\nconst sleep = (ms: number) => new Promise<void>((resolve) => setTimeout(resolve, ms));\r\n\r\nexport const appRouter = router({\r\n  streamWords: publicProcedure.query(async function* () {\r\n    const words = ['Hello', 'streaming', 'world'];\r\n    for (const word of words) {\r\n      await sleep(100);\r\n      yield word;\r\n    }\r\n  }),\r\n});\r\n\r\nexport type AppRouter = typeof appRouter;\r\n"]
[389.24292, "o", "\u001b[?2004hroot@fa43178d-cf4c-4e1a-9e5e-b55e43cf27fe:/home/user/project# "]
[389.607035, "i", "echo '=== src/trpc/client.ts ==='; cat /home/user/project/src/trpc/client.ts\n"]
[389.607754, "o", "\u001b[?2004l\r\r\n"]
[389.607818, "o", "=== src/trpc/client.ts ===\r\n"]
[389.608976, "o", "'use client';\r\n\r\nimport { createTRPCReact } from '@trpc/react-query';\r\nimport type { AppRouter } from '@/server';\r\n\r\nexport const trpc = createTRPCReact<AppRouter>();\r\n"]
[389.609226, "o", "\u001b[?2004h"]
[389.609284, "o", "root@fa43178d-cf4c-4e1a-9e5e-b55e43cf27fe:/home/user/project# "]
[390.047252, "i", "echo '=== src/trpc/Provider.tsx ==='; cat /home/user/project/src/trpc/Provider.tsx\n"]
[390.047699, "o", "\u001b[?2004l\r\r\n"]
[390.047762, "o", "=== src/trpc/Provider.tsx ===\r\n"]
[390.048727, "o", "'use client';\r\n\r\nimport { useState } from 'react';\r\nimport { QueryClient, QueryClientProvider } from '@tanstack/react-query';\r\nimport { httpBatchStreamLink } from '@trpc/client';\r\nimport { trpc } from './client';\r\n\r\nfunction getBaseUrl() {\r\n  if (typeof window !== 'undefined') return '';\r\n  if (process.env.VERCEL_URL) return `https://${process.env.VERCEL_URL}`;\r\n  return `http://localhost:${process.env.PORT ?? 3000}`;\r\n}\r\n\r\nexport function TRPCProvider({ children }: { children: React.ReactNode }) {\r\n  const [queryClient] = useState(\r\n    () =>\r\n      new QueryClient({\r\n        defaultOptions: {\r\n          queries: {\r\n            staleTime: 5 * 1000,\r\n          },\r\n        },\r\n      }),\r\n  );\r\n  const [trpcClient] = useState(() =>\r\n    trpc.createClient({\r\n      links: [\r\n        httpBatchStreamLink({\r\n          url: `${getBaseUrl()}/api/trpc`,\r\n        }),\r\n      ],\r\n    }),\r\n  );\r\n\r\n  return (\r\n    <trpc.Provider client={trpcClient} queryClient={queryClient}>\r\n      <QueryClientProvider client={queryClient}>{children}</QueryClientProvider>\r\n    </trpc.Provider>\r\n  );\r\n}\r\n"]
[390.048965, "o", "\u001b[?2004hroot@fa43178d-cf4c-4e1a-9e5e-b55e43cf27fe:/home/user/project# "]
[390.400886, "i", "echo '=== src/app/layout.tsx ==='; cat /home/user/project/src/app/layout.tsx\n"]
[390.401261, "o", "\u001b[?2004l\r\r\n=== src/app/layout.tsx ===\r\n"]
[390.403039, "o", "import { TRPCProvider } from '@/trpc/Provider';\r\n\r\nexport const metadata = {\r\n  title: 'tRPC Streaming',\r\n  description: 'tRPC v11 streaming example',\r\n};\r\n\r\nexport default function RootLayout({\r\n  children,\r\n}: {\r\n  children: React.ReactNode;\r\n}) {\r\n  return (\r\n    <html lang=\"en\">\r\n      <body>\r\n        <TRPCProvider>{children}</TRPCProvider>\r\n      </body>\r\n    </html>\r\n  );\r\n}\r\n"]
[390.403365, "o", "\u001b[?2004hroot@fa43178d-cf4c-4e1a-9e5e-b55e43cf27fe:/home/user/project# "]
[390.736999, "i", "echo '=== src/app/page.tsx ==='; cat /home/user/project/src/app/page.tsx\n"]
[390.737309, "o", "\u001b[?2004l\r\r\n"]
[390.737389, "o", "=== src/app/page.tsx ===\r\n"]
[390.739287, "o", "'use client';\r\n\r\nimport { trpc } from '@/trpc/client';\r\n\r\nexport default function Home() {\r\n  const query = trpc.streamWords.useQuery();\r\n  const words = query.data ?? [];\r\n\r\n  return (\r\n    <main>\r\n      <h1>tRPC Streaming Output</h1>\r\n      <div id=\"chat-output\">{words.join(' ')}</div>\r\n    </main>\r\n  );\r\n}\r\n"]
[390.73961, "o", "\u001b[?2004h"]
