[60.149711, "i", "cat > src/app/page.tsx << 'EOF'\n'use client';\n\nimport { useEffect, useState } from 'react';\nimport { trpc } from '@/trpc/client';\n\nexport default function Home() {\n  const [words, setWords] = useState<string[]>([]);\n\n  useEffect(() => {\n    const controller = new AbortController();\n    let active = true;\n\n    (async () => {\n      try {\n        const client = trpc.streamWords.query(undefined, { signal: controller.signal });\n        for await (const word of client) {\n          if (!active) break;\n          setWords((prev) => [...prev, word]);\n        }\n      } catch (err) {\n        // ignore abort errors\n      }\n    })();\n\n    return () => {\n      active = false;\n      controller.abort();\n    };\n  }, []);\n\n  return (\n    <main>\n      <h1>tRPC Streaming Output</h1>\n      <div id=\"chat-output\">{words.join(' ')}</div>\n    </main>\n  );\n}\nEOF\n"]
