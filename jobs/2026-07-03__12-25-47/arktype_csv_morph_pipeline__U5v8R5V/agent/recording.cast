[344.24044, "o", "const StringIntegerParse = type('string.integer.parse')\r\n\u001b[?2004l\r\u001b[?2004h"]
[344.240492, "o", "> "]
[344.240637, "o", "const AgeRange = type('0 <= number <= 150')\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[344.240685, "o", "> "]
[344.240794, "o", "const UserT = type({\r\n\u001b[?2004l\r\u001b[?2004h> "]
[344.240843, "o", "    id: 'string.uuid',\r\n\u001b[?2004l\r\u001b[?2004h> "]
[344.241014, "o", "    age: type.pipe(StringIntegerParse, AgeRange),\r\n\u001b[?2004l\r\u001b[?2004h"]
[344.241061, "o", "> "]
[344.24116, "o", "    email: 'string.email',\r\n\u001b[?2004l\r\u001b[?2004h> "]
[344.241268, "o", "    signupAt: 'string.date.iso.parse'\r\n\u001b[?2004l\r\u001b[?2004h"]
[344.241317, "o", "> })\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[344.241413, "o", "\u001b[?2004h> /**\r\n\u001b[?2004l\r\u001b[?2004h> "]
[344.241655, "o", " * Strongly-typed user record produced by the pipeline after validation.\r\n\u001b[?2004l\r\u001b[?2004h>  *\r\n"]
[344.241751, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[344.241936, "o", " * `age` is morphed from a string into an integer in the inclusive range\r\n\u001b[?2004l\r\u001b[?2004h> "]
[344.24217, "o", " * `[0, 150]` and `signupAt` is morphed from an ISO-8601 string into a real\r\n\u001b[?2004l\r\u001b[?2004h"]
[344.242214, "o", "> "]
[344.242381, "o", " * `Date` instance, all via ArkType's morph/pipe machinery.\r\n\u001b[?2004l\r\u001b[?2004h"]
[344.242421, "o", ">  */\r\n\u001b[?2004l\r\u001b[?2004h> "]
[344.242588, "o", "export type UserRecord = typeof UserT.infer\r\n\u001b[?2004l\r\u001b[?2004h"]
[344.242628, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[344.242725, "o", "/**\r\n\u001b[?2004l\r\u001b[?2004h> "]
[344.242885, "o", " * User-defined morph that splits a raw CSV string into an array of\r\n\u001b[?2004l\r\u001b[?2004h"]
[344.242956, "o", "> "]
[344.242994, "o", " * record-shaped objects.\r\n\u001b[?2004l\r\u001b[?2004h"]
[344.243031, "o", ">  *\r\n\u001b[?2004l\r"]
[344.243144, "o", "\u001b[?2004h> "]
[344.243288, "o", " * This is the only place where raw CSV parsing logic lives; downstream\r\n\u001b[?2004l\r\u001b[?2004h"]
[344.243365, "o", "> "]
[344.243493, "o", " * validation is entirely handled by ArkType via the pipe.\r\n\u001b[?2004l\r"]
[344.243577, "o", "\u001b[?2004h>  *\r\n\u001b[?2004l\r\u001b[?2004h"]
[344.243621, "o", "> "]
[344.243783, "o", " * Throws a descriptive `Error` if the input is empty, the header is\r\n\u001b[?2004l\r\u001b[?2004h"]
[344.243821, "o", "> "]
[344.244039, "o", " * malformed, or any data row has the wrong number of comma-separated cells.\r\n\u001b[?2004l\r\u001b[?2004h"]
[344.244076, "o", "> "]
[344.244267, "o", " * The error is caught and surfaced as `INVALID: <msg>` by the CLI.\r\n\u001b[?2004l\r\u001b[?2004h"]
[344.244302, "o", ">  */\r\n\u001b[?2004l\r\u001b[?2004h"]
[344.244332, "o", "> "]
[344.244521, "o", "export const parseCsv = (csv: string): RawUserRecord[] => {\r\n\u001b[?2004l\r\u001b[?2004h"]
[344.244603, "o", "> "]
[344.244686, "o", "    if (csv.length === 0) {\r\n\u001b[?2004l\r"]
[344.244726, "o", "\u001b[?2004h> "]
[344.244856, "o", "        throw new Error('input is empty (no header row)')\r\n\u001b[?2004l\r"]
[344.244933, "o", "\u001b[?2004h>     }\r\n\u001b[?2004l\r"]
[344.245015, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[344.245087, "o", "    const lines = csv.split('\\n')\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[344.245167, "o", "\u001b[?2004h> "]
[344.245246, "o", "    if (lines[0] !== EXPECTED_HEADER) {\r\n\u001b[?2004l\r\u001b[?2004h"]
[344.245325, "o", "> "]
[344.245371, "o", "        throw new Error(\r\n\u001b[?2004l\r\u001b[?2004h> "]
[344.24563, "o", "            `header row must be exactly ${JSON.stringify(EXPECTED_HEADER)} ` +\r\n\u001b[?2004l\r\u001b[?2004h"]
[344.245708, "o", "> "]
[344.245833, "o", "                `(got ${JSON.stringify(lines[0] ?? '')})`\r\n\u001b[?2004l\r\u001b[?2004h"]
[344.245908, "o", ">         )\r\n\u001b[?2004l\r"]
[344.245989, "o", "\u001b[?2004h>     }\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[344.246028, "o", "\u001b[?2004h> "]
[344.24612, "o", "    const records: RawUserRecord[] = []\r\n\u001b[?2004l\r\u001b[?2004h"]
[344.246157, "o", "> "]
[344.246287, "o", "    for (let i = 1; i < lines.length; i++) {\r\n\u001b[?2004l\r\u001b[?2004h"]
[344.246364, "o", "> "]
[344.246552, "o", "        // Skip trailing empty line that often appears when reading from stdin.\r\n\u001b[?2004l\r\u001b[?2004h"]
[344.246591, "o", "> "]
[344.246721, "o", "        if (lines[i].length === 0) continue\r\n\u001b[?2004l\r\u001b[?2004h"]
[344.246759, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[344.246911, "o", "        const cells = lines[i].split(',')\r\n\u001b[?2004l\r\u001b[?2004h"]
[344.246949, "o", "> "]
[344.247038, "o", "        if (cells.length !== 4) {\r\n\u001b[?2004l\r\u001b[?2004h"]
[344.247076, "o", "> "]
[344.247163, "o", "            throw new Error(\r\n\u001b[?2004l\r\u001b[?2004h"]
[344.24723, "o", "> "]
[344.247403, "o", "                `row ${i + 1} has ${cells.length} columns, expected 4 ` +\r\n\u001b[?2004l\r\u001b[?2004h"]
[344.247479, "o", "> "]
[344.247604, "o", "                    `(got ${JSON.stringify(lines[i])})`\r\n\u001b[?2004l\r"]
[344.247641, "o", "\u001b[?2004h> "]
[344.247734, "o", "            )\r\n\u001b[?2004l\r\u001b[?2004h>         }\r\n\u001b[?2004l\r"]
[344.247773, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[344.247868, "o", "        records.push({\r\n\u001b[?2004l\r\u001b[?2004h"]
[344.247904, "o", "> "]
[344.24799, "o", "            id: cells[0],\r\n\u001b[?2004l\r\u001b[?2004h> "]
[344.248085, "o", "            age: cells[1],\r\n\u001b[?2004l\r\u001b[?2004h"]
[344.248161, "o", "> "]
[344.248203, "o", "            email: cells[2],\r\n\u001b[?2004l\r\u001b[?2004h"]
[344.248298, "o", "> "]
[344.248374, "o", "            signupAt: cells[3]\r\n\u001b[?2004l\r\u001b[?2004h> "]
[344.248452, "o", "        })\r\n\u001b[?2004l\r\u001b[?2004h>     }\r\n\u001b[?2004l\r"]
[344.248489, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[344.24855, "o", "    return records\r\n\u001b[?2004l\r\u001b[?2004h"]
[344.24865, "o", "> }\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> /**\r\n\u001b[?2004l\r"]
[344.248728, "o", "\u001b[?2004h> "]
[344.248798, "o", " * End-to-end ArkType pipeline.\r\n\u001b[?2004l\r\u001b[?2004h"]
[344.248877, "o", ">  *\r\n\u001b[?2004l\r\u001b[?2004h> "]
[344.249066, "o", " * Composition (an explicit morph pipe, not a single inline schema):\r\n\u001b[?2004l\r\u001b[?2004h"]
[344.249102, "o", ">  *\r\n\u001b[?2004l\r\u001b[?2004h"]
[344.249191, "o", "> "]
[344.249312, "o", " *   1. `type('string')` — the raw CSV bytes from stdin.\r\n\u001b[?2004l\r\u001b[?2004h"]
[344.249388, "o", "> "]
[344.249595, "o", " *   2. `parseCsv` — user-defined morph that produces an array of raw records.\r\n\u001b[?2004l\r\u001b[?2004h"]
[344.249698, "o", "> "]
[344.249838, "o", " *   3. `UserT.array()` — validates each cell and morphs `age`/`signupAt`\r\n\u001b[?2004l\r"]
[344.249869, "o", "\u001b[?2004h> "]
[344.249966, "o", " *      into their target types.\r\n\u001b[?2004l\r"]
[344.249997, "o", "\u001b[?2004h>  *\r\n\u001b[?2004l\r"]
[344.250025, "o", "\u001b[?2004h> "]
[344.25026, "o", " * On success, the inferred output is `UserRecord[]` where `signupAt` is a\r\n\u001b[?2004l\r\u001b[?2004h"]
[344.250292, "o", "> "]
[344.250517, "o", " * real `Date`. On failure the result is an `ArkErrors` instance describing\r\n\u001b[?2004l\r\u001b[?2004h"]
[344.250549, "o", "> "]
[344.250657, "o", " * the first constraint violation.\r\n\u001b[?2004l\r\u001b[?2004h"]
[344.250687, "o", ">  */\r\n\u001b[?2004l\r"]
[344.250754, "o", "\u001b[?2004h> "]
[344.25095, "o", "export const PipelineT = type.pipe(type('string'), parseCsv, UserT.array())\r\n\u001b[?2004l\r"]
[344.250981, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[344.251057, "o", "\u001b[?2004h> /**\r\n\u001b[?2004l\r\u001b[?2004h> "]
[344.251206, "o", " * Run the pipeline on the given raw CSV string.\r\n\u001b[?2004l\r\u001b[?2004h"]
[344.251235, "o", ">  *\r\n\u001b[?2004l\r"]
[344.251305, "o", "\u001b[?2004h> "]
[344.251485, "o", " * Returns either the validated user records (on success) or a single\r\n\u001b[?2004l\r\u001b[?2004h"]
[344.251517, "o", "> "]
[344.251788, "o", " * descriptive error message (on failure). This is the function the CLI\r\n\u001b[?2004l\r\u001b[?2004h"]
[344.251822, "o", "> "]
[344.252038, "o", " * consumes; it isolates it from ArkType's internal error representation.\r\n\u001b[?2004l\r\u001b[?2004h"]
[344.25207, "o", ">  */\r\n\u001b[?2004l\r"]
[344.252141, "o", "\u001b[?2004h> "]
[344.252197, "o", "export const runPipeline = (\r\n\u001b[?2004l\r"]
[344.252225, "o", "\u001b[?2004h> "]
[344.252271, "o", "    csv: string\r\n\u001b[?2004l\r\u001b[?2004h"]
[344.252339, "o", "> "]
[344.252529, "o", "): { ok: true; records: UserRecord[] } | { ok: false; error: string } => {\r\n\u001b[?2004l\r\u001b[?2004h"]
[344.252559, "o", "> "]
[344.252668, "o", "    const result = PipelineT(csv)\r\n\u001b[?2004l\r"]
[344.252698, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[344.252768, "o", "> "]
[344.25284, "o", "    if (result instanceof ArkErrors) {\r\n\u001b[?2004l\r"]
[344.252871, "o", "\u001b[?2004h> "]
[344.253031, "o", "        return { ok: false, error: result.summary }\r\n\u001b[?2004l\r\u001b[?2004h"]
[344.253063, "o", ">     }\r\n\u001b[?2004l\r"]
[344.253132, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[344.253314, "o", "    return { ok: true, records: result as UserRecord[] }\r\n\u001b[?2004l\r"]
[344.253347, "o", "\u001b[?2004h> }\r\n\u001b[?2004l\r"]
[344.253418, "o", "\u001b[?2004h> PIPELINE_EOF\r\n\u001b[?2004l\r"]
[344.255302, "o", "\u001b[?2004hroot@6dad3eb8-6d44-497d-9379-660eb77182d6:/home/user/myproject# "]
[344.67019, "i", "head -30 /home/user/myproject/src/pipeline.ts\n"]
[344.670431, "o", "head -30 /home/user/myproject/src/pipeline.ts\r\n\u001b[?2004l\r"]
[344.671384, "o", "import { type, ArkErrors } from 'arktype'\r\n\r\n/**\r\n * Expected CSV header. The header must match this exactly (case-sensitive,\r\n * no extra columns, no leading/trailing whitespace).\r\n */\r\nconst EXPECTED_HEADER = 'id,age,email,signupAt' as const\r\n\r\n/**\r\n * Raw record shape produced by the CSV parsing morph before validation.\r\n *\r\n * Each cell is a `string` at this stage; ArkType will morph the integer and\r\n * ISO date columns into their target types during the second stage of the"]
[344.671439, "o", "\r\n * pipe.\r\n */\r\nexport type RawUserRecord = {\r\n    id: string\r\n    age: string\r\n    email: string\r\n    signupAt: string\r\n}\r\n\r\n/**\r\n * Per-cell validation schema for a single user record.\r\n *\r\n * - `id` must be a UUID.\r\n * - `age` is validated as a string-shaped integer and morphed into a real\r\n *   number in the inclusive range `[0, 150]`.\r\n * - `email` must be a valid email address.\r\n * - `signupAt` must be an ISO-8601 date string and is morphed into a `Date`.\r\n"]
[344.67161, "o", "\u001b[?2004h"]
[344.671635, "o", "root@6dad3eb8-6d44-497d-9379-660eb77182d6:/home/user/myproject# "]
[354.163909, "i", "cat > /home/user/myproject/cli.ts << 'CLI_EOF'\nimport { runPipeline, type UserRecord } from './src/pipeline.ts'\n\n/**\n * Read the entire raw CSV payload from stdin verbatim.\n *\n * No trimming or normalization is applied before the bytes are forwarded to\n * the ArkType pipeline; the pipeline is responsible for any validation or\n * transformation.\n */\nconst readStdin = async (): Promise<string> => {\n    const chunks: Buffer[] = []\n    for await (const chunk of process.stdin) {\n        chunks.push(chunk as Buffer)\n    }\n    return Buffer.concat(chunks).toString('utf8')\n}\n\n/**\n * JSON-serialize a validated user record array, preserving the `Date`\n * instances produced by the `signupAt` morph.\n *\n * `JSON.stringify` natively formats `Date` values as ISO-8601 strings, which\n * matches the input format and keeps the output reproducible.\n */\nconst serializeRecords = (records: UserRecord[]): string =>\n    JSON.stringify(records)\n\nconst main = async (): Promise<void> => {\n    const csv = await readStdin()\n\n    let outcome: ReturnType<typeof runPipeline>\n    try {\n        outcome = runPipeline(csv)\n    } catch (err) {\n        // The user-defined CSV-parsing morph throws `Error` instances with\n        // descriptive messages; surface them through the same `INVALID:`\n        // channel as ArkType-originated errors.\n        const message = err instanceof Error ? err.message : String(err)\n        console.log(`INVALID: ${message}`)\n        process.exit(0)\n        return\n    }\n\n    if (!outcome.ok) {\n        console.log(`INVALID: ${outcome.error}`)\n        process.exit(0)\n        return\n    }\n\n    console.log('VALID')\n    console.log(serializeRecords(outcome.records))\n    process.exit(0)\n}\n\nmain().catch((err: unknown) => {\n    // Last-resort safety net: any unexpected throw becomes a single-line\n    // `INVALID:` message and the process still exits with code 0 so that\n    // downstream tooling can rely on stdout alone to detect failure.\n    const message = err instanceof Error ? err.message : String(err)\n    console.log(`INVALID: ${message}`)\n    process.exit(0)\n})\nCLI_EOF\n"]
[354.164486, "o", "cat > /home/user/myproject/cli.ts << 'CLI_EOF'\r\n\u001b[?2004l\r"]
[354.164606, "o", "\u001b[?2004h"]
[354.164663, "o", "> "]
[354.165143, "o", "import { runPipeline, type UserRecord } from './src/pipeline.ts'\r\n\u001b[?2004l\r"]
[354.165198, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[354.165305, "o", "\u001b[?2004h> /**\r\n"]
[354.165386, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[354.165835, "o", " * Read the entire raw CSV payload from stdin verbatim.\r\n\u001b[?2004l\r"]
[354.165914, "o", "\u001b[?2004h>  *\r\n\u001b[?2004l\r"]
[354.165968, "o", "\u001b[?2004h"]
[354.166019, "o", "> "]
[354.166613, "o", " * No trimming or normalization is applied before the bytes are forwarded to\r\n\u001b[?2004l\r"]
[354.166666, "o", "\u001b[?2004h"]
[354.166726, "o", "> "]
[354.1673, "o", " * the ArkType pipeline; the pipeline is responsible for any validation or\r\n\u001b[?2004l\r"]
[354.167353, "o", "\u001b[?2004h> "]
[354.167537, "o", " * transformation.\r\n\u001b[?2004l\r"]
[354.167599, "o", "\u001b[?2004h> "]
[354.167706, "o", " */\r\n\u001b[?2004l\r\u001b[?2004h> "]
[354.168103, "o", "const readStdin = async (): Promise<string> => {\r\n\u001b[?2004l\r"]
[354.168154, "o", "\u001b[?2004h> "]
[354.168439, "o", "    const chunks: Buffer[] = []\r\n\u001b[?2004l\r"]
[354.168492, "o", "\u001b[?2004h> "]
[354.168894, "o", "    for await (const chunk of process.stdin) {\r\n\u001b[?2004l\r"]
[354.168949, "o", "\u001b[?2004h> "]
[354.169241, "o", "        chunks.push(chunk as Buffer)\r\n\u001b[?2004l\r"]
[354.169295, "o", "\u001b[?2004h> "]
[354.169403, "o", "    }\r\n\u001b[?2004l\r\u001b[?2004h"]
[354.169457, "o", "> "]
[354.169837, "o", "    return Buffer.concat(chunks).toString('utf8')\r\n\u001b[?2004l\r"]
[354.169892, "o", "\u001b[?2004h> }\r\n\u001b[?2004l\r"]
[354.169996, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[354.170049, "o", "\u001b[?2004h"]
[354.170099, "o", "> /**\r\n\u001b[?2004l\r"]
[354.170157, "o", "\u001b[?2004h"]
[354.170213, "o", "> "]
[354.170778, "o", " * JSON-serialize a validated user record array, preserving the `Date`\r\n\u001b[?2004l\r"]
[354.170832, "o", "\u001b[?2004h> "]
[354.171231, "o", " * instances produced by the `signupAt` morph.\r\n\u001b[?2004l\r"]
[354.171309, "o", "\u001b[?2004h> "]
[354.171362, "o", " *\r\n\u001b[?2004l\r\u001b[?2004h"]
[354.171462, "o", "> "]
[354.172079, "o", " * `JSON.stringify` natively formats `Date` values as ISO-8601 strings, which\r\n\u001b[?2004l\r\u001b[?2004h"]
[354.172161, "o", "> "]
[354.172641, "o", " * matches the input format and keeps the output reproducible.\r\n\u001b[?2004l\r"]
[354.172697, "o", "\u001b[?2004h> "]
[354.172794, "o", " */\r\n\u001b[?2004l\r\u001b[?2004h"]
[354.172848, "o", "> "]
[354.173313, "o", "const serializeRecords = (records: UserRecord[]): string =>\r\n\u001b[?2004l\r"]
[354.173389, "o", "\u001b[?2004h> "]
[354.173626, "o", "    JSON.stringify(records)\r\n\u001b[?2004l\r"]
[354.173701, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[354.173753, "o", "\u001b[?2004h> "]
[354.174119, "o", "const main = async (): Promise<void> => {\r\n\u001b[?2004l\r"]
[354.174173, "o", "\u001b[?2004h> "]
[354.174467, "o", "    const csv = await readStdin()\r\n\u001b[?2004l\r"]
[354.174518, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[354.174616, "o", "\u001b[?2004h> "]
[354.175017, "o", "    let outcome: ReturnType<typeof runPipeline>\r\n\u001b[?2004l\r"]
[354.175069, "o", "\u001b[?2004h> "]
[354.175195, "o", "    try {\r\n\u001b[?2004l\r"]
[354.175269, "o", "\u001b[?2004h> "]
