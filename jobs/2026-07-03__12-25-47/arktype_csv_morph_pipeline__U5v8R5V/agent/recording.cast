[107.851498, "i", "cat > /home/user/myproject/test_ark5.ts << 'EOF'\nimport { type } from 'arktype'\n\nconst StringIntParse = type('string.integer.parse')\n\n// Test pipe: from integer string to integer in range\nconst AgeT = type.pipe(StringIntParse, n => n >= 0 && n <= 150)\nconst ageResult = AgeT('25')\nconsole.log('Age 25:', ageResult, 'is errors:', ageResult instanceof type.errors)\n\nconst ageBad = AgeT('200')\nconsole.log('Age 200:', ageBad, 'is errors:', ageBad instanceof type.errors)\nif (ageBad instanceof type.errors) console.log('Summary:', ageBad.summary)\n\nconst ageNotInt = AgeT('not-an-int')\nconsole.log('Age non-int:', ageNotInt, 'is errors:', ageNotInt instanceof type.errors)\nif (ageNotInt instanceof type.errors) console.log('Summary:', ageNotInt.summary)\nEOF\n"]
