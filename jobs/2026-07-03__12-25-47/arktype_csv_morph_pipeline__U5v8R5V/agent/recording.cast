[97.792044, "i", "cat > /home/user/myproject/test_ark5.ts << 'EOF'\nimport { type } from 'arktype'\n\n// string.integer.parse parses a string to integer\n// For age, we need a morph that validates it's an integer in [0, 150]\n// Approach: use pipe with integer.parse then range\n// Or use a narrow constraint on integer.parse\n\n// Let's try the pipe approach:\nconst AgeT = type.pipe('string.integer.parse', n => n >= 0 && n <= 150)\nconst ageResult = AgeT('25')\nconsole.log('Age 25:', ageResult, 'is errors:', ageResult instanceof type.errors)\n\nconst ageBad = AgeT('200')\nconsole.log('Age 200:', ageBad, 'is errors:', ageBad instanceof type.errors)\nif (ageBad instanceof type.errors) console.log('Summary:', ageBad.summary)\nEOF\n"]
