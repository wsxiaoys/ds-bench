[330.247314, "o", "grep \"ArkErrors\" /home/user/myproject/node_modules/arktype/out/index.d.ts\r\n\u001b[?2004l\r"]
[330.248412, "o", "export { ArkError, \u001b[01;31m\u001b[KArkErrors\u001b[m\u001b[K, Traversal, TraversalError, type ArkSchemaConfig, type ArkSchemaScopeConfig, type JsonSchema } from \"@ark/schema\";\r\n"]
[330.248612, "o", "\u001b[?2004hroot@6dad3eb8-6d44-497d-9379-660eb77182d6:/home/user/myproject# "]
