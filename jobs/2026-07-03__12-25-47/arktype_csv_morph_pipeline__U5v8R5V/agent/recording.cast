[237.023443, "i", "cat > /home/user/myproject/test_morph_ctx.ts << 'EOF'\nimport { type, ArkError } from 'arktype'\nimport type { Traversal } from '@ark/schema'\n\nconst UserT = type({\n  id: 'string.uuid',\n  age: type.pipe(type('string.integer.parse'), type('0 <= number <= 150')),\n  email: 'string.email',\n  signupAt: 'string.date.iso.parse'\n})\n\nconst parseCsv = (csv: string, ctx: Traversal): Array<{ id: string; age: string; email: string; signupAt: string }> => {\n  if (csv.length === 0) {\n    return ctx.errorFromContext({ code: 'predicate', description: 'input is empty', predicate: () => false, actual: csv })\n  }\n  const lines = csv.split('\\n')\n  const header = lines[0]\n  if (header !== 'id,age,email,signupAt') {\n    return ctx.errorFromContext({ code: 'predicate', description: 'header row must be exactly \"id,age,email,signupAt\"', predicate: () => false, actual: csv })\n  }\n  const records = []\n  for (let i = 1; i < lines.length; i++) {\n    if (lines[i].length === 0) continue\n    const cells = lines[i].split(',')\n    if (cells.length !== 4) {\n      return ctx.errorFromContext({ code: 'predicate', description: `row ${i + 1} has ${cells.length} columns, expected 4`, predicate: () => false, actual: csv })\n    }\n    records.push({ id: cells[0], age: cells[1], email: cells[2], signupAt: cells[3] })\n  }\n  return records\n}\n\nconst StringT = type('string')\nconst PipelineT = type.pipe(StringT, parseCsv, UserT.array())\n\n// Test empty input\nconsole.log('--- empty ---')\nlet r = PipelineT('')\nconsole.log('is errors:', r instanceof type.errors)\nif (r instanceof type.errors) console.log('Summary:', r.summary)\n\n// Test bad header\nconsole.log('--- bad header ---')\nr = PipelineT('id,age,email,name\\n1,2,3,4')\nconsole.log('is errors:', r instanceof type.errors)\nif (r instanceof type.errors) console.log('Summary:', r.summary)\n\n// Test wrong column count\nconsole.log('--- wrong columns ---')\nr = PipelineT('id,age,email,signupAt\\n1,2,3')\nconsole.log('is errors:', r instanceof type.errors)\nif (r instanceof type.errors) console.log('Summary:', r.summary)\nEOF\n"]
