[398.645413, "o", "// This is your Prisma schema file,\r\n// learn more about it in the docs: https://pris.ly/d/prisma-schema\r\n\r\ngenerator client {\r\n  provider = \"prisma-client-js\"\r\n}\r\n\r\ndatasource db {\r\n  provider = \"sqlite\"\r\n  url      = env(\"DATABASE_URL\")\r\n}\r\n\r\nmodel User {\r\n  id    Int    @id @default(REDACTEDincrement())\r\n  email String @unique\r\n  name  String?\r\n  posts Post[]\r\n}\r\n\r\nmodel Post {\r\n  id       Int       @id @default(REDACTEDincrement())\r\n  title    String\r\n  authorId Int\r\n  author   User      @relation(fields: [authorId], references: [id])\r\n  postTags PostTag[]\r\n}\r\n\r\nmodel Tag {\r\n  id       Int       @id @default(REDACTEDincrement())\r\n"]
[398.645476, "o", "  name     String    @unique\r\n  postTags PostTag[]\r\n}\r\n\r\nmodel PostTag {\r\n  postId  Int\r\n  tagId   Int\r\n  addedAt DateTime @default(now())\r\n  post    Post     @relation(fields: [postId], references: [id])\r\n  tag     Tag      @relation(fields: [tagId], references: [id])\r\n\r\n  @@id([postId, tagId])\r\n}\r\n"]
