[162.717093, "i", "python3 << 'PYEOF'\ntest_script = '''extends SceneTree\n\nfunc _initialize() -> void:\n    print(\"Loading scene...\")\n    var scene = load(\"res://scenes/Main.tscn\")\n    if scene == null:\n        print(\"FAIL: could not load scene\")\n        quit(1)\n        return\n    var inst = scene.instantiate()\n    if inst == null:\n        print(\"FAIL: could not instantiate scene\")\n        quit(1)\n        return\n    root.add_child(inst)\n    print(\"Instance added to tree\")\n    \n    print(\"Has build: \", inst.has_method(\"build\"))\n    print(\"Has place: \", inst.has_method(\"place\"))\n    print(\"Has remove: \", inst.has_method(\"remove\"))\n    print(\"Has get_item: \", inst.has_method(\"get_item\"))\n    \n    inst.build()\n    print(\"Build called\")\n    \n    var gm = inst.get_node(\"GridMap\")\n    print(\"GridMap: \", gm)\n    print(\"mesh_library: \", gm.mesh_library)\n    if gm.mesh_library != null:\n        var item_list = gm.mesh_library.get_item_list()\n        print(\"item_list: \", item_list)\n        for id in item_list:\n            var m = gm.mesh_library.get_item_mesh(id)\n            print(\"  mesh \", id, \": \", m)\n            if m != null and m.get_surface_count() > 0:\n                var mat = m.surface_get_material(0)\n                if mat != null:\n                    print(\"    albedo: \", mat.albedo_color)\n    \n    print(\"cell (0,0,0): \", inst.get_item(0, 0, 0))\n    print(\"cell (1,0,0): \", inst.get_item(1, 0, 0))\n    print(\"cell (2,0,0): \", inst.get_item(2, 0, 0))\n    print(\"cell (0,1,0): \", inst.get_item(0, 1, 0))\n    print(\"cell (10,10,10): \", inst.get_item(10, 10, 10))\n    \n    inst.place(2, 5, 5, 5)\n    print(\"after place(2,5,5,5): \", inst.get_item(5, 5, 5))\n    \n    inst.remove(0, 0, 0)\n    print(\"after remove(0,0,0): \", inst.get_item(0, 0, 0))\n    \n    inst.build()\n    print(\"after rebuild (0,0,0): \", inst.get_item(0, 0, 0))\n    print(\"after rebuild (5,5,5): \", inst.get_item(5, 5, 5))\n    \n    print(\"ALL TESTS DONE\")\n    quit(0)\n'''\nwith open('/home/user/myproject/test_level.gd', 'w') as f:\n    f.write(test_script)\nprint('written')\nPYEOF\n"]
