[79.54149, "i", "cat > /tmp/test_level.gd << 'EOF'\nextends SceneTree\n\nfunc _initialize() -> void:\n    print(\"Loading scene...\")\n    var scene := load(\"res://scenes/Main.tscn\")\n    if scene == null:\n        print(\"FAIL: could not load scene\")\n        quit(1)\n        return\n    var inst := scene.instantiate()\n    if inst == null:\n        print(\"FAIL: could not instantiate scene\")\n        quit(1)\n        return\n    root.add_child(inst)\n    print(\"Instance added to tree\")\n    \n    # Check script\n    var script = inst.get_script()\n    print(\"Script: \", script)\n    print(\"Has build: \", inst.has_method(\"build\"))\n    print(\"Has place: \", inst.has_method(\"place\"))\n    print(\"Has remove: \", inst.has_method(\"remove\"))\n    print(\"Has get_item: \", inst.has_method(\"get_item\"))\n    \n    # Call build\n    inst.build()\n    print(\"Build called\")\n    \n    # Check GridMap\n    var gm = inst.get_node(\"GridMap\")\n    print(\"GridMap: \", gm)\n    print(\"mesh_library: \", gm.mesh_library)\n    if gm.mesh_library != null:\n        print(\"has item 0: \", gm.mesh_library.has_item(0))\n        print(\"has item 1: \", gm.mesh_library.has_item(1))\n        print(\"has item 2: \", gm.mesh_library.has_item(2))\n        var m0 = gm.mesh_library.get_item_mesh(0)\n        print(\"mesh 0: \", m0)\n        if m0 != null and m0.get_surface_count() > 0:\n            var mat0 = m0.surface_get_material(0)\n            print(\"mat0: \", mat0, \" albedo: \", mat0.albedo_color if mat0 else \"null\")\n        var m1 = gm.mesh_library.get_item_mesh(1)\n        if m1 != null and m1.get_surface_count() > 0:\n            var mat1 = m1.surface_get_material(0)\n            print(\"mat1: \", mat1, \" albedo: \", mat1.albedo_color if mat1 else \"null\")\n        var m2 = gm.mesh_library.get_item_mesh(2)\n        if m2 != null and m2.get_surface_count() > 0:\n            var mat2 = m2.surface_get_material(0)\n            print(\"mat2: \", mat2, \" albedo: \", mat2.albedo_color if mat2 else \"null\")\n    \n    # Check get_item\n    print(\"cell (0,0,0): \", inst.get_item(0, 0, 0))\n    print(\"cell (1,0,0): \", inst.get_item(1, 0, 0))\n    print(\"cell (2,0,0): \", inst.get_item(2, 0, 0))\n    print(\"cell (0,1,0): \", inst.get_item(0, 1, 0))\n    print(\"cell (10,10,10): \", inst.get_item(10, 10, 10))\n    \n    # Test place\n    inst.place(2, 5, 5, 5)\n    print(\"after place(2,5,5,5): \", inst.get_item(5, 5, 5))\n    \n    # Test remove\n    inst.remove(0, 0, 0)\n    print(\"after remove(0,0,0): \", inst.get_item(0, 0, 0))\n    \n    # Test calling build again (should reset)\n    inst.build()\n    print(\"after rebuild: (0,0,0): \", inst.get_item(0, 0, 0))\n    print(\"after rebuild: (5,5,5): \", inst.get_item(5, 5, 5))\n    \n    print(\"ALL TESTS DONE\")\n    quit(0)\nEOF\n"]
