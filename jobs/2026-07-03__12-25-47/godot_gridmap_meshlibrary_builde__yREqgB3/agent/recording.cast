[45.601337, "o", "rm /home/user/myproject/scripts/LevelBuilder.gd\r\n\u001b[?2004l\r"]
[45.602999, "o", "\u001b[?2004h"]
[45.603064, "o", "root@be573ba1-de42-4d4c-aef7-9938ce36a2de:~# "]
[45.986147, "i", "python3 << 'PYEOF'\ncontent = '''extends Node3D\n\nconst LEVEL_PATH := \"res://data/level.json\"\n\nvar grid_map: GridMap\n\nfunc _ready() -> void:\n    grid_map = get_node_or_null(\"GridMap\") as GridMap\n\nfunc _ensure_grid_map() -> GridMap:\n    if grid_map == null:\n        grid_map = get_node_or_null(\"GridMap\") as GridMap\n    return grid_map\n\nfunc _make_box_mesh(color: Color) -> BoxMesh:\n    var mesh := BoxMesh.new()\n    mesh.size = Vector3(1.0, 1.0, 1.0)\n    var mat := StandardMaterial3D.new()\n    mat.albedo_color = color\n    mesh.surface_set_material(0, mat)\n    mesh.material = mat\n    return mesh\n\nfunc _build_mesh_library() -> MeshLibrary:\n    var lib := MeshLibrary.new()\n    for id in range(3):\n        lib.create_item(id)\n    var color0 := Color(0.9, 0.1, 0.1)\n    var color1 := Color(0.1, 0.9, 0.1)\n    var color2 := Color(0.1, 0.3, 0.95)\n    lib.set_item_mesh(0, _make_box_mesh(color0))\n    lib.set_item_mesh(1, _make_box_mesh(color1))\n    lib.set_item_mesh(2, _make_box_mesh(color2))\n    var shape := BoxShape3D.new()\n    shape.size = Vector3(1.0, 1.0, 1.0)\n    for id in range(3):\n        lib.set_item_shapes(id, [shape])\n    return lib\n\nfunc _load_level_cells() -> Array:\n    var f := FileAccess.open(LEVEL_PATH, FileAccess.READ)\n    if f == null:\n        push_error(\"Failed to open level file: %s (err %d)\" % [LEVEL_PATH, FileAccess.get_open_error()])\n        return []\n    var text := f.get_as_text()\n    f.close()\n    var parsed: Variant = JSON.parse_string(text)\n    if typeof(parsed) != TYPE_DICTIONARY:\n        push_error(\"level.json is not a JSON object\")\n        return []\n    var cells_v: Variant = parsed.get(\"cells\", [])\n    if typeof(cells_v) != TYPE_ARRAY:\n        return []\n    return cells_v\n\nfunc build() -> void:\n    var gm := _ensure_grid_map()\n    if gm == null:\n        push_error(\"GridMap child node not found\")\n        return\n    var lib := _build_mesh_library()\n    gm.mesh_library = lib\n    gm.clear()\n    var cells: Array = _load_level_cells()\n    for entry_v in cells:\n        if typeof(entry_v) != TYPE_DICTIONARY:\n            continue\n        var entry: Dictionary = entry_v\n        var id_i: int = int(entry.get(\"id\", -1))\n        var x: int = int(entry.get(\"x\", 0))\n        var y: int = int(entry.get(\"y\", 0))\n        var z: int = int(entry.get(\"z\", 0))\n        if id_i < 0 or id_i > 2:\n            continue\n        gm.set_cell_item(Vector3i(x, y, z), id_i)\n\nfunc place(item_id: int, gx: int, gy: int, gz: int) -> void:\n    var gm := _ensure_grid_map()\n    if gm == null:\n        return\n    gm.set_cell_item(Vector3i(gx, gy, gz), item_id)\n\nfunc remove(gx: int, gy: int, gz: int) -> void:\n    var gm := _ensure_grid_map()\n    if gm == null:\n        return\n    gm.set_cell_item(Vector3i(gx, gy, gz), GridMap.INVALID_CELL_ITEM)\n\nfunc get_item(gx: int, gy: int, gz: int) -> int:\n    var gm := _ensure_grid_map()\n    if gm == null:\n        return -1\n    return int(gm.get_cell_item(Vector3i(gx, gy, gz)))\n'''\nwith open('/home/user/myproject/scripts/LevelBuilder.gd', 'w') as f:\n    f.write(content)\nprint('written')\nPYEOF\n"]
