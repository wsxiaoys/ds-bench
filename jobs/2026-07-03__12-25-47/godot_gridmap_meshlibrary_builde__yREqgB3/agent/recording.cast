[45.991119, "o", "\u001b[?2004h> "]
[45.991224, "o", "    var shape := BoxShape3D.new()\r\n\u001b[?2004l\r"]
[45.99125, "o", "\u001b[?2004h> "]
[45.991399, "o", "    shape.size = Vector3(1.0, 1.0, 1.0)\r\n\u001b[?2004l\r"]
[45.991437, "o", "\u001b[?2004h> "]
[45.99152, "o", "    for id in range(3):\r\n\u001b[?2004l\r"]
[45.991545, "o", "\u001b[?2004h> "]
[45.991702, "o", "        lib.set_item_shapes(id, [shape])\r\n\u001b[?2004l\r"]
[45.991729, "o", "\u001b[?2004h> "]
[45.991803, "o", "    return lib\r\n\u001b[?2004l\r\u001b[?2004h"]
[45.991828, "o", "> \r\n\u001b[?2004l\r"]
[45.991886, "o", "\u001b[?2004h> "]
[45.991993, "o", "func _load_level_cells() -> Array:\r\n\u001b[?2004l\r"]
[45.992019, "o", "\u001b[?2004h> "]
[45.992225, "o", "    var f := FileAccess.open(LEVEL_PATH, FileAccess.READ)\r\n\u001b[?2004l\r"]
[45.99226, "o", "\u001b[?2004h> "]
[45.992326, "o", "    if f == null:\r\n\u001b[?2004l\r"]
[45.992353, "o", "\u001b[?2004h> "]
[45.992721, "o", "        push_error(\"Failed to open level file: %s (err %d)\" % [LEVEL_PATH, FileAccess.get_open_error()])\r\n\u001b[?2004l\r"]
[45.992749, "o", "\u001b[?2004h> "]
[45.992823, "o", "        return []\r\n\u001b[?2004l\r"]
[45.992858, "o", "\u001b[?2004h> "]
[45.992968, "o", "    var text := f.get_as_text()\r\n\u001b[?2004l\r"]
[45.992994, "o", "\u001b[?2004h> "]
[45.993067, "o", "    f.close()\r\n\u001b[?2004l\r\u001b[?2004h"]
[45.993093, "o", "> "]
[45.993264, "o", "    var parsed: Variant = JSON.parse_string(text)\r\n\u001b[?2004l\r"]
[45.993291, "o", "\u001b[?2004h> "]
[45.993449, "o", "    if typeof(parsed) != TYPE_DICTIONARY:\r\n\u001b[?2004l\r"]
[45.993475, "o", "\u001b[?2004h> "]
[45.993676, "o", "        push_error(\"level.json is not a JSON object\")\r\n\u001b[?2004l\r"]
[45.993714, "o", "\u001b[?2004h> "]
[45.993777, "o", "        return []\r\n\u001b[?2004l\r"]
[45.993802, "o", "\u001b[?2004h> "]
[45.993991, "o", "    var cells_v: Variant = parsed.get(\"cells\", [])\r\n\u001b[?2004l\r"]
[45.994018, "o", "\u001b[?2004h> "]
[45.994155, "o", "    if typeof(cells_v) != TYPE_ARRAY:\r\n\u001b[?2004l\r"]
[45.994181, "o", "\u001b[?2004h> "]
[45.994255, "o", "        return []\r\n\u001b[?2004l\r"]
[45.99429, "o", "\u001b[?2004h> "]
[45.994364, "o", "    return cells_v\r\n\u001b[?2004l\r"]
[45.994398, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[45.994436, "o", "> "]
[45.994494, "o", "func build() -> void:\r\n\u001b[?2004l\r"]
[45.994519, "o", "\u001b[?2004h> "]
[45.994639, "o", "    var gm := _ensure_grid_map()\r\n\u001b[?2004l\r"]
[45.994664, "o", "\u001b[?2004h> "]
[45.994734, "o", "    if gm == null:\r\n\u001b[?2004l\r"]
[45.994759, "o", "\u001b[?2004h> "]
[45.994931, "o", "        push_error(\"GridMap child node not found\")\r\n\u001b[?2004l\r"]
[45.994957, "o", "\u001b[?2004h> "]
[45.995011, "o", "        return\r\n\u001b[?2004l\r"]
[45.995036, "o", "\u001b[?2004h> "]
[45.995169, "o", "    var lib := _build_mesh_library()\r\n\u001b[?2004l\r"]
[45.995194, "o", "\u001b[?2004h> "]
[45.995294, "o", "    gm.mesh_library = lib\r\n\u001b[?2004l\r"]
[45.995319, "o", "\u001b[?2004h> "]
[45.995368, "o", "    gm.clear()\r\n\u001b[?2004l\r"]
[45.995394, "o", "\u001b[?2004h> "]
[45.995541, "o", "    var cells: Array = _load_level_cells()\r\n\u001b[?2004l\r"]
[45.995576, "o", "\u001b[?2004h> "]
[45.995662, "o", "    for entry_v in cells:\r\n\u001b[?2004l\r"]
[45.995704, "o", "\u001b[?2004h> "]
[45.995848, "o", "        if typeof(entry_v) != TYPE_DICTIONARY:\r\n\u001b[?2004l\r"]
[45.995874, "o", "\u001b[?2004h> "]
[45.995952, "o", "            continue\r\n\u001b[?2004l\r"]
[45.995977, "o", "\u001b[?2004h> "]
[45.996111, "o", "        var entry: Dictionary = entry_v\r\n\u001b[?2004l\r"]
[45.996136, "o", "\u001b[?2004h> "]
[45.996306, "o", "        var id_i: int = int(entry.get(\"id\", -1))\r\n\u001b[?2004l\r"]
[45.996342, "o", "\u001b[?2004h> "]
[45.996486, "o", "        var x: int = int(entry.get(\"x\", 0))\r\n\u001b[?2004l\r\u001b[?2004h"]
[45.996512, "o", "> "]
[45.996719, "o", "        var y: int = int(entry.get(\"y\", 0))\r\n\u001b[?2004l\r\u001b[?2004h> "]
[45.996835, "o", "        var z: int = int(entry.get(\"z\", 0))\r\n\u001b[?2004l\r"]
[45.996864, "o", "\u001b[?2004h> "]
[45.996983, "o", "        if id_i < 0 or id_i > 2:\r\n\u001b[?2004l\r"]
[45.997014, "o", "\u001b[?2004h> "]
[45.997118, "o", "            continue\r\n\u001b[?2004l\r\u001b[?2004h"]
[45.997162, "o", "> "]
[45.997325, "o", "        gm.set_cell_item(Vector3i(x, y, z), id_i)\r\n\u001b[?2004l\r"]
[45.997362, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[45.99739, "o", "\u001b[?2004h"]
[45.997461, "o", "> "]
[45.997617, "o", "func place(item_id: int, gx: int, gy: int, gz: int) -> void:\r\n\u001b[?2004l\r\u001b[?2004h"]
[45.997653, "o", "> "]
[45.997777, "o", "    var gm := _ensure_grid_map()\r\n\u001b[?2004l\r"]
[45.997807, "o", "\u001b[?2004h> "]
[45.997893, "o", "    if gm == null:\r\n\u001b[?2004l\r\u001b[?2004h"]
[45.997918, "o", "> "]
[45.997981, "o", "        return\r\n\u001b[?2004l\r"]
[45.998035, "o", "\u001b[?2004h> "]
[45.998188, "o", "    gm.set_cell_item(Vector3i(gx, gy, gz), item_id)\r\n\u001b[?2004l\r"]
[45.998211, "o", "\u001b[?2004h> \r\n"]
[45.998264, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[45.998427, "o", "func remove(gx: int, gy: int, gz: int) -> void:\r\n\u001b[?2004l\r"]
[45.998449, "o", "\u001b[?2004h> "]
[45.998583, "o", "    var gm := _ensure_grid_map()\r\n\u001b[?2004l\r"]
[45.998607, "o", "\u001b[?2004h> "]
[45.998694, "o", "    if gm == null:\r\n\u001b[?2004l\r"]
[45.998719, "o", "\u001b[?2004h> "]
[45.998786, "o", "        return\r\n\u001b[?2004l\r"]
[45.998824, "o", "\u001b[?2004h> "]
[45.999056, "o", "    gm.set_cell_item(Vector3i(gx, gy, gz), GridMap.INVALID_CELL_ITEM)\r\n\u001b[?2004l\r"]
[45.999078, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[45.999137, "o", "\u001b[?2004h> "]
[45.999306, "o", "func get_item(gx: int, gy: int, gz: int) -> int:\r\n\u001b[?2004l\r\u001b[?2004h"]
[45.999329, "o", "> "]
[45.999448, "o", "    var gm := _ensure_grid_map()\r\n\u001b[?2004l\r"]
[45.999486, "o", "\u001b[?2004h> "]
[45.99955, "o", "    if gm == null:\r\n\u001b[?2004l\r"]
[45.999573, "o", "\u001b[?2004h> "]
[45.999662, "o", "        return -1\r\n\u001b[?2004l\r"]
[45.999686, "o", "\u001b[?2004h> "]
[45.999883, "o", "    return int(gm.get_cell_item(Vector3i(gx, gy, gz)))\r\n\u001b[?2004l\r"]
[45.999921, "o", "\u001b[?2004h> "]
[45.999959, "o", "'''\r\n\u001b[?2004l\r\u001b[?2004h"]
[45.999981, "o", "> "]
[46.000215, "o", "with open('/home/user/myproject/scripts/LevelBuilder.gd', 'w') as f:\r\n\u001b[?2004l\r"]
[46.000238, "o", "\u001b[?2004h> "]
[46.000327, "o", "    f.write(content)\r\n\u001b[?2004l\r"]
[46.000348, "o", "\u001b[?2004h> "]
[46.000434, "o", "print('written')\r\n\u001b[?2004l\r\u001b[?2004h"]
[46.000472, "o", "> "]
[46.00053, "o", "PYEOF\r\n\u001b[?2004l\r"]
[46.012418, "o", "written\r\n"]
[46.013988, "o", "\u001b[?2004hroot@be573ba1-de42-4d4c-aef7-9938ce36a2de:~# "]
[46.355186, "i", "cat /home/user/myproject/scripts/LevelBuilder.gd | head -20\n"]
[46.355546, "o", "cat /home/user/myproject/scripts/LevelBuilder.gd | head -20\r\n\u001b[?2004l\r"]
[46.356458, "o", "extends Node3D\r\n\r\nconst LEVEL_PATH := \"res://data/level.json\"\r\n\r\nvar grid_map: GridMap\r\n\r\nfunc _ready() -> void:\r\n    grid_map = get_node_or_null(\"GridMap\") as GridMap\r\n\r\nfunc _ensure_grid_map() -> GridMap:\r\n"]
[46.356524, "o", "    if grid_map == null:\r\n        grid_map = get_node_or_null(\"GridMap\") as GridMap\r\n    return grid_map\r\n\r\nfunc _make_box_mesh(color: Color) -> BoxMesh:\r\n    var mesh := BoxMesh.new()\r\n    mesh.size = Vector3(1.0, 1.0, 1.0)\r\n    var mat := StandardMaterial3D.new()\r\n    mat.albedo_color = color\r\n    mesh.surface_set_material(0, mat)\r\n"]
[46.356653, "o", "\u001b[?2004h"]
[46.356677, "o", "root@be573ba1-de42-4d4c-aef7-9938ce36a2de:~# "]
