[53.553913, "o", "[\r\n  {\r\n    \"property\": \"Name\",\r\n    \"value\": \"harbor-interop-zrg4e09aor\"\r\n  },\r\n  {\r\n    \"property\": \"Number of Objects\",\r\n    \"value\": \"0\"\r\n  },\r\n  {\r\n    \"property\": \"Total Size\",\r\n    \"value\": \"0 B\"\r\n  },\r\n  {\r\n    \"property\": \"All Versions Count\",\r\n    \"value\": \"0\"\r\n  },\r\n  {\r\n    \"property\": \"Default Tier\",\r\n    \"value\": \"STANDARD\"\r\n  },\r\n  {\r\n    \"property\": \"Locations\",\r\n    \"value\": \"Global\"\r\n  },\r\n  {\r\n    \"property\": \"Snapshots Enabled\",\r\n    \"value\": \"Yes\"\r\n  },\r\n  {\r\n    \"property\": \"Delete Protection\",\r\n    \"value\": \"No\"\r\n  },\r\n  {\r\n    \"property\": \"Soft Delete\",\r\n    \"value\": \"Disabled\"\r\n  },\r\n  {\r\n    \"property\": \"Allow Object ACL\",\r\n    \"value\": \"No\"\r\n  },\r\n  {\r\n    \"property\": \"Custom Domain\",\r\n    \"value\": \"None\"\r\n  },\r\n  {\r\n    \"property\": \"Has Forks\",\r\n    \"value\": \"No\"\r\n  }\r\n]\r\n"]
[53.627673, "o", "\u001b[?2004hroot@bc986082-8e1c-4e44-bb65-6ed63b12cd1b:~# "]
[57.716037, "i", "tigris buckets create --help\n"]
[57.716526, "o", "tigris buckets create --help\r\n\u001b[?2004l\r"]
[57.907845, "o", "Usage: tigris buckets create|c [options] [command] [name]\r\n\r\nCreate a new bucket with optional access, tier, and location settings\r\n\r\nArguments:\r\n  name                                      Name of the bucket\r\n\r\nOptions:\r\n  -a, --access <value>                      Access level (default: \"private\")\r\n  --public                                  Shorthand for --access public\r\n  -s, --enable-snapshots                    Enable snapshots for the bucket (default: false)\r\n  --allow-object-acl                        Allow per-object ACLs on the bucket (default: false)\r\n  --enable-directory-listing                Enable directory listing, relevant for public buckets (default: false)\r\n  -t, --default-tier <value>                Choose the default tier for the bucket (default: \"STANDARD\")\r\n  -l, --locations <value>                   Location for the bucket (default: \"global\")\r\n  --fork, --fork-of [value]                 Create this bucket as a fork (copy-on-write clone) of the named source bucket\r\n  --source-snap, --source-snapshot [value]  Fork from a specific snapshot of the source bucket. Accepts a snapshot version string or any UNIX\r\n                                            nanosecond-precision timestamp (e.g. 1765889000501544464). Requires --fork-of\r\n  --format <value>                          Output format (default: \"table\")\r\n  --json                                    Output as JSON\r\n  -y, --yes                                 Skip confirmation prompts\r\n  -h, --help                                display help for command\r\n\r\nCommands:\r\n  help                                      Show help for this command\r\n"]
[57.914, "o", "\u001b[?2004hroot@bc986082-8e1c-4e44-bb65-6ed63b12cd1b:~# "]
[61.525631, "i", "tigris --help\n"]
[61.52591, "o", "tigris --help\r\n\u001b[?2004l\r"]
[61.632378, "o", "Usage: tigris [options] [command]\r\n\r\nCommand line interface for Tigris\r\n\r\nOptions:\r\n  -V, --version                   output the version number\r\n  -h, --help                      display help for command\r\n\r\nCommands:\r\n  configure|c [options]           Save access-key credentials to ~/.tigris/config.json for persistent use across all commands\r\n  login|l [options]               Start a session via OAuth (default) or temporary credentials. Session state is cleared on logout\r\n  whoami|w [options]              Print the currently authenticated user, organization, and auth method\r\n  update [options]                Update the CLI to the latest version\r\n  logout [options]                End the current session and clear login state. Credentials saved via 'configure' are kept\r\n  credentials|creds               Test whether your current credentials can reach Tigris and optionally verify access to a specific bucket\r\n  ls|list [options] [path]        List all buckets (no arguments) or objects under a bucket/prefix path. Accepts bare names or t3:// URIs\r\n  mk|create [options] <path>      Create a bucket (bare name) or a folder inside a bucket (bucket/folder/ with trailing slash)\r\n  touch [options] <path>          Create an empty (zero-byte) object at the given bucket/key path\r\n  stat [options] [path]           Show storage stats (no args), bucket info, or object metadata\r\n  presign [options] <path>        Generate a presigned URL for temporary access to an object without credentials\r\n  cp|copy [options] <src> <dest>  Copy files between local filesystem and Tigris, or between paths within Tigris. At least one side must be a remote t3:// path\r\n  mv|move [options] <src> <dest>  Move (rename) objects within Tigris. Both source and destination must be remote t3:// paths\r\n  rm|remove [options] <path>      Remove a bucket, folder, or object from Tigris. A bare bucket name deletes the bucket itself\r\n  bundle [options] <bucket>       Download multiple objects as a streaming tar archive in a single request. Designed for batch workloads that need many objects\r\n                                  without per-object HTTP overhead\r\n  organizations|orgs              List, create, and switch between organizations. An organization is a workspace that contains your resources like buckets and\r\n                                  access keys\r\n  buckets|b                       Create, inspect, update, and delete buckets. Buckets are top-level containers that hold objects\r\n  snapshots|s                     List and take snapshots. A snapshot is a point-in-time, read-only copy of a bucket's state\r\n  objects|o                       Low-level object operations for listing, downloading, uploading, and deleting individual objects in a bucket\r\n  access-keys|keys                Create, list, inspect, delete, and assign roles to access keys. Access keys are credentials used for programmatic API access\r\n  iam                             Identity and Access Management - manage policies, users, and permissions\r\n  help                            Show general help\r\n  version                         Show the CLI version\r\n"]
[61.637811, "o", "\u001b[?2004hroot@bc986082-8e1c-4e44-bb65-6ed63b12cd1b:~# "]
[65.388501, "i", "tigris objects --help\n"]
[65.388733, "o", "tigris objects --help\r\n\u001b[?2004l\r"]
[65.51852, "o", "Usage: tigris objects|o [options] [command]\r\n\r\nLow-level object operations for listing, downloading, uploading, and deleting individual objects in a bucket\r\n\r\nOptions:\r\n  -h, --help                                       display help for command\r\n\r\nCommands:\r\n  list|l [options] <bucket>                        List objects in a bucket, optionally filtered by a key prefix\r\n  list-versions|lv [options] <bucket>              List object versions and delete markers in a bucket (requires bucket versioning). Returns both arrays\r\n                                                   separately to match the S3 ListObjectVersions response\r\n  get|g [options] <bucket> [key]                   Download an object by key. Prints to stdout by default, or saves to a file with --output\r\n  put|p [options] <bucket> [key] [file]            Upload a local file — or data piped via stdin — as an object. Content-type is REDACTED-detected from the file\r\n                                                   extension unless overridden\r\n  delete|d [options] <bucket> [key]                Delete one or more objects by key from the given bucket. On a versioned bucket, the default creates a delete\r\n                                                   marker; use --version-id or --all-versions to hard-delete versions\r\n  set|s [options] <bucket> [key]                   (Deprecated) Update settings on an existing object such as access level. Use `tigris objects set-access` for\r\n                                                   ACL changes and `tigris mv` to rename\r\n  set-access|sa [options] <bucket> [key] [access]  Set the access level (public or private) on an existing object\r\n  info|i [options] <bucket> [key]                  Show metadata for an object (content type, size, modified date)\r\n  restore|rs [options] <bucket> [key]              Restore an archived object (e.g. one in the GLACIER tier) into an actively-readable copy for a number of days\r\n  restore-info|ri [options] <bucket> [key]         Show the restore state of an archived object (archived, in-progress, or restored)\r\n  help                                             Show help for this command\r\n"]
[65.523993, "o", "\u001b[?2004hroot@bc986082-8e1c-4e44-bb65-6ed63b12cd1b:~# "]
[65.875185, "i", "tigris cp --help\n"]
[65.875384, "o", "tigris cp --help\r\n\u001b[?2004l\r"]
[66.01459, "o", "Usage: tigris cp|copy [options] [command] <src> <dest>\r\n\r\nCopy files between local filesystem and Tigris, or between paths within Tigris. At least one side must be a remote t3:// path\r\n\r\nArguments:\r\n  src                   Source path. Use t3:// (or tigris://) prefix for remote Tigris paths, bare paths for local files. At least one side must be remote.\r\n                        Quote wildcard patterns to prevent shell expansion\r\n  dest                  Destination path. Use t3:// (or tigris://) prefix for remote Tigris paths, bare paths for local files\r\n\r\nOptions:\r\n  -r, --recursive       Copy directories recursively\r\n  -a, --access <value>  Access level for uploaded objects (only applies to local-to-remote uploads)\r\n  --format <value>      Output format (default: \"table\")\r\n  --json                Output as JSON\r\n  -y, --yes             Skip confirmation prompts\r\n  -h, --help            display help for command\r\n\r\nCommands:\r\n  help                  Show help for this command\r\n"]
[66.020137, "o", "\u001b[?2004hroot@bc986082-8e1c-4e44-bb65-6ed63b12cd1b:~# "]
[70.706598, "i", "tigris objects put --help\n"]
[70.706797, "o", "tigris objects put --help\r\n\u001b[?2004l\r"]
[70.834362, "o", "Usage: tigris objects put|p [options] [command] <bucket> [key] [file]\r\n\r\nUpload a local file — or data piped via stdin — as an object. Content-type is REDACTED-detected from the file extension unless overridden\r\n\r\nArguments:\r\n  bucket                      Name of the bucket, or a full path (t3://bucket/key)\r\n  key                         Key for the object (omit if bucket contains the full path)\r\n  file                        Path to the local file to upload. Omit to read the object data from stdin (piped input)\r\n\r\nOptions:\r\n  -a, --access <value>        Access level (default: \"private\")\r\n  -t, --content-type [value]  Content type (REDACTED-detected from extension if omitted)\r\n  --format <value>            Output format (default: \"table\")\r\n  --json                      Output as JSON\r\n  -y, --yes                   Skip confirmation prompts\r\n  -h, --help                  display help for command\r\n\r\nCommands:\r\n  help                        Show help for this command\r\n"]
[70.839545, "o", "\u001b[?2004hroot@bc986082-8e1c-4e44-bb65-6ed63b12cd1b:~# "]
[75.89944, "i", "tigris buckets lifecycle edit --help\n"]
[75.899674, "o", "tigris buckets lifecycle edit --help\r\n\u001b[?2004l\r"]
[76.030012, "o", "Usage: tigris buckets lifecycle edit|e [options] [command] <name> <id>\r\n\r\nEdit an existing lifecycle rule by its id. Only specified fields are changed\r\n\r\nArguments:\r\n  name                         Name of the bucket\r\n  id                           Lifecycle rule id (run `tigris buckets lifecycle list` to see ids)\r\n\r\nOptions:\r\n  -p, --prefix [value]         Replace the rule's key prefix\r\n  -s, --storage-class <value>  Replace the rule's transition target\r\n  -d, --days [value]           Replace the rule's transition days\r\n  --date [value]               Replace the rule's transition date (ISO-8601)\r\n  --expire-days [value]        Replace the rule's expiration days\r\n  --expire-date [value]        Replace the rule's expiration date (ISO-8601)\r\n  --enable                     Enable the rule\r\n  --disable                    Disable the rule (does not remove it)\r\n  --format <value>             Output format (default: \"table\")\r\n  --json                       Output as JSON\r\n  -y, --yes                    Skip confirmation prompts\r\n  -h, --help                   display help for command\r\n\r\nCommands:\r\n  help                         Show help for this command\r\n"]
[76.035695, "o", "\u001b[?2004hroot@bc986082-8e1c-4e44-bb65-6ed63b12cd1b:~# "]
