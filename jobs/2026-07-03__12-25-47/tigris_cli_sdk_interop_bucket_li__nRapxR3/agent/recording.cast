[76.887666, "o", "\u001b[?2004hroot@bc986082-8e1c-4e44-bb65-6ed63b12cd1b:~# "]
[83.641305, "i", "tigris mk --help\n"]
[83.641538, "o", "tigris mk --help\r\n\u001b[?2004l\r"]
[83.793801, "o", "Usage: tigris mk|create [options] [command] <path>\r\n\r\nCreate a bucket (bare name) or a folder inside a bucket (bucket/folder/ with trailing slash)\r\n\r\nArguments:\r\n  path                                      A bucket name or bucket/folder/ path. Trailing slash creates a folder inside the bucket. Supports t3:// and\r\n                                            tigris:// prefixes\r\n\r\nOptions:\r\n  -a, --access <value>                      Access level (only applies when creating a bucket) (default: \"private\")\r\n  --public                                  Shorthand for --access public (only applies when creating a bucket)\r\n  -s, --enable-snapshots                    Enable snapshots for the bucket (only applies when creating a bucket) (default: false)\r\n  --allow-object-acl                        Allow per-object ACLs on the bucket (only applies when creating a bucket) (default: false)\r\n  --enable-directory-listing                Enable directory listing, relevant for public buckets (only applies when creating a bucket) (default: false)\r\n  -t, --default-tier <value>                Default storage tier (only applies when creating a bucket) (default: \"STANDARD\")\r\n  -l, --locations <value>                   Location for the bucket (only applies when creating a bucket) (default: \"global\")\r\n  --fork, --fork-of [value]                 Create this bucket as a fork (copy-on-write clone) of the named source bucket\r\n  --source-snap, --source-snapshot [value]  Fork from a specific snapshot of the source bucket. Accepts a snapshot version string or any UNIX\r\n                                            nanosecond-precision timestamp (e.g. 1765889000501544464). Requires --fork-of\r\n  --format <value>                          Output format (default: \"table\")\r\n  --json                                    Output as JSON\r\n  -y, --yes                                 Skip confirmation prompts\r\n  -h, --help                                display help for command\r\n\r\nCommands:\r\n  help                                      Show help for this command\r\n"]
[83.800278, "o", "\u001b[?2004hroot@bc986082-8e1c-4e44-bb65-6ed63b12cd1b:~# "]
[84.204036, "i", "tigris create --help\n"]
[84.204263, "o", "tigris create --help\r\n\u001b[?2004l\r"]
[84.331549, "o", "Usage: tigris mk|create [options] [command] <path>\r\n\r\nCreate a bucket (bare name) or a folder inside a bucket (bucket/folder/ with trailing slash)\r\n\r\nArguments:\r\n  path                                      A bucket name or bucket/folder/ path. Trailing slash creates a folder inside the bucket. Supports t3:// and\r\n                                            tigris:// prefixes\r\n\r\nOptions:\r\n  -a, --access <value>                      Access level (only applies when creating a bucket) (default: \"private\")\r\n  --public                                  Shorthand for --access public (only applies when creating a bucket)\r\n  -s, --enable-snapshots                    Enable snapshots for the bucket (only applies when creating a bucket) (default: false)\r\n  --allow-object-acl                        Allow per-object ACLs on the bucket (only applies when creating a bucket) (default: false)\r\n  --enable-directory-listing                Enable directory listing, relevant for public buckets (only applies when creating a bucket) (default: false)\r\n  -t, --default-tier <value>                Default storage tier (only applies when creating a bucket) (default: \"STANDARD\")\r\n  -l, --locations <value>                   Location for the bucket (only applies when creating a bucket) (default: \"global\")\r\n  --fork, --fork-of [value]                 Create this bucket as a fork (copy-on-write clone) of the named source bucket\r\n  --source-snap, --source-snapshot [value]  Fork from a specific snapshot of the source bucket. Accepts a snapshot version string or any UNIX\r\n                                            nanosecond-precision timestamp (e.g. 1765889000501544464). Requires --fork-of\r\n  --format <value>                          Output format (default: \"table\")\r\n  --json                                    Output as JSON\r\n  -y, --yes                                 Skip confirmation prompts\r\n  -h, --help                                display help for command\r\n\r\nCommands:\r\n  help                                      Show help for this command\r\n"]
