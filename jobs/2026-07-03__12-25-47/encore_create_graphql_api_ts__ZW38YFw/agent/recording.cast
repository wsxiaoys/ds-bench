[387.413282, "o", "> "]
[387.413317, "o", "      });\r\n\u001b[?2004l\r\u001b[?2004h"]
[387.413338, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h"]
[387.41336, "o", "> "]
[387.413433, "o", "      resp.statusCode = 200;\r\n\u001b[?2004l\r"]
[387.413453, "o", "\u001b[?2004h> "]
[387.413605, "o", "      resp.setHeader(\"Content-Type\", \"application/json\");\r\n\u001b[?2004l\r"]
[387.413626, "o", "\u001b[?2004h> "]
[387.41373, "o", "      resp.end(JSON.stringify(result));\r\n\u001b[?2004l\r"]
[387.413751, "o", "\u001b[?2004h> "]
[387.413814, "o", "    } catch (err) {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[387.414018, "o", "      const message = err instanceof Error ? err.message : String(err);\r\n\u001b[?2004l\r"]
[387.41404, "o", "\u001b[?2004h> "]
