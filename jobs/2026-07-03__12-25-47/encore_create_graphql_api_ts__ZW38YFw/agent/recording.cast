[214.026171, "o", "encore app create graphql-api --lang ts --example https://github.com/encoredotdev/encore-ts-example-graphql --llm-rules=none 2>&1 | head -50\r\n\u001b[?2004l\r"]
[214.052139, "o", "Usage:\r\n  encore app create [name]\r\n\r\nFlags:\r\n      --example string     URL to example code to use.\r\n  -h, --help               help for create\r\n  -l, --lang string        Programming language to use for the app. One of (\"go\" or \"ts\"). (default \"\")\r\n  -r, --llm-rules string   Initialize the app with llm rules for a specific tool. One of (\"cursor\", \"claudecode\", \"vscode\", \"agentsmd\", or \"zed\").\r\n      --platform           whether to create the app with the Encore Platform (default true)\r\n\r\nGlobal Flags:\r\n      --trace string    file to write execution trace data to\r\n  -v, --verbose count   verbose output\r\n\r\ninvalid argument \"none\" for \"-r, --llm-rules\" flag: must be one of \"cursor\", \"claudecode\", \"vscode\", \"agentsmd\", or \"zed\"\r\n"]
[214.121185, "o", "\u001b[?2004hroot@c58dab8b-5041-4da9-9075-31c228cf1f9a:/home/user/graphql-api# "]
