[852.616949, "i", "cat > hello/graphql.ts << 'EOF'\nimport { api } from \"encore.dev/api\";\nimport {\n  GraphQLSchema,\n  GraphQLObjectType,\n  GraphQLString,\n  graphql,\n  parse,\n} from \"graphql\";\n\nconst schema = new GraphQLSchema({\n  query: new GraphQLObjectType({\n    name: \"Query\",\n    fields: {\n      hello: {\n        type: GraphQLString,\n        args: {\n          name: { type: GraphQLString },\n        },\n        resolve: (_root: unknown, args: { name?: string | null }) => {\n          const name = args.name ?? \"World\";\n          return `Hello, ${name}!`;\n        },\n      },\n    },\n  }),\n});\n\nasync function readBody(req: any): Promise<string> {\n  return new Promise((resolve, reject) => {\n    const chunks: Buffer[] = [];\n    req.on(\"data\", (chunk: Buffer) => chunks.push(chunk));\n    req.on(\"end\", () => resolve(Buffer.concat(chunks).toString(\"utf8\")));\n    req.on(\"error\", reject);\n  });\n}\n\nexport const graphql = api.raw(\n  { expose: true, method: \"*\", path: \"/graphql\" },\n  async (req: any, resp: any) => {\n    try {\n      let payload: { query?: string; operationName?: string | null; variables?: Record<string, unknown> | null };\n      if (req.method === \"GET\") {\n        const url = new URL(req.url ?? \"/graphql\", \"http://localhost\");\n        const query = url.searchParams.get(\"query\");\n        const operationName = url.searchParams.get(\"operationName\");\n        const variablesParam = url.searchParams.get(\"variables\");\n        payload = {\n          query: query ?? undefined,\n          operationName: operationName ?? null,\n          variables: variablesParam ? JSON.parse(variablesParam) : null,\n        };\n      } else {\n        const body = await readBody(req);\n        const contentType = (req.headers[\"content-type\"] ?? \"\") as string;\n        if (contentType.includes(\"application/graphql\")) {\n          payload = { query: body };\n        } else {\n          payload = JSON.parse(body);\n        }\n      }\n\n      if (!payload.query) {\n        resp.statusCode = 400;\n        resp.setHeader(\"Content-Type\", \"application/json\");\n        resp.end(JSON.stringify({ errors: [{ message: \"Missing query\" }] }));\n        return;\n      }\n\n      // Validate by parsing (catches syntax errors early).\n      parse(payload.query);\n\n      const result = await graphql({\n        schema,\n        source: payload.query,\n        variableValues: payload.variables ?? undefined,\n        operationName: payload.operationName ?? undefined,\n      });\n\n      resp.statusCode = 200;\n      resp.setHeader(\"Content-Type\", \"application/json\");\n      resp.end(JSON.stringify(result));\n    } catch (err) {\n      const message = err instanceof Error ? err.message : String(err);\n      resp.statusCode = 400;\n      resp.setHeader(\"Content-Type\", \"application/json\");\n      resp.end(\n        JSON.stringify({\n          errors: [{ message }],\n        })\n      );\n    }\n  }\n);\nEOF\n"]
