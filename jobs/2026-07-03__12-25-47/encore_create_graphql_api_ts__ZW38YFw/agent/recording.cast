[387.410927, "o", "        const contentType = (req.headers[\"content-type\"] ?? \"\") as string;\r\n\u001b[?2004l\r\u001b[?2004h"]
[387.410948, "o", "> "]
[387.411101, "o", "        if (contentType.includes(\"application/graphql\")) {\r\n\u001b[?2004l\r"]
[387.411121, "o", "\u001b[?2004h> "]
[387.411222, "o", "          payload = { query: body };\r\n\u001b[?2004l\r"]
[387.411243, "o", "\u001b[?2004h> "]
[387.41129, "o", "        } else {\r\n\u001b[?2004l\r"]
[387.411311, "o", "\u001b[?2004h> "]
[387.411461, "o", "          payload = JSON.parse(body) as GraphQLPayload;\r\n\u001b[?2004l\r\u001b[?2004h"]
[387.411481, "o", "> "]
[387.411511, "o", "        }\r\n\u001b[?2004l\r\u001b[?2004h"]
[387.411533, "o", "> "]
[387.411555, "o", "      }\r\n\u001b[?2004l\r"]
[387.411611, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[387.411677, "o", "      if (!payload.query) {\r\n\u001b[?2004l\r"]
[387.4117, "o", "\u001b[?2004h> "]
[387.411781, "o", "        resp.statusCode = 400;\r\n\u001b[?2004l\r"]
[387.411814, "o", "\u001b[?2004h> "]
[387.411966, "o", "        resp.setHeader(\"Content-Type\", \"application/json\");\r\n\u001b[?2004l\r"]
[387.411988, "o", "\u001b[?2004h> "]
[387.412188, "o", "        resp.end(JSON.stringify({ errors: [{ message: \"Missing query\" }] }));\r\n\u001b[?2004l\r"]
[387.412213, "o", "\u001b[?2004h> "]
[387.412254, "o", "        return;\r\n\u001b[?2004l\r\u001b[?2004h"]
[387.412276, "o", "> "]
[387.412298, "o", "      }\r\n\u001b[?2004l\r"]
[387.412346, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[387.4125, "o", "      // Validate by parsing (catches syntax errors early).\r\n\u001b[?2004l\r"]
[387.412534, "o", "\u001b[?2004h> "]
[387.412595, "o", "      parse(payload.query);\r\n\u001b[?2004l\r"]
[387.412617, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[387.412655, "o", "\u001b[?2004h> "]
[387.41274, "o", "      const result = await graphql({\r\n\u001b[?2004l\r"]
[387.412761, "o", "\u001b[?2004h> "]
[387.412808, "o", "        schema,\r\n\u001b[?2004l\r"]
[387.412828, "o", "\u001b[?2004h> "]
[387.412914, "o", "        source: payload.query,\r\n\u001b[?2004l\r"]
[387.412936, "o", "\u001b[?2004h> "]
[387.413087, "o", "        variableValues: payload.variables ?? undefined,\r\n\u001b[?2004l\r"]
[387.413108, "o", "\u001b[?2004h> "]
