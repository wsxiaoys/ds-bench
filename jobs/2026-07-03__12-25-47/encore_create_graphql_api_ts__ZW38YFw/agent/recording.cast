[257.315807, "i", "encore app list 2>&1 | head -30\n"]
[257.316069, "o", "encore app list 2>&1 | head -30\r\n\u001b[?2004l\r"]
[257.341927, "o", "Commands to create and link Encore apps\r\n\r\nUsage:\r\n  encore app [command]\r\n\r\nAvailable Commands:\r\n  clone       Clone an existing Encore app from Encore Cloud to your computer\r\n  create      Create a new Encore app\r\n  init        Register an existing local repo as a new app on Encore Cloud\r\n  link        Link an existing local repo to an existing Encore Cloud app\r\n\r\nFlags:\r\n  -h, --help   help for app\r\n\r\nGlobal Flags:\r\n      --trace string    file to write execution trace data to\r\n  -v, --verbose count   verbose output\r\n\r\nUse \"encore app [command] --help\" for more information about a command.\r\n"]
[257.346974, "o", "\u001b[?2004hroot@c58dab8b-5041-4da9-9075-31c228cf1f9a:/home/user/graphql-api# "]
[267.124288, "i", "mkdir -p hello\n"]
[267.124485, "o", "mkdir -p hello\r\n\u001b[?2004l\r"]
[267.12586, "o", "\u001b[?2004hroot@c58dab8b-5041-4da9-9075-31c228cf1f9a:/home/user/graphql-api# "]
[267.457789, "i", "cat > hello/graphql.ts << 'EOF'\nimport { api } from \"encore.dev\";\nimport { createSchema, createYoga } from \"graphql-yoga\";\n\nconst typeDefs = `\n  type Query {\n    \"\"\"Returns a hello message. If no name is provided, returns 'Hello, World!'\"\"\"\n    hello(name: String): String!\n  }\n`;\n\nconst resolvers = {\n  Query: {\n    hello: (_parent: unknown, args: { name?: string | null }) => {\n      const name = args.name ?? \"World\";\n      return `Hello, ${name}!`;\n    },\n  },\n};\n\nconst yoga = createYoga({\n  schema: createSchema({ typeDefs, resolvers }),\n  graphqlEndpoint: \"/graphql\",\n  landingPage: false,\n  graphiql: false,\n});\n\nexport const graphql = api.raw(\n  { expose: true, method: \"*\", path: \"/graphql\" },\n  async (ctx) => {\n    const request = ctx.request;\n    const url = new URL(request.url);\n    const headers: Record<string, string> = {};\n    request.headers.forEach((value, key) => {\n      headers[key] = value;\n    });\n\n    const method = request.method;\n    let body: BodyInit | undefined;\n    const contentType = request.headers.get(\"content-type\") ?? \"\";\n    if (method !== \"GET\" && method !== \"HEAD\" && request.body) {\n      const cloned = request.clone();\n      if (contentType.includes(\"application/json\")) {\n        const text = await cloned.text();\n        body = text;\n      } else {\n        body = await cloned.arrayBuffer().then((buf) => new Uint8Array(buf));\n      }\n    }\n\n    const yogaRequest = new Request(request.url, {\n      method,\n      headers,\n      body,\n    } as RequestInit);\n\n    const response = await yoga.handle(yogaRequest, {});\n\n    const responseHeaders: Record<string, string> = {};\n    response.headers.forEach((value, key) => {\n      responseHeaders[key] = value;\n    });\n\n    const responseBody = await response.text();\n    return new Response(responseBody, {\n      status: response.status,\n      headers: responseHeaders,\n    });\n  }\n);\nEOF\n"]
