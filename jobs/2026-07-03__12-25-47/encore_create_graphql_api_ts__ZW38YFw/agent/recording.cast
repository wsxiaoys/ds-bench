[193.913622, "o", "\u001b[?25l  ✔ App Name: graphql-api                                                \r\r\n  ✔ Template: https://github.com/encoredotdev/encore-ts-example-graphql  \r\r\n                                                                         \r\r\n  Select a tool to generate LLM rules for [Use arrows to move]           \r\r\n                                                                         \r\r\n                                                                         \r\r\n                                                                         \r\r\n                                                                         \r\r\n                                                                         \r\r\n                                                                         \r\r\n                                                                         \r\r\n                                                                         \r\r\n                                                                         \r\r\n                                                                         \r\r\n                                                                         \r\r\n                                                                         \r\r\n                                                                         \r\r\n                                                                         \r\r\n                                                                         \r\r\n                                                                         \r\r\n                                                                         \r\r\n                                                                         \r\r\n"]
