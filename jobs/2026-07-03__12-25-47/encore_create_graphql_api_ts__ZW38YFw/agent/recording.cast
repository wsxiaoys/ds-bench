[716.343086, "o", "{\r\n  \"name\": \"encore-graphql\",\r\n  \"private\": true,\r\n  \"version\": \"0.0.1\",\r\n  \"description\": \"Encore Typescript Starter\",\r\n  \"license\": \"MPL-2.0\",\r\n  \"type\": \"module\",\r\n  \"scripts\": {\r\n    \"generate\": \"graphql-codegen --config codegen.yml\"\r\n  },\r\n  \"devDependencies\": {\r\n    \"@graphql-codegen/cli\": \"^5.0.3\",\r\n    \"@graphql-codegen/typescript\": \"2.8.8\",\r\n    \"@graphql-codegen/typescript-resolvers\": \"2.7.13\",\r\n    \"@types/node\": \"^20.5.7\",\r\n    \"typescript\": \"^5.2.2\"\r\n  },\r\n  \"dependencies\": {\r\n    \"@apollo/server\": \"^4.11.0\",\r\n    \"encore.dev\": \"^1.45.7\",\r\n    \"graphql\": \"^16.9.0\",\r\n    \"graphql-tag\": \"^2.12.6\",\r\n    \"knex\": \"^3.1.0\",\r\n    \"pg\": \"^8.13.1\",\r\n    \"ts-jose\": \"^5.9.6\"\r\n  }\r\n}"]
