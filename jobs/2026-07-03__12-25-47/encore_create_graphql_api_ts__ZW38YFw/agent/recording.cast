[1162.275079, "i", "cat > hello/graphql.ts << 'EOF'\nimport { api } from \"encore.dev/api\";\n\nexport const graphql = api.raw(\n  { expose: true, method: \"*\", path: \"/graphql\" },\n  async (req: any, resp: any) => {\n    console.log(\"HANDLER START\", !!req, !!resp);\n    try {\n      if (!req || !resp) return;\n      console.log(\"ABOUT TO WRITE\");\n      resp.statusCode = 200;\n      resp.setHeader(\"Content-Type\", \"application/json\");\n      resp.end(JSON.stringify({ ok: true, msg: \"test\" }));\n      console.log(\"WROTE\");\n    } catch (err) {\n      console.log(\"ERR:\", err);\n    }\n  }\n);\nEOF\n"]
