[64.960383, "i", "python3 << 'EOF'\nimport json, re\nhtml = open('/home/user/altair_project/chart.html').read()\nm = re.search(r'var spec = ({.*?});\\s*var embedOpt', html, re.DOTALL)\nspec = json.loads(m.group(1))\nprint('Has data url:', 'url' in spec.get('data', {}))\nprint('URL:', spec['data']['url'])\nprint('Has vconcat:', 'vconcat' in spec)\nprint('Number of sub-charts:', len(spec['vconcat']))\nprint('First (detail) height:', spec['vconcat'][0].get('height'))\nprint('Second (context) height:', spec['vconcat'][1].get('height'))\nprint('Detail mark type:', spec['vconcat'][0]['layer'][0]['mark']['type'])\nprint('Context mark type:', spec['vconcat'][1]['mark']['type'])\nprint('Domain binding:', spec['vconcat'][0]['layer'][0]['encoding']['x']['scale']['domain'])\nprint('Rule mark:', spec['vconcat'][0]['layer'][1]['mark'])\nprint('Rule transforms:', spec['vconcat'][0]['layer'][1]['transform'])\nprint('Params:', spec['params'])\nEOF\n"]
[64.960543, "o", "python3 << 'EOF'\r\n\u001b[?2004l\r"]
[64.960599, "o", "\u001b[?2004h> "]
[64.960651, "o", "import json, re\r\n\u001b[?2004l\r"]
