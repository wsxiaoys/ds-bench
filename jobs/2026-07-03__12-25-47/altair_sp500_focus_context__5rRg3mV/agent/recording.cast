[64.960912, "o", "> "]
[64.961081, "o", "m = re.search(r'var spec = ({.*?});\\s*var embedOpt', html, re.DOTALL)\r\n\u001b[?2004l\r"]
[64.961105, "o", "\u001b[?2004h> "]
