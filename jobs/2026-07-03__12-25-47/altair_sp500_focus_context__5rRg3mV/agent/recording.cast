[41.948596, "o", "      position: relative;\r\n    }\r\n  </style>\r\n  <script type=\"text/javascript\" src=\"https://cdn.jsdelivr.net/npm/vega@6\"></script>\r\n  <script type=\"text/javascript\" src=\"https://cdn.jsdelivr.net/npm/vega-lite@6.4.1\"></script>\r\n  <script type=\"text/javascript\" src=\"https://cdn.jsdelivr.net/npm/vega-embed@7\"></script>\r\n</head>\r\n<body>\r\n  <div id=\"vis\"></div>\r\n  <script>\r\n    (function(vegaEmbed) {\r\n      var spec = {\"config\": {\"view\": {\"continuousWidth\": 300, \"continuousHeight\": 300}}, \"vconcat\": [{\"layer\": [{\"mark\": {\"type\": \"area\"}, \"encoding\": {\"x\": {\"field\": \"date\", \"scale\": {\"domain\": {\"param\": \"param_c97a99acfc68b794\"}}, \"title\": \"Date\", \"type\": \"temporal\"}, \"y\": {\"field\": \"price\", \"title\": \"Price\", \"type\": \"quantitative\"}}, \"title\": \"S&P 500 Detail\"}, {\"mark\": {\"type\": \"rule\", \"color\": \"firebrick\", \"size\": 2}, \"encoding\": {\"y\": {\"field\": \"max_price\", \"type\": \"quantitative\"}}, \"transform\": [{\"filter\": {\"param\": \"param_c97a99acfc68b794\"}}, {\"aggregate\": [{\"op\": \"max\", \"field\": \"price\", \"as\": \"max_price\"}]}]}], \"height\": 300}, {\"mark\": {\"type\": \"area\"}, \"encoding\": {\"x\": {\"field\": \"date\", \"title\": \"Date\", \"type\": \"temporal\"}, \"y\": {\"field\": \"price\", \"title\": \"Price\", \"type\": \"quantitative\"}}, \"height\": 60, \"name\": \"view_3fcb6ff21a506dc0_1\", \"title\": \"S&P 500 Overview (drag to brush)\"}], \"data\": {\"url\": \"https://cdn.jsdelivr.net/npm/vega-datasets@v1.29.0/data/sp500.csv\"}, \"params\": [{\"name\": \"param_c97a99acfc68b794\", \"select\": {\"type\": \"interval\", \"encodings\": [\"x\"]}, \"views\": [\"view_3fcb6ff21a506dc0_1\"]}], \"$schema\": \"https://vega.github.io/schema/vega-lite/v6.4.1.json\"};\r\n      var embedOpt = {\"mode\": \"vega-lite\"};\r\n\r\n      function showError(el, error){\r\n          el.innerHTML = ('<div style=\"color:red;\">'\r\n                          + '<p>JavaScript Error: ' + error.message + '</p>'\r\n                          + \"<p>This usually means there's a typo in your chart specification. \"\r\n                          + \"See the javascript console for the full traceback.</p>\"\r\n                          + '</div>');\r\n          throw error;\r\n      }\r\n      const el = document.getElementById('vis');\r\n      vegaEmbed(\"#vis\", spec, embedOpt)\r\n        .catch(error => showError(el, error));\r\n    })(vegaEmbed);\r\n\r\n  </script>\r\n</body>\r\n"]
