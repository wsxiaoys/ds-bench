[186.166879, "o", "    const result = await s3.send(\r\n\u001b[?2004l\r"]
[186.166939, "o", "\u001b[?2004h> "]
[186.167195, "o", "      new PutObjectCommand({\r\n\u001b[?2004l\r"]
