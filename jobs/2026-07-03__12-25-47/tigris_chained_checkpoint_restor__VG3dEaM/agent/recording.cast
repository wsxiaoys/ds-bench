[133.37108, "o", "{\r\n  \"name\": \"@tigrisdata/agent-kit\",\r\n  \"version\": \"0.1.3\",\r\n  \"description\": \"Composed workflows for AI agents on Tigris — forks, workspaces, checkpoints, and coordination\",\r\n  \"type\": \"module\",\r\n  \"main\": \"./dist/index.js\",\r\n  \"module\": \"./dist/index.js\",\r\n  \"types\": \"./dist/index.d.ts\",\r\n  \"exports\": {\r\n    \".\": {\r\n      \"import\": {\r\n        \"types\": \"./dist/index.d.ts\",\r\n        \"default\": \"./dist/index.js\"\r\n      },\r\n      \"require\": {\r\n        \"types\": \"./dist/index.d.cts\",\r\n        \"default\": \"./dist/index.cjs\"\r\n      }\r\n    },\r\n    \"./package.json\": \"./package.json\"\r\n  },\r\n  \"files\": [\r\n    \"dist\",\r\n    \"README.md\"\r\n  ],\r\n  \"publishConfig\": {\r\n    \"access\": \"public\"\r\n  },\r\n  \"scripts\": {\r\n    \"build\": \"tsc --noEmit && tsup\",\r\n    \"dev\": \"tsc --noEmit && tsup --watch\",\r\n    \"publint\": \"publint\",\r\n    \"prepublishOnly\": \"npm run build\",\r\n    \"test\": \"vitest run --config vitest.config.ts\",\r\n    \"clean\": \"rm -rf dist\"\r\n  },\r\n  \"keywords\": [\r\n    \"ai\",\r\n    \"agents\",\r\n    \"tigris\",\r\n    \"storage\",\r\n    \"forks\",\r\n    \"checkpoint\"\r\n  ],\r\n  \"author\": \"Tigris Data\",\r\n  \"repository\": {\r\n    \"type\": \"git\",\r\n    \"url\": \"git+https://github.com/tigrisdata/storage.git\",\r\n    \"directory\": \"packages/agent-kit\"\r\n  },\r\n  \"license\": \"MIT\",\r\n  \"dependencies\": {\r\n    \"@tigrisdata/storage\": \"^3.2.1\",\r\n    \"@tigrisdata/iam\": \"^2.1.1\",\r\n    \"dotenv\": \"^17.4.2\"\r\n  }\r\n}\r\n"]
