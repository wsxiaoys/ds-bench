[350.898638, "i", "cat > /home/user/chained-ckpt/list-buckets2.ts << 'EOF'\nimport { listBuckets } from \"@tigrisdata/storage\";\n\nasync function main() {\n  const accessKeyId = process.env.TIGRIS_STORAGE_ACCESS_KEY_ID!;\n  const secretAccessKey = process.env.TIGRIS_STORAGE_SECRET_ACCESS_KEY!;\n\n  const config = {\n    endpoint: \"REDACTED\",\n    accessKeyId,\n    secretAccessKey,\n  };\n\n  let paginationToken: string | undefined;\n  let allBuckets: any[] = [];\n  do {\n    const { data, error } = await listBuckets({ config, paginationToken });\n    if (error) {\n      console.error(\"Error:\", error);\n      process.exit(1);\n    }\n    if (data?.buckets) {\n      allBuckets = allBuckets.concat(data.buckets);\n    }\n    paginationToken = data?.paginationToken;\n    console.log(\"Page, total so far:\", allBuckets.length, \"next token:\", paginationToken);\n  } while (paginationToken);\n  \n  const harborBuckets = allBuckets.filter((b: any) => b.name?.includes(\"harbor\"));\n  console.log(\"Total harbor buckets:\", harborBuckets.length);\n  console.log(\"Harbor buckets:\");\n  harborBuckets.forEach((b: any) => console.log(\"  \", b.name));\n}\n\nmain().catch((err) => {\n  console.error(err);\n  process.exit(1);\n});\nEOF\n"]
