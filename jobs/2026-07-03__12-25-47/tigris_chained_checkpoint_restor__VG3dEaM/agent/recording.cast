[464.098981, "i", "cat > /home/user/chained-ckpt/verify.ts << 'EOF'\nimport { listBuckets, listBucketSnapshots, get } from \"@tigrisdata/storage\";\nimport { readFileSync } from \"node:fs\";\n\nfunction normalizeBucketName(name: string): string {\n  return name.toLowerCase().replace(/[^a-z0-9.-]/g, \"-\");\n}\n\nasync function main() {\n  const accessKeyId = process.env.TIGRIS_STORAGE_ACCESS_KEY_ID!;\n  const secretAccessKey = process.env.TIGRIS_STORAGE_SECRET_ACCESS_KEY!;\n\n  const config = {\n    endpoint: \"REDACTED\",\n    accessKeyId,\n    secretAccessKey,\n  };\n\n  const runId = readFileSync(\"/logs/artifacts/run-id\", \"utf8\").trim();\n  const bucketName = normalizeBucketName(`harbor-awscli-${runId}`);\n  console.log(\"Source bucket:\", bucketName);\n\n  // List buckets containing the source name\n  const { data: bucketsData, error: bucketsError } = await listBuckets({ config });\n  if (bucketsError) {\n    console.error(\"bucketsError:\", bucketsError);\n    process.exit(1);\n  }\n  const sourceBucket = bucketsData?.buckets?.find((b: any) => b.name === bucketName);\n  console.log(\"Source bucket exists:\", !!sourceBucket, sourceBucket);\n\n  // List snapshots\n  const { data: snaps, error: snapsError } = await listBucketSnapshots(bucketName, { config });\n  if (snapsError) {\n    console.error(\"snapsError:\", snapsError);\n  } else {\n    console.log(\"Snapshots:\", JSON.stringify(snaps, null, 2));\n  }\n\n  // Get the v1.txt object content\n  const { data: v1, error: v1Error } = await get(`/${bucketName}/v1.txt`, \"string\", { config });\n  if (v1Error) {\n    console.error(\"v1Error:\", v1Error);\n  } else {\n    console.log(\"v1.txt content:\", JSON.stringify(v1));\n  }\n}\n\nmain().catch((err) => {\n  console.error(err);\n  process.exit(1);\n});\nEOF\n"]
