[186.168169, "o", "\u001b[?2004h> "]
[186.168255, "o", "      }),\r\n\u001b[?2004l\r"]
[186.168347, "o", "\u001b[?2004h> "]
[186.168435, "o", "    );\r\n\u001b[?2004l\r\u001b[?2004h> "]
[186.168824, "o", "    console.log(\"Mutated to v2:\", result);\r\n\u001b[?2004l\r"]
[186.16891, "o", "\u001b[?2004h>   }\r\n\u001b[?2004l\r"]
[186.169002, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[186.169089, "o", "\u001b[?2004h> "]
[186.169709, "o", "  // Step 5: Restore the checkpoint into a fork named \"rollback-recovery\".\r\n\u001b[?2004l\r"]
[186.169804, "o", "\u001b[?2004h> "]
[186.170308, "o", "  const { data: restored, error: restoreError } = await restore(\r\n\u001b[?2004l\r"]
[186.170363, "o", "\u001b[?2004h> "]
[186.17053, "o", "    bucketName,\r\n\u001b[?2004l\r"]
[186.170617, "o", "\u001b[?2004h> "]
[186.170781, "o", "    ckpt.snapshotId,\r\n\u001b[?2004l\r"]
[186.170867, "o", "\u001b[?2004h> "]
[186.17124, "o", "    { forkName: \"rollback-recovery\", config },\r\n\u001b[?2004l\r"]
[186.171332, "o", "\u001b[?2004h>   );\r\n"]
[186.171422, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[186.171625, "o", "  if (restoreError) {\r\n\u001b[?2004l\r"]
[186.171713, "o", "\u001b[?2004h> "]
[186.172227, "o", "    throw new Error(`Restore failed: ${restoreError.message}`);\r\n\u001b[?2004l\r"]
[186.172324, "o", "\u001b[?2004h>   }\r\n\u001b[?2004l\r"]
[186.172413, "o", "\u001b[?2004h> "]
[186.172584, "o", "  if (!restored) {\r\n\u001b[?2004l\r"]
[186.172671, "o", "\u001b[?2004h> "]
[186.173055, "o", "    throw new Error(\"Restore returned no data\");\r\n\u001b[?2004l\r"]
[186.173142, "o", "\u001b[?2004h>   }\r\n"]
[186.173203, "o", "\u001b[?2004l\r\u001b[?2004h"]
[186.173262, "o", "> "]
[186.173721, "o", "  console.log(\"Restored fork bucket:\", restored.bucket);\r\n\u001b[?2004l\r"]
[186.17381, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[186.173897, "o", "\u001b[?2004h> "]
[186.174383, "o", "  // Step 6: Write the recovery bucket name to recovery.json.\r\n\u001b[?2004l\r"]
[186.174477, "o", "\u001b[?2004h> "]
[186.174605, "o", "  writeFileSync(\r\n\u001b[?2004l\r"]
[186.174663, "o", "\u001b[?2004h> "]
[186.175051, "o", "    \"/home/user/chained-ckpt/recovery.json\",\r\n\u001b[?2004l\r"]
[186.175135, "o", "\u001b[?2004h> "]
[186.175733, "o", "    JSON.stringify({ recoveryBucket: restored.bucket }, null, 2) + \"\\n\",\r\n\u001b[?2004l\r"]
[186.175795, "o", "\u001b[?2004h> "]
[186.175854, "o", "  );\r\n\u001b[?2004l\r"]
[186.175991, "o", "\u001b[?2004h> "]
[186.176243, "o", "  console.log(\"Wrote recovery.json\");\r\n\u001b[?2004l\r"]
[186.176302, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[186.176407, "o", "\u001b[?2004h> "]
[186.176833, "o", "  // Step 7: Tear down the recovery fork bucket.\r\n\u001b[?2004l\r"]
[186.176921, "o", "\u001b[?2004h> "]
[186.177506, "o", "  // First, empty it to be safe (in case it has objects), then delete.\r\n\u001b[?2004l\r"]
[186.177604, "o", "\u001b[?2004h> "]
[186.177698, "o", "  try {\r\n\u001b[?2004l\r\u001b[?2004h"]
[186.177783, "o", "> "]
[186.17801, "o", "    const listed = await s3.send(\r\n\u001b[?2004l\r"]
[186.178095, "o", "\u001b[?2004h> "]
[186.17859, "o", "      new ListObjectsV2Command({ Bucket: restored.bucket }),\r\n\u001b[?2004l\r"]
[186.178648, "o", "\u001b[?2004h> "]
[186.178773, "o", "    );\r\n\u001b[?2004l\r\u001b[?2004h> "]
[186.179152, "o", "    const objects = listed.Contents ?? [];\r\n\u001b[?2004l\r"]
[186.179236, "o", "\u001b[?2004h> "]
[186.17952, "o", "    for (const obj of objects) {\r\n\u001b[?2004l\r"]
[186.179578, "o", "\u001b[?2004h> "]
[186.179843, "o", "      if (!obj.Key) continue;\r\n\u001b[?2004l\r"]
[186.179903, "o", "\u001b[?2004h> "]
[186.180091, "o", "      await s3.send(\r\n\u001b[?2004l\r"]
[186.180149, "o", "\u001b[?2004h> "]
[186.180448, "o", "        new DeleteObjectCommand({\r\n\u001b[?2004l\r"]
[186.180516, "o", "\u001b[?2004h> "]
[186.180825, "o", "          Bucket: restored.bucket,\r\n\u001b[?2004l\r"]
[186.180913, "o", "\u001b[?2004h> "]
[186.18105, "o", "          Key: obj.Key,\r\n\u001b[?2004l\r"]
[186.18111, "o", "\u001b[?2004h> "]
[186.181177, "o", "        }),\r\n\u001b[?2004l\r\u001b[?2004h"]
[186.181245, "o", "> "]
[186.18132, "o", "      );\r\n\u001b[?2004l\r\u001b[?2004h> "]
[186.18138, "o", "    }\r\n\u001b[?2004l\r\u001b[?2004h"]
[186.181596, "o", ">   } catch (err) {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[186.182065, "o", "    console.warn(\"Warning: failed to list/delete objects in recovery bucket:\", err);\r\n\u001b[?2004l\r"]
[186.182159, "o", "\u001b[?2004h>   }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[186.182244, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[186.182771, "o", "  const { error: removeError } = await removeBucket(restored.bucket, { force: true, config });\r\n\u001b[?2004l\r\u001b[?2004h"]
[186.18283, "o", "> "]
[186.18295, "o", "  if (removeError) {\r\n\u001b[?2004l\r\u001b[?2004h"]
[186.183034, "o", "> "]
[186.183368, "o", "    throw new Error(`removeBucket failed: ${removeError.message}`);\r\n\u001b[?2004l\r\u001b[?2004h"]
[186.183422, "o", ">   }\r\n\u001b[?2004l\r"]
[186.183567, "o", "\u001b[?2004h> "]
[186.18375, "o", "  console.log(\"Recovery bucket deleted.\");\r\n\u001b[?2004l\r"]
[186.183844, "o", "\u001b[?2004h> }\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
