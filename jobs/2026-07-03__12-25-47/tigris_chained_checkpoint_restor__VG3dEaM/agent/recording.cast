[383.563721, "i", "cat > /home/user/chained-ckpt/create-bucket.ts << 'EOF'\nimport { createBucket, enableSnapshot } from \"@tigrisdata/storage\";\nimport { readFileSync } from \"node:fs\";\n\nfunction normalizeBucketName(name: string): string {\n  return name.toLowerCase().replace(/[^a-z0-9.-]/g, \"-\");\n}\n\nasync function main() {\n  const accessKeyId = process.env.TIGRIS_STORAGE_ACCESS_KEY_ID!;\n  const secretAccessKey = process.env.TIGRIS_STORAGE_SECRET_ACCESS_KEY!;\n\n  const config = {\n    endpoint: \"REDACTED\",\n    accessKeyId,\n    secretAccessKey,\n  };\n\n  const runId = readFileSync(\"/logs/artifacts/run-id\", \"utf8\").trim();\n  const bucketName = normalizeBucketName(`harbor-awscli-${runId}`);\n  console.log(\"Bucket:\", bucketName);\n\n  const { data, error } = await createBucket(bucketName, { config });\n  console.log(\"createBucket result:\", { data, error });\n\n  const { data: snapData, error: snapError } = await enableSnapshot(bucketName, { config });\n  console.log(\"enableSnapshot result:\", { data: snapData, error: snapError });\n}\n\nmain().catch((err) => {\n  console.error(err);\n  process.exit(1);\n});\nEOF\n"]
