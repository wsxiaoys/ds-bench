[514.97238, "o", "[gd_scene load_steps=2 format=3 uid=\"uid://b1234567890ab\"]\r\n\r\n[ext_resource type=\"Script\" path=\"res://scripts/TweenController.gd\" id=\"1_controller\"]\r\n\r\n[node name=\"Animator\" type=\"Node2D\"]\r\n\r\n[node name=\"Target\" type=\"Node2D\" parent=\".\"]\r\n\r\n[node name=\"TweenController\" type=\"Node\" parent=\".\"]\r\nscript = ExtResource(\"1_controller\")\r\n"]
