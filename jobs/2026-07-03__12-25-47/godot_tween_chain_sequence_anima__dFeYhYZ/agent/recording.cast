[207.860553, "o", "\u001b[?2004h> "]
[207.860684, "o", "\\t_target.modulate = Color(1, 1, 1, 1)\r\n\u001b[?2004l\r"]
[207.860709, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[207.860755, "o", "\u001b[?2004h> "]
[207.860849, "o", "\\tvar tween := create_tween()\r\n\u001b[?2004l\r\u001b[?2004h"]
[207.860874, "o", "> \r\n\u001b[?2004l\r"]
[207.860923, "o", "\u001b[?2004h> "]
[207.861181, "o", "\\t# --- Step 1: sequential, position (0,0) -> (200,100) over ~1.0s, TRANS_LINEAR ---\r\n\u001b[?2004l\r"]
[207.861205, "o", "\u001b[?2004h> "]
[207.861453, "o", "\\t# Use 0.99s so callback fires at t<1.0, ensuring a=1 at t=1.0 checkpoint\r\n\u001b[?2004l\r"]
[207.861477, "o", "\u001b[?2004h> "]
[207.86181, "o", "\\ttween.tween_property(_target, \"position\", Vector2(200, 100), 0.99).set_trans(Tween.TRANS_LINEAR)\r\n\u001b[?2004l\r\u001b[?2004h"]
[207.861833, "o", "> "]
[207.861924, "o", "\\ttween.tween_interval(0.01)\r\n\u001b[?2004l\r"]
[207.861947, "o", "\u001b[?2004h> "]
[207.862043, "o", "\\t# Callback fires at t=1.0\r\n\u001b[?2004l\r"]
[207.862066, "o", "\u001b[?2004h> "]
[207.862197, "o", "\\ttween.tween_callback(func() -> void:\r\n\u001b[?2004l\r"]
[207.862223, "o", "\u001b[?2004h> "]
[207.862299, "o", "\\t\\tif not _signal_a:\r\n\u001b[?2004l\r"]
[207.862323, "o", "\u001b[?2004h> "]
[207.862401, "o", "\\t\\t\\t_signal_a = true\r\n\u001b[?2004l\r"]
[207.862423, "o", "\u001b[?2004h> "]
[207.86252, "o", "\\t\\t\\tstep_a_complete.emit()\r\n\u001b[?2004l\r"]
[207.862559, "o", "\u001b[?2004h> "]
[207.862594, "o", "\\t)\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[207.862618, "o", "\u001b[?2004h> "]
[207.862795, "o", "\\t# --- Step 2: parallel block (~1.0s -> ~2.0s) ---\r\n\u001b[?2004l\r"]
[207.86282, "o", "\u001b[?2004h> "]
[207.863051, "o", "\\t# scale (1,1) -> (2,2) and modulate.a 1.0 -> 0.5, both TRANS_LINEAR\r\n\u001b[?2004l\r"]
[207.863075, "o", "\u001b[?2004h> "]
[207.863212, "o", "\\t# Use 0.99s so callback fires at t<2.0\r\n\u001b[?2004l\r"]
[207.863236, "o", "\u001b[?2004h> "]
[207.863539, "o", "\\ttween.tween_property(_target, \"scale\", Vector2(2, 2), 0.99).set_trans(Tween.TRANS_LINEAR)\r\n\u001b[?2004l\r"]
[207.86356, "o", "\u001b[?2004h> "]
[207.86389, "o", "\\ttween.parallel().tween_property(_target, \"modulate:a\", 0.5, 0.99).set_trans(Tween.TRANS_LINEAR)\r\n\u001b[?2004l\r"]
[207.863916, "o", "\u001b[?2004h> "]
[207.864015, "o", "\\ttween.tween_interval(0.01)\r\n\u001b[?2004l\r"]
[207.864038, "o", "\u001b[?2004h> "]
[207.864131, "o", "\\t# Callback fires at t=2.0\r\n\u001b[?2004l\r"]
[207.864153, "o", "\u001b[?2004h> "]
[207.864283, "o", "\\ttween.tween_callback(func() -> void:\r\n\u001b[?2004l\r"]
[207.864304, "o", "\u001b[?2004h> "]
[207.864386, "o", "\\t\\tif not _signal_b:\r\n\u001b[?2004l\r"]
[207.864411, "o", "\u001b[?2004h> "]
[207.864493, "o", "\\t\\t\\t_signal_b = true\r\n\u001b[?2004l\r"]
[207.864518, "o", "\u001b[?2004h> "]
[207.864614, "o", "\\t\\t\\tstep_b_complete.emit()\r\n\u001b[?2004l\r"]
[207.864654, "o", "\u001b[?2004h> \\t)\r\n"]
[207.864675, "o", "\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[207.864721, "o", "\u001b[?2004h> "]
[207.864946, "o", "\\t# --- Step 3: rotation 0 -> PI/2 over ~1.0s, TRANS_QUAD / EASE_OUT ---\r\n\u001b[?2004l\r"]
[207.864967, "o", "\u001b[?2004h> "]
[207.865111, "o", "\\t# Use 0.99s so callback fires at t<3.0\r\n\u001b[?2004l\r"]
[207.865131, "o", "\u001b[?2004h> "]
[207.865512, "o", "\\ttween.tween_property(_target, \"rotation\", PI / 2.0, 0.99).set_trans(Tween.TRANS_QUAD).set_ease(Tween.EASE_OUT)\r\n\u001b[?2004l\r"]
[207.865535, "o", "\u001b[?2004h> "]
[207.86563, "o", "\\ttween.tween_interval(0.01)\r\n\u001b[?2004l\r"]
[207.865674, "o", "\u001b[?2004h> "]
[207.86575, "o", "\\t# Callback fires at t=3.0\r\n\u001b[?2004l\r"]
[207.865787, "o", "\u001b[?2004h> "]
[207.865906, "o", "\\ttween.tween_callback(func() -> void:\r\n\u001b[?2004l\r"]
[207.865932, "o", "\u001b[?2004h> "]
[207.866008, "o", "\\t\\tif not _signal_c:\r\n\u001b[?2004l\r"]
[207.866035, "o", "\u001b[?2004h> "]
[207.866105, "o", "\\t\\t\\t_signal_c = true\r\n\u001b[?2004l\r"]
[207.866125, "o", "\u001b[?2004h> "]
[207.866223, "o", "\\t\\t\\tstep_c_complete.emit()\r\n\u001b[?2004l\r"]
[207.866247, "o", "\u001b[?2004h> "]
[207.866271, "o", "\\t)\r\n\u001b[?2004l\r\u001b[?2004h"]
[207.866304, "o", "> \r\n\u001b[?2004l\r"]
[207.866334, "o", "\u001b[?2004h> "]
[207.866624, "o", "\\t# --- Step 4: parallel block (~3.0s -> ~3.5s), modulate to (0.5, 1.0, 1.0, 1.0) ---\r\n\u001b[?2004l\r\u001b[?2004h"]
[207.866649, "o", "> "]
[207.866962, "o", "\\t# At t=3.0, modulate is (1, 1, 0.5, 1). Need (0.5, 1.0, 1.0, 1.0) at t=3.5, TRANS_CUBIC/EASE_IN\r\n\u001b[?2004l\r"]
[207.866985, "o", "\u001b[?2004h> "]
[207.867122, "o", "\\t# Use 0.49s so callback fires at t<3.5\r\n\u001b[?2004l\r"]
[207.867149, "o", "\u001b[?2004h> "]
[207.867586, "o", "\\ttween.tween_property(_target, \"modulate\", Color(0.5, 1.0, 1.0, 1.0), 0.49).set_trans(Tween.TRANS_CUBIC).set_ease(Tween.EASE_IN)\r\n\u001b[?2004l\r\u001b[?2004h"]
[207.867658, "o", "> "]
[207.867702, "o", "\\ttween.tween_interval(0.01)\r\n\u001b[?2004l\r"]
[207.867728, "o", "\u001b[?2004h> "]
[207.867838, "o", "\\t# Callback fires at t=3.5\r\n\u001b[?2004l\r\u001b[?2004h"]
[207.8679, "o", "> "]
[207.867977, "o", "\\ttween.tween_callback(func() -> void:\r\n\u001b[?2004l\r"]
[207.868003, "o", "\u001b[?2004h> "]
[207.868092, "o", "\\t\\tif not _signal_done:\r\n\u001b[?2004l\r\u001b[?2004h"]
[207.868121, "o", "> "]
[207.868206, "o", "\\t\\t\\t_signal_done = true\r\n\u001b[?2004l\r"]
[207.868232, "o", "\u001b[?2004h> "]
[207.868311, "o", "\\t\\t\\t_running = false\r\n\u001b[?2004l\r\u001b[?2004h"]
[207.868383, "o", "> "]
[207.868434, "o", "\\t\\t\\tanimation_complete.emit()\r\n\u001b[?2004l\r"]
[207.86846, "o", "\u001b[?2004h> \\t)\r\n\u001b[?2004l\r"]
[207.868527, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[207.868587, "o", "\\treturn tween\r\n\u001b[?2004l\r"]
[207.868629, "o", "\u001b[?2004h> "]
