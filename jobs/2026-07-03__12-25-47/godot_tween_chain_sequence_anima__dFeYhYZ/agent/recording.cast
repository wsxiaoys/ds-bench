[150.986734, "i", "cat > /tmp/make_test3.py << 'PYEOF'\nlines = [\n    'extends SceneTree',\n    '',\n    'var target = null',\n    'var controller = null',\n    'var tween = null',\n    'var count_a = 0',\n    'var count_b = 0',\n    'var count_c = 0',\n    'var count_done = 0',\n    'var checkpoints = [0.5, 1.0, 1.5, 2.0, 3.0, 3.5]',\n    'var current_t = 0.0',\n    'var ci = 0',\n    '',\n    'func _initialize() -> void:',\n    '\\tvar scene = load(\"res://scenes/Animator.tscn\")',\n    '\\tvar instance = scene.instantiate()',\n    '\\troot.add_child(instance)',\n    '\\ttarget = instance.get_node(\"Target\")',\n    '\\tcontroller = instance.get_node(\"TweenController\")',\n    '\\tcontroller.step_a_complete.connect(func(): count_a += 1)',\n    '\\tcontroller.step_b_complete.connect(func(): count_b += 1)',\n    '\\tcontroller.step_c_complete.connect(func(): count_c += 1)',\n    '\\tcontroller.animation_complete.connect(func(): count_done += 1)',\n    '\\ttween = controller.play_sequence()',\n    '\\ttween.pause()',\n    '',\n    'func _process(delta) -> bool:',\n    '\\t# Step in 0.01 increments until we reach the next checkpoint',\n    '\\twhile ci < checkpoints.size() and current_t < checkpoints[ci]:',\n    '\\t\\tvar next_cp = checkpoints[ci]',\n    '\\t\\tvar step = min(0.01, next_cp - current_t)',\n    '\\t\\ttween.custom_step(step)',\n    '\\t\\tcurrent_t += step',\n    '\\tif ci >= checkpoints.size():',\n    '\\t\\treturn true',\n    '\\tvar cp_t = checkpoints[ci]',\n    '\\tprint(\"t=\", cp_t, \" pos=\", target.position, \" scale=\", target.scale, \" rot=\", target.rotation, \" mod=\", target.modulate, \" a=\", count_a, \" b=\", count_b, \" c=\", count_c, \" done=\", count_done, \" running=\", controller.is_running())',\n    '\\tci += 1',\n    '\\treturn false',\n    '',\n    'func _on_test_done() -> void:',\n    '\\tquit(0)',\n]\nwith open('/home/user/godot_project/test_animation.gd', 'w') as f:\n    f.write('\\n'.join(lines) + '\\n')\nprint('OK')\nPYEOF\n"]
