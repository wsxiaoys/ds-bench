[123.458135, "i", "cat > /tmp/make_test2.py << 'PYEOF'\nlines = [\n    'extends SceneTree',\n    '',\n    'var target = null',\n    'var controller = null',\n    'var tween = null',\n    'var count_a = 0',\n    'var count_b = 0',\n    'var count_c = 0',\n    'var count_done = 0',\n    'var current_t = 0.0',\n    'var ts = [0.5, 1.0, 1.5, 2.0, 3.0, 3.5]',\n    'var ti = 0',\n    '',\n    'func _initialize() -> void:',\n    '\\tvar scene = load(\"res://scenes/Animator.tscn\")',\n    '\\tvar instance = scene.instantiate()',\n    '\\troot.add_child(instance)',\n    '\\ttarget = instance.get_node(\"Target\")',\n    '\\tcontroller = instance.get_node(\"TweenController\")',\n    '\\tprint(\"Target position: \", target.position)',\n    '\\tcontroller.step_a_complete.connect(_on_a)',\n    '\\tcontroller.step_b_complete.connect(_on_b)',\n    '\\tcontroller.step_c_complete.connect(_on_c)',\n    '\\tcontroller.animation_complete.connect(_on_done)',\n    '\\ttween = controller.play_sequence()',\n    '\\tprint(\"Tween: \", tween, \" valid: \", tween != null and tween.is_valid())',\n    '\\tprint(\"Tween running: \", tween.is_running())',\n    '\\ttween.pause()',\n    '\\tprint(\"After pause, running: \", tween.is_running())',\n    '\\tprint(\"Controller is_running: \", controller.is_running())',\n    '',\n    'func _on_a():',\n    '\\tcount_a += 1',\n    '\\tprint(\"SIGNAL A fired\")',\n    '',\n    'func _on_b():',\n    '\\tcount_b += 1',\n    '\\tprint(\"SIGNAL B fired\")',\n    '',\n    'func _on_c():',\n    '\\tcount_c += 1',\n    '\\tprint(\"SIGNAL C fired\")',\n    '',\n    'func _on_done():',\n    '\\tcount_done += 1',\n    '\\tprint(\"SIGNAL DONE fired\")',\n    '',\n    'func _process(delta) -> bool:',\n    '\\tif ti >= ts.size():',\n    '\\t\\treturn true',\n    '\\tvar target_t = ts[ti]',\n    '\\tvar dt = target_t - current_t',\n    '\\tprint(\"Stepping dt=\", dt, \" from t=\", current_t, \" to t=\", target_t)',\n    '\\ttween.custom_step(dt)',\n    '\\tcurrent_t = target_t',\n    '\\tprint(\"t=\", current_t, \" pos=\", target.position, \" scale=\", target.scale, \" rot=\", target.rotation, \" mod=\", target.modulate, \" a=\", count_a, \" b=\", count_b, \" c=\", count_c, \" done=\", count_done, \" running=\", controller.is_running())',\n    '\\tti += 1',\n    '\\treturn false',\n    '',\n    'func _on_test_done() -> void:',\n    '\\tquit(0)',\n]\nwith open('/home/user/godot_project/test_animation.gd', 'w') as f:\n    f.write('\\n'.join(lines) + '\\n')\nprint('OK')\nPYEOF\n"]
