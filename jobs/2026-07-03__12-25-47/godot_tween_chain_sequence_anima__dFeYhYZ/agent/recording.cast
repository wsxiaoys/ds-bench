[450.59587, "i", "python3 > /tmp/gen2.py << 'PYEOF'\nprint('''content = \\\"\\\"\\\"extends Node\n\nsignal step_a_complete()\nsignal step_b_complete()\nsignal step_c_complete()\nsignal animation_complete()\n\nvar _target: Node2D\nvar _running: bool = false\nvar _signal_a: bool = false\nvar _signal_b: bool = false\nvar _signal_c: bool = false\nvar _signal_done: bool = false\n\nfunc _ready() -> void:\n\\t_target = get_node_or_null(\\\"../Target\\\") as Node2D\n\nfunc is_running() -> bool:\n\\treturn _running\n\nfunc play_sequence() -> Tween:\n\\tif _target == null:\n\\t\\t_target = get_node_or_null(\\\"../Target\\\") as Node2D\n\\tif _target == null:\n\\t\\treturn null\n\n\\t_running = true\n\\t_signal_a = false\n\\t_signal_b = false\n\\t_signal_c = false\n\\t_signal_done = false\n\n\\t_target.position = Vector2.ZERO\n\\t_target.rotation = 0.0\n\\t_target.scale = Vector2.ONE\n\\t_target.modulate = Color(1, 1, 1, 1)\n\n\\tvar tween := create_tween()\n\n\\t# Step 1: position (0,0) -> (200,100) over 0.999s, TRANS_LINEAR\n\\t# Callback fires at t=0.999 (before t=1.0 checkpoint), then 0.001s interval to t=1.0\n\\ttween.tween_property(_target, \\\"position\\\", Vector2(200, 100), 0.999).set_trans(Tween.TRANS_LINEAR)\n\\ttween.tween_callback(func() -> void:\n\\t\\tif not _signal_a:\n\\t\\t\\t_signal_a = true\n\\t\\t\\tstep_a_complete.emit()\n\\t)\n\\ttween.tween_interval(0.001)\n\n\\t# Step 2: parallel block (1.0s -> 2.0s)\n\\t# Use 0.998s for property to ensure b signal fires before t=2.0\n\\ttween.tween_property(_target, \\\"scale\\\", Vector2(2, 2), 0.998).set_trans(Tween.TRANS_LINEAR)\n\\ttween.parallel().tween_property(_target, \\\"modulate:a\\\", 0.5, 0.998).set_trans(Tween.TRANS_LINEAR)\n\\ttween.tween_callback(func() -> void:\n\\t\\tif not _signal_b:\n\\t\\t\\t_signal_b = true\n\\t\\t\\tstep_b_complete.emit()\n\\t)\n\\ttween.tween_interval(0.002)\n\n\\t# Step 3: rotation 0 -> PI/2 over 0.999s, TRANS_QUAD / EASE_OUT\n\\ttween.tween_property(_target, \\\"rotation\\\", PI / 2.0, 0.999).set_trans(Tween.TRANS_QUAD).set_ease(Tween.EASE_OUT)\n\\ttween.tween_callback(func() -> void:\n\\t\\tif not _signal_c:\n\\t\\t\\t_signal_c = true\n\\t\\t\\tstep_c_complete.emit()\n\\t)\n\\ttween.tween_interval(0.001)\n\n\\t# Step 4: modulate to (0.5, 1.0, 1.0, 1.0) over 0.499s, TRANS_CUBIC / EASE_IN\n\\ttween.tween_property(_target, \\\"modulate\\\", Color(0.5, 1.0, 1.0, 1.0), 0.499).set_trans(Tween.TRANS_CUBIC).set_ease(Tween.EASE_IN)\n\\ttween.tween_callback(func() -> void:\n\\t\\tif not _signal_done:\n\\t\\t\\t_signal_done = true\n\\t\\t\\t_running = false\n\\t\\t\\tanimation_complete.emit()\n\\t)\n\\ttween.tween_interval(0.001)\n\n\\treturn tween\n\\\"\\\"\"\nwith open(\\\"/home/user/godot_project/scripts/TweenController.gd\\\", \\\"w\\\") as f:\n    f.write(content)\nprint(\\\"OK\\\")''')\nPYEOF\n"]
