[72.286005, "i", "cat > /home/user/godot_project/test_animation.gd << 'PYEOF'\nextends SceneTree\n\nfunc _initialize() -> void:\n\tprint(\"Loading scene...\")\n\tvar scene = load(\"res://scenes/Animator.tscn\")\n\tif scene == null:\n\t\tprint(\"ERROR: Failed to load scene\")\n\t\tquit(1)\n\t\treturn\n\tprint(\"Scene loaded: \", scene)\n\tvar instance = scene.instantiate()\n\tif instance == null:\n\t\tprint(\"ERROR: Failed to instantiate scene\")\n\t\tquit(1)\n\t\treturn\n\tprint(\"Scene instantiated\")\n\troot.add_child(instance)\n\t\n\tvar target = instance.get_node(\"Target\")\n\tvar controller = instance.get_node(\"TweenController\")\n\tprint(\"Target: \", target, \" position: \", target.position)\n\tprint(\"Controller: \", controller)\n\t\n\t# Connect signals\n\tvar count_a = [0]\n\tvar count_b = [0]\n\tvar count_c = [0]\n\tvar count_done = [0]\n\tcontroller.step_a_complete.connect(func(): count_a[0] += 1)\n\tcontroller.step_b_complete.connect(func(): count_b[0] += 1)\n\tcontroller.step_c_complete.connect(func(): count_c[0] += 1)\n\tcontroller.animation_complete.connect(func(): count_done[0] += 1)\n\t\n\t# Play sequence\n\tvar tween = controller.play_sequence()\n\tif tween == null:\n\t\tprint(\"ERROR: play_sequence returned null\")\n\t\tquit(1)\n\t\treturn\n\tprint(\"Tween created: \", tween)\n\ttween.pause()\n\tprint(\"Tween paused. is_running: \", controller.is_running())\n\t\n\t# Step through and check checkpoints\n\tvar checkpoints = [\n\t\t{\"t\": 0.5, \"pos\": Vector2(100, 50), \"scale\": null, \"rot\": null, \"mod\": null, \"a\": 0, \"b\": 0, \"c\": 0, \"done\": 0, \"running\": true},\n\t\t{\"t\": 1.0, \"pos\": Vector2(200, 100), \"scale\": null, \"rot\": null, \"mod\": null, \"a\": 1, \"b\": 0, \"c\": 0, \"done\": 0, \"running\": true},\n\t\t{\"t\": 1.5, \"pos\": null, \"scale\": Vector2(1.5, 1.5), \"rot\": null, \"mod_a\": 0.75, \"a\": 1, \"b\": 0, \"c\": 0, \"done\": 0, \"running\": true},\n\t\t{\"t\": 2.0, \"pos\": null, \"scale\": Vector2(2, 2), \"rot\": null, \"mod_a\": 0.5, \"a\": 1, \"b\": 1, \"c\": 0, \"done\": 0, \"running\": true},\n\t\t{\"t\": 3.0, \"pos\": null, \"scale\": null, \"rot\": PI/2.0, \"mod\": null, \"a\": 1, \"b\": 1, \"c\": 1, \"done\": 0, \"running\": true},\n\t\t{\"t\": 3.5, \"pos\": null, \"scale\": null, \"rot\": null, \"mod\": Color(0.5, 1.0, 1.0, 1.0), \"a\": 1, \"b\": 1, \"c\": 1, \"done\": 1, \"running\": false},\n\t]\n\t\n\tvar current_t = 0.0\n\tfor cp in checkpoints:\n\t\tvar target_t = cp.t\n\t\tvar dt = target_t - current_t\n\t\tif dt > 0:\n\t\t\ttween.custom_step(dt)\n\t\tcurrent_t = target_t\n\t\tprint(\"--- t=\", current_t, \" ---\")\n\t\tprint(\"  position: \", target.position)\n\t\tprint(\"  scale: \", target.scale)\n\t\tprint(\"  rotation: \", target.rotation)\n\t\tprint(\"  modulate: \", target.modulate)\n\t\tprint(\"  signals: a=\", count_a[0], \" b=\", count_b[0], \" c=\", count_c[0], \" done=\", count_done[0])\n\t\tprint(\"  is_running: \", controller.is_running())\n\t\n\tquit(0)\nPYEOF\n"]
