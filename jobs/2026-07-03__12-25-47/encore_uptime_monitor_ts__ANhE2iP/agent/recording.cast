[934.877619, "o", "{\r\n  \"compilerOptions\": {\r\n    \"target\": \"ES2022\",\r\n    \"module\": \"ES2022\",\r\n    \"moduleResolution\": \"Bundler\",\r\n    \"esModuleInterop\": true,\r\n    \"forceConsistentCasingInFileNames\": true,\r\n    \"strict\": true,\r\n    \"skipLibCheck\": true,\r\n    \"resolveJsonModule\": true,\r\n    \"allowJs\": true,\r\n    \"noEmit\": true\r\n  },\r\n  \"include\": [\"**/*.ts\"]\r\n}\r\n"]
