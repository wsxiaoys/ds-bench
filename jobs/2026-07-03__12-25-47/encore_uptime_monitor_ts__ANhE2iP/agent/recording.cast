[97.502658, "o", "  siteId: number;\r\n\u001b[?2004l\r"]
[97.502742, "o", "\u001b[?2004h> "]
[97.502836, "o", "  url: string;\r\n\u001b[?2004l\r\u001b[?2004h> }\r\n"]
[97.502886, "o", "\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[97.503186, "o", "export const checkTopic = new Topic<CheckEvent>(\"check-site\", {\r\n\u001b[?2004l\r"]
[97.503235, "o", "\u001b[?2004h> "]
[97.503385, "o", "  deliveryGuarantee: \"at-least-once\",\r\n\u001b[?2004l\r"]
