[12.166552, "o", "prefect block --help 2>&1 | head -30\r\n\u001b[?2004l\r"]
[12.944685, "o", "Usage: prefect block COMMAND [OPTIONS]\r\n\r\n"]
[12.944808, "o", "Manage blocks.\r\n\r\n"]
[12.94875, "o", "╭─ Commands ───────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────╮\r\n│ create        Generate a link to the Prefect UI to create a block.                                                                                           │\r\n│ delete        Delete a configured block.                                                                                                                     │\r\n│ inspect       Displays details about a configured block.                                                                                                     │\r\n│ ls            View all configured blocks.                                                                                                                    │\r\n│ register      Register blocks types within a module or file.                                                                                                 │\r\n│ type (types)  Inspect and delete block types.                                                                                                                │\r\n╰──────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────╯\r\n"]
[12.949458, "o", "╭─ Session Parameters ─────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────╮\r\n│ --profile             Select a profile for this CLI run.                                                                                                     │\r\n│ --prompt --no-prompt  Toggle interactive prompts.                                                                                                            │\r\n╰──────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────╯\r\n"]
[13.06809, "o", "\u001b[?2004hroot@594df259-37fe-4d19-8e59-9b9afb07a55e:/home/user/project# "]
[16.892811, "i", "python3 -c \"from prefect.blocks.system import Secret; print(Secret.__doc__)\" 2>&1 | head -20\n"]
[16.893514, "o", "python3 -c \"from prefect.blocks.system import Secret; print(Secret.__doc__)\" 2>&1 | head -20\r\n\u001b[?2004l\r"]
[17.570911, "o", "\r\n    A block that represents a secret value. The value stored in this block will be obfuscated when\r\n    this block is viewed or edited in the UI.\r\n\r\n    Attributes:\r\n        value: A value that should be kept secret.\r\n\r\n    Example:\r\n        ```python\r\n        from prefect.blocks.system import Secret\r\n\r\n        Secret(value=\"REDACTED\").save(\"BLOCK_NAME\", overwrite=True)\r\n\r\n        secret_block = Secret.load(\"BLOCK_NAME\")\r\n\r\n        # Access the stored secret\r\n        secret_block.get()\r\n        ```\r\n    \r\n"]
[17.674349, "o", "\u001b[?2004hroot@594df259-37fe-4d19-8e59-9b9afb07a55e:/home/user/project# "]
[22.295199, "i", "python3 -c \"from prefect.blocks.system import Secret; Secret(value='super-secret-value').save('my-api-key', overwrite=True); print('Secret block created')\"\n"]
[22.295865, "o", "python3 -c \"from prefect.blocks.system import Secret; Secret(value='super-secret-value').save('my-api-key', overwrite=True); print('Secret block created')\"\r\n\u001b[?2004l\r"]
[30.306864, "o", "Secret block created\r\n"]
[30.992972, "o", "\u001b[?2004hroot@594df259-37fe-4d19-8e59-9b9afb07a55e:/home/user/project# "]
[42.039738, "i", "cat > /home/user/project/serve_flow.py << 'EOF'\nfrom prefect import flow\nfrom prefect.blocks.system import Secret\n\n\n@flow(name=\"my_flow\")\ndef my_flow():\n    secret_block = Secret.load(\"my-api-key\")\n    print(secret_block.get())\n\n\nif __name__ == \"__main__\":\n    my_flow.serve(name=\"my-deployment\", cron=\"0 9 * * *\")\nEOF\n"]
