[57.324904, "o", "cat /home/user/myproject/sandbox_env.py\r\n\u001b[?2004l\r"]
[57.325861, "o", "import os\r\nfrom daytona import Daytona, CreateSandboxFromSnapshotParams\r\n\r\n\r\ndef main():\r\n    # Read run-id\r\n    with open('/logs/artifacts/run-id', 'r') as f:\r\n        run_id = f.read().strip()\r\n\r\n    sandbox_name = f\"envvar-py-{run_id}\"\r\n    my_var_value = f\"hello-{run_id}\"\r\n\r\n    daytona = Daytona()\r\n    sandbox = None\r\n    log_lines = []\r\n\r\n    try:\r\n        # Create sandbox with custom env vars\r\n        params = CreateSandboxFromSnapshotParams(\r\n            name=sandbox_name,\r\n            env_vars={\r\n                \"MY_VAR\": my_var_value,\r\n                \"APP_MODE\": \"production\",\r\n            },\r\n        )\r\n        sandbox = daytona.create(params)\r\n\r\n        # Read MY_VAR from sandbox\r\n        resp_my_var = sandbox.process.exec(\"echo \\\"$MY_VAR\\\"\")\r\n        my_var_captured = resp_my_var.result.strip()\r\n        log_lines.append(f\"MY_VAR: {my_var_captured}\")\r\n\r\n        # Read APP_MODE from sandbox\r\n        resp_app_mode = sandbox.process.exec(\"echo \\\"$APP_MODE\\\"\")\r\n        app_mode_captured = resp_app_mode.result.strip()\r\n        log_lines.append(f\"APP_MODE: {app_mode_captured}\")\r\n\r\n        # Write to log file\r\n        with open('/home/user/myproject/output.log', 'w') as f:\r\n            f.write(\"\\n\".join(log_lines) + \"\\n\")\r\n\r\n        print(\"Log file written:\")\r\n        print(\"\\n\".join(log_lines))\r\n    finally:\r\n        if sandbox is not None:\r\n            try:\r\n                sandbox.delete()\r\n            except Exception as e:\r\n                print(f\"Failed to delete sandbox: {e}\")\r\n\r\n\r\nif __name__ == \"__main__\":\r\n    main()\r\n"]
[57.326062, "o", "\u001b[?2004hroot@c03236ca-a05c-45f9-ba23-72a03cf25484:~# "]
