[49.002042, "i", "cat > build.gradle << 'EOF'\nplugins {\n    id 'application'\n    id 'java'\n}\n\nrepositories {\n    mavenCentral()\n}\n\njava {\n    sourceCompatibility = JavaVersion.VERSION_17\n    targetCompatibility = JavaVersion.VERSION_17\n}\n\ndependencies {\n    implementation 'com.badlogicgames.gdx:gdx:1.14.2'\n    implementation 'com.badlogicgames.gdx:gdx-backend-headless:1.14.2'\n}\n\napplication {\n    mainClass = 'com.example.GeometryCli'\n    applicationName = 'geometry-cli'\n    applicationDefaultJvmArgs = []\n}\n\n// Ensure jar manifest points to the main class so we can also call via java -jar\njar {\n    manifest {\n        attributes 'Main-Class': 'com.example.GeometryCli'\n    }\n}\n\nrun {\n    // Forward program args to Gradle run via --args (default in Gradle 8)\n    standardInput = System.in\n}\nEOF\n"]
