[71.690753, "o", "\u001b[?2004h> "]
[71.693083, "o", "                            OUT.println(\"ERROR \" + lineNo + \" \" + cmd);\r\n\u001b[?2004l\r"]
[71.693305, "o", "\u001b[?2004h> "]
[71.694304, "o", "                    }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[71.69563, "o", "                } catch (Exception ex) {\r\n\u001b[?2004l\r"]
[71.696236, "o", "\u001b[?2004h> "]
[71.697239, "o", "                    OUT.println(\"ERROR \" + lineNo + \" \" + cmd);\r\n\u001b[?2004l\r\u001b[?2004h"]
[71.697451, "o", "> "]
[71.697834, "o", "                }\r\n\u001b[?2004l\r\u001b[?2004h"]
[71.698652, "o", ">             }\r\n\u001b[?2004l\r\u001b[?2004h"]
[71.699791, "o", ">         } catch (Exception e) {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[71.699986, "o", "            e.printStackTrace();\r\n\u001b[?2004l\r\u001b[?2004h"]
[71.701398, "o", ">         }\r\n\u001b[?2004l\r\u001b[?2004h>         Gdx.app.exit();\r\n\u001b[?2004l\r\u001b[?2004h>     }\r\n\u001b[?2004l\r"]
[71.701614, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[71.701793, "o", "\u001b[?2004h> "]
[71.703028, "o", "    public static void main(String[] args) throws Exception {\r\n\u001b[?2004l\r"]
[71.703239, "o", "\u001b[?2004h> "]
[71.703818, "o", "        if (args.length < 1) {\r\n\u001b[?2004l\r\u001b[?2004h"]
[71.70776, "o", ">             System.err.println(\"Usage: geometry-cli <script-file>\");\r\n\u001b[?2004l\r\u001b[?2004h>             System.exit(1);\r\n\u001b[?2004l\r\u001b[?2004h> "]
[71.70873, "o", "        }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[71.709636, "o", "        String scriptPath = args[0];\r\n\u001b[?2004l\r"]
[71.709842, "o", "\u001b[?2004h> "]
[71.711857, "o", "        HeadlessApplicationConfiguration config = new HeadlessApplicationConfiguration();\r\n\u001b[?2004l\r"]
[71.712217, "o", "\u001b[?2004h> "]
[71.715784, "o", "        config.updatesPerSecond = 0;\r\n\u001b[?2004l\r\u001b[?2004h>         HeadlessApplication app = new HeadlessApplication(new GeometryCli(scriptPath), config);\r\n\u001b[?2004l\r\u001b[?2004h> "]
[71.716776, "o", "        // Wait until the application thread terminates\r\n\u001b[?2004l\r"]
[71.71699, "o", "\u001b[?2004h> "]
[71.718717, "o", "        // Gdx.app.exit() will let the main loop in HeadlessApplication finish.\r\n"]
[71.718933, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[71.720052, "o", "        Thread mainLoopThread = getMainLoopThread(app);\r\n\u001b[?2004l\r"]
[71.720261, "o", "\u001b[?2004h> "]
[71.721183, "o", "        if (mainLoopThread != null) {\r\n\u001b[?2004l\r\u001b[?2004h"]
[71.721386, "o", "> "]
[71.722227, "o", "            mainLoopThread.join();\r\n\u001b[?2004l\r\u001b[?2004h"]
[71.72266, "o", ">         }\r\n\u001b[?2004l\r"]
[71.722865, "o", "\u001b[?2004h> "]
[71.723104, "o", "    }\r\n\u001b[?2004l\r\u001b[?2004h"]
[71.723378, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h"]
[71.72361, "o", "> "]
[71.725071, "o", "    private static Thread getMainLoopThread(HeadlessApplication app) {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[71.726424, "o", "        // HeadlessApplication maintains an internal thread running MainLoop;\r\n\u001b[?2004l\r"]
[71.726764, "o", "\u001b[?2004h> "]
[71.727619, "o", "        // access via reflection to join it cleanly.\r\n\u001b[?2004l\r"]
[71.727855, "o", "\u001b[?2004h> "]
[71.728283, "o", "        try {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[71.730222, "o", "            java.lang.reflect.Field f = HeadlessApplication.class.getDeclaredField(\"mainLoopThread\");\r\n\u001b[?2004l\r"]
[71.730566, "o", "\u001b[?2004h> "]
[71.731173, "o", "            f.setAccessible(true);\r\n\u001b[?2004l\r"]
[71.73147, "o", "\u001b[?2004h> "]
[71.732164, "o", "            return (Thread) f.get(app);\r\n\u001b[?2004l\r"]
[71.732448, "o", "\u001b[?2004h> "]
[71.733464, "o", "        } catch (Throwable t) {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[71.733987, "o", "            return null;\r\n\u001b[?2004l\r"]
[71.734307, "o", "\u001b[?2004h> "]
[71.782587, "o", "        }"]
[71.784771, "o", "\r\n\u001b[?2004l\r\u001b[?2004h>     }\r\n\u001b[?2004l\r\u001b[?2004h> }\r\n\u001b[?2004l\r\u001b[?2004h> JAVAEOF\r\n\u001b[?2004l\r"]
