[505.099744, "o", "                backoff = min(backoff * 1.5, 30.0)\r\n\u001b[?2004l\r"]
[505.099767, "o", "\u001b[?2004h> "]
[505.099873, "o", "                continue\r\n\u001b[?2004l\r"]
[505.099896, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[505.099927, "o", "\u001b[?2004h> "]
[505.10023, "o", "            raise RuntimeError(f\"Unexpected embeddings response: {body[:500]}\")\r\n\u001b[?2004l\r"]
[505.100254, "o", "\u001b[?2004h> "]
[505.10042, "o", "        except urllib.error.HTTPError as e:\r\n\u001b[?2004l\r"]
[505.100443, "o", "\u001b[?2004h> "]
[505.100683, "o", "            body = e.read().decode(\"utf-8\", errors=\"replace\")\r\n\u001b[?2004l\r"]
[505.100707, "o", "\u001b[?2004h> "]
[505.101064, "o", "            sys.stderr.write(f\"[embed] HTTP {e.code}: {body[:300]}; sleep {backoff:.1f}s\\n\")\r\n\u001b[?2004l\r"]
[505.101088, "o", "\u001b[?2004h> "]
[505.101207, "o", "            sys.stderr.flush()\r\n\u001b[?2004l\r"]
[505.101231, "o", "\u001b[?2004h> "]
[505.101357, "o", "            time.sleep(backoff)\r\n\u001b[?2004l\r"]
[505.101382, "o", "\u001b[?2004h> "]
[505.101563, "o", "            backoff = min(backoff * 1.5, 30.0)\r\n\u001b[?2004l\r"]
[505.101586, "o", "\u001b[?2004h> "]
[505.101708, "o", "        except Exception as e:\r\n\u001b[?2004l\r"]
[505.101748, "o", "\u001b[?2004h> "]
[505.102032, "o", "            sys.stderr.write(f\"[embed] error: {e}; sleep {backoff:.1f}s\\n\")\r\n\u001b[?2004l\r"]
[505.102055, "o", "\u001b[?2004h> "]
[505.10218, "o", "            sys.stderr.flush()\r\n\u001b[?2004l\r"]
[505.102203, "o", "\u001b[?2004h> "]
[505.102331, "o", "            time.sleep(backoff)\r\n\u001b[?2004l\r"]
[505.102353, "o", "\u001b[?2004h> "]
[505.102534, "o", "            backoff = min(backoff * 1.5, 30.0)\r\n\u001b[?2004l\r"]
[505.102556, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[505.102585, "o", "\u001b[?2004h"]
[505.10264, "o", "> "]
[505.102826, "o", "    raise RuntimeError(\"Exceeded max retries for embeddings\")\r\n\u001b[?2004l\r"]
[505.102857, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[505.102886, "o", "\u001b[?2004h> \r\n"]
[505.10294, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[505.103036, "o", "def read_csv_rows(csv_path):\r\n\u001b[?2004l\r"]
[505.103061, "o", "\u001b[?2004h> "]
[505.103121, "o", "    rows = []\r\n\u001b[?2004l\r"]
[505.103145, "o", "\u001b[?2004h> "]
[505.103388, "o", "    with open(csv_path, \"r\", encoding=\"utf-8\", newline=\"\") as f:\r\n\u001b[?2004l\r"]
[505.103411, "o", "\u001b[?2004h> "]
[505.103548, "o", "        reader = csv.DictReader(f)\r\n\u001b[?2004l\r"]
[505.103573, "o", "\u001b[?2004h> "]
[505.103678, "o", "        for row in reader:\r\n\u001b[?2004l\r"]
[505.103702, "o", "\u001b[?2004h> "]
[505.103842, "o", "            rows.append(dict(row))\r\n\u001b[?2004l\r"]
[505.103881, "o", "\u001b[?2004h> "]
[505.103933, "o", "    return rows\r\n\u001b[?2004l\r"]
[505.103958, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[505.103983, "o", "\u001b[?2004h> "]
[505.104011, "o", "\r\n\u001b[?2004l\r\u001b[?2004h"]
[505.104075, "o", "> "]
[505.104111, "o", "def cmd_ingest(args):\r\n\u001b[?2004l\r"]
[505.104136, "o", "\u001b[?2004h> "]
[505.104232, "o", "    csv_path = args.csv\r\n\u001b[?2004l\r"]
[505.104256, "o", "\u001b[?2004h> "]
[505.104366, "o", "    table_name = args.table\r\n\u001b[?2004l\r"]
[505.10439, "o", "\u001b[?2004h> "]
[505.104508, "o", "    text_col = args.text_col\r\n\u001b[?2004l\r"]
[505.104533, "o", "\u001b[?2004h> "]
[505.104661, "o", "    batch_size = args.batch_size\r\n\u001b[?2004l\r"]
[505.104685, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[505.104731, "o", "\u001b[?2004h> "]
[505.104868, "o", "    if not os.path.exists(csv_path):\r\n\u001b[?2004l\r"]
[505.104891, "o", "\u001b[?2004h> "]
[505.105116, "o", "        sys.stderr.write(f\"CSV not found: {csv_path}\\n\")\r\n\u001b[?2004l\r"]
[505.105141, "o", "\u001b[?2004h> "]
[505.105208, "o", "        return 1\r\n\u001b[?2004l\r"]
[505.105232, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[505.105258, "o", "\u001b[?2004h"]
[505.10531, "o", "> "]
[505.10547, "o", "    sys.stderr.write(f\"[ingest] reading {csv_path}\\n\")\r\n\u001b[?2004l\r"]
[505.105494, "o", "\u001b[?2004h> "]
[505.105631, "o", "    rows = read_csv_rows(csv_path)\r\n\u001b[?2004l\r"]
[505.105656, "o", "\u001b[?2004h> "]
[505.105935, "o", "    sys.stderr.write(f\"[ingest] {len(rows)} rows loaded\\n\")\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[505.105962, "o", "> "]
[505.106087, "o", "    if rows and text_col not in rows[0]:\r\n\u001b[?2004l\r"]
[505.106112, "o", "\u001b[?2004h> "]
[505.106436, "o", "        sys.stderr.write(f\"[ingest] column '{text_col}' not in CSV; have: {list(rows[0].keys())}\\n\")\r\n\u001b[?2004l\r"]
[505.10646, "o", "\u001b[?2004h> "]
[505.106519, "o", "        return 1\r\n\u001b[?2004l\r"]
[505.106543, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[505.106567, "o", "\u001b[?2004h"]
[505.106593, "o", "> "]
[505.106702, "o", "    os.makedirs(DB_DIR, exist_ok=True)\r\n\u001b[?2004l\r"]
[505.106739, "o", "\u001b[?2004h> "]
[505.106835, "o", "    db = lancedb.connect(DB_DIR)\r\n\u001b[?2004l\r"]
[505.106882, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[505.10692, "o", "\u001b[?2004h> "]
[505.10697, "o", "    all_records = []\r\n\u001b[?2004l\r"]
[505.106993, "o", "\u001b[?2004h> "]
[505.107062, "o", "    n = len(rows)\r\n\u001b[?2004l\r"]
[505.107086, "o", "\u001b[?2004h> "]
[505.107227, "o", "    for start in range(0, n, batch_size):\r\n\u001b[?2004l\r"]
[505.107252, "o", "\u001b[?2004h> "]
[505.107397, "o", "        end = min(start + batch_size, n)\r\n\u001b[?2004l\r"]
[505.107421, "o", "\u001b[?2004h> "]
[505.107527, "o", "        batch = rows[start:end]\r\n\u001b[?2004l\r"]
[505.10755, "o", "\u001b[?2004h> "]
[505.107761, "o", "        texts = [str(r.get(text_col, \"\") or \"\") for r in batch]\r\n\u001b[?2004l\r"]
[505.107801, "o", "\u001b[?2004h> "]
[505.108091, "o", "        sys.stderr.write(f\"[ingest] embedding rows {start}..{end-1} ({len(batch)} items)\\n\")\r\n\u001b[?2004l\r"]
[505.108129, "o", "\u001b[?2004h> "]
[505.108202, "o", "        sys.stderr.flush()\r\n\u001b[?2004l\r"]
[505.108227, "o", "\u001b[?2004h> "]
[505.10836, "o", "        embeddings = embed_texts(texts)\r\n\u001b[?2004l\r"]
[505.108385, "o", "\u001b[?2004h> "]
[505.108547, "o", "        for r, emb in zip(batch, embeddings):\r\n\u001b[?2004l\r"]
[505.10857, "o", "\u001b[?2004h> "]
[505.108628, "o", "            try:\r\n\u001b[?2004l\r"]
[505.108652, "o", "\u001b[?2004h> "]
[505.10878, "o", "                rid = int(r.get(\"id\"))\r\n\u001b[?2004l\r"]
[505.108803, "o", "\u001b[?2004h> "]
[505.108913, "o", "            except Exception:\r\n\u001b[?2004l\r"]
[505.108951, "o", "\u001b[?2004h> "]
[505.109015, "o", "                rid = 0\r\n\u001b[?2004l\r"]
[505.109038, "o", "\u001b[?2004h> "]
[505.109109, "o", "            rec = {\r\n\u001b[?2004l\r"]
[505.109132, "o", "\u001b[?2004h> "]
[505.109227, "o", "                \"id\": rid,\r\n\u001b[?2004l\r"]
[505.10925, "o", "\u001b[?2004h> "]
[505.109414, "o", "                \"title\": r.get(\"title\", \"\") or \"\",\r\n\u001b[?2004l\r"]
[505.109438, "o", "\u001b[?2004h> "]
[505.109596, "o", "                \"body\": r.get(\"body\", \"\") or \"\",\r\n\u001b[?2004l\r"]
[505.109619, "o", "\u001b[?2004h> "]
[505.109802, "o", "                \"category\": r.get(\"category\", \"\") or \"\",\r\n\u001b[?2004l\r"]
[505.10985, "o", "\u001b[?2004h> "]
[505.11003, "o", "                \"published\": r.get(\"published\", \"\") or \"\",\r\n\u001b[?2004l\r"]
[505.110072, "o", "\u001b[?2004h> "]
[505.110237, "o", "                \"text\": str(r.get(text_col, \"\") or \"\"),\r\n\u001b[?2004l\r"]
[505.110275, "o", "\u001b[?2004h> "]
[505.110362, "o", "                \"vector\": emb,\r\n\u001b[?2004l\r"]
[505.110386, "o", "\u001b[?2004h> "]
[505.110439, "o", "            }\r\n\u001b[?2004l\r"]
[505.110463, "o", "\u001b[?2004h> "]
[505.110582, "o", "            all_records.append(rec)\r\n\u001b[?2004l\r"]
[505.110605, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[505.110628, "o", "\u001b[?2004h> "]
[505.110971, "o", "    sys.stderr.write(f\"[ingest] writing {len(all_records)} records to LanceDB table '{table_name}'\\n\")\r\n\u001b[?2004l\r"]
[505.111007, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[505.11103, "o", "\u001b[?2004h> "]
[505.111077, "o", "    try:\r\n\u001b[?2004l\r\u001b[?2004h"]
[505.1111, "o", "> "]
[505.111208, "o", "        db.drop_table(table_name)\r\n\u001b[?2004l\r"]
[505.111246, "o", "\u001b[?2004h> "]
[505.111301, "o", "    except Exception:\r\n\u001b[?2004l\r"]
[505.111324, "o", "\u001b[?2004h> "]
[505.111375, "o", "        pass\r\n\u001b[?2004l\r"]
[505.11141, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[505.111432, "o", "\u001b[?2004h> "]
[505.111514, "o", "    schema = pa.schema([\r\n\u001b[?2004l\r"]
[505.111536, "o", "\u001b[?2004h> "]
[505.111632, "o", "        (\"id\", pa.int64()),\r\n\u001b[?2004l\r"]
[505.111654, "o", "\u001b[?2004h> "]
[505.111763, "o", "        (\"title\", pa.string()),\r\n\u001b[?2004l\r"]
[505.111785, "o", "\u001b[?2004h> "]
[505.1119, "o", "        (\"body\", pa.string()),\r\n\u001b[?2004l\r"]
[505.111937, "o", "\u001b[?2004h> "]
[505.112038, "o", "        (\"category\", pa.string()),\r\n\u001b[?2004l\r"]
[505.11206, "o", "\u001b[?2004h> "]
[505.112181, "o", "        (\"published\", pa.string()),\r\n\u001b[?2004l\r"]
[505.112204, "o", "\u001b[?2004h> "]
[505.112305, "o", "        (\"text\", pa.string()),\r\n\u001b[?2004l\r"]
[505.112327, "o", "\u001b[?2004h> "]
[505.112512, "o", "        (\"vector\", pa.list_(pa.float32(), VECTOR_DIM)),\r\n\u001b[?2004l\r"]
[505.112535, "o", "\u001b[?2004h> "]
[505.11258, "o", "    ])\r\n\u001b[?2004l\r\u001b[?2004h"]
[505.112602, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h"]
[505.112626, "o", "> "]
[505.112917, "o", "    table = db.create_table(table_name, data=all_records, schema=schema, mode=\"overwrite\")\r\n\u001b[?2004l\r"]
[505.112954, "o", "\u001b[?2004h> "]
[505.113244, "o", "    sys.stderr.write(f\"[ingest] table '{table_name}' created with {table.count_rows()} rows\\n\")\r\n\u001b[?2004l\r"]
[505.113267, "o", "\u001b[?2004h> "]
[505.113315, "o", "    return 0\r\n\u001b[?2004l\r"]
[505.113337, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[505.113383, "o", "\u001b[?2004h"]
[505.113417, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[505.113478, "o", "def cmd_search(args):\r\n\u001b[?2004l\r"]
[505.113502, "o", "\u001b[?2004h> "]
[505.1136, "o", "    table_name = args.table\r\n\u001b[?2004l\r"]
[505.113623, "o", "\u001b[?2004h> "]
[505.113701, "o", "    query = args.query\r\n\u001b[?2004l\r"]
[505.113725, "o", "\u001b[?2004h> "]
[505.11378, "o", "    k = args.k\r\n\u001b[?2004l\r"]
[505.113817, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[505.113857, "o", "\u001b[?2004h> "]
[505.113954, "o", "    db = lancedb.connect(DB_DIR)\r\n\u001b[?2004l\r"]
[505.11399, "o", "\u001b[?2004h> "]
[505.114119, "o", "    if table_name not in db.table_names():\r\n\u001b[?2004l\r"]
[505.114141, "o", "\u001b[?2004h> "]
[505.114341, "o", "        sys.stderr.write(f\"Table '{table_name}' not found\\n\")\r\n\u001b[?2004l\r"]
[505.114363, "o", "\u001b[?2004h> "]
[505.114424, "o", "        return 1\r\n\u001b[?2004l\r"]
[505.114446, "o", "\u001b[?2004h> "]
[505.114576, "o", "    table = db.open_table(table_name)\r\n\u001b[?2004l\r"]
[505.11461, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[505.114633, "o", "\u001b[?2004h> "]
[505.114744, "o", "    qvec = embed_texts([query])[0]\r\n\u001b[?2004l\r"]
[505.114768, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[505.11479, "o", "\u001b[?2004h> "]
[505.11497, "o", "    rows = table.search(qvec).limit(k).to_list()\r\n\u001b[?2004l\r"]
[505.114993, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[505.115017, "o", "\u001b[?2004h> "]
[505.115085, "o", "    results = []\r\n\u001b[?2004l\r"]
[505.115122, "o", "\u001b[?2004h> "]
[505.115174, "o", "    for r in rows:\r\n\u001b[?2004l\r"]
[505.115196, "o", "\u001b[?2004h> "]
[505.115272, "o", "        score = None\r\n\u001b[?2004l\r"]
[505.115294, "o", "\u001b[?2004h> "]
[505.115548, "o", "        for key in (\"_distance\", \"_score\", \"score\", \"distance\", \"similarity\"):\r\n\u001b[?2004l\r"]
[505.11557, "o", "\u001b[?2004h> "]
[505.115658, "o", "            if key in r:\r\n\u001b[?2004l\r"]
[505.11568, "o", "\u001b[?2004h> "]
[505.115785, "o", "                score = r[key]\r\n\u001b[?2004l\r"]
[505.115821, "o", "\u001b[?2004h> "]
[505.115892, "o", "                break\r\n\u001b[?2004l\r"]
[505.115915, "o", "\u001b[?2004h> "]
[505.116004, "o", "        if score is None:\r\n\u001b[?2004l\r"]
[505.116043, "o", "\u001b[?2004h> "]
[505.116108, "o", "            score = 0.0\r\n\u001b[?2004l\r"]
[505.116135, "o", "\u001b[?2004h> "]
[505.116188, "o", "        try:\r\n\u001b[?2004l\r"]
[505.116213, "o", "\u001b[?2004h> "]
[505.116333, "o", "            score_f = float(score)\r\n\u001b[?2004l\r"]
[505.11637, "o", "\u001b[?2004h> "]
[505.116494, "o", "            if score_f != score_f:  # NaN\r\n\u001b[?2004l\r"]
[505.116515, "o", "\u001b[?2004h> "]
[505.116619, "o", "                score_f = 0.0\r\n\u001b[?2004l\r"]
[505.116656, "o", "\u001b[?2004h> "]
[505.116865, "o", "            if score_f == float(\"inf\") or score_f == float(\"-inf\"):\r\n\u001b[?2004l\r"]
[505.116887, "o", "\u001b[?2004h> "]
[505.116993, "o", "                score_f = 0.0\r\n\u001b[?2004l\r"]
[505.117031, "o", "\u001b[?2004h> "]
[505.117102, "o", "        except Exception:\r\n\u001b[?2004l\r"]
[505.117135, "o", "\u001b[?2004h> "]
[505.117215, "o", "            score_f = 0.0\r\n\u001b[?2004l\r"]
[505.117238, "o", "\u001b[?2004h> "]
[505.117325, "o", "        results.append({\r\n\u001b[?2004l\r"]
[505.117362, "o", "\u001b[?2004h> "]
[505.117493, "o", "            \"id\": int(r.get(\"id\", 0) or 0),\r\n\u001b[?2004l\r"]
[505.117516, "o", "\u001b[?2004h> "]
[505.117686, "o", "            \"title\": str(r.get(\"title\", \"\") or \"\"),\r\n\u001b[?2004l\r"]
[505.117709, "o", "\u001b[?2004h> "]
[505.117906, "o", "            \"category\": str(r.get(\"category\", \"\") or \"\"),\r\n\u001b[?2004l\r"]
[505.117929, "o", "\u001b[?2004h> "]
[505.118129, "o", "            \"published\": str(r.get(\"published\", \"\") or \"\"),\r\n\u001b[?2004l\r"]
[505.118151, "o", "\u001b[?2004h> "]
[505.118267, "o", "            \"score\": score_f,\r\n\u001b[?2004l\r\u001b[?2004h"]
[505.1183, "o", "> "]
[505.118371, "o", "        })\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[505.118553, "o", "    out = {\"query\": query, \"k\": k, \"results\": results}\r\n\u001b[?2004l\r"]
[505.118578, "o", "\u001b[?2004h> "]
[505.118764, "o", "    sys.stdout.write(json.dumps(out, ensure_ascii=False))\r\n\u001b[?2004l\r"]
[505.118789, "o", "\u001b[?2004h> "]
[505.118885, "o", "    sys.stdout.write(\"\\n\")\r\n\u001b[?2004l\r"]
[505.11891, "o", "\u001b[?2004h> "]
[505.118986, "o", "    sys.stdout.flush()\r\n\u001b[?2004l\r"]
[505.119028, "o", "\u001b[?2004h> "]
[505.119052, "o", "    return 0\r\n\u001b[?2004l\r"]
[505.119078, "o", "\u001b[?2004h> "]
[505.119102, "o", "\r\n\u001b[?2004l\r\u001b[?2004h"]
[505.119127, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h"]
[505.119152, "o", "> "]
[505.119192, "o", "def main():\r\n\u001b[?2004l\r"]
[505.119216, "o", "\u001b[?2004h> "]
[505.119388, "o", "    parser = argparse.ArgumentParser(prog=\"loader\")\r\n\u001b[?2004l\r"]
[505.119411, "o", "\u001b[?2004h> "]
[505.119599, "o", "    sub = parser.add_subparsers(dest=\"cmd\", required=True)\r\n\u001b[?2004l\r"]
[505.119621, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[505.119666, "o", "\u001b[?2004h> "]
[505.119776, "o", "    p_ing = sub.add_parser(\"ingest\")\r\n\u001b[?2004l\r"]
[505.1198, "o", "\u001b[?2004h> "]
[505.119958, "o", "    p_ing.add_argument(\"--csv\", required=True)\r\n\u001b[?2004l\r"]
[505.120001, "o", "\u001b[?2004h> "]
[505.120144, "o", "    p_ing.add_argument(\"--table\", required=True)\r\n\u001b[?2004l\r"]
[505.120167, "o", "\u001b[?2004h> "]
[505.120338, "o", "    p_ing.add_argument(\"--text-col\", required=True)\r\n\u001b[?2004l\r"]
[505.120364, "o", "\u001b[?2004h> "]
[505.120567, "o", "    p_ing.add_argument(\"--batch-size\", type=int, required=True)\r\n\u001b[?2004l\r"]
[505.120591, "o", "\u001b[?2004h> "]
[505.120721, "o", "    p_ing.set_defaults(func=cmd_ingest)\r\n\u001b[?2004l\r"]
[505.120745, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[505.120773, "o", "\u001b[?2004h> "]
[505.120918, "o", "    p_search = sub.add_parser(\"search\")\r\n\u001b[?2004l\r"]
[505.120941, "o", "\u001b[?2004h> "]
[505.121109, "o", "    p_search.add_argument(\"--table\", required=True)\r\n\u001b[?2004l\r"]
[505.121131, "o", "\u001b[?2004h> "]
[505.121303, "o", "    p_search.add_argument(\"--query\", required=True)\r\n\u001b[?2004l\r"]
[505.121328, "o", "\u001b[?2004h> "]
[505.121514, "o", "    p_search.add_argument(\"--k\", type=int, required=True)\r\n\u001b[?2004l\r"]
[505.121536, "o", "\u001b[?2004h> "]
[505.121678, "o", "    p_search.set_defaults(func=cmd_search)\r\n\u001b[?2004l\r"]
[505.1217, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[505.121725, "o", "\u001b[?2004h"]
[505.121748, "o", "> "]
[505.121848, "o", "    args = parser.parse_args()\r\n\u001b[?2004l\r"]
[505.121871, "o", "\u001b[?2004h> "]
[505.121962, "o", "    return args.func(args)\r\n\u001b[?2004l\r"]
[505.121984, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[505.12201, "o", "\u001b[?2004h> "]
[505.122072, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[505.122139, "o", "if __name__ == \"__main__\":\r\n\u001b[?2004l\r"]
[505.122163, "o", "\u001b[?2004h> "]
