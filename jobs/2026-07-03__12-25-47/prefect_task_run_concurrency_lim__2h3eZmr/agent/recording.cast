[182.192461, "i", "cat > /home/user/project/flow.py << 'EOF'\nimport time\nfrom prefect import flow, task\n\n@task(tags=[\"heavy-processing\"])\ndef process_data(i):\n    print(f\"Processing data chunk {i}\")\n    time.sleep(1)\n    return i * 2\n\n@flow\ndef main_flow():\n    for i in range(5):\n        process_data.submit(i)\n\nif __name__ == \"__main__\":\n    main_flow()\nEOF\n"]
