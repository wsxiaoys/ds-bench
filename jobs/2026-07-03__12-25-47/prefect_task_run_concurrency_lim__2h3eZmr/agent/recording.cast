[105.571716, "o", "\u001b[1m                                                                                                                                                                \u001b[0m\r\n\u001b[1m \u001b[0m\u001b[1;33mUsage: \u001b[0m\u001b[1mprefect concurrency-limit [OPTIONS] COMMAND [ARGS]...\u001b[0m\u001b[1m                                                                                                  \u001b[0m\u001b[1m \u001b[0m\r\n\u001b[1m                                                                                                                                                                \u001b[0m\r\n"]
[105.57195, "o", " Manage task-level concurrency limits.                                                                                                                          \r\n                                                                                                                                                                \r\n"]
[105.573271, "o", "\u001b[2m╭─\u001b[0m\u001b[2m Options \u001b[0m\u001b[2m───────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────\u001b[0m\u001b[2m─╮\u001b[0m\r\n\u001b[2m│\u001b[0m \u001b[1;36m-\u001b[0m\u001b[1;36m-help\u001b[0m          Show this message and exit.                                                                                                                  \u001b[2m│\u001b[0m\r\n\u001b[2m╰──────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────╯\u001b[0m\r\n"]
[105.574287, "o", "\u001b[2m╭─\u001b[0m\u001b[2m Commands \u001b[0m\u001b[2m──────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────\u001b[0m\u001b[2m─╮\u001b[0m\r\n\u001b[2m│\u001b[0m \u001b[1;36mcreate  \u001b[0m\u001b[1;36m \u001b[0m Create a concurrency limit against a tag.                                                                                                          \u001b[2m│\u001b[0m\r\n\u001b[2m│\u001b[0m \u001b[1;36mdelete  \u001b[0m\u001b[1;36m \u001b[0m Delete the concurrency limit set on the specified tag.                                                                                             \u001b[2m│\u001b[0m\r\n\u001b[2m│\u001b[0m \u001b[1;36minspect \u001b[0m\u001b[1;36m \u001b[0m View details about a concurrency limit. `active_slots` shows a list of TaskRun IDs which are currently using a concurrency slot.                   \u001b[2m│\u001b[0m\r\n\u001b[2m│\u001b[0m \u001b[1;36mls      \u001b[0m\u001b[1;36m \u001b[0m View all concurrency limits.                                                                                                                       \u001b[2m│\u001b[0m\r\n\u001b[2m│\u001b[0m \u001b[1;36mreset   \u001b[0m\u001b[1;36m \u001b[0m Resets the concurrency limit slots set on the specified tag.                                                                                       \u001b[2m│\u001b[0m\r\n\u001b[2m╰──────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────╯\u001b[0m\r\n"]
