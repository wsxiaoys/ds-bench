[8.888298, "o", "cat flow.py\r\n\u001b[?2004l\r"]
[8.889943, "o", "import time\r\nfrom prefect import flow, task\r\n\r\n@task\r\ndef process_data(i):\r\n    print(f\"Processing data chunk {i}\")\r\n    time.sleep(1)\r\n    return i * 2\r\n\r\n@flow\r\ndef main_flow():\r\n    for i in range(5):\r\n        process_data.submit(i)\r\n\r\nif __name__ == \"__main__\":\r\n    main_flow()\r\n"]
