[171.130621, "o", "\u001b[3m                                        Concurrency Limits                                        \u001b[0m\r\n┏━━━━━━━━━━━━━━━━━━┳━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━┳━━━━━━━━━━━━━━━━━━━┳━━━━━━━━━━━━━━━━━━┓\r\n┃\u001b[1m \u001b[0m\u001b[1mTag             \u001b[0m\u001b[1m \u001b[0m┃\u001b[1m \u001b[0m\u001b[1m                                  ID\u001b[0m\u001b[1m \u001b[0m┃\u001b[1m \u001b[0m\u001b[1mConcurrency Limit\u001b[0m\u001b[1m \u001b[0m┃\u001b[1m \u001b[0m\u001b[1mActive Task Runs\u001b[0m\u001b[1m \u001b[0m┃\r\n┡━━━━━━━━━━━━━━━━━━╇━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━╇━━━━━━━━━━━━━━━━━━━╇━━━━━━━━━━━━━━━━━━┩\r\n│\u001b[32m \u001b[0m\u001b[32mheavy-processing\u001b[0m\u001b[32m \u001b[0m│\u001b[36m \u001b[0m\u001b[36md2dc2aa7-496d-4a24-896d-e64014852e9f\u001b[0m\u001b[36m \u001b[0m│\u001b[34m \u001b[0m\u001b[34m2                \u001b[0m\u001b[34m \u001b[0m│\u001b[35m \u001b[0m\u001b[35m0               \u001b[0m\u001b[35m \u001b[0m│\r\n└──────────────────┴──────────────────────────────────────┴───────────────────┴──────────────────┘\r\n\u001b[2;3m                     inspect a concurrency limit to show active task run IDs                      \u001b[0m\r\n"]
