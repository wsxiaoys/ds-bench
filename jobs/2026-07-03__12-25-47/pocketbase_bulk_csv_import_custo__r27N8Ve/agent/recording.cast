[314.360107, "o", "grep -n 'POST\\|GET\\|PUT\\|DELETE\\|Any\\|Route\\|Group' /root/go/pkg/mod/github.com/pocketbase/pocketbase@v0.31.0/tools/router/group.go | head -20\r\n\u001b[?2004l\r"]
[314.362431, "o", "11:// (note: the struct is named RouterGroup instead of Group so that it can\r\n12:// be embedded in the Router without conflicting with the Group method)\r\n14:// RouterGroup represents a collection of routes and other sub groups\r\n16:type RouterGroup[T hook.Resolver] struct {\r\n18:\tchildren            []any // Route or RouterGroup\r\n24:// Group creates and register a new child Group into the current one\r\n33:func (group *RouterGroup[T]) Group(prefix string) *RouterGroup[T] {\r\n34:\tnewGroup := &RouterGroup[T]{}\r\n35:\tnewGroup.Prefix = prefix\r\n37:\tgroup.children = append(group.children, newGroup)\r\n39:\treturn newGroup\r\n48:// or middleware with custom exec prirority, use [RouterGroup.Bind] method.\r\n49:func (group *RouterGroup[T]) BindFunc(middlewareFuncs ...func(e T) error) *RouterGroup[T] {\r\n58:func (group *RouterGroup[T]) Bind(middlewares ...*hook.Handler[T]) *RouterGroup[T] {\r\n78:func (group *RouterGroup[T]) Unbind(middlewareIds ...string) *RouterGroup[T] {\r\n94:\t\t\tcase *RouterGroup[T]:\r\n96:\t\t\tcase *Route[T]:\r\n111:// Route registers a single route into the current group.\r\n118:func (group *RouterGroup[T]) Route(method string, path string, action func(e T) error) *Route[T] {\r\n"]
[314.362494, "o", "119:\troute := &Route[T]{\r\n"]
