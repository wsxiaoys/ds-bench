[348.83492, "o", "grep -n 'FileReader\\|Open' /root/go/pkg/mod/github.com/pocketbase/pocketbase@v0.31.0/tools/filesystem/file.go | head -20\r\n\u001b[?2004l\r"]
[348.83711, "o", "21:// FileReader defines an interface for a file resource reader.\r\n22:type FileReader interface {\r\n23:\tOpen() (io.ReadSeekCloser, error)\r\n30:\tReader       FileReader `form:\"-\" json:\"-\" xml:\"-\"`\r\n128:var _ FileReader = (*MultipartReader)(nil)\r\n130:// MultipartReader defines a FileReader from [multipart.FileHeader].\r\n135:// Open implements the [filesystem.FileReader] interface.\r\n136:func (r *MultipartReader) Open() (io.ReadSeekCloser, error) {\r\n137:\treturn r.Header.Open()\r\n142:var _ FileReader = (*PathReader)(nil)\r\n144:// PathReader defines a FileReader from a local file path.\r\n149:// Open implements the [filesystem.FileReader] interface.\r\n150:func (r *PathReader) Open() (io.ReadSeekCloser, error) {\r\n151:\treturn os.Open(r.Path)\r\n156:var _ FileReader = (*BytesReader)(nil)\r\n158:// BytesReader defines a FileReader from bytes content.\r\n163:// Open implements the [filesystem.FileReader] interface.\r\n164:func (r *BytesReader) Open() (io.ReadSeekCloser, error) {\r\n179:var _ FileReader = (openFuncAsReader)(nil)\r\n181:// openFuncAsReader defines a FileReader from a bare Open function.\r\n"]
