[164.980732, "o", "func (e *Event) FindUploadedFiles(key string) ([]*filesystem.File, error) {\r\n\tif e.Request.MultipartForm == nil {\r\n\t\terr := e.Request.ParseMultipartForm(DefaultMaxMemory)\r\n\t\tif err != nil {\r\n\t\t\treturn nil, err\r\n\t\t}\r\n\t}\r\n\r\n"]
[164.980759, "o", "\tif e.Request.MultipartForm == nil || e.Request.MultipartForm.File == nil || len(e.Request.MultipartForm.File[key]) == 0 {\r\n\t\treturn nil, http.ErrMissingFile\r\n\t}\r\n\r\n\tresult := make([]*filesystem.File, 0, len(e.Request.MultipartForm.File[key]))\r\n\r\n\tfor _, fh := range e.Request.MultipartForm.File[key] {\r\n\t\tfile, err := filesystem.NewFileFromMultipart(fh)\r\n\t\tif err != nil {\r\n\t\t\treturn nil, err\r\n\t"]
[164.980845, "o", "\t}\r\n\r\n\t\tresult = append(result, file)\r\n\t}\r\n\r\n\treturn result, nil\r\n}\r\n\r\n// Store\r\n// -------------------------------------------------------------------\r\n\r\n// Get retrieves single value from the current event data store.\r\n"]
