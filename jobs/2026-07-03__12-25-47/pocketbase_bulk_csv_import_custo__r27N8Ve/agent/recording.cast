[387.696335, "o", "package main\r\n\r\nimport (\r\ngo.mod \"encoding/csv\"\r\ngo.mod \"errors\"\r\ngo.mod \"fmt\"\r\ngo.mod \"io\"\r\ngo.mod \"log\"\r\ngo.mod \"net/http\"\r\ngo.mod \"os\"\r\ngo.mod \"strconv\"\r\ngo.mod \"strings\"\r\n\r\ngo.mod \"github.com/pocketbase/pocketbase\"\r\ngo.mod \"github.com/pocketbase/pocketbase/apis\"\r\ngo.mod \"github.com/pocketbase/pocketbase/core\"\r\ngo.mod \"github.com/pocketbase/pocketbase/tools/hook\"\r\n)\r\n\r\n"]
[387.696428, "o", "const productsCollectionName = \"products\"\r\n\r\nfunc main() {\r\ngo.mod app := pocketbase.New()\r\n\r\ngo.mod app.OnServe().BindFunc(func(e *core.ServeEvent) error {\r\ngo.mod go.mod // Register the bulk import route\r\ngo.mod go.mod e.Router.POST(\"/api/import/products\", importProducts).Bind(apis.RequireSuperuserAuth())\r\n\r\ngo.mod go.mod if err := e.Next(); err != nil {\r\ngo.mod go.mod go.mod return err\r\n"]
