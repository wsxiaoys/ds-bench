[356.304033, "i", "sleep 90 && python3 << 'EOF'\nimport os, httpx, json, time\nurl = os.environ['OPENAI_BASE_URL'].rstrip('/') + '/embeddings'\nheaders = {'Authorization': 'Bearer ' + os.environ['OPENAI_API_KEY'], 'Content-Type': 'application/json'}\nfor type_val in ['query', 'document', 'passage']:\n    data = {'model': 'MiniMax-M3', 'texts': ['hello world'], 'type': type_val}\n    with httpx.Client(timeout=30) as c:\n        r = c.post(url, json=data, headers=headers)\n        print(f\"type={type_val}: {r.status_code} {r.text[:300]}\")\n    time.sleep(3)\nEOF\n"]
