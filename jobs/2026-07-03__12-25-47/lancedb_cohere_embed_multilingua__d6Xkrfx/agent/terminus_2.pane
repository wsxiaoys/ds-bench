[?2004l[?2004h> 
[?2004l[?2004h> COHERE_MODEL = "embed-multilingual-v3.0"
[?2004l[?2004h> VECTOR_DIM = 1024
[?2004l[?2004h> 
[?2004l[?2004h> # ---------------------------------------------------------------------------
[?2004l[?2004h> # Lazy singletons
[?2004l[?2004h> # ---------------------------------------------------------------------------
[?2004l[?2004h> _client = None
[?2004l[?2004h> _db = None
[?2004l[?2004h> _table = None
[?2004l[?2004h> _built = False
[?2004l[?2004h> 
[?2004l[?2004h> 
[?2004l[?2004h> def _get_client() -> cohere.Client:
