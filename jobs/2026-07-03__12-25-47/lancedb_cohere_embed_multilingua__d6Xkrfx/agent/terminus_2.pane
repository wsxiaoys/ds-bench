[?2004l[?2004h> 
[?2004l[?2004h> 
[?2004l[?2004h> def _schema():
[?2004l[?2004h>     """Return an Arrow schema with a fixed-size 1024-d float32 list for vectors."""
[?2004l[?2004h>     return pa.schema(
[?2004l[?2004h>         [
[?2004l[?2004h>             pa.field("concept_id", pa.int32()),
[?2004l[?2004h>             pa.field("language", pa.string()),
[?2004l[?2004h>             pa.field("text", pa.string()),
[?2004l[?2004h>             pa.field("vector", pa.list_(pa.float32(), VECTOR_DIM)),
[?2004l[?2004h>         ]
[?2004l[?2004h>     )
[?2004l[?2004h> 
[?2004l[?2004h> 
[?2004l[?2004h> def _extract_embeddings(response) -> list:
[?2004l[?2004h>     """Pull a list of embedding vectors out of a Cohere embed response."""
