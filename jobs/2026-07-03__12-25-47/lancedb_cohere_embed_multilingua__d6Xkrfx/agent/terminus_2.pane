[?2004l[?2004h>     if hasattr(emb, "float_"):
[?2004l[?2004h>         emb = emb.float_
[?2004l[?2004h>     elif hasattr(emb, "float"):
[?2004l[?2004h>         emb = emb.float
[?2004l[?2004h>     return [list(map(float, v)) for v in emb]
[?2004l[?2004h> 
[?2004l[?2004h> 
[?2004l[?2004h> def build_index() -> None:
[?2004l[?2004h>     """Read the corpus, embed every text with Cohere, and persist to LanceDB."""
[?2004l[?2004h>     global _table, _built
[?2004l[?2004h> 
[?2004l[?2004h>     if _built:
[?2004l[?2004h>         return
[?2004l[?2004h> 
[?2004l[?2004h>     # Load corpus
[?2004l[?2004h>     with open(CORPUS_PATH, "r", encoding="utf-8") as f:
[?2004l[?2004h>         rows = json.load(f)
[?2004l[?2004h>     if not isinstance(rows, list):
[?2004l[?2004h>         raise ValueError("corpus.json must contain a list of rows")
[?2004l[?2004h> 
[?2004l[?2004h>     texts = [r["text"] for r in rows]
[?2004l[?2004h>     languages = [r["language"] for r in rows]
[?2004l[?2004h>     concept_ids = [int(r["concept_id"]) for r in rows]
[?2004l[?2004h> 
[?2004l[?2004h>     co = _get_client()
[?2004l[?2004h> 
[?2004l[?2004h>     # Embed documents with the proper input type.
[?2004l[?2004h>     # Cohere accepts up to 96 texts per call and we have 90, so a single call works,
[?2004l[?2004h>     # but we still batch defensively.
[?2004l[?2004h>     all_vectors: list[list[float]] = []
[?2004l[?2004h>     batch_size = 96
[?2004l[?2004h>     for start in range(0, len(texts), batch_size):
[?2004l[?2004h>         batch = texts[start : start + batch_size]
[?2004l[?2004h>         resp = co.embed(
[?2004l[?2004h>             texts=batch,
[?2004l[?2004h>             model=COHERE_MODEL,
[?2004l[?2004h>             input_type="search_document",
[?2004l[?2004h>         )
[?2004l[?2004h>         all_vectors.extend(_extract_embeddings(resp))
[?2004l[?2004h> 
[?2004l[?2004h>     # Convert to float32 numpy arrays (and verify dim) for storage.
[?2004l[?2004h>     arrays: list[np.ndarray] = []
[?2004l[?2004h>     for v in all_vectors:
[?2004l[?2004h>         arr = np.asarray(v, dtype=np.float32)
[?2004l[?2004h>         if arr.shape[0] != VECTOR_DIM:
[?2004l[?2004h>             raise ValueError(
[?2004l[?2004h>                 f"unexpected embedding dim {arr.shape[0]}, expected {VECTOR_DIM}"
[?2004l[?2004h>             )
[?2004l[?2004h>         arrays.append(arr)
[?2004l[?2004h> 
[?2004l[?2004h>     # Build records for LanceDB.
[?2004l[?2004h>     records = [
[?2004l[?2004h>         {
[?2004l[?2004h>             "concept_id": np.int32(concept_ids[i]),
[?2004l[?2004h>             "language": languages[i],
[?2004l[?2004h>             "text": texts[i],
[?2004l[?2004h>             "vector": arrays[i],
[?2004l[?2004h>         }
[?2004l[?2004h>         for i in range(len(texts))
[?2004l[?2004h>     ]
[?2004l[?2004h> 
[?2004l[?2004h>     db = _get_db()
[?2004l[?2004h> 
[?2004l[?2004h>     # Drop existing table if rerun in same dir.
[?2004l[?2004h>     try:
[?2004l[?2004h>         if TABLE_NAME in db.table_names():
[?2004l[?2004h>             db.drop_table(TABLE_NAME)
[?2004l[?2004h>     except Exception:
[?2004l[?2004h>         pass
[?2004l[?2004h> 
[?2004l[?2004h>     tbl = db.create_table(TABLE_NAME, data=records, schema=_schema(), mode="overwrite")
[?2004l[?2004h> 
[?2004l[?2004h>     # Make sure a vector index exists (helps recall and speed for top-k).
[?2004l[?2004h>     try:
[?2004l[?2004h>         tbl.create_index(num_partitions=1, num_sub_vectors=16, metric="cosine")
[?2004l[?2004h>     except Exception:
[?2004l[?2004h>         # Index creation is optional; an exact search will still work.
[?2004l[?2004h>         pass
[?2004l[?2004h> 
[?2004l[?2004h>     _table = tbl
[?2004l[?2004h>     _built = True
[?2004l[?2004h> 
[?2004l[?2004h> 
[?2004l[?2004h> def _ensure_table():
[?2004l[?2004h>     global _table
[?2004l[?2004h>     if _table is not None:
[?2004l[?2004h>         return _table
[?2004l[?2004h>     db = _get_db()
[?2004l[?2004h>     # If the verifier previously called build_index, the table should exist.
[?2004l[?2004h>     names = db.table_names()
[?2004l[?2004h>     if TABLE_NAME in names:
[?2004l[?2004h>         _table = db.open_table(TABLE_NAME)
[?2004l[?2004h>         return _table
[?2004l[?2004h>     # Otherwise build it lazily.
[?2004l[?2004h>     build_index()
[?2004l[?2004h>     return _table
[?2004l[?2004h> 
[?2004l[?2004h> 
[?2004l[?2004h> def cross_lingual_search(query: str, k: int = 3) -> list[dict]:
[?2004l[?2004h>     """Embed ``query`` and return the top-k documents across all three languages."""
[?2004l[?2004h>     if not isinstance(query, str):
[?2004l[?2004h>         raise TypeError("query must be a string")
[?2004l[?2004h>     if not isinstance(k, int) or k <= 0:
[?2004l[?2004h>         raise ValueError("k must be a positive int")
[?2004l[?2004h> 
[?2004l[?2004h>     tbl = _ensure_table()
[?2004l[?2004h> 
[?2004l[?2004h>     co = _get_client()
[?2004l[?2004h>     resp = co.embed(
[?2004l[?2004h>         texts=[query],
[?2004l[?2004h>         model=COHERE_MODEL,
[?2004l[?2004h>         input_type="search_query",
[?2004l[?2004h>     )
[?2004l[?2004h>     vecs = _extract_embeddings(resp)
[?2004l[?2004h>     qvec = np.asarray(vecs[0], dtype=np.float32)
[?2004l[?2004h>     if qvec.shape[0] != VECTOR_DIM:
[?2004l[?2004h>         raise ValueError(
[?2004l[?2004h>             f"unexpected query embedding dim {qvec.shape[0]}, expected {VECTOR_DIM}"
[?2004l[?2004h>         )
[?2004l[?2004h> 
[?2004l[?2004h>     # Search across all languages (no filter), sorted by ascending distance.
[?2004l[?2004h>     results = (
[?2004l[?2004h>         tbl.search(qvec.tolist())
[?2004l[?2004h>         .metric("cosine")
[?2004l[?2004h>         .limit(k)
[?2004l[?2004h>         .to_pandas()
[?2004l[?2004h>     )
[?2004l[?2004h> 
[?2004l[?2004h>     out: list[dict] = []
[?2004l[?2004h>     for _, row in results.iterrows():
[?2004l[?2004h>         out.append(
[?2004l[?2004h>             {
[?2004l[?2004h>                 "concept_id": int(row["concept_id"]),
[?2004l[?2004h>                 "language": str(row["language"]),
[?2004l[?2004h>                 "text": str(row["text"]),
[?2004l[?2004h>             }
[?2004l[?2004h>         )
[?2004l[?2004h>     return out
