[36.89038, "i", "python3 << 'EOF'\nimport cohere\nco = cohere.Client()\nr = co.embed(texts=['hello', 'world'], model='embed-multilingual-v3.0', input_type='search_document')\nprint('embeddings type:', type(r.embeddings))\nif isinstance(r.embeddings, list):\n    print('len:', len(r.embeddings))\n    print('first type:', type(r.embeddings[0]))\n    if isinstance(r.embeddings[0], list):\n        print('vec dim:', len(r.embeddings[0]))\n        print('first few:', r.embeddings[0][:5])\nelse:\n    print('embeddings attr:', dir(r.embeddings))\nEOF\n"]
