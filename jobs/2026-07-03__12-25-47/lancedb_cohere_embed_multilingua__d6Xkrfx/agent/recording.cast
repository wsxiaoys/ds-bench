[112.639257, "o", "\u001b[?2004h> "]
[112.639538, "o", "print('Schema:', tbl.schema)\r\n\u001b[?2004l\r"]
[112.639602, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[112.639672, "o", "\u001b[?2004h"]
