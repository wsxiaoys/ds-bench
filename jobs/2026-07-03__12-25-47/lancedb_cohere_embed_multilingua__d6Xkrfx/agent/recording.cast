[112.639906, "o", "# Quick multi-lang test\r\n\u001b[?2004l\r"]
[112.639973, "o", "\u001b[?2004h> "]
[112.640122, "o", "import solution\r\n\u001b[?2004l\r"]
[112.640193, "o", "\u001b[?2004h> "]
