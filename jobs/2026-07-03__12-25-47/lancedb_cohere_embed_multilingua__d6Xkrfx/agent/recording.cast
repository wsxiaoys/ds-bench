[111.54178, "o", "\u001b[?2004hroot@92dc6a4f-4f12-40a7-bd5b-35128abcc7eb:/home/user/myproject# "]
[112.636338, "i", "python3 << 'EOF'\nimport lancedb, pyarrow as pa, json, pathlib\n\ndb = lancedb.connect('/home/user/myproject/lancedb_data')\nprint('Tables:', db.table_names())\ntbl = db.open_table('multilingual_zrzl84khxk')\nprint('Count:', tbl.count_rows())\nprint('Schema:', tbl.schema)\n\n# Quick multi-lang test\nimport solution\nprint('---')\nfor q in [\"Where is the Eiffel Tower?\",\n          \"¿Dónde está la Torre Eiffel?\",\n          \"Où est la Tour Eiffel ?\",\n          \"Who painted the Mona Lisa?\",\n          \"Bonjour, comment allez-vous?\"]:\n    hits = solution.cross_lingual_search(q, k=3)\n    print(f'Q: {q}')\n    for h in hits:\n        print(f'  c={h[\"concept_id\"]} lang={h[\"language\"]} text={h[\"text\"][:60]}')\nEOF\n"]
[112.636784, "o", "python3 << 'EOF'\r\n\u001b[?2004l\r"]
[112.63689, "o", "\u001b[?2004h"]
[112.636967, "o", "> "]
[112.637286, "o", "import lancedb, pyarrow as pa, json, pathlib\r\n\u001b[?2004l\r"]
[112.637356, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[112.637445, "o", "\u001b[?2004h"]
[112.637517, "o", "> "]
[112.637963, "o", "db = lancedb.connect('/home/user/myproject/lancedb_data')\r\n\u001b[?2004l\r"]
[112.638032, "o", "\u001b[?2004h> "]
[112.638335, "o", "print('Tables:', db.table_names())\r\n\u001b[?2004l\r"]
[112.638385, "o", "\u001b[?2004h> "]
