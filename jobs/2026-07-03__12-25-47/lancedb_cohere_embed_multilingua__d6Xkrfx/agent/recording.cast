[112.640806, "o", "\u001b[?2004h> "]
[112.641201, "o", "          \"¿Dónde está la Torre Eiffel?\",\r\n\u001b[?2004l\r"]
[112.641267, "o", "\u001b[?2004h> "]
[112.641631, "o", "          \"Où est la Tour Eiffel ?\",\r\n\u001b[?2004l\r"]
[112.641688, "o", "\u001b[?2004h> "]
