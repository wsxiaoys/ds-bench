[112.642101, "o", "\u001b[?2004h> "]
[112.642504, "o", "          \"Bonjour, comment allez-vous?\"]:\r\n\u001b[?2004l\r"]
[112.642588, "o", "\u001b[?2004h> "]
[112.642987, "o", "    hits = solution.cross_lingual_search(q, k=3)\r\n\u001b[?2004l\r"]
[112.643039, "o", "\u001b[?2004h> "]
[112.643248, "o", "    print(f'Q: {q}')\r\n\u001b[?2004l\r"]
[112.643321, "o", "\u001b[?2004h> "]
[112.643499, "o", "    for h in hits:\r\n\u001b[?2004l\r"]
[112.643551, "o", "\u001b[?2004h> "]
[112.644277, "o", "        print(f'  c={h[\"concept_id\"]} lang={h[\"language\"]} text={h[\"text\"][:60]}')\r\n\u001b[?2004l\r"]
[112.644329, "o", "\u001b[?2004h> "]
