[69.504454, "i", "cat > /home/user/myproject/solution.py << 'PYEOF'\n\"\"\"\nCross-lingual semantic search using Cohere's embed-multilingual-v3.0 and LanceDB.\n\"\"\"\nimport os\nimport json\nimport pathlib\nimport numpy as np\n\nimport cohere\nimport lancedb\nimport pyarrow as pa\n\n# ---------------------------------------------------------------------------\n# Paths / config\n# ---------------------------------------------------------------------------\nPROJECT_DIR = pathlib.Path(\"/home/user/myproject\")\nCORPUS_PATH = PROJECT_DIR / \"corpus.json\"\n\nRUN_ID_PATH = pathlib.Path(\"/logs/artifacts/run-id\")\nif RUN_ID_PATH.exists():\n    RUN_ID = RUN_ID_PATH.read_text().strip()\nelse:\n    RUN_ID = \"default\"\n\nDB_DIR = PROJECT_DIR / \"lancedb_data\"\nDB_DIR.mkdir(parents=True, exist_ok=True)\n\nTABLE_NAME = f\"multilingual_{RUN_ID}\"\n\nCOHERE_MODEL = \"embed-multilingual-v3.0\"\nVECTOR_DIM = 1024\n\n# ---------------------------------------------------------------------------\n# Lazy singletons\n# ---------------------------------------------------------------------------\n_client = None\n_db = None\n_table = None\n_built = False\n\n\ndef _get_client() -> cohere.Client:\n    global _client\n    if _client is None:\n        api_key = os.environ.get(\"COHERE_API_KEY\")\n        if not api_key:\n            raise RuntimeError(\"COHERE_API_KEY is not set\")\n        _client = cohere.Client(api_key=api_key)\n    return _client\n\n\ndef _get_db() -> lancedb.DBConnection:\n    global _db\n    if _db is None:\n        _db = lancedb.connect(str(DB_DIR))\n    return _db\n\n\ndef _schema():\n    \"\"\"Return an Arrow schema with a fixed-size 1024-d float32 list for vectors.\"\"\"\n    return pa.schema(\n        [\n            pa.field(\"concept_id\", pa.int32()),\n            pa.field(\"language\", pa.string()),\n            pa.field(\"text\", pa.string()),\n            pa.field(\"vector\", pa.list_(pa.float32(), VECTOR_DIM)),\n        ]\n    )\n\n\ndef _extract_embeddings(response) -> list:\n    \"\"\"Pull a list of embedding vectors out of a Cohere embed response.\"\"\"\n    emb = getattr(response, \"embeddings\", None)\n    if isinstance(emb, list) and len(emb) > 0 and not isinstance(emb[0], (list, tuple)):\n        # Possibly an EmbeddingsByType object exposing .float / .float_\n        if hasattr(emb, \"float_\"):\n            emb = emb.float_\n        elif hasattr(emb, \"float\"):\n            emb = emb.float\n    # Some versions put vectors under embeddings.float_\n    if hasattr(emb, \"float_\"):\n        emb = emb.float_\n    elif hasattr(emb, \"float\"):\n        emb = emb.float\n    return [list(map(float, v)) for v in emb]\n\n\ndef build_index() -> None:\n    \"\"\"Read the corpus, embed every text with Cohere, and persist to LanceDB.\"\"\"\n    global _table, _built\n\n    if _built:\n        return\n\n    # Load corpus\n    with open(CORPUS_PATH, \"r\", encoding=\"utf-8\") as f:\n        rows = json.load(f)\n    if not isinstance(rows, list):\n        raise ValueError(\"corpus.json must contain a list of rows\")\n\n    texts = [r[\"text\"] for r in rows]\n    languages = [r[\"language\"] for r in rows]\n    concept_ids = [int(r[\"concept_id\"]) for r in rows]\n\n    co = _get_client()\n\n    # Embed documents with the proper input type.\n    # Cohere accepts up to 96 texts per call and we have 90, so a single call works,\n    # but we still batch defensively.\n    all_vectors: list[list[float]] = []\n    batch_size = 96\n    for start in range(0, len(texts), batch_size):\n        batch = texts[start : start + batch_size]\n        resp = co.embed(\n            texts=batch,\n            model=COHERE_MODEL,\n            input_type=\"search_document\",\n        )\n        all_vectors.extend(_extract_embeddings(resp))\n\n    # Convert to float32 numpy arrays (and verify dim) for storage.\n    arrays: list[np.ndarray] = []\n    for v in all_vectors:\n        arr = np.asarray(v, dtype=np.float32)\n        if arr.shape[0] != VECTOR_DIM:\n            raise ValueError(\n                f\"unexpected embedding dim {arr.shape[0]}, expected {VECTOR_DIM}\"\n            )\n        arrays.append(arr)\n\n    # Build records for LanceDB.\n    records = [\n        {\n            \"concept_id\": np.int32(concept_ids[i]),\n            \"language\": languages[i"]
[69.504648, "i", "],\n            \"text\": texts[i],\n            \"vector\": arrays[i],\n        }\n        for i in range(len(texts))\n    ]\n\n    db = _get_db()\n\n    # Drop existing table if rerun in same dir.\n    try:\n        if TABLE_NAME in db.table_names():\n            db.drop_table(TABLE_NAME)\n    except Exception:\n        pass\n\n    tbl = db.create_table(TABLE_NAME, data=records, schema=_schema(), mode=\"overwrite\")\n\n    # Make sure a vector index exists (helps recall and speed for top-k).\n    try:\n        tbl.create_index(num_partitions=1, num_sub_vectors=16, metric=\"cosine\")\n    except Exception:\n        # Index creation is optional; an exact search will still work.\n        pass\n\n    _table = tbl\n    _built = True\n\n\ndef _ensure_table():\n    global _table\n    if _table is not None:\n        return _table\n    db = _get_db()\n    # If the verifier previously called build_index, the table should exist.\n    names = db.table_names()\n    if TABLE_NAME in names:\n        _table = db.open_table(TABLE_NAME)\n        return _table\n    # Otherwise build it lazily.\n    build_index()\n    return _table\n\n\ndef cross_lingual_search(query: str, k: int = 3) -> list[dict]:\n    \"\"\"Embed ``query`` and return the top-k documents across all three languages.\"\"\"\n    if not isinstance(query, str):\n        raise TypeError(\"query must be a string\")\n    if not isinstance(k, int) or k <= 0:\n        raise ValueError(\"k must be a positive int\")\n\n    tbl = _ensure_table()\n\n    co = _get_client()\n    resp = co.embed(\n        texts=[query],\n        model=COHERE_MODEL,\n        input_type=\"search_query\",\n    )\n    vecs = _extract_embeddings(resp)\n    qvec = np.asarray(vecs[0], dtype=np.float32)\n    if qvec.shape[0] != VECTOR_DIM:\n        raise ValueError(\n            f\"unexpected query embedding dim {qvec.shape[0]}, expected {VECTOR_DIM}\"\n        )\n\n    # Search across all languages (no filter), sorted by ascending distance.\n    results = (\n        tbl.search(qvec.tolist())\n        .metric(\"cosine\")\n        .limit(k)\n        .to_pandas()\n    )\n\n    out: list[dict] = []\n    for _, row in results.iterrows():\n        out.append(\n            {\n                \"concept_id\": int(row[\"concept_id\"]),\n                \"language\": str(row[\"language\"]),\n                \"text\": str(row[\"text\"]),\n            }\n        )\n    return out\n\n\nif __name__ == \"__main__\":  # quick smoke test when run directly\n    build_index()\n    hits = cross_lingual_search(\"Where is the Eiffel Tower?\", k=3)\n    for h in hits:\n        print(h)\nPYEOF\n"]
[69.505274, "o", "cat > /home/user/myproject/solution.py << 'PYEOF'\r\n\u001b[?2004l\r"]
[69.505445, "o", "\u001b[?2004h> "]
[69.505502, "o", "\"\"\"\r\n\u001b[?2004l\r\u001b[?2004h> "]
[69.506235, "o", "Cross-lingual semantic search using Cohere's embed-multilingual-v3.0 and LanceDB.\r\n\u001b[?2004l\r"]
[69.506288, "o", "\u001b[?2004h> "]
[69.506341, "o", "\"\"\"\r\n\u001b[?2004l\r"]
[69.506393, "o", "\u001b[?2004h> "]
[69.506552, "o", "import os\r\n\u001b[?2004l\r\u001b[?2004h"]
[69.506603, "o", "> "]
[69.5067, "o", "import json\r\n\u001b[?2004l\r"]
[69.506749, "o", "\u001b[?2004h> "]
[69.5069, "o", "import pathlib\r\n\u001b[?2004l\r"]
[69.50695, "o", "\u001b[?2004h> "]
[69.507136, "o", "import numpy as np\r\n\u001b[?2004l\r"]
[69.507185, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[69.507275, "o", "\u001b[?2004h> "]
[69.507405, "o", "import cohere\r\n\u001b[?2004l\r"]
[69.507464, "o", "\u001b[?2004h> "]
[69.507617, "o", "import lancedb\r\n\u001b[?2004l\r"]
[69.507668, "o", "\u001b[?2004h> "]
[69.507868, "o", "import pyarrow as pa\r\n\u001b[?2004l\r"]
[69.507918, "o", "\u001b[?2004h> "]
[69.50797, "o", "\r\n\u001b[?2004l\r\u001b[?2004h"]
[69.508082, "o", "> "]
[69.508691, "o", "# ---------------------------------------------------------------------------\r\n\u001b[?2004l\r"]
[69.508742, "o", "\u001b[?2004h> "]
[69.508912, "o", "# Paths / config\r\n\u001b[?2004l\r"]
[69.508965, "o", "\u001b[?2004h> "]
[69.509656, "o", "# ---------------------------------------------------------------------------\r\n\u001b[?2004l\r"]
[69.509708, "o", "\u001b[?2004h> "]
[69.510167, "o", "PROJECT_DIR = pathlib.Path(\"/home/user/myproject\")\r\n\u001b[?2004l\r"]
[69.510218, "o", "\u001b[?2004h> "]
[69.510615, "o", "CORPUS_PATH = PROJECT_DIR / \"corpus.json\"\r\n\u001b[?2004l\r"]
[69.510666, "o", "\u001b[?2004h> \r\n"]
[69.510717, "o", "\u001b[?2004l\r\u001b[?2004h"]
[69.510769, "o", "> "]
[69.511219, "o", "RUN_ID_PATH = pathlib.Path(\"/logs/artifacts/run-id\")\r\n\u001b[?2004l\r"]
[69.511268, "o", "\u001b[?2004h> "]
[69.511515, "o", "if RUN_ID_PATH.exists():\r\n\u001b[?2004l\r"]
[69.511563, "o", "\u001b[?2004h> "]
[69.511985, "o", "    RUN_ID = RUN_ID_PATH.read_text().strip()\r\n\u001b[?2004l\r"]
[69.512034, "o", "\u001b[?2004h> "]
[69.512117, "o", "else:\r\n\u001b[?2004l\r"]
[69.512213, "o", "\u001b[?2004h> "]
[69.512383, "o", "    RUN_ID = \"default\"\r\n\u001b[?2004l\r"]
[69.512441, "o", "\u001b[?2004h> "]
[69.51253, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[69.51287, "o", "DB_DIR = PROJECT_DIR / \"lancedb_data\"\r\n\u001b[?2004l\r"]
[69.512921, "o", "\u001b[?2004h> "]
[69.513327, "o", "DB_DIR.mkdir(parents=True, exist_ok=True)\r\n\u001b[?2004l\r"]
[69.513378, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[69.51349, "o", "\u001b[?2004h> "]
[69.513804, "o", "TABLE_NAME = f\"multilingual_{RUN_ID}\"\r\n\u001b[?2004l\r"]
[69.513853, "o", "\u001b[?2004h> \r\n"]
[69.513904, "o", "\u001b[?2004l\r\u001b[?2004h"]
[69.513957, "o", "> "]
[69.514306, "o", "COHERE_MODEL = \"embed-multilingual-v3.0\"\r\n\u001b[?2004l\r"]
[69.514354, "o", "\u001b[?2004h> "]
[69.514545, "o", "VECTOR_DIM = 1024\r\n\u001b[?2004l\r"]
[69.514594, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[69.514695, "o", "\u001b[?2004h> "]
[69.515357, "o", "# ---------------------------------------------------------------------------\r\n\u001b[?2004l\r"]
[69.515409, "o", "\u001b[?2004h> "]
[69.515594, "o", "# Lazy singletons\r\n\u001b[?2004l\r"]
[69.515648, "o", "\u001b[?2004h> "]
[69.516338, "o", "# ---------------------------------------------------------------------------\r\n\u001b[?2004l\r"]
[69.516391, "o", "\u001b[?2004h> "]
[69.516545, "o", "_client = None\r\n\u001b[?2004l\r"]
[69.516597, "o", "\u001b[?2004h> "]
[69.516723, "o", "_db = None\r\n\u001b[?2004l\r"]
[69.516774, "o", "\u001b[?2004h> "]
[69.516915, "o", "_table = None\r\n\u001b[?2004l\r"]
[69.516965, "o", "\u001b[?2004h> "]
[69.517117, "o", "_built = False\r\n\u001b[?2004l\r"]
[69.517169, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[69.517267, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[69.517337, "o", "\u001b[?2004h> "]
[69.517652, "o", "def _get_client() -> cohere.Client:\r\n\u001b[?2004l\r"]
[69.517703, "o", "\u001b[?2004h> "]
[69.517894, "o", "    global _client\r\n\u001b[?2004l\r"]
[69.517945, "o", "\u001b[?2004h> "]
[69.518175, "o", "    if _client is None:\r\n\u001b[?2004l\r"]
[69.518227, "o", "\u001b[?2004h> "]
[69.518709, "o", "        api_key = os.environ.get(\"COHERE_API_KEY\")\r\n\u001b[?2004l\r"]
[69.518761, "o", "\u001b[?2004h> "]
[69.51899, "o", "        if not api_key:\r\n\u001b[?2004l\r"]
[69.519042, "o", "\u001b[?2004h> "]
[69.519593, "o", "            raise RuntimeError(\"COHERE_API_KEY is not set\")\r\n\u001b[?2004l\r"]
[69.519644, "o", "\u001b[?2004h> "]
[69.5201, "o", "        _client = cohere.Client(api_key=api_key)\r\n\u001b[?2004l\r"]
[69.52015, "o", "\u001b[?2004h> "]
[69.520337, "o", "    return _client\r\n\u001b[?2004l\r"]
[69.520389, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[69.520491, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[69.520558, "o", "\u001b[?2004h> "]
[69.520907, "o", "def _get_db() -> lancedb.DBConnection:\r\n\u001b[?2004l\r"]
[69.520958, "o", "\u001b[?2004h> "]
[69.521109, "o", "    global _db\r\n\u001b[?2004l\r"]
[69.52116, "o", "\u001b[?2004h> "]
[69.521361, "o", "    if _db is None:\r\n\u001b[?2004l\r"]
[69.521421, "o", "\u001b[?2004h> "]
[69.521817, "o", "        _db = lancedb.connect(str(DB_DIR))\r\n\u001b[?2004l\r"]
[69.521888, "o", "\u001b[?2004h> "]
[69.522017, "o", "    return _db\r\n\u001b[?2004l\r"]
[69.522068, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[69.522166, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[69.522217, "o", "\u001b[?2004h"]
[69.522268, "o", "> "]
[69.52247, "o", "def _schema():\r\n\u001b[?2004l\r"]
[69.522523, "o", "\u001b[?2004h> "]
[69.523456, "o", "    \"\"\"Return an Arrow schema with a fixed-size 1024-d float32 list for vectors.\"\"\"\r\n\u001b[?2004l\r"]
[69.523533, "o", "\u001b[?2004h> "]
[69.523782, "o", "    return pa.schema(\r\n\u001b[?2004l\r"]
[69.523852, "o", "\u001b[?2004h> "]
[69.523984, "o", "        [\r\n\u001b[?2004l\r"]
[69.524033, "o", "\u001b[?2004h"]
[69.524085, "o", "> "]
[69.524612, "o", "            pa.field(\"concept_id\", pa.int32()),\r\n\u001b[?2004l\r"]
[69.524662, "o", "\u001b[?2004h"]
[69.524713, "o", "> "]
[69.525217, "o", "            pa.field(\"language\", pa.string()),\r\n\u001b[?2004l\r"]
[69.525294, "o", "\u001b[?2004h> "]
[69.525785, "o", "            pa.field(\"text\", pa.string()),\r\n\u001b[?2004l\r"]
[69.525833, "o", "\u001b[?2004h"]
[69.525884, "o", "> "]
[69.526632, "o", "            pa.field(\"vector\", pa.list_(pa.float32(), VECTOR_DIM)),\r\n\u001b[?2004l\r"]
[69.526681, "o", "\u001b[?2004h"]
[69.526731, "o", "> "]
[69.526834, "o", "        ]\r\n\u001b[?2004l\r"]
[69.526883, "o", "\u001b[?2004h"]
[69.526933, "o", "> "]
[69.526985, "o", "    )\r\n\u001b[?2004l\r"]
[69.527116, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[69.527183, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[69.527273, "o", "\u001b[?2004h> "]
[69.527759, "o", "def _extract_embeddings(response) -> list:\r\n\u001b[?2004l\r"]
[69.527819, "o", "\u001b[?2004h"]
[69.527918, "o", "> "]
[69.528681, "o", "    \"\"\"Pull a list of embedding vectors out of a Cohere embed response.\"\"\"\r\n\u001b[?2004l\r"]
[69.528765, "o", "\u001b[?2004h> "]
[69.529292, "o", "    emb = getattr(response, \"embeddings\", None)\r\n\u001b[?2004l\r"]
[69.529368, "o", "\u001b[?2004h"]
[69.529454, "o", "> "]
[69.530378, "o", "    if isinstance(emb, list) and len(emb) > 0 and not isinstance(emb[0], (list, tuple)):\r\n\u001b[?2004l\r"]
[69.530445, "o", "\u001b[?2004h"]
[69.530552, "o", "> "]
[69.531268, "o", "        # Possibly an EmbeddingsByType object exposing .float / .float_\r\n\u001b[?2004l\r"]
[69.531325, "o", "\u001b[?2004h"]
[69.531383, "o", "> "]
[69.531758, "o", "        if hasattr(emb, \"float_\"):\r\n\u001b[?2004l\r"]
[69.531819, "o", "\u001b[?2004h"]
[69.531875, "o", "> "]
[69.532169, "o", "            emb = emb.float_\r\n\u001b[?2004l\r"]
[69.532249, "o", "\u001b[?2004h> "]
[69.532671, "o", "        elif hasattr(emb, \"float\"):\r\n\u001b[?2004l\r"]
[69.532752, "o", "\u001b[?2004h> "]
[69.533067, "o", "            emb = emb.float\r\n\u001b[?2004l\r"]
[69.533123, "o", "\u001b[?2004h"]
[69.53318, "o", "> "]
[69.533785, "o", "    # Some versions put vectors under embeddings.float_\r\n\u001b[?2004l\r"]
[69.53384, "o", "\u001b[?2004h"]
[69.533899, "o", "> "]
[69.534214, "o", "    if hasattr(emb, \"float_\"):\r\n\u001b[?2004l\r"]
[69.53427, "o", "\u001b[?2004h"]
[69.534363, "o", "> "]
[69.53459, "o", "        emb = emb.float_\r\n\u001b[?2004l\r"]
[69.53467, "o", "\u001b[?2004h> "]
[69.53503, "o", "    elif hasattr(emb, \"float\"):\r\n\u001b[?2004l\r"]
[69.535086, "o", "\u001b[?2004h"]
[69.535143, "o", "> "]
[69.535395, "o", "        emb = emb.float\r\n\u001b[?2004l\r"]
[69.53548, "o", "\u001b[?2004h> "]
[69.535963, "o", "    return [list(map(float, v)) for v in emb]\r\n\u001b[?2004l\r"]
[69.536017, "o", "\u001b[?2004h"]
[69.536073, "o", "> \r\n\u001b[?2004l\r"]
[69.536187, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[69.536267, "o", "\u001b[?2004h> "]
[69.536525, "o", "def build_index() -> None:\r\n\u001b[?2004l\r"]
[69.536607, "o", "\u001b[?2004h> "]
[69.53738, "o", "    \"\"\"Read the corpus, embed every text with Cohere, and persist to LanceDB.\"\"\"\r\n\u001b[?2004l\r"]
[69.537449, "o", "\u001b[?2004h"]
[69.537509, "o", "> "]
[69.537731, "o", "    global _table, _built\r\n\u001b[?2004l\r"]
[69.53781, "o", "\u001b[?2004h> \r\n"]
[69.537887, "o", "\u001b[?2004l\r\u001b[?2004h"]
[69.537964, "o", "> "]
[69.538068, "o", "    if _built:\r\n\u001b[?2004l\r"]
[69.538123, "o", "\u001b[?2004h"]
[69.53818, "o", "> "]
[69.538307, "o", "        return\r\n\u001b[?2004l\r"]
[69.538363, "o", "\u001b[?2004h"]
[69.538463, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h"]
[69.538539, "o", "> "]
[69.538681, "o", "    # Load corpus\r\n\u001b[?2004l\r"]
[69.538763, "o", "\u001b[?2004h> "]
[69.539311, "o", "    with open(CORPUS_PATH, \"r\", encoding=\"utf-8\") as f:\r\n\u001b[?2004l\r"]
[69.539365, "o", "\u001b[?2004h"]
[69.539469, "o", "> "]
[69.539697, "o", "        rows = json.load(f)\r\n\u001b[?2004l\r"]
[69.539775, "o", "\u001b[?2004h> "]
[69.540112, "o", "    if not isinstance(rows, list):\r\n\u001b[?2004l\r"]
[69.540168, "o", "\u001b[?2004h"]
[69.540226, "o", "> "]
[69.540875, "o", "        raise ValueError(\"corpus.json must contain a list of rows\")\r\n\u001b[?2004l\r"]
[69.540959, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[69.541033, "o", "\u001b[?2004h> "]
[69.541431, "o", "    texts = [r[\"text\"] for r in rows]\r\n\u001b[?2004l\r"]
[69.541485, "o", "\u001b[?2004h"]
[69.541542, "o", "> "]
[69.541982, "o", "    languages = [r[\"language\"] for r in rows]\r\n\u001b[?2004l\r"]
[69.54206, "o", "\u001b[?2004h> "]
[69.542638, "o", "    concept_ids = [int(r[\"concept_id\"]) for r in rows]\r\n\u001b[?2004l\r"]
[69.542693, "o", "\u001b[?2004h"]
[69.542792, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h"]
[69.542871, "o", "> "]
[69.54307, "o", "    co = _get_client()\r\n\u001b[?2004l\r"]
[69.543125, "o", "\u001b[?2004h"]
[69.543181, "o", "> \r\n\u001b[?2004l\r"]
[69.543295, "o", "\u001b[?2004h> "]
[69.543784, "o", "    # Embed documents with the proper input type.\r\n\u001b[?2004l\r"]
[69.543839, "o", "\u001b[?2004h"]
[69.543934, "o", "> "]
[69.544745, "o", "    # Cohere accepts up to 96 texts per call and we have 90, so a single call works,\r\n\u001b[?2004l\r"]
[69.544801, "o", "\u001b[?2004h"]
[69.544899, "o", "> "]
[69.545128, "o", "    # but we still batch defensively.\r\n\u001b[?2004l\r"]
[69.545184, "o", "\u001b[?2004h> "]
[69.545512, "o", "    all_vectors: list[list[float]] = []\r\n\u001b[?2004l\r"]
[69.545567, "o", "\u001b[?2004h> "]
[69.545736, "o", "    batch_size = 96\r\n\u001b[?2004l\r"]
[69.54579, "o", "\u001b[?2004h> "]
[69.546183, "o", "    for start in range(0, len(texts), batch_size):\r\n\u001b[?2004l\r"]
[69.546237, "o", "\u001b[?2004h> "]
[69.546639, "o", "        batch = texts[start : start + batch_size]\r\n\u001b[?2004l\r"]
[69.546695, "o", "\u001b[?2004h> "]
[69.546894, "o", "        resp = co.embed(\r\n\u001b[?2004l\r"]
[69.546949, "o", "\u001b[?2004h> "]
[69.547156, "o", "            texts=batch,\r\n\u001b[?2004l\r"]
[69.547239, "o", "\u001b[?2004h> "]
[69.547467, "o", "            model=COHERE_MODEL,\r\n\u001b[?2004l\r"]
[69.547546, "o", "\u001b[?2004h> "]
[69.547852, "o", "            input_type=\"search_document\",\r\n\u001b[?2004l\r"]
[69.547907, "o", "\u001b[?2004h> "]
[69.548004, "o", "        )\r\n\u001b[?2004l\r"]
[69.54806, "o", "\u001b[?2004h> "]
[69.548572, "o", "        all_vectors.extend(_extract_embeddings(resp))\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[69.548627, "o", "\u001b[?2004h> "]
[69.549129, "o", "    # Convert to float32 numpy arrays (and verify dim) for storage.\r\n\u001b[?2004l\r"]
[69.549206, "o", "\u001b[?2004h> "]
[69.549468, "o", "    arrays: list[np.ndarray] = []\r\n\u001b[?2004l\r"]
[69.549525, "o", "\u001b[?2004h> "]
[69.549733, "o", "    for v in all_vectors:\r\n\u001b[?2004l\r"]
[69.54979, "o", "\u001b[?2004h> "]
[69.550143, "o", "        arr = np.asarray(v, dtype=np.float32)\r\n\u001b[?2004l\r"]
[69.550221, "o", "\u001b[?2004h> "]
[69.550514, "o", "        if arr.shape[0] != VECTOR_DIM:\r\n\u001b[?2004l\r"]
[69.550595, "o", "\u001b[?2004h> "]
[69.550806, "o", "            raise ValueError(\r\n\u001b[?2004l\r"]
[69.55086, "o", "\u001b[?2004h> "]
[69.551493, "o", "                f\"unexpected embedding dim {arr.shape[0]}, expected {VECTOR_DIM}\"\r\n\u001b[?2004l\r"]
[69.551548, "o", "\u001b[?2004h> "]
[69.551671, "o", "            )\r\n\u001b[?2004l\r"]
[69.551735, "o", "\u001b[?2004h> "]
[69.551939, "o", "        arrays.append(arr)\r\n\u001b[?2004l\r"]
[69.551995, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[69.552052, "o", "\u001b[?2004h"]
[69.552113, "o", "> "]
[69.552336, "o", "    # Build records for LanceDB.\r\n\u001b[?2004l\r"]
[69.552437, "o", "\u001b[?2004h> "]
[69.552554, "o", "    records = [\r\n\u001b[?2004l\r"]
[69.55261, "o", "\u001b[?2004h> "]
[69.552706, "o", "        {\r\n\u001b[?2004l\r"]
[69.55279, "o", "\u001b[?2004h> "]
[69.553206, "o", "            \"concept_id\": np.int32(concept_ids[i]),\r\n\u001b[?2004l\r"]
[69.553268, "o", "\u001b[?2004h"]
[69.553331, "o", "> "]
[69.553566, "o", "            \"language\": languages[i],\r\n\u001b[?2004l\r"]
[69.553625, "o", "\u001b[?2004h> "]
[69.553853, "o", "            \"text\": texts[i],\r\n\u001b[?2004l\r"]
[69.553911, "o", "\u001b[?2004h"]
[69.554014, "o", "> "]
[69.554208, "o", "            \"vector\": arrays[i],\r\n\u001b[?2004l\r"]
[69.554311, "o", "\u001b[?2004h> "]
[69.554429, "o", "        }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[69.554705, "o", "        for i in range(len(texts))\r\n\u001b[?2004l\r"]
[69.554767, "o", "\u001b[?2004h> "]
[69.554915, "o", "    ]\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[69.55502, "o", "\u001b[?2004h> "]
[69.555123, "o", "    db = _get_db()\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[69.555229, "o", "\u001b[?2004h> "]
[69.555521, "o", "    # Drop existing table if rerun in same dir.\r\n\u001b[?2004l\r\u001b[?2004h"]
[69.555628, "o", ">     try:\r\n\u001b[?2004l\r\u001b[?2004h"]
[69.555737, "o", "> "]
[69.555918, "o", "        if TABLE_NAME in db.table_names():\r\n\u001b[?2004l\r\u001b[?2004h"]
[69.556023, "o", "> "]
[69.556205, "o", "            db.drop_table(TABLE_NAME)\r\n\u001b[?2004l\r\u001b[?2004h"]
[69.556309, "o", "> "]
[69.556409, "o", "    except Exception:\r\n\u001b[?2004l\r\u001b[?2004h"]
[69.556537, "o", ">         pass\r\n\u001b[?2004l\r"]
[69.556644, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[69.557077, "o", "    tbl = db.create_table(TABLE_NAME, data=records, schema=_schema(), mode=\"overwrite\")\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[69.557141, "o", "\u001b[?2004h> "]
[69.557362, "o", "    # Make sure a vector index exists (helps recall and speed for top-k).\r\n\u001b[?2004l\r\u001b[?2004h> "]
[69.557478, "o", "    try:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[69.557685, "o", "        tbl.create_index(num_partitions=1, num_sub_vectors=16, metric=\"cosine\")\r\n\u001b[?2004l\r\u001b[?2004h> "]
[69.557791, "o", "    except Exception:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[69.558035, "o", "        # Index creation is optional; an exact search will still work.\r\n\u001b[?2004l\r\u001b[?2004h> "]
[69.558129, "o", "        pass\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[69.558233, "o", "\u001b[?2004h>     _table = tbl\r\n\u001b[?2004l\r"]
[69.558336, "o", "\u001b[?2004h> "]
[69.558451, "o", "    _built = True\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[69.558558, "o", "> def _ensure_table():\r\n\u001b[?2004l\r\u001b[?2004h> "]
[69.558662, "o", "    global _table\r\n\u001b[?2004l\r\u001b[?2004h> "]
[69.558765, "o", "    if _table is not None:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[69.558868, "o", "        return _table\r\n\u001b[?2004l\r\u001b[?2004h> "]
[69.558971, "o", "    db = _get_db()\r\n\u001b[?2004l\r\u001b[?2004h> "]
[69.559172, "o", "    # If the verifier previously called build_index, the table should exist.\r\n\u001b[?2004l\r\u001b[?2004h> "]
[69.559295, "o", "    names = db.table_names()\r\n\u001b[?2004l\r\u001b[?2004h> "]
[69.559412, "o", "    if TABLE_NAME in names:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[69.559574, "o", "        _table = db.open_table(TABLE_NAME)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[69.559667, "o", "        return _table\r\n\u001b[?2004l\r\u001b[?2004h> "]
[69.55979, "o", "    # Otherwise build it lazily.\r\n\u001b[?2004l\r\u001b[?2004h> "]
[69.559894, "o", "    build_index()\r\n\u001b[?2004l\r\u001b[?2004h> "]
[69.56, "o", "    return _table\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[69.560103, "o", "> "]
[69.560234, "o", "def cross_lingual_search(query: str, k: int = 3) -> list[dict]:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[69.560523, "o", "    \"\"\"Embed ``query`` and return the top-k documents across all three languages.\"\"\"\r\n\u001b[?2004l\r\u001b[?2004h> "]
[69.560662, "o", "    if not isinstance(query, str):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[69.560834, "o", "        raise TypeError(\"query must be a string\")\r\n\u001b[?2004l\r\u001b[?2004h> "]
[69.560983, "o", "    if not isinstance(k, int) or k <= 0:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[69.561168, "o", "        raise ValueError(\"k must be a positive int\")\r\n\u001b[?2004l\r\u001b[?2004h> \r\n"]
[69.56127, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[69.561375, "o", "    tbl = _ensure_table()\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[69.561494, "o", "    co = _get_client()\r\n\u001b[?2004l\r\u001b[?2004h> "]
[69.561601, "o", "    resp = co.embed(\r\n\u001b[?2004l\r\u001b[?2004h> "]
[69.561703, "o", "        texts=[query],\r\n\u001b[?2004l\r\u001b[?2004h> "]
[69.561805, "o", "        model=COHERE_MODEL,\r\n\u001b[?2004l\r\u001b[?2004h> "]
[69.561907, "o", "        input_type=\"search_query\",\r\n\u001b[?2004l\r\u001b[?2004h>     )\r\n\u001b[?2004l\r"]
[69.562009, "o", "\u001b[?2004h> "]
[69.562114, "o", "    vecs = _extract_embeddings(resp)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[69.562249, "o", "    qvec = np.asarray(vecs[0], dtype=np.float32)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[69.562384, "o", "    if qvec.shape[0] != VECTOR_DIM:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[69.562509, "o", "        raise ValueError(\r\n\u001b[?2004l\r\u001b[?2004h> "]
[69.562771, "o", "            f\"unexpected query embedding dim {qvec.shape[0]}, expected {VECTOR_DIM}\"\r\n\u001b[?2004l\r\u001b[?2004h> "]
[69.562873, "o", "        )\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[69.563118, "o", "    # Search across all languages (no filter), sorted by ascending distance.\r\n\u001b[?2004l\r\u001b[?2004h> "]
[69.563219, "o", "    results = (\r\n\u001b[?2004l\r\u001b[?2004h> "]
[69.56334, "o", "        tbl.search(qvec.tolist())\r\n\u001b[?2004l\r\u001b[?2004h> "]
[69.563464, "o", "        .metric(\"cosine\")\r\n\u001b[?2004l\r\u001b[?2004h> "]
[69.563572, "o", "        .limit(k)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[69.563679, "o", "        .to_pandas()\r\n\u001b[?2004l\r\u001b[?2004h>     )\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[69.563783, "o", "\u001b[?2004h>     out: list[dict] = []\r\n\u001b[?2004l\r"]
[69.563885, "o", "\u001b[?2004h> "]
[69.563987, "o", "    for _, row in results.iterrows():\r\n\u001b[?2004l\r\u001b[?2004h> "]
[69.564091, "o", "        out.append(\r\n\u001b[?2004l\r\u001b[?2004h>             {\r\n\u001b[?2004l\r"]
[69.564153, "o", "\u001b[?2004h> "]
[69.564309, "o", "                \"concept_id\": int(row[\"concept_id\"]),\r\n\u001b[?2004l\r\u001b[?2004h> "]
[69.564484, "o", "                \"language\": str(row[\"language\"]),\r\n\u001b[?2004l\r\u001b[?2004h> "]
[69.564638, "o", "                \"text\": str(row[\"text\"]),\r\n\u001b[?2004l\r\u001b[?2004h> "]
[69.564746, "o", "            }\r\n\u001b[?2004l\r\u001b[?2004h>         )\r\n\u001b[?2004l\r"]
[69.564848, "o", "\u001b[?2004h>     return out\r\n\u001b[?2004l\r\u001b[?2004h> \r\n"]
[69.564949, "o", "\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[69.565128, "o", "if __name__ == \"__main__\":  # quick smoke test when run directly\r\n\u001b[?2004l\r\u001b[?2004h> "]
[69.565227, "o", "    build_index()\r\n\u001b[?2004l\r\u001b[?2004h> "]
[69.565491, "o", "    hits = cross_lingual_search(\"Where is the Eiffel Tower?\", k=3)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[69.565599, "o", "    for h in hits:\r\n\u001b[?2004l\r\u001b[?2004h>         print(h)\r\n\u001b[?2004l\r"]
[69.565706, "o", "\u001b[?2004h> PYEOF\r\n\u001b[?2004l\r"]
[69.5691, "o", "\u001b[?2004hroot@92dc6a4f-4f12-40a7-bd5b-35128abcc7eb:~# "]
