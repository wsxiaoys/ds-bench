[90.471675, "i", "cat main.py\n"]
[90.472061, "o", "cat main.py\r\n\u001b[?2004l\r"]
[90.473641, "o", "def main():\r\n    print(\"Hello from myproject!\")\r\n\r\n\r\nif __name__ == \"__main__\":\r\n    main()\r\n"]
