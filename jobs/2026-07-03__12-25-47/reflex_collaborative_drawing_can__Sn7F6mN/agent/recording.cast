[205.187631, "o", "async def create_stroke(stroke: StrokeIn):\r\n\u001b[?2004l\r"]
[205.187684, "o", "\u001b[?2004h> "]
[205.187969, "o", "    with rx.session() as session:\r\n\u001b[?2004l\r"]
[205.188025, "o", "\u001b[?2004h> "]
[205.188379, "o", "        db_stroke = Stroke(**stroke.model_dump())\r\n\u001b[?2004l\r"]
[205.188431, "o", "\u001b[?2004h> "]
[205.188673, "o", "        session.add(db_stroke)\r\n\u001b[?2004l\r"]
[205.188729, "o", "\u001b[?2004h> "]
[205.189016, "o", "        session.commit()\r\n\u001b[?2004l\r\u001b[?2004h> "]
[205.189241, "o", "        session.refresh(db_stroke)\r\n\u001b[?2004l\r"]
[205.189294, "o", "\u001b[?2004h> "]
[205.189449, "o", "        return {\r\n\u001b[?2004l\r"]
[205.189499, "o", "\u001b[?2004h> "]
[205.189748, "o", "            \"id\": db_stroke.id,\r\n\u001b[?2004l\r"]
[205.1898, "o", "\u001b[?2004h> "]
[205.190061, "o", "            \"x1\": db_stroke.x1,\r\n\u001b[?2004l\r"]
[205.190112, "o", "\u001b[?2004h> "]
[205.190361, "o", "            \"y1\": db_stroke.y1,\r\n\u001b[?2004l\r"]
[205.190413, "o", "\u001b[?2004h> "]
[205.190658, "o", "            \"x2\": db_stroke.x2,\r\n\u001b[?2004l\r"]
[205.19071, "o", "\u001b[?2004h> "]
[205.190977, "o", "            \"y2\": db_stroke.y2,\r\n\u001b[?2004l\r"]
[205.191032, "o", "\u001b[?2004h> "]
[205.191316, "o", "            \"color\": db_stroke.color,\r\n\u001b[?2004l\r"]
[205.191368, "o", "\u001b[?2004h> "]
[205.191714, "o", "            \"session_id\": db_stroke.session_id,\r\n\u001b[?2004l\r"]
[205.191764, "o", "\u001b[?2004h> "]
[205.191874, "o", "        }\r\n\u001b[?2004l\r"]
[205.191927, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[205.192037, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[205.192088, "o", "\u001b[?2004h> "]
[205.192339, "o", "@fastapi_app.get(\"/api/strokes\")\r\n\u001b[?2004l\r"]
[205.192393, "o", "\u001b[?2004h> "]
[205.192602, "o", "async def list_strokes():\r\n\u001b[?2004l\r"]
[205.192655, "o", "\u001b[?2004h> "]
[205.192919, "o", "    with rx.session() as session:\r\n\u001b[?2004l\r"]
[205.192971, "o", "\u001b[?2004h> "]
[205.193344, "o", "        rows = session.exec(select(Stroke)).all()\r\n\u001b[?2004l\r"]
[205.193397, "o", "\u001b[?2004h> "]
[205.193545, "o", "        return [\r\n\u001b[?2004l\r"]
[205.193597, "o", "\u001b[?2004h> "]
[205.193726, "o", "            {\r\n\u001b[?2004l\r"]
[205.193778, "o", "\u001b[?2004h> "]
[205.194016, "o", "                \"id\": r.id,\r\n\u001b[?2004l\r"]
[205.194066, "o", "\u001b[?2004h> "]
[205.194295, "o", "                \"x1\": r.x1,\r\n\u001b[?2004l\r"]
[205.194348, "o", "\u001b[?2004h> "]
[205.194573, "o", "                \"y1\": r.y1,\r\n\u001b[?2004l\r"]
[205.194626, "o", "\u001b[?2004h> "]
[205.194846, "o", "                \"x2\": r.x2,\r\n\u001b[?2004l\r"]
[205.194993, "o", "\u001b[?2004h> "]
[205.195143, "o", "                \"y2\": r.y2,\r\n\u001b[?2004l\r"]
[205.195197, "o", "\u001b[?2004h> "]
[205.19546, "o", "                \"color\": r.color,\r\n\u001b[?2004l\r"]
[205.195516, "o", "\u001b[?2004h> "]
[205.195847, "o", "                \"session_id\": r.session_id,\r\n\u001b[?2004l\r"]
[205.195918, "o", "\u001b[?2004h> "]
[205.196046, "o", "            }\r\n\u001b[?2004l\r"]
[205.196103, "o", "\u001b[?2004h> "]
[205.196317, "o", "            for r in rows\r\n\u001b[?2004l\r"]
[205.196375, "o", "\u001b[?2004h> "]
[205.196501, "o", "        ]\r\n\u001b[?2004l\r\u001b[?2004h"]
[205.196552, "o", "> \r\n\u001b[?2004l\r"]
[205.196674, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
