[61.797629, "i", "cat > src/router.ts << 'EOF'\nimport { match } from \"arktype\";\n\n/**\n * Router constructed via ArkType's `match` pattern matcher.\n *\n * Cases:\n *   1. bare `string`        -> `text:<length>`\n *   2. bare `number`        -> `num:<value>`\n *   3. `string[]`           -> `list:<length>`\n *   4. click (button)       -> `btn:<target.id>`\n *   5. click (link, valid URL) -> `link:<target.href>`\n *   6. submit               -> `submit:<formId>:<valid>`\n *\n * Anything else raises a `TraversalError` (default: \"assert\").\n */\nexport const route = match({\n\t// 1) bare string -> text:<length>\n\tstring: (s) => `text:${s.length}`,\n\n\t// 2) bare number -> num:<value>\n\tnumber: (n) => `num:${n}`,\n\n\t// 3) string[] -> list:<length>\n\t\"string[]\": (arr) => `list:${arr.length}`,\n\n\t// 4) click event whose target.type === \"button\" -> btn:<id>\n\t//    The literal `\"click\"` discriminator MUST appear here.\n\t'kind': 'click',\n\t'target.type': 'button',\n\t'id': 'string'\n\t// 5) click event whose target.type === \"link\" with valid URL href\n\t//    handled via fluent .case() below (nested discriminator),\n\t// 6) submit event handled via fluent .case() below,\n}, /* placeholder, the real cases are appended via .case() below */)\n\t.case(\n\t\t// 5) click event with link target (requires valid URL href)\n\t\t{ kind: 'click', target: { type: 'link', href: 'string.url' } },\n\t\t(e) => `link:${e.target.href}`\n\t)\n\t.case(\n\t\t// 6) submit event\n\t\t{ kind: 'submit', payload: { formId: 'string', valid: 'boolean' } },\n\t\t(e) => `submit:${e.payload.formId}:${e.payload.valid}`\n\t)\n\t.default(\"assert\");\nEOF\n"]
