[480.226656, "i", "cat > /home/user/myproject/pb_hooks/rate_limit.pb.js << 'EOF'\nconsole.log(\"HOOK LOADED\");\n\nconst RATE_LIMIT_WINDOW_MS = 60 * 1000;\nconst RATE_LIMIT_MAX = 3;\n\nconst rateLimitStore = {};\n\nonRecordCreateRequest((e) => {\n    if (e.collection.name !== \"users\") {\n        return;\n    }\n\n    const ip = e.realIP();\n    const now = Date.now();\n    console.log(\"HOOK ip:\", ip, \"now:\", now);\n\n    if (!rateLimitStore[ip]) {\n        rateLimitStore[ip] = [];\n    }\n    const timestamps = rateLimitStore[ip];\n    console.log(\"HOOK before prune:\", JSON.stringify(timestamps));\n\n    const cutoff = now - RATE_LIMIT_WINDOW_MS;\n    while (timestamps.length > 0 && timestamps[0] <= cutoff) {\n        timestamps.shift();\n    }\n    console.log(\"HOOK after prune:\", JSON.stringify(timestamps));\n\n    if (timestamps.length >= RATE_LIMIT_MAX) {\n        const oldest = timestamps[0];\n        const retryAfterMs = (oldest + RATE_LIMIT_WINDOW_MS) - now;\n        let retryAfterSec = Math.ceil(retryAfterMs / 1000);\n        if (retryAfterSec < 1) retryAfterSec = 1;\n        console.log(\"HOOK rate limited, retryAfter:\", retryAfterSec);\n        throw new ApiError(429, \"Too many signup attempts\", { retryAfter: retryAfterSec });\n    }\n\n    timestamps.push(now);\n    console.log(\"HOOK after push:\", JSON.stringify(timestamps));\n}, \"users\");\nEOF\n"]
