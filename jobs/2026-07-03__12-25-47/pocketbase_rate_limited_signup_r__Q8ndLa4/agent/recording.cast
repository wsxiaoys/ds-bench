n  clone(): (RequestInfo)\r\n }\r\n type _sVuucpU = hook.Event&RequestEvent\r\n interface BatchRequestEvent extends _sVuucpU {\r\n  batch: Array<(InternalRequest | undefined)>\r\n }\r\n interface InternalRequest {\r\n  /**\r\n   * note: for uploading files the value must be either *filesystem.File or []*filesystem.File\r\n   */\r\n  body: _TygojaDict\r\n  headers: _TygojaDict\r\n  method: string\r\n  url: string\r\n }\r\n interface InternalRequest {\r\n  validate(): void\r\n"]
