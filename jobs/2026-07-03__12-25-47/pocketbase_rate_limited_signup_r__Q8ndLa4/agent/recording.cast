[195.461011, "o", "\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[195.461067, "o", "function pruneOldEntries(timestamps, now) {\r\n\u001b[?2004l\r"]
[195.461118, "o", "\u001b[?2004h> "]
[195.461205, "o", "    const cutoff = now - RATE_LIMIT_WINDOW_MS;\r\n\u001b[?2004l\r"]
[195.461255, "o", "\u001b[?2004h> "]
[195.461283, "o", "    let i = 0;\r\n\u001b[?2004l\r\u001b[?2004h> "]
[195.461445, "o", "    while (i < timestamps.length && timestamps[i] <= cutoff) {\r\n\u001b[?2004l\r\u001b[?2004h"]
[195.461487, "o", "> "]
[195.461534, "o", "        i++;\r\n\u001b[?2004l\r\u001b[?2004h>     }\r\n\u001b[?2004l\r\u001b[?2004h"]
[195.461562, "o", "> "]
[195.461625, "o", "    if (i > 0) {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[195.46169, "o", "        timestamps.splice(0, i);\r\n\u001b[?2004l\r"]
[195.46174, "o", "\u001b[?2004h> "]
[195.461791, "o", "    }\r\n\u001b[?2004l\r\u001b[?2004h> }\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[195.461842, "o", "\u001b[?2004h> "]
[195.461892, "o", "onRecordCreateRequest((e) => {\r\n\u001b[?2004l\r"]
[195.461944, "o", "\u001b[?2004h> "]
[195.462019, "o", "    // Only apply to the built-in users auth collection\r\n\u001b[?2004l\r"]
[195.462071, "o", "\u001b[?2004h> "]
[195.462176, "o", "    if (!e.collection || e.collection.name !== \"users\") {\r\n\u001b[?2004l\r"]
[195.462225, "o", "\u001b[?2004h> "]
[195.462276, "o", "        return;\r\n\u001b[?2004l\r\u001b[?2004h> "]
[195.462328, "o", "    }\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[195.462386, "o", "    const ip = getClientIp(e);\r\n\u001b[?2004l\r"]
[195.462411, "o", "\u001b[?2004h> "]
[195.462484, "o", "    const now = Date.now();\r\n\u001b[?2004l\r\u001b[?2004h"]
[195.462535, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h"]
[195.462586, "o", "> "]
[195.462636, "o", "    let timestamps = rateLimitStore[ip];\r\n\u001b[?2004l\r\u001b[?2004h> "]
[195.462693, "o", "    if (!timestamps) {\r\n\u001b[?2004l\r"]
[195.462744, "o", "\u001b[?2004h> "]
[195.462792, "o", "        timestamps = [];\r\n\u001b[?2004l\r\u001b[?2004h> "]
[195.462891, "o", "        rateLimitStore[ip] = timestamps;\r\n\u001b[?2004l\r"]
[195.462935, "o", "\u001b[?2004h> "]
[195.462954, "o", "    }\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[195.463061, "o", "    pruneOldEntries(timestamps, now);\r\n\u001b[?2004l\r\u001b[?2004h"]
[195.463111, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h"]
[195.463141, "o", "> "]
[195.463213, "o", "    if (timestamps.length >= RATE_LIMIT_MAX) {\r\n\u001b[?2004l\r"]
[195.463265, "o", "\u001b[?2004h> "]
[195.463421, "o", "        // Compute when the oldest entry will fall out of the rolling window.\r\n\u001b[?2004l\r\u001b[?2004h"]
[195.463468, "o", "> "]
[195.463529, "o", "        const oldest = timestamps[0];\r\n\u001b[?2004l\r"]
[195.46358, "o", "\u001b[?2004h> "]
[195.463709, "o", "        const retryAfterMs = (oldest + RATE_LIMIT_WINDOW_MS) - now;\r\n\u001b[?2004l\r"]
[195.463759, "o", "\u001b[?2004h> "]
[195.463868, "o", "        let retryAfterSec = Math.ceil(retryAfterMs / 1000);\r\n\u001b[?2004l\r"]
[195.463914, "o", "\u001b[?2004h> "]
[195.463968, "o", "        if (retryAfterSec < 1) {\r\n\u001b[?2004l\r"]
[195.464016, "o", "\u001b[?2004h> "]
[195.464065, "o", "            retryAfterSec = 1;\r\n\u001b[?2004l\r\u001b[?2004h"]
[195.464109, "o", "> "]
[195.46413, "o", "        }\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[195.46419, "o", "> "]
[195.464317, "o", "        // Set the Retry-After header on the underlying response writer\r\n\u001b[?2004l\r"]
[195.464363, "o", "\u001b[?2004h> "]
[195.464451, "o", "        // BEFORE writing the response body.\r\n\u001b[?2004l\r"]
[195.464491, "o", "\u001b[?2004h> "]
[195.464537, "o", "        try {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[195.464699, "o", "            e.response.header().set(\"Retry-After\", String(retryAfterSec));\r\n\u001b[?2004l\r"]
[195.464749, "o", "\u001b[?2004h> "]
[195.464891, "o", "            e.response.header().set(\"Content-Type\", \"application/json\");\r\n\u001b[?2004l\r"]
[195.464941, "o", "\u001b[?2004h> "]
[195.464993, "o", "        } catch (_) {}\r\n\u001b[?2004l\r\u001b[?2004h"]
[195.465043, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[195.465178, "o", "        // Write a 429 JSON response with `retryAfter` at the top level.\r\n\u001b[?2004l\r"]
[195.465228, "o", "\u001b[?2004h> "]
[195.465279, "o", "        e.json(429, {\r\n\u001b[?2004l\r\u001b[?2004h"]
[195.46533, "o", "> "]
[195.46538, "o", "            status: 429,\r\n\u001b[?2004l\r\u001b[?2004h> "]
[195.46553, "o", "            message: \"Too many signup attempts. Please try again later.\",\r\n\u001b[?2004l\r\u001b[?2004h"]
[195.465583, "o", "> "]
[195.465639, "o", "            retryAfter: retryAfterSec,\r\n\u001b[?2004l\r"]
[195.46569, "o", "\u001b[?2004h> "]
[195.465741, "o", "        });\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[195.465773, "o", "> "]
[195.465856, "o", "        // Stop further processing for this request.\r\n\u001b[?2004l\r"]
[195.465903, "o", "\u001b[?2004h> "]
[195.465985, "o", "        throw new ApiError(429, \"stop\", {});\r\n\u001b[?2004l\r"]
[195.46603, "o", "\u001b[?2004h> "]
[195.466082, "o", "    }\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[195.466213, "o", "    // Within limit: record this request and let it proceed.\r\n\u001b[?2004l\r"]
[195.466263, "o", "\u001b[?2004h> "]
[195.466309, "o", "    timestamps.push(now);\r\n\u001b[?2004l\r\u001b[?2004h"]
[195.466355, "o", "> "]
[195.46641, "o", "}, \"users\");\r\n\u001b[?2004l\r\u001b[?2004h> EOF\r\n\u001b[?2004l\r"]
[195.46749, "o", "\u001b[?2004hroot@fe2d402a-d04e-42f6-acaa-37f2a76e979a:~# "]
