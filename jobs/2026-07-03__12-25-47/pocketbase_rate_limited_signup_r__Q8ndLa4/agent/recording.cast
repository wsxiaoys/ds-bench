[183.728106, "i", "cat > /home/user/myproject/pb_hooks/rate_limit.pb.js << 'EOF'\n/// <reference path=\"../pb_data/types.d.ts\" />\n\n// Per-IP rate limiter for user signup endpoint.\n// Limits POST /api/collections/users/records to 3 requests per 60 seconds per IP.\n// On the 4th request within the window, returns 429 with Retry-After header and retryAfter body field.\n\nconst RATE_LIMIT_WINDOW_MS = 60 * 1000;   // 60 seconds\nconst RATE_LIMIT_MAX = 3;                  // 3 requests allowed per window\n\n// In-memory map: IP -> array of request timestamps (ms)\nconst rateLimitStore = {};\n\nfunction getClientIp(e) {\n    // Prefer realIP() since it considers trusted proxy headers; fall back to remoteIP().\n    try {\n        const ip = e.realIP();\n        if (ip) {\n            return ip;\n        }\n    } catch (_) {}\n    try {\n        return e.remoteIP();\n    } catch (_) {\n        return \"unknown\";\n    }\n}\n\nfunction pruneOldEntries(timestamps, now) {\n    const cutoff = now - RATE_LIMIT_WINDOW_MS;\n    // Remove entries older than the rolling window\n    let i = 0;\n    while (i < timestamps.length && timestamps[i] <= cutoff) {\n        i++;\n    }\n    if (i > 0) {\n        timestamps.splice(0, i);\n    }\n}\n\nonRecordCreateRequest((e) => {\n    // Only apply to the built-in users auth collection\n    if (e.collection.name !== \"users\") {\n        return;\n    }\n\n    const ip = getClientIp(e);\n    const now = Date.now();\n\n    let timestamps = rateLimitStore[ip];\n    if (!timestamps) {\n        timestamps = [];\n        rateLimitStore[ip] = timestamps;\n    }\n\n    // Drop timestamps that fall outside the current rolling window\n    pruneOldEntries(timestamps, now);\n\n    if (timestamps.length >= RATE_LIMIT_MAX) {\n        // Compute when the oldest entry will fall out of the window\n        const oldest = timestamps[0];\n        const retryAfterMs = (oldest + RATE_LIMIT_WINDOW_MS) - now;\n        let retryAfterSec = Math.ceil(retryAfterMs / 1000);\n        if (retryAfterSec < 1) {\n            retryAfterSec = 1;\n        }\n\n        // Set the Retry-After header on the response\n        try {\n            e.response.header().set(\"Retry-After\", String(retryAfterSec));\n        } catch (_) {}\n\n        // Throw a 429 with a JSON body that includes retryAfter\n        throw new ApiError(\n            429,\n            \"Too many signup attempts. Please try again later.\",\n            { retryAfter: retryAfterSec }\n        );\n    }\n\n    // Record this request\n    timestamps.push(now);\n}, \"users\");\n\n// Periodic cleanup of stale IPs to avoid memory growth.\n// Run every 5 minutes and remove entries whose timestamps are all outside the window.\n$app ? void $app : null;\nEOF\n"]
