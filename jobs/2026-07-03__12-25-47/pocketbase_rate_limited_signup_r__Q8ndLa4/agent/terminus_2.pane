[?2004l[?2004h>     let i = 0;
[?2004l[?2004h>     while (i < timestamps.length && timestamps[i] <= cutoff) {
[?2004l[?2004h>         i++;
[?2004l[?2004h>     }
[?2004l[?2004h>     if (i > 0) {
[?2004l[?2004h>         timestamps.splice(0, i);
[?2004l[?2004h>     }
[?2004l[?2004h> }
[?2004l[?2004h> 
[?2004l[?2004h> onRecordCreateRequest((e) => {
