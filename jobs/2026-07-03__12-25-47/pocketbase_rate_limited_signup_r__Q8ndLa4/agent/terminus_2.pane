[?2004hroot@fe2d402a-d04e-42f6-acaa-37f2a76e979a:~# cat /home/user/myproject/pb_hooks/rate_limit.pb.js
[?2004l/// <reference path="../pb_data/types.d.ts" />

const RATE_LIMIT_WINDOW_MS = 60 * 1000;
const RATE_LIMIT_MAX = 3;

const rateLimitStore = {};

onRecordCreateRequest((e) => {
    if (!e.collection || e.collection.name !== "users") {
        return;
    }

    const ip = e.realIP ? e.realIP() : "127.0.0.1";
    const now = Date.now();

    if (!rateLimitStore[ip]) {
        rateLimitStore[ip] = [];
    }
    const timestamps = rateLimitStore[ip];

    const cutoff = now - RATE_LIMIT_WINDOW_MS;
    let i = 0;
    while (i < timestamps.length && timestamps[i] <= cutoff) i++;
    if (i > 0) timestamps.splice(0, i);

    console.log("HOOK:", ip, "count:", timestamps.length);

    if (timestamps.length >= RATE_LIMIT_MAX) {
        const oldest = timestamps[0];
        const retryAfterMs = (oldest + RATE_LIMIT_WINDOW_MS) - now;
        let retryAfterSec = Math.ceil(retryAfterMs / 1000);
        if (retryAfterSec < 1) retryAfterSec = 1;

        console.log("HOOK: Rate limited, retryAfter:", retryAfterSec);
        throw new ApiError(429, "Too many signup attempts", { retryAfter: retryAfterSec });
    }

    timestamps.push(now);
}, "users");
