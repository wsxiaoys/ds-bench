[245.825957, "i", "python3 << 'PYEOF'\ncontent = '''package migrations\n\nimport (\n\\t\"github.com/pocketbase/pocketbase/core\"\n\\tm \"github.com/pocketbase/pocketbase/migrations\"\n)\n\nfunc init() {\n\\tm.Register(func(app core.App) error {\n\\t\\tview := core.NewViewCollection(\"user_post_stats\")\n\\t\\tview.ViewQuery = `\n\\t\\t\\tSELECT\n\\t\\t\\t\\tusers.id AS id,\n\\t\\t\\t\\tusers.id AS user,\n\\t\\t\\t\\tusers.email AS email,\n\\t\\t\\t\\tcount(posts.id) AS post_count,\n\\t\\t\\t\\tcast(coalesce(max(posts.created), '') AS text) AS last_post_at\n\\t\\t\\tFROM users\n\\t\\t\\tLEFT JOIN posts ON posts.author = users.id\n\\t\\t\\tGROUP BY users.id, users.email\n\\t\\t`\n\\t\\treturn app.Save(view)\n\\t}, func(app core.App) error {\n\\t\\tif c, err := app.FindCollectionByNameOrId(\"user_post_stats\"); err == nil {\n\\t\\t\\treturn app.Delete(c)\n\\t\\t}\n\\t\\treturn nil\n\\t})\n}\n'''\nwith open('migrations/1700000001_user_post_stats.go', 'w') as f:\n    f.write(content)\nprint('Done')\nPYEOF\n"]
