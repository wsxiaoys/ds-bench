[224.094848, "o", "\u001b[32m\u001b[K443\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\u001b[01;31m\u001b[KcommentsReplaceRegex\u001b[m\u001b[K = regexp.MustCompile(`(?m)(\\/\\*[\\s\\S]*?\\*\\/)|(--.+$)`)\r\n"]
