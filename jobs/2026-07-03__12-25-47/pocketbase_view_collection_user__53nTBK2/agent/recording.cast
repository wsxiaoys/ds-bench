[224.094576, "o", "\u001b[32m\u001b[K441\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\u001b[01;31m\u001b[KjoinReplaceRegex\u001b[m\u001b[K     = regexp.MustCompile(`(?im)\\s+(full\\s+outer\\s+join|left\\s+outer\\s+join|right\\s+outer\\s+join|full\\s+join|cross\\s+join|inner\\s+join|outer\\s+join|left\\s+join|right\\s+join|join)\\s+?`)\r\n"]
