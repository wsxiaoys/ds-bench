[81.382041, "o", "\t\t\t\t\tlj.id cid,\r\n\t\t\t\t\tij.id as did,\r\n\t\t\t\t\ta.bool,\r\n\t\t\t\t\t` + core.CollectionNameSuperusers + `.id as eid,\r\n\t\t\t\t\t` + core.CollectionNameSuperusers + `.email"]
