[246.412708, "o", "package migrations$\r\n$\r\nimport ($\r\n^I\"github.com/pocketbase/pocketbase/core\"$\r\n^Im \"github.com/pocketbase/pocketbase/migrations\"$\r\n)$\r\n$\r\nfunc init() {$\r\n^Im.Register(func(app core.App) error {$\r\n^I^Iview := core.NewViewCollection(\"user_post_stats\")$\r\n^I^Iview.ViewQuery = `$\r\n^I^I^ISELECT$\r\n^I^I^I^Iusers.id AS id,$\r\n^I^I^I^Iusers.id AS user,$\r\n^I^I^I^Iusers.email AS email,$\r\n^I^I^I^Icount(posts.id) AS post_count,$\r\n^I^I^I^Icast(coalesce(max(posts.created), '') AS text) AS last_post_at$\r\n^I^I^IFROM users$\r\n^I^I^ILEFT JOIN posts ON posts.author = users.id$\r\n^I^I^IGROUP BY users.id, users.email$\r\n^I^I`$\r\n^I^Ireturn app.Save(view)$\r\n^I}, func(app core.App) error {$\r\n^I^Iif c, err := app.FindCollectionByNameOrId(\"user_post_stats\"); err == nil {$\r\n^I^I^Ireturn app.Delete(c)$\r\n^I^I}$\r\n^I^Ireturn nil$\r\n^I})$\r\n}$\r\n"]
