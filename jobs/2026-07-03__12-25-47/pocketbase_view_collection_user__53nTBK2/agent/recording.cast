[365.067197, "o", "[1.00ms] CREATE TABLE IF NOT EXISTS `_migrations` (file VARCHAR(255) PRIMARY KEY NOT NULL, applied INTEGER NOT NULL)\r\n"]
[365.068045, "o", "[0.00ms] SELECT (1) FROM `_migrations` WHERE `file`='1640988000_aux_init.go' LIMIT 1\r\n"]
[365.068678, "o", "[0.00ms] INSERT INTO `_migrations` (`applied`, `file`) VALUES (1783090836933901, '1640988000_aux_init.go')\r\n"]
[365.068704, "o", "[0.00ms] SELECT (1) FROM `_migrations` WHERE `file`='1640988000_init.go' LIMIT 1\r\n"]
