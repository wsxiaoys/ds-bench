[123.52809, "o", "221:\tp := new(identifiersParser)\r\n233:\tvar mainTable identifier\r\n376:func findCollectionsByIdentifiers(app App, tables []identifier) (map[string]*Collection, error) {\r\n437:// Raw query identifiers parser\r\n446:type identifier struct {\r\n451:type identifiersParser struct {\r\n452:\t"]
[123.528165, "o", "columns []identifier\r\n453:\ttables  []identifier\r\n456:func (p *identifiersParser) parse(selectQuery string) error {\r\n490:\t\t\tcontinue // ignore as it is not important for the identifiers parsing\r\n544:func extractIdentifiers(rawExpression string) ([]identifier, error) {\r\n553:\tresult := make([]identifier, 0, len(rawIdentifiers))\r\n564:\t\tresolved, err := identifierFromParts(parts)\r\n575:func identifierFromParts(parts []string) (identifier, error) {\r\n"]
