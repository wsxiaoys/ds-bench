[529.557831, "i", "python3 << 'PYEOF'\ncontent = '''package migrations\n\nimport (\n\\t\"github.com/pocketbase/pocketbase/core\"\n\\tm \"github.com/pocketbase/pocketbase/migrations\"\n)\n\nfunc init() {\n\\tm.Register(func(app core.App) error {\n\\t\\t// Locate the existing `users` auth collection that is created\n\\t\\t// by the built-in pocketbase migrations.\n\\t\\tusers, err := app.FindCollectionByNameOrId(\"users\")\n\\t\\tif err != nil {\n\\t\\t\\treturn err\n\\t\\t}\n\n\\t\\t// Create the `posts` base collection that references `users` via the\n\\t\\t// `author` relation field.\n\\t\\tposts := core.NewBaseCollection(\"posts\")\n\\t\\tposts.Fields.Add(\n\\t\\t\\t&core.TextField{Name: \"title\", Required: true, Max: 200},\n\\t\\t\\t&core.RelationField{\n\\t\\t\\t\\tName:         \"author\",\n\\t\\t\\t\\tRequired:     true,\n\\t\\t\\t\\tMaxSelect:    1,\n\\t\\t\\t\\tCollectionId: users.Id,\n\\t\\t\\t},\n\\t\\t\\t&core.AutodateField{Name: \"created\", OnCreate: true},\n\\t\\t\\t&core.AutodateField{Name: \"updated\", OnCreate: true, OnUpdate: true},\n\\t\\t)\n\n\\t\\treturn app.Save(posts)\n\\t}, func(app core.App) error {\n\\t\\tif c, err := app.FindCollectionByNameOrId(\"posts\"); err == nil {\n\\t\\t\\tif err := app.Delete(c); err != nil {\n\\t\\t\\t\\treturn err\n\\t\\t\\t}\n\\t\\t}\n\\t\\treturn nil\n\\t})\n}\n'''\nwith open('/home/user/myproject/migrations/1700000000_init.go', 'w') as f:\n    f.write(content)\nprint('Done')\nPYEOF\n"]
