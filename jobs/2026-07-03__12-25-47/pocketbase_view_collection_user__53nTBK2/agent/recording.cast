od/github.com/pocketbase/pocketbase@v0.31.0/core/collection_validate_test.go:345:\t\t\t\tc := core.NewViewCollection(\"new\")\r\n/root/go/pkg/mod/github.com/pocketbase/pocketbase@v0.31.0/core/collection_validate_test.go:359:\t\t\t\tc := core.NewViewCollection(\"new\")\r\n"]
