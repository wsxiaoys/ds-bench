[127.691443, "o", "\u001b[?2004l\r\u001b[?2004h> EOF\r\n\u001b[?2004l\r"]
[127.692698, "o", "\u001b[?2004hroot@05a05a8e-f9cf-4a88-a0ef-639ebdab8c1b:/home/user/parse-task# "]
[127.988223, "i", "cat parse.ts\n"]
[127.988389, "o", "cat parse.ts\r\n\u001b[?2004l\r"]
[127.98924, "o", "import { LlamaCloud } from '@llamaindex/llama-cloud';\r\nimport * as fs from 'fs';\r\nimport * as path from 'path';\r\n\r\nasync function main(): Promise<void> {\r\n  // Create output directory if it doesn't exist\r\n  const outputDir = path.join(__dirname, 'output');\r\n  if (!fs.existsSync(outputDir)) {\r\n    fs.mkdirSync(outputDir, { recursive: true });\r\n  }\r\n\r\n  // Initialize the client. The SDK reads LLAMA_CLOUD_API_KEY from the environment REDACTEDmatically.\r\n  const client = new LlamaCloud();\r\n\r\n  // Upload the PDF file with the correct purpose for a parse job.\r\n  const fileStream = fs.createReadStream(path.join(__dirname, 'sample.pdf'));\r\n  const uploadedFile = await client.files.create({\r\n    file: fileStream as any,\r\n    purpose: 'parse',\r\n  });\r\n  const fileId = uploadedFile.id;\r\n  console.log(`Uploaded file with ID: ${fileId}`);\r\n\r\n  // Run a synchronous parse job (this blocks until the job is COMPLETED).\r\n  const result = await client.parsing.parse({\r\n    file_id: fileId,\r\n    tier: 'cost_effective',\r\n    version: 'latest',\r\n    expand: ['markdown'],\r\n  });\r\n\r\n  const jobId = result.job.id;\r\n  const jobStatus = result.job.status;\r\n  console.log(`Parse job ID: ${jobId}, status: ${jobStatus}`);\r\n\r\n  // Verify the job can be retrieved via client.parsing.get (sanity check).\r\n  const retrieved = await client.parsing.get(jobId);\r\n  console.log(`Retrieved job status: ${retrieved.job.status}`);\r\n\r\n  // Collect markdown from every page.\r\n  const pages = result.markdown?.pages ?? [];\r\n  const pageMarkdownList: string[] = [];\r\n  for (const page of pages) {\r\n    if ('markdown' in page && page.success) {\r\n      pageMarkdownList.push(page.markdown);\r\n    } else {\r\n      console.warn(`Page ${page.page_number} failed: ${('error' in page) ? page.error : 'unknown'}`);\r\n    }\r\n  }\r\n  const pageCount = pageMarkdownList.length;\r\n\r\n  // Concatenate pages with `---` between them.\r\n  const combinedMarkdown = pageMarkdownList.join('\\n---\\n');\r\n\r\n  // Persist the parsed markdown.\r\n  const parsedMdPath = path.join(outputDir, 'parsed.md');\r\n  fs.writeFileSync(parsedMdPath, combinedMarkdown, 'utf8');\r\n  console.log(`Wrote parsed markdown to ${parsedMdPath}`);\r\n\r\n  // Append a human-readable log entry.\r\n  const logPath = path.join(outputDir, 'result.log');\r\n  const logLines = [\r\n    `File ID: ${fileId}`,\r\n    `Job ID: ${jobId}`,\r\n    `Job Status: COMPLETED`,\r\n    `Page Count: ${pageCount}`,\r\n  ];\r\n  fs.appendFileSync(logPath, logLines.join('\\n') + '\\n', 'utf8');\r\n  console.log(`Appended log to ${logPath}`);\r\n}\r\n\r\nmain().catch((err) => {\r\n  console.error('Error during parsing:', err);\r\n  process.exit(1);\r\n});\r\n"]
[127.989424, "o", "\u001b[?2004hroot@05a05a8e-f9cf-4a88-a0ef-639ebdab8c1b:/home/user/parse-task# "]
[132.231705, "i", "npx tsx parse.ts 2>&1 | tee /tmp/parse-run.log\n"]
[132.231965, "o", "npx tsx parse.ts 2>&1 | tee /tmp/parse-run.log\r\n\u001b[?2004l\r"]
[132.779252, "o", "Error during parsing: ReferenceError: __dirname is not defined\r\n    at main (/home/user/parse-task/parse.ts:7:31)\r\n    at <anonymous> (/home/user/parse-task/parse.ts:72:1)\r\n    at ModuleJob.run (node:internal/modules/esm/module_job:439:25)\r\n    at async node:internal/modules/esm/loader:643:26\r\n    at async asyncRunEntryPointWithESMLoader (node:internal/modules/run_main:101:5)\r\n"]
[132.889779, "o", "\u001b[?2004hroot@05a05a8e-f9cf-4a88-a0ef-639ebdab8c1b:/home/user/parse-task# "]
[171.263723, "i", "cat > parse.ts << 'EOF'\nimport { LlamaCloud } from '@llamaindex/llama-cloud';\nimport * as fs from 'fs';\nimport * as path from 'path';\nimport { fileURLToPath } from 'url';\n\nconst __filename = fileURLToPath(import.meta.url);\nconst __dirname = path.dirname(__filename);\n\nasync function main(): Promise<void> {\n  // Create output directory if it doesn't exist\n  const outputDir = path.join(__dirname, 'output');\n  if (!fs.existsSync(outputDir)) {\n    fs.mkdirSync(outputDir, { recursive: true });\n  }\n\n  // Initialize the client. The SDK reads LLAMA_CLOUD_API_KEY from the environment REDACTEDmatically.\n  const client = new LlamaCloud();\n\n  // Upload the PDF file with the correct purpose for a parse job.\n  const fileStream = fs.createReadStream(path.join(__dirname, 'sample.pdf'));\n  const uploadedFile = await client.files.create({\n    file: fileStream as any,\n    purpose: 'parse',\n  });\n  const fileId = uploadedFile.id;\n  console.log(`Uploaded file with ID: ${fileId}`);\n\n  // Run a synchronous parse job (this blocks until the job is COMPLETED).\n  const result = await client.parsing.parse({\n    file_id: fileId,\n    tier: 'cost_effective',\n    version: 'latest',\n    expand: ['markdown'],\n  });\n\n  const jobId = result.job.id;\n  const jobStatus = result.job.status;\n  console.log(`Parse job ID: ${jobId}, status: ${jobStatus}`);\n\n  // Verify the job can be retrieved via client.parsing.get (sanity check).\n  const retrieved = await client.parsing.get(jobId);\n  console.log(`Retrieved job status: ${retrieved.job.status}`);\n\n  // Collect markdown from every page.\n  const pages = result.markdown?.pages ?? [];\n  const pageMarkdownList: string[] = [];\n  for (const page of pages) {\n    if ('markdown' in page && page.success) {\n      pageMarkdownList.push(page.markdown);\n    } else {\n      console.warn(`Page ${page.page_number} failed: ${('error' in page) ? page.error : 'unknown'}`);\n    }\n  }\n  const pageCount = pageMarkdownList.length;\n\n  // Concatenate pages with `---` between them.\n  const combinedMarkdown = pageMarkdownList.join('\\n---\\n');\n\n  // Persist the parsed markdown.\n  const parsedMdPath = path.join(outputDir, 'parsed.md');\n  fs.writeFileSync(parsedMdPath, combinedMarkdown, 'utf8');\n  console.log(`Wrote parsed markdown to ${parsedMdPath}`);\n\n  // Append a human-readable log entry.\n  const logPath = path.join(outputDir, 'result.log');\n  const logLines = [\n    `File ID: ${fileId}`,\n    `Job ID: ${jobId}`,\n    `Job Status: COMPLETED`,\n    `Page Count: ${pageCount}`,\n  ];\n  fs.appendFileSync(logPath, logLines.join('\\n') + '\\n', 'utf8');\n  console.log(`Appended log to ${logPath}`);\n}\n\nmain().catch((err) => {\n  console.error('Error during parsing:', err);\n  process.exit(1);\n});\nEOF\n"]
