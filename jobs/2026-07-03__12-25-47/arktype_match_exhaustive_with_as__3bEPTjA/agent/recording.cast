[124.155785, "i", "cat > convert.js << 'EOF'\nconst { match } = require('arktype');\n\n// Read JSON from STDIN\nlet input = '';\nprocess.stdin.setEncoding('utf8');\nprocess.stdin.on('data', chunk => { input += chunk; });\nprocess.stdin.on('end', () => {\n  let data;\n  try {\n    data = JSON.parse(input);\n  } catch (e) {\n    console.error('Invalid JSON input');\n    process.exit(1);\n  }\n\n  const result = match({\n    '\"length\"': ({ meters }) => `${(meters * 3.28084).toFixed(2)} feet`,\n    '\"mass\"': ({ kilograms }) => `${(kilograms * 2.20462).toFixed(2)} pounds`,\n    '\"temperature\"': ({ celsius }) => `${((celsius * 9/5) + 32).toFixed(2)} Fahrenheit`,\n    default: \"assert\"\n  })(data.kind);\n\n  console.log(result);\n});\nEOF\necho '{\"kind\": \"length\", \"meters\": 1}' | node convert.js\n"]
