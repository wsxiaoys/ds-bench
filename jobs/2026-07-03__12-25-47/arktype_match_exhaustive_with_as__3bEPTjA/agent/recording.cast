[87.053521, "i", "cat > convert.js << 'EOF'\nconst { match, type } = require('arktype');\n\n// Read JSON from STDIN\nlet input = '';\nprocess.stdin.setEncoding('utf8');\nprocess.stdin.on('data', chunk => { input += chunk; });\nprocess.stdin.on('end', () => {\n  let data;\n  try {\n    data = JSON.parse(input);\n  } catch (e) {\n    console.error('Invalid JSON input');\n    process.exit(1);\n  }\n\n  const result = match({\n    [{ kind: 'length' }, '|', { kind: 'mass' }, '|', { kind: 'temperature' }]: (data) => {\n      if (data.kind === 'length') return `${(data.meters * 3.28084).toFixed(2)} feet`;\n      if (data.kind === 'mass') return `${(data.kilograms * 2.20462).toFixed(2)} pounds`;\n      return `${((data.celsius * 9/5) + 32).toFixed(2)} Fahrenheit`;\n    },\n    default: \"assert\"\n  })(data);\n\n  console.log(result);\n});\nEOF\necho '{\"kind\": \"length\", \"meters\": 1}' | node convert.js\n"]
