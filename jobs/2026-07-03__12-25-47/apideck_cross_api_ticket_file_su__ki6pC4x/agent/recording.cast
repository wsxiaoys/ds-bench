[554.805939, "i", "python3 << 'PYEOF'\nimport urllib.request\nimport json\n\nurl = 'https://unify.apideck.com/issue-tracking/collections/REDACTED/tickets/276'\nheaders = {\n    'Authorization': 'Bearer REDACTED',\n    'x-apideck-app-id': 'REDACTED',\n    'x-apideck-consumer-id': 'REDACTED',\n    'x-apideck-service-id': 'github',\n}\n\nreq = urllib.request.Request(url, headers=headers, method='GET')\nwith urllib.request.urlopen(req) as resp:\n    data = json.loads(resp.read().decode())\n\ndesc = data['data']['description']\nprint('Subject:', data['data']['subject'])\nprint()\nprint('Description (repr):', repr(desc))\nprint()\nprint('Description lines:')\nfor i, line in enumerate(desc.split('\\n')):\n    print(f'  Line {i}: {repr(line)}')\n\nprint()\nprint('First 100 bytes (hex):', desc[:100].encode().hex())\nprint('Last 50 bytes:', repr(desc[-50:]))\nPYEOF\n"]
