[143.183143, "i", "python3 << 'PYEOF'\nimport urllib.request\nimport json\nimport urllib.error\n\nurl = 'https://unify.apideck.com/issue-tracking/tickets'\nheaders = {\n    'Authorization': 'Bearer REDACTED',\n    'x-apideck-app-id': 'REDACTED',\n    'x-apideck-consumer-id': 'REDACTED',\n    'x-apideck-collection-id': 'REDACTED',\n    'x-apideck-service-id': 'github',\n    'Content-Type': 'application/json'\n}\n\nids = [\n    'eyJpZCI6IjNBREEwNzlCNzg1MzRGRjEhczA0OWUwOTNkNDc3ZTQ3NjNiMDkxYTczMjcwYjYzMzgyIiwiZHJpdmVfaWQiOiIzQURBMDc5Qjc4NTM0RkYxIn0=',\n    'eyJpZCI6IjNBREEwNzlCNzg1MzRGRjEhczQxOTk1MjE4YzgxYjQ4NTg5YWVmYjFlNGVhYTIyZWU4IiwiZHJpdmVfaWQiOiIzQURBMDc5Qjc4NTM0RkYxIn0=',\n    'eyJpZCI6IjNBREEwNzlCNzg1MzRGRjEhczdkMTdhN2E0NGQwYzRiM2FiYjY1OTA0NzM5YjAwMjJhIiwiZHJpdmVfaWQiOiIzQURBMDc5Qjc4NTM0RkYxIn0='\n]\nids.sort()\ndescription = '\\n'.join(ids)\npayload = json.dumps({\n    'title': '/logs/artifacts/run-id [FILE-INDEX]',\n    'description': description\n}).encode()\n\nreq = urllib.request.Request(url, data=payload, headers=headers, method='POST')\ntry:\n    with urllib.request.urlopen(req) as resp:\n        print('Status:', resp.status)\n        print(resp.read().decode())\nexcept urllib.error.HTTPError as e:\n    print('Error Status:', e.code)\n    print(e.read().decode())\nPYEOF\n"]
