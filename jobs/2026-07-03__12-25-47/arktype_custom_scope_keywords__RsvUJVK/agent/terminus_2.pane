[?2004l[?2004h>         let digit = s.charCodeAt(i) - 48;
[?2004l[?2004h>         if (shouldDouble) {
[?2004l[?2004h>             digit *= 2;
[?2004l[?2004h>             sum += digit >= 10 ? digit - 9 : digit;
[?2004l[?2004h>         } else {
[?2004l[?2004h>             sum += digit;
[?2004l[?2004h>         }
[?2004l[?2004h>         shouldDouble = !shouldDouble;
[?2004l[?2004h>     }
[?2004l[?2004h>     return sum % 10 === 0;
[?2004l[?2004h> };
[?2004l[?2004h> 
