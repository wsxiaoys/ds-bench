[388.65459, "o", "drwxr-xr-x  1 root root    43 Jul  3 14:40 \u001b[0m\u001b[01;34m.\u001b[0m\r\ndrwxr-xr-x  1 root root    31 Jul  3 14:33 \u001b[01;34m..\u001b[0m\r\n-rw-r--r--  1 root root  1031 Jul  3 14:38 cli.ts\r\ndrwxr-xr-x 14 root root  4096 Jul  3 14:33 \u001b[01;34mnode_modules\u001b[0m\r\n-rw-r--r--  1 root root 18023 Jul  3 14:33 package-lock.json\r\n-rw-r--r--  1 root root   260 Jul  3 14:33 package.json\r\ndrwxr-xr-x  2 root root    33 Jul  3 14:36 \u001b[01;34msrc\u001b[0m\r\n"]
