wed, $>>(predicate: Predicate.Castable<this[\"infer\"], narrowed>): r extends infer _ ? _ : never;\r\nnode_modules/arktype/out/variants/base.d.ts:433:     * #### narrow this based on an {@link equals} check\r\nnode_modules/arktype/out/variants/base.d.ts:456:     * #### narrow this based on an {@link extends} check\r\nnode_modules/arktype/out/variants/base.d.ts:475:     * const NoAt = type(\"string\").narrow(s => !s.includes(\"@\"))\r\nnode_modules/arktype/out/variants/string.d.ts:6:    matching<const schema extends Pattern.Schema>(schema: schema): schema extends string ? Type<regex.infer<schema>, $> : schema extends {\r\n"]
