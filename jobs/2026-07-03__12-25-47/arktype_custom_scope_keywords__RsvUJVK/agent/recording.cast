[51.288682, "o", "263:     *     .narrow(s => s === [...s].reverse().join(\"\"))\r\n307:     * ⚠️ the behavior of {@link narrow}, this method's output counterpart, is usually more desirable\r\n309:     * 🥸 {@link https://www.typescriptlang.org/docs/handbook/2/narrowing.html#using-type-predicates | Type predicates} can be used as casts\r\n319:    filter<narrowed extends this[\"inferIn\"] = never, r = instantiateType<[\r\n320:        narrowed\r\n321:    ] extends [never] ? t : t extends InferredMorph<never, infer o> ? (In: narrowed) => o : narrowed, $>>(predicate: Predicate.Castable<this[\"inferIn\"], narrowed>): r extends infer _ ? _ : never;\r\n327:     * 🥸 {@link https://www.typescriptlang.org/docs/handbook/2/narrowing.html#using-type-predicates | Type predicates} can be used as casts\r\n330:     * const Palindrome = type(\"string\").narrow(s => s === [...s].reverse().join(\"\"))\r\n332:     * const PalindromicEmail = type(\"string.date.parse\").narrow((date, ctx) =>\r\n336:     * const WithPredicate = type(\"string\").narrow((s): s is `${string}.tsx` => /\\.tsx?$/.test(s))\r\n338:    narrow<narrowed extends this[\"infer\"] = never, r = instantiateType<[\r\n339:        narrowed\r\n340:    ] extends [never] ? t : t extends InferredMorph<infer i, infer o> ? o extends To ? (In: i) => To<narrowed> : (In: i) => Out<narrowed> : narrowed, $>>(predicate: Predicate.Castable<this[\"infer\"], narrowed>): r extends infer _ ? _ : never;\r\n433:     * #### narrow this based on an {@link equals} check\r\n456:     * #### narrow this based on an {@link extends} check\r\n475:     * const NoAt = type(\"string\").narrow(s => !s.includes(\"@\"))\r\n"]
