[428.793923, "o", "import { Outlet, createRootRoute } from '@tanstack/react-router'\r\n\r\nexport const Route = createRootRoute({\r\n  component: RootComponent,\r\n})\r\n\r\nfunction RootComponent() {\r\n  return (\r\n    <div>\r\n      <Outlet />\r\n    </div>\r\n  )\r\n}\r\n"]
