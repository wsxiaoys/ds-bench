[444.357787, "i", "cat > /tmp/test_engine.py << 'PYEOF'\nimport asyncio\nimport sys\nsys.path.insert(0, '/home/user/ticker_app')\n\nfrom ticker_app.engine import engine\n\nasync def main():\n    print(\"Initial:\", engine.snapshot())\n    \n    # Start\n    started = await engine.start()\n    print(f\"First start: started={started}, running={engine.running}\")\n    \n    # Idempotent start\n    started = await engine.start()\n    print(f\"Second start: started={started}, running={engine.running}\")\n    \n    # Wait for ticks\n    await asyncio.sleep(2.0)\n    print(\"After 2s ticks:\", engine.snapshot()['update_count'])\n    \n    # Stop\n    await engine.stop()\n    print(f\"Stopped: running={engine.running}\")\n    \n    # Wait to see if engine keeps running\n    count_before = engine.snapshot()['update_count']\n    await asyncio.sleep(2.0)\n    count_after = engine.snapshot()['update_count']\n    print(f\"Ticks before wait: {count_before}, after wait: {count_after}\")\n    \n    # Start again\n    started = await engine.start()\n    print(f\"Restart: started={started}\")\n    await asyncio.sleep(1.0)\n    print(\"After 1s ticks:\", engine.snapshot()['update_count'])\n    await engine.stop()\n\nasyncio.run(main())\nPYEOF\nuv run python /tmp/test_engine.py\n"]
