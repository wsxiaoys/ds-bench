[268.47183, "i", "cat > ticker_app/ticker_app.py << 'PYEOF'\n\"\"\"Reflex stock-ticker dashboard.\n\nThis module wires together:\n- A `TickerState` that exposes the live price book to the browser.\n- A long-running `@rx.event(background=True)` handler that mirrors the\n  shared engine's ticks into the Reflex state every 500 ms.\n- A `percent_change` cached computed var.\n- A FastAPI sub-app (mounted via `api_transformer`) that exposes the\n  headless REST surface used by the verifier.\n\"\"\"\n\nfrom __future__ import annotations\n\nimport asyncio\nfrom typing import Any, Dict, List\n\nimport fastapi\nimport reflex as rx\n\nfrom .engine import SEEDS, SYMBOLS, engine\n\n\ndef _row(symbol: str, price: float, percent: float) -> Dict[str, Any]:\n    return {\n        \"symbol\": symbol,\n        \"price_text\": f\"${price:,.2f}\",\n        \"percent_text\": f\"{percent:+.4f}%\",\n        \"percent\": float(percent),\n    }\n\n\n# ----------------------------------------------------------------------- state\nclass TickerState(rx.State):\n    \"\"\"Live state for the stock-ticker page.\"\"\"\n\n    # Plain serializable base vars (visible to the UI).\n    prices: Dict[str, float] = dict(SEEDS)\n    seeds: Dict[str, float] = dict(SEEDS)\n    running: bool = False\n    update_count: int = 0\n\n    # Backend-only vars (underscore-prefixed, not serialized to the client).\n    _loop_active: bool = False\n\n    # ---------------------------------------------------------------- computed\n    @rx.var(cache=True)\n    def percent_change(self) -> Dict[str, float]:\n        \"\"\"Per-symbol percent change vs. seed, rounded to 4 decimal places.\"\"\"\n        prices = self.prices\n        seeds = self.seeds\n        result: Dict[str, float] = {}\n        for sym in SYMBOLS:\n            seed = seeds.get(sym, SEEDS[sym])\n            current = prices.get(sym, seed)\n            if seed == 0:\n                result[sym] = 0.0\n            else:\n                result[sym] = round((current - seed) / seed * 100.0, 4)\n        return result\n\n    @rx.var\n    def rows(self) -> List[Dict[str, Any]]:\n        \"\"\"Pre-formatted table rows built from the live prices and computed var.\"\"\"\n        prices = self.prices\n        seeds = self.seeds\n        pct_map = self.percent_change\n        out: List[Dict[str, Any]] = []\n        for sym in SYMBOLS:\n            price = float(prices.get(sym, seeds.get(sym, SEEDS[sym])))\n            pct = float(pct_map.get(sym, 0.0))\n            out.append(_row(sym, price, pct))\n        return out\n\n    # ---------------------------------------------------------------- helpers\n    def _pull_snapshot_into_state(self) -> None:\n        \"\"\"Copy the engine's current snapshot into the (non-background) base vars.\"\"\"\n        snap = engine.snapshot()\n        self.prices = snap[\"prices\"]\n        self.seeds = snap[\"seeds\"]\n        self.running = bool(snap[\"running\"])\n        self.update_count = int(snap[\"update_count\"])\n\n    # ---------------------------------------------------------------- handlers\n    @rx.event\n    async def start(self) -> Any:\n        \"\"\"UI Start handler. Drives the engine idempotently and kicks off the\n        background event handler that mirrors ticks into State.\"\"\"\n        async with self:\n            if self._loop_active:\n                self._pull_snapshot_into_state()\n                return\n            self._loop_active = True\n\n        # Ask the engine to start (it is itself idempotent).\n        await engine.start()\n\n        async with self:\n            self._pull_snapshot_into_state()\n\n        # Kick off the background mirror. The background handler itself\n        # owns the idempotency guard around _loop_active.\n        return TickerState.background_update\n\n    @rx.event\n    async def stop(self) -> None:\n        \"\"\"UI Stop handler.\"\"\"\n        await engine.stop()\n        async with self:\n            self._loop_active = False\n            self._pull_snapshot_into_state()\n\n    @rx.event(background=True)\n    async def background_update(self) -> None:\n        \"\"\"Long-running background handler that mirrors the engine's ticks\n        into the Reflex State. Owns the idempotency guard `_loop_active`.\n        \"\"\"\n       "]
[268.471881, "i", " async with self:\n            if self._loop_active:\n                return\n            self._loop_active = True\n\n        try:\n            while True:\n                await asyncio.sleep(engine.TICK_SECONDS)\n                snap = engine.snapshot()\n                async with self:\n                    self.prices = snap[\"prices\"]\n                    self.update_count = int(snap[\"update_count\"])\n                    self.running = bool(snap[\"running\"])\n                if not snap[\"running\"]:\n                    break\n        finally:\n            async with self:\n                self._loop_active = False\n\n\n# ----------------------------------------------------------------------- UI\ndef _render_row(row: Dict[str, Any]) -> rx.Component:\n    return rx.table.row(\n        rx.table.cell(rx.text(row[\"symbol\"], weight=\"bold\")),\n        rx.table.cell(rx.text(row[\"price_text\"])),\n        rx.table.cell(rx.text(row[\"percent_text\"])),\n    )\n\n\ndef index() -> rx.Component:\n    return rx.container(\n        rx.vstack(\n            rx.heading(\"Live Stock Ticker\", size=\"7\"),\n            rx.text(\n                rx.cond(\n                    TickerState.running,\n                    rx.text(\"Status: RUNNING\", color=\"green\", weight=\"bold\"),\n                    rx.text(\"Status: STOPPED\", color=\"red\", weight=\"bold\"),\n                )\n            ),\n            rx.hstack(\n                rx.button(\"Start\", on_click=TickerState.start, color_scheme=\"green\"),\n                rx.button(\"Stop\", on_click=TickerState.stop, color_scheme=\"red\"),\n                spacing=\"4\",\n            ),\n            rx.table.root(\n                rx.table.header(\n                    rx.table.row(\n                        rx.table.column_header_cell(\"Symbol\"),\n                        rx.table.column_header_cell(\"Price\"),\n                        rx.table.column_header_cell(\"Percent Change\"),\n                    )\n                ),\n                rx.table.body(\n                    rx.foreach(TickerState.rows, _render_row),\n                ),\n                width=\"100%\",\n            ),\n            spacing=\"4\",\n            padding=\"2em\",\n        )\n    )\n\n\n# ----------------------------------------------------------------------- API\napi_app = fastapi.FastAPI(title=\"Ticker REST API\")\n\n\n@api_app.post(\"/api/ticker/start\")\nasync def api_start() -> Dict[str, Any]:\n    started = await engine.start()\n    return {\"running\": bool(engine.running), \"started\": bool(started)}\n\n\n@api_app.post(\"/api/ticker/stop\")\nasync def api_stop() -> Dict[str, Any]:\n    await engine.stop()\n    return {\"running\": bool(engine.running)}\n\n\n@api_app.get(\"/api/ticker/snapshot\")\nasync def api_snapshot() -> Dict[str, Any]:\n    return engine.snapshot()\n\n\n# ----------------------------------------------------------------------- app\napp = rx.App(api_transformer=api_app)\napp.add_page(index)\nPYEOF\n"]
[268.472108, "o", "cat > ticker_app/ticker_app.py << 'PYEOF'\r\n\u001b[?2004l\r"]
[268.472186, "o", "\u001b[?2004h> \"\"\"Reflex stock-ticker dashboard.\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[268.472522, "o", "This module wires together:\r\n\u001b[?2004l\r\u001b[?2004h> - A `TickerState` that exposes the live price book to the browser.\r\n\u001b[?2004l\r\u001b[?2004h> - A long-running `@rx.event(background=True)` handler that mirrors the\r\n\u001b[?2004l\r\u001b[?2004h>   shared engine's ticks into the Reflex state every 500 ms.\r\n\u001b[?2004l\r\u001b[?2004h> "]
[268.472704, "o", "- A `percent_change` cached computed var.\r\n\u001b[?2004l\r\u001b[?2004h> - A FastAPI sub-app (mounted via `api_transformer`) that exposes the\r\n\u001b[?2004l\r\u001b[?2004h>   headless REST surface used by the verifier.\r\n\u001b[?2004l\r\u001b[?2004h> \"\"\"\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[268.472755, "o", "from __future__ import annotations\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[268.472797, "o", "\u001b[?2004h> import asyncio\r\n\u001b[?2004l\r\u001b[?2004h> "]
[268.472884, "o", "from typing import Any, Dict, List\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> import fastapi\r\n\u001b[?2004l\r"]
[268.472905, "o", "\u001b[?2004h> "]
[268.472985, "o", "import reflex as rx\r\n\u001b[?2004l\r\u001b[?2004h> "]
[268.473002, "o", "\r\n\u001b[?2004l\rl\u001b[?2004h> "]
[268.473043, "o", "from .engine import SEEDS, SYMBOLS, engine\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r-\u001b[?2004h> "]
[268.473183, "o", "def _row(symbol: str, price: float, percent: float) -> Dict[str, Any]:\r\n\u001b[?2004l\r\u001b[?2004h>     return {\r\n\u001b[?2004l\r\u001b[?2004h"]
[268.473269, "o", ">         \"symbol\": symbol,\r\n\u001b[?2004l\r\u001b[?2004h> "]
[268.473316, "o", "        \"price_text\": f\"${price:,.2f}\",\r\n\u001b[?2004l\r\u001b[?2004h> "]
[268.473367, "o", "        \"percent_text\": f\"{percent:+.4f}%\",\r\n\u001b[?2004l\r\u001b[?2004h> "]
[268.473424, "o", "        \"percent\": float(percent),\r\n\u001b[?2004l\r[\""]
[268.473467, "o", "\u001b[?2004h>     }\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\rprice_t\u001b[?2004h> \r\n\u001b[?2004l\re\u001b[?2004h> "]
[268.473577, "o", "# ----------------------------------------------------------------------- state\r\n\u001b[?2004l\r"]
[268.473612, "o", "\u001b[?2004h> "]
[268.473651, "o", "class TickerState(rx.State):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[268.473742, "o", "    \"\"\"Live state for the stock-ticker page.\"\"\"\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[268.47385, "o", "    # Plain serializable base vars (visible to the UI).\r\n\u001b[?2004l\r\u001b[?2004h> "]
[268.47392, "o", "    prices: Dict[str, float] = dict(SEEDS)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[268.473972, "o", "    seeds: Dict[str, float] = dict(SEEDS)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[268.47401, "o", "    running: bool = False\r\n\u001b[?2004l\r"]
[268.47402, "o", "\u001b[?2004h> "]
[268.474067, "o", "    update_count: int = 0\r\n\u001b[?2004l\rh"]
[268.474079, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[268.474236, "o", "    # Backend-only vars (underscore-prefixed, not serialized to the client).\r\n\u001b[?2004l\r\u001b[?2004h> "]
[268.474287, "o", "    _loop_active: bool = False\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[268.474327, "o", "> "]
[268.474421, "o", "    # ---------------------------------------------------------------- computed\r\n\u001b[?2004l\r\u001b[?2004h> "]
[268.474495, "o", "    @rx.var(cache=True)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[268.474552, "o", "    def percent_change(self) -> Dict[str, float]:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[268.474638, "o", "        \"\"\"Per-symbol percent change vs. seed, rounded to 4 decimal places.\"\"\"\r\n\u001b[?2004l\r\u001b[?2004h"]
[268.47467, "o", "> "]
[268.474685, "o", "        prices = self.prices\r\n\u001b[?2004l\r"]
[268.474715, "o", "\u001b[?2004h> "]
[268.474771, "o", "        seeds = self.seeds\r\n\u001b[?2004l\r\u001b[?2004h"]
[268.474815, "o", "> "]
[268.474925, "o", "        result: Dict[str, float] = {}\r\n\u001b[?2004l\r\u001b[?2004h>         for sym in SYMBOLS:\r\n\u001b[?2004l\r\u001b[?2004h>             seed = seeds.get(sym, SEEDS[sym])\r\n\u001b[?2004l\r\u001b[?2004h> "]
[268.475006, "o", "            current = prices.get(sym, seed)\r\n\u001b[?2004l\r\u001b[?2004h>             if seed == 0:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[268.475084, "o", "                result[sym] = 0.0\r\n\u001b[?2004l\rh\u001b[?2004h> "]
[268.47512, "o", "            else:\r\n\u001b[?2004l\rcen\u001b[?2004h> "]
[268.475213, "o", "                result[sym] = round((current - seed) / seed * 100.0, 4)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[268.475282, "o", "        return result\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r \u001b[?2004h> "]
[268.475326, "o", "    @rx.var\r\n\u001b[?2004l\r\u001b[?2004h> "]
[268.475381, "o", "    def rows(self) -> List[Dict[str, Any]]:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[268.475484, "o", "        \"\"\"Pre-formatted table rows built from the live prices and computed var.\"\"\"\r\n\u001b[?2004l\r\u001b[?2004h> "]
[268.475528, "o", "        prices = self.prices\r\n\u001b[?2004l\r\u001b[?2004h> "]
[268.475592, "o", "        seeds = self.seeds\r\n\u001b[?2004l\r\u001b[?2004h> "]
[268.475683, "o", "        pct_map = self.percent_change\r\n\u001b[?2004l\r\u001b[?2004h> "]
[268.475746, "o", "        out: List[Dict[str, Any]] = []\r\n\u001b[?2004l\r\u001b[?2004h> "]
[268.475778, "o", "        for sym in SYMBOLS:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[268.475884, "o", "            price = float(prices.get(sym, seeds.get(sym, SEEDS[sym])))\r\n\u001b[?2004l\r\u001b[?2004h> "]
[268.475949, "o", "            pct = float(pct_map.get(sym, 0.0))\r\n\u001b[?2004l\r\u001b[?2004h"]
[268.475965, "o", "> "]
[268.47603, "o", "            out.append(_row(sym, price, pct))\r\n\u001b[?2004l\r"]
[268.476076, "o", "\u001b[?2004h> "]
[268.476125, "o", "        return out\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[268.476255, "o", ">     # ---------------------------------------------------------------- helpers\r\n\u001b[?2004l\r\u001b[?2004h>     def _pull_snapshot_into_state(self) -> None:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[268.476372, "o", "        \"\"\"Copy the engine's current snapshot into the (non-background) base vars.\"\"\"\r\n\u001b[?2004l\r\u001b[?2004h> "]
[268.476426, "o", "        snap = engine.snapshot()\r\n\u001b[?2004l\r"]
[268.476473, "o", "\u001b[?2004h> "]
[268.476488, "o", "        self.prices = snap[\"prices\"]\r\n\u001b[?2004l\r\u001b[?2004h"]
[268.4765, "o", "> "]
[268.476568, "o", "        self.seeds = snap[\"seeds\"]\r\n\u001b[?2004l\r\u001b[?2004h> "]
[268.476636, "o", "        self.running = bool(snap[\"running\"])\r\n\u001b[?2004l\r\u001b[?2004h> "]
[268.476701, "o", "        self.update_count = int(snap[\"update_count\"])\r\n\u001b[?2004l\r\u001b[?2004h"]
[268.476713, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[268.476809, "o", "    # ---------------------------------------------------------------- handlers\r\n\u001b[?2004l\r\u001b[?2004h> "]
[268.476823, "o", "    @rx.event\r\n\u001b[?2004l\r"]
[268.476831, "o", "\u001b[?2004h> "]
[268.476871, "o", "    async def start(self) -> Any:\r\n\u001b[?2004l\r"]
[268.47688, "o", "\u001b[?2004h> "]
[268.476958, "o", "        \"\"\"UI Start handler. Drives the engine idempotently and kicks off the\r\n\u001b[?2004l\r\u001b[?2004h"]
[268.476967, "o", "> "]
[268.477036, "o", "        background event handler that mirrors ticks into State.\"\"\"\r\n\u001b[?2004l\r"]
[268.477049, "o", "\u001b[?2004h> "]
[268.477071, "o", "        async with self:\r\n\u001b[?2004l\r"]
[268.47708, "o", "\u001b[?2004h> "]
[268.477118, "o", "            if self._loop_active:\r\n\u001b[?2004l\r\u001b[?2004h"]
[268.477127, "o", "> "]
[268.477179, "o", "                self._pull_snapshot_into_state()\r\n\u001b[?2004l\r"]
[268.477187, "o", "\u001b[?2004h> "]
[268.477207, "o", "                return\r\n\u001b[?2004l\r"]
[268.477223, "o", "\u001b[?2004h> "]
[268.47726, "o", "            self._loop_active = True\r\n\u001b[?2004l\r"]
[268.477272, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[268.477282, "o", "\u001b[?2004h> "]
[268.477341, "o", "        # Ask the engine to start (it is itself idempotent).\r\n\u001b[?2004l\r"]
[268.477349, "o", "\u001b[?2004h> "]
[268.477469, "o", "        await engine.start()\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h>         async with self:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[268.477481, "o", "            self._pull_snapshot_into_state()\r\n\u001b[?2004l\r"]
[268.47749, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[268.477499, "o", "\u001b[?2004h> "]
[268.477576, "o", "        # Kick off the background mirror. The background handler itself\r\n\u001b[?2004l\r"]
[268.477585, "o", "\u001b[?2004h> "]
[268.47765, "o", "        # owns the idempotency guard around _loop_active.\r\n\u001b[?2004l\r\u001b[?2004h"]
[268.477659, "o", "> "]
[268.477703, "o", "        return TickerState.background_update\r\n\u001b[?2004l\r"]
[268.477713, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[268.477721, "o", "\u001b[?2004h> "]
[268.477746, "o", "    @rx.event\r\n\u001b[?2004l\r\u001b[?2004h> "]
[268.477779, "o", "    async def stop(self) -> None:\r\n\u001b[?2004l\r"]
[268.477802, "o", "\u001b[?2004h> "]
[268.477822, "o", "        \"\"\"UI Stop handler.\"\"\"\r\n\u001b[?2004l\r"]
[268.477832, "o", "\u001b[?2004h> "]
[268.477862, "o", "        await engine.stop()\r\n\u001b[?2004l\r"]
[268.477884, "o", "\u001b[?2004h> "]
[268.477895, "o", "        async with self:\r\n\u001b[?2004l\r"]
[268.477903, "o", "\u001b[?2004h> "]
[268.477944, "o", "            self._loop_active = False\r\n\u001b[?2004l\r"]
[268.477963, "o", "\u001b[?2004h> "]
[268.478002, "o", "            self._pull_snapshot_into_state()\r\n\u001b[?2004l\r"]
[268.478019, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[268.478033, "o", "\u001b[?2004h> "]
[268.478053, "o", "    @rx.event(background=True)\r\n\u001b[?2004l\r"]
[268.478062, "o", "\u001b[?2004h> "]
[268.478116, "o", "    async def background_update(self) -> None:\r\n\u001b[?2004l\r"]
[268.478127, "o", "\u001b[?2004h> "]
[268.478202, "o", "        \"\"\"Long-running background handler that mirrors the engine's ticks\r\n\u001b[?2004l\r"]
[268.478231, "o", "\u001b[?2004h> "]
[268.478287, "o", "        into the Reflex State. Owns the idempotency guard `_loop_active`.\r\n\u001b[?2004l\r"]
[268.478307, "o", "\u001b[?2004h> "]
[268.478321, "o", "        \"\"\"\r\n\u001b[?2004l\r"]
[268.47834, "o", "\u001b[?2004h> "]
[268.478357, "o", "        async with self:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[268.478396, "o", "            if self._loop_active:\r\n\u001b[?2004l\r\u001b[?2004h"]
[268.478415, "o", "> "]
[268.478439, "o", "                return\r\n\u001b[?2004l\r\u001b[?2004h> "]
[268.478478, "o", "            self._loop_active = True\r\n\u001b[?2004l\r"]
[268.478506, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[268.478524, "o", "        try:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[268.478555, "o", "            while True:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[268.478613, "o", "                await asyncio.sleep(engine.TICK_SECONDS)\r\n\u001b[?2004l\r"]
[268.478637, "o", "\u001b[?2004h> "]
[268.478673, "o", "                snap = engine.snapshot()\r\n\u001b[?2004l\r\u001b[?2004h> "]
[268.478712, "o", "                async with self:\r\n\u001b[?2004l\r\u001b[?2004h"]
[268.478735, "o", "> "]
[268.478766, "o", "                    self.prices = snap[\"prices\"]\r\n\u001b[?2004l\r"]
[268.478784, "o", "\u001b[?2004h> "]
[268.478844, "o", "                    self.update_count = int(snap[\"update_count\"])\r\n\u001b[?2004l\r"]
[268.478855, "o", "\u001b[?2004h> "]
[268.478913, "o", "                    self.running = bool(snap[\"running\"])\r\n\u001b[?2004l\r"]
[268.478937, "o", "\u001b[?2004h> "]
[268.478965, "o", "                if not snap[\"running\"]:\r\n\u001b[?2004l\r\u001b[?2004h"]
[268.478976, "o", "> "]
[268.479005, "o", "                    break\r\n\u001b[?2004l\r\u001b[?2004h"]
[268.479026, "o", ">         finally:\r\n\u001b[?2004l\r"]
[268.479049, "o", "\u001b[?2004h> "]
[268.479066, "o", "            async with self:\r\n\u001b[?2004l\r"]
[268.479089, "o", "\u001b[?2004h> "]
[268.479116, "o", "                self._loop_active = False\r\n\u001b[?2004l\r"]
[268.479135, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[268.479152, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[268.479171, "o", "\u001b[?2004h> "]
[268.479231, "o", "# ----------------------------------------------------------------------- UI\r\n\u001b[?2004l\r"]
[268.479251, "o", "\u001b[?2004h> "]
[268.479294, "o", "def _render_row(row: Dict[str, Any]) -> rx.Component:\r\n\u001b[?2004l\r"]
[268.479315, "o", "\u001b[?2004h> "]
[268.479332, "o", "    return rx.table.row(\r\n\u001b[?2004l\r"]
[268.479357, "o", "\u001b[?2004h> "]
[268.479406, "o", "        rx.table.cell(rx.text(row[\"symbol\"], weight=\"bold\")),\r\n\u001b[?2004l\r"]
[268.479424, "o", "\u001b[?2004h> "]
[268.479467, "o", "        rx.table.cell(rx.text(row[\"price_text\"])),\r\n\u001b[?2004l\r"]
[268.479492, "o", "\u001b[?2004h> "]
[268.47953, "o", "        rx.table.cell(rx.text(row[\"percent_text\"])),\r\n\u001b[?2004l\r"]
[268.479554, "o", "\u001b[?2004h>     )\r\n"]
[268.479575, "o", "\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[268.47959, "o", "\u001b[?2004h> "]
[268.47961, "o", "def index() -> rx.Component:\r\n\u001b[?2004l\r\u001b[?2004h"]
[268.47962, "o", "> "]
[268.479649, "o", "    return rx.container(\r\n\u001b[?2004l\r\u001b[?2004h> "]
[268.479673, "o", "        rx.vstack(\r\n\u001b[?2004l\r"]
[268.479682, "o", "\u001b[?2004h> "]
[268.47974, "o", "            rx.heading(\"Live Stock Ticker\", size=\"7\"),\r\n\u001b[?2004l\r"]
[268.479763, "o", "\u001b[?2004h> "]
[268.479779, "o", "            rx.text(\r\n\u001b[?2004l\r"]
[268.480131, "o", "\u001b[?2004h>                 rx.cond(\r\n\u001b[?2004l\r\u001b[?2004h>                     TickerState.running,\r\n\u001b[?2004l\r\u001b[?2004h>                     rx.text(\"Status: RUNNING\", color=\"green\", weight=\"bold\"),\r\n\u001b[?2004l\r\u001b[?2004h>                     rx.text(\"Status: STOPPED\", color=\"red\", weight=\"bold\"),\r\n\u001b[?2004l\r\u001b[?2004h>                 )\r\n\u001b[?2004l\r\u001b[?2004h>             ),\r\n\u001b[?2004l\r\u001b[?2004h>             rx.hstack(\r\n\u001b[?2004l\r\u001b[?2004h> "]
[268.480207, "o", "                rx.button(\"Start\", on_click=TickerState.start, color_scheme=\"green\"),\r\n\u001b[?2004l\r"]
[268.480234, "o", "\u001b[?2004h> "]
[268.480302, "o", "                rx.button(\"Stop\", on_click=TickerState.stop, color_scheme=\"red\"),\r\n\u001b[?2004l\r"]
[268.480319, "o", "\u001b[?2004h> "]
[268.480349, "o", "                spacing=\"4\",\r\n\u001b[?2004l\r\u001b[?2004h> "]
[268.480384, "o", "            ),\r\n\u001b[?2004l\r\u001b[?2004h> "]
[268.480414, "o", "            rx.table.root(\r\n\u001b[?2004l\r\u001b[?2004h> "]
[268.480449, "o", "                rx.table.header(\r\n\u001b[?2004l\r"]
[268.480457, "o", "\u001b[?2004h> "]
[268.480497, "o", "                    rx.table.row(\r\n\u001b[?2004l\r"]
[268.48052, "o", "\u001b[?2004h> "]
[268.48057, "o", "                        rx.table.column_header_cell(\"Symbol\"),\r\n\u001b[?2004l\r"]
[268.480592, "o", "\u001b[?2004h> "]
[268.480642, "o", "                        rx.table.column_header_cell(\"Price\"),\r\n\u001b[?2004l\r"]
[268.480663, "o", "\u001b[?2004h> "]
[268.480723, "o", "                        rx.table.column_header_cell(\"Percent Change\"),\r\n\u001b[?2004l\r"]
[268.480731, "o", "\u001b[?2004h> "]
[268.480759, "o", "                    )\r\n\u001b[?2004l\r"]
[268.480783, "o", "\u001b[?2004h> "]
[268.480795, "o", "                ),\r\n\u001b[?2004l\r\u001b[?2004h> "]
[268.480831, "o", "                rx.table.body(\r\n\u001b[?2004l\r\u001b[?2004h"]
[268.480841, "o", "> "]
