[143.529915, "o", "            \"running\": bool(self._running),\r\n\u001b[?2004l\r\u001b[?2004h> "]
[143.529959, "o", "            \"update_count\": int(self._update_count),\r\n\u001b[?2004l\r\u001b[?2004h> "]
[143.530002, "o", "            \"seeds\": seeds,\r\n\u001b[?2004l\r\u001b[?2004h> "]
[143.530047, "o", "            \"prices\": prices,\r\n\u001b[?2004l\r\u001b[?2004h> "]
[143.530102, "o", "            \"percent_changes\": percent_changes,\r\n\u001b[?2004l\r\u001b[?2004h>         }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[143.530145, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[143.53024, "o", "    # ---------------------------------------------------------------- mutation\r\n\u001b[?2004l\r\u001b[?2004h>     def reset_prices(self) -> None:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[143.530306, "o", "        \"\"\"Reset prices back to seeds and zero the update count.\"\"\"\r\n\u001b[?2004l\r\u001b[?2004h> "]
[143.530354, "o", "        self._prices = dict(self._seeds)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[143.530409, "o", "        self._update_count = 0\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[143.530456, "o", "    def tick_once(self) -> Dict[str, float]:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[143.530499, "o", "        \"\"\"Apply one bounded random walk step and return the new prices.\"\"\"\r\n\u001b[?2004l\r\u001b[?2004h> "]
[143.530524, "o", "        for sym in SYMBOLS:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[143.530591, "o", "            current = self._prices[sym]\r\n\u001b[?2004l\r\u001b[?2004h> "]
[143.530677, "o", "            delta_pct = self._rng.uniform(-self.MAX_DELTA_FRACTION, self.MAX_DELTA_FRACTION)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[143.530723, "o", "            new_price = current * (1.0 + delta_pct)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[143.53077, "o", "            if new_price < self.MIN_PRICE:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[143.530815, "o", "                new_price = self.MIN_PRICE\r\n\u001b[?2004l\r\u001b[?2004h> "]
[143.530863, "o", "            self._prices[sym] = float(new_price)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[143.530906, "o", "        self._update_count += 1\r\n\u001b[?2004l\r\u001b[?2004h> "]
[143.530952, "o", "        return dict(self._prices)\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[143.531012, "o", "    # ---------------------------------------------------------------- control\r\n\u001b[?2004l\r\u001b[?2004h> "]
[143.531059, "o", "    async def start(self) -> bool:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[143.531125, "o", "        \"\"\"Start the background loop idempotently. Returns True if a new loop was started.\"\"\"\r\n\u001b[?2004l\r\u001b[?2004h> "]
[143.531175, "o", "        async with self._lock:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[143.53126, "o", "            if self._running and self._task is not None and not self._task.done():\r\n\u001b[?2004l\r\u001b[?2004h> "]
[143.531282, "o", "                return False\r\n\u001b[?2004l\r\u001b[?2004h> "]
[143.531338, "o", "            self._running = True\r\n\u001b[?2004l\r\u001b[?2004h> "]
[143.531385, "o", "            self.reset_prices()\r\n\u001b[?2004l\r\u001b[?2004h> "]
[143.531409, "o", "            self._task = asyncio.create_task(self._run())\r\n\u001b[?2004l\r\u001b[?2004h> "]
[143.531465, "o", "            return True\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[143.53151, "o", "    async def stop(self) -> None:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[143.531558, "o", "        \"\"\"Stop the background loop if running.\"\"\"\r\n\u001b[?2004l\r\u001b[?2004h> "]
[143.531602, "o", "        async with self._lock:\r\n\u001b[?2004l\r\u001b[?2004h>             self._running = False\r\n\u001b[?2004l\r"]
[143.531648, "o", "\u001b[?2004h>             task = self._task\r\n\u001b[?2004l\r\u001b[?2004h> "]
[143.531673, "o", "            self._task = None\r\n\u001b[?2004l\r\u001b[?2004h> "]
[143.531732, "o", "        if task is not None and not task.done():\r\n\u001b[?2004l\r\u001b[?2004h> "]
[143.531778, "o", "            task.cancel()\r\n\u001b[?2004l\r\u001b[?2004h>             try:\r\n\u001b[?2004l\r"]
[143.531823, "o", "\u001b[?2004h>                 await task\r\n\u001b[?2004l\r\u001b[?2004h> "]
[143.531874, "o", "            except (asyncio.CancelledError, Exception):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[143.531917, "o", "                pass\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[143.531962, "o", "    async def _run(self) -> None:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[143.532006, "o", "        \"\"\"The long-running tick loop.\"\"\"\r\n\u001b[?2004l\r\u001b[?2004h>         try:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[143.532048, "o", "            while True:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[143.532098, "o", "                await asyncio.sleep(self.TICK_SECONDS)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[143.532141, "o", "                prices = self.tick_once()\r\n\u001b[?2004l\r\u001b[?2004h> "]
[143.532191, "o", "                if self._listener is not None:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[143.532237, "o", "                    try:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[143.532292, "o", "                        result = self._listener(dict(prices), int(self._update_count))\r\n\u001b[?2004l\r\u001b[?2004h> "]
[143.532351, "o", "                        if asyncio.iscoroutine(result):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[143.532405, "o", "                            await result\r\n\u001b[?2004l\r\u001b[?2004h> "]
[143.532452, "o", "                    except Exception:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[143.532504, "o", "                        # Listener errors must not kill the engine loop.\r\n\u001b[?2004l\r\u001b[?2004h> "]
[143.532526, "o", "                        pass\r\n\u001b[?2004l\r\u001b[?2004h> "]
[143.532583, "o", "        except asyncio.CancelledError:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[143.532631, "o", "            return\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[143.532704, "o", "# Module-level singleton used by both the Reflex State and the REST API.\r\n\u001b[?2004l\r\u001b[?2004h> "]
[143.532729, "o", "engine = TickerEngine()\r\n\u001b[?2004l\r\u001b[?2004h> PYEOF\r\n\u001b[?2004l\r"]
