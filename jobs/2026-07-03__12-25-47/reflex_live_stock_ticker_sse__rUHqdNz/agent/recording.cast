[268.480924, "o", "\u001b[?2004h> "]
[268.480943, "o", "                ),\r\n\u001b[?2004l\r"]
[268.48153, "o", "\u001b[?2004h>                 width=\"100%\",\r\n\u001b[?2004l\r\u001b[?2004h>             ),\r\n\u001b[?2004l\r\u001b[?2004h>             spacing=\"4\",\r\n\u001b[?2004l\r\u001b[?2004h>             padding=\"2em\",\r\n\u001b[?2004l\r\u001b[?2004h>         )\r\n\u001b[?2004l\r\u001b[?2004h>     )\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> # ----------------------------------------------------------------------- API\r\n\u001b[?2004l\r\u001b[?2004h> api_app = fastapi.FastAPI(title=\"Ticker REST API\")\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> @api_app.post(\"/api/ticker/start\")\r\n\u001b[?2004l\r\u001b[?2004h> async def api_start() -> Dict[str, Any]:\r\n\u001b[?2004l\r\u001b[?2004h>     started = await engine.start()\r\n\u001b[?2004l\r\u001b[?2004h>     return {\"running\": bool(engine.running), \"started\": bool(started)}\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[268.481572, "o", "@api_app.post(\"/api/ticker/stop\")\r\n\u001b[?2004l\r\u001b[?2004h"]
[268.481596, "o", "> "]
[268.48162, "o", "async def api_stop() -> Dict[str, Any]:\r\n\u001b[?2004l\r"]
[268.481644, "o", "\u001b[?2004h> "]
[268.481669, "o", "    await engine.stop()\r\n\u001b[?2004l\r\u001b[?2004h> "]
[268.481709, "o", "    return {\"running\": bool(engine.running)}\r\n\u001b[?2004l\r"]
[268.48172, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
