[160.641018, "o", "> "]
[160.641081, "o", "        self.update_count = int(snap[\"update_count\"])\r\n\u001b[?2004l\r\u001b[?2004h"]
[160.641089, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h"]
[160.641108, "o", "> "]
[160.641194, "o", "    # ---------------------------------------------------------------- handlers\r\n\u001b[?2004l\r\u001b[?2004h"]
[160.641208, "o", "> "]
[160.641226, "o", "    @rx.event\r\n\u001b[?2004l\r\u001b[?2004h"]
