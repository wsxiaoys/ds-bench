[160.641296, "o", "> "]
[160.641384, "o", "        \"\"\"UI Start handler. Drives the engine idempotently and kicks off the\r\n\u001b[?2004l\r\u001b[?2004h"]
[160.641398, "o", "> "]
[160.64147, "o", "        background event handler that mirrors ticks into State.\"\"\"\r\n\u001b[?2004l\r\u001b[?2004h"]
[160.641483, "o", "> "]
[160.64151, "o", "        async with self:\r\n\u001b[?2004l\r\u001b[?2004h"]
[160.641523, "o", "> "]
[160.641609, "o", "            # Flip a backend-only flag so the background handler can no-op\r\n\u001b[?2004l\r"]
[160.641623, "o", "\u001b[?2004h> "]
[160.641681, "o", "            # if a previous loop is still running.\r\n\u001b[?2004l\r\u001b[?2004h"]
[160.641695, "o", "> "]
[160.641732, "o", "            if self._loop_active:\r\n\u001b[?2004l\r\u001b[?2004h"]
[160.641745, "o", "> "]
[160.6418, "o", "                self._pull_snapshot_into_state()\r\n\u001b[?2004l\r\u001b[?2004h"]
[160.641809, "o", "> "]
[160.641838, "o", "                return\r\n\u001b[?2004l\r\u001b[?2004h"]
[160.641846, "o", "> "]
[160.641893, "o", "            self._loop_active = True\r\n\u001b[?2004l\r\u001b[?2004h"]
[160.641908, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[160.641984, "o", "        # Ask the engine to start (it is itself idempotent).\r\n\u001b[?2004l\r\u001b[?2004h"]
[160.641998, "o", "> "]
[160.642027, "o", "        await engine.start()\r\n\u001b[?2004l\r\u001b[?2004h"]
