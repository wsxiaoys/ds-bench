[160.642501, "o", "> "]
[160.642526, "o", "    async def stop(self) -> None:\r\n\u001b[?2004l\r\u001b[?2004h"]
[160.64254, "o", "> "]
[160.642555, "o", "        \"\"\"UI Stop handler.\"\"\"\r\n\u001b[?2004l\r\u001b[?2004h"]
[160.64257, "o", "> "]
[160.642586, "o", "        await engine.stop()\r\n\u001b[?2004l\r\u001b[?2004h> "]
[160.642615, "o", "        async with self:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[160.642644, "o", "            self._loop_active = False\r\n\u001b[?2004l\r\u001b[?2004h> "]
[160.64268, "o", "            self._pull_snapshot_into_state()\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[160.642693, "o", "\u001b[?2004h> "]
[160.642715, "o", "    @rx.event(background=True)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[160.642751, "o", "    async def background_update(self) -> None:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[160.642806, "o", "        \"\"\"Long-running background handler that mirrors the engine's ticks\r\n\u001b[?2004l\r\u001b[?2004h> "]
[160.642859, "o", "        into the Reflex State. Owns the idempotency guard `_loop_active`.\r\n\u001b[?2004l\r\u001b[?2004h"]
[160.642874, "o", ">         \"\"\"\r\n\u001b[?2004l\r"]
[160.642887, "o", "\u001b[?2004h> "]
[160.642904, "o", "        async with self:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[160.642932, "o", "            if self._loop_active:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[160.642979, "o", "                # Another mirror is already running. Yield to it.\r\n\u001b[?2004l\r\u001b[?2004h> "]
[160.643001, "o", "                return\r\n\u001b[?2004l\r\u001b[?2004h"]
[160.643017, "o", "> "]
[160.643035, "o", "            self._loop_active = True\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[160.643048, "o", "\u001b[?2004h> "]
[160.643062, "o", "        try:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[160.643113, "o", "            # Run as long as the engine is running. We re-check the engine\r\n\u001b[?2004l\r\u001b[?2004h> "]
[160.643166, "o", "            # status every iteration so that a stop issued via REST also\r\n\u001b[?2004l\r\u001b[?2004h> "]
[160.643201, "o", "            # causes this loop to exit.\r\n\u001b[?2004l\r"]
[160.643215, "o", "\u001b[?2004h> "]
[160.643233, "o", "            while True:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[160.643275, "o", "                await asyncio.sleep(engine.TICK_SECONDS)\r\n\u001b[?2004l\r\u001b[?2004h"]
[160.643289, "o", "> "]
[160.643312, "o", "                snap = engine.snapshot()\r\n\u001b[?2004l\r\u001b[?2004h> "]
[160.643341, "o", "                async with self:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[160.643378, "o", "                    self.prices = snap[\"prices\"]\r\n\u001b[?2004l\r\u001b[?2004h> "]
[160.643427, "o", "                    self.update_count = int(snap[\"update_count\"])\r\n\u001b[?2004l\r\u001b[?2004h> "]
[160.64347, "o", "                    self.running = bool(snap[\"running\"])\r\n\u001b[?2004l\r\u001b[?2004h> "]
[160.643505, "o", "                if not snap[\"running\"]:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[160.643528, "o", "                    break\r\n\u001b[?2004l\r\u001b[?2004h> "]
[160.643547, "o", "        finally:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[160.643573, "o", "            async with self:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[160.643607, "o", "                self._loop_active = False\r\n\u001b[?2004l\r\u001b[?2004h> \r\n"]
[160.643622, "o", "\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[160.64363, "o", "> "]
[160.643685, "o", "# ----------------------------------------------------------------------- UI\r\n\u001b[?2004l\r\u001b[?2004h> "]
[160.643719, "o", "def _format_price(value: float) -> str:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[160.643744, "o", "    return f\"${value:,.2f}\"\r\n\u001b[?2004l\r\u001b[?2004h"]
[160.643758, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[160.643774, "o", "> "]
[160.643796, "o", "def _format_percent(value: float) -> str:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[160.643822, "o", "    return f\"{value:+.4f}%\"\r\n\u001b[?2004l\r\u001b[?2004h"]
[160.643836, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[160.643863, "o", "def index() -> rx.Component:\r\n\u001b[?2004l\r\u001b[?2004h"]
[160.643877, "o", "> "]
[160.643891, "o", "    return rx.container(\r\n\u001b[?2004l\r\u001b[?2004h> "]
[160.643909, "o", "        rx.vstack(\r\n\u001b[?2004l\r\u001b[?2004h> "]
[160.643951, "o", "            rx.heading(\"Live Stock Ticker\", size=\"7\"),\r\n\u001b[?2004l\r\u001b[?2004h> "]
[160.643986, "o", "            rx.text(\r\n\u001b[?2004l\r\u001b[?2004h> "]
[160.644012, "o", "                rx.cond(\r\n\u001b[?2004l\r\u001b[?2004h> "]
[160.644031, "o", "                    TickerState.running,\r\n\u001b[?2004l\r\u001b[?2004h> "]
[160.644087, "o", "                    rx.text(\"Status: RUNNING\", color=\"green\", weight=\"bold\"),\r\n\u001b[?2004l\r\u001b[?2004h> "]
[160.644142, "o", "                    rx.text(\"Status: STOPPED\", color=\"red\", weight=\"bold\"),\r\n\u001b[?2004l\r\u001b[?2004h> "]
[160.64416, "o", "                )\r\n\u001b[?2004l\r\u001b[?2004h> "]
[160.644177, "o", "            ),\r\n\u001b[?2004l\r\u001b[?2004h> "]
[160.644199, "o", "            rx.hstack(\r\n\u001b[?2004l\r\u001b[?2004h"]
[160.644214, "o", "> "]
[160.64427, "o", "                rx.button(\"Start\", on_click=TickerState.start, color_scheme=\"green\"),\r\n\u001b[?2004l\r\u001b[?2004h"]
[160.64428, "o", "> "]
[160.644334, "o", "                rx.button(\"Stop\", on_click=TickerState.stop, color_scheme=\"red\"),\r\n\u001b[?2004l\r\u001b[?2004h"]
[160.644343, "o", "> "]
[160.644363, "o", "                spacing=\"4\",\r\n\u001b[?2004l\r\u001b[?2004h"]
[160.644378, "o", ">             ),\r\n\u001b[?2004l\r"]
[160.644392, "o", "\u001b[?2004h> "]
[160.644407, "o", "            rx.table.root(\r\n\u001b[?2004l\r\u001b[?2004h"]
[160.644422, "o", "> "]
[160.64444, "o", "                rx.table.header(\r\n\u001b[?2004l\r\u001b[?2004h"]
[160.644455, "o", "> "]
[160.644472, "o", "                    rx.table.row(\r\n\u001b[?2004l\r"]
[160.644482, "o", "\u001b[?2004h"]
[160.644561, "o", ">                         rx.table.column_header_cell(\"Symbol\"),\r\n\u001b[?2004l\r\u001b[?2004h> "]
[160.644591, "o", "                        rx.table.column_header_cell(\"Price\"),\r\n\u001b[?2004l\r\u001b[?2004h"]
[160.644609, "o", "> "]
[160.644647, "o", "                        rx.table.column_header_cell(\"Percent Change\"),\r\n\u001b[?2004l\r\u001b[?2004h"]
[160.644657, "o", "> "]
[160.644678, "o", "                    )\r\n\u001b[?2004l\r\u001b[?2004h> "]
[160.644692, "o", "                ),\r\n\u001b[?2004l\r\u001b[?2004h> "]
[160.64472, "o", "                rx.table.body(\r\n\u001b[?2004l\r\u001b[?2004h"]
[160.644735, "o", "> "]
[160.644748, "o", "                    *[\r\n\u001b[?2004l\r\u001b[?2004h> "]
[160.644782, "o", "                        rx.table.row(\r\n\u001b[?2004l\r\u001b[?2004h> "]
[160.644834, "o", "                            rx.table.cell(rx.text(sym, weight=\"bold\")),\r\n\u001b[?2004l\r\u001b[?2004h> "]
[160.644889, "o", "                            rx.table.cell(rx.text(f\"${SEEDS[sym]:,.2f}\")),\r\n\u001b[?2004l\r\u001b[?2004h> "]
[160.644924, "o", "                            rx.table.cell(\r\n\u001b[?2004l\r\u001b[?2004h"]
[160.644939, "o", "> "]
[160.644959, "o", "                                rx.text(\r\n\u001b[?2004l\r\u001b[?2004h> "]
[160.644997, "o", "                                    rx.cond(\r\n\u001b[?2004l\r\u001b[?2004h> "]
[160.645058, "o", "                                        TickerState.prices[sym] != None,  # noqa: E711\r\n\u001b[?2004l\r\u001b[?2004h> "]
[160.645121, "o", "                                        f\"{TickerState.prices[sym] if False else 0}\",\r\n\u001b[?2004l\r\u001b[?2004h> "]
[160.645157, "o", "                                        \"0\",\r\n\u001b[?2004l\r\u001b[?2004h"]
[160.645172, "o", "> "]
[160.64519, "o", "                                    )\r\n\u001b[?2004l\r\u001b[?2004h"]
[160.645199, "o", "> "]
[160.645228, "o", "                                )\r\n\u001b[?2004l\r\u001b[?2004h"]
[160.645243, "o", "> "]
[160.645257, "o", "                            ),\r\n\u001b[?2004l\r"]
[160.645272, "o", "\u001b[?2004h> "]
[160.645288, "o", "                        )\r\n\u001b[?2004l\r\u001b[?2004h> "]
[160.645328, "o", "                        for sym in SYMBOLS\r\n\u001b[?2004l\r\u001b[?2004h> "]
[160.645349, "o", "                    ]\r\n\u001b[?2004l\r\u001b[?2004h"]
[160.645363, "o", "> "]
[160.645378, "o", "                ),\r\n\u001b[?2004l\r\u001b[?2004h> "]
[160.645392, "o", "            ),\r\n\u001b[?2004l\r\u001b[?2004h> "]
[160.645415, "o", "            spacing=\"4\",\r\n\u001b[?2004l\r\u001b[?2004h> "]
[160.645442, "o", "            padding=\"2em\",\r\n\u001b[?2004l\r\u001b[?2004h"]
[160.645456, "o", ">         )\r\n\u001b[?2004l\r\u001b[?2004h> "]
[160.64547, "o", "    )\r\n\u001b[?2004l\r\u001b[?2004h> "]
[160.645484, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[160.645499, "o", "> "]
[160.645544, "o", "# ----------------------------------------------------------------------- API\r\n\u001b[?2004l\r\u001b[?2004h"]
[160.645558, "o", "> "]
[160.645589, "o", "api_app = fastapi.FastAPI(title=\"Ticker REST API\")\r\n\u001b[?2004l\r"]
[160.645604, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[160.645617, "o", "\u001b[?2004h> "]
[160.645645, "o", "@api_app.post(\"/api/ticker/start\")\r\n\u001b[?2004l\r\u001b[?2004h"]
[160.645658, "o", "> "]
[160.645681, "o", "async def api_start() -> Dict[str, Any]:\r\n\u001b[?2004l\r\u001b[?2004h"]
[160.645695, "o", "> "]
[160.645715, "o", "    started = await engine.start()\r\n\u001b[?2004l\r\u001b[?2004h"]
[160.64573, "o", "> "]
[160.645764, "o", "    return {\"running\": engine.running, \"started\": started}\r\n\u001b[?2004l\r\u001b[?2004h"]
[160.645779, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[160.645793, "o", "\u001b[?2004h> "]
[160.645813, "o", "@api_app.post(\"/api/ticker/stop\")\r\n\u001b[?2004l\r"]
[160.645829, "o", "\u001b[?2004h> "]
[160.645849, "o", "async def api_stop() -> Dict[str, Any]:\r\n\u001b[?2004l\r\u001b[?2004h"]
[160.645864, "o", "> "]
[160.645877, "o", "    await engine.stop()\r\n\u001b[?2004l\r\u001b[?2004h> "]
[160.645912, "o", "    return {\"running\": engine.running}\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[160.645926, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[160.645959, "o", "@api_app.get(\"/api/ticker/snapshot\")\r\n\u001b[?2004l\r\u001b[?2004h"]
[160.645973, "o", "> "]
[160.645998, "o", "async def api_snapshot() -> Dict[str, Any]:\r\n\u001b[?2004l\r"]
[160.646012, "o", "\u001b[?2004h> "]
[160.646027, "o", "    return engine.snapshot()\r\n\u001b[?2004l\r\u001b[?2004h"]
[160.646043, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[160.646056, "o", "\u001b[?2004h> "]
[160.646116, "o", "# ----------------------------------------------------------------------- app\r\n\u001b[?2004l\r"]
[160.646132, "o", "\u001b[?2004h> "]
[160.646164, "o", "app = rx.App(api_transformer=api_app)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[160.646182, "o", "app.add_page(index)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[160.646196, "o", "PYEOF\r\n\u001b[?2004l\r"]
[160.647039, "o", "\u001b[?2004hroot@07c691a2-6b06-40da-895f-5897ed04fc25:/home/user/ticker_app# "]
[160.967094, "i", "ls -la ticker_app/\n"]
[160.967306, "o", "ls -la ticker_app/\r\n\u001b[?2004l\r"]
[160.968243, "o", "total 20\r\ndrwxr-xr-x 2 root root   63 Jul  3 12:48 \u001b[0m\u001b[01;34m.\u001b[0m\r\ndrwxr-xr-x 9 root root 4096 Jul  3 12:47 \u001b[01;34m..\u001b[0m\r\n-rw-r--r-- 1 root root    0 Jul  3 12:47 __init__.py\r\n-rw-r--r-- 1 root root 5209 Jul  3 12:48 engine.py\r\n-rw-r--r-- 1 root root 7141 Jul  3 12:48 ticker_app.py\r\n"]
[160.968358, "o", "\u001b[?2004hroot@07c691a2-6b06-40da-895f-5897ed04fc25:/home/user/ticker_app# "]
[172.746518, "i", "uv run python -c \"from ticker_app import engine; print(engine.snapshot())\"\n"]
[172.746751, "o", "uv run python -c \"from ticker_app import engine; print(engine.snapshot())\"\r\n\u001b[?2004l\r"]
[172.810896, "o", "Traceback (most recent call last):\r\n  File \"<string>\", line 1, in <module>\r\nAttributeError: module 'ticker_app.engine' has no attribute 'snapshot'\r\n"]
[172.81875, "o", "\u001b[?2004hroot@07c691a2-6b06-40da-895f-5897ed04fc25:/home/user/ticker_app# "]
[180.836328, "i", "cat ticker_app/engine.py | head -40\n"]
[180.83676, "o", "cat ticker_app/engine.py | head -40\r\n\u001b[?2004l\r"]
[180.837597, "o", "\"\"\"In-memory price-book engine shared between Reflex State and REST API.\r\n\r\nThe engine owns:\r\n- The deterministic seed prices for the symbol universe.\r\n- The current prices for each symbol.\r\n- A counter of completed 500 ms ticks since the most recent start.\r\n- A running flag.\r\n\r\nThe Reflex UI Start/Stop event handlers and the FastAPI endpoints both call\r\ninto this single engine, so the state observed by the REST surface and the\r\nstate observed by the browser are guaranteed to agree.\r\n\"\"\"\r\n\r\nfrom __future__ import annotations\r\n\r\nimport asyncio\r\nimport random\r\nfrom typing import Awaitable, Callable, Dict, Optional\r\n\r\n\r\nSEEDS: Dict[str, float] = {\r\n    \"AAPL\": 150.00,\r\n    \"GOOG\": 2800.00,\r\n    \"MSFT\": 300.00,\r\n    \"AMZN\": 3300.00,\r\n    \"TSLA\": 700.00,\r\n}\r\n\r\nSYMBOLS = tuple(SEEDS.keys())\r\n\r\n\r\nclass TickerEngine:\r\n    \"\"\"A tiny in-memory ticker engine with an asyncio background task.\"\"\"\r\n\r\n    TICK_SECONDS = 0.5\r\n    MAX_DELTA_FRACTION = 0.005  # +/- 0.5% per tick\r\n    MIN_PRICE = 0.01\r\n\r\n    def __init__(self) -> None:\r\n        self._prices: Dict[str, float] = dict(SEEDS)\r\n"]
[180.83774, "o", "\u001b[?2004hroot@07c691a2-6b06-40da-895f-5897ed04fc25:/home/user/ticker_app# "]
[181.271828, "i", "uv run python -c \"from ticker_app.engine import engine; print(engine.snapshot())\"\n"]
[181.272158, "o", "uv run python -c \"from ticker_app.engine import engine; print(engine.snapshot())\"\r\n\u001b[?2004l\r"]
[181.336137, "o", "{'running': False, 'update_count': 0, 'seeds': {'AAPL': 150.0, 'GOOG': 2800.0, 'MSFT': 300.0, 'AMZN': 3300.0, 'TSLA': 700.0}, 'prices': {'AAPL': 150.0, 'GOOG': 2800.0, 'MSFT': 300.0, 'AMZN': 3300.0, 'TSLA': 700.0}, 'percent_changes': {'AAPL': 0.0, 'GOOG': 0.0, 'MSFT': 0.0, 'AMZN': 0.0, 'TSLA': 0.0}}\r\n"]
[181.343541, "o", "\u001b[?2004hroot@07c691a2-6b06-40da-895f-5897ed04fc25:/home/user/ticker_app# "]
[190.077097, "i", "uv run python -c \"from ticker_app.ticker_app import app, TickerState, api_app; print('OK')\"\n"]
[190.077449, "o", "uv run python -c \"from ticker_app.ticker_app import app, TickerState, api_app; print('OK')\"\r\n\u001b[?2004l\r"]
