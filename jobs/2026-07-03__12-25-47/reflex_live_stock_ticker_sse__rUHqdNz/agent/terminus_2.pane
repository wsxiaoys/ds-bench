[?2004l[?2004h> """Reflex stock-ticker dashboard.
[?2004l[?2004h> 
[?2004l[?2004h> This module wires together:
[?2004l[?2004h> - A `TickerState` that exposes the live price book to the browser.
[?2004l[?2004h> - A long-running `@rx.event(background=True)` handler that mirrors the
[?2004l[?2004h>   shared engine's ticks into the Reflex state every 500 ms.
[?2004l[?2004h> - A `percent_change` cached computed var.
[?2004l[?2004h> - A FastAPI sub-app (mounted via `api_transformer`) that exposes the
[?2004l[?2004h>   headless REST surface used by the verifier.
[?2004l[?2004h> """
[?2004l[?2004h> 
[?2004l[?2004h> from __future__ import annotations
[?2004l[?2004h> 
[?2004l[?2004h> import asyncio
[?2004l[?2004h> from typing import Any, Dict
[?2004l[?2004h> 
[?2004l[?2004h> import fastapi
[?2004l[?2004h> import reflex as rx
[?2004l[?2004h> 
[?2004l[?2004h> from .engine import SEEDS, SYMBOLS, engine
[?2004l[?2004h> 
[?2004l[?2004h> 
[?2004l[?2004h> # ----------------------------------------------------------------------- state
[?2004l[?2004h> class TickerState(rx.State):
[?2004l[?2004h>     """Live state for the stock-ticker page."""
[?2004l[?2004h> 
[?2004l[?2004h>     # Plain serializable base vars (visible to the UI).
[?2004l[?2004h>     prices: Dict[str, float] = dict(SEEDS)
[?2004l[?2004h>     seeds: Dict[str, float] = dict(SEEDS)
[?2004l[?2004h>     running: bool = False
[?2004l[?2004h>     update_count: int = 0
[?2004l[?2004h> 
[?2004l[?2004h>     # Backend-only vars (underscore-prefixed, not serialized to the client).
[?2004l[?2004h>     _loop_active: bool = False
[?2004l[?2004h> 
[?2004l[?2004h>     # ---------------------------------------------------------------- computed
[?2004l[?2004h>     @rx.var(cache=True)
[?2004l[?2004h>     def percent_change(self) -> Dict[str, float]:
[?2004l[?2004h>         """Per-symbol percent change vs. seed, rounded to 4 decimal places."""
[?2004l[?2004h>         prices = self.prices
[?2004l[?2004h>         seeds = self.seeds
[?2004l[?2004h>         result: Dict[str, float] = {}
[?2004l[?2004h>         for sym in SYMBOLS:
[?2004l[?2004h>             seed = seeds.get(sym, SEEDS[sym])
[?2004l[?2004h>             current = prices.get(sym, seed)
[?2004l[?2004h>             if seed == 0:
[?2004l[?2004h>                 result[sym] = 0.0
[?2004l[?2004h>             else:
[?2004l[?2004h>                 result[sym] = round((current - seed) / seed * 100.0, 4)
[?2004l[?2004h>         return result
[?2004l[?2004h> 
[?2004l[?2004h>     # ---------------------------------------------------------------- helpers
[?2004l[?2004h>     def _pull_snapshot_into_state(self) -> None:
[?2004l[?2004h>         """Copy the engine's current snapshot into the (non-background) base vars."""
[?2004l[?2004h>         snap = engine.snapshot()
[?2004l[?2004h>         self.prices = snap["prices"]
[?2004l[?2004h>         self.seeds = snap["seeds"]
[?2004l[?2004h>         self.running = bool(snap["running"])
[?2004l[?2004h>         self.update_count = int(snap["update_count"])
[?2004l[?2004h> 
[?2004l[?2004h>     # ---------------------------------------------------------------- handlers
[?2004l[?2004h>     @rx.event
[?2004l[?2004h>     async def start(self) -> Any:
[?2004l[?2004h>         """UI Start handler. Drives the engine idempotently and kicks off the
[?2004l[?2004h>         background event handler that mirrors ticks into State."""
[?2004l[?2004h>         async with self:
[?2004l[?2004h>             # Flip a backend-only flag so the background handler can no-op
[?2004l[?2004h>             # if a previous loop is still running.
[?2004l[?2004h>             if self._loop_active:
[?2004l[?2004h>                 self._pull_snapshot_into_state()
[?2004l[?2004h>                 return
[?2004l[?2004h>             self._loop_active = True
[?2004l[?2004h> 
[?2004l[?2004h>         # Ask the engine to start (it is itself idempotent).
[?2004l[?2004h>         await engine.start()
[?2004l[?2004h> 
[?2004l[?2004h>         # Make sure the UI sees the freshly-started engine state.
[?2004l[?2004h>         async with self:
[?2004l[?2004h>             self._pull_snapshot_into_state()
[?2004l[?2004h> 
[?2004l[?2004h>         # Kick off the background mirror. The background handler itself
[?2004l[?2004h>         # owns the idempotency guard around _loop_active.
[?2004l[?2004h>         return TickerState.background_update
[?2004l[?2004h> 
[?2004l[?2004h>     @rx.event
[?2004l[?2004h>     async def stop(self) -> None:
[?2004l[?2004h>         """UI Stop handler."""
[?2004l[?2004h>         await engine.stop()
[?2004l[?2004h>         async with self:
[?2004l[?2004h>             self._loop_active = False
[?2004l[?2004h>             self._pull_snapshot_into_state()
[?2004l[?2004h> 
[?2004l[?2004h>     @rx.event(background=True)
[?2004l[?2004h>     async def background_update(self) -> None:
[?2004l[?2004h>         """Long-running background handler that mirrors the engine's ticks
[?2004l[?2004h>         into the Reflex State. Owns the idempotency guard `_loop_active`.
[?2004l[?2004h>         """
[?2004l[?2004h>         async with self:
[?2004l[?2004h>             if self._loop_active:
[?2004l[?2004h>                 # Another mirror is already running. Yield to it.
[?2004l[?2004h>                 return
[?2004l[?2004h>             self._loop_active = True
[?2004l[?2004h> 
[?2004l[?2004h>         try:
[?2004l[?2004h>             # Run as long as the engine is running. We re-check the engine
[?2004l[?2004h>             # status every iteration so that a stop issued via REST also
[?2004l[?2004h>             # causes this loop to exit.
[?2004l[?2004h>             while True:
[?2004l[?2004h>                 await asyncio.sleep(engine.TICK_SECONDS)
[?2004l[?2004h>                 snap = engine.snapshot()
[?2004l[?2004h>                 async with self:
[?2004l[?2004h>                     self.prices = snap["prices"]
[?2004l[?2004h>                     self.update_count = int(snap["update_count"])
[?2004l[?2004h>                     self.running = bool(snap["running"])
[?2004l[?2004h>                 if not snap["running"]:
[?2004l[?2004h>                     break
[?2004l[?2004h>         finally:
[?2004l[?2004h>             async with self:
[?2004l[?2004h>                 self._loop_active = False
[?2004l[?2004h> 
[?2004l[?2004h> 
[?2004l[?2004h> # ----------------------------------------------------------------------- UI
[?2004l[?2004h> def _format_price(value: float) -> str:
[?2004l[?2004h>     return f"${value:,.2f}"
[?2004l[?2004h> 
[?2004l[?2004h> 
[?2004l[?2004h> def _format_percent(value: float) -> str:
[?2004l[?2004h>     return f"{value:+.4f}%"
[?2004l[?2004h> 
[?2004l[?2004h> 
[?2004l[?2004h> def index() -> rx.Component:
[?2004l[?2004h>     return rx.container(
[?2004l[?2004h>         rx.vstack(
[?2004l[?2004h>             rx.heading("Live Stock Ticker", size="7"),
[?2004l[?2004h>             rx.text(
[?2004l[?2004h>                 rx.cond(
[?2004l[?2004h>                     TickerState.running,
[?2004l[?2004h>                     rx.text("Status: RUNNING", color="green", weight="bold"),
[?2004l[?2004h>                     rx.text("Status: STOPPED", color="red", weight="bold"),
[?2004l[?2004h>                 )
[?2004l[?2004h>             ),
[?2004l[?2004h>             rx.hstack(
[?2004l[?2004h>                 rx.button("Start", on_click=TickerState.start, color_scheme="green"),
[?2004l[?2004h>                 rx.button("Stop", on_click=TickerState.stop, color_scheme="red"),
[?2004l[?2004h>                 spacing="4",
[?2004l[?2004h>             ),
[?2004l[?2004h>             rx.table.root(
[?2004l[?2004h>                 rx.table.header(
[?2004l[?2004h>                     rx.table.row(
[?2004l[?2004h>                         rx.table.column_header_cell("Symbol"),
[?2004l[?2004h>                         rx.table.column_header_cell("Price"),
[?2004l[?2004h>                         rx.table.column_header_cell("Percent Change"),
[?2004l[?2004h>                     )
[?2004l[?2004h>                 ),
[?2004l[?2004h>                 rx.table.body(
[?2004l[?2004h>                     *[
[?2004l[?2004h>                         rx.table.row(
[?2004l[?2004h>                             rx.table.cell(rx.text(sym, weight="bold")),
[?2004l[?2004h>                             rx.table.cell(rx.text(f"${SEEDS[sym]:,.2f}")),
[?2004l[?2004h>                             rx.table.cell(
[?2004l[?2004h>                                 rx.text(
[?2004l[?2004h>                                     rx.cond(
[?2004l[?2004h>                                         TickerState.prices[sym] != None,  # noqa: E711
[?2004l[?2004h>                                         f"{TickerState.prices[sym] if False else 0}",
[?2004l[?2004h>                                         "0",
[?2004l[?2004h>                                     )
[?2004l[?2004h>                                 )
[?2004l[?2004h>                             ),
[?2004l[?2004h>                         )
[?2004l[?2004h>                         for sym in SYMBOLS
[?2004l[?2004h>                     ]
[?2004l[?2004h>                 ),
[?2004l[?2004h>             ),
[?2004l[?2004h>             spacing="4",
[?2004l[?2004h>             padding="2em",
[?2004l[?2004h>         )
[?2004l[?2004h>     )
[?2004l[?2004h> 
[?2004l[?2004h> 
[?2004l[?2004h> # ----------------------------------------------------------------------- API
[?2004l[?2004h> api_app = fastapi.FastAPI(title="Ticker REST API")
[?2004l[?2004h> 
[?2004l[?2004h> 
[?2004l[?2004h> @api_app.post("/api/ticker/start")
[?2004l[?2004h> async def api_start() -> Dict[str, Any]:
[?2004l[?2004h>     started = await engine.start()
[?2004l[?2004h>     return {"running": engine.running, "started": started}
[?2004l[?2004h> 
[?2004l[?2004h> 
[?2004l[?2004h> @api_app.post("/api/ticker/stop")
[?2004l[?2004h> async def api_stop() -> Dict[str, Any]:
