[?2004l[?2004h>     return {"running": engine.running}
[?2004l[?2004h> 
[?2004l[?2004h> 
[?2004l[?2004h> @api_app.get("/api/ticker/snapshot")
[?2004l[?2004h> async def api_snapshot() -> Dict[str, Any]:
[?2004l[?2004h>     return engine.snapshot()
[?2004l[?2004h> 
[?2004l[?2004h> 
[?2004l[?2004h> # ----------------------------------------------------------------------- app
[?2004l[?2004h> app = rx.App(api_transformer=api_app)
