[?2004l[?2004h> """In-memory price-book engine shared between Reflex State and REST API.
[?2004l[?2004h> 
[?2004l[?2004h> The engine owns:
[?2004l[?2004h> - The deterministic seed prices for the symbol universe.
[?2004l[?2004h> - The current prices for each symbol.
[?2004l[?2004h> - A counter of completed 500 ms ticks since the most recent start.
[?2004l[?2004h> - A running flag.
[?2004l[?2004h> 
[?2004l[?2004h> The Reflex UI Start/Stop event handlers and the FastAPI endpoints both call
[?2004l[?2004h> into this single engine, so the state observed by the REST surface and the
[?2004l[?2004h> state observed by the browser are guaranteed to agree.
[?2004l[?2004h> """
[?2004l[?2004h> 
[?2004la[?2004h> from __future__ import annotations
[?2004l[?2004h> 
[?2004l
[?2004h> import asyncio
[?2004l[?2004h> import random
[?2004l[?2004h> from typing import Awaitable, Callable, Dict, Optional
[?2004l[?2004h> 
[?2004lo[?2004h> 
[?2004ln[?2004h> SEEDS: Dict[str, float] = {
[?2004l[?2004h>     "AAPL": 150.00,
[?2004l[?2004h>     "GOOG": 2800.00,
[?2004l[?2004h>     "MSFT": 300.00,
[?2004l[?2004h>     "AMZN": 3300.00,
[?2004l[?2004h>     "TSLA": 700.00,
[?2004l[?2004h> }
[?2004l[?2004h> 
[?2004l[?2004h> SYMBOLS = tuple(SEEDS.keys())
[?2004l[?2004h> 
[?2004l[?2004h> 
[?2004l[?2004h> class TickerEngine:
[?2004l[?2004h>     """A tiny in-memory ticker engine with an asyncio background task."""
[?2004l[?2004h> 
[?2004l[?2004h>     TICK_SECONDS = 0.5
[?2004l[?2004h>     MAX_DELTA_FRACTION = 0.005  # +/- 0.5% per tick
[?2004l[?2004h>     MIN_PRICE = 0.01
[?2004l[?2004h> 
[?2004l [?2004h>     def __init__(self) -> None:
[?2004l[?2004h>         self._prices: Dict[str, float] = dict(SEEDS)
[?2004l[?2004h>         self._seeds: Dict[str, float] = dict(SEEDS)
[?2004l[?2004h>         self._running: bool = False
[?2004l[?2004h>         self._update_count: int = 0
[?2004l[?2004h>         self._task: Optional[asyncio.Task] = None
[?2004l[?2004h>         self._lock = asyncio.Lock()
[?2004l[?2004h>         # Fixed seed so the executor's randomness is deterministic.
[?2004l[?2004h>         self._rng = random.Random(20240101)
[?2004l[?2004h>         # Optional listener (used by the Reflex UI to mirror ticks into State).
[?2004l[?2004h>         self._listener: Optional[Callable[[Dict[str, float], int], Awaitable[None] | None]] = None
[?2004l[?2004h> 
[?2004l[?2004h>     # ------------------------------------------------------------------ access
[?2004l[?2004h>     def set_listener(
[?2004l[?2004h>         self,
[?2004l[?2004h>         listener: Optional[Callable[[Dict[str, float], int], Awaitable[None] | None]],
[?2004l[?2004h>     ) -> None:
[?2004l[?2004h>         """Register a coroutine to receive a copy of every tick."""
[?2004l[?2004h>         self._listener = listener
[?2004l[?2004h> 
[?2004l[?2004h>     @property
[?2004l[?2004h>     def seeds(self) -> Dict[str, float]:
[?2004l[?2004h>         return dict(self._seeds)
[?2004l[?2004h> 
[?2004l[?2004h>     @property
[?2004l[?2004h>     def running(self) -> bool:
[?2004l[?2004h>         return self._running
[?2004l[?2004h> 
[?2004l[?2004h>     @property
[?2004l[?2004h>     def update_count(self) -> int:
[?2004l[?2004h>         return self._update_count
[?2004l[?2004h> 
[?2004l[?2004h>     def snapshot(self) -> Dict[str, object]:
[?2004l[?2004h>         """Return a JSON-serializable view of the current engine state."""
[?2004l[?2004h>         prices = {sym: float(self._prices[sym]) for sym in SYMBOLS}
[?2004l[?2004h>         seeds = {sym: float(self._seeds[sym]) for sym in SYMBOLS}
[?2004l[?2004h>         percent_changes = {
[?2004l[?2004h>             sym: round((prices[sym] - seeds[sym]) / seeds[sym] * 100.0, 4)
[?2004l[?2004h>             for sym in SYMBOLS
[?2004l[?2004h>         }
[?2004l[?2004h>         return {
[?2004l[?2004h>             "running": bool(self._running),
[?2004l[?2004h>             "update_count": int(self._update_count),
[?2004l[?2004h>             "seeds": seeds,
[?2004l[?2004h>             "prices": prices,
[?2004l[?2004h>             "percent_changes": percent_changes,
[?2004l[?2004h>         }
[?2004l[?2004h> 
[?2004l[?2004h>     # ---------------------------------------------------------------- mutation
[?2004l[?2004h>     def reset_prices(self) -> None:
[?2004l[?2004h>         """Reset prices back to seeds and zero the update count."""
[?2004l[?2004h>         self._prices = dict(self._seeds)
[?2004l[?2004h>         self._update_count = 0
[?2004l[?2004h> 
[?2004l[?2004h>     def tick_once(self) -> Dict[str, float]:
[?2004l[?2004h>         """Apply one bounded random walk step and return the new prices."""
[?2004l[?2004h>         for sym in SYMBOLS:
[?2004l[?2004h>             current = self._prices[sym]
[?2004l[?2004h>             delta_pct = self._rng.uniform(-self.MAX_DELTA_FRACTION, self.MAX_DELTA_FRACTION)
[?2004l[?2004h>             new_price = current * (1.0 + delta_pct)
[?2004l[?2004h>             if new_price < self.MIN_PRICE:
[?2004l[?2004h>                 new_price = self.MIN_PRICE
[?2004l[?2004h>             self._prices[sym] = float(new_price)
[?2004l[?2004h>         self._update_count += 1
[?2004l[?2004h>         return dict(self._prices)
[?2004l[?2004h> 
[?2004l[?2004h>     # ---------------------------------------------------------------- control
[?2004l[?2004h>     async def start(self) -> bool:
[?2004l[?2004h>         """Start the background loop idempotently. Returns True if a new loop was started."""
[?2004l[?2004h>         async with self._lock:
[?2004l[?2004h>             if self._running and self._task is not None and not self._task.done():
[?2004l[?2004h>                 return False
[?2004l[?2004h>             self._running = True
[?2004l[?2004h>             self.reset_prices()
[?2004l[?2004h>             self._task = asyncio.create_task(self._run())
[?2004l[?2004h>             return True
[?2004l[?2004h> 
[?2004l[?2004h>     async def stop(self) -> None:
[?2004l[?2004h>         """Stop the background loop if running."""
