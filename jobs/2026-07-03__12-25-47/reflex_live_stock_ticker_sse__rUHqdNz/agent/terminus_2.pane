[?2004l[?2004h>             except (asyncio.CancelledError, Exception):
[?2004l[?2004h>                 pass
[?2004l[?2004h> 
[?2004l[?2004h>     async def _run(self) -> None:
[?2004l[?2004h>         """The long-running tick loop."""
[?2004l[?2004h>         try:
[?2004l[?2004h>             while True:
[?2004l[?2004h>                 await asyncio.sleep(self.TICK_SECONDS)
[?2004l[?2004h>                 prices = self.tick_once()
