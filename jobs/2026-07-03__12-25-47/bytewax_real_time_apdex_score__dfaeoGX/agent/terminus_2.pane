[?2004l[?2004h>             return 0.0
[?2004l[?2004h>         score = (self.satisfied + self.tolerating / 2.0) / total
[?2004l[?2004h>         # Round to 2 decimal places (as required).
[?2004l[?2004h>         return round(score, 2)
[?2004l[?2004h> 
[?2004l[?2004h> 
