[?2004l[?2004h> def build_dataflow() -> Dataflow:
[?2004l[?2004h>     flow = Dataflow("apdex")
[?2004l[?2004h> 
[?2004l[?2004h>     # 1. Load all input events as a list and feed them through a
[?2004l[?2004h>     #    ``TestingSource``. ``TestingSource`` is the most straightforward
[?2004l[?2004h>     #    way to drive a finite, in-memory dataset through a Bytewax
