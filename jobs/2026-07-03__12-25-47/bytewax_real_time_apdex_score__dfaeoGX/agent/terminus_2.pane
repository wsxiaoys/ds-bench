[?2004l[?2004h> #!/usr/bin/env python3
[?2004l[?2004h> """Real-time Apdex score calculation with Bytewax.
[?2004l[?2004h> 
[?2004l[?2004h> Reads JSON line events from ``input.jsonl``, groups them in 10-second
[?2004l[?2004h> tumbling windows per ``service`` using the event timestamp, and writes
[?2004l[?2004h> the calculated Apdex score to ``output.jsonl``.
[?2004l[?2004h> 
[?2004l[?2004h> Each output line contains:
[?2004l[?2004h>   - ``window_start`` (ISO 8601 string, UTC)
[?2004l[?2004h>   - ``service``       (string)
[?2004l[?2004h>   - ``apdex_score``    (float, rounded to 2 decimal places)
[?2004l[?2004h> """
[?2004l[?2004h> 
[?2004l[?2004h> import json
[?2004l[?2004h> import os
[?2004l[?2004h> from datetime import datetime, timedelta, timezone
[?2004l[?2004h> from typing import List, Tuple
[?2004l[?2004h> 
[?2004l[?2004h> from bytewax.dataflow import Dataflow
[?2004l[?2004h> import bytewax.operators as op
[?2004l[?2004h> from bytewax.operators.windowing import (
[?2004l[?2004h>     EventClock,
[?2004l[?2004h>     TumblingWindower,
[?2004l[?2004h>     fold_window,
[?2004l[?2004h> )
[?2004l[?2004h> from bytewax.testing import TestingSource, run_main
[?2004l[?2004h> from bytewax.outputs import DynamicSink, StatelessSinkPartition
[?2004l[?2004h> 
[?2004l[?2004h> 
[?2004l[?2004h> # -----------------------------------------------------------------------
[?2004l[?2004h> # Constants
[?2004l[?2004h> # -----------------------------------------------------------------------
[?2004l[?2004h> 
[?2004l[?2004h> APDEX_SATISFIED_MAX = 500          # response_time_ms <= 500 -> satisfied
[?2004l[?2004h> APDEX_TOLERATING_MAX = 2000        # 500 < x <= 2000 -> tolerating
[?2004l[?2004h> # anything strictly greater than 2000 -> frustrated.
[?2004l[?2004h> 
[?2004l[?2004h> INPUT_PATH = "input.jsonl"
[?2004l[?2004h> OUTPUT_PATH = "output.jsonl"
[?2004l[?2004h> WINDOW_LENGTH = timedelta(seconds=10)
[?2004l[?2004h> 
[?2004l[?2004h> 
[?2004l[?2004h> # -----------------------------------------------------------------------
[?2004l[?2004h> # Input loading
[?2004l[?2004h> # -----------------------------------------------------------------------
[?2004l[?2004h> 
[?2004l[?2004h> def _parse_timestamp(value: str) -> datetime:
[?2004l[?2004h>     ts = datetime.fromisoformat(value.replace("Z", "+00:00"))
[?2004l[?2004h>     if ts.tzinfo is None:
[?2004l[?2004h>         ts = ts.replace(tzinfo=timezone.utc)
[?2004l[?2004h>     else:
[?2004l[?2004h>         ts = ts.astimezone(timezone.utc)
[?2004l[?2004h>     return ts
[?2004l[?2004h> 
[?2004l[?2004h> 
[?2004l[?2004h> def load_input_events(path: str) -> List[Tuple[str, int, datetime]]:
[?2004l[?2004h>     events: List[Tuple[str, int, datetime]] = []
[?2004l[?2004h>     if not os.path.exists(path):
[?2004l[?2004h>         return events
[?2004l[?2004h>     with open(path, "r", encoding="utf-8") as fh:
[?2004l[?2004h>         for raw in fh:
[?2004l[?2004h>             raw = raw.strip()
[?2004l[?2004h>             if not raw:
[?2004l[?2004h>                 continue
[?2004l[?2004h>             record = json.loads(raw)
[?2004l[?2004h>             ts = _parse_timestamp(record["timestamp"])
[?2004l[?2004h>             events.append(
[?2004l[?2004h>                 (record["service"], int(record["response_time_ms"]), ts)
[?2004l[?2004h>             )
[?2004l[?2004h>     return events
[?2004l[?2004h> 
[?2004l[?2004h> 
[?2004l[?2004h> # -----------------------------------------------------------------------
[?2004l[?2004h> # Window-state / Apdex accumulator
[?2004l[?2004h> # -----------------------------------------------------------------------
[?2004l[?2004h> 
[?2004l[?2004h> class ApdexAccumulator:
[?2004l[?2004h>     """A per-window tally of satisfied/tolerating/frustrated counts."""
[?2004l[?2004h> 
[?2004l[?2004h>     __slots__ = ("satisfied", "tolerating", "frustrated")
[?2004l[?2004h> 
[?2004l[?2004h>     def __init__(self) -> None:
[?2004l[?2004h>         self.satisfied: int = 0
[?2004l[?2004h>         self.tolerating: int = 0
[?2004l[?2004h>         self.frustrated: int = 0
[?2004l[?2004h> 
[?2004l[?2004h>     def add(self, response_time_ms: int) -> "ApdexAccumulator":
[?2004l[?2004h>         if response_time_ms <= APDEX_SATISFIED_MAX:
[?2004l[?2004h>             self.satisfied += 1
[?2004l[?2004h>         elif response_time_ms <= APDEX_TOLERATING_MAX:
[?2004l[?2004h>             self.tolerating += 1
[?2004l[?2004h>         else:
[?2004l[?2004h>             self.frustrated += 1
[?2004l[?2004h>         return self
[?2004l[?2004h> 
[?2004l[?2004h>     def merge(self, other: "ApdexAccumulator") -> "ApdexAccumulator":
[?2004l[?2004h>         self.satisfied += other.satisfied
[?2004l[?2004h>         self.tolerating += other.tolerating
[?2004l[?2004h>         self.frustrated += other.frustrated
[?2004l[?2004h>         return self
[?2004l[?2004h> 
[?2004l[?2004h>     def apdex(self) -> float:
[?2004l[?2004h>         total = self.satisfied + self.tolerating + self.frustrated
[?2004l[?2004h>         if total == 0:
[?2004l[?2004h>             return 0.0
[?2004l[?2004h>         score = (self.satisfied + self.tolerating / 2.0) / total
[?2004l[?2004h>         return round(score, 2)
[?2004l[?2004h> 
[?2004l[?2004h> 
[?2004l[?2004h> def builder() -> ApdexAccumulator:
[?2004l[?2004h>     return ApdexAccumulator()
[?2004l[?2004h> 
[?2004l[?2004h> 
[?2004l[?2004h> def folder(acc: ApdexAccumulator, value) -> ApdexAccumulator:
[?2004l[?2004h>     # ``value`` comes from the keyed upstream stream and is the original
[?2004l[?2004h>     # 3-tuple ``(service, response_time_ms, ts)``.
[?2004l[?2004h>     return acc.add(value[1])
[?2004l[?2004h> 
[?2004l[?2004h> 
[?2004l[?2004h> def merger(a: ApdexAccumulator, b: ApdexAccumulator) -> ApdexAccumulator:
[?2004l[?2004h>     return a.merge(b)
[?2004l[?2004h> 
[?2004l[?2004h> 
[?2004l[?2004h> # -----------------------------------------------------------------------
[?2004l[?2004h> # Output sink
[?2004l[?2004h> # -----------------------------------------------------------------------
[?2004l[?2004h> 
[?2004l[?2004h> class _NoopSinkPartition(StatelessSinkPartition):
[?2004l[?2004h>     def write_batch(self, items) -> None:
[?2004l[?2004h>         return None
[?2004l[?2004h> 
[?2004l[?2004h> 
[?2004l[?2004h> class JsonlFileSinkPartition(StatelessSinkPartition):
[?2004l[?2004h>     def __init__(self, path: str) -> None:
[?2004l[?2004h>         self._path = path
[?2004l[?2004h> 
[?2004l[?2004h>     def write_batch(self, items) -> None:
[?2004l[?2004h>         with open(self._path, "a", encoding="utf-8") as fh:
[?2004l[?2004h>             for item in items:
[?2004l[?2004h>                 fh.write(json.dumps(item) + "\n")
[?2004l[?2004h> 
[?2004l[?2004h> 
[?2004l[?2004h> class JsonlFileSink(DynamicSink):
[?2004l[?2004h>     """A single-partition JSONL file sink (only worker 0 writes)."""
[?2004l[?2004h> 
[?2004l[?2004h>     def __init__(self, path: str = OUTPUT_PATH) -> None:
[?2004l[?2004h>         self._path = path
[?2004l[?2004h> 
[?2004l[?2004h>     def build(self, step_id, worker_index, worker_count):
[?2004l[?2004h>         if worker_index == 0:
[?2004l[?2004h>             return JsonlFileSinkPartition(self._path)
[?2004l[?2004h>         return _NoopSinkPartition()
[?2004l[?2004h> 
[?2004l[?2004h> 
[?2004l[?2004h> # -----------------------------------------------------------------------
[?2004l[?2004h> # Dataflow construction
[?2004l[?2004h> # -----------------------------------------------------------------------
[?2004l[?2004h> 
[?2004l[?2004h> def build_dataflow() -> Dataflow:
[?2004l[?2004h>     flow = Dataflow("apdex")
[?2004l[?2004h> 
[?2004l[?2004h>     # 1. Load all input events into memory and feed via TestingSource.
[?2004l[?2004h>     events = load_input_events(INPUT_PATH)
[?2004l[?2004h>     up = op.input("in", flow, TestingSource(events))
[?2004l[?2004h> 
[?2004l[?2004h>     # 2. Key by service so each service has its own windows.
[?2004l[?2004h>     keyed = op.key_on("key_by_service", up, lambda x: x[0])
[?2004l[?2004h> 
[?2004l[?2004h>     # 3. Event-time clock using the embedded timestamp.
[?2004l[?2004h>     clock = EventClock(
[?2004l[?2004h>         ts_getter=lambda item: item[2],
[?2004l[?2004h>         wait_for_system_duration=timedelta(seconds=0),
[?2004l[?2004h>     )
[?2004l[?2004h> 
[?2004l[?2004h>     # 4. 10-second tumbling windows aligned to the start of the first
[?2004l[?2004h>     #    window that contains any event.
[?2004l[?2004h>     epoch = datetime.fromtimestamp(0, tz=timezone.utc)
[?2004l[?2004h>     if events:
[?2004l[?2004h>         first_ts = min(ev[2] for ev in events)
[?2004l[?2004h>     else:
[?2004l[?2004h>         first_ts = epoch
[?2004l[?2004h>     seconds_since_epoch = int((first_ts - epoch).total_seconds())
[?2004l[?2004h>     window_seconds = int(WINDOW_LENGTH.total_seconds())
[?2004l[?2004h>     snapped = seconds_since_epoch - (seconds_since_epoch % window_seconds)
[?2004l[?2004h>     align_to = epoch + timedelta(seconds=snapped)
[?2004l[?2004h> 
[?2004l[?2004h>     windower = TumblingWindower(
[?2004l[?2004h>         length=WINDOW_LENGTH,
[?2004l[?2004h>         align_to=align_to,
[?2004l[?2004h>     )
[?2004l[?2004h> 
[?2004l[?2004h>     # 5. Fold each window of events into an ApdexAccumulator.
[?2004l[?2004h>     windowed = fold_window(
[?2004l[?2004h>         "apdex_fold",
[?2004l[?2004h>         keyed,
[?2004l[?2004h>         clock,
[?2004l[?2004h>         windower,
[?2004l[?2004h>         builder=builder,
[?2004l[?2004h>         folder=folder,
[?2004l[?2004h>         merger=merger,
[?2004l[?2004h>     )
[?2004l[?2004h> 
[?2004l[?2004h>     # 6. Project each emitted item ``(service, (window_id, acc))`` into
[?2004l[?2004h>     #    the final output schema. ``window_start`` is computed from the
[?2004l[?2004h>     #    window id (the index 0, 1, 2, ...) and the aligned base time.
[?2004l[?2004h>     def project(item) -> dict:
[?2004l[?2004h>         service, (window_id, acc) = item
[?2004l[?2004h>         window_start = align_to + window_id * WINDOW_LENGTH
[?2004l[?2004h>         return {
[?2004l[?2004h>             "window_start": window_start.isoformat().replace("+00:00", "Z"),
[?2004l[?2004h>             "service": service,
[?2004l[?2004h>             "apdex_score": acc.apdex(),
[?2004l[?2004h>         }
[?2004l[?2004h> 
[?2004l[?2004h>     results = op.map_value("project", windowed.down, project)
[?2004l[?2004h> 
[?2004l[?2004h>     # 7. Stream the results to a JSONL file.
[?2004l[?2004h>     op.output("out", results, JsonlFileSink(OUTPUT_PATH))
[?2004l[?2004h> 
[?2004l[?2004h>     # Stash the align_to on the flow object so it can be inspected by
[?2004l[?2004h>     # ``main`` if useful (purely informational).
[?2004l[?2004h>     flow._align_to = align_to  # type: ignore[attr-defined]
[?2004l[?2004h>     return flow
[?2004l[?2004h> 
