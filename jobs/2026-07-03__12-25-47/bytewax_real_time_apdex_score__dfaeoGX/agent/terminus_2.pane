[?2004l[?2004h> 
[?2004l[?2004h> class ApdexAccumulator:
[?2004l[?2004h>     """A running tally of satisfied, tolerating, and frustrated counts."""
[?2004l[?2004h> 
[?2004l[?2004h>     __slots__ = ("satisfied", "tolerating", "frustrated")
[?2004l[?2004h> 
