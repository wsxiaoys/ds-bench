[369.755447, "o", "wc -l /home/user/bytewax-apdex/apdex_flow.py\r\n\u001b[?2004l\r"]
[369.756829, "o", "240 /home/user/bytewax-apdex/apdex_flow.py\r\n"]
[369.75707, "o", "\u001b[?2004hroot@12accb2e-00c6-4ecd-b227-db18e43324a9:/home/user/bytewax-apdex# "]
[370.172859, "i", "cat /home/user/bytewax-apdex/apdex_flow.py\n"]
