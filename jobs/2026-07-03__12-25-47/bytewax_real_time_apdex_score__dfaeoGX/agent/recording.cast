[90.828161, "o", "            self.frustrated += 1\r\n\u001b[?2004l\r"]
[90.828184, "o", "\u001b[?2004h> "]
[90.828248, "o", "        return self\r\n\u001b[?2004l\r"]
[90.828271, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[90.828299, "o", "\u001b[?2004h> "]
[90.82853, "o", "    def merge(self, other: \"ApdexAccumulator\") -> \"ApdexAccumulator\":\r\n\u001b[?2004l\r\u001b[?2004h"]
[90.828557, "o", "> "]
[90.828688, "o", "        self.satisfied += other.satisfied\r\n\u001b[?2004l\r\u001b[?2004h"]
[90.828717, "o", "> "]
[90.828862, "o", "        self.tolerating += other.tolerating\r\n\u001b[?2004l\r\u001b[?2004h> "]
[90.82901, "o", "        self.frustrated += other.frustrated\r\n\u001b[?2004l\r\u001b[?2004h"]
[90.829068, "o", "> "]
[90.829101, "o", "        return self\r\n\u001b[?2004l\r\u001b[?2004h"]
[90.829165, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[90.829241, "o", "    def apdex(self) -> float:\r\n\u001b[?2004l\r"]
[90.829265, "o", "\u001b[?2004h> "]
[90.82948, "o", "        total = self.satisfied + self.tolerating + self.frustrated\r\n\u001b[?2004l\r"]
[90.829593, "o", "\u001b[?2004h>         if total == 0:\r\n\u001b[?2004l\r\u001b[?2004h"]
[90.829711, "o", "> "]
[90.829798, "o", "            return 0.0\r\n\u001b[?2004l\r\u001b[?2004h> "]
[90.829948, "o", "        score = (self.satisfied + self.tolerating / 2.0) / total\r\n\u001b[?2004l\r"]
[90.829972, "o", "\u001b[?2004h> "]
[90.830135, "o", "        # Round to 2 decimal places (as required).\r\n\u001b[?2004l\r\u001b[?2004h"]
[90.830159, "o", "> "]
[90.830264, "o", "        return round(score, 2)\r\n\u001b[?2004l\r\u001b[?2004h"]
[90.830287, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[90.830355, "o", "\u001b[?2004h> "]
[90.830447, "o", "def builder() -> ApdexAccumulator:\r\n\u001b[?2004l\r\u001b[?2004h"]
[90.83054, "o", "> "]
[90.830594, "o", "    return ApdexAccumulator()\r\n\u001b[?2004l\r\u001b[?2004h"]
[90.830668, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[90.830844, "o", "def folder(acc: ApdexAccumulator, value) -> ApdexAccumulator:\r\n\u001b[?2004l\r\u001b[?2004h"]
[90.830867, "o", "> "]
[90.831111, "o", "    # `value` is the tuple coming from the upstream after key_on was removed:\r\n\u001b[?2004l\r\u001b[?2004h"]
[90.831134, "o", "> "]
[90.831259, "o", "    # `(service, response_time_ms, ts)`.\r\n\u001b[?2004l\r\u001b[?2004h"]
[90.831282, "o", "> "]
[90.831364, "o", "    return acc.add(value[1])\r\n\u001b[?2004l\r"]
[90.831424, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[90.831627, "o", "def merger(a: ApdexAccumulator, b: ApdexAccumulator) -> ApdexAccumulator:\r\n\u001b[?2004l\r\u001b[?2004h"]
[90.831699, "o", "> "]
[90.831776, "o", "    return a.merge(b)\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[90.831823, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[90.831979, "o", "# ---------------------------------------------------------------------------\r\n\u001b[?2004l\r"]
[90.832002, "o", "\u001b[?2004h> "]
[90.832031, "o", "# Output\r\n\u001b[?2004l\r"]
[90.832126, "o", "\u001b[?2004h> "]
[90.832268, "o", "# ---------------------------------------------------------------------------\r\n\u001b[?2004l\r\u001b[?2004h"]
[90.832304, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[90.832455, "o", "class JsonlFileSinkPartition(StatelessSinkPartition):\r\n\u001b[?2004l\r\u001b[?2004h"]
[90.832489, "o", "> "]
[90.832666, "o", "    \"\"\"Append each received item as a JSON line to the output file.\"\"\"\r\n\u001b[?2004l\r"]
[90.832697, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[90.832824, "o", "    def __init__(self, path: str) -> None:\r\n\u001b[?2004l\r\u001b[?2004h"]
[90.832858, "o", "> "]
[90.832933, "o", "        self._path = path\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[90.832971, "o", "\u001b[?2004h> "]
[90.833074, "o", "    def write_batch(self, items) -> None:\r\n\u001b[?2004l\r\u001b[?2004h"]
[90.833133, "o", "> "]
[90.833258, "o", "        with open(self._path, \"a\", encoding=\"utf-8\") as fh:\r\n\u001b[?2004l\r\u001b[?2004h"]
[90.833289, "o", "> "]
[90.833373, "o", "            for item in items:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[90.833514, "o", "                fh.write(json.dumps(item) + \"\\n\")\r\n\u001b[?2004l\r\u001b[?2004h"]
[90.833587, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[90.833641, "o", "class JsonlFileSink:\r\n\u001b[?2004l\r\u001b[?2004h"]
[90.833671, "o", "> "]
[90.833796, "o", "    \"\"\"A simple single-partition JSONL file sink.\"\"\"\r\n\u001b[?2004l\r\u001b[?2004h"]
[90.833826, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[90.834001, "o", "    def __init__(self, path: str = OUTPUT_PATH) -> None:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[90.834089, "o", "        self._path = path\r\n\u001b[?2004l\r\u001b[?2004h"]
[90.834153, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[90.834296, "o", "    def build(self, step_id, worker_index, worker_count):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[90.834462, "o", "        # Single partition for simplicity; only worker 0 writes.\r\n\u001b[?2004l\r"]
[90.835043, "o", "\u001b[?2004h>         if worker_index == 0:\r\n\u001b[?2004l\r\u001b[?2004h>             return JsonlFileSinkPartition(self._path)\r\n\u001b[?2004l\r\u001b[?2004h>         # On other workers we still need to return something; use a no-op\r\n\u001b[?2004l\r\u001b[?2004h> "]
[90.835112, "o", "        # partition so write_batch is never called there.\r\n\u001b[?2004l\r\u001b[?2004h> "]
[90.835228, "o", "        return _NoopSinkPartition()\r\n\u001b[?2004l\r\u001b[?2004h"]
[90.835299, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[90.835331, "o", "\u001b[?2004h> "]
[90.83542, "o", "class _NoopSinkPartition(StatelessSinkPartition):\r\n\u001b[?2004l\r\u001b[?2004h"]
[90.835454, "o", "> "]
[90.835567, "o", "    def write_batch(self, items) -> None:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[90.835716, "o", "        return None\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[90.835793, "o", "> "]
[90.835908, "o", "# ---------------------------------------------------------------------------\r\n\u001b[?2004l\r\u001b[?2004h"]
[90.835966, "o", "> "]
[90.836003, "o", "# Dataflow\r\n\u001b[?2004l\r\u001b[?2004h> "]
[90.836192, "o", "# ---------------------------------------------------------------------------\r\n\u001b[?2004l\r"]
[90.836251, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[90.836323, "o", "def build_dataflow() -> Dataflow:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[90.836412, "o", "    flow = Dataflow(\"apdex\")\r\n\u001b[?2004l\r\u001b[?2004h"]
[90.836447, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[90.836636, "o", "    # 1. Load all input events as a list and feed them through a\r\n\u001b[?2004l\r\u001b[?2004h"]
[90.836661, "o", "> "]
[90.836847, "o", "    #    ``TestingSource``. ``TestingSource`` is the most straightforward\r\n\u001b[?2004l\r\u001b[?2004h"]
[90.836904, "o", "> "]
[90.837228, "o", "    #    way to drive a finite, in-memory dataset through a Bytewax\r\n\u001b[?2004l\r\u001b[?2004h>     #    dataflow for batch-style calculations like this one.\r\n\u001b[?2004l\r\u001b[?2004h"]
[90.837296, "o", "> "]
[90.837357, "o", "    events = load_input_events(INPUT_PATH)\r\n\u001b[?2004l\r\u001b[?2004h"]
[90.837385, "o", "> "]
[90.837528, "o", "    up = op.input(\"in\", flow, TestingSource(events))\r\n\u001b[?2004l\r\u001b[?2004h"]
[90.837558, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[90.83784, "o", "    # 2. Key by ``service`` so each service has its own windows.\r\n\u001b[?2004l\r\u001b[?2004h> "]
[90.837908, "o", "    keyed = op.key_on(\"key_by_service\", up, lambda x: x[0])\r\n\u001b[?2004l\r\u001b[?2004h"]
[90.837937, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[90.83814, "o", "    # 3. Configure an event-time clock driven by the embedded timestamp.\r\n\u001b[?2004l\r\u001b[?2004h"]
[90.83817, "o", "> "]
[90.83826, "o", "    def get_ts(item) -> datetime:\r\n\u001b[?2004l\r\u001b[?2004h"]
[90.838323, "o", "> "]
[90.838382, "o", "        return item[2]\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[90.838441, "o", "> "]
[90.838503, "o", "    clock = EventClock(\r\n\u001b[?2004l\r\u001b[?2004h> "]
[90.838555, "o", "        ts_getter=get_ts,\r\n\u001b[?2004l\r\u001b[?2004h"]
[90.838636, "o", "> "]
[90.83873, "o", "        wait_for_system_duration=timedelta(seconds=0),\r\n\u001b[?2004l\r\u001b[?2004h> "]
[90.838762, "o", "    )\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[90.838836, "o", "\u001b[?2004h> "]
[90.838983, "o", "    # 4. 10-second tumbling windows. Align to the first event's timestamp\r\n\u001b[?2004l\r\u001b[?2004h"]
[90.839005, "o", "> "]
[90.839129, "o", "    #    (or the Unix epoch if there is no data).\r\n\u001b[?2004l\r"]
[90.839148, "o", "\u001b[?2004h> "]
[90.839213, "o", "    if events:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[90.839335, "o", "        align_to = min(ev[2] for ev in events)\r\n\u001b[?2004l\r"]
[90.839356, "o", "\u001b[?2004h> "]
[90.839417, "o", "    else:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[90.839575, "o", "        align_to = datetime.fromtimestamp(0, tz=timezone.utc)\r\n\u001b[?2004l\r"]
[90.839599, "o", "\u001b[?2004h> "]
[90.839758, "o", "    # Snap align_to down to the start of its 10-second window.\r\n\u001b[?2004l\r"]
[90.839807, "o", "\u001b[?2004h> "]
[90.839922, "o", "    epoch = datetime.fromtimestamp(0, tz=timezone.utc)\r\n\u001b[?2004l\r"]
[90.839965, "o", "\u001b[?2004h> "]
[90.840117, "o", "    seconds_since_epoch = int((align_to - epoch).total_seconds())\r\n\u001b[?2004l\r"]
[90.840143, "o", "\u001b[?2004h> "]
[90.840283, "o", "    window_seconds = int(WINDOW_LENGTH.total_seconds())\r\n\u001b[?2004l\r"]
[90.840334, "o", "\u001b[?2004h> "]
[90.840496, "o", "    snapped = seconds_since_epoch - (seconds_since_epoch % window_seconds)\r\n\u001b[?2004l\r"]
[90.840517, "o", "\u001b[?2004h> "]
[90.840654, "o", "    align_to = epoch + timedelta(seconds=snapped)\r\n\u001b[?2004l\r"]
[90.840679, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[90.840722, "o", "\u001b[?2004h> "]
[90.84079, "o", "    windower = TumblingWindower(\r\n\u001b[?2004l\r"]
[90.840811, "o", "\u001b[?2004h> "]
[90.840891, "o", "        length=WINDOW_LENGTH,\r\n\u001b[?2004l\r"]
[90.840912, "o", "\u001b[?2004h> "]
[90.840985, "o", "        align_to=align_to,\r\n\u001b[?2004l\r"]
[90.841007, "o", "\u001b[?2004h> "]
[90.841048, "o", "    )\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[90.841081, "o", "\u001b[?2004h> "]
[90.841233, "o", "    # 5. Fold each window of events into an ApdexAccumulator.\r\n\u001b[?2004l\r"]
[90.841255, "o", "\u001b[?2004h> "]
[90.841331, "o", "    windowed = fold_window(\r\n\u001b[?2004l\r\u001b[?2004h"]
[90.841351, "o", "> "]
[90.841409, "o", "        \"apdex_fold\",\r\n\u001b[?2004l\r"]
[90.84143, "o", "\u001b[?2004h> "]
[90.841474, "o", "        keyed,\r\n\u001b[?2004l\r"]
[90.841495, "o", "\u001b[?2004h> "]
[90.841543, "o", "        clock,\r\n\u001b[?2004l\r"]
[90.841564, "o", "\u001b[?2004h> "]
[90.841614, "o", "        windower,\r\n\u001b[?2004l\r"]
[90.841634, "o", "\u001b[?2004h> "]
[90.841702, "o", "        builder=builder,\r\n\u001b[?2004l\r"]
[90.841722, "o", "\u001b[?2004h> "]
[90.841788, "o", "        folder=folder,\r\n\u001b[?2004l\r"]
[90.841808, "o", "\u001b[?2004h> "]
[90.84187, "o", "        merger=merger,\r\n\u001b[?2004l\r"]
[90.84189, "o", "\u001b[?2004h> "]
[90.841932, "o", "    )\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[90.841961, "o", "\u001b[?2004h> "]
[90.842118, "o", "    # 6. Compute the score and project to the desired schema.\r\n\u001b[?2004l\r"]
[90.842139, "o", "\u001b[?2004h> "]
[90.842223, "o", "    def project(item) -> dict:\r\n\u001b[?2004l\r"]
[90.842244, "o", "\u001b[?2004h> "]
[90.842389, "o", "        (_service, _acc), (window_start, _meta) = item\r\n\u001b[?2004l\r"]
[90.842409, "o", "\u001b[?2004h> "]
[90.842541, "o", "        window_start_iso: datetime = window_start\r\n\u001b[?2004l\r"]
[90.842563, "o", "\u001b[?2004h> "]
[90.842642, "o", "        score = _acc.apdex()\r\n\u001b[?2004l\r"]
[90.842662, "o", "\u001b[?2004h> "]
[90.842711, "o", "        return {\r\n\u001b[?2004l\r"]
[90.842731, "o", "\u001b[?2004h> "]
[90.84294, "o", "            \"window_start\": window_start_iso.isoformat().replace(\"+00:00\", \"Z\"),\r\n\u001b[?2004l\r"]
[90.843005, "o", "\u001b[?2004h> "]
[90.84305, "o", "            \"service\": _service,\r\n\u001b[?2004l\r"]
[90.843072, "o", "\u001b[?2004h> "]
[90.843161, "o", "            \"apdex_score\": score,\r\n\u001b[?2004l\r"]
[90.843182, "o", "\u001b[?2004h> "]
[90.843233, "o", "        }\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[90.843257, "o", "\u001b[?2004h> "]
[90.843415, "o", "    results = op.map_value(\"project\", windowed.down, project)\r\n\u001b[?2004l\r"]
[90.843435, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[90.84348, "o", "\u001b[?2004h> "]
[90.843586, "o", "    # 7. Stream the results to a JSONL file.\r\n\u001b[?2004l\r"]
[90.843609, "o", "\u001b[?2004h> "]
[90.843758, "o", "    op.output(\"out\", results, JsonlFileSink(OUTPUT_PATH))\r\n\u001b[?2004l\r"]
[90.84378, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[90.843828, "o", "> "]
[90.84385, "o", "    return flow\r\n\u001b[?2004l\r\u001b[?2004h"]
[90.84389, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[90.843914, "o", "\u001b[?2004h> "]
[90.844239, "o", "def main() -> None:\r\n\u001b[?2004l\r\u001b[?2004h>     # Ensure a clean output file so repeated runs don't append duplicates.\r\n\u001b[?2004l\r\u001b[?2004h> "]
[90.844314, "o", "    if os.path.exists(OUTPUT_PATH):\r\n\u001b[?2004l\r\u001b[?2004h"]
[90.844335, "o", "> "]
[90.844418, "o", "        os.remove(OUTPUT_PATH)\r\n\u001b[?2004l\r"]
[90.844439, "o", "\u001b[?2004h> "]
[90.844532, "o", "    run_main(build_dataflow())\r\n\u001b[?2004l\r"]
[90.844553, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[90.844601, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[90.844674, "o", "if __name__ == \"__main__\":\r\n\u001b[?2004l\r"]
[90.844696, "o", "\u001b[?2004h> "]
[90.844728, "o", "    main()\r\n\u001b[?2004l\r\u001b[?2004h"]
[90.844753, "o", "> "]
[90.844802, "o", "PYEOF\r\n\u001b[?2004l\r"]
[90.846547, "o", "\u001b[?2004hroot@12accb2e-00c6-4ecd-b227-db18e43324a9:/home/user/bytewax-apdex# "]
[95.639552, "i", "cat > /home/user/bytewax-apdex/input.jsonl << 'EOF'\n{\"timestamp\": \"2023-01-01T12:00:00Z\", \"service\": \"api\", \"response_time_ms\": 100}\n{\"timestamp\": \"2023-01-01T12:00:02Z\", \"service\": \"api\", \"response_time_ms\": 600}\n{\"timestamp\": \"2023-01-01T12:00:05Z\", \"service\": \"api\", \"response_time_ms\": 2500}\n{\"timestamp\": \"2023-01-01T12:00:11Z\", \"service\": \"api\", \"response_time_ms\": 300}\n{\"timestamp\": \"2023-01-01T12:00:12Z\", \"service\": \"web\", \"response_time_ms\": 400}\n{\"timestamp\": \"2023-01-01T12:00:14Z\", \"service\": \"web\", \"response_time_ms\": 1500}\n{\"timestamp\": \"2023-01-01T12:00:25Z\", \"service\": \"api\", \"response_time_ms\": 50}\nEOF\n"]
[95.639871, "o", "cat > /home/user/bytewax-apdex/input.jsonl << 'EOF'\r\n\u001b[?2004l\r"]
[95.639913, "o", "\u001b[?2004h> "]
[95.640121, "o", "{\"timestamp\": \"2023-01-01T12:00:00Z\", \"service\": \"api\", \"response_time_ms\": 100}\r\n\u001b[?2004l\r"]
