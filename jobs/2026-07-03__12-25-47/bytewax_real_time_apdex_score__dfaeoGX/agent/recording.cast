[69.964474, "o", "Help on class EventClock in module bytewax.operators.windowing:\r\n\r\nclass EventClock(Clock)\r\n |  EventClock(ts_getter: Callable[[~V], datetime.datetime], wait_for_system_duration: datetime.timedelta, now_getter: Callable[[], datetime.datetime] = <function _get_system_utc at 0x7fd7bfd6e160>, to_system_utc: Callable[[datetime.datetime], Optional[datetime.datetime]] = <function _identity at 0x7fd7c070a160>) -> None\r\n |\r\n |  Use a timestamp embedded within each item.\r\n |\r\n |  The watermark is the largest timestamp seen thus far, minus the\r\n |  waiting duration, plus the system time duration that has elapsed\r\n |  since that item was seen. This effectively means that items will\r\n |  be correctly processed as long as they do not have timestamps\r\n |  out-of-order or arrive later than the waiting duration.\r\n |\r\n |  :::{note}\r\n |\r\n |  By default, all timestamps returned by `ts_getter` also need to be\r\n |  [aware datetimes](inv:python:std:label#datetime-naive-aware) in\r\n |  UTC.\r\n |\r\n |  This is because `now_getter` defaults to returning the current\r\n |  system time as [aware\r\n |  datetimes](inv:python:std:label#datetime-naive-aware) in UTC, and\r\n |  comparisons are made to that.\r\n |\r\n |  It's easiest to convert your timestamps to UTC in `ts_getter`, but\r\n |  you can also specify a custom `now_getter` and `to_system_utc` to\r\n |  support other sense of time.\r\n |\r\n |  :::\r\n |\r\n |  :arg ts_getter: Called once on each item to get its timestamp.\r\n |\r\n |  :arg wait_for_system_duration: How much system time to wait after\r\n |      seeing a timestamp to have the watermark catch up to that time.\r\n |\r\n |  :arg now_getter: Return the current \"system\" timestamp used to\r\n |      advance the watermark. Defaults to the current system time in\r\n |      UTC.\r\n |\r\n |  :arg to_system_utc: For a given window close timestamp, return the\r\n"]
[69.976775, "o", "\u001b[?2004hroot@12accb2e-00c6-4ecd-b227-db18e43324a9:/home/user/bytewax-apdex# "]
[90.814746, "i", "cat > /home/user/bytewax-apdex/apdex_flow.py << 'PYEOF'\n#!/usr/bin/env python3\n\"\"\"Real-time Apdex score calculation with Bytewax.\n\nReads JSON line events from `input.jsonl`, groups them in 10-second\ntumbling windows per `service` using the event timestamp, and writes\nthe calculated Apdex score to `output.jsonl`.\n\"\"\"\n\nimport json\nimport os\nfrom datetime import datetime, timedelta, timezone\nfrom typing import Iterable, List, Tuple\n\nfrom bytewax.dataflow import Dataflow\nimport bytewax.operators as op\nfrom bytewax.operators.windowing import (\n    EventClock,\n    TumblingWindower,\n    fold_window,\n)\nfrom bytewax.testing import TestingSource, run_main\nfrom bytewax.connectors.files import FileSink\nfrom bytewax.outputs import StatelessSinkPartition\n\n\n# Apdex thresholds (in milliseconds).\nAPDEX_SATISFIED_MAX = 500          # <= 500 ms\nAPDEX_TOLERATING_MAX = 2000        # 500 < x <= 2000 ms\n\n\nINPUT_PATH = \"input.jsonl\"\nOUTPUT_PATH = \"output.jsonl\"\nWINDOW_LENGTH = timedelta(seconds=10)\n\n\n# ---------------------------------------------------------------------------\n# Source\n# ---------------------------------------------------------------------------\n\ndef load_input_events(path: str) -> List[Tuple[str, int, datetime]]:\n    \"\"\"Load events from a JSONL file as `(service, response_time_ms, ts)` tuples.\n\n    Timestamps are returned as timezone-aware UTC ``datetime`` instances.\n    \"\"\"\n    events: List[Tuple[str, int, datetime]] = []\n    if not os.path.exists(path):\n        return events\n    with open(path, \"r\", encoding=\"utf-8\") as fh:\n        for raw in fh:\n            raw = raw.strip()\n            if not raw:\n                continue\n            record = json.loads(raw)\n            ts = _parse_timestamp(record[\"timestamp\"])\n            events.append((record[\"service\"], int(record[\"response_time_ms\"]), ts))\n    return events\n\n\ndef _parse_timestamp(value: str) -> datetime:\n    \"\"\"Parse an ISO-8601 timestamp into an aware UTC ``datetime``.\"\"\"\n    # Python's fromisoformat in 3.12 handles \"Z\" REDACTEDmatically but be safe.\n    ts = datetime.fromisoformat(value.replace(\"Z\", \"+00:00\"))\n    if ts.tzinfo is None:\n        ts = ts.replace(tzinfo=timezone.utc)\n    else:\n        ts = ts.astimezone(timezone.utc)\n    return ts\n\n\n# ---------------------------------------------------------------------------\n# Aggregation state\n# ---------------------------------------------------------------------------\n\nclass ApdexAccumulator:\n    \"\"\"A running tally of satisfied, tolerating, and frustrated counts.\"\"\"\n\n    __slots__ = (\"satisfied\", \"tolerating\", \"frustrated\")\n\n    def __init__(self) -> None:\n        self.satisfied: int = 0\n        self.tolerating: int = 0\n        self.frustrated: int = 0\n\n    def add(self, response_time_ms: int) -> \"ApdexAccumulator\":\n        if response_time_ms <= APDEX_SATISFIED_MAX:\n            self.satisfied += 1\n        elif response_time_ms <= APDEX_TOLERATING_MAX:\n            self.tolerating += 1\n        else:\n            self.frustrated += 1\n        return self\n\n    def merge(self, other: \"ApdexAccumulator\") -> \"ApdexAccumulator\":\n        self.satisfied += other.satisfied\n        self.tolerating += other.tolerating\n        self.frustrated += other.frustrated\n        return self\n\n    def apdex(self) -> float:\n        total = self.satisfied + self.tolerating + self.frustrated\n        if total == 0:\n            return 0.0\n        score = (self.satisfied + self.tolerating / 2.0) / total\n        # Round to 2 decimal places (as required).\n        return round(score, 2)\n\n\ndef builder() -> ApdexAccumulator:\n    return ApdexAccumulator()\n\n\ndef folder(acc: ApdexAccumulator, value) -> ApdexAccumulator:\n    # `value` is the tuple coming from the upstream after key_on was removed:\n    # `(service, response_time_ms, ts)`.\n    return acc.add(value[1])\n\n\ndef merger(a: ApdexAccumulator, b: ApdexAccumulator) -> ApdexAccumulator:\n    return a.merge(b)\n\n\n# ---------------------------------------------------------------------------\n# Output\n# ---------------------------------------------------------------------------\n\nclass JsonlFileSinkPartition(Sta"]
[90.8149, "i", "telessSinkPartition):\n    \"\"\"Append each received item as a JSON line to the output file.\"\"\"\n\n    def __init__(self, path: str) -> None:\n        self._path = path\n\n    def write_batch(self, items) -> None:\n        with open(self._path, \"a\", encoding=\"utf-8\") as fh:\n            for item in items:\n                fh.write(json.dumps(item) + \"\\n\")\n\n\nclass JsonlFileSink:\n    \"\"\"A simple single-partition JSONL file sink.\"\"\"\n\n    def __init__(self, path: str = OUTPUT_PATH) -> None:\n        self._path = path\n\n    def build(self, step_id, worker_index, worker_count):\n        # Single partition for simplicity; only worker 0 writes.\n        if worker_index == 0:\n            return JsonlFileSinkPartition(self._path)\n        # On other workers we still need to return something; use a no-op\n        # partition so write_batch is never called there.\n        return _NoopSinkPartition()\n\n\nclass _NoopSinkPartition(StatelessSinkPartition):\n    def write_batch(self, items) -> None:\n        return None\n\n\n# ---------------------------------------------------------------------------\n# Dataflow\n# ---------------------------------------------------------------------------\n\ndef build_dataflow() -> Dataflow:\n    flow = Dataflow(\"apdex\")\n\n    # 1. Load all input events as a list and feed them through a\n    #    ``TestingSource``. ``TestingSource`` is the most straightforward\n    #    way to drive a finite, in-memory dataset through a Bytewax\n    #    dataflow for batch-style calculations like this one.\n    events = load_input_events(INPUT_PATH)\n    up = op.input(\"in\", flow, TestingSource(events))\n\n    # 2. Key by ``service`` so each service has its own windows.\n    keyed = op.key_on(\"key_by_service\", up, lambda x: x[0])\n\n    # 3. Configure an event-time clock driven by the embedded timestamp.\n    def get_ts(item) -> datetime:\n        return item[2]\n\n    clock = EventClock(\n        ts_getter=get_ts,\n        wait_for_system_duration=timedelta(seconds=0),\n    )\n\n    # 4. 10-second tumbling windows. Align to the first event's timestamp\n    #    (or the Unix epoch if there is no data).\n    if events:\n        align_to = min(ev[2] for ev in events)\n    else:\n        align_to = datetime.fromtimestamp(0, tz=timezone.utc)\n    # Snap align_to down to the start of its 10-second window.\n    epoch = datetime.fromtimestamp(0, tz=timezone.utc)\n    seconds_since_epoch = int((align_to - epoch).total_seconds())\n    window_seconds = int(WINDOW_LENGTH.total_seconds())\n    snapped = seconds_since_epoch - (seconds_since_epoch % window_seconds)\n    align_to = epoch + timedelta(seconds=snapped)\n\n    windower = TumblingWindower(\n        length=WINDOW_LENGTH,\n        align_to=align_to,\n    )\n\n    # 5. Fold each window of events into an ApdexAccumulator.\n    windowed = fold_window(\n        \"apdex_fold\",\n        keyed,\n        clock,\n        windower,\n        builder=builder,\n        folder=folder,\n        merger=merger,\n    )\n\n    # 6. Compute the score and project to the desired schema.\n    def project(item) -> dict:\n        (_service, _acc), (window_start, _meta) = item\n        window_start_iso: datetime = window_start\n        score = _acc.apdex()\n        return {\n            \"window_start\": window_start_iso.isoformat().replace(\"+00:00\", \"Z\"),\n            \"service\": _service,\n            \"apdex_score\": score,\n        }\n\n    results = op.map_value(\"project\", windowed.down, project)\n\n    # 7. Stream the results to a JSONL file.\n    op.output(\"out\", results, JsonlFileSink(OUTPUT_PATH))\n\n    return flow\n\n\ndef main() -> None:\n    # Ensure a clean output file so repeated runs don't append duplicates.\n    if os.path.exists(OUTPUT_PATH):\n        os.remove(OUTPUT_PATH)\n    run_main(build_dataflow())\n\n\nif __name__ == \"__main__\":\n    main()\nPYEOF\n"]
