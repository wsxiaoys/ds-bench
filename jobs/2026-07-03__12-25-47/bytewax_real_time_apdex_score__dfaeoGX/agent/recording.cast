[90.827318, "o", "    def add(self, response_time_ms: int) -> \"ApdexAccumulator\":\r\n\u001b[?2004l\r\u001b[?2004h"]
[90.827341, "o", "> "]
[90.827502, "o", "        if response_time_ms <= APDEX_SATISFIED_MAX:\r\n\u001b[?2004l\r"]
[90.827539, "o", "\u001b[?2004h> "]
[90.827637, "o", "            self.satisfied += 1\r\n\u001b[?2004l\r\u001b[?2004h"]
[90.827662, "o", "> "]
[90.827833, "o", "        elif response_time_ms <= APDEX_TOLERATING_MAX:\r\n\u001b[?2004l\r\u001b[?2004h"]
[90.827857, "o", "> "]
