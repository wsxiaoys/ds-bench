[206.871176, "o", "CAPTURED: tuple => ('api', (0, <__main__.Acc object at 0x7517a6953680>))\r\nCAPTURED: tuple => ('api', (1, <__main__.Acc object at 0x7517a676ddc0>))\r\nCAPTURED: tuple => ('api', (2, <__main__.Acc object at 0x7517a676e180>))\r\nCAPTURED: tuple => ('web', (1, <__main__.Acc object at 0x7517a676e000>))\r\n"]
[206.884312, "o", "\u001b[?2004hroot@12accb2e-00c6-4ecd-b227-db18e43324a9:/home/user/bytewax-apdex# "]
[223.542681, "i", "cat > /tmp/test_debug4.py << 'EOF'\nimport json\nimport os\nfrom datetime import datetime, timedelta, timezone\nfrom bytewax.dataflow import Dataflow\nimport bytewax.operators as op\nfrom bytewax.operators.windowing import EventClock, TumblingWindower, fold_window\nfrom bytewax.testing import TestingSource, run_main\nfrom bytewax.outputs import DynamicSink, StatelessSinkPartition\n\nINPUT_PATH = \"input.jsonl\"\n\nclass Acc:\n    __slots__ = (\"s\", \"t\", \"f\")\n    def __init__(self):\n        self.s = self.t = self.f = 0\n    def add(self, rt):\n        if rt <= 500: self.s += 1\n        elif rt <= 2000: self.t += 1\n        else: self.f += 1\n        return self\n    def merge(self, o):\n        self.s += o.s; self.t += o.t; self.f += o.f\n        return self\n\ndef builder(): return Acc()\ndef folder(a, v): return a.add(v[1])\ndef merger(a, b): return a.merge(b)\n\nflow = Dataflow(\"d\")\nevents = []\nwith open(INPUT_PATH) as fh:\n    for line in fh:\n        line = line.strip()\n        if not line: continue\n        r = json.loads(line)\n        ts = datetime.fromisoformat(r[\"timestamp\"].replace(\"Z\", \"+00:00\"))\n        if ts.tzinfo is None: ts = ts.replace(tzinfo=timezone.utc)\n        events.append((r[\"service\"], int(r[\"response_time_ms\"]), ts))\n\nup = op.input(\"in\", flow, TestingSource(events))\nkeyed = op.key_on(\"k\", up, lambda x: x[0])\nclock = EventClock(ts_getter=lambda x: x[2], wait_for_system_duration=timedelta(0))\nepoch = datetime.fromtimestamp(0, tz=timezone.utc)\nalign = events[0][2]\nsecs = int((align - epoch).total_seconds())\nsnapped = secs - (secs % 10)\nalign = epoch + timedelta(seconds=snapped)\nwin = TumblingWindower(length=timedelta(seconds=10), align_to=align)\nwindowed = fold_window(\"w\", keyed, clock, win, builder=builder, folder=folder, merger=merger)\n\n\nclass CaptureSink(DynamicSink):\n    def __init__(self):\n        self.items = []\n    def build(self, step_id, worker_index, worker_count):\n        out = self\n        class P(StatelessSinkPartition):\n            def write_batch(self, items):\n                for it in items:\n                    print(\"CAPTURED:\", type(it).__name__, \"=>\", repr(it))\n                    out.items.append(it)\n        return P()\n\ncap = CaptureSink()\n# Apply map_value first\ndef show(v):\n    print(\"MAPV:\", type(v).__name__, \"=>\", repr(v))\n    return v\n\nmapped = op.map_value(\"mapv\", windowed.down, show)\nop.output(\"capture\", mapped, cap)\nrun_main(flow)\nEOF\npython /tmp/test_debug4.py 2>&1 | head -30\n"]
