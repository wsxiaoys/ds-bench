[247.617012, "o", "\u001b[32m\u001b[K5\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[Ktumbling windows per ``\u001b[01;31m\u001b[Kservice\u001b[m\u001b[K`` using the event timestamp, and writes\r\n\u001b[32m\u001b[K10\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K  - ``\u001b[01;31m\u001b[Kservice\u001b[m\u001b[K``       (string)\r\n\u001b[32m\u001b[K68\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K                (record[\"\u001b[01;31m\u001b[Kservice\u001b[m\u001b[K\"], int(record[\"response_time_ms\"]), ts)\r\n"]
[247.617043, "o", "\u001b[32m\u001b[K116\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K    # 3-tuple ``(\u001b[01;31m\u001b[Kservice\u001b[m\u001b[K, response_time_ms, ts)``.\r\n\u001b[32m\u001b[K166\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K    # 2. Key by \u001b[01;31m\u001b[Kservice\u001b[m\u001b[K so each \u001b[01;31m\u001b[Kservice\u001b[m\u001b[K has its own windows.\r\n\u001b[32m\u001b[K167\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K    keyed = op.key_on(\"key_by_\u001b[01;31m\u001b[Kservice\u001b[m\u001b[K\", up, lambda x: x[0])\r\n\u001b[32m\u001b[K203\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K    # 6. Project each emitted item ``(\u001b[01;31m\u001b[Kservice\u001b[m\u001b[K, (\u001b[01;31m\u001b[Kwindow_id\u001b[m\u001b[K, acc))`` into\r\n"]
[247.617066, "o", "\u001b[32m\u001b[K206\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K    \u001b[01;31m\u001b[Kdef project\u001b[m\u001b[K(item) -> dict:\r\n\u001b[32m\u001b[K207\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K        \u001b[01;31m\u001b[Kwindow_id\u001b[m\u001b[K, acc = item\r\n\u001b[32m\u001b[K208\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K        \u001b[01;31m\u001b[Kservice\u001b[m\u001b[K = item_owner"]
[247.617087, "o", "\r\n\u001b[32m\u001b[K209\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K        window_start = align_to + \u001b[01;31m\u001b[Kwindow_id\u001b[m\u001b[K * WINDOW_LENGTH\r\n\u001b[32m\u001b[K212\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K            \"\u001b[01;31m\u001b[Kservice\u001b[m\u001b[K\": \u001b[01;31m\u001b[Kservice\u001b[m\u001b[K,\r\n"]
[247.617136, "o", "\u001b[32m\u001b[K216\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K    results = op.\u001b[01;31m\u001b[Kmap(\"project\"\u001b[m\u001b[K, windowed.down, project)\r\n"]
[247.617534, "o", "\u001b[?2004h"]
[247.61867, "o", "root@12accb2e-00c6-4ecd-b227-db18e43324a9:/home/user/bytewax-apdex# "]
[270.260648, "i", "cat > /home/user/bytewax-apdex/apdex_flow.py << 'PYEOF'\n#!/usr/bin/env python3\n\"\"\"Real-time Apdex score calculation with Bytewax.\n\nReads JSON line events from ``input.jsonl``, groups them in 10-second\ntumbling windows per ``service`` using the event timestamp, and writes\nthe calculated Apdex score to ``output.jsonl``.\n\nEach output line contains:\n  - ``window_start`` (ISO 8601 string, UTC)\n  - ``service``       (string)\n  - ``apdex_score``    (float, rounded to 2 decimal places)\n\nRun it with ``python apdex_flow.py``.\n\"\"\"\n\nimport json\nimport os\nfrom datetime import datetime, timedelta, timezone\nfrom typing import List, Tuple\n\nfrom bytewax.dataflow import Dataflow\nimport bytewax.operators as op\nfrom bytewax.operators.windowing import (\n    EventClock,\n    TumblingWindower,\n    fold_window,\n)\nfrom bytewax.testing import TestingSource, run_main\nfrom bytewax.outputs import DynamicSink, StatelessSinkPartition\n\n\n# ---------------------------------------------------------------------------\n# Apdex thresholds (milliseconds)\n# ---------------------------------------------------------------------------\n\nAPDEX_SATISFIED_MAX = 500          # response_time_ms <= 500   -> satisfied\nAPDEX_TOLERATING_MAX = 2000        # 500  < x <= 2000          -> tolerating\n# Anything strictly greater than 2000 -> frustrated.\n\nINPUT_PATH = \"input.jsonl\"\nOUTPUT_PATH = \"output.jsonl\"\nWINDOW_LENGTH = timedelta(seconds=10)\n\n\n# ---------------------------------------------------------------------------\n# Input loading\n# ---------------------------------------------------------------------------\n\ndef _parse_timestamp(value: str) -> datetime:\n    ts = datetime.fromisoformat(value.replace(\"Z\", \"+00:00\"))\n    if ts.tzinfo is None:\n        ts = ts.replace(tzinfo=timezone.utc)\n    else:\n        ts = ts.astimezone(timezone.utc)\n    return ts\n\n\ndef load_input_events(path: str) -> List[Tuple[str, int, datetime]]:\n    \"\"\"Load JSONL events as ``(service, response_time_ms, datetime)`` tuples.\"\"\"\n    events: List[Tuple[str, int, datetime]] = []\n    if not os.path.exists(path):\n        return events\n    with open(path, \"r\", encoding=\"utf-8\") as fh:\n        for raw in fh:\n            raw = raw.strip()\n            if not raw:\n                continue\n            record = json.loads(raw)\n            ts = _parse_timestamp(record[\"timestamp\"])\n            events.append(\n                (record[\"service\"], int(record[\"response_time_ms\"]), ts)\n            )\n    return events\n\n\n# ---------------------------------------------------------------------------\n# Window-state / Apdex accumulator\n# ---------------------------------------------------------------------------\n\nclass ApdexAccumulator:\n    \"\"\"A per-window tally of satisfied/tolerating/frustrated counts.\"\"\"\n\n    __slots__ = (\"satisfied\", \"tolerating\", \"frustrated\")\n\n    def __init__(self) -> None:\n        self.satisfied: int = 0\n        self.tolerating: int = 0\n        self.frustrated: int = 0\n\n    def add(self, response_time_ms: int) -> \"ApdexAccumulator\":\n        if response_time_ms <= APDEX_SATISFIED_MAX:\n            self.satisfied += 1\n        elif response_time_ms <= APDEX_TOLERATING_MAX:\n            self.tolerating += 1\n        else:\n            self.frustrated += 1\n        return self\n\n    def merge(self, other: \"ApdexAccumulator\") -> \"ApdexAccumulator\":\n        self.satisfied += other.satisfied\n        self.tolerating += other.tolerating\n        self.frustrated += other.frustrated\n        return self\n\n    def apdex(self) -> float:\n        total = self.satisfied + self.tolerating + self.frustrated\n        if total == 0:\n            return 0.0\n        score = (self.satisfied + self.tolerating / 2.0) / total\n        return round(score, 2)\n\n\ndef builder() -> ApdexAccumulator:\n    return ApdexAccumulator()\n\n\ndef folder(acc: ApdexAccumulator, value) -> ApdexAccumulator:\n    \"\"\"Fold one ``(service, response_time_ms, ts)`` tuple into the accumulator.\"\"\"\n    return acc.add(value[1])\n\n\ndef merger(a: ApdexAccumulator, b: ApdexAccumulator) -> ApdexAccumulator:\n    return a.merge(b)\n\n\n# --------------------------------------------"]
[270.260785, "i", "-------------------------------\n# Output sink\n# ---------------------------------------------------------------------------\n\nclass _NoopSinkPartition(StatelessSinkPartition):\n    def write_batch(self, items) -> None:\n        return None\n\n\nclass JsonlFileSinkPartition(StatelessSinkPartition):\n    def __init__(self, path: str) -> None:\n        self._path = path\n\n    def write_batch(self, items) -> None:\n        with open(self._path, \"a\", encoding=\"utf-8\") as fh:\n            for item in items:\n                fh.write(json.dumps(item) + \"\\n\")\n\n\nclass JsonlFileSink(DynamicSink):\n    \"\"\"A single-partition JSONL file sink (only worker 0 writes).\"\"\"\n\n    def __init__(self, path: str = OUTPUT_PATH) -> None:\n        self._path = path\n\n    def build(self, step_id, worker_index, worker_count):\n        if worker_index == 0:\n            return JsonlFileSinkPartition(self._path)\n        return _NoopSinkPartition()\n\n\n# ---------------------------------------------------------------------------\n# Dataflow construction\n# ---------------------------------------------------------------------------\n\ndef build_dataflow() -> Dataflow:\n    flow = Dataflow(\"apdex\")\n\n    # 1. Load all input events into memory and feed them through a\n    #    ``TestingSource`` (which is the simplest finite-source helper\n    #    Bytewax provides).\n    events = load_input_events(INPUT_PATH)\n    up = op.input(\"in\", flow, TestingSource(events))\n\n    # 2. Key by service so each service has its own windows.\n    keyed = op.key_on(\"key_by_service\", up, lambda x: x[0])\n\n    # 3. Event-time clock using the embedded timestamp.\n    clock = EventClock(\n        ts_getter=lambda item: item[2],\n        wait_for_system_duration=timedelta(seconds=0),\n    )\n\n    # 4. 10-second tumbling windows aligned to the start of the first\n    #    window that contains any event.\n    epoch = datetime.fromtimestamp(0, tz=timezone.utc)\n    if events:\n        first_ts = min(ev[2] for ev in events)\n    else:\n        first_ts = epoch\n    seconds_since_epoch = int((first_ts - epoch).total_seconds())\n    window_seconds = int(WINDOW_LENGTH.total_seconds())\n    snapped = seconds_since_epoch - (seconds_since_epoch % window_seconds)\n    align_to = epoch + timedelta(seconds=snapped)\n\n    windower = TumblingWindower(\n        length=WINDOW_LENGTH,\n        align_to=align_to,\n    )\n\n    # 5. Fold each window of events into an ApdexAccumulator.\n    windowed = fold_window(\n        \"apdex_fold\",\n        keyed,\n        clock,\n        windower,\n        builder=builder,\n        folder=folder,\n        merger=merger,\n    )\n\n    # 6. ``windowed.down`` is a keyed stream. Items arriving look like\n    #    ``(service, (window_id, acc))``. We use ``op.map`` (not\n    #    ``map_value``) so the mapper receives the full keyed tuple and\n    #    can recover the service key. ``window_start`` is computed from\n    #    the window id (an integer index 0, 1, 2, ...) and ``align_to``.\n    def project(item) -> dict:\n        service, (window_id, acc) = item\n        window_start = align_to + window_id * WINDOW_LENGTH\n        return {\n            \"window_start\": window_start.isoformat().replace(\"+00:00\", \"Z\"),\n            \"service\": service,\n            \"apdex_score\": acc.apdex(),\n        }\n\n    results = op.map(\"project\", windowed.down, project)\n\n    # 7. Stream the results to a JSONL file.\n    op.output(\"out\", results, JsonlFileSink(OUTPUT_PATH))\n\n    return flow\n\n\n# ---------------------------------------------------------------------------\n# Entrypoint\n# ---------------------------------------------------------------------------\n\ndef main() -> None:\n    if os.path.exists(OUTPUT_PATH):\n        os.remove(OUTPUT_PATH)\n    run_main(build_dataflow())\n\n\nif __name__ == \"__main__\":\n    main()\nPYEOF\n"]
[270.261098, "o", "cat > /home/user/bytewax-apdex/apdex_flow.py << 'PYEOF'\r\n\u001b[?2004l\r"]
[270.261162, "o", "\u001b[?2004h> "]
[270.261247, "o", "#!/usr/bin/env python3\r\n\u001b[?2004l\r"]
[270.261279, "o", "\u001b[?2004h> "]
[270.261441, "o", "\"\"\"Real-time Apdex score calculation with Bytewax.\r\n\u001b[?2004l\r"]
[270.261472, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[270.261497, "o", "> "]
[270.261742, "o", "Reads JSON line events from ``input.jsonl``, groups them in 10-second\r\n\u001b[?2004l\r\u001b[?2004h"]
[270.261771, "o", "> "]
[270.261999, "o", "tumbling windows per ``service`` using the event timestamp, and writes\r\n\u001b[?2004l\r\u001b[?2004h"]
[270.262028, "o", "> "]
[270.262182, "o", "the calculated Apdex score to ``output.jsonl``.\r\n\u001b[?2004l\r\u001b[?2004h"]
[270.262211, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h"]
[270.262265, "o", "> "]
[270.262321, "o", "Each output line contains:\r\n\u001b[?2004l\r"]
[270.262352, "o", "\u001b[?2004h> "]
[270.262496, "o", "  - ``window_start`` (ISO 8601 string, UTC)\r\n\u001b[?2004l\r"]
[270.262531, "o", "\u001b[?2004h> "]
[270.2627, "o", "  - ``service``       (string)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[270.262865, "o", "  - ``apdex_score``    (float, rounded to 2 decimal places)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[270.262902, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[270.263028, "o", "Run it with ``python apdex_flow.py``.\r\n\u001b[?2004l\r\u001b[?2004h> "]
[270.263081, "o", "\"\"\"\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[270.263116, "o", "> "]
[270.263147, "o", "import json\r\n\u001b[?2004l\r\u001b[?2004h> "]
[270.263221, "o", "import os\r\n\u001b[?2004l\r\u001b[?2004h> "]
[270.263393, "o", "from datetime import datetime, timedelta, timezone\r\n\u001b[?2004l\r\u001b[?2004h"]
[270.263429, "o", "> "]
[270.263547, "o", "from typing import List, Tuple\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[270.263598, "o", "\u001b[?2004h> "]
[270.263687, "o", "from bytewax.dataflow import Dataflow\r\n\u001b[?2004l\r"]
[270.263721, "o", "\u001b[?2004h> "]
[270.263812, "o", "import bytewax.operators as op\r\n\u001b[?2004l\r\u001b[?2004h"]
[270.263843, "o", "> "]
[270.26397, "o", "from bytewax.operators.windowing import (\r\n\u001b[?2004l\r"]
[270.264001, "o", "\u001b[?2004h> "]
[270.26406, "o", "    EventClock,\r\n\u001b[?2004l\r\u001b[?2004h> "]
[270.264139, "o", "    TumblingWindower,\r\n\u001b[?2004l\r"]
[270.264165, "o", "\u001b[?2004h> "]
[270.264218, "o", "    fold_window,\r\n\u001b[?2004l\r\u001b[?2004h"]
[270.264245, "o", "> )\r\n\u001b[?2004l\r"]
[270.264294, "o", "\u001b[?2004h> "]
[270.264431, "o", "from bytewax.testing import TestingSource, run_main\r\n\u001b[?2004l\r"]
[270.264459, "o", "\u001b[?2004h> "]
[270.264694, "o", "from bytewax.outputs import DynamicSink, StatelessSinkPartition\r\n\u001b[?2004l\r"]
[270.26472, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[270.264766, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[270.265008, "o", "# ---------------------------------------------------------------------------\r\n\u001b[?2004l\r"]
[270.265034, "o", "\u001b[?2004h> "]
[270.265145, "o", "# Apdex thresholds (milliseconds)\r\n\u001b[?2004l\r"]
[270.265172, "o", "\u001b[?2004h> "]
[270.265413, "o", "# ---------------------------------------------------------------------------\r\n\u001b[?2004l\r\u001b[?2004h"]
[270.26544, "o", "> \r\n\u001b[?2004l\r"]
[270.265489, "o", "\u001b[?2004h> "]
[270.265712, "o", "APDEX_SATISFIED_MAX = 500          # response_time_ms <= 500   -> satisfied\r\n\u001b[?2004l\r"]
[270.26574, "o", "\u001b[?2004h> "]
[270.26598, "o", "APDEX_TOLERATING_MAX = 2000        # 500  < x <= 2000          -> tolerating\r\n\u001b[?2004l\r"]
[270.266009, "o", "\u001b[?2004h> "]
[270.26617, "o", "# Anything strictly greater than 2000 -> frustrated.\r\n\u001b[?2004l\r"]
[270.266196, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[270.266241, "o", "> "]
[270.2663, "o", "INPUT_PATH = \"input.jsonl\"\r\n\u001b[?2004l\r"]
[270.266327, "o", "\u001b[?2004h> "]
[270.26642, "o", "OUTPUT_PATH = \"output.jsonl\"\r\n\u001b[?2004l\r"]
[270.266447, "o", "\u001b[?2004h> "]
[270.266578, "o", "WINDOW_LENGTH = timedelta(seconds=10)\r\n\u001b[?2004l\r\u001b[?2004h"]
[270.266621, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[270.266665, "o", "\u001b[?2004h> "]
[270.266901, "o", "# ---------------------------------------------------------------------------\r\n\u001b[?2004l\r"]
[270.266932, "o", "\u001b[?2004h> "]
[270.267023, "o", "# Input loading\r\n\u001b[?2004l\r\u001b[?2004h> "]
[270.267244, "o", "# ---------------------------------------------------------------------------\r\n\u001b[?2004l\r"]
[270.267268, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[270.267331, "o", "\u001b[?2004h> "]
[270.267437, "o", "def _parse_timestamp(value: str) -> datetime:\r\n\u001b[?2004l\r"]
[270.267459, "o", "\u001b[?2004h> "]
[270.267666, "o", "    ts = datetime.fromisoformat(value.replace(\"Z\", \"+00:00\"))\r\n\u001b[?2004l\r\u001b[?2004h"]
[270.267689, "o", "> "]
[270.267773, "o", "    if ts.tzinfo is None:\r\n\u001b[?2004l\r\u001b[?2004h"]
[270.267795, "o", "> "]
[270.267934, "o", "        ts = ts.replace(tzinfo=timezone.utc)\r\n\u001b[?2004l\r"]
[270.267957, "o", "\u001b[?2004h> "]
[270.268018, "o", "    else:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[270.268138, "o", "        ts = ts.astimezone(timezone.utc)\r\n\u001b[?2004l\r"]
[270.268162, "o", "\u001b[?2004h> "]
[270.26822, "o", "    return ts\r\n\u001b[?2004l\r\u001b[?2004h> "]
[270.268246, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[270.268303, "o", "\u001b[?2004h> "]
[270.268497, "o", "def load_input_events(path: str) -> List[Tuple[str, int, datetime]]:\r\n\u001b[?2004l\r"]
[270.268518, "o", "\u001b[?2004h> "]
[270.268782, "o", "    \"\"\"Load JSONL events as ``(service, response_time_ms, datetime)`` tuples.\"\"\"\r\n\u001b[?2004l\r\u001b[?2004h"]
[270.268807, "o", "> "]
[270.268957, "o", "    events: List[Tuple[str, int, datetime]] = []\r\n\u001b[?2004l\r"]
[270.268979, "o", "\u001b[?2004h> "]
[270.269083, "o", "    if not os.path.exists(path):\r\n\u001b[?2004l\r"]
[270.269105, "o", "\u001b[?2004h> "]
[270.269178, "o", "        return events\r\n\u001b[?2004l\r"]
[270.2692, "o", "\u001b[?2004h> "]
[270.26936, "o", "    with open(path, \"r\", encoding=\"utf-8\") as fh:\r\n\u001b[?2004l\r"]
[270.269382, "o", "\u001b[?2004h> "]
[270.269459, "o", "        for raw in fh:\r\n\u001b[?2004l\r\u001b[?2004h"]
[270.269485, "o", "> "]
[270.269583, "o", "            raw = raw.strip()\r\n\u001b[?2004l\r"]
[270.269608, "o", "\u001b[?2004h> "]
[270.269682, "o", "            if not raw:\r\n\u001b[?2004l\r"]
[270.269704, "o", "\u001b[?2004h> "]
[270.269783, "o", "                continue\r\n\u001b[?2004l\r"]
[270.269805, "o", "\u001b[?2004h> "]
[270.269922, "o", "            record = json.loads(raw)\r\n\u001b[?2004l\r"]
[270.269947, "o", "\u001b[?2004h> "]
[270.270118, "o", "            ts = _parse_timestamp(record[\"timestamp\"])\r\n\u001b[?2004l\r"]
[270.270141, "o", "\u001b[?2004h> "]
[270.270224, "o", "            events.append(\r\n\u001b[?2004l\r"]
[270.270246, "o", "\u001b[?2004h> "]
[270.270477, "o", "                (record[\"service\"], int(record[\"response_time_ms\"]), ts)\r\n\u001b[?2004l\r"]
[270.270499, "o", "\u001b[?2004h> "]
[270.270563, "o", "            )\r\n\u001b[?2004l\r\u001b[?2004h"]
[270.270591, "o", "> "]
[270.270647, "o", "    return events\r\n\u001b[?2004l\r\u001b[?2004h> "]
[270.270672, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[270.270728, "o", "\u001b[?2004h> "]
[270.270946, "o", "# ---------------------------------------------------------------------------\r\n\u001b[?2004l\r"]
[270.270969, "o", "\u001b[?2004h> "]
[270.271082, "o", "# Window-state / Apdex accumulator\r\n\u001b[?2004l\r"]
[270.271105, "o", "\u001b[?2004h> "]
[270.271346, "o", "# ---------------------------------------------------------------------------\r\n\u001b[?2004l\r"]
[270.27137, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[270.271434, "o", "\u001b[?2004h> "]
[270.27148, "o", "class ApdexAccumulator:\r\n\u001b[?2004l\r\u001b[?2004h"]
[270.271503, "o", "> "]
[270.271745, "o", "    \"\"\"A per-window tally of satisfied/tolerating/frustrated counts.\"\"\"\r\n\u001b[?2004l\r\u001b[?2004h"]
[270.27177, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[270.271968, "o", "    __slots__ = (\"satisfied\", \"tolerating\", \"frustrated\")\r\n\u001b[?2004l\r"]
[270.271991, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[270.272051, "o", "> "]
[270.272121, "o", "    def __init__(self) -> None:\r\n\u001b[?2004l\r\u001b[?2004h"]
[270.272185, "o", "> "]
[270.272258, "o", "        self.satisfied: int = 0\r\n\u001b[?2004l\r"]
[270.272282, "o", "\u001b[?2004h> "]
[270.272404, "o", "        self.tolerating: int = 0\r\n\u001b[?2004l\r"]
[270.272427, "o", "\u001b[?2004h> "]
[270.272554, "o", "        self.frustrated: int = 0\r\n\u001b[?2004l\r"]
[270.272576, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[270.272633, "o", "\u001b[?2004h> "]
[270.272817, "o", "    def add(self, response_time_ms: int) -> \"ApdexAccumulator\":\r\n\u001b[?2004l\r"]
[270.272841, "o", "\u001b[?2004h> "]
[270.273019, "o", "        if response_time_ms <= APDEX_SATISFIED_MAX:\r\n\u001b[?2004l\r"]
[270.273044, "o", "\u001b[?2004h> "]
[270.27316, "o", "            self.satisfied += 1\r\n\u001b[?2004l\r"]
[270.273185, "o", "\u001b[?2004h> "]
[270.273359, "o", "        elif response_time_ms <= APDEX_TOLERATING_MAX:\r\n\u001b[?2004l\r"]
[270.273382, "o", "\u001b[?2004h> "]
[270.273487, "o", "            self.tolerating += 1\r\n\u001b[?2004l\r"]
[270.273514, "o", "\u001b[?2004h> "]
[270.273589, "o", "        else:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[270.273689, "o", "            self.frustrated += 1\r\n\u001b[?2004l\r"]
[270.273712, "o", "\u001b[?2004h> "]
[270.27378, "o", "        return self\r\n\u001b[?2004l\r\u001b[?2004h"]
[270.273803, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h"]
[270.273858, "o", "> "]
[270.274049, "o", "    def merge(self, other: \"ApdexAccumulator\") -> \"ApdexAccumulator\":\r\n\u001b[?2004l\r"]
[270.274071, "o", "\u001b[?2004h> "]
[270.274207, "o", "        self.satisfied += other.satisfied\r\n\u001b[?2004l\r"]
[270.274231, "o", "\u001b[?2004h> "]
[270.274367, "o", "        self.tolerating += other.tolerating\r\n\u001b[?2004l\r"]
[270.27439, "o", "\u001b[?2004h> "]
[270.274541, "o", "        self.frustrated += other.frustrated\r\n\u001b[?2004l\r"]
[270.27457, "o", "\u001b[?2004h> "]
[270.274634, "o", "        return self\r\n\u001b[?2004l\r"]
[270.274664, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[270.274729, "o", "> "]
[270.274793, "o", "    def apdex(self) -> float:\r\n\u001b[?2004l\r"]
[270.274816, "o", "\u001b[?2004h> "]
[270.275042, "o", "        total = self.satisfied + self.tolerating + self.frustrated\r\n\u001b[?2004l\r"]
[270.275065, "o", "\u001b[?2004h> "]
[270.275153, "o", "        if total == 0:\r\n\u001b[?2004l\r"]
[270.275176, "o", "\u001b[?2004h> "]
[270.275263, "o", "            return 0.0\r\n\u001b[?2004l\r"]
[270.275286, "o", "\u001b[?2004h> "]
[270.275504, "o", "        score = (self.satisfied + self.tolerating / 2.0) / total\r\n\u001b[?2004l\r"]
[270.275531, "o", "\u001b[?2004h> "]
[270.275648, "o", "        return round(score, 2)\r\n\u001b[?2004l\r"]
[270.275671, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[270.275725, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[270.275845, "o", "def builder() -> ApdexAccumulator:\r\n\u001b[?2004l\r"]
[270.275867, "o", "\u001b[?2004h> "]
[270.275963, "o", "    return ApdexAccumulator()\r\n\u001b[?2004l\r"]
[270.275985, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[270.276038, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[270.276206, "o", "def folder(acc: ApdexAccumulator, value) -> ApdexAccumulator:\r\n\u001b[?2004l\r"]
[270.27623, "o", "\u001b[?2004h> "]
[270.276454, "o", "    \"\"\"Fold one ``(service, response_time_ms, ts)`` tuple into the accumulator.\"\"\"\r\n\u001b[?2004l\r"]
[270.276478, "o", "\u001b[?2004h> "]
[270.276573, "o", "    return acc.add(value[1])\r\n\u001b[?2004l\r"]
[270.276596, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[270.276652, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[270.276848, "o", "def merger(a: ApdexAccumulator, b: ApdexAccumulator) -> ApdexAccumulator:\r\n\u001b[?2004l\r"]
[270.276872, "o", "\u001b[?2004h> "]
[270.276942, "o", "    return a.merge(b)\r\n\u001b[?2004l\r"]
[270.276965, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[270.277018, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[270.277224, "o", "# ---------------------------------------------------------------------------\r\n\u001b[?2004l\r"]
[270.277247, "o", "\u001b[?2004h> "]
[270.277303, "o", "# Output sink\r\n\u001b[?2004l\r\u001b[?2004h"]
[270.277327, "o", "> "]
[270.277545, "o", "# ---------------------------------------------------------------------------\r\n\u001b[?2004l\r\u001b[?2004h"]
[270.277568, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h"]
[270.277624, "o", "> "]
[270.277733, "o", "class _NoopSinkPartition(StatelessSinkPartition):\r\n\u001b[?2004l\r"]
[270.277755, "o", "\u001b[?2004h> "]
[270.277881, "o", "    def write_batch(self, items) -> None:\r\n\u001b[?2004l\r"]
[270.277904, "o", "\u001b[?2004h> "]
[270.27797, "o", "        return None\r\n\u001b[?2004l\r"]
[270.277994, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[270.278048, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[270.27819, "o", "class JsonlFileSinkPartition(StatelessSinkPartition):\r\n\u001b[?2004l\r"]
[270.278212, "o", "\u001b[?2004h> "]
[270.278336, "o", "    def __init__(self, path: str) -> None:\r\n\u001b[?2004l\r"]
[270.278359, "o", "\u001b[?2004h> "]
[270.278438, "o", "        self._path = path\r\n\u001b[?2004l\r"]
[270.278462, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[270.278516, "o", "\u001b[?2004h> "]
[270.27862, "o", "    def write_batch(self, items) -> None:\r\n\u001b[?2004l\r"]
[270.278645, "o", "\u001b[?2004h> "]
[270.27881, "o", "        with open(self._path, \"a\", encoding=\"utf-8\") as fh:\r\n\u001b[?2004l\r"]
[270.278834, "o", "\u001b[?2004h> "]
[270.278925, "o", "            for item in items:\r\n\u001b[?2004l\r"]
[270.278948, "o", "\u001b[?2004h> "]
[270.279087, "o", "                fh.write(json.dumps(item) + \"\\n\")\r\n\u001b[?2004l\r"]
[270.279112, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[270.279168, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[270.279262, "o", "class JsonlFileSink(DynamicSink):\r\n\u001b[?2004l\r"]
[270.279284, "o", "\u001b[?2004h> "]
[270.279474, "o", "    \"\"\"A single-partition JSONL file sink (only worker 0 writes).\"\"\"\r\n\u001b[?2004l\r"]
[270.279496, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[270.279611, "o", "\u001b[?2004h> "]
[270.279692, "o", "    def __init__(self, path: str = OUTPUT_PATH) -> None:\r\n\u001b[?2004l\r"]
[270.279715, "o", "\u001b[?2004h> "]
[270.279795, "o", "        self._path = path\r\n\u001b[?2004l\r"]
[270.279818, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[270.279863, "o", "\u001b[?2004h> "]
[270.280004, "o", "    def build(self, step_id, worker_index, worker_count):\r\n\u001b[?2004l\r"]
[270.280026, "o", "\u001b[?2004h> "]
[270.280134, "o", "        if worker_index == 0:\r\n\u001b[?2004l\r\u001b[?2004h"]
[270.280161, "o", "> "]
[270.280314, "o", "            return JsonlFileSinkPartition(self._path)\r\n\u001b[?2004l\r\u001b[?2004h"]
[270.28034, "o", "> "]
[270.280439, "o", "        return _NoopSinkPartition()\r\n\u001b[?2004l\r\u001b[?2004h"]
[270.280463, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h"]
[270.280489, "o", "> \r\n\u001b[?2004l\r"]
[270.280569, "o", "\u001b[?2004h> "]
[270.280743, "o", "# ---------------------------------------------------------------------------\r\n\u001b[?2004l\r"]
[270.28077, "o", "\u001b[?2004h> "]
[270.280841, "o", "# Dataflow construction\r\n\u001b[?2004l\r"]
[270.280868, "o", "\u001b[?2004h> "]
[270.281075, "o", "# ---------------------------------------------------------------------------\r\n\u001b[?2004l\r"]
[270.281101, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[270.28115, "o", "> "]
[270.281231, "o", "def build_dataflow() -> Dataflow:\r\n\u001b[?2004l\r"]
[270.281255, "o", "\u001b[?2004h> "]
[270.281348, "o", "    flow = Dataflow(\"apdex\")\r\n\u001b[?2004l\r\u001b[?2004h"]
[270.281373, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h"]
[270.281422, "o", "> "]
[270.281591, "o", "    # 1. Load all input events into memory and feed them through a\r\n\u001b[?2004l\r"]
[270.281617, "o", "\u001b[?2004h> "]
[270.281822, "o", "    #    ``TestingSource`` (which is the simplest finite-source helper\r\n\u001b[?2004l\r\u001b[?2004h"]
[270.281848, "o", "> "]
[270.281927, "o", "    #    Bytewax provides).\r\n\u001b[?2004l\r"]
[270.281953, "o", "\u001b[?2004h> "]
[270.282076, "o", "    events = load_input_events(INPUT_PATH)\r\n\u001b[?2004l\r"]
[270.282102, "o", "\u001b[?2004h> "]
[270.282246, "o", "    up = op.input(\"in\", flow, TestingSource(events))\r\n\u001b[?2004l\r"]
[270.282274, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[270.2823, "o", "> "]
[270.282469, "o", "    # 2. Key by service so each service has its own windows.\r\n\u001b[?2004l\r"]
[270.282494, "o", "\u001b[?2004h> "]
[270.282666, "o", "    keyed = op.key_on(\"key_by_service\", up, lambda x: x[0])\r\n\u001b[?2004l\r\u001b[?2004h"]
[270.282692, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h"]
[270.282741, "o", "> "]
[270.28287, "o", "    # 3. Event-time clock using the embedded timestamp.\r\n\u001b[?2004l\r"]
[270.282896, "o", "\u001b[?2004h> "]
[270.282971, "o", "    clock = EventClock(\r\n\u001b[?2004l\r"]
[270.282997, "o", "\u001b[?2004h> "]
[270.283111, "o", "        ts_getter=lambda item: item[2],\r\n\u001b[?2004l\r"]
[270.283138, "o", "\u001b[?2004h> "]
[270.283291, "o", "        wait_for_system_duration=timedelta(seconds=0),\r\n\u001b[?2004l\r"]
[270.283318, "o", "\u001b[?2004h>     )\r\n"]
[270.283343, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[270.302813, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[270.302847, "o", "    # 4. 10-second tumbling windows aligned to the start of the first\r\n\u001b[?2004l\r"]
[270.302872, "o", "\u001b[?2004h> "]
[270.303005, "o", "    #    window that contains any event.\r\n\u001b[?2004l\r"]
[270.303028, "o", "\u001b[?2004h> "]
[270.303184, "o", "    epoch = datetime.fromtimestamp(0, tz=timezone.utc)\r\n\u001b[?2004l\r"]
[270.303207, "o", "\u001b[?2004h> "]
[270.303263, "o", "    if events:\r\n\u001b[?2004l\r"]
[270.303285, "o", "\u001b[?2004h> "]
[270.303417, "o", "        first_ts = min(ev[2] for ev in events)\r\n\u001b[?2004l\r"]
[270.303439, "o", "\u001b[?2004h> "]
[270.303488, "o", "    else:\r\n\u001b[?2004l\r\u001b[?2004h"]
[270.303512, "o", "> "]
[270.303602, "o", "        first_ts = epoch\r\n\u001b[?2004l\r\u001b[?2004h"]
[270.303629, "o", "> "]
[270.303801, "o", "    seconds_since_epoch = int((first_ts - epoch).total_seconds())\r\n\u001b[?2004l\r"]
[270.303825, "o", "\u001b[?2004h> "]
[270.303978, "o", "    window_seconds = int(WINDOW_LENGTH.total_seconds())\r\n\u001b[?2004l\r"]
[270.304003, "o", "\u001b[?2004h> "]
[270.304212, "o", "    snapped = seconds_since_epoch - (seconds_since_epoch % window_seconds)\r\n\u001b[?2004l\r"]
[270.304236, "o", "\u001b[?2004h> "]
[270.304375, "o", "    align_to = epoch + timedelta(seconds=snapped)\r\n\u001b[?2004l\r"]
[270.304399, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[270.304455, "o", "\u001b[?2004h> "]
[270.304529, "o", "    windower = TumblingWindower(\r\n\u001b[?2004l\r"]
[270.304556, "o", "\u001b[?2004h> "]
[270.304654, "o", "        length=WINDOW_LENGTH,\r\n\u001b[?2004l\r"]
[270.304677, "o", "\u001b[?2004h> "]
[270.30476, "o", "        align_to=align_to,\r\n\u001b[?2004l\r"]
[270.304782, "o", "\u001b[?2004h> "]
[270.304837, "o", "    )\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[270.304864, "o", "\u001b[?2004h> "]
[270.305033, "o", "    # 5. Fold each window of events into an ApdexAccumulator.\r\n\u001b[?2004l\r"]
[270.305056, "o", "\u001b[?2004h> "]
[270.30514, "o", "    windowed = fold_window(\r\n\u001b[?2004l\r"]
[270.305163, "o", "\u001b[?2004h> "]
[270.305234, "o", "        \"apdex_fold\",\r\n\u001b[?2004l\r"]
[270.305259, "o", "\u001b[?2004h> "]
[270.305311, "o", "        keyed,\r\n\u001b[?2004l\r"]
[270.305339, "o", "\u001b[?2004h> "]
[270.305395, "o", "        clock,\r\n\u001b[?2004l\r\u001b[?2004h"]
[270.30542, "o", "> "]
[270.305476, "o", "        windower,\r\n\u001b[?2004l\r\u001b[?2004h"]
[270.305499, "o", "> "]
[270.305578, "o", "        builder=builder,\r\n\u001b[?2004l\r"]
[270.305603, "o", "\u001b[?2004h> "]
[270.305673, "o", "        folder=folder,\r\n\u001b[?2004l\r"]
[270.305697, "o", "\u001b[?2004h> "]
[270.305768, "o", "        merger=merger,\r\n\u001b[?2004l\r"]
[270.305792, "o", "\u001b[?2004h> "]
[270.305846, "o", "    )\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[270.305869, "o", "\u001b[?2004h> "]
[270.306058, "o", "    # 6. ``windowed.down`` is a keyed stream. Items arriving look like\r\n\u001b[?2004l\r"]
[270.306081, "o", "\u001b[?2004h> "]
[270.30626, "o", "    #    ``(service, (window_id, acc))``. We use ``op.map`` (not\r\n\u001b[?2004l\r"]
[270.306283, "o", "\u001b[?2004h> "]
[270.306479, "o", "    #    ``map_value``) so the mapper receives the full keyed tuple and\r\n\u001b[?2004l\r"]
[270.306501, "o", "\u001b[?2004h> "]
[270.306706, "o", "    #    can recover the service key. ``window_start`` is computed from\r\n\u001b[?2004l\r"]
[270.306729, "o", "\u001b[?2004h> "]
[270.306924, "o", "    #    the window id (an integer index 0, 1, 2, ...) and ``align_to``.\r\n\u001b[?2004l\r"]
[270.306946, "o", "\u001b[?2004h> "]
[270.307039, "o", "    def project(item) -> dict:\r\n\u001b[?2004l\r"]
[270.307062, "o", "\u001b[?2004h> "]
[270.307179, "o", "        service, (window_id, acc) = item\r\n\u001b[?2004l\r"]
[270.307201, "o", "\u001b[?2004h> "]
[270.307367, "o", "        window_start = align_to + window_id * WINDOW_LENGTH\r\n\u001b[?2004l\r"]
[270.307389, "o", "\u001b[?2004h> "]
[270.307451, "o", "        return {\r\n\u001b[?2004l\r\u001b[?2004h"]
[270.307473, "o", "> "]
[270.307686, "o", "            \"window_start\": window_start.isoformat().replace(\"+00:00\", \"Z\"),\r\n\u001b[?2004l\r"]
[270.307708, "o", "\u001b[?2004h> "]
[270.307804, "o", "            \"service\": service,\r\n\u001b[?2004l\r"]
[270.307826, "o", "\u001b[?2004h> "]
[270.30794, "o", "            \"apdex_score\": acc.apdex(),\r\n\u001b[?2004l\r"]
[270.307963, "o", "\u001b[?2004h> "]
[270.308003, "o", "        }\r\n\u001b[?2004l\r"]
[270.308027, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[270.308089, "o", "\u001b[?2004h> "]
[270.308215, "o", "    results = op.map(\"project\", windowed.down, project)\r\n\u001b[?2004l\r"]
[270.30824, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[270.308297, "o", "\u001b[?2004h> "]
[270.3084, "o", "    # 7. Stream the results to a JSONL file.\r\n\u001b[?2004l\r"]
[270.308423, "o", "\u001b[?2004h> "]
[270.308596, "o", "    op.output(\"out\", results, JsonlFileSink(OUTPUT_PATH))\r\n\u001b[?2004l\r"]
[270.30862, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[270.308675, "o", "\u001b[?2004h> "]
[270.308702, "o", "    return flow\r\n\u001b[?2004l\r\u001b[?2004h"]
[270.308754, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[270.308778, "o", "\u001b[?2004h> "]
[270.308994, "o", "# ---------------------------------------------------------------------------\r\n\u001b[?2004l\r"]
[270.309017, "o", "\u001b[?2004h> "]
[270.309065, "o", "# Entrypoint\r\n\u001b[?2004l\r"]
[270.309091, "o", "\u001b[?2004h> "]
[270.309295, "o", "# ---------------------------------------------------------------------------\r\n\u001b[?2004l\r"]
[270.309318, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[270.309371, "o", "\u001b[?2004h> "]
[270.309412, "o", "def main() -> None:\r\n\u001b[?2004l\r"]
[270.309434, "o", "\u001b[?2004h> "]
[270.309546, "o", "    if os.path.exists(OUTPUT_PATH):\r\n\u001b[?2004l\r"]
[270.309585, "o", "\u001b[?2004h> "]
[270.30967, "o", "        os.remove(OUTPUT_PATH)\r\n\u001b[?2004l\r"]
[270.309693, "o", "\u001b[?2004h> "]
[270.309789, "o", "    run_main(build_dataflow())\r\n\u001b[?2004l\r"]
[270.309814, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[270.309869, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[270.309949, "o", "if __name__ == \"__main__\":\r\n\u001b[?2004l\r"]
[270.309972, "o", "\u001b[?2004h> "]
[270.310022, "o", "    main()\r\n\u001b[?2004l\r\u001b[?2004h"]
[270.310047, "o", "> PYEOF\r\n"]
[270.310101, "o", "\u001b[?2004l\r"]
[270.311565, "o", "\u001b[?2004hroot@12accb2e-00c6-4ecd-b227-db18e43324a9:/home/user/bytewax-apdex# "]
[270.753234, "i", "cd /home/user/bytewax-apdex && python apdex_flow.py\n"]
[270.753549, "o", "cd /home/user/bytewax-apdex && python apdex_flow.py\r\n\u001b[?2004l\r"]
[270.884232, "o", "\u001b[?2004hroot@12accb2e-00c6-4ecd-b227-db18e43324a9:/home/user/bytewax-apdex# "]
[280.263624, "i", "cat /home/user/bytewax-apdex/output.jsonl\n"]
[280.264094, "o", "cat /home/user/bytewax-apdex/output.jsonl\r\n\u001b[?2004l\r"]
[280.265423, "o", "{\"window_start\": \"2023-01-01T12:00:00Z\", \"service\": \"api\", \"apdex_score\": 0.5}\r\n{\"window_start\": \"2023-01-01T12:00:10Z\", \"service\": \"api\", \"apdex_score\": 1.0}\r\n{\"window_start\": \"2023-01-01T12:00:20Z\", \"service\": \"api\", \"apdex_score\": 1.0}\r\n{\"window_start\": \"2023-01-01T12:00:10Z\", \"service\": \"web\", \"apdex_score\": 0.75}\r\n"]
[280.265724, "o", "\u001b[?2004hroot@12accb2e-00c6-4ecd-b227-db18e43324a9:/home/user/bytewax-apdex# "]
[280.673602, "i", "echo '---' && cat /home/user/bytewax-apdex/input.jsonl\n"]
[280.674011, "o", "echo '---' && cat /home/user/bytewax-apdex/input.jsonl\r\n\u001b[?2004l\r"]
[280.674077, "o", "---\r\n"]
[280.675866, "o", "{\"timestamp\": \"2023-01-01T12:00:00Z\", \"service\": \"api\", \"response_time_ms\": 100}\r\n{\"timestamp\": \"2023-01-01T12:00:02Z\", \"service\": \"api\", \"response_time_ms\": 600}\r\n{\"timestamp\": \"2023-01-01T12:00:05Z\", \"service\": \"api\", \"response_time_ms\": 2500}\r\n{\"timestamp\": \"2023-01-01T12:00:11Z\", \"service\": \"api\", \"response_time_ms\": 300}\r\n{\"timestamp\": \"2023-01-01T12:00:12Z\", \"service\": \"web\", \"response_time_ms\": 400}\r\n{\"timestamp\": \"2023-01-01T12:00:14Z\", \"service\": \"web\", \"response_time_ms\": 1500}\r\n{\"timestamp\": \"2023-01-01T12:00:25Z\", \"service\": \"api\", \"response_time_ms\": 50}\r\n"]
[280.676134, "o", "\u001b[?2004h"]
[280.676163, "o", "root@12accb2e-00c6-4ecd-b227-db18e43324a9:/home/user/bytewax-apdex# "]
[287.802803, "i", "mv input.jsonl input_backup.jsonl && touch input.jsonl && python apdex_flow.py && echo '---' && ls -la output.jsonl && cat output.jsonl && mv input_backup.jsonl input.jsonl\n"]
[287.804424, "o", "mv input.jsonl input_backup.jsonl && touch input.jsonl && python apdex_flow.py && echo '---' && ls -la output.jsonl && cat output.jsonl && mv input_backup.jsonl input.jsonl\r\n\u001b[?2004l\r"]
[287.946046, "o", "---\r\n"]
[287.947969, "o", "ls: cannot access 'output.jsonl': No such file or directory\r\n"]
[287.948305, "o", "\u001b[?2004hroot@12accb2e-00c6-4ecd-b227-db18e43324a9:/home/user/bytewax-apdex# "]
[297.51035, "i", "ls -la /home/user/bytewax-apdex/\n"]
[297.510573, "o", "ls -la /home/user/bytewax-apdex/\r\n\u001b[?2004l\r"]
