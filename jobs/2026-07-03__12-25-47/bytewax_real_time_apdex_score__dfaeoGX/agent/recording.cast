[126.707756, "o", "python3 -c \"from bytewax.operators.windowing import WindowOut; import inspect; print(inspect.getsource(WindowOut))\" 2>&1 | head -80\r\n\u001b[?2004l\r"]
[126.827334, "o", "@dataclass(frozen=True)\r\nclass WindowOut(Generic[V, W_co]):\r\n    \"\"\"Streams returned from a windowing operator.\"\"\"\r\n\r\n    down: KeyedStream[Tuple[int, W_co]]\r\n    \"\"\"Items emitted from this operator.\r\n\r\n    Sub-keyed by window ID.\r\n    \"\"\"\r\n\r\n    late: KeyedStream[Tuple[int, V]]\r\n    \"\"\"Upstreams items that were deemed late for a window.\r\n\r\n    It's possible you will see window IDs here that were never in the\r\n    `down` or `meta` streams, depending on the specifics of the\r\n    ordering of the data.\r\n\r\n    Sub-keyed by window ID.\"\"\"\r\n\r\n    meta: KeyedStream[Tuple[int, WindowMetadata]]\r\n    \"\"\"Metadata about closed windows.\r\n\r\n    Emitted once when that window closes. Not emitted for original\r\n    windows that are merged into another window. The target window's\r\n    {py:obj}`~bytewax.operators.windowing.WindowMetadata` will have\r\n    the original window IDs in\r\n    {py:obj}`~bytewax.operators.windowing.WindowMetadata.merged_ids`.\r\n\r\n    Sub-keyed by window ID.\r\n    \"\"\"\r\n\r\n"]
[126.839686, "o", "\u001b[?2004hroot@12accb2e-00c6-4ecd-b227-db18e43324a9:/home/user/bytewax-apdex# "]
[136.347402, "i", "cat > /tmp/test_debug.py << 'EOF'\nimport json\nimport os\nfrom datetime import datetime, timedelta, timezone\nfrom bytewax.dataflow import Dataflow\nimport bytewax.operators as op\nfrom bytewax.operators.windowing import EventClock, TumblingWindower, fold_window\nfrom bytewax.testing import TestingSource, run_main\n\nINPUT_PATH = \"input.jsonl\"\nOUTPUT_PATH = \"output.jsonl\"\nWINDOW_LENGTH = timedelta(seconds=10)\n\nclass Acc:\n    __slots__ = (\"s\", \"t\", \"f\")\n    def __init__(self):\n        self.s = self.t = self.f = 0\n    def add(self, rt):\n        if rt <= 500: self.s += 1\n        elif rt <= 2000: self.t += 1\n        else: self.f += 1\n        return self\n    def merge(self, o):\n        self.s += o.s; self.t += o.t; self.f += o.f\n        return self\n\ndef builder(): return Acc()\ndef folder(a, v): return a.add(v[1])\ndef merger(a, b): return a.merge(b)\n\nflow = Dataflow(\"d\")\nevents = []\nwith open(INPUT_PATH) as fh:\n    for line in fh:\n        line = line.strip()\n        if not line: continue\n        r = json.loads(line)\n        ts = datetime.fromisoformat(line[line.index('\"timestamp\"'):line.index(',')].split(': ',1)[1].strip('\"'))\n        # Simpler parse:\n        ts = datetime.fromisoformat(r[\"timestamp\"].replace(\"Z\", \"+00:00\"))\n        if ts.tzinfo is None: ts = ts.replace(tzinfo=timezone.utc)\n        events.append((r[\"service\"], int(r[\"response_time_ms\"]), ts))\nprint(\"events:\", events)\n\nup = op.input(\"in\", flow, TestingSource(events))\nkeyed = op.key_on(\"k\", up, lambda x: x[0])\nclock = EventClock(ts_getter=lambda x: x[2], wait_for_system_duration=timedelta(0))\nepoch = datetime.fromtimestamp(0, tz=timezone.utc)\nalign = events[0][2]\nsecs = int((align - epoch).total_seconds())\nsnapped = secs - (secs % 10)\nalign = epoch + timedelta(seconds=snapped)\nwin = TumblingWindower(length=WINDOW_LENGTH, align_to=align)\nwindowed = fold_window(\"w\", keyed, clock, win, builder=builder, folder=folder, merger=merger)\n\nop.inspect(\"down\", windowed.down)\nop.inspect(\"meta\", windowed.meta)\n\nrun_main(flow)\nEOF\npython /tmp/test_debug.py 2>&1 | head -50\n"]
