[159.741106, "o", "> "]
[159.74123, "o", "            if not raw:\r\n\u001b[?2004l\r"]
[159.741289, "o", "\u001b[?2004h"]
[159.741316, "o", "> "]
[159.741446, "o", "                continue\r\n\u001b[?2004l\r"]
[159.741506, "o", "\u001b[?2004h"]
[159.741557, "o", "> "]
[159.741728, "o", "            record = json.loads(raw)\r\n\u001b[?2004l\r"]
[159.741782, "o", "\u001b[?2004h> "]
[159.742082, "o", "            ts = _parse_timestamp(record[\"timestamp\"])\r\n\u001b[?2004l\r"]
[159.742144, "o", "\u001b[?2004h"]
[159.742174, "o", "> "]
[159.742308, "o", "            events.append(\r\n\u001b[?2004l\r"]
[159.742339, "o", "\u001b[?2004h"]
[159.742413, "o", "> "]
[159.742784, "o", "                (record[\"service\"], int(record[\"response_time_ms\"]), ts)\r\n\u001b[?2004l\r"]
[159.742815, "o", "\u001b[?2004h> "]
[159.742922, "o", "            )\r\n\u001b[?2004l\r"]
[159.74298, "o", "\u001b[?2004h"]
[159.743008, "o", "> "]
[159.743099, "o", "    return events\r\n\u001b[?2004l\r"]
[159.74313, "o", "\u001b[?2004h"]
[159.743199, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[159.743254, "o", "\u001b[?2004h> "]
[159.74368, "o", "# -----------------------------------------------------------------------\r\n\u001b[?2004l\r"]
[159.743711, "o", "\u001b[?2004h"]
[159.743788, "o", "> "]
[159.74394, "o", "# Window-state / Apdex accumulator\r\n\u001b[?2004l\r"]
[159.743998, "o", "\u001b[?2004h"]
[159.744052, "o", "> "]
[159.744418, "o", "# -----------------------------------------------------------------------\r\n\u001b[?2004l\r"]
[159.744465, "o", "\u001b[?2004h"]
[159.744486, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h"]
[159.744516, "o", "> "]
[159.744758, "o", "class ApdexAccumulator:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[159.745193, "o", "    \"\"\"A per-window tally of satisfied/tolerating/frustrated counts.\"\"\"\r\n\u001b[?2004l\r\u001b[?2004h"]
[159.745282, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[159.745639, "o", "    __slots__ = (\"satisfied\", \"tolerating\", \"frustrated\")\r\n\u001b[?2004l\r\u001b[?2004h"]
[159.745727, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[159.74593, "o", "    def __init__(self) -> None:\r\n\u001b[?2004l\r\u001b[?2004h"]
[159.746017, "o", "> "]
[159.746163, "o", "        self.satisfied: int = 0\r\n\u001b[?2004l\r\u001b[?2004h"]
[159.746247, "o", "> "]
[159.746415, "o", "        self.tolerating: int = 0\r\n\u001b[?2004l\r"]
[159.746474, "o", "\u001b[?2004h> "]
[159.746682, "o", "        self.frustrated: int = 0\r\n\u001b[?2004l\r\u001b[?2004h"]
[159.746765, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[159.747135, "o", "    def add(self, response_time_ms: int) -> \"ApdexAccumulator\":\r\n\u001b[?2004l\r"]
[159.747189, "o", "\u001b[?2004h> "]
[159.747486, "o", "        if response_time_ms <= APDEX_SATISFIED_MAX:\r\n\u001b[?2004l\r\u001b[?2004h"]
[159.747595, "o", "> "]
[159.747712, "o", "            self.satisfied += 1\r\n\u001b[?2004l\r\u001b[?2004h"]
[159.747815, "o", "> "]
[159.748045, "o", "        elif response_time_ms <= APDEX_TOLERATING_MAX:\r\n\u001b[?2004l\r\u001b[?2004h"]
[159.748129, "o", "> "]
[159.748308, "o", "            self.tolerating += 1\r\n\u001b[?2004l\r\u001b[?2004h"]
[159.748379, "o", "> "]
[159.748446, "o", "        else:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[159.748686, "o", "            self.frustrated += 1\r\n\u001b[?2004l\r"]
[159.748763, "o", "\u001b[?2004h> "]
[159.74886, "o", "        return self\r\n\u001b[?2004l\r"]
[159.748936, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[159.749355, "o", "    def merge(self, other: \"ApdexAccumulator\") -> \"ApdexAccumulator\":\r\n\u001b[?2004l\r\u001b[?2004h"]
[159.749431, "o", "> "]
[159.749655, "o", "        self.satisfied += other.satisfied\r\n\u001b[?2004l\r"]
[159.749728, "o", "\u001b[?2004h> "]
[159.749961, "o", "        self.tolerating += other.tolerating\r\n\u001b[?2004l\r"]
[159.750053, "o", "\u001b[?2004h> "]
[159.750264, "o", "        self.frustrated += other.frustrated\r\n\u001b[?2004l\r"]
[159.750361, "o", "\u001b[?2004h> "]
[159.750455, "o", "        return self\r\n\u001b[?2004l\r\u001b[?2004h"]
[159.750568, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[159.750715, "o", "    def apdex(self) -> float:\r\n\u001b[?2004l\r\u001b[?2004h"]
[159.750809, "o", "> "]
[159.751126, "o", "        total = self.satisfied + self.tolerating + self.frustrated\r\n\u001b[?2004l\r\u001b[?2004h"]
[159.751205, "o", "> "]
[159.751319, "o", "        if total == 0:\r\n\u001b[?2004l\r\u001b[?2004h"]
[159.751399, "o", "> "]
[159.751503, "o", "            return 0.0\r\n\u001b[?2004l\r\u001b[?2004h"]
[159.751601, "o", "> "]
[159.751921, "o", "        score = (self.satisfied + self.tolerating / 2.0) / total\r\n\u001b[?2004l\r\u001b[?2004h"]
[159.752018, "o", "> "]
[159.752163, "o", "        return round(score, 2)\r\n\u001b[?2004l\r\u001b[?2004h"]
[159.752234, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[159.752302, "o", "\u001b[?2004h> "]
[159.752477, "o", "def builder() -> ApdexAccumulator:\r\n\u001b[?2004l\r\u001b[?2004h"]
[159.752552, "o", "> "]
[159.75269, "o", "    return ApdexAccumulator()\r\n\u001b[?2004l\r\u001b[?2004h> "]
[159.752755, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[159.752831, "o", "\u001b[?2004h> "]
[159.753128, "o", "def folder(acc: ApdexAccumulator, value) -> ApdexAccumulator:\r\n\u001b[?2004l\r\u001b[?2004h"]
[159.753193, "o", "> "]
[159.753551, "o", "    # ``value`` comes from the keyed upstream stream and is the original\r\n\u001b[?2004l\r\u001b[?2004h"]
[159.753619, "o", "> "]
[159.753835, "o", "    # 3-tuple ``(service, response_time_ms, ts)``.\r\n\u001b[?2004l\r"]
[159.753899, "o", "\u001b[?2004h> "]
[159.754038, "o", "    return acc.add(value[1])\r\n\u001b[?2004l\r"]
[159.7541, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[159.754173, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[159.754558, "o", "def merger(a: ApdexAccumulator, b: ApdexAccumulator) -> ApdexAccumulator:\r\n\u001b[?2004l\r\u001b[?2004h"]
[159.754624, "o", "> "]
[159.754693, "o", "    return a.merge(b)\r\n\u001b[?2004l\r"]
[159.754759, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[159.754829, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[159.755212, "o", "# -----------------------------------------------------------------------\r\n\u001b[?2004l\r\u001b[?2004h"]
[159.75528, "o", "> "]
[159.755344, "o", "# Output sink\r\n\u001b[?2004l\r\u001b[?2004h> "]
[159.755743, "o", "# -----------------------------------------------------------------------\r\n\u001b[?2004l\r\u001b[?2004h"]
[159.755809, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[159.75609, "o", "class _NoopSinkPartition(StatelessSinkPartition):\r\n\u001b[?2004l\r"]
[159.756159, "o", "\u001b[?2004h> "]
[159.756357, "o", "    def write_batch(self, items) -> None:\r\n\u001b[?2004l\r\u001b[?2004h"]
[159.756415, "o", "> "]
[159.756588, "o", "        return None\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[159.756651, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[159.756921, "o", "class JsonlFileSinkPartition(StatelessSinkPartition):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[159.757135, "o", "    def __init__(self, path: str) -> None:\r\n\u001b[?2004l\r\u001b[?2004h"]
[159.757199, "o", "> "]
[159.757399, "o", "        self._path = path\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[159.7576, "o", "    def write_batch(self, items) -> None:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[159.757885, "o", "        with open(self._path, \"a\", encoding=\"utf-8\") as fh:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[159.758061, "o", "            for item in items:\r\n\u001b[?2004l\r\u001b[?2004h"]
[159.758126, "o", "> "]
[159.75833, "o", "                fh.write(json.dumps(item) + \"\\n\")\r\n\u001b[?2004l\r\u001b[?2004h> \r\n"]
[159.758409, "o", "\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[159.758493, "o", "> "]
[159.758748, "o", "class JsonlFileSink(DynamicSink):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[159.758967, "o", "    \"\"\"A single-partition JSONL file sink (only worker 0 writes).\"\"\"\r\n\u001b[?2004l\r\u001b[?2004h"]
[159.759102, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[159.759324, "o", "    def __init__(self, path: str = OUTPUT_PATH) -> None:\r\n\u001b[?2004l\r\u001b[?2004h"]
[159.759396, "o", "> "]
[159.7596, "o", "        self._path = path\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[159.759875, "o", "    def build(self, step_id, worker_index, worker_count):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[159.760027, "o", "        if worker_index == 0:\r\n\u001b[?2004l\r\u001b[?2004h"]
[159.760103, "o", "> "]
[159.760287, "o", "            return JsonlFileSinkPartition(self._path)\r\n\u001b[?2004l\r\u001b[?2004h"]
[159.760362, "o", "> "]
[159.760516, "o", "        return _NoopSinkPartition()\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[159.760602, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[159.803087, "o", "# -----------------------------------------------------------------------\r\n\u001b[?2004l\r\u001b[?2004h> # Dataflow construction\r\n\u001b[?2004l\r\u001b[?2004h> # -----------------------------------------------------------------------\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> def build_dataflow() -> Dataflow:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[159.803297, "o", "    flow = Dataflow(\"apdex\")\r\n\u001b[?2004l\r"]
[159.803476, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[159.803561, "o", "> "]
[159.803922, "o", "    # 1. Load all input events into memory and feed via TestingSource.\r\n\u001b[?2004l\r"]
[159.80398, "o", "\u001b[?2004h> "]
[159.804281, "o", "    events = load_input_events(INPUT_PATH)\r\n\u001b[?2004l\r"]
[159.804339, "o", "\u001b[?2004h> "]
[159.804758, "o", "    up = op.input(\"in\", flow, TestingSource(events))\r\n\u001b[?2004l\r"]
[159.804817, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[159.804873, "o", "\u001b[?2004h> "]
[159.805298, "o", "    # 2. Key by service so each service has its own windows.\r\n\u001b[?2004l\r"]
[159.80535, "o", "\u001b[?2004h> "]
[159.805782, "o", "    keyed = op.key_on(\"key_by_service\", up, lambda x: x[0])\r\n\u001b[?2004l\r"]
[159.805848, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[159.80597, "o", "> "]
[159.806291, "o", "    # 3. Event-time clock using the embedded timestamp.\r\n\u001b[?2004l\r"]
[159.806349, "o", "\u001b[?2004h> "]
[159.806516, "o", "    clock = EventClock(\r\n\u001b[?2004l\r"]
[159.806582, "o", "\u001b[?2004h> "]
[159.80687, "o", "        ts_getter=lambda item: item[2],\r\n\u001b[?2004l\r"]
[159.806978, "o", "\u001b[?2004h> "]
[159.807294, "o", "        wait_for_system_duration=timedelta(seconds=0),\r\n\u001b[?2004l\r"]
[159.807394, "o", "\u001b[?2004h>     )\r\n\u001b[?2004l\r"]
[159.807483, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[159.807992, "o", "    # 4. 10-second tumbling windows aligned to the start of the first\r\n\u001b[?2004l\r"]
[159.80805, "o", "\u001b[?2004h> "]
[159.80832, "o", "    #    window that contains any event.\r\n\u001b[?2004l\r"]
[159.808375, "o", "\u001b[?2004h> "]
[159.808753, "o", "    epoch = datetime.fromtimestamp(0, tz=timezone.utc)\r\n\u001b[?2004l\r"]
[159.80881, "o", "\u001b[?2004h> "]
[159.808917, "o", "    if events:\r\n\u001b[?2004l\r"]
[159.808973, "o", "\u001b[?2004h> "]
[159.809298, "o", "        first_ts = min(ev[2] for ev in events)\r\n\u001b[?2004l\r"]
[159.809354, "o", "\u001b[?2004h> "]
[159.809458, "o", "    else:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[159.809667, "o", "        first_ts = epoch\r\n\u001b[?2004l\r"]
[159.809726, "o", "\u001b[?2004h> "]
[159.810175, "o", "    seconds_since_epoch = int((first_ts - epoch).total_seconds())\r\n\u001b[?2004l\r"]
[159.810236, "o", "\u001b[?2004h> "]
[159.810614, "o", "    window_seconds = int(WINDOW_LENGTH.total_seconds())\r\n\u001b[?2004l\r"]
[159.810671, "o", "\u001b[?2004h> "]
[159.811181, "o", "    snapped = seconds_since_epoch - (seconds_since_epoch % window_seconds)\r\n\u001b[?2004l\r"]
[159.811264, "o", "\u001b[?2004h> "]
[159.811572, "o", "    align_to = epoch + timedelta(seconds=snapped)\r\n\u001b[?2004l\r"]
[159.811637, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[159.811815, "o", "\u001b[?2004h> "]
[159.811929, "o", "    windower = TumblingWindower(\r\n\u001b[?2004l\r\u001b[?2004h"]
[159.811984, "o", "> "]
[159.812168, "o", "        length=WINDOW_LENGTH,\r\n\u001b[?2004l\r"]
[159.812275, "o", "\u001b[?2004h> "]
[159.812416, "o", "        align_to=align_to,\r\n\u001b[?2004l\r"]
[159.81247, "o", "\u001b[?2004h> "]
[159.812645, "o", "    )\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[159.813059, "o", "    # 5. Fold each window of events into an ApdexAccumulator.\r\n\u001b[?2004l\r"]
[159.813117, "o", "\u001b[?2004h> "]
[159.8133, "o", "    windowed = fold_window(\r\n\u001b[?2004l\r"]
[159.813359, "o", "\u001b[?2004h> "]
[159.813512, "o", "        \"apdex_fold\",\r\n\u001b[?2004l\r"]
[159.813614, "o", "\u001b[?2004h> "]
[159.813779, "o", "        keyed,\r\n\u001b[?2004l\r\u001b[?2004h> "]
[159.813873, "o", "        clock,\r\n\u001b[?2004l\r"]
[159.813927, "o", "\u001b[?2004h> "]
[159.814047, "o", "        windower,\r\n\u001b[?2004l\r"]
[159.814107, "o", "\u001b[?2004h> "]
[159.814315, "o", "        builder=builder,\r\n\u001b[?2004l\r\u001b[?2004h> "]
[159.81449, "o", "        folder=folder,\r\n\u001b[?2004l\r"]
[159.814625, "o", "\u001b[?2004h> "]
[159.814724, "o", "        merger=merger,\r\n\u001b[?2004l\r"]
[159.814784, "o", "\u001b[?2004h> "]
[159.814907, "o", "    )\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[159.814973, "o", "\u001b[?2004h> "]
[159.815561, "o", "    # 6. Project each emitted item ``(service, (window_id, acc))`` into\r\n\u001b[?2004l\r"]
[159.815621, "o", "\u001b[?2004h> "]
[159.816146, "o", "    #    the final output schema. ``window_start`` is computed from the\r\n\u001b[?2004l\r"]
[159.816209, "o", "\u001b[?2004h> "]
[159.816882, "o", "    #    window id (the index 0, 1, 2, ...) and the aligned base time.\r\n\u001b[?2004l\r\u001b[?2004h"]
[159.817038, "o", "> "]
[159.817208, "o", "    def project(item) -> dict:\r\n\u001b[?2004l\r"]
[159.81728, "o", "\u001b[?2004h> "]
[159.817511, "o", "        service, (window_id, acc) = item\r\n\u001b[?2004l\r"]
[159.817586, "o", "\u001b[?2004h> "]
[159.818071, "o", "        window_start = align_to + window_id * WINDOW_LENGTH\r\n\u001b[?2004l\r"]
[159.818142, "o", "\u001b[?2004h> "]
[159.818283, "o", "        return {\r\n\u001b[?2004l\r"]
[159.818347, "o", "\u001b[?2004h> "]
[159.818945, "o", "            \"window_start\": window_start.isoformat().replace(\"+00:00\", \"Z\"),\r\n\u001b[?2004l\r"]
[159.819028, "o", "\u001b[?2004h> "]
[159.819314, "o", "            \"service\": service,\r\n\u001b[?2004l\r"]
[159.819393, "o", "\u001b[?2004h> "]
[159.819778, "o", "            \"apdex_score\": acc.apdex(),\r\n\u001b[?2004l\r"]
[159.819853, "o", "\u001b[?2004h> "]
[159.819963, "o", "        }\r\n\u001b[?2004l\r"]
[159.820034, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[159.8201, "o", "\u001b[?2004h> "]
[159.82071, "o", "    results = op.map_value(\"project\", windowed.down, project)\r\n\u001b[?2004l\r\u001b[?2004h"]
[159.820812, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[159.821252, "o", "    # 7. Stream the results to a JSONL file.\r\n\u001b[?2004l\r"]
[159.821359, "o", "\u001b[?2004h> "]
[159.821861, "o", "    op.output(\"out\", results, JsonlFileSink(OUTPUT_PATH))\r\n\u001b[?2004l\r"]
[159.821929, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[159.821991, "o", "\u001b[?2004h> "]
