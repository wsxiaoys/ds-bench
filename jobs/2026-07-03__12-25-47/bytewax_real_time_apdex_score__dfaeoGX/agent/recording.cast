[136.477397, "o", "events: [('api', 100, datetime.datetime(2023, 1, 1, 12, 0, tzinfo=datetime.timezone.utc)), ('api', 600, datetime.datetime(2023, 1, 1, 12, 0, 2, tzinfo=datetime.timezone.utc)), ('api', 2500, datetime.datetime(2023, 1, 1, 12, 0, 5, tzinfo=datetime.timezone.utc)), ('api', 300, datetime.datetime(2023, 1, 1, 12, 0, 11, tzinfo=datetime.timezone.utc)), ('web', 400, datetime.datetime(2023, 1, 1, 12, 0, 12, tzinfo=datetime.timezone.utc)), ('web', 1500, datetime.datetime(2023, 1, 1, 12, 0, 14, tzinfo=datetime.timezone.utc)), ('api', 50, datetime.datetime(2023, 1, 1, 12, 0, 25, tzinfo=datetime.timezone.utc))]\r\nd.down: ('api', (0, <__main__.Acc object at 0x746c5b8ad900>))\r\nd.meta: ('api', (0, WindowMetadata(open_time=datetime.datetime(2023, 1, 1, 12, 0, tzinfo=datetime.timezone.utc), close_time=datetime.datetime(2023, 1, 1, 12, 0, 10, tzinfo=datetime.timezone.utc), merged_ids=set())))\r\n"]
