[31.020853, "o", "root@fffd77b8-bb2f-4ce3-a952-a12f1d1f4aa4:~# "]
[34.976091, "i", "python -c \"import inspect; from bytewax.connectors.stdio import _PrintSinkPartition; print(inspect.getsource(_PrintSinkPartition))\"\n"]
[34.976649, "o", "python -c \"import inspect; from bytewax.connectors.stdio import _PrintSinkPartition; print(inspect.getsource(_PrintSinkPartition))\"\r\n\u001b[?2004l\r"]
[35.002551, "o", "class _PrintSinkPartition(StatelessSinkPartition[Any]):\r\n    @override\r\n    def write_batch(self, items: List[Any]) -> None:\r\n        for item in items:\r\n            line = str(item)\r\n            sys.stdout.write(line)\r\n            sys.stdout.write(\"\\n\")\r\n        sys.stdout.flush()\r\n\r\n"]
[35.007013, "o", "\u001b[?2004hroot@fffd77b8-bb2f-4ce3-a952-a12f1d1f4aa4:~# "]
[45.293617, "i", "cat > /home/user/bytewax_project/pipeline.py << 'EOF'\nimport json\nfrom bytewax import operators as op\nfrom bytewax.connectors.files import FileSource\nfrom bytewax.connectors.stdio import StdOutSink\nfrom bytewax.dataflow import Dataflow\n\nflow = Dataflow(\"multi_stage_agg\")\n\n# Stage 0: Read input.jsonl line by line and parse JSON\ninp = op.input(\n    \"input\",\n    flow,\n    FileSource(\"input.jsonl\"),\n)\n\n# Parse each line (string) into a dict\nparsed = op.map(\"parse_json\", inp, lambda line: json.loads(line))\n\n# Stage 1: Local Aggregation by sensor_id\n# Map dict to (sensor_id, val) tuple to create a KeyedStream\nkeyed = op.map(\"key_on_sensor\", parsed, lambda rec: (rec[\"sensor_id\"], rec[\"val\"]))\n\n# Use reduce_final for finite stream aggregation\n# reducer: combine two values; initializer is None - but reduce_final needs an initial value\n# Use fold_final with init 0 and step function (acc, val) -> acc + val\nlocal_sums = op.fold_final(\n    \"local_sum\",\n    keyed,\n    lambda key: 0,\n    lambda acc, val: acc + val,\n)\n\n# Stage 2: Global Aggregation\n# Re-key all items to \"global\"\nglobal_keyed = op.key_on(\"rekey_global\", local_sums, lambda item: \"global\")\n\n# Compute the grand total\ngrand_total = op.fold_final(\n    \"global_sum\",\n    global_keyed,\n    lambda key: 0,\n    lambda acc, val: acc + val,\n)\n\n# Output to stdout - map to string so StdOutSink handles it\nop.output(\"stdout\", grand_total, StdOutSink())\nEOF\n"]
