[?2004hroot@e0ef87fb-6001-456a-a9d4-d5917e74da75:~# cat > /home/user/remix.py << 'EOF'
[?2004l[?2004h> import numpy as np
[?2004l[?2004h> import librosa
[?2004l[?2004h> import soundfile as sf
[?2004l[?2004h> 
[?2004l[?2004h> # Step 0: Read input preserving native sample rate
[?2004l[?2004h> input_path = '/home/user/input.wav'
[?2004l[?2004h> y, sr = librosa.load(input_path, sr=None)
[?2004l[?2004h> print(f"Loaded audio: len={len(y)}, sr={sr}")
[?2004l[?2004h> 
[?2004l[?2004h> # Step 1: HPSS with margin=(1.0, 5.0) - strong percussive mask
[?2004l[?2004h> harmonic, percussive = librosa.effects.hpss(y, margin=(1.0, 5.0))
[?2004l[?2004h> print(f"HPSS done. harmonic len={len(harmonic)}, percussive len={len(percussive)}")
[?2004l[?2004h> 
[?2004l[?2004h> # Step 2: Pitch-shift harmonic up by 7 semitones
[?2004l[?2004h> harmonic_shifted = librosa.effects.pitch_shift(harmonic, sr=sr, n_steps=7)
[?2004l[?2004h> print(f"Pitch-shifted harmonic len={len(harmonic_shifted)}")
[?2004l[?2004h> 
[?2004l[?2004h> # Step 3: Time-stretch percussive by 0.85 (slow down)
[?2004l[?2004h> percussive_stretched = librosa.effects.time_stretch(percussive, rate=0.85)
[?2004l[?2004h> print(f"Time-stretched percussive len={len(percussive_stretched)}")
[?2004l[?2004h> 
[?2004l[?2004h> # Step 4: Align lengths to original input length
[?2004l[?2004h> target_len = len(y)
[?2004l[?2004h> 
[?2004l[?2004h> def align_length(sig, target):
[?2004l[?2004h>     if len(sig) < target:
[?2004l[?2004h>         # pad with zeros
[?2004l[?2004h>         out = np.zeros(target, dtype=sig.dtype)
[?2004l[?2004h>         out[:len(sig)] = sig
[?2004l[?2004h>         return out
[?2004l[?2004h>     else:
[?2004l[?2004h>         return sig[:target]
[?2004l[?2004h> 
[?2004l[?2004h> h_aligned = align_length(harmonic_shifted, target_len)
[?2004l[?2004h> p_aligned = align_length(percussive_stretched, target_len)
[?2004l[?2004h> 
[?2004l[?2004h> mix = 0.7 * h_aligned + 0.5 * p_aligned
[?2004l[?2004h> print(f"Mix len={len(mix)}")
[?2004l[?2004h> 
[?2004l[?2004h> # Step 5: Trim leading/trailing silence with top_db=30
[?2004l[?2004h> mix_trimmed, _ = librosa.effects.trim(mix, top_db=30)
[?2004l[?2004h> print(f"Trimmed mix len={len(mix_trimmed)}")
[?2004l[?2004h> 
[?2004l[?2004h> # Step 6: Write to output.wav at same sample rate
[?2004l[?2004h> sf.write('/home/user/output.wav', mix_trimmed, sr)
[?2004l[?2004h> print("Done. Wrote /home/user/output.wav")
