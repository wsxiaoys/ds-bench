[568.224627, "o", "            this.impl.removeItem(oldkey);\r\n        }\r\n    }\r\n    get impl() {\r\n        return window.localStorage;\r\n    }\r\n    get prefix() {\r\n        return this.group === 'NativeStorage' ? '' : `${this.group}.`;\r\n    }\r\n    rawKeys() {\r\n        return Object.keys(this.impl).filter((k) => k.indexOf(this.prefix) === 0);\r\n    }\r\n    applyPrefix(key) {\r\n        return this.prefix + key;\r\n    }\r\n}\r\n"]
