[444.546021, "i", "cat > /tmp/test_gallery2.py << 'EOF'\nimport asyncio\nfrom playwright.async_api import async_playwright\nimport base64\nimport os\nimport re\n\nJPEG_B64 = (\n    \"/9j/4AAQSkZJRgABAQEAYABgAAD/2wBDAAEBAQEBAQEBAQEBAQEBAQEBAQEBAQEBAQEBAQEBAQEB\"\n    \"AQEBAQEBAQEBAQEBAQEBAQEBAQEBAQEBAQEBAQEBAQEBAQEBAQEB/9sAQwEBAQEBAQEBAQEBAQEB\"\n    \"AQEBAQEBAQEBAQEBAQEBAQEBAQEBAQEBAQEBAQEBAQEBAQEBAQEBAQEBAQEBAQEBAQEBAQEB/8AA\"\n    \"QECAwQFBgcICQoL/8QAFQABAQAAAAAAAAAAAAAAAAAAAAv/xAAUEAEAAAAAAAAAAAAAAAAAAAAA/9o\"\n    \"ADAMBAAIRAxEAPwBVAAH//9k=\"\n)\n\ndef make_jpeg():\n    b64 = JPEG_B64 + \"=\" * (-len(JPEG_B64) % 4)\n    jpeg_bytes = base64.b64decode(b64)\n    path = '/tmp/test2.jpg'\n    with open(path, 'wb') as f:\n        f.write(jpeg_bytes)\n    return path\n\nasync def dump_idb(page):\n    \"\"\"Dump all IndexedDB databases and their contents.\"\"\"\n    return await page.evaluate(\"\"\"async () => {\n        const result = {};\n        const dbs = await indexedDB.databases();\n        for (const d of dbs) {\n            const db = await new Promise((resolve, reject) => {\n                const req = indexedDB.open(d.name);\n                req.onsuccess = () => resolve(req.result);\n                req.onerror = () => reject(req.error);\n            });\n            const stores = Array.from(db.objectStoreNames);\n            result[d.name] = {};\n            for (const s of stores) {\n                const tx = db.transaction(s, 'readonly');\n                const store = tx.objectStore(s);\n                const items = await new Promise((resolve, reject) => {\n                    const req = store.getAll();\n                    req.onsuccess = () => resolve(req.result);\n                    req.onerror = () => reject(req.error);\n                });\n                result[d.name][s] = items;\n            }\n            db.close();\n        }\n        return result;\n    }\"\"\")\n\nasync def main():\n    jpeg_path = make_jpeg()\n    print(f\"Created test JPEG: {jpeg_path}, size: {os.path.getsize(jpeg_path)} bytes\")\n    \n    async with async_playwright() as p:\n        browser = await p.chromium.launch(headless=True, args=['--no-sandbox'])\n        context = await browser.new_context()\n        page = await context.new_page()\n        \n        page.on('console', lambda msg: print(f\"[console.{msg.type}]: {msg.text}\"))\n        \n        await page.goto('http://127.0.0.1:4173/')\n        await page.wait_for_load_state('networkidle')\n        \n        async with page.expect_file_chooser() as fc_info:\n            click_task = asyncio.create_task(page.click('#capture-btn'))\n        file_chooser = await fc_info.value\n        await file_chooser.set_files(jpeg_path)\n        await click_task\n        \n        await page.wait_for_function(\n            \"() => document.getElementById('capture-status').textContent === 'saved'\",\n            timeout=15000\n        )\n        \n        photos = await page.evaluate(\"window.gallery.listPhotos()\")\n        print(f\"Photos: {photos}\")\n        \n        idb = await dump_idb(page)\n        print(\"IndexedDB contents:\")\n        for db_name, stores in idb.items():\n            print(f\"  DB: {db_name}\")\n            for store, items in stores.items():\n                print(f\"    Store: {store} ({len(items)} items)\")\n                for item in items[:5]:\n                    print(f\"      {repr(item)[:200]}\")\n        \n        # Verify the Filesystem file is stored in IndexedDB\n        fs_files = idb.get('Filesystem', {})\n        print(f\"\\nFilesystem stores: {list(fs_files.keys())}\")\n        for store, items in fs_files.items():\n            for item in items:\n                print(f\"  [{store}]: {repr(item)[:300]}\")\n        \n        await browser.close()\n\nasyncio.run(main())\nEOF\npython3 /tmp/test_gallery2.py\n"]
