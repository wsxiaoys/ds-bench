[582.376628, "i", "cat > /tmp/test_prefs.py << 'EOF'\nimport asyncio\nfrom playwright.async_api import async_playwright\nimport base64\nimport os\nimport json\n\nJPEG_B64 = (\n    \"/9j/4AAQSkZJRgABAQEAYABgAAD/2wBDAAEBAQEBAQEBAQEBAQEBAQEBAQEBAQEBAQEBAQEBAQEB\"\n    \"AQEBAQEBAQEBAQEBAQEBAQEBAQEBAQEBAQEBAQEBAQEBAQEBAQEB/9sAQwEBAQEBAQEBAQEBAQEB\"\n    \"AQEBAQEBAQEBAQEBAQEBAQEBAQEBAQEBAQEBAQEBAQEBAQEBAQEBAQEBAQEBAQEBAQEBAQEB/8AA\"\n    \"QECAwQFBgcICQoL/8QAFQABAQAAAAAAAAAAAAAAAAAAAAv/xAAUEAEAAAAAAAAAAAAAAAAAAAAA/9o\"\n    \"ADAMBAAIRAxEAPwBVAAH//9k=\"\n)\n\ndef make_jpeg():\n    b64 = JPEG_B64 + \"=\" * (-len(JPEG_B64) % 4)\n    jpeg_bytes = base64.b64decode(b64)\n    path = '/tmp/test3.jpg'\n    with open(path, 'wb') as f:\n        f.write(jpeg_bytes)\n    return path\n\nasync def main():\n    jpeg_path = make_jpeg()\n    \n    async with async_playwright() as p:\n        browser = await p.chromium.launch(headless=True, args=['--no-sandbox'])\n        context = await browser.new_context()\n        page = await context.new_page()\n        \n        await page.goto('http://127.0.0.1:4173/')\n        await page.wait_for_load_state('networkidle')\n        \n        for i in range(2):\n            async with page.expect_file_chooser() as fc_info:\n                click_task = asyncio.create_task(page.click('#capture-btn'))\n            file_chooser = await fc_info.value\n            await file_chooser.set_files(jpeg_path)\n            await click_task\n            \n            await page.wait_for_function(\n                f\"() => document.getElementById('capture-status').textContent === 'saved'\",\n                timeout=15000\n            )\n            print(f\"Captured photo {i+1}\")\n            await asyncio.sleep(0.5)\n        \n        photos = await page.evaluate(\"window.gallery.listPhotos()\")\n        print(f\"Photos after 2 captures: {photos}\")\n        assert len(photos) == 2\n        \n        # Check localStorage (Preferences web implementation)\n        ls_value = await page.evaluate(\"window.localStorage.getItem('CapacitorStorage.photo_index')\")\n        print(f\"localStorage photo_index: {ls_value!r}\")\n        assert ls_value is not None, \"photo_index not in localStorage\"\n        parsed = json.loads(ls_value)\n        print(f\"Parsed: {parsed}\")\n        assert isinstance(parsed, list)\n        assert len(parsed) == 2\n        assert all(p.startswith('photos/') and p.endswith('.jpeg') for p in parsed)\n        # Verify order matches insertion order\n        assert parsed == photos, f\"Order mismatch: {parsed} != {photos}\"\n        \n        first = photos[0]\n        await page.evaluate(f\"window.gallery.deletePhoto({first!r})\")\n        photos_after = await page.evaluate(\"window.gallery.listPhotos()\")\n        print(f\"Photos after deleting first: {photos_after}\")\n        assert len(photos_after) == 1\n        \n        # Verify localStorage is also updated\n        ls_value2 = await page.evaluate(\"window.localStorage.getItem('CapacitorStorage.photo_index')\")\n        parsed2 = json.loads(ls_value2)\n        print(f\"After delete, localStorage: {parsed2}\")\n        assert len(parsed2) == 1\n        assert first not in parsed2\n        \n        # Try to delete non-existent path - should still work without throwing\n        try:\n            await page.evaluate(\"window.gallery.deletePhoto('photos/does-not-exist.jpeg')\")\n            photos_after3 = await page.evaluate(\"window.gallery.listPhotos()\")\n            print(f\"After deleting non-existent: {photos_after3}\")\n            assert len(photos_after3) == 1, f\"Expected 1, got {len(photos_after3)}\"\n        except Exception as e:\n            print(f\"ERROR: {e}\")\n            raise\n        \n        await browser.close()\n        print(\"=== ALL ADVANCED TESTS PASSED ===\")\n\nasyncio.run(main())\nEOF\npython3 /tmp/test_prefs.py\n"]
