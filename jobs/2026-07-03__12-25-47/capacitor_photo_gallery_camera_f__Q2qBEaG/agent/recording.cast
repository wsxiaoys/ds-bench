[159.082967, "o", "     * On iOS it's only supported for CameraSource.Camera, but not for CameraSource.Photos.\r\n     *\r\n     * @since 1.0.0\r\n     */\r\n    allowEditing?: boolean;\r\n    /**\r\n     * How the data should be returned. Currently, only 'Base64', 'DataUrl' or 'Uri' is supported\r\n     *\r\n"]
