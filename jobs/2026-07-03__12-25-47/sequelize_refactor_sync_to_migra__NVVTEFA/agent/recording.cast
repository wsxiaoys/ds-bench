[11.269203, "o", "\u001b[?2004hroot@590a1cd2-31d3-48fc-9c08-b2fe3d050ec8:/home/user/project# "]
[11.623712, "i", "cat package.json\n"]
[11.624004, "o", "cat package.json\r\n\u001b[?2004l\r"]
[11.625597, "o", "{\r\n  \"name\": \"express-sequelize-app\",\r\n  \"version\": \"1.0.0\",\r\n  \"main\": \"index.js\",\r\n  \"scripts\": {\r\n    \"start\": \"node index.js\"\r\n  },\r\n  \"dependencies\": {\r\n    \"express\": \"^4.21.2\",\r\n    \"sequelize\": \"^6.37.5\",\r\n    \"sqlite3\": \"^5.1.7\"\r\n  }\r\n}\r\n"]
[11.625967, "o", "\u001b[?2004hroot@590a1cd2-31d3-48fc-9c08-b2fe3d050ec8:/home/user/project# "]
[11.995882, "i", "cat index.js\n"]
[11.996509, "o", "cat index.js\r\n\u001b[?2004l\r"]
[11.99776, "o", "const express = require('express');\r\nconst { Sequelize, DataTypes } = require('sequelize');\r\n\r\nconst app = express();\r\napp.use(express.json());\r\n\r\nconst sequelize = new Sequelize({\r\n  dialect: 'sqlite',\r\n  storage: './database.sqlite',\r\n  logging: false\r\n});\r\n\r\nconst User = sequelize.define('User', {\r\n  username: {\r\n    type: DataTypes.STRING,\r\n    allowNull: false\r\n  }\r\n});\r\n\r\napp.post('/users', async (req, res) => {\r\n  try {\r\n    const user = await User.create({ username: req.body.username });\r\n    res.status(201).json(user);\r\n  } catch (error) {\r\n    res.status(400).json({ error: error.message });\r\n  }\r\n});\r\n\r\napp.get('/users', async (req, res) => {\r\n  const users = await User.findAll();\r\n  res.json(users);\r\n});\r\n\r\nsequelize.sync({ force: true }).then(() => {\r\n  app.listen(3000, () => {\r\n    console.log('Server is running on port 3000');\r\n  });\r\n});\r\n"]
