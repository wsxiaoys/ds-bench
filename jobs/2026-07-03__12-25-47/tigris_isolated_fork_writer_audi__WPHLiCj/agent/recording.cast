[55.584693, "o", "#!/bin/bash\r\nset -e\r\n\r\n# Read run id\r\nRUN_ID=$(cat /logs/artifacts/run-id)\r\nBUCKET_NAME=\"harbor-isolation-${RUN_ID}\"\r\n\r\n# Normalize: lowercase and replace invalid chars with hyphens\r\nBUCKET_NAME=$(echo \"$BUCKET_NAME\" | tr '[:upper:]' '[:lower:]' | sed 's/[^a-z0-9.-]/-/g')\r\n\r\ncd /home/user/isolation\r\n\r\n# Try to create the bucket (idempotent)\r\nnode --experimental-vm-modules -e \"\r\nimport('@tigrisdata/storage').then(async ({ createBucket, putObject, getBucketMetadata, setBucketSnapshot }) => {\r\n  const { data, error } = await createBucket(process.env.BUCKET_NAME, { enableSnapshot: true });\r\n  if (error && !String(error.message).includes('already exists')) {\r\n    console.error('Bucket creation failed:', error.message);\r\n    process.exit(1);\r\n  }\r\n  console.log('Bucket ready');\r\n  await putObject(process.env.BUCKET_NAME, 'seed1.txt', Buffer.from('seed1 content'));\r\n  await putObject(process.env.BUCKET_NAME, 'seed2.txt', Buffer.from('seed2 content'));\r\n  console.log('Seeds uploaded');\r\n});\r\n\" 2>&1 || true\r\n"]
[55.584945, "o", "\u001b[?2004h"]
[55.584996, "o", "root@1f9f4190-5c5f-42fb-bf99-ecfffc22c517:~# "]
[62.904296, "i", "cat > /home/user/isolation/setup.sh << 'EOF'\n#!/bin/bash\n# Setup script for isolation task. Idempotent.\nset -e\n\nRUN_ID=$(cat /logs/artifacts/run-id)\nBUCKET_NAME=\"harbor-isolation-${RUN_ID}\"\n# Normalize: lowercase and replace invalid chars with hyphens\nBUCKET_NAME=$(echo \"$BUCKET_NAME\" | tr '[:upper:]' '[:lower:]' | sed 's/[^a-z0-9.-]/-/g')\n\nexport BUCKET_NAME\n\ncd /home/user/isolation\n\nnode --input-type=module -e \"\nimport { createBucket, putObject } from '@tigrisdata/storage';\nconst bucketName = process.env.BUCKET_NAME;\nconsole.log('Setting up bucket:', bucketName);\n\nconst { data, error } = await createBucket(bucketName, { enableSnapshot: true });\nif (error) {\n  if (String(error.message).toLowerCase().includes('already exists')) {\n    console.log('Bucket already exists, continuing');\n  } else {\n    console.error('Bucket creation error:', error.message);\n    process.exit(1);\n  }\n} else {\n  console.log('Bucket created');\n}\n\nconst r1 = await putObject(bucketName, 'seed1.txt', Buffer.from('seed1 content\\n'));\nif (r1.error) { console.error('putObject seed1 error:', r1.error.message); process.exit(1); }\nconsole.log('seed1.txt uploaded');\n\nconst r2 = await putObject(bucketName, 'seed2.txt', Buffer.from('seed2 content\\n'));\nif (r2.error) { console.error('putObject seed2 error:', r2.error.message); process.exit(1); }\nconsole.log('seed2.txt uploaded');\n\nconsole.log('Setup complete for bucket:', bucketName);\n\"\nEOF\n"]
