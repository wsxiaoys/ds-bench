[55.196173, "i", "cat > /home/user/isolation/setup.sh << 'EOF'\n#!/bin/bash\nset -e\n\n# Read run id\nRUN_ID=$(cat /logs/artifacts/run-id)\nBUCKET_NAME=\"harbor-isolation-${RUN_ID}\"\n\n# Normalize: lowercase and replace invalid chars with hyphens\nBUCKET_NAME=$(echo \"$BUCKET_NAME\" | tr '[:upper:]' '[:lower:]' | sed 's/[^a-z0-9.-]/-/g')\n\ncd /home/user/isolation\n\n# Try to create the bucket (idempotent)\nnode --experimental-vm-modules -e \"\nimport('@tigrisdata/storage').then(async ({ createBucket, putObject, getBucketMetadata, setBucketSnapshot }) => {\n  const { data, error } = await createBucket(process.env.BUCKET_NAME, { enableSnapshot: true });\n  if (error && !String(error.message).includes('already exists')) {\n    console.error('Bucket creation failed:', error.message);\n    process.exit(1);\n  }\n  console.log('Bucket ready');\n  await putObject(process.env.BUCKET_NAME, 'seed1.txt', Buffer.from('seed1 content'));\n  await putObject(process.env.BUCKET_NAME, 'seed2.txt', Buffer.from('seed2 content'));\n  console.log('Seeds uploaded');\n});\n\" 2>&1 || true\nEOF\n"]
