[244.689055, "i", "cat > /home/user/isolation/setup.sh << 'EOF'\n#!/bin/bash\n# Setup script for isolation task. Idempotent.\nset -e\n\nRUN_ID=$(cat /logs/artifacts/run-id)\nBUCKET_NAME=\"harbor-isolation-${RUN_ID}\"\n# Normalize: lowercase and replace invalid chars with hyphens\nBUCKET_NAME=$(echo \"$BUCKET_NAME\" | tr '[:upper:]' '[:lower:]' | sed 's/[^a-z0-9.-]/-/g')\n\nexport BUCKET_NAME\n\ncd /home/user/isolation\n\nnode --input-type=module -e \"\nimport { createBucket, getBucketInfo, put } from '@tigrisdata/storage';\nconst bucketName = process.env.BUCKET_NAME;\nconsole.log('Setting up bucket:', bucketName);\n\n// Check if bucket already exists\nconst info = await getBucketInfo(bucketName);\nif (info.error) {\n  // Try to create\n  const { data, error } = await createBucket(bucketName, { enableSnapshot: true });\n  if (error) {\n    console.error('Bucket creation error:', error.message);\n    process.exit(1);\n  }\n  console.log('Bucket created');\n} else {\n  console.log('Bucket already exists');\n}\n\nconst r1 = await put('seed1.txt', 'seed1 content\\n', { config: { bucket: bucketName } });\nif (r1.error) { console.error('put seed1 error:', r1.error.message); process.exit(1); }\nconsole.log('seed1.txt uploaded');\n\nconst r2 = await put('seed2.txt', 'seed2 content\\n', { config: { bucket: bucketName } });\nif (r2.error) { console.error('put seed2 error:', r2.error.message); process.exit(1); }\nconsole.log('seed2.txt uploaded');\n\nconsole.log('Setup complete for bucket:', bucketName);\n\"\nEOF\n"]
