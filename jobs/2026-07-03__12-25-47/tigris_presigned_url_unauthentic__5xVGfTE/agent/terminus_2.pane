[?2004l[?2004h> import os
[?2004l[?2004h> import re
[?2004l[?2004h> import boto3
[?2004l[?2004h> from botocore.client import Config
[?2004l[?2004h> from botocore.exceptions import ClientError
[?2004l[?2004h> 
[?2004l[?2004h> # Step 1: read run-id
[?2004l[?2004h> with open('/logs/artifacts/run-id', 'r') as f:
[?2004l[?2004h>     run_id = f.read().strip()
[?2004l[?2004h> 
[?2004l[?2004h> # Normalize: lowercase, replace invalid chars with hyphens
[?2004l[?2004h> normalized = run_id.lower()
[?2004l[?2004h> # S3 bucket names can contain lowercase letters, numbers, dots, and hyphens
[?2004l[?2004h> normalized = re.sub(r'[^a-z0-9.\-]', '-', normalized)
[?2004l[?2004h> bucket = f"harbor-presign-{normalized}"
[?2004l[?2004h> print(f"Bucket name: {bucket}")
[?2004l[?2004h> 
[?2004l[?2004h> # Step 2: build boto3 S3 client
[?2004l[?2004h> s3_client = boto3.client(
[?2004l[?2004h>     's3',
[?2004l[?2004h>     endpoint_url=os.environ['AWS_ENDPOINT_URL_S3'],
[?2004l[?2004h>     region_name=os.environ.get('AWS_REGION', 'REDACTED'),
[?2004l[?2004h>     config=Config(s3={"addressing_style": "virtual"}),
[?2004l[?2004h> )
[?2004l[?2004h> 
[?2004l[?2004h> # Step 3: create bucket (treat BucketAlreadyOwnedByYou as success)
[?2004l[?2004h> try:
[?2004l[?2004h>     s3_client.create_bucket(Bucket=bucket)
[?2004l[?2004h>     print(f"Bucket {bucket} created")
[?2004l[?2004h> except ClientError as e:
[?2004l[?2004h>     code = e.response.get('Error', {}).get('Code')
[?2004l[?2004h>     if code in ('BucketAlreadyOwnedByYou', 'BucketAlreadyExists'):
[?2004l[?2004h>         print(f"Bucket {bucket} already owned/exists - continuing")
[?2004l[?2004h>     else:
[?2004l[?2004h>         raise
[?2004l[?2004h> 
[?2004l[?2004h> # Step 4: upload object
[?2004l[?2004h> s3_client.put_object(Bucket=bucket, Key="share/secret.txt", Body=b"shareable content")
[?2004l[?2004h> print("Object uploaded")
[?2004l[?2004h> 
[?2004l[?2004h> # Step 5: mint presigned URL
[?2004l[?2004h> url = s3_client.generate_presigned_url(
[?2004l[?2004h>     "get_object",
[?2004l[?2004h>     Params={"Bucket": bucket, "Key": "share/secret.txt"},
[?2004l[?2004h>     ExpiresIn=300,
[?2004l[?2004h> )
[?2004l[?2004h> print(f"Presigned URL length: {len(url)}")
[?2004l[?2004h> 
[?2004l[?2004h> # Step 6: write URL with no trailing newline
[?2004l[?2004h> with open('/home/user/tigris-task/presigned.url', 'w') as f:
[?2004l[?2004h>     f.write(url)
[?2004l[?2004h> print("Wrote /home/user/tigris-task/presigned.url")
[?2004l[?2004h> PYEOF
