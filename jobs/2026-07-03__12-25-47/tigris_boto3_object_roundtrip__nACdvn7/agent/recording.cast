[51.675587, "i", "python3 -c \"\nimport os, boto3, pathlib\nfrom botocore.client import Config\nrun_id = pathlib.Path('/logs/artifacts/run-id').read_text().strip()\nbucket = f'harbor-boto3-{run_id}'\nimport re\nbucket = re.sub(r'[^a-z0-9.-]', '-', bucket.lower())\ns3 = boto3.client('s3', endpoint_url=os.environ['AWS_ENDPOINT_URL_S3'], config=Config(s3={'addressing_style': 'virtual'}))\nresp = s3.list_objects_v2(Bucket=bucket)\nprint('Bucket:', bucket)\nprint('Objects:', [(o['Key'], o['Size']) for o in resp.get('Contents', [])])\n\"\n"]
