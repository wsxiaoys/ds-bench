[?2004l[?2004h> movies_data = alt.UrlData(movies_url)
[?2004l[?2004h> 
[?2004l[?2004h> # Null-row filters, applied to every view. (Scatter also filters rotten nulls.)
[?2004l[?2004h> imdb_not_null = "datum.IMDB_Rating != null"
[?2004l[?2004h> rt_not_null = "datum.Rotten_Tomatoes_Rating != null"
[?2004l[?2004h> 
[?2004l[?2004h> # ---- Shared 2D interval brush -------------------------------------------
[?2004l[?2004h> brush = alt.selection_interval(name="brush")
[?2004l[?2004h> 
[?2004l[?2004h> # ---- View A: scatter (brush host) --------------------------------------
[?2004l[?2004h> # IMDB rating (x) vs Rotten Tomatoes rating (y).  Points inside the brush
[?2004l[?2004h> # are colored by Major_Genre; points outside are flat 'lightgray'.
[?2004l[?2004h> scatter = (
[?2004l[?2004h>     alt.Chart(movies_data, title="IMDB vs Rotten Tomatoes")
[?2004l[?2004h>     .mark_point(filled=True, size=60, opacity=0.7)
[?2004l[?2004h>     .transform_filter(imdb_not_null)
[?2004l[?2004h>     .transform_filter(rt_not_null)
[?2004l[?2004h>     .encode(
[?2004l[?2004h>         x=alt.X("IMDB_Rating:Q", title="IMDB Rating"),
[?2004l[?2004h>         y=alt.Y("Rotten_Tomatoes_Rating:Q", title="Rotten Tomatoes Rating"),
[?2004l[?2004h>         color=alt.when(brush).then(
[?2004l[?2004h>             alt.Color(
[?2004l[?2004h>                 "Major_Genre:N",
[?2004l[?2004h>                 legend=alt.Legend(title="Major Genre (inside brush)"),
[?2004l[?2004h>             )
[?2004l[?2004h>         ).otherwise(alt.value("lightgray")),
[?2004l[?2004h>         tooltip=[
[?2004l[?2004h>             "Title:N",
[?2004l[?2004h>             "Major_Genre:N",
[?2004l[?2004h>             "IMDB_Rating:Q",
[?2004l[?2004h>             "Rotten_Tomatoes_Rating:Q",
[?2004l[?2004h>         ],
[?2004l[?2004h>     )
[?2004l[?2004h>     .properties(width=600, height=400)
[?2004l[?2004h>     .add_params(brush)
[?2004l[?2004h> )
[?2004l[?2004h> 
[?2004l[?2004h> # ---- View B: genre bar (top-8 most frequent genres) ---------------------
[?2004l[?2004h> # Aggregate -> window-rank -> keep top 8, all done *after* applying the brush.
[?2004l[?2004h> bar = (
[?2004l[?2004h>     alt.Chart(movies_data, title="Movies by Major Genre (top 8)")
[?2004l[?2004h>     .mark_bar()
[?2004l[?2004h>     .transform_filter(imdb_not_null)
[?2004l[?2004h>     .transform_filter(rt_not_null)
[?2004l[?2004h>     .transform_filter(brush)
[?2004l[?2004h>     .transform_aggregate(count="count()", groupby=["Major_Genre"])
[?2004l[?2004h>     .transform_window(
[?2004l[?2004h>         rank="rank(count)",
[?2004l[?2004h>         sort=[alt.SortField("count", order="descending")],
[?2004l[?2004h>     )
[?2004l[?2004h>     .transform_filter("datum.rank <= 8")
[?2004l[?2004h>     .encode(
[?2004l[?2004h>         x=alt.X("count:Q", title="Number of Movies"),
[?2004l[?2004h>         y=alt.Y("Major_Genre:N", sort="-x", title="Major Genre"),
[?2004l[?2004h>         color=alt.Color("Major_Genre:N", legend=None),
[?2004l[?2004h>         tooltip=["Major_Genre:N", alt.Tooltip("count:Q", title="Movies")],
[?2004l[?2004h>     )
[?2004l[?2004h>     .properties(width=300, height=200)
[?2004l[?2004h> )
[?2004l[?2004h> 
[?2004l[?2004h> # ---- View C: IMDB rating histogram -------------------------------------
[?2004l[?2004h> hist = (
[?2004l[?2004h>     alt.Chart(movies_data, title="IMDB Rating Distribution")
[?2004l[?2004h>     .mark_bar()
[?2004l[?2004h>     .transform_filter(imdb_not_null)
[?2004l[?2004h>     .transform_filter(rt_not_null)
[?2004l[?2004h>     .transform_filter(brush)
[?2004l[?2004h>     .encode(
[?2004l[?2004h>         x=alt.X(
[?2004l[?2004h>             "IMDB_Rating:Q",
[?2004l[?2004h>             bin=alt.Bin(maxbins=20),
[?2004l[?2004h>             title="IMDB Rating (binned)",
[?2004l[?2004h>         ),
[?2004l[?2004h>         y=alt.Y("count():Q", title="Number of Movies"),
[?2004l[?2004h>         tooltip=[
[?2004l[?2004h>             alt.Tooltip("IMDB_Rating:Q", bin=alt.Bin(maxbins=20)),
