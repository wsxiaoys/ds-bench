[?2004l[?2004h>         ],
[?2004l[?2004h>     )
[?2004l[?2004h>     .properties(width=300, height=200)
[?2004l[?2004h> )
[?2004l[?2004h> 
[?2004l[?2004h> # ---- Layout -------------------------------------------------------------
[?2004l[?2004h> # View A on top; View B and View C side-by-side underneath.
[?2004l[?2004h> dashboard = scatter & (bar | hist)
