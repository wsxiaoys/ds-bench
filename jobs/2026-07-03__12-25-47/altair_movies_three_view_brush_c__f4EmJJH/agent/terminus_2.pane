[?2004l[?2004h> import altair as alt
[?2004l[?2004h> 
[?2004l[?2004h> # URL-based data source; declare types explicitly.
[?2004l[?2004h> url = "https://cdn.jsdelivr.net/npm/vega-datasets@v1/data/movies.json"
[?2004l[?2004h> data = alt.UrlData(url, format="json")
[?2004l[?2004h> 
[?2004l[?2004h> # Shared predicates to drop nulls on the rating columns on every view.
[?2004l[?2004h> # (Scatter adds the Rotten_Tomatoes_Rating null-filter as well.)
[?2004l[?2004h> imdb_not_null = "datum.IMDB_Rating != null"
[?2004l[?2004h> rt_not_null = "datum.Rotten_Tomatoes_Rating != null"
[?2004l[?2004h> 
[?2004l[?2004h> # Reusable brush that drives all three views.
[?2004l[?2004h> brush = alt.selection_interval(name="brush")
[?2004l[?2004h> 
[?2004l[?2004h> # ----- View A: scatter (brush host) ---------------------------------------
[?2004l[?2004h> # IMDB vs Rotten Tomatoes, colored by Major_Genre inside the brush,
[?2004l[?2004h> # otherwise flat 'lightgray'.
[?2004l[?2004h> scatter = (
[?2004l[?2004h>     alt.Chart(data, title="IMDB vs Rotten Tomatoes")
[?2004l[?2004h>     .mark_point()
[?2004l[?2004h>     .transform_filter(imdb_not_null)
[?2004l[?2004h>     .transform_filter(rt_not_null)
[?2004l[?2004h>     .encode(
[?2004l[?2004h>         x=alt.X("IMDB_Rating:Q", title="IMDB Rating"),
[?2004l[?2004h>         y=alt.Y("Rotten_Tomatoes_Rating:Q", title="Rotten Tomatoes Rating"),
[?2004l[?2004h>         color=alt.Color(
[?2004l[?2004h>             "Major_Genre:N",
[?2004l[?2004h>             legend=alt.Legend(title="Major Genre (inside brush)"),
[?2004l[?2004h>         ),
[?2004l[?2004h>         tooltip=["Title:N", "Major_Genre:N", "IMDB_Rating:Q", "Rotten_Tomatoes_Rating:Q"],
[?2004l[?2004h>     )
[?2004l[?2004h>     .properties(width=600, height=400)
[?2004l[?2004h>     .add_params(brush)
[?2004l[?2004h>     .encode(
[?2004l[?2004h>         x=alt.X("IMDB_Rating:Q", title="IMDB Rating"),
[?2004l[?2004h>         y=alt.Y("Rotten_Tomatoes_Rating:Q", title="Rotten Tomatoes Rating"),
[?2004l[?2004h>         color=alt.condition(
[?2004l[?2004h>             brush,
[?2004l[?2004h>             alt.Color("Major_Genre:N", legend=alt.Legend(title="Major Genre (inside brush)")),
[?2004l[?2004h>             alt.value("lightgray"),
[?2004l[?2004h>         ),
[?2004l[?2004h>         tooltip=["Title:N", "Major_Genre:N", "IMDB_Rating:Q", "Rotten_Tomatoes_Rating:Q"],
[?2004l[?2004h>     )
[?2004l[?2004h>     .properties(width=600, height=400)
[?2004l[?2004h> )
[?2004l[?2004h> 
[?2004l[?2004h> # ----- View B: bar of top-8 most frequent Major_Genre values ----------------
[?2004l[?2004h> # Rank genres globally, then keep the top 8 regardless of the brush.
[?2004l[?2004h> genre_ranking = (
[?2004l[?2004h>     alt.Chart(data)
[?2004l[?2004h>     .transform_filter(imdb_not_null)
[?2004l[?2004h>     .transform_filter(rt_not_null)
[?2004l[?2004h>     .transform_aggregate(count="count()", groupby=["Major_Genre"])
[?2004l[?2004h>     .transform_window(rank="rank(count)", sort=[alt.SortField("count", order="descending")])
[?2004l[?2004h>     .transform_filter("datum.rank <= 8")
[?2004l[?2004h> )
[?2004l[?2004h> 
[?2004l[?2004h> bar = (
[?2004l[?2004h>     alt.Chart(data, title="Movies by Major Genre (top 8)")
[?2004l[?2004h>     .mark_bar()
[?2004l[?2004h>     .transform_filter(imdb_not_null)
[?2004l[?2004h>     .transform_filter(rt_not_null)
[?2004l[?2004h>     .transform_filter(brush)
[?2004l[?2004h>     .transform_lookup("Major_Genre", from_=alt.LookupData(genre_ranking, "Major_Genre", ["rank"]))
[?2004l[?2004h>     .transform_filter("datum.rank != null")
[?2004l[?2004h>     .encode(
[?2004l[?2004h>         x=alt.X("count():Q", title="Number of Movies"),
[?2004l[?2004h>         y=alt.Y("Major_Genre:N", sort="-x", title="Major Genre"),
[?2004l[?2004h>         color=alt.Color("Major_Genre:N", legend=None),
[?2004l[?2004h>         tooltip=["Major_Genre:N", alt.Tooltip("count():Q", title="Movies")],
[?2004l[?2004h>     )
[?2004l[?2004h>     .properties(width=300, height=200)
[?2004l[?2004h> )
[?2004l[?2004h> 
[?2004l[?2004h> # ----- View C: IMDB_Rating histogram ---------------------------------------
[?2004l[?2004h> hist = (
[?2004l[?2004h>     alt.Chart(data, title="IMDB Rating Distribution")
[?2004l[?2004h>     .mark_bar()
[?2004l[?2004h>     .transform_filter(imdb_not_null)
[?2004l[?2004h>     .transform_filter(rt_not_null)
[?2004l[?2004h>     .transform_filter(brush)
[?2004l[?2004h>     .encode(
[?2004l[?2004h>         x=alt.X("IMDB_Rating:Q", bin=alt.Bin(maxbins=20), title="IMDB Rating (binned)"),
[?2004l[?2004h>         y=alt.Y("count():Q", title="Number of Movies"),
[?2004l[?2004h>         tooltip=[alt.Tooltip("IMDB_Rating:Q", bin=alt.Bin(maxbins=20)), alt.Tooltip("count():Q")],
[?2004l[?2004h>     )
[?2004l[?2004h>     .properties(width=300, height=200)
[?2004l[?2004h> )
[?2004l[?2004h> 
[?2004l[?2004h> # ----- Compose layout: scatter on top, bar and histogram side-by-side -----
[?2004l[?2004h> dashboard = scatter & (bar | hist)
[?2004l[?2004h> 
[?2004l[?2004h> dashboard.save("/home/user/myproject/chart.html")
