[215.555843, "o", "<!DOCTYPE html>\r\n<html>\r\n<head>\r\n  <meta charset=\"UTF-8\">\r\n  <style>\r\n    #vis.vega-embed {\r\n      width: 100%;\r\n      display: flex;\r\n    }\r\n\r\n    #vis.vega-embed details,\r\n    #vis.vega-embed details summary {\r\n      position: relative;\r\n    }\r\n  </style>\r\n  <script type=\"text/javascript\" src=\"https://cdn.jsdelivr.net/npm/vega@6\"></script>\r\n  <script type=\"text/javascript\" src=\"https://cdn.jsdelivr.net/npm/vega-lite@6.4.1\"></script>\r\n  <script type=\"text/javascript\" src=\"https://cdn.jsdelivr.net/npm/vega-embed@7\"></script>\r\n</head>"]
[215.555923, "o", "\r\n<body>\r\n  <div id=\"vis\"></div>\r\n  <script>\r\n    (function(vegaEmbed) {\r\n      var spec = {\"config\": {\"view\": {\"continuousWidth\": 300, \"continuousHeight\": 300}}, \"vconcat\": [{\"mark\": {\"type\": \"point\", \"filled\": true, \"opacity\": 0.7, \"size\": 60}, \"encoding\": {\"color\": {\"condition\": {\"param\": \"brush\", \"field\": \"Major_Genre\", \"legend\": {\"title\": \"Major Genre (inside brush)\"}, \"type\": \"nominal\"}, \"value\": \"lightgray\"}, \"tooltip\": [{\"field\": \"Title\", \"type\": \"nominal\"}, {\"field\": \"Major_Genre\", \"type\": \"nominal\"}, {\"field\": \"IMDB_Rating\", \"type\": \"quantitative\"}, {\"field\": \"Rotten_Tomatoes_Rating\", \"type\": \"quantitative\"}], \"x\": {\"field\": \"IMDB_Rating\", \"title\": \"IMDB Rating\", \"type\": \"quantitative\"}, \"y\": {\"field\": \"Rotten_Tomatoes_Rating\", \"title\": \"Rotten Tomatoes Rating\", \"type\": \"quantitative\"}}, \"height\": 400, \"name\": \"view_be26877b3f639fb1_0\", \"title\": \"IMDB vs Rotten Tomatoes\", \"transform\": [{\"filter\": \"datum.IMDB_Rating != null\"}, {\"filter\": \"datum.Rotten_Tomatoes_Rating != null\"}], \"width\": 600}, {\"hconcat\": [{\"mark\": {\"type\": \"bar\"}, \"encoding\": {\"color\": {\"field\": \"Major_Genre\", \"legend\": null, \"type\": \"nominal\"}, \"tooltip\": [{\"field\": \"Major_Genre\", \"type\": \"nominal\"}, {\"field\": \"count\", \"title\": \"Movies\", \"type\": \"quantitative\"}], \"x\": {\"field\": \"count\", \"title\": \"Number of Movies\", \"type\": \"quantitative\"}, \"y\": {\"field\": \"Major_Genre\", \"sort\": \"-x\", \"title\": \"Major Genre\", \"type\": \"nominal\"}}, \"height\": 200, \"title\": \"Movies by Major Genre (top 8)\", \"transform\": [{\"filter\": \"datum.IMDB_Rating != null\"}, {\"filter\": \"datum.Rotten_Tomatoes_Rating != null\"}, {\"filter\": {\"param\": \"brush\"}}, {\"aggregate\": [{\"op\": \"count\", \"as\": \"count\"}], \"groupby\": [\"Major_Genre\"]}, {\"window\": [{\"op\": \"rank\", \"field\": \"count\", \"as\": \"rank\"}], \"sort\": [{\"field\": \"count\", \"order\": \"descending\"}]}, {\"filter\": \"datum.rank <= 8\"}], \"width\": 300}, {\"mark\": {\"type\": \"bar\"}, \"encoding\": {\"tooltip\": [{\"bin\": {\"maxbins\": 20}, \"field\": \"IMDB_Rating\", \"type\": \"quantitative\"}, {\"aggregate\": \"count\", \"type\": \"quantitative\"}], \"x\": {\"bin\": {\"maxbins\": 20}, \"field\": \"IMDB_Rating\", \"title\": \"IMDB Rating (binned)\", \"type\": \"quantitative\"}, \"y\": {\"aggregate\": \"count\", \"title\": \"Number of Movies\", \"type\": \"quantitative\"}}, \"height\": 200, \"title\": \"IMDB Rating Distribution\", \"transform\": [{\"filter\": \"datum.IMDB_Rating != null\"}, {\"filter\": \"datum.Rotten_Tomatoes_Rating != null\"}, {\"filter\": {\"param\": \"brush\"}}], \"width\": 300}]}], \"data\": {\"url\": \"https://cdn.jsdelivr.net/npm/vega-datasets@v1.29.0/data/movies.json\"}, \"params\": [{\"name\": \"brush\", \"select\": {\"type\": \"interval\"}, \"views\": [\"view_be26877b3f639fb1_0\"]}], \"$schema\": \"https://vega.github.io/schema/vega-lite/v6.4.1.json\"};\r\n      var embedOpt = {\"mode\": \"vega-lite\"};\r\n\r\n      function showError(el, error){\r\n          el.innerHTML = ('<div style=\"color:red;\">'\r\n                          + '<p>JavaScript Error: ' + error.message + '</p>'\r\n                          + \"<p>This usually means there's a typo in your chart specification. \"\r\n                          + \"See the javascript console for the full traceback.</p>\"\r\n                          + '</div>');\r\n"]
[215.555956, "o", "          throw error;\r\n      }\r\n      const el = document.getElementById('vis');\r\n      vegaEmbed(\"#vis\", spec, embedOpt)\r\n        .catch(error => showError(el, error));\r\n    })(vegaEmbed);\r\n\r\n  </script>\r\n</body>\r\n</html>"]
