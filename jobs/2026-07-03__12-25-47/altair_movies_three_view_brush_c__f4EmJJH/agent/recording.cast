[232.770318, "i", "python3 << 'PYEOF'\nimport json\nwith open('/home/user/myproject/chart.html') as f:\n    html = f.read()\nstart = html.find('var spec = ') + len('var spec = ')\nend = html.find(';', start)\nspec = json.loads(html[start:end])\n\n# Confirm scatter view has the brush param via condition.\nscatter = spec['vconcat'][0]\nprint(\"SCATTER color:\", json.dumps(scatter['encoding']['color'], indent=2))\nprint(\"SCATTER mark:\", scatter['mark'])\n# brush should NOT be in scatter params (it's at top level). But the selection is wired to the scatter view via 'views': ['view_..._0'].\nprint(\"SCATTER name:\", scatter.get('name'))\nprint(\"SCATTER transforms:\", scatter.get('transform'))\n\nbar_hist = spec['vconcat'][1]['hconcat']\nprint()\nprint(\"BAR mark:\", bar_hist[0]['mark'], \"transforms:\", [t for t in bar_hist[0]['transform']])\nprint(\"HIST mark:\", bar_hist[1]['mark'], \"transforms:\", [t for t in bar_hist[1]['transform']])\nPYEOF\n"]
