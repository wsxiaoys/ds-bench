[167.505186, "i", "python3 << 'PYEOF'\nimport altair as alt\nfrom vega_datasets import data\n\nmovies_url = data.movies.url\nmovies_data = alt.UrlData(movies_url)\n\nbrush = alt.selection_interval(name=\"brush\")\n\nimdb_not_null = \"datum.IMDB_Rating != null\"\nrt_not_null = \"datum.Rotten_Tomatoes_Rating != null\"\n\nbar = (\n    alt.Chart(movies_data, title=\"Movies by Major Genre (top 8)\")\n    .mark_bar()\n    .transform_filter(imdb_not_null)\n    .transform_filter(rt_not_null)\n    .transform_filter(brush)\n    .transform_aggregate(count=\"count()\", groupby=[\"Major_Genre\"])\n    .transform_window(\n        rank=\"rank(count)\",\n        sort=[alt.SortField(\"count\", order=\"descending\")],\n    )\n    .transform_filter(\"datum.rank <= 8\")\n    .encode(\n        x=alt.X(\"count:Q\", title=\"Number of Movies\"),\n        y=alt.Y(\"Major_Genre:N\", sort=\"-x\", title=\"Major Genre\"),\n        color=alt.Color(\"Major_Genre:N\", legend=None),\n    )\n    .properties(width=300, height=200)\n)\n\nspec = bar.to_dict()\nimport json\nprint(json.dumps(spec, indent=2, default=str)[:2000])\nPYEOF\n"]
