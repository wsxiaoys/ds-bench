[154.607996, "i", "python3 << 'PYEOF'\nimport json, urllib.request\nfrom collections import Counter\nurl = \"https://cdn.jsdelivr.net/npm/vega-datasets@v1.29.0/data/movies.json\"\nwith urllib.request.urlopen(url) as r:\n    movies = json.load(r)\nfiltered = [m for m in movies if m.get(\"IMDB_Rating\") is not None and m.get(\"Rotten_Tomatoes_Rating\") is not None]\nctr = Counter(m.get(\"Major_Genre\") for m in filtered)\ntop8 = [g for g, _ in ctr.most_common(8)]\nprint(top8)\nPYEOF\n"]
