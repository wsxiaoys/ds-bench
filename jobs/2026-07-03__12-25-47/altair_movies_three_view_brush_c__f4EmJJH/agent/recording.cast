[232.787642, "o", "SCATTER color: {\r\n  \"condition\": {\r\n    \"param\": \"brush\",\r\n    \"field\": \"Major_Genre\",\r\n    \"legend\": {\r\n      \"title\": \"Major Genre (inside brush)\"\r\n    },\r\n    \"type\": \"nominal\"\r\n  },\r\n  \"value\": \"lightgray\"\r\n}\r\nSCATTER mark: {'type': 'point', 'filled': True, 'opacity': 0.7, 'size': 60}\r\nSCATTER name: view_be26877b3f639fb1_0\r\nSCATTER transforms: [{'filter': 'datum.IMDB_Rating != null'}, {'filter': 'datum.Rotten_Tomatoes_Rating != null'}]\r\n\r\nBAR mark: {'type': 'bar'} transforms: [{'filter': 'datum.IMDB_Rating != null'}, {'filter': 'datum.Rotten_Tomatoes_Rating != null'}, {'filter': {'param': 'brush'}}, {'aggregate': [{'op': 'count', 'as': 'count'}], 'groupby': ['Major_Genre']}, {'window': [{'op': 'rank', 'field': 'count', 'as': 'rank'}], 'sort': [{'field': 'count', 'order': 'descending'}]}, {'filter': 'datum.rank <= 8'}]\r\nHIST mark: {'type': 'bar'} transforms: [{'filter': 'datum.IMDB_Rating != null'}, {'filter': 'datum.Rotten_Tomatoes_Rating != null'}, {'filter': {'param': 'brush'}}]\r\n"]
