Sending keys: ['cat > run.py << \'EOF\'\n#!/usr/bin/env python3\n"""Bytewax Fraud Detection State Machine.\n\nReads user events from a JSONlines file, tracks each user\'s state using a\nstate machine implemented with Bytewax\'s stateful_map operator, and emits\nfraud alerts to an output JSONlines file when suspicious activity is\ndetected.\n"""\nimport argparse\nimport json\nimport sys\nfrom typing import Dict, Iterable, List, Optional, Tuple\n\nfrom bytewax.dataflow import Dataflow\nfrom bytewax.inputs import FixedPartitionedSource, StatefulSourcePartition\nfrom bytewax.outputs import StatelessSinkPartition, Sink\nimport bytewax.operators as op\nfrom bytewax.execution import run_main\n\n\n# ---------- Constants ----------\nLOGGED_OUT = "LOGGED_OUT"\nLOGGED_IN = "LOGGED_IN"\nSUSPICIOUS = "SUSPICIOUS"\n\nLARGE_TRANSACTION_THRESHOLD = 1000\nLARGE_TX_WINDOW_SECONDS = 300\nLARGE_TX_COUNT_THRESHOLD = 3\n\n\n# ---------- Custom Source ----------\nclass JSONLinesSource(FixedPartitionedSource):\n    """Reads JSON objects (one per line) from a single file."""\n\n    def __init__(self, path: str):\n        self._path = path\n\n    def list_parts(self) -> List[str]:\n        return ["single"]\n\n    def build_part(\n        self,\n        step_id: str,\n        for_part: str,\n        resume_state: Optional[int],\n    ) -> StatefulSourcePartition:\n        return _JSONLinesPartition(self._path, resume_state)\n\n\nclass _JSONLinesPartition(StatefulSourcePartition[int, int]):\n    """Reads the file line by line. `resume_state` is the next line index."""\n\n    def __init__(self, path: str, start_index: Optional[int]):\n        self._path = path\n        # Defer opening until first call to avoid issues in __init__\n        self._index = start_index if start_index is not None else 0\n        self._done = start_index is not None and False\n        self._lines: Optional[List[str]] = None\n\n    def _ensure_loaded(self) -> None:\n        if self._lines is None:\n            with open(self._path, "r", encoding="utf-8") as f:\n                self._lines = [line for line in f.read().splitlines() if line.strip()]\n\n    def next_batch(self) -> Iterable[Tuple[int, dict]]:\n        self._ensure_loaded()\n        assert self._lines is not None\n        if self._index >= len(self._lines):\n            raise StopIteration()\n        # Read one line at a time so the snapshot is precise.\n        line = self._lines[self._index]\n        self._index += 1\n        try:\n            item = json.loads(line)\n        except json.JSONDecodeError as exc:\n            raise ValueError(\n                f"Invalid JSON on line {self._index} of {self._path}: {line!r}"\n            ) from exc\n        yield (self._index - 1, item)\n\n    def snapshot(self) -> int:\n        return self._index\n\n\n# ---------- Custom Sink ----------\nclass JSONLinesSink(Sink):\n    """Writes one JSON object per line to a single output file."""\n\n    def __init__(self, path: str):\n        self._path = path\n\n    def list_parts(self) -> List[str]:\n        return ["single"]\n\n    def build_part(\n        self,\n        step_id: str,\n        for_part: str,\n        resume_state: Optional[int],\n    ) -> StatelessSinkPartition:\n        return _JSONLinesSinkPartition(self._path)\n\n\nclass _JSONLinesSinkPartition(StatelessSinkPartition):\n    def __init__(self, path: str):\n        self._path = path\n        self._fh = open(self._path, "w", encoding="utf-8")\n\n    def write_batch(self, items: List[dict]) -> None:\n        for item in items:\n            self._fh.write(json.dumps(item) + "\\n")\n        self._fh.flush()\n\n    def close(self) -> None:\n        try:\n            self._fh.close()\n        except Exception:\n            pass\n\n\n# ---------- State Machine ----------\ndef initial_state() -> dict:\n    return {\n        "state": LOGGED_OUT,\n        "login_time": None,\n        "large_tx_count": 0,\n    }\n\n\ndef update_state(state: Optional[dict], event: dict) -> Tuple[dict, Optional[dict]]:\n    """Apply the event to the state, returning (new_state, alert_or_None).\n\n    State is treated as immutable: we build a brand new dict each call.\n    """\n    if state is None:\n        state = initial_state()\n\n    event_type = event.get("event_type")\n    timestamp = event.get("timestamp")\n    amount = event.get("amount", 0) or 0\n\n    # Always honor logout immediately.\n    if event_type == "logout":\n        new_state = initial_state()\n        return new_state, None\n\n    if event_type == "login":\n        new_state = {\n            "state": LOGGED_IN,\n            "login_time": timestamp,\n            "large_tx_count": 0,\n        }\n        return new_state, None\n\n    if event_type == "transaction":\n        current = state["state"]\n        login_time = state["login_time"]\n\n        # If we\'re not currently logged in (LOGGED_OUT) or the login window\n        # has expired (>300 seconds since login), the transaction is ignored\n        # and we reset to LOGGED_OUT.\n        if current == LOGGED_OUT or login_time is None or timestamp - login_time > LARGE_TX_WINDOW_SECONDS:\n            new_state = initial_state()\n            return new_state, None\n\n        # We are within the 300-second login window.\n        new_large_tx_count = state["large_tx_count"]\n        new_status = current\n\n        if amount >= LARGE_TRANSACTION_THRESHOLD:\n            new_large_tx_count += 1\n            new_status = SUSPICIOUS\n\n        new_state = {\n            "state": new_status,\n            "login_time": login_time,\n            "large_tx_count": new_large_tx_count,\n        }\n\n        # Did we just cross the fraud threshold?\n        if new_large_tx_count >= LARGE_TX_COUNT_THRESHOLD:\n            alert = {"user_id": event["user_id"], "alert": "FRAUD_ALERT"}\n            # Reset to LOGGED_OUT after emitting the alert.\n            reset_state = initial_state()\n            return reset_state, alert\n\n        return new_state, None\n\n    # Unknown event types are ignored; state is unchanged.\n    return dict(state), None\n\n\n# ---------- Dataflow ----------\ndef build_dataflow(input_path: str, output_path: str) -> Dataflow:\n    flow = Dataflow("fraud_detection")\n\n    raw = op.input("input", flow, JSONLinesSource(input_path))\n\n    # Key by user_id so that state is maintained per user.\n    keyed = op.key_on("key_user", raw, lambda kv: kv[1]["user_id"])\n\n    # Value is the event payload.\n    events = op.map("value_only", keyed, lambda kv: kv[1])\n\n    # Stateful map: state machine per user.\n    alerts = op.stateful_map("fraud_state", events, update_state)\n\n    # Keep only the alert value (None events are dropped at the sink).\n    def to_sink(kv):\n        alert = kv[1]\n        return alert\n\n    only_alerts = op.filter("drop_none", alerts, lambda kv: kv[1] is not None)\n    cleaned = op.map("to_alert", only_alerts, to_sink)\n\n    op.output("alerts_out", cleaned, JSONLinesSink(output_path))\n    return flow\n\n\ndef main(argv: Optional[List[str]] = None) -> int:\n    parser = argparse.ArgumentParser(description="Bytewax Fraud Detection")\n    parser.add_argument("--input", required=True, help="Input JSONlines file")\n    parser.add_argument("--output", required=True, help="Output JSONlines file")\n    args = parser.parse_args(argv)\n\n    flow = build_dataflow(args.input, args.output)\n    run_main(flow)\n    return 0\n\n\nif __name__ == "__main__":\n    sys.exit(main())\nEOF\n'] min_timeout_sec: 0.5 max_timeout_sec: 180.0
