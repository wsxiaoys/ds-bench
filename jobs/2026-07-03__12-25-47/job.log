lidate({ value, validationSource: \'field\' }, z.string().min(2, \'Last name must be at least 2 characters\'))\n                },\n              }}\n            >\n              {(field) => (\n                <div className="field">\n                  <label htmlFor={field.name}>Last Name</label>\n                  <input\n                    id={field.name}\n                    name={field.name}\n                    type="text"\n                    value={field.state.value}\n                    onBlur={field.handleBlur}\n                    onChange={(e) => field.handleChange(e.target.value)}\n                  />\n                  {field.state.meta.errors.length > 0 && (\n                    <div className="error" data-testid={`${field.name}-error`}>\n                      {field.state.meta.errors[0]?.toString()}\n                    </div>\n                  )}\n                </div>\n              )}\n            </form.Field>\n            <div className="actions">\n              <button type="button" onClick={handleNext} data-testid="next-button">\n                Next\n              </button>\n            </div>\n          </div>\n        )}\n\n        {step === 2 && (\n          <div data-testid="step-2">\n            <h2>Account Info</h2>\n            <form.Field\n              name="email"\n              validators={{\n                onChange: ({ value }) => {\n                  const v = zodValidator()()\n                  return v.validate({ value, validationSource: \'field\' }, z.string().email(\'Invalid email address\'))\n                },\n              }}\n            >\n              {(field) => (\n                <div className="field">\n                  <label htmlFor={field.name}>Email</label>\n                  <input\n                    id={field.name}\n                    name={field.name}\n                    type="email"\n                    value={field.state.value}\n                    onBlur={field.handleBlur}\n                    o