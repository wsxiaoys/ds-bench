nd(\'target_desired_distance = 8.0\')\nlines.append(\'\')\nlines.append(\'[node name="Obstacles" type="Node2D" parent="."]\')\nlines.append(\'\')\n\n# Obstacle1 at (400, 220) -- above the corridor\nlines.append(\'[node name="Obstacle1" type="NavigationObstacle2D" parent="Obstacles"]\')\nlines.append(\'position = Vector2(400, 220)\')\nlines.append(\'vertices = \' + packed_vec_array(ob1_local))\nlines.append(\'affect_navigation_mesh = true\')\nlines.append(\'carve_navigation_mesh = true\')\nlines.append(\'\')\n\n# Obstacle2 at (400, 380) -- below the corridor\nlines.append(\'[node name="Obstacle2" type="NavigationObstacle2D" parent="Obstacles"]\')\nlines.append(\'position = Vector2(400, 380)\')\nlines.append(\'vertices = \' + packed_vec_array(ob2_local))\nlines.append(\'affect_navigation_mesh = true\')\nlines.append(\'carve_navigation_mesh = true\')\nlines.append(\'\')\n\n# Goal at (720, 300)\nlines.append(\'[node name="Goal" type="Marker2D" parent="."]\')\nlines.append(\'position = Vector2(720, 300)\')\n\ncontent = \'\\n\'.join(lines) + \'\\n\'\nwith open(\'/home/user/godot_project/scenes/nav_world.tscn\', \'w\') as f:\n    f.write(content)\nprint(\'done\')\nPYEOF\npython3 /tmp/write_scene.py\n'] min_timeout_sec: 0.3 max_timeout_sec: 180.0
