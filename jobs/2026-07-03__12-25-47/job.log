\n        assert(fresh_tilemap.get_cell_source_id(Vector2i(x, fresh.height - 1)) == 1)\n    for y in range(fresh.height):\n        assert(fresh_tilemap.get_cell_source_id(Vector2i(0, y)) == 1)\n        assert(fresh_tilemap.get_cell_source_id(Vector2i(fresh.width - 1, y)) == 1)\n    print("Test 5: Edge cells are walls OK")\n    \n    # Test 6: Determinism - same seed -> same data\n    var fresh2_script = load("res://scripts/DungeonGenerator.gd")\n    var fresh2 = fresh2_script.new()\n    var fresh2_tilemap := TileMapLayer.new()\n    fresh2_tilemap.tile_set = load("res://tilesets/dungeon.tres")\n    fresh2.generate(fresh2_tilemap)\n    \n    var diffs = 0\n    for y in range(fresh.height):\n        for x in range(fresh.width):\n            if fresh_tilemap.get_cell_source_id(Vector2i(x, y)) != fresh2_tilemap.get_cell_source_id(Vector2i(x, y)):\n                diffs += 1\n    print("Test 6: Determinism diffs: ", diffs)\n    assert(diffs == 0, "Same seed must produce same data")\n    \n    # Test 7: Different seed -> different data\n    fresh.seed = 99\n    fresh.generate(fresh_tilemap)\n    var diffs2 = 0\n    for y in range(fresh.height):\n        for x in range(fresh.width):\n            if fresh_tilemap.get_cell_source_id(Vector2i(x, y)) != fresh2_tilemap.get_cell_source_id(Vector2i(x, y)):\n                diffs2 += 1\n    print("Test 7: Different seed diffs: ", diffs2)\n    assert(diffs2 > 0, "Different seed must produce different data")\n    \n    # Test 8: Room properties\n    for r in rooms:\n        assert(r.position.x >= 1)\n        assert(r.position.y >= 1)\n        assert(r.position.x + r.size.x <= fresh.width - 1)\n        assert(r.position.y + r.size.y <= fresh.height - 1)\n    print("Test 8: Rooms inside interior OK")\n    \n    for i in range(rooms.size()):\n        for j in range(i + 1, rooms.size()):\n            assert(not rooms[i].intersects(rooms[j]), "Rooms must not overlap")\n    print("Test 8: Rooms non-overlapping OK")\n    \n    print("ALL TESTS PASSED")\n    quit(0)\nEOF\ncd /home/user/myproject && godot --headless --script /tmp/final_test.gd 2>&1 | tail -25\n'] min_timeout_sec: 8.0 max_timeout_sec: 180.0
