th.trunc(event.at) };\n  }\n  if (state.status === "loading" && event.type === "reject") {\n    return { status: "failure", code: event.code, reason: event.reason };\n  }\n  return state;\n});\n\nconsole.log("Transition tests:");\ntry {\n  console.log(transition({ status: "idle" }, { type: "start", at: 100 }));\n} catch(e) { console.log("ERROR:", String(e).substring(0, 200)); }\n\ntry {\n  console.log(transition({ status: "idle" }, { type: "reset" }));\n} catch(e) { console.log("ERROR:", String(e).substring(0, 200)); }\n\ntry {\n  console.log(transition({ status: "loading", startedAt: 5 }, { type: "resolve", data: "hello", at: 200 }));\n} catch(e) { console.log("ERROR:", String(e).substring(0, 200)); }\n\ntry {\n  console.log(transition({ status: "loading", startedAt: 5 }, { type: "reject", code: 500, reason: "oops", at: 200 }));\n} catch(e) { console.log("ERROR:", String(e).substring(0, 200)); }\n\ntry {\n  console.log(transition({ status: "loading", startedAt: 5 }, { type: "start", at: 200 }));\n} catch(e) { console.log("ERROR:", String(e).substring(0, 200)); }\n\ntry {\n  console.log(transition({ status: "bad" }, { type: "start", at: 100 }));\n} catch(e) { console.log("ERROR:", String(e).substring(0, 200)); }\nEOF\ncd /home/user/myproject && npx --no-install tsx arktest3.ts 2>&1 | head -100\n'] min_timeout_sec: 5.0 max_timeout_sec: 180.0
