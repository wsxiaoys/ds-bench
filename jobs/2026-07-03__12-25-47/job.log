Sending keys: ['cat > /home/user/projectile_sim/headless/src/main/java/com/example/sim/SimulationListener.java << \'EOF\'\npackage com.example.sim;\n\nimport com.badlogic.gdx.ApplicationAdapter;\nimport com.badlogic.gdx.Gdx;\nimport com.badlogic.gdx.files.FileHandle;\nimport com.badlogic.gdx.utils.Pool;\n\nimport java.io.BufferedWriter;\nimport java.io.IOException;\nimport java.nio.charset.StandardCharsets;\nimport java.nio.file.Files;\nimport java.nio.file.Path;\nimport java.nio.file.Paths;\nimport java.util.ArrayList;\nimport java.util.Collections;\nimport java.util.HashMap;\nimport java.util.List;\nimport java.util.Map;\n\npublic class SimulationListener extends ApplicationAdapter {\n\n    private final String scenarioPath;\n    private final String outputPath;\n\n    private int totalTicks = 0;\n    private int gravityX = 0;\n    private int gravityY = 0;\n    private int floorY = 0;\n    private final Map<Integer, List<int[]>> spawnsByTick = new HashMap<>();\n    private int totalSpawns = 0;\n\n    private final Pool<Projectile> pool = new Pool<Projectile>() {\n        @Override\n        protected Projectile newObject() {\n            return new Projectile();\n        }\n    };\n\n    private final List<Projectile> active = new ArrayList<>();\n\n    private int currentTick = 0;\n    private int groundedCount = 0;\n    private int peakActive = 0;\n    private int spawnIdCounter = 0;\n\n    private BufferedWriter writer;\n\n    public SimulationListener(String scenarioPath, String outputPath) {\n        this.scenarioPath = scenarioPath;\n        this.outputPath = outputPath;\n    }\n\n    @Override\n    public void create() {\n        try {\n            Path outFile = Paths.get(outputPath);\n            if (outFile.getParent() != null) {\n                Files.createDirectories(outFile.getParent());\n            }\n            writer = Files.newBufferedWriter(outFile, StandardCharsets.UTF_8);\n\n            FileHandle fh = Gdx.files.absolute(scenarioPath);\n            String contents = fh.readString("UTF-8");\n            parseScenario(contents);\n\n            writeLine("TICKS " + totalTicks);\n        } catch (IOException e) {\n            throw new RuntimeException("Failed to initialise simulation", e);\n        }\n    }\n\n    private void parseScenario(String contents) {\n        String[] lines = contents.split("\\r?\\n");\n        for (String raw : lines) {\n            String line = raw.trim();\n            if (line.isEmpty() || line.startsWith("#")) {\n                continue;\n            }\n            String[] parts = line.split("\\\\s+");\n            String head = parts[0];\n            switch (head) {\n                case "TICKS": {\n                    totalTicks = Integer.parseInt(parts[1]);\n                    break;\n                }\n                case "GRAVITY": {\n                    gravityX = Integer.parseInt(parts[1]);\n                    gravityY = Integer.parseInt(parts[2]);\n                    break;\n                }\n                case "FLOOR": {\n                    floorY = Integer.parseInt(parts[1]);\n                    break;\n                }\n                case "SPAWN": {\n                    int tick = Integer.parseInt(parts[1]);\n                    int x = Integer.parseInt(parts[2]);\n                    int y = Integer.parseInt(parts[3]);\n                    int vx = Integer.parseInt(parts[4]);\n                    int vy = Integer.parseInt(parts[5]);\n                    spawnsByTick.computeIfAbsent(tick, k -> new ArrayList<>()).add(new int[]{x, y, vx, vy});\n                    totalSpawns++;\n                    break;\n                }\n                default:\n                    throw new IllegalArgumentException("Unknown directive: " + head);\n            }\n        }\n    }\n\n    @Override\n    public void render() {\n        if (currentTick >= totalTicks) {\n            Gdx.app.exit();\n            return;\n        }\n\n        int tick = currentTick;\n\n        // 1. Spawn scheduled projectiles for this tick.\n        List<int[]> spawns = spawnsByTick.getOrDefault(tick, Collections.emptyList());\n        for (int[] s : spawns) {\n            Projectile p = pool.obtain();\n            p.id = spawnIdCounter++;\n            p.position.set(s[0], s[1]);\n            p.velocity.set(s[2], s[3]);\n            active.add(p);\n        }\n\n        // Track peak as the max simultaneously active count (right after spawning).\n        if (active.size() > peakActive) {\n            peakActive = active.size();\n        }\n\n        // 2. Integrate in spawn-id order.\n        List<Projectile> sorted = new ArrayList<>(active);\n        sorted.sort((a, b) -> Integer.compare(a.id, b.id));\n        for (Projectile p : sorted) {\n            p.velocity.x += gravityX;\n            p.velocity.y += gravityY;\n        }\n        for (Projectile p : sorted) {\n            p.position.x += p.velocity.x;\n            p.position.y += p.velocity.y;\n        }\n\n        // 3. Ground check.\n        List<int[]> groundedThisTick = new ArrayList<>(); // [id, ...]\n        List<Projectile> stillActive = new ArrayList<>(active.size());\n        for (Projectile p : active) {\n            if (p.position.y <= floorY) {\n                groundedThisTick.add(new int[]{p.id});\n                pool.free(p);\n                groundedCount++;\n            } else {\n                stillActive.add(p);\n            }\n        }\n        Collections.sort(groundedThisTick, (a, b) -> Integer.compare(a[0], b[0]));\n        stillActive.sort((a, b) -> Integer.compare(a.id, b.id));\n\n        // Emit tick summary.\n        writeLine("TICK " + tick + " ACTIVE " + stillActive.size());\n        for (Projectile p : stillActive) {\n            writeLine("P" + p.id + " x=" + (int) p.position.x\n                    + " y=" + (int) p.position.y\n                    + " vx=" + (int) p.velocity.x\n                    + " vy=" + (int) p.velocity.y);\n        }\n        for (int[] idHolder : groundedThisTick) {\n            writeLine("GROUNDED P" + idHolder[0] + " tick=" + tick);\n        }\n\n        active.clear();\n        active.addAll(stillActive);\n\n        currentTick++;\n\n        if (currentTick >= totalTicks) {\n            writeLine("SUMMARY spawned=" + totalSpawns\n                    + " grounded=" + groundedCount\n                    + " pool_free=" + pool.getFree()\n                    + " peak_active=" + peakActive);\n            Gdx.app.exit();\n        }\n    }\n\n    private void writeLine(String s) {\n        try {\n            writer.write(s);\n            writer.write("\\n");\n        } catch (IOException e) {\n            throw new RuntimeException("Failed to write log line", e);\n        }\n    }\n\n    @Override\n    public void dispose() {\n        if (writer != null) {\n            try {\n                writer.flush();\n                writer.close();\n            } catch (IOException ignored) {\n            }\n            writer = null;\n        }\n    }\n}\nEOF\n'] min_timeout_sec: 0.5 max_timeout_sec: 180.0
