Sending keys: ["cat > /home/user/myproject/scripts/DungeonGenerator.gd << 'EOF'\nextends Node\nclass_name DungeonGenerator\n\n@export var seed: int = 12345\n@export var width: int = 64\n@export var height: int = 64\n@export var wall_threshold: float = 0.0\n\nvar _rooms: Array[Rect2i] = []\n\nfunc generate(target: TileMapLayer) -> void:\n    _rooms.clear()\n    if target == null:\n        return\n    target.clear()\n\n    # 1. Noise pass\n    var noise := FastNoiseLite.new()\n    noise.seed = seed\n    noise.noise_type = FastNoiseLite.TYPE_PERLIN\n    noise.frequency = 0.1\n\n    for y in range(height):\n        for x in range(width):\n            var n: float = noise.get_noise_2d(x, y)\n            # n is in [-1, 1]; wall_threshold default 0.0 -> n >= 0 is floor\n            if n >= wall_threshold:\n                target.set_cell(Vector2i(x, y), 0, Vector2i(0, 0))\n            else:\n                target.set_cell(Vector2i(x, y), 1, Vector2i(1, 0))\n\n    # 2. Force outer edge to wall (source_id 1)\n    for x in range(width):\n        target.set_cell(Vector2i(x, 0), 1, Vector2i(1, 0))\n        target.set_cell(Vector2i(x, height - 1), 1, Vector2i(1, 0))\n    for y in range(height):\n        target.set_cell(Vector2i(0, y), 1, Vector2i(1, 0))\n        target.set_cell(Vector2i(width - 1, y), 1, Vector2i(1, 0))\n\n    # 3. Carve rooms deterministically using a separate RNG seeded from seed\n    var rng := RandomNumberGenerator.new()\n    rng.seed = seed\n\n    var room_count: int = 4\n    var max_attempts: int = 64\n    var attempts: int = 0\n    var min_size: int = 4\n    var max_size: int = 8\n\n    while _rooms.size() < room_count and attempts < max_attempts:\n        attempts += 1\n        var rw: int = rng.randi_range(min_size, max_size)\n        var rh: int = rng.randi_range(min_size, max_size)\n        var rx: int = rng.randi_range(1, width - 2 - rw)\n        var ry: int = rng.randi_range(1, height - 2 - rh)\n        var rect := Rect2i(rx, ry, rw, rh)\n        var ok: bool = true\n        for r in _rooms:\n            if r.intersects(rect):\n                ok = false\n                break\n        if not ok:\n            continue\n        _rooms.append(rect)\n        # Carve the room (write floor)\n        for y2 in range(ry, ry + rh):\n            for x2 in range(rx, rx + rw):\n                target.set_cell(Vector2i(x2, y2), 0, Vector2i(0, 0))\n\n    # 4. Connect rooms with L-shaped corridors\n    for i in range(1, _rooms.size()):\n        var prev: Rect2i = _rooms[i - 1]\n        var cur: Rect2i = _rooms[i]\n        var p_center: Vector2i = Vector2i(prev.position.x + prev.size.x / 2, prev.position.y + prev.size.y / 2)\n        var c_center: Vector2i = Vector2i(cur.position.x + cur.size.x / 2, cur.position.y + cur.size.y / 2)\n        # L-shape: horizontal then vertical (deterministic)\n        var step_x: int = 1 if c_center.x >= p_center.x else -1\n        var step_y: int = 1 if c_center.y >= p_center.y else -1\n        var x0: int = p_center.x\n        while x0 != c_center.x:\n            target.set_cell(Vector2i(x0, p_center.y), 0, Vector2i(0, 0))\n            x0 += step_x\n        # ensure the endpoint is carved too\n        target.set_cell(Vector2i(c_center.x, p_center.y), 0, Vector2i(0, 0))\n        var y0: int = p_center.y\n        while y0 != c_center.y:\n            target.set_cell(Vector2i(c_center.x, y0), 0, Vector2i(0, 0))\n            y0 += step_y\n        target.set_cell(Vector2i(c_center.x, c_center.y), 0, Vector2i(0, 0))\n\nfunc count_floor_tiles(target: TileMapLayer) -> int:\n    var count: int = 0\n    for y in range(height):\n        for x in range(width):\n            if target.get_cell_source_id(Vector2i(x, y)) == 0:\n                count += 1\n    return count\n\nfunc find_rooms() -> Array[Rect2i]:\n    return _rooms\nEOF\necho 'Script written'\nwc -l /home/user/myproject/scripts/DungeonGenerator.gd\n"] min_timeout_sec: 0.5 max_timeout_sec: 180.0
