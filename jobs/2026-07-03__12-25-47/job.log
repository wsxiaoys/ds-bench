Sending keys: ["cat > /tmp/solve.py << 'EOF'\nimport json\nimport numpy as np\nimport librosa\nimport soundfile as sf\n\nINPUT_PATH = '/home/user/input.wav'\nOUTPUT_PATH = '/home/user/peaks.json'\n\n# Load audio\ny, sr = sf.read(INPUT_PATH)\nif y.ndim > 1:\n    y = np.mean(y, axis=1)\nduration = len(y) / sr\n\n# STFT parameters\nn_fft = 2048\nhop_length = 512\n\n# Compute reassigned spectrogram\n# Returns (freqs, times, mags)\nfreqs, times, mags = librosa.reassigned_spectrogram(\n    y, sr=sr, n_fft=n_fft, hop_length=hop_length, center=True\n)\n\nprint('freqs.shape:', freqs.shape)\nprint('times.shape:', times.shape)\nprint('mags.shape:', mags.shape)\nprint('sr:', sr, 'duration:', duration)\nprint('n_frames:', freqs.shape[-1])\nprint('first times:', times[0, :5] if times.ndim == 2 else times[:5])\nprint('last time:', times[0, -1] if times.ndim == 2 else times[-1])\n\n# Verify shape: (1 + n_fft/2, n_frames)\nassert freqs.shape == (n_fft // 2 + 1, freqs.shape[-1])\n\nn_frames = freqs.shape[-1]\n\n# Convert magnitudes to dB\nmags_db = librosa.amplitude_to_db(mags, ref=np.max)\n\n# For each frame, get top-5 peaks\nframes_out = []\nfor t_idx in range(n_frames):\n    f_col = freqs[:, t_idx] if freqs.ndim == 2 else freqs[..., t_idx]\n    m_col = mags_db[:, t_idx] if mags_db.ndim == 2 else mags_db[..., t_idx]\n    \n    # Mask out NaN/inf in frequencies (and corresponding magnitudes)\n    finite_mask = np.isfinite(f_col) & np.isfinite(m_col)\n    # Also require freq > 0 and <= sr/2\n    valid_mask = finite_mask & (f_col > 0.0) & (f_col <= sr / 2.0)\n    \n    valid_idx = np.where(valid_mask)[0]\n    \n    if len(valid_idx) == 0:\n        # Shouldn't happen for typical input, but handle gracefully\n        peaks = []\n        for _ in range(5):\n            peaks.append({'freq_hz': float(sr / 2.0), 'magnitude_db': -np.inf})\n        # But magnitude_db must be finite. Use a large negative number? Actually -inf isn't finite.\n        # Let's pick 5 dummy finite peaks instead\n        peaks = [{'freq_hz': float(sr/2.0), 'magnitude_db': -1e10} for _ in range(5)]\n    else:\n        valid_mags = m_col[valid_idx]\n        # Sort by magnitude descending, take top 5\n        # Use argpartition for efficiency, then argsort on the partition\n        k = min(5, len(valid_idx))\n        if k < 5:\n            # Pad with copies of the smallest available peak\n            top_k_local = np.argsort(-valid_mags)[:k]\n            top_k_idx = valid_idx[top_k_local]\n            while len(top_k_idx) < 5:\n                top_k_idx = np.concatenate([top_k_idx, [top_k_idx[-1]]])\n        else:\n            # Get top 5 by magnitude\n            top_k_local = np.argpartition(-valid_mags, 4)[:5]\n            top_k_local = top_k_local[np.argsort(-valid_mags[top_k_local])]\n            top_k_idx = valid_idx[top_k_local]\n        \n        peaks = []\n        for idx in top_k_idx:\n            f_val = float(f_col[idx])\n            m_val = float(m_col[idx])\n            # Final safety: ensure finite\n            if not np.isfinite(f_val):\n                f_val = float(sr / 2.0)\n            if not np.isfinite(m_val):\n                m_val = -1e10\n            peaks.append({'freq_hz': f_val, 'magnitude_db': m_val})\n    \n    # Get time for this frame\n    time_val = float(times[0, t_idx]) if times.ndim == 2 else float(times[t_idx])\n    if not np.isfinite(time_val):\n        time_val = float(t_idx * hop_length / sr)\n    \n    frames_out.append({\n        'time': time_val,\n        'peaks': peaks\n    })\n\noutput = {\n    'meta': {\n        'n_frames': n_frames,\n        'sr': int(sr),\n        'n_fft': n_fft,\n        'hop_length': hop_length\n    },\n    'frames': frames_out\n}\n\nwith open(OUTPUT_PATH, 'w') as f:\n    json.dump(output, f)\n\nprint('Wrote', OUTPUT_PATH)\nprint('First frame:', frames_out[0])\nprint('Last frame:', frames_out[-1])\nEOF\n"] min_timeout_sec: 0.2 max_timeout_sec: 180.0
