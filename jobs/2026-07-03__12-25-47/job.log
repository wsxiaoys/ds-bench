Sending keys: ["cat > /home/user/altair_project/build_chart.py << 'PYEOF'\nimport altair as alt\nfrom vega_datasets import data\n\n# Data source: use the URL directly from vega_datasets (no pandas processing)\nsource = data.sp500.url\n\n# Brush selection restricted to x-axis, used by the lower (context) chart\nbrush = alt.selection_interval(encodings=['x'])\n\n# Lower (context) chart: small overview with brush\ncontext = (\n    alt.Chart(source)\n    .mark_area()\n    .encode(\n        x=alt.X('date:T', title='Date'),\n        y=alt.Y('price:Q', title='Price'),\n    )\n    .properties(\n        height=60,\n        title='S&P 500 Overview (drag to brush)',\n    )\n    .add_params(brush)\n)\n\n# Upper (detail) chart: large area whose x-domain follows the brush\ndetail = (\n    alt.Chart(source)\n    .mark_area()\n    .encode(\n        x=alt.X(\n            'date:T',\n            title='Date',\n            scale=alt.Scale(domain=brush),\n        ),\n        y=alt.Y('price:Q', title='Price'),\n    )\n    .properties(\n        height=300,\n        title='S&P 500 Detail',\n    )\n)\n\n# Horizontal rule marking the running maximum price inside the brushed window.\n# Computed inside the spec: filter by brush, then aggregate max of price.\nmax_rule = (\n    alt.Chart(source)\n    .transform_filter(brush)\n    .transform_aggregate(max_price='max(price)')\n    .mark_rule(color='firebrick', size=2)\n    .encode(y='max_price:Q')\n)\n\n# Layer the rule onto the detail chart, then concatenate detail over context\ndetail_with_rule = alt.layer(detail, max_rule)\n\nchart = detail_with_rule & context\n\nif __name__ == '__main__':\n    chart.save('/home/user/altair_project/chart.html')\n    print('Saved /home/user/altair_project/chart.html')\nPYEOF\n"] min_timeout_sec: 0.2 max_timeout_sec: 180.0
