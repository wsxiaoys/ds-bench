Sending keys: ['cat > /home/user/turn-based-game/headless/src/main/java/launcher/HeadlessLauncher.java << \'EOF\'\npackage launcher;\n\nimport com.badlogic.gdx.ApplicationListener;\nimport com.badlogic.gdx.Gdx;\nimport com.badlogic.gdx.backends.headless.HeadlessApplication;\nimport com.badlogic.gdx.backends.headless.HeadlessApplicationConfiguration;\nimport com.badlogic.gdx.files.FileHandle;\nimport game.ScriptedMockInput;\nimport game.TurnBasedGame;\n\nimport java.io.File;\nimport java.util.ArrayList;\nimport java.util.List;\nimport java.util.concurrent.CountDownLatch;\n\n/**\n * Headless launcher. Boots a {@link HeadlessApplication} running a {@link TurnBasedGame}\n * driven by commands read from a script file. The transcript is written via libGDX\'s\n * {@link Gdx#files} subsystem, then the JVM is allowed to terminate cleanly with exit code 0.\n */\npublic final class HeadlessLauncher {\n\n    private HeadlessLauncher() { }\n\n    public static void main(String[] args) {\n        String mapPath = null;\n        String commandsPath = null;\n        String transcriptPath = null;\n        for (String a : args) {\n            if (a == null) continue;\n            if (a.startsWith("--map=")) mapPath = a.substring("--map=".length());\n            else if (a.startsWith("--commands=")) commandsPath = a.substring("--commands=".length());\n            else if (a.startsWith("--transcript=")) transcriptPath = a.substring("--transcript=".length());\n        }\n        if (mapPath == null || commandsPath == null || transcriptPath == null) {\n            System.err.println("Usage: HeadlessLauncher --map=<path> --commands=<path> --transcript=<path>");\n            System.exit(2);\n            return;\n        }\n\n        // Read commands file via standard IO (parsing is independent of libGDX).\n        List<String> commands = readCommands(commandsPath);\n\n        // The transcript and map will be read through Gdx.files once Gdx.files exists.\n        // We construct the listener first; Gdx.files is alive after HeadlessApplication ctor.\n        CountDownLatch mainLoopDone = new CountDownLatch(1);\n\n        HeadlessApplication app;\n        {\n            HeadlessApplicationConfiguration cfg = new HeadlessApplicationConfiguration();\n            // Run as fast as possible.\n            cfg.updatesPerSecond = 0;\n            cfg.renderInterval = 0f;\n            cfg.idleFPS = 0;\n            ScriptedMockInput scripted = new ScriptedMockInput(commands);\n            FileHandle mapHandle = Gdx.files.absolute(new File(mapPath).getAbsolutePath());\n            FileHandle transcriptHandle = Gdx.files.absolute(new File(transcriptPath).getAbsolutePath());\n            TurnBasedGame game = new TurnBasedGame(mapHandle, transcriptHandle, scripted);\n            // Wrap the listener so we can observe when the headless main loop terminates.\n            ApplicationListener wrapper = new LoopTerminator(game, mainLoopDone);\n            app = new HeadlessApplication(wrapper, cfg);\n            // Replace Gdx.input with our scripted subclass immediately.\n            Gdx.input = scripted;\n        }\n\n        // Block the main thread until the headless main-loop thread signals done.\n        try {\n            mainLoopDone.await();\n        } catch (InterruptedException ie) {\n            Thread.currentThread().interrupt();\n        }\n        // Ensure resources are released.\n        app.exit();\n    }\n\n    private static List<String> readCommands(String path) {\n        List<String> out = new ArrayList<String>();\n        java.io.BufferedReader br = null;\n        try {\n            br = new java.io.BufferedReader(\n                    new java.io.InputStreamReader(\n                            new java.io.FileInputStream(path), "UTF-8"));\n            String line;\n            while ((line = br.readLine()) != null) {\n                String trimmed = line.trim();\n                if (trimmed.isEmpty()) continue;\n                if (trimmed.startsWith("#")) continue;\n                out.add(trimmed);\n            }\n        } catch (java.io.IOException ioe) {\n            throw new RuntimeException("Failed to read commands file: " + path, ioe);\n        } finally {\n            if (br != null) {\n                try { br.close(); } catch (java.io.IOException ignored) { }\n            }\n        }\n        return out;\n    }\n\n    /** Wraps a listener so we can fire a latch when the headless main loop stops. */\n    private static final class LoopTerminator implements ApplicationListener {\n        private final ApplicationListener delegate;\n        private final CountDownLatch latch;\n        private boolean disposed = false;\n\n        LoopTerminator(ApplicationListener delegate, CountDownLatch latch) {\n            this.delegate = delegate;\n            this.latch = latch;\n        }\n\n        @Override\n        public void create() { delegate.create(); }\n\n        @Override\n        public void render() {\n            try {\n                delegate.render();\n            } finally {\n                if (disposed) latch.countDown();\n            }\n        }\n\n        @Override\n        public void pause() { delegate.pause(); }\n\n        @Override\n        public void resize(int width, int height) { delegate.resize(width, height); }\n\n        @Override\n        public void resume() { delegate.resume(); }\n\n        @Override\n        public void dispose() {\n            try {\n                delegate.dispose();\n            } finally {\n                disposed = true;\n                latch.countDown();\n            }\n        }\n    }\n}\nEOF\n'] min_timeout_sec: 0.1 max_timeout_sec: 180.0
