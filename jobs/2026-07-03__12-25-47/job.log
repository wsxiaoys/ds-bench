th}, size: {os.path.getsize(jpeg_path)} bytes")\n    \n    async with async_playwright() as p:\n        browser = await p.chromium.launch(headless=True, args=[\'--no-sandbox\'])\n        context = await browser.new_context()\n        page = await context.new_page()\n        \n        page.on(\'console\', lambda msg: print(f"[console.{msg.type}]: {msg.text}"))\n        \n        await page.goto(\'http://127.0.0.1:4173/\')\n        await page.wait_for_load_state(\'networkidle\')\n        \n        async with page.expect_file_chooser() as fc_info:\n            click_task = asyncio.create_task(page.click(\'#capture-btn\'))\n        file_chooser = await fc_info.value\n        await file_chooser.set_files(jpeg_path)\n        await click_task\n        \n        await page.wait_for_function(\n            "() => document.getElementById(\'capture-status\').textContent === \'saved\'",\n            timeout=15000\n        )\n        \n        photos = await page.evaluate("window.gallery.listPhotos()")\n        print(f"Photos: {photos}")\n        \n        idb = await dump_idb(page)\n        print("IndexedDB contents:")\n        for db_name, stores in idb.items():\n            print(f"  DB: {db_name}")\n            for store, items in stores.items():\n                print(f"    Store: {store} ({len(items)} items)")\n                for item in items[:5]:\n                    print(f"      {repr(item)[:200]}")\n        \n        # Verify the Filesystem file is stored in IndexedDB\n        fs_files = idb.get(\'Filesystem\', {})\n        print(f"\\nFilesystem stores: {list(fs_files.keys())}")\n        for store, items in fs_files.items():\n            for item in items:\n                print(f"  [{store}]: {repr(item)[:300]}")\n        \n        await browser.close()\n\nasyncio.run(main())\nEOF\npython3 /tmp/test_gallery2.py\n'] min_timeout_sec: 30.0 max_timeout_sec: 180.0
