Sending keys: ['cat > /tmp/test_prefs.py << \'EOF\'\nimport asyncio\nfrom playwright.async_api import async_playwright\nimport base64\nimport os\nimport re\n\nJPEG_B64 = (\n    "/9j/4AAQSkZJRgABAQEAYABgAAD/2wBDAAEBAQEBAQEBAQEBAQEBAQEBAQEBAQEBAQEBAQEBAQEB"\n    "AQEBAQEBAQEBAQEBAQEBAQEBAQEBAQEBAQEBAQEBAQEBAQEBAQEB/9sAQwEBAQEBAQEBAQEBAQEB"\n    "AQEBAQEBAQEBAQEBAQEBAQEBAQEBAQEBAQEBAQEBAQEBAQEBAQEBAQEBAQEBAQEBAQEBAQEB/8AA"\n    "QECAwQFBgcICQoL/8QAFQABAQAAAAAAAAAAAAAAAAAAAAv/xAAUEAEAAAAAAAAAAAAAAAAAAAAA/9o"\n    "ADAMBAAIRAxEAPwBVAAH//9k="\n)\n\ndef make_jpeg():\n    b64 = JPEG_B64 + "=" * (-len(JPEG_B64) % 4)\n    jpeg_bytes = base64.b64decode(b64)\n    path = \'/tmp/test3.jpg\'\n    with open(path, \'wb\') as f:\n        f.write(jpeg_bytes)\n    return path\n\nasync def main():\n    jpeg_path = make_jpeg()\n    \n    async with async_playwright() as p:\n        browser = await p.chromium.launch(headless=True, args=[\'--no-sandbox\'])\n        context = await browser.new_context()\n        page = await context.new_page()\n        \n        await page.goto(\'http://127.0.0.1:4173/\')\n        await page.wait_for_load_state(\'networkidle\')\n        \n        # Capture 2 photos\n        for i in range(2):\n            async with page.expect_file_chooser() as fc_info:\n                click_task = asyncio.create_task(page.click(\'#capture-btn\'))\n            file_chooser = await fc_info.value\n            await file_chooser.set_files(jpeg_path)\n            await click_task\n            \n            await page.wait_for_function(\n                f"() => document.getElementById(\'capture-status\').textContent === \'saved\'",\n                timeout=15000\n            )\n            print(f"Captured photo {i+1}")\n            await asyncio.sleep(0.5)\n        \n        photos = await page.evaluate("window.gallery.listPhotos()")\n        print(f"Photos after 2 captures: {photos}")\n        assert len(photos) == 2\n        \n        # Check the Preferences storage in IndexedDB\n        prefs = await page.evaluate("""async () => {\n            return new Promise((resolve, reject) => {\n                const req = indexedDB.open(\'CapacitorPreferences\');\n                req.onsuccess = () => {\n                    const db = req.result;\n                    const tx = db.transaction(\'Preferences\', \'readonly\');\n                    const store = tx.objectStore(\'Preferences\');\n                    const all = store.getAll();\n                    all.onsuccess = () => resolve(all.result);\n                    all.onerror = () => reject(all.error);\n                };\n                req.onerror = () => reject(req.error);\n            });\n        }""")\n        print(f"Preferences: {prefs}")\n        \n        # Now delete the first photo\n        first = photos[0]\n        await page.evaluate(f"window.gallery.deletePhoto({first!r})")\n        photos_after = await page.evaluate("window.gallery.listPhotos()")\n        print(f"Photos after deleting first: {photos_after}")\n        assert len(photos_after) == 1\n        \n        # Try to delete non-existent path - should still update index\n        await page.evaluate("window.gallery.deletePhoto(\'photos/does-not-exist.jpeg\')")\n        photos_after2 = await page.evaluate("window.gallery.listPhotos()")\n        print(f"Photos after deleting non-existent: {photos_after2}")\n        assert len(photos_after2) == 1, f"Expected 1, got {len(photos_after2)}"\n        \n        await browser.close()\n        print("=== ALL ADVANCED TESTS PASSED ===")\n\nasyncio.run(main())\nEOF\npython3 /tmp/test_prefs.py\n'] min_timeout_sec: 30.0 max_timeout_sec: 180.0
