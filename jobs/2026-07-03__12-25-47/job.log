func ListTasks(ctx context.Context) (*ListTasksResponse, error) {\n\\trows, err := taskdb.Query(ctx, SQLQSELECT id, title, description, done FROM tasks ORDER BY idSQLQ)\n\\tif err != nil {\n\\t\\treturn nil, err\n\\t}\n\\tdefer rows.Close()\n\n\\ttasks := []Task{}\n\\tfor rows.Next() {\n\\t\\tvar t Task\n\\t\\tif err := rows.Scan(&t.ID, &t.Title, &t.Description, &t.Done); err != nil {\n\\t\\t\\treturn nil, err\n\\t\\t}\n\\t\\ttasks = append(tasks, t)\n\\t}\n\\tif err := rows.Err(); err != nil {\n\\t\\treturn nil, err\n\\t}\n\\treturn &ListTasksResponse{Tasks: tasks}, nil\n}\n\n// GetTask gets a single task by ID.\n//encore:api public method=GET path=/tasks/:id\nfunc GetTask(ctx context.Context, id int64) (*Task, error) {\n\\tt := &Task{}\n\\terr := taskdb.QueryRow(ctx, SQLQ\\n\\t\\tSELECT id, title, description, done FROM tasks WHERE id = $1\\n\\tSQLQ, id).Scan(&t.ID, &t.Title, &t.Description, &t.Done)\n\\tif err != nil {\n\\t\\tif errors.Is(err, sql.ErrNoRows) {\n\\t\\t\\treturn nil, &errNotFound{fmt.Sprintf("task %d not found", id)}\n\\t\\t}\n\\t\\treturn nil, err\n\\t}\n\\treturn t, nil\n}\n\n// UpdateTask updates a task\'s title, description, and done status.\n//encore:api public method=PUT path=/tasks/:id\nfunc UpdateTask(ctx context.Context, id int64, params *UpdateTaskParams) (*Task, error) {\n\\tt := &Task{}\n\\terr := taskdb.QueryRow(ctx, SQLQ\\n\\t\\tUPDATE tasks SET title = $1, description = $2, done = $3\\n\\t\\tWHERE id = $4\\n\\t\\tRETURNING id, title, description, done\\n\\tSQLQ, params.Title, params.Description, params.Done, id).Scan(&t.ID, &t.Title, &t.Description, &t.Done)\n\\tif err != nil {\n\\t\\tif errors.Is(err, sql.ErrNoRows) {\n\\t\\t\\treturn nil, &errNotFound{fmt.Sprintf("task %d not found", id)}\n\\t\\t}\n\\t\\treturn nil, err\n\\t}\n\\treturn t, nil\n}\n\n// DeleteTask deletes a task by ID.\n//encore:api public method=DELETE path=/tasks/:id\nfunc DeleteTask(ctx context.Context, id int64) error {\n\\tres, err := taskdb.Exec(ctx, SQLQDELETE FROM tasks WHERE id = $1SQLQ, id)\n\\tif err != nil {\n\\t\\treturn err\n\\t}\n\\tif n, err := res.RowsAffected(); err != nil {\n\\t\\treturn err\n\\t} else if n == 0 {\n\\t\\treturn &errNotFound{fmt.Sprintf("task %d not found", id)}\n\\t}\n\\treturn nil\n}\n\ntype errNotFound struct{ msg string }\n\nfunc (e *errNotFound) Error() string { return e.msg }\n\'\'\'\n\n# Replace placeholders\ncode = code.replace(\'BACKTICK\', chr(96))\ncode = code.replace(\'SQLQ\', chr(96))\n\nwith open(\'/home/user/task/task.go\', \'w\') as f:\n    f.write(code)\nprint(\'task.go written, length:\', len(code))\nPYEOF\npython3 /tmp/gen_task.py\n'] min_timeout_sec: 0.5 max_timeout_sec: 180.0
