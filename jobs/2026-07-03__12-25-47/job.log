    process.stderr.write(\'Auth failed: \' + (e && e.message ? e.message : e) + \'\\n\');\n    process.exit(1);\n  }\n\n  const safeChat = String(args.chat).replace(/\'/g, "\\\\\'");\n  const filter = "chat=\'" + safeChat + "\'";\n\n  try {\n    unsubFn = await pb.collection(\'messages\').subscribe(\'*\', function (e) {\n      if (!e) return;\n      const record = e.record || {};\n      writeLine({ action: e.action, record: record });\n    }, { filter: filter });\n  } catch (e) {\n    process.stderr.write(\'Subscribe failed: \' + (e && e.message ? e.message : e) + \'\\n\');\n    process.exit(1);\n  }\n\n  process.stderr.write(\'Subscribed to messages with filter: \' + filter + \'\\n\');\n})();\nJSEOF\n'] min_timeout_sec: 0.3 max_timeout_sec: 180.0
