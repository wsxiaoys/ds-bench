d}\\n`;\n  process.stdout.write(keyLine);\n  await writeFile("/home/user/tigris-task/output.log", keyLine, "utf8");\n}\n\nmain().catch((err) => {\n  console.error("Unhandled error:", err);\n  process.exit(1);\n});\nEOF\n'] min_timeout_sec: 0.1 max_timeout_sec: 180.0
