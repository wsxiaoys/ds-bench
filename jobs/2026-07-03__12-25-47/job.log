Sending keys: ['python3 << \'PYEOF\'\ncode = \'\'\'package main\n\nimport (\n\t"context"\n\t"database/sql"\n\t"errors"\n\t"fmt"\n\t"log"\n\t"net/http"\n\t"net/url"\n\t"os"\n\t"strings"\n\t"time"\n\n\t"github.com/aws/aws-sdk-go-v2/aws"\n\tawsconfig "github.com/aws/aws-sdk-go-v2/config"\n\t"github.com/aws/aws-sdk-go-v2/credentials"\n\t"github.com/aws/aws-sdk-go-v2/service/s3"\n\t"github.com/aws/smithy-go"\n\t"github.com/google/uuid"\n\t"github.com/pocketbase/pocketbase"\n\t"github.com/pocketbase/pocketbase/apis"\n\t"github.com/pocketbase/pocketbase/core"\n\t"github.com/pocketbase/pocketbase/models"\n\t"github.com/pocketbase/pocketbase/models/schema"\n\t"github.com/pocketbase/pocketbase/tools/routine"\n)\n\nconst (\n\tdefaultEndpoint  = "http://127.0.0.1:9000"\n\tdefaultRegion    = "us-east-1"\n\tdefaultBucket    = "uploads"\n\tdefaultAccessKey = "minioadmin"\n\tdefaultSecretKey = "minioadmin"\n\tpresignExpires   = 5 * time.Minute\n)\n\nfunc envOr(key, def string) string {\n\tif v := os.Getenv(key); v != "" {\n\t\treturn v\n\t}\n\treturn def\n}\n\ntype s3Config struct {\n\tEndpoint  string\n\tRegion    string\n\tBucket    string\n\tAccessKey string\n\tSecretKey string\n}\n\nfunc loadS3Config() s3Config {\n\treturn s3Config{\n\t\tEndpoint:  envOr("MINIO_ENDPOINT", defaultEndpoint),\n\t\tRegion:    envOr("MINIO_REGION", defaultRegion),\n\t\tBucket:    envOr("MINIO_BUCKET", defaultBucket),\n\t\tAccessKey: envOr("MINIO_ACCESS_KEY", defaultAccessKey),\n\t\tSecretKey: envOr("MINIO_SECRET_KEY", defaultSecretKey),\n\t}\n}\n\nfunc ensureScheme(endpoint string) string {\n\tif strings.HasPrefix(endpoint, "http://") || strings.HasPrefix(endpoint, "https://") {\n\t\treturn endpoint\n\t}\n\treturn "http://" + endpoint\n}\n\nfunc newS3Client(ctx context.Context, cfg s3Config) (*s3.Client, error) {\n\tendpoint := ensureScheme(cfg.Endpoint)\n\n\tawsCfg, err := awsconfig.LoadDefaultConfig(ctx,\n\t\tawsconfig.WithRegion(cfg.Region),\n\t\tawsconfig.WithCredentialsProvider(credentials.NewStaticCredentialsProvider(cfg.AccessKey, cfg.SecretKey, "")),\n\t)\n\tif err != nil {\n\t\treturn nil, err\n\t}\n\n\treturn s3.NewFromConfig(awsCfg, func(o *s3.Options) {\n\t\to.BaseEndpoint = aws.String(endpoint)\n\t\to.UsePathStyle = true\n\t}), nil\n}\n\nfunc newPresignClient(client *s3.Client) *s3.PresignClient {\n\treturn s3.NewPresignClient(client)\n}\n\nfunc ensureCollections(app core.App) error {\n\t// pending_upload\n\tpending, err := app.Dao().FindCollectionByNameOrId("pending_upload")\n\tif err != nil {\n\t\tif !errors.Is(err, sql.ErrNoRows) {\n\t\t\treturn fmt.Errorf("find pending_upload: %w", err)\n\t\t}\n\t\tcol := models.NewBaseCollection("pending_upload")\n\t\tcol.Fields.Add(\n\t\t\t&schema.SchemaField{\n\t\t\t\tName:    "user",\n\t\t\t\tType:    schema.FieldTypeRelation,\n\t\t\t\tOptions: &schema.RelationOptions{MaxSelect: 1, CollectionId: "_pb_users_auth_", Required: true, CascadeDelete: false},\n\t\t\t},\n\t\t\t&schema.SchemaField{\n\t\t\t\tName:    "key",\n\t\t\t\tType:    schema.FieldTypeText,\n\t\t\t\tOptions: &schema.TextOptions{Required: true, Pattern: "^[a-f0-9-]{16,}$"},\n\t\t\t},\n\t\t\t&schema.SchemaField{\n\t\t\t\tName:    "expires_at",\n\t\t\t\tType:    schema.FieldTypeDate,\n\t\t\t\tOptions: &schema.DateOptions{Required: true},\n\t\t\t},\n\t\t)\n\t\tcol.Indexes = []string{"CREATE UNIQUE INDEX idx_pending_upload_key ON pending_upload ([[key]])"}\n\t\tif err := app.Dao().SaveCollection(col); err != nil {\n\t\t\treturn fmt.Errorf("create pending_upload: %w", err)\n\t\t}\n\t\tlog.Println("created pending_upload collection")\n\t} else {\n\t\t// Ensure the unique index on key exists for existing collection\n\t\tif _, idxErr := app.Dao().FindIndexByName("idx_pending_upload_key"); idxErr != nil {\n\t\t\tif !errors.Is(idxErr, sql.ErrNoRows) {\n\t\t\t\treturn fmt.Errorf("find pending_upload index: %w", idxErr)\n\t\t\t}\n\t\t\tidx := models.NewIndex("idx_pending_upload_key", "CREATE UNIQUE INDEX idx_pending_upload_key ON pending_upload ([[key]])", pending)\n\t\t\tif err := app.Dao().SaveIndex(idx); err != nil {\n\t\t\t\treturn fmt.Errorf("save pending_upload index: %w", err)\n\t\t\t}\n\t\t}\n\t}\n\n\tuploads, err := app.Dao().FindCollectionByNameOrId("uploads")\n\tif err != nil {\n\t\tif !errors.Is(err, sql.ErrNoRows) {\n\t\t\treturn fmt.Errorf("find uploads: %w", err)\n\t\t}\n\t\tcol := models.NewBaseCollection("uploads")\n\t\tcol.Fields.Add(\n\t\t\t&schema.SchemaField{\n\t\t\t\tName:    "user",\n\t\t\t\tType:    schema.FieldTypeRelation,\n\t\t\t\tOptions: &schema.RelationOptions{MaxSelect: 1, CollectionId: "_pb_users_auth_", Required: true, CascadeDelete: false},\n\t\t\t},\n\t\t\t&schema.SchemaField{\n\t\t\t\tName:    "key",\n\t\t\t\tType:    schema.FieldTypeText,\n\t\t\t\tOptions: &schema.TextOptions{Required: true, Pattern: "^[a-f0-9-]{16,}$"},\n\t\t\t},\n\t\t)\n\t\tcol.Indexes = []string{"CREATE UNIQUE INDEX idx_uploads_key ON uploads ([[key]])"}\n\t\tif err := app.Dao().SaveCollection(col); err != nil {\n\t\t\treturn fmt.Errorf("create uploads: %w", err)\n\t\t}\n\t\tlog.Println("created uploads collection")\n\t} else {\n\t\tif _, idxErr := app.Dao().FindIndexByName("idx_uploads_key"); idxErr != nil {\n\t\t\tif !errors.Is(idxErr, sql.ErrNoRows) {\n\t\t\t\treturn fmt.Errorf("find uploads index: %w", idxErr)\n\t\t\t}\n\t\t\tidx := models.NewIndex("idx_uploads_key", "CREATE UNIQUE INDEX idx_uploads_key ON uploads ([[key]])", uploads)\n\t\t\tif err := app.Dao().SaveIndex(idx); err != nil {\n\t\t\t\treturn fmt.Errorf("save uploads index: %w", err)\n\t\t\t}\n\t\t}\n\t}\n\n\treturn nil\n}\n\'\'\'\n\nwith open(\'/home/user/myapp/main.go\', \'w\') as f:\n    f.write(code)\nprint(\'written part 1\')\nPYEOF\n'] min_timeout_sec: 1.0 max_timeout_sec: 180.0
