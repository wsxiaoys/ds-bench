Sending keys: ['cat > /home/user/myproject/parse_pdf.py << \'PYEOF\'\nimport os\nimport sys\nimport httpx\nfrom pathlib import Path\nfrom llama_cloud import LlamaCloud\n\nINPUT_PDF = "/home/user/myproject/input.pdf"\nOUTPUT_DIR = Path("/home/user/myproject/output")\nMARKDOWN_PATH = OUTPUT_DIR / "markdown.md"\nIMAGES_DIR = OUTPUT_DIR / "images"\nLOG_PATH = OUTPUT_DIR / "output.log"\n\n\ndef main():\n    OUTPUT_DIR.mkdir(parents=True, exist_ok=True)\n    IMAGES_DIR.mkdir(parents=True, exist_ok=True)\n\n    client = LlamaCloud()\n\n    # 1. Upload the PDF as a parse source file\n    with open(INPUT_PDF, "rb") as f:\n        uploaded = client.files.create(file=f, purpose="parse")\n    print(f"Uploaded file id: {uploaded.id}", flush=True)\n\n    # 2. Submit a parse job with screenshots and markdown, polling until done.\n    result = client.parsing.parse(\n        tier="agentic",\n        version="latest",\n        file_id=uploaded.id,\n        expand=["markdown", "images_content_metadata"],\n        output_options={"images_to_save": ["screenshot"]},\n    )\n\n    print(f"Parse job id: {result.job.id}", flush=True)\n    print(f"Parse job status: {result.job.status}", flush=True)\n\n    # 3. Save the markdown text (concatenate per-page markdown).\n    md_pages = []\n    if result.markdown is not None:\n        for page in result.markdown.pages:\n            if getattr(page, "success", False):\n                md_pages.append(page.markdown)\n            else:\n                print(f"  markdown page {getattr(page, \'page_number\', \'?\')} failed: {getattr(page, \'error\', \'\')}", flush=True)\n    markdown_text = "\\n\\n".join(md_pages)\n    MARKDOWN_PATH.write_text(markdown_text, encoding="utf-8")\n\n    # 4. Save the per-page screenshots. Match image metadata page by page.\n    page_screenshots = []\n    if result.images_content_metadata is not None:\n        for img in result.images_content_metadata.images:\n            if getattr(img, "category", None) == "screenshot":\n                page_screenshots.append(img)\n\n    # Sort screenshots by page number inferred from bbox/filename.\n    # The filename is typically something like \'image_0.png\', but we need to know\n    # the page number. The ImagesContentMetadataImage doesn\'t directly carry a\n    # page number; it carries a bbox. However, LlamaParse typically produces\n    # screenshots in document order with filenames \'image_<n>.png\'. We rely on\n    # the order they come back, which should be page order for screenshots.\n    page_screenshots.sort(key=lambda img: img.index)\n\n    image_count = 0\n    with httpx.Client(timeout=60.0) as http:\n        for page_idx, img in enumerate(page_screenshots, start=1):\n            if not img.presigned_url:\n                print(f"  No presigned_url for {img.filename}", flush=True)\n                continue\n            resp = http.get(img.presigned_url)\n            resp.raise_for_status()\n            out_path = IMAGES_DIR / f"page_{page_idx}.png"\n            out_path.write_bytes(resp.content)\n            image_count += 1\n            print(f"  Wrote {out_path} ({len(resp.content)} bytes)", flush=True)\n\n    # 5. Write the log file.\n    md_chars = len(markdown_text)\n    log_lines = [\n        f"Parse job ID: {result.job.id}",\n        f"Markdown chars: {md_chars}",\n        f"Image count: {image_count}",\n    ]\n    LOG_PATH.write_text("\\n".join(log_lines) + "\\n", encoding="utf-8")\n    print(f"Wrote log to {LOG_PATH}", flush=True)\n    print("DONE", flush=True)\n\n\nif __name__ == "__main__":\n    try:\n        main()\n    except Exception as e:\n        print(f"ERROR: {e}", file=sys.stderr, flush=True)\n        raise\nPYEOF\n'] min_timeout_sec: 0.1 max_timeout_sec: 180.0
