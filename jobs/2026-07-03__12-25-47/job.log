Sending keys: ["cat > src/main.ts << 'EOF'\nimport { Preferences } from '@capacitor/preferences';\n\nasync function refreshList(): Promise<void> {\n  const list = document.getElementById('kv-list');\n  if (!list) return;\n  // Clear existing children\n  while (list.firstChild) {\n    list.removeChild(list.firstChild);\n  }\n\n  const { keys } = await Preferences.keys();\n  for (const key of keys) {\n    const { value } = await Preferences.get({ key });\n    const li = document.createElement('li');\n    li.setAttribute('data-key', key);\n    li.textContent = `${key}=${value ?? ''}`;\n    list.appendChild(li);\n  }\n}\n\nfunction getInput(id: string): HTMLInputElement | null {\n  return document.getElementById(id) as HTMLInputElement | null;\n}\n\nasync function handleSet(): Promise<void> {\n  const keyInput = getInput('kv-key');\n  const valueInput = getInput('kv-value');\n  if (!keyInput || !valueInput) return;\n  const key = keyInput.value;\n  const value = valueInput.value;\n  if (!key) return;\n  await Preferences.set({ key, value });\n  await refreshList();\n}\n\nasync function handleRemove(): Promise<void> {\n  const keyInput = getInput('kv-key');\n  if (!keyInput) return;\n  const key = keyInput.value;\n  if (!key) return;\n  await Preferences.remove({ key });\n  await refreshList();\n}\n\nasync function handleClear(): Promise<void> {\n  await Preferences.clear();\n  await refreshList();\n}\n\nfunction setup(): void {\n  const setBtn = document.getElementById('kv-set-btn');\n  const removeBtn = document.getElementById('kv-remove-btn');\n  const clearBtn = document.getElementById('kv-clear-btn');\n\n  setBtn?.addEventListener('click', () => {\n    void handleSet();\n  });\n  removeBtn?.addEventListener('click', () => {\n    void handleRemove();\n  });\n  clearBtn?.addEventListener('click', () => {\n    void handleClear();\n  });\n\n  void refreshList();\n}\n\nif (document.readyState === 'loading') {\n  document.addEventListener('DOMContentLoaded', setup);\n} else {\n  setup();\n}\nEOF\n"] min_timeout_sec: 0.1 max_timeout_sec: 180.0
