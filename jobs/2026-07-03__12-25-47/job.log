Sending keys: ['cat > /home/user/myproject/fetch_users.py << \'EOF\'\nimport json\nimport os\nfrom apideck_unify import Apideck\nfrom apideck_unify.types import UNSET\n\n\ndef to_value(field):\n    """Convert UNSET or None to None, empty strings to None, otherwise return string."""\n    if field is None or field is UNSET:\n        return None\n    s = str(field)\n    if s == "" or s.strip() == "":\n        return None\n    return s\n\n\ndef main():\n    api_key = os.environ.get("APIDECK_API_KEY")\n    app_id = os.environ.get("APIDECK_APP_ID")\n    consumer_id = os.environ.get("APIDECK_CONSUMER_ID")\n    collection_id = os.environ.get("APIDECK_ISSUE_TRACKING_COLLECTION_ID")\n\n    apideck = Apideck(\n        api_key=api_key,\n        app_id=app_id,\n        consumer_id=consumer_id,\n    )\n\n    all_users = []\n    page = apideck.issue_tracking.collection_users.list(\n        collection_id=collection_id,\n        service_id="github",\n        limit=200,\n    )\n\n    while page is not None:\n        response_data = page.get_collection_users_response\n        if response_data is not None and response_data.data is not None:\n            for user in response_data.data:\n                all_users.append(\n                    {\n                        "id": to_value(user.id),\n                        "name": to_value(user.name),\n                        "first_name": to_value(user.first_name),\n                        "last_name": to_value(user.last_name),\n                        "email": to_value(user.email),\n                    }\n                )\n        page = page.next()\n\n    output = {\n        "collection_id": collection_id,\n        "service_id": "github",\n        "users": all_users,\n    }\n\n    with open("/home/user/myproject/users.json", "w") as f:\n        json.dump(output, f, indent=2)\n\n    with open("/home/user/myproject/output.log", "w") as f:\n        f.write(f"User count: {len(all_users)}\\n")\n\n    print(f"Collected {len(all_users)} users")\n\n\nif __name__ == "__main__":\n    main()\nEOF\n'] min_timeout_sec: 0.1 max_timeout_sec: 180.0
