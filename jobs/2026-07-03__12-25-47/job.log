Sending keys: ['cat > run.py << \'PYEOF\'\nimport json\nfrom datetime import datetime, timedelta\nfrom pathlib import Path\nfrom typing import Any, Dict, Iterable, Tuple\n\nfrom bytewax import operators as op\nfrom bytewax.connectors.files import FileSink, FileSource\nfrom bytewax.dataflow import Dataflow\nfrom bytewax.operators import StatefulLogic\nfrom bytewax.testing import run_main\n\nWINDOW = timedelta(seconds=10)\n\n\ndef parse_ts(s) -> datetime:\n    # Accept either an ISO 8601 string or a datetime object.\n    if isinstance(s, datetime):\n        return s\n    if s.endswith("Z"):\n        s = s[:-1] + "+00:00"\n    return datetime.fromisoformat(s)\n\n\nclass DedupLogic(StatefulLogic[Dict[str, Any], Dict[str, Any], Dict[str, datetime]]):\n    """Per-user_id event-id deduplication over a sliding 10s window."""\n\n    RETAIN: bool = StatefulLogic.RETAIN\n\n    def __init__(self, resume_state):\n        # state maps event_id -> last emitted timestamp (datetime)\n        self._state: Dict[str, datetime] = dict(resume_state) if resume_state else {}\n\n    def on_item(\n        self, value: Dict[str, Any]\n    ) -> Tuple[Iterable[Dict[str, Any]], bool]:\n        event_id = value["event_id"]\n        ts = parse_ts(value["timestamp"])\n\n        # Clean up: drop entries older than the window relative to the\n        # current event\'s timestamp.\n        stale = [\n            eid for eid, last_ts in self._state.items()\n            if ts - last_ts > WINDOW\n        ]\n        for eid in stale:\n            del self._state[eid]\n\n        # Deduplication: if the same event_id was seen within last 10s\n        # (inclusive of exactly 10s), drop the new event.\n        prev_ts = self._state.get(event_id)\n        if prev_ts is not None and ts <= prev_ts + WINDOW:\n            return (iter(()), StatefulLogic.RETAIN)\n\n        # Otherwise emit, and (re)start the 10s window for this event_id.\n        self._state[event_id] = ts\n        return (iter((value,)), StatefulLogic.RETAIN)\n\n    def snapshot(self) -> Dict[str, datetime]:\n        # State must be effectively immutable on return.\n        return dict(self._state)\n\n\ndef build_logic(resume_state):\n    return DedupLogic(resume_state)\n\n\ndef build_flow(input_path: Path, output_path: Path) -> Dataflow:\n    flow = Dataflow("stateful_dedup")\n\n    # Read raw lines from the input file.\n    lines = op.input("input", flow, FileSource(str(input_path)))\n\n    # Parse JSON -> dict. Timestamps stay as strings until on_item parses\n    # them (this avoids any state issues with mutating the dict between\n    # the map and on_item).\n    parsed = op.map("parse_json", lines, lambda line: json.loads(line))\n\n    # Key the stream by user_id so state is maintained per user.\n    keyed = op.key_on("key_user", parsed, lambda event: event["user_id"])\n\n    # Apply stateful dedup.\n    deduped = op.stateful("dedup", keyed, build_logic)\n\n    # Drop the user_id key (unkey) so we can serialize to a flat JSON line.\n    unkeyed = op.key_rm("unkey", deduped)\n\n    # Restore timestamps to ISO 8601 strings and serialize back to JSON.\n    def _format(event):\n        out = dict(event)\n        ts = out["timestamp"]\n        if isinstance(ts, datetime):\n            if ts.tzinfo is not None:\n                ts = ts.astimezone(tz=ts.tzinfo).replace(microsecond=0)\n                out["timestamp"] = ts.isoformat().replace("+00:00", "Z")\n            else:\n                out["timestamp"] = ts.isoformat()\n        return json.dumps(out)\n\n    out_lines = op.map("to_json", unkeyed, _format)\n\n    # Write lines out.\n    op.output("output", out_lines, FileSink(str(output_path)))\n\n    return flow\n\n\nif __name__ == "__main__":\n    run_main(build_flow(Path("input.jsonl"), Path("output.jsonl")))\nPYEOF\n'] min_timeout_sec: 0.5 max_timeout_sec: 180.0
