get, "rotation", PI / 2.0, 1.0).set_trans(Tween.TRANS_QUAD).set_ease(Tween.EASE_OUT)\n\t# At t=3.0, emit step_c_complete\n\ttween.tween_callback(func() -> void:\n\t\tif not _signal_c:\n\t\t\t_signal_c = true\n\t\t\tstep_c_complete.emit()\n\t)\n\n\t# --- Step 4: parallel block (3.0s -> 3.5s), modulate to (0.5, 1.0, 1.0, 1.0) ---\n\t# At t=3.0, modulate is (1, 1, 0.5, 1).\n\t# Need to reach (0.5, 1.0, 1.0, 1.0) at t=3.5, with TRANS_CUBIC / EASE_IN, 0.5s\n\ttween.tween_property(_target, "modulate", Color(0.5, 1.0, 1.0, 1.0), 0.5).set_trans(Tween.TRANS_CUBIC).set_ease(Tween.EASE_IN)\n\t# At t=3.5, emit animation_complete and mark not running\n\ttween.tween_callback(func() -> void:\n\t\tif not _signal_done:\n\t\t\t_signal_done = true\n\t\t\t_running = false\n\t\t\tanimation_complete.emit()\n\t)\n\n\treturn tween\nEOF\n'] min_timeout_sec: 0.2 max_timeout_sec: 180.0
