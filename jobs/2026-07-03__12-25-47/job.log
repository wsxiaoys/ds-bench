_value = await page.evaluate("window.localStorage.getItem(\'CapacitorStorage.photo_index\')")\n        print(f"localStorage photo_index: {ls_value!r}")\n        assert ls_value is not None, "photo_index not in localStorage"\n        parsed = json.loads(ls_value)\n        print(f"Parsed: {parsed}")\n        assert isinstance(parsed, list)\n        assert len(parsed) == 2\n        assert all(p.startswith(\'photos/\') and p.endswith(\'.jpeg\') for p in parsed)\n        # Verify order matches insertion order\n        assert parsed == photos, f"Order mismatch: {parsed} != {photos}"\n        \n        first = photos[0]\n        await page.evaluate(f"window.gallery.deletePhoto({first!r})")\n        photos_after = await page.evaluate("window.gallery.listPhotos()")\n        print(f"Photos after deleting first: {photos_after}")\n        assert len(photos_after) == 1\n        \n        # Verify localStorage is also updated\n        ls_value2 = await page.evaluate("window.localStorage.getItem(\'CapacitorStorage.photo_index\')")\n        parsed2 = json.loads(ls_value2)\n        print(f"After delete, localStorage: {parsed2}")\n        assert len(parsed2) == 1\n        assert first not in parsed2\n        \n        # Try to delete non-existent path - should still work without throwing\n        try:\n            await page.evaluate("window.gallery.deletePhoto(\'photos/does-not-exist.jpeg\')")\n            photos_after3 = await page.evaluate("window.gallery.listPhotos()")\n            print(f"After deleting non-existent: {photos_after3}")\n            assert len(photos_after3) == 1, f"Expected 1, got {len(photos_after3)}"\n        except Exception as e:\n            print(f"ERROR: {e}")\n            raise\n        \n        await browser.close()\n        print("=== ALL ADVANCED TESTS PASSED ===")\n\nasyncio.run(main())\nEOF\npython3 /tmp/test_prefs.py\n'] min_timeout_sec: 30.0 max_timeout_sec: 180.0
