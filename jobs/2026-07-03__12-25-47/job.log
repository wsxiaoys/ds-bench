Sending keys: ['cat > /tmp/run_debug2.py << \'EOF\'\nimport sys\nsys.path.insert(0, \'/home/user/bytewax_project\')\nimport leaderboard\nimport json\nimport heapq\n\n# Monkey-patch topk_step to add prints\noriginal_build = leaderboard.build_dataflow\n\nimport bytewax.operators as op\nfrom bytewax.dataflow import Dataflow\n\ndef build_with_debug(input_path, k):\n    flow = Dataflow("leaderboard")\n    raw = op.input("in", flow, leaderboard.JSONLSource(input_path))\n    parsed = op.map("parse", raw, lambda line: json.loads(line))\n    keyed = op.key_on("by_player", parsed, lambda ev: ev["player_id"])\n    def max_score(state, ev):\n        score = ev[\'score\']\n        if state is None or score > state:\n            new_state = score\n        else:\n            new_state = state\n        print(f\'max_score: key={ev["player_id"]}, score={score}, new_state={new_state}, return value=({new_state}, ({ev["player_id"]}, {new_state}))\')\n        return (new_state, (ev[\'player_id\'], new_state))\n    player_max = op.stateful_map("player_max", keyed, max_score)\n    routed = op.key_on("to_global", player_max, lambda _x: "GLOBAL")\n    def topk_step(state, item):\n        print(f\'topk_step: received item={item!r}, type={type(item).__name__}\')\n        player_id, score = item\n        heap = state\n        if heap is None:\n            heap = []\n        current = {pid: sc for sc, pid in heap}\n        if player_id in current:\n            if score > current[player_id]:\n                heap = [(s, p) for (s, p) in heap if p != player_id]\n                heapq.heapify(heap)\n            else:\n                return (heap, leaderboard._heap_to_sorted_list(heap))\n        if len(heap) < k:\n            heapq.heappush(heap, (score, player_id))\n        else:\n            if score > heap[0][0]:\n                heapq.heapreplace(heap, (score, player_id))\n        result = (heap, leaderboard._heap_to_sorted_list(heap))\n        print(f\'topk_step: returning value={result[1]!r}\')\n        return result\n    topk_stream = op.stateful_map("topk", routed, topk_step)\n    values = op.map_value("extract", topk_stream, lambda v: v)\n    op.output("out", values, leaderboard.CollectSink())\n    return flow\n\nleaderboard.build_dataflow = build_with_debug\nflow = build_with_debug(\'/tmp/test_input.jsonl\', 3)\nfrom bytewax.testing import run_main\nrun_main(flow)\nEOF\npython3 /tmp/run_debug2.py 2>&1 | head -40\n'] min_timeout_sec: 10.0 max_timeout_sec: 180.0
