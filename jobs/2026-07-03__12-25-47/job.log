e\nkeep_alive_seconds = 310\nprint(f"Keeping sandbox alive for {keep_alive_seconds} seconds...")\ntime.sleep(keep_alive_seconds)\n\nprint("Done!")\nPYEOF\n'] min_timeout_sec: 0.2 max_timeout_sec: 180.0
