> {submittedData.password}\n          </p>\n        </div>\n        <pre id="success-data" style={{ display: \'none\' }}>\n          {JSON.stringify(submittedData)}\n        </pre>\n      </div>\n    )\n  }\n\n  return (\n    <div className="app">\n      <h1>Multi-step Registration Form</h1>\n      <p>Step {step} of 2</p>\n      <form\n        onSubmit={(e) => {\n          e.preventDefault()\n          e.stopPropagation()\n          form.handleSubmit()\n        }}\n      >\n        {step === 1 && (\n          <div data-testid="step-1">\n            <h2>User Info</h2>\n            <form.Field\n              name="firstName"\n              validators={{\n                onChange: z.string().min(2, \'First name must be at least 2 characters\'),\n              }}\n            >\n              {(field) => (\n                <div className="field">\n                  <label htmlFor={field.name}>First Name</label>\n                  <input\n                    id={field.name}\n                    name={field.name}\n                    type="text"\n                    value={field.state.value}\n                    onBlur={field.handleBlur}\n                    onChange={(e) => field.handleChange(e.target.value)}\n                  />\n                  {field.state.meta.errors.length > 0 && (\n                    <div className="error" data-testid={`${field.name}-error`}>\n                      {field.state.meta.errors[0]?.toString()}\n                    </div>\n                  )}\n                </div>\n              )}\n            </form.Field>\n            <form.Field\n              name="lastName"\n              validators={{\n                onChange: z.string().min(2, \'Last name must be at least 2 characters\'),\n              }}\n            >\n              {(field) => (\n                <div className="field">\n                  <label htmlFor={field.name}>Last Name</label>\n                  <input\n                    id={field.name}\n                    name={field.name}\n                    type="text"\n                    value={field.state.value}\n                    onBlur={field.handleBlur}\n                    onChange={(e) => field.handleChange(e.target.value)}\n                  />\n                  {field.state.meta.errors.length > 0 && (\n                    <div className="error" data-testid={`${field.name}-error`}>\n                      {field.state.meta.errors[0]?.toString()}\n                    </div>\n                  )}\n                </div>\n              )}\n            </form.Field>\n            <div className="actions">\n              <button type="button" onClick={handleNext} data-testid="next-button">\n                Next\n              </button>\n            </div>\n          </div>\n        )}\n\n        {step === 2 && (\n          <div data-testid="step-2">\n            <h2>Account Info</h2>\n            <form.Field\n              name="email"\n              validators={{\n                onChange: z.string().email(\'Invalid email address\'),\n              }}\n            >\n              {(field) => (\n                <div className="field">\n                  <label htmlFor={field.name}>Email</label>\n                  <input\n                    id={field.name}\n                    name={field.name}\n                    type="email"\n                    value={field.state.value}\n                    onBlur={field.handleBlur}\n                    onChange={(e) => field.handleChange(e.target.value)}\n                  />\n                  {field.state.meta.errors.length > 0 && (\n                    <div className="error" data-testid={`${field.name}-error`}>\n                      {field.state.meta.errors[0]?.toString()}\n                    </div>\n                  )}\n                </div>\n              )}\n            </form.Field>\n            <form.Field\n              name="password"\n              validators={{\n                onChange: z.string().min(6, \'Password must be at least 6 characters\'),\n              }}\n            >\n              {(field) => (\n                <div className="field">\n                  <label htmlFor={field.name}>Password</label>\n                  <input\n                    id={field.name}\n                    name={field.name}\n                    type="password"\n                    value={field.state.value}\n                    onBlur={field.handleBlur}\n                    onChange={(e) => field.handleChange(e.target.value)}\n                  />\n                  {field.state.meta.errors.length > 0 && (\n                    <div className="error" data-testid={`${field.name}-error`}>\n                      {field.state.meta.errors[0]?.toString()}\n                    </div>\n                  )}\n                </div>\n              )}\n            </form.Field>\n            <div className="actions">\n              <button type="button" onClick={handleBack} data-testid="back-button">\n                Back\n              </button>\n              <button type="submit" data-testid="submit-button">\n                Submit\n              </button>\n            </div>\n          </div>\n        )}\n      </form>\n    </div>\n  )\n}\n\nexport default App\nAPPEOF\n'] min_timeout_sec: 0.2 max_timeout_sec: 180.0
