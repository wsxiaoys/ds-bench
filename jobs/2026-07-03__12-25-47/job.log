Sending keys: ['cat > /home/user/bytewax_batching/dataflow.py << \'PYEOF\'\nimport json\nimport os\nimport sqlite3\nfrom datetime import timedelta\n\nfrom bytewax.connectors.files import FileSource\nfrom bytewax.dataflow import Dataflow\nfrom bytewax.operators import DynamicSink, StatelessSinkPartition\nfrom bytewax.testing import run_main\nimport bytewax.operators as op\n\n\n# Read run-id\nRUN_ID_FILE = "/logs/artifacts/run-id"\nwith open(RUN_ID_FILE, "r") as f:\n    RUN_ID = f.read().strip()\n\nDB_PATH = f"/home/user/bytewax_batching/metrics-{RUN_ID}.db"\nINPUT_PATH = "/home/user/bytewax_batching/input.jsonl"\nOUTPUT_LOG = "/home/user/bytewax_batching/output.log"\n\n\ndef ensure_table():\n    """Create the SQLite database and the device_metrics table if it doesn\'t exist."""\n    conn = sqlite3.connect(DB_PATH)\n    try:\n        conn.execute(\n            """\n            CREATE TABLE IF NOT EXISTS device_metrics (\n                device_id TEXT,\n                timestamp TEXT,\n                metric_value REAL\n            )\n            """\n        )\n        conn.commit()\n    finally:\n        conn.close()\n\n\nclass SQLiteSink(DynamicSink):\n    """Custom Bytewax Sink that bulk-inserts batches into SQLite using executemany."""\n\n    def build(self, step_id, worker_index, worker_count):\n        return _SQLiteSinkPartition()\n\n\nclass _SQLiteSinkPartition(StatelessSinkPartition):\n    def __init__(self):\n        self._conn = sqlite3.connect(DB_PATH)\n\n    def write_batch(self, items):\n        # `items` is a list of items reaching this output. Each item is a\n        # (key, [record, record, ...]) tuple produced by op.collect.\n        rows = []\n        for _key, batch in items:\n            for record in batch:\n                rows.append(\n                    (\n                        record["device_id"],\n                        record["timestamp"],\n                        record["metric_value"],\n                    )\n                )\n        if rows:\n            self._conn.executemany(\n                "INSERT INTO device_metrics (device_id, timestamp, metric_value) "\n                "VALUES (?, ?, ?)",\n                rows,\n            )\n            self._conn.commit()\n\n    def close(self):\n        try:\n            self._conn.commit()\n        finally:\n            self._conn.close()\n\n\ndef parse_line(line: str):\n    """Parse a single JSONL line into a metric dict."""\n    line = line.strip()\n    if not line:\n        return None\n    return json.loads(line)\n\n\ndef build_flow():\n    # Ensure the SQLite table exists before the dataflow starts writing.\n    ensure_table()\n\n    flow = Dataflow("device_metrics_batching")\n\n    # Read device metrics from the JSONL file.\n    source = FileSource(INPUT_PATH)\n    metrics = op.input("metrics_in", flow, source)\n\n    # Parse the JSON string into a dict.\n    parsed = op.map("parse", metrics, parse_line)\n\n    # Filter out any metrics where metric_value is less than 0.\n    filtered = op.filter(\n        "non_negative",\n        parsed,\n        lambda r: r is not None and r["metric_value"] >= 0,\n    )\n\n    # Group the metrics by device_id.\n    keyed = op.key_on("by_device", filtered, lambda r: r["device_id"])\n\n    # Batch the metrics for each device using max batch size of 10 and\n    # a timeout of 1 second.\n    batched = op.collect(\n        "batch",\n        keyed,\n        timeout=timedelta(seconds=1),\n        max_size=10,\n    )\n\n    # Write batched metrics to SQLite using a custom DynamicSink.\n    op.output("sqlite_sink", batched, SQLiteSink())\n\n    return flow\n\n\ndef main():\n    flow = build_flow()\n    # Run the dataflow to completion.\n    run_main(flow)\n    # After the dataflow completes successfully, write the log message.\n    with open(OUTPUT_LOG, "w") as f:\n        f.write("Pipeline finished.\\n")\n\n\nif __name__ == "__main__":\n    main()\nPYEOF\n'] min_timeout_sec: 0.2 max_timeout_sec: 180.0
