Sending keys: ['cat > /home/user/myproject/solution.py << \'PYEOF\'\nimport os\nimport nltk\n\n# Ensure WordNet corpora are present\nfor pkg in (\'wordnet\', \'omw-1.4\'):\n    try:\n        nltk.data.find(f\'corpora/{pkg}\')\n    except LookupError:\n        nltk.download(pkg, quiet=True)\n\nfrom nltk.corpus import wordnet as wn  # noqa: E402\n\nimport lancedb  # noqa: E402\nfrom lancedb.query import MatchQuery, BooleanQuery, Occur  # noqa: E402\n\n_TABLE = None\n_IDX_BUILT = False\n\n\ndef _get_table():\n    global _TABLE\n    if _TABLE is None:\n        db = lancedb.connect(os.environ[\'LANCEDB_URI\'])\n        _TABLE = db.open_table(os.environ[\'LANCEDB_TABLE\'])\n    return _TABLE\n\n\ndef _ensure_fts_index():\n    global _IDX_BUILT\n    if _IDX_BUILT:\n        return\n    table = _get_table()\n    # Check if an FTS index on \'content\' already exists\n    has_fts = False\n    try:\n        for idx in table.list_indices():\n            # idx columns dict and details vary between lancedb versions; just attempt create if not.\n            try:\n                cols = idx.columns if hasattr(idx, \'columns\') else None\n            except Exception:\n                cols = None\n            if cols is None:\n                continue\n            col_names = [c if isinstance(c, str) else getattr(c, \'name\', str(c)) for c in cols]\n            if any(name == \'content\' or name.endswith(\'content\') for name in col_names):\n                # Roughly check if it is an FTS index; if type info available\n                idx_type = getattr(idx, \'index_type\', None) or getattr(idx, \'type\', None)\n                if idx_type is None or \'FTS\' in str(idx_type).upper() or \'INVERTED\' in str(idx_type).upper():\n                    has_fts = True\n                    break\n    except Exception:\n        has_fts = False\n    if not has_fts:\n        try:\n            table.create_fts_index("content", use_tantivy=False, replace=False)\n        except Exception as e:\n            # If the index already exists in some form, ignore\n            if \'already exists\' not in str(e).lower() and \'duplicate\' not in str(e).lower():\n                raise\n    _IDX_BUILT = True\n\n\ndef _expand_token(token: str) -> list[str]:\n    """Return the token itself plus up to 3 single-word lowercase synonyms from WordNet."""\n    token = token.lower()\n    out = []\n    seen = {token}\n    # Use wn.synonyms which returns synonyms grouped by sense\n    try:\n        groups = wn.synonyms(token) or []\n    except Exception:\n        groups = []\n    if not groups:\n        # Fallback: walk synsets ourselves\n        groups = []\n        for syn in wn.synsets(token):\n            names = [n.replace(\'_\', \' \').replace(\'-\', \' \') for n in syn.lemma_names()]\n            groups.append(names)\n    for group in groups:\n        for lemma in group:\n            lemma = lemma.lower().strip()\n            if not lemma or lemma in seen:\n                continue\n            # Single token only (no \'_\' or whitespace)\n            if \'_\' in lemma or \' \' in lemma or \'\\t\' in lemma or \'\\n\' in lemma:\n                continue\n            seen.add(lemma)\n            out.append(lemma)\n            if len(out) >= 3:\n                break\n        if len(out) >= 3:\n            break\n    return [token] + out\n\n\ndef expanded_search(query: str, k: int = 10) -> list[int]:\n    tokens = query.lower().split()\n    expansion_tokens = []\n    for t in tokens:\n        expansion_tokens.extend(_expand_token(t))\n    # Deduplicate while preserving order\n    seen = set()\n    uniq = []\n    for t in expansion_tokens:\n        if t not in seen:\n            seen.add(t)\n            uniq.append(t)\n\n    table = _get_table()\n    _ensure_fts_index()\n\n    # Build a SHOULD/OR boolean query\n    if len(uniq) == 1:\n        search_q = MatchQuery(uniq[0], "content")\n    else:\n        clauses = [(Occur.SHOULD, MatchQuery(t, "content")) for t in uniq]\n        search_q = BooleanQuery(clauses)\n\n    results = table.search(search_q, query_type="fts").limit(k).to_list()\n    return [r[\'id\'] for r in results]\nPYEOF\necho \'---\' && cat /home/user/myproject/solution.py | head -20\n'] min_timeout_sec: 0.3 max_timeout_sec: 180.0
