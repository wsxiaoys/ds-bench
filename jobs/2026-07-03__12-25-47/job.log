Sending keys: ["cat > /home/user/solve.py << 'PYEOF'\nimport numpy as np\nimport librosa\nimport json\n\n# Load audio\ny, sr = librosa.load('/home/user/input.wav', sr=None)\nprint(f'Audio length: {len(y)} samples, sr={sr}')\n\n# Common parameters\nhop_length = 512  # 2^9, divisible by 64 (2^6) for n_octaves=7\nn_fft = 2048\n\n# STFT\nS = np.abs(librosa.stft(y, n_fft=n_fft, hop_length=hop_length))\nstft_db = librosa.amplitude_to_db(S, ref=np.max)\nprint(f'STFT shape: {stft_db.shape}')\n\n# CQT - default n_octaves = ceil(n_bins/bins_per_octave) = 7 with n_bins=84\ncqt_n_bins = 84  # 7 octaves * 12 bins/octave\nbins_per_octave_cqt = 12\nC = np.abs(librosa.cqt(\n    y,\n    sr=sr,\n    hop_length=hop_length,\n    n_bins=cqt_n_bins,\n    bins_per_octave=bins_per_octave_cqt,\n))\ncqt_db = librosa.amplitude_to_db(C, ref=np.max)\nprint(f'CQT shape: {cqt_db.shape}')\n\n# VQT - similar, 84 bins, 12 per octave, default fmin=C1\nvqt_n_bins = 84\nbins_per_octave_vqt = 12\nV = np.abs(librosa.vqt(\n    y,\n    sr=sr,\n    hop_length=hop_length,\n    n_bins=vqt_n_bins,\n    bins_per_octave=bins_per_octave_vqt,\n    intervals='equal',\n))\nvqt_db = librosa.amplitude_to_db(V, ref=np.max)\nprint(f'VQT shape: {vqt_db.shape}')\n\n# Verify same time grid\nassert stft_db.shape[1] == cqt_db.shape[1] == vqt_db.shape[1], f'Frame mismatch: {stft_db.shape[1]}, {cqt_db.shape[1]}, {vqt_db.shape[1]}'\nprint(f'All have {stft_db.shape[1]} frames - OK')\n\n# Save npz\nnp.savez('/home/user/spec_stack.npz', stft_db=stft_db, cqt_db=cqt_db, vqt_db=vqt_db)\nprint('Saved spec_stack.npz')\n\n# Build metadata\nn_frames = stft_db.shape[1]\nstft_freqs = librosa.fft_frequencies(sr=sr, n_fft=n_fft)\ncqt_freqs = librosa.cqt_frequencies(\n    n_bins=cqt_n_bins,\n    fmin=librosa.note_to_hz('C1'),\n    bins_per_octave=bins_per_octave_cqt,\n)\nvqt_freqs = librosa.interval_frequencies(\n    n_bins=vqt_n_bins,\n    fmin=librosa.note_to_hz('C1'),\n    intervals='equal',\n    bins_per_octave=bins_per_octave_vqt,\n)\n\nprint(f'stft_freqs: {len(stft_freqs)} entries, first={stft_freqs[0]}, last={stft_freqs[-1]}')\nprint(f'cqt_freqs: {len(cqt_freqs)} entries, first={cqt_freqs[0]}, last={cqt_freqs[-1]}')\nprint(f'vqt_freqs: {len(vqt_freqs)} entries, first={vqt_freqs[0]}, last={vqt_freqs[-1]}')\n\nmeta = {\n    'n_frames': int(n_frames),\n    'hop_length': int(hop_length),\n    'sample_rate': int(sr),\n    'stft_freqs': stft_freqs.tolist(),\n    'cqt_freqs': cqt_freqs.tolist(),\n    'vqt_freqs': vqt_freqs.tolist(),\n    'n_fft': int(n_fft),\n    'cqt_n_bins': int(cqt_n_bins),\n    'cqt_bins_per_octave': int(bins_per_octave_cqt),\n    'vqt_n_bins': int(vqt_n_bins),\n    'vqt_bins_per_octave': int(bins_per_octave_vqt),\n}\n\nwith open('/home/user/spec_meta.json', 'w') as f:\n    json.dump(meta, f)\nprint('Saved spec_meta.json')\nprint(f'Keys: {sorted(meta.keys())}')\nPYEOF\n"] min_timeout_sec: 0.1 max_timeout_sec: 180.0
