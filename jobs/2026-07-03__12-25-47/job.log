Sending keys: ['cat > /home/user/myapp/android/app/src/main/java/com/example/myapp/DeviceSensorPlugin.java << \'EOF\'\npackage com.example.myapp;\n\nimport com.getcapacitor.JSObject;\nimport com.getcapacitor.Plugin;\nimport com.getcapacitor.PluginCall;\nimport com.getcapacitor.PluginMethod;\nimport com.getcapacitor.annotation.CapacitorPlugin;\n\n@CapacitorPlugin(name = "DeviceSensor")\npublic class DeviceSensorPlugin extends Plugin {\n\n    @PluginMethod\n    public void getReading(PluginCall call) {\n        String sensor = call.getString("sensor");\n        if (sensor == null) {\n            call.reject("Missing \'sensor\' option");\n            return;\n        }\n\n        JSObject ret = new JSObject();\n        switch (sensor) {\n            case "temperature":\n                ret.put("sensor", "temperature");\n                ret.put("value", 22.5);\n                ret.put("unit", "C");\n                call.resolve(ret);\n                break;\n            case "humidity":\n                ret.put("sensor", "humidity");\n                ret.put("value", 65.0);\n                ret.put("unit", "%");\n                call.resolve(ret);\n                break;\n            case "battery":\n                ret.put("sensor", "battery");\n                ret.put("value", 87.0);\n                ret.put("unit", "%");\n                call.resolve(ret);\n                break;\n            default:\n                call.reject("Unsupported sensor: " + sensor);\n                break;\n        }\n    }\n\n    @PluginMethod\n    public void isAvailable(PluginCall call) {\n        String sensor = call.getString("sensor");\n        JSObject ret = new JSObject();\n        if (sensor == null) {\n            ret.put("available", false);\n            call.resolve(ret);\n            return;\n        }\n\n        switch (sensor) {\n            case "temperature":\n            case "humidity":\n            case "battery":\n                ret.put("available", true);\n                break;\n            default:\n                ret.put("available", false);\n                break;\n        }\n        call.resolve(ret);\n    }\n}\nEOF\n'] min_timeout_sec: 0.1 max_timeout_sec: 180.0
