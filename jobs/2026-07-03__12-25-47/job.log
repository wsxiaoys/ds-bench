Sending keys: ['cat > /home/user/gdx-interp/src/main/java/com/example/interp/Main.java <<\'JAVAEOF\'\npackage com.example.interp;\n\nimport com.badlogic.gdx.ApplicationAdapter;\nimport com.badlogic.gdx.Gdx;\nimport com.badlogic.gdx.backends.headless.HeadlessApplication;\nimport com.badlogic.gdx.backends.headless.HeadlessApplicationConfiguration;\nimport com.badlogic.gdx.files.FileHandle;\nimport com.badlogic.gdx.math.Interpolation;\n\nimport java.io.FileOutputStream;\nimport java.io.IOException;\nimport java.io.OutputStreamWriter;\nimport java.io.Reader;\nimport java.io.Writer;\nimport java.lang.reflect.Field;\nimport java.nio.charset.StandardCharsets;\nimport java.util.Locale;\nimport java.util.Properties;\n\npublic class Main {\n\n    public static void main(String[] args) throws Exception {\n        if (args.length != 2) {\n            System.err.println("Usage: <config-path> <output-path>");\n            System.exit(1);\n        }\n        String configPath = args[0];\n        String outputPath = args[1];\n\n        HeadlessApplicationConfiguration config = new HeadlessApplicationConfiguration();\n        config.updatesPerSecond = 0;\n\n        InterpListener listener = new InterpListener(configPath, outputPath);\n        HeadlessApplication app = new HeadlessApplication(listener, config);\n\n        // Join the main loop thread so the JVM exits cleanly.\n        Field f = HeadlessApplication.class.getDeclaredField("mainLoopThread");\n        f.setAccessible(true);\n        Thread t = (Thread) f.get(app);\n        t.join();\n\n        if (listener.failed) {\n            System.exit(1);\n        }\n    }\n\n    static class InterpListener extends ApplicationAdapter {\n        private final String configPath;\n        private final String outputPath;\n\n        private Interpolation interp;\n        private float start;\n        private float end;\n        private int samples;\n        private String curveName;\n\n        private int currentSample = 0;\n        private boolean initialized = false;\n        boolean failed = false;\n\n        private final StringBuilder sb = new StringBuilder();\n\n        InterpListener(String configPath, String outputPath) {\n            this.configPath = configPath;\n            this.outputPath = outputPath;\n        }\n\n        @Override\n        public void create() {\n            try {\n                FileHandle fh = Gdx.files.absolute(configPath);\n                Properties p = new Properties();\n                try (Reader r = fh.reader("UTF-8")) {\n                    p.load(r);\n                }\n\n                curveName = p.getProperty("curve");\n                if (curveName == null) {\n                    throw new IllegalArgumentException("Missing \'curve\' property");\n                }\n\n                Field curveField;\n                try {\n                    curveField = Interpolation.class.getField(curveName);\n                } catch (NoSuchFieldException e) {\n                    throw new IllegalArgumentException("Unknown curve: " + curveName);\n                }\n                Object val = curveField.get(null);\n                if (!(val instanceof Interpolation)) {\n                    throw new IllegalArgumentException("Field is not an Interpolation: " + curveName);\n                }\n                interp = (Interpolation) val;\n\n                String startStr = p.getProperty("start");\n                String endStr = p.getProperty("end");\n                String samplesStr = p.getProperty("samples");\n                if (startStr == null || endStr == null || samplesStr == null) {\n                    throw new IllegalArgumentException("Missing required property");\n                }\n                start = Float.parseFloat(startStr);\n                end = Float.parseFloat(endStr);\n                samples = Integer.parseInt(samplesStr);\n                if (samples < 2) {\n                    throw new IllegalArgumentException("samples must be >= 2");\n                }\n\n                initialized = true;\n            } catch (Exception e) {\n                System.err.println("Error: " + e.getMessage());\n                failed = true;\n                Gdx.app.exit();\n            }\n        }\n\n        @Override\n        public void render() {\n            if (!initialized || failed) {\n                Gdx.app.exit();\n                return;\n            }\n            if (currentSample >= samples) {\n                Gdx.app.exit();\n                return;\n            }\n\n            int i = currentSample;\n            float t;\n            if (i == samples - 1) {\n                t = 1.0f;\n            } else {\n                t = i / (float) (samples - 1);\n            }\n\n            float v = interp.apply(start, end, t);\n\n            if (currentSample == 0) {\n                sb.append("curve=").append(curveName).append(\'\\n\');\n                sb.append("samples=").append(samples).append(\'\\n\');\n            }\n            sb.append(String.format(Locale.ROOT, "%.6f", v)).append(\'\\n\');\n\n            currentSample++;\n            if (currentSample >= samples) {\n                Gdx.app.exit();\n            }\n        }\n\n        @Override\n        public void dispose() {\n            if (failed || sb.length() == 0) {\n                return;\n            }\n            try (Writer w = new OutputStreamWriter(\n                    new FileOutputStream(outputPath), StandardCharsets.UTF_8)) {\n                w.write(sb.toString());\n            } catch (IOException e) {\n                System.err.println("Failed to write output: " + e.getMessage());\n                failed = true;\n            }\n        }\n    }\n}\nJAVAEOF\n'] min_timeout_sec: 0.2 max_timeout_sec: 180.0
