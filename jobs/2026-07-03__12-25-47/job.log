Sending keys: ["cat > /tmp/segment.py << 'PYEOF'\nimport json\nimport numpy as np\nimport librosa\nimport librosa.feature\nimport librosa.beat\nimport librosa.segment\n\nHOP = 512\nSR = 22050\nN_SEG = 3\n\n# Load audio\ny, sr = librosa.load('/home/user/input.wav', sr=SR)\nduration = len(y) / float(sr)\n\n# Beat tracking\ntempo, beats = librosa.beat.beat_track(y=y, sr=sr, hop_length=HOP)\nbeats = np.asarray(beats)\nn_beats_total = len(beats)\nprint('duration:', duration, 'tempo:', tempo, 'beats:', n_beats_total)\n\n# Chroma CQT\nchroma = librosa.feature.chroma_cqt(y=y, sr=sr, hop_length=HOP)\n\n# Beat-synchronous chroma\nsync_chroma = librosa.util.sync(chroma, beats)\n\n# Coarse segmentation\n# Choose k so that each segment has at least 3 beats (so subsegment can give 3 sub-segments)\n# 44 beats / k=4 -> ~11 beats per segment, plenty\n# 44 beats / k=5 -> ~9 beats per segment\n# 44 beats / k=6 -> ~7 beats per segment\n# 44 beats / k=7 -> ~6 beats per segment\n# 44 beats / k=8 -> ~5 beats per segment\n# Try k=5 first\nk = 5\nbounds = librosa.segment.agglomerative(sync_chroma, k)\nbounds = np.asarray(bounds)\nprint('agglo bounds:', bounds, 'k=', k)\n\n# beats array indices -> frame mapping\n# Map each beat index to its frame\n# A coarse segment is bounds[i]..bounds[i+1] in beat indices\n# So start_frame = beats[bounds[i]], end_frame = beats[bounds[i+1]] (or end of track)\ntotal_frames = chroma.shape[1]\n\ncoarse_segments = []\nfor i in range(len(bounds)):\n    bi_start = int(bounds[i])\n    bi_end = int(bounds[i+1]) if i+1 < len(bounds) else (n_beats_total - 1)\n    # bi_end is the inclusive last beat of this segment; the segment is [beats[bi_start], beats[bi_end]]\n    # The next segment starts at beats[bi_end] (next coarse boundary index is bi_end)\n    # wait: if i+1 has bounds[i+1] = bi_end, then segment i goes from beats[bounds[i]] to beats[bounds[i+1]]\n    # but as a half-open interval we typically use [start, end). Let's use bi_end as index but the end_frame is beats[bi_end]\n    # and next segment starts at beats[bi_end] = same frame. So they share boundary.\n    start_frame = int(beats[bi_start])\n    if i + 1 < len(bounds):\n        end_frame = int(beats[bounds[i+1]])\n    else:\n        # Last segment: extend to end of audio\n        end_frame = total_frames\n    start_t = float(librosa.frames_to_time(np.array([start_frame]), sr=sr, hop_length=HOP)[0])\n    end_t = float(librosa.frames_to_time(np.array([end_frame]), sr=sr, hop_length=HOP)[0])\n    coarse_segments.append({'index': i, 'start_frame': start_frame, 'end_frame': end_frame, 'start': start_t, 'end': end_t})\n\n# Clamp last end to duration so coarse covers full track\ncoarse_segments[-1]['end'] = duration\n\nprint('coarse segments:', coarse_segments)\n\n# Subsegment each coarse segment using beat frames as boundaries\n# We need 3 sub-segments per coarse segment\nfine_segments = []\nfor c in coarse_segments:\n    # Use beat frames within the segment's frame range. Include both boundary beats.\n    # seg_beats: list of beat frame numbers inside [start_frame, end_frame]\n    seg_beats = beats[(beats >= c['start_frame']) & (beats <= c['end_frame'])]\n    if len(seg_beats) < 4:\n        # Not enough beats to sub-segment into 3 parts using beats\n        # Fall back to frame-level boundaries. Use start_frame, 1/3, 2/3, end_frame\n        sf = c['start_frame']\n        ef = c['end_frame']\n        thirds = [sf, sf + (ef - sf) // 3, sf + 2 * (ef - sf) // 3, ef]\n        seg_beats = np.array(sorted(set(thirds)), dtype=int)\n    sub_bounds = librosa.segment.subsegment(chroma, seg_beats, n_segments=N_SEG)\n    sub_bounds = np.asarray(sub_bounds)\n    # sub_bounds contains input seg_beats PLUS newly added interior boundaries\n    # Walk through each interval (between consecutive seg_beats) and extract N_SEG sub-segments\n    n_int = len(seg_beats) - 1\n    # Verify total length is approximately n_int * N_SEG + 1\n    # If subsegment fails for an interval (too few frames), interval becomes single-frame sub-segments\n    # In that case it still returns something consistent.\n    # Walk per interval\n    idx = 0\n    for interval_i in range(n_int):\n        # n_segments+1 boundaries for this interval\n        # but if there were fewer frames, may be different. Try to grab n_segments+1 boundaries\n        b_sub = sub_bounds[idx:idx+N_SEG+1].tolist()\n        if len(b_sub) < N_SEG + 1:\n            # truncate: we got fewer. Just take what's left\n            b_sub = sub_bounds[idx:].tolist()\n        idx += N_SEG\n        # Generate N_SEG sub-segments from these\n        # If we have b_sub with >= 2 elements we can make (len(b_sub)-1) sub-segments.\n        # We want exactly N_SEG. If len(b_sub) > N_SEG+1 we have a problem; but per design\n        # each interval yields exactly N_SEG+1 boundaries.\n        if len(b_sub) < 2:\n            continue\n        if len(b_sub) < N_SEG + 1:\n            # pad with end_frame\n            while len(b_sub) < N_SEG + 1:\n                b_sub.append(c['end_frame'])\n        if len(b_sub) > N_SEG + 1:\n            b_sub = b_sub[:N_SEG + 1]\n        for j in range(N_SEG):\n            sf = int(b_sub[j])\n            ef = int(b_sub[j+1])\n            # clamp to coarse range\n            if sf < c['start_frame']: sf = c['start_frame']\n            if ef > c['end_frame']: ef = c['end_frame']\n            if ef <= sf:\n                ef = sf + 1\n            start_t = float(librosa.frames_to_time(np.array([sf]), sr=sr, hop_length=HOP)[0])\n            end_t = float(librosa.frames_to_time(np.array([ef]), sr=sr, hop_length=HOP)[0])\n            fine_segments.append({'start_frame': sf, 'end_frame': ef, 'start': start_t, 'end': end_t, 'parent_index': c['index']})\n\n    # Ensure we have exactly N_SEG fine segments for this coarse. If not (e.g. too few frames),\n    # fall back to evenly split\n    children_now = [f for f in fine_segments if f['parent_index'] == c['index']]\n    if len(children_now) != N_SEG:\n        # Remove the ones we added for this coarse\n        fine_segments = [f for f in fine_segments if f['parent_index'] != c['index']]\n        # Even split\n        sf0 = c['start_frame']\n        ef0 = c['end_frame']\n        for j in range(N_SEG):\n            sf = sf0 + (ef0 - sf0) * j // N_SEG\n            ef = sf0 + (ef0 - sf0) * (j + 1) // N_SEG\n            start_t = float(librosa.frames_to_time(np.array([sf]), sr=sr, hop_length=HOP)[0])\n            end_t = float(librosa.frames_to_time(np.array([ef]), sr=sr, hop_length=HOP)[0])\n            fine_segments.append({'start_frame': sf, 'end_frame': ef, 'start': start_t, 'end': end_t, 'parent_index': c['index']})\n\n# Final cleanups: ensure parent coverage\nfor c in coarse_segments:\n    children = [f for f in fine_segments if f['parent_index'] == c['index']]\n    children.sort(key=lambda x: x['start_frame'])\n    # Force first start = coarse start, last end = coarse end\n    children[0]['start_frame'] = c['start_frame']\n    children[0]['start'] = c['start']\n    children[-1]['end_frame'] = c['end_frame']\n    children[-1]['end'] = c['end']\n    # Make adjacent children share boundary\n    for k in range(1, len(children)):\n        children[k]['start_frame'] = children[k-1]['end_frame']\n        children[k]['start'] = children[k-1]['end']\n    # Ensure each child has minimum duration\n    for k in range(len(children)):\n        if children[k]['end_frame'] - children[k]['start_frame'] < 2:\n            children[k]['end_frame'] = children[k]['start_frame'] + 2\n            children[k]['end'] = float(librosa.frames_to_time(np.array([children[k]['end_frame']]), sr=sr, hop_length=HOP)[0])\n            if k+1 < len(children):\n                children[k+1]['start_frame'] = children[k]['end_frame']\n                children[k+1]['start'] = children[k]['end']\n        # update in fine_segments\n        # (they are the same dicts, but we want consistency)\n\n# Build final json\ncoarse_out = [{'index': c['index'], 'start': round(c['start'], 6), 'end': round(c['end'], 6)} for c in coarse_segments]\nfine_sorted = sorted(fine_segments, key=lambda x: (x['parent_index'], x['start_frame']))\n# Re-sort globally by start time\nfine_sorted = sorted(fine_sorted, key=lambda x: x['start'])\nfine_out = []\nfor i, f in enumerate(fine_sorted):\n    fine_out.append({'index': i, 'start': round(f['start'], 6), 'end': round(f['end'], 6), 'parent_index': f['parent_index']})\n\nresult = {'coarse': coarse_out, 'fine': fine_out}\n\nwith open('/home/user/hierarchy.json', 'w') as f:\n    json.dump(result, f, indent=2)\n\nprint(json.dumps(result, indent=2))\nPYEOF\n"] min_timeout_sec: 0.2 max_timeout_sec: 180.0
