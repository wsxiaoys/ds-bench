nfig(ctx,\n\t\tconfig.WithRegion(cfg.Region),\n\t\tconfig.WithCredentialsProvider(credentials.NewStaticCredentialsProvider(cfg.AccessKey, cfg.SecretKey, "")),\n\t)\n\tif err != nil {\n\t\treturn nil, err\n\t}\n\n\treturn s3.NewFromConfig(awsCfg, func(o *s3.Options) {\n\t\to.BaseEndpoint = aws.String(endpoint)\n\t\to.UsePathStyle = true\n\t}), nil\n}\n\nfunc ensureCollections(app core.App) error {\n\tif _, err := app.Dao().FindCollectionByNameOrId("pending_upload"); err != nil {\n\t\tif !errors.Is(err, sql.ErrNoRows) {\n\t\t\t// continue to create\n\t\t}\n\t\tcol := models.NewBaseCollection("pending_upload")\n\t\tcol.Fields.Add(\n\t\t\t&schema.SchemaField{Name: "user", Type: schema.FieldTypeRelation, Options: &schema.RelationOptions{MaxSelect: 1, CollectionId: "_pb_users_auth_", Required: true}},\n\t\t\t&schema.SchemaField{Name: "key", Type: schema.FieldTypeText, Options: &schema.TextOptions{Required: true, Pattern: "^[a-f0-9-]{16,}$"}},\n\t\t\t&schema.SchemaField{Name: "expires_at", Type: schema.FieldTypeDate, Options: &schema.DateOptions{Required: true}},\n\t\t)\n\t\tcol.Indexes = []string{"CREATE UNIQUE INDEX idx_pending_upload_key ON pending_upload (key)"}\n\t\tif err := app.Dao().SaveCollection(col); err != nil {\n\t\t\treturn fmt.Errorf("create pending_upload: %w", err)\n\t\t}\n\t\tlog.Println("created pending_upload collection")\n\t}\n\n\tif _, err := app.Dao().FindCollectionByNameOrId("uploads"); err != nil {\n\t\tcol := models.NewBaseCollection("uploads")\n\t\tcol.Fields.Add(\n\t\t\t&schema.SchemaField{Name: "user", Type: schema.FieldTypeRelation, Options: &schema.RelationOptions{MaxSelect: 1, CollectionId: "_pb_users_auth_", Required: true}},\n\t\t\t&schema.SchemaField{Name: "key", Type: schema.FieldTypeText, Options: &schema.TextOptions{Required: true, Pattern: "^[a-f0-9-]{16,}$"}},\n\t\t)\n\t\tcol.Indexes = []string{"CREATE UNIQUE INDEX idx_uploads_key ON uploads (key)"}\n\t\tif err := app.Dao().SaveCollection(col); err != nil {\n\t\t\treturn fmt.Errorf("