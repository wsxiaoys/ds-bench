Sending keys: ["cat > checkout.js << 'EOF'\nconst { PrismaClient } = require('@prisma/client');\nconst fs = require('fs');\n\nconst prisma = new PrismaClient();\n\nasync function checkout(productId, quantity) {\n  return prisma.$transaction(async (tx) => {\n    const product = await tx.product.findUnique({ where: { id: productId } });\n    if (!product || product.stock < quantity) {\n      throw new Error('Insufficient stock');\n    }\n    await tx.product.update({\n      where: { id: productId },\n      data: { stock: { decrement: quantity } },\n    });\n    const order = await tx.order.create({\n      data: { productId, quantity },\n    });\n    return order;\n  });\n}\n\n(async () => {\n  try {\n    const successOrder = await checkout(1, 3);\n    console.log('Success order:', successOrder);\n\n    let insufficientStockCaught = false;\n    try {\n      await checkout(1, 100);\n    } catch (e) {\n      console.log('Caught error:', e.message);\n      insufficientStockCaught = true;\n    }\n\n    const finalProduct = await prisma.product.findUnique({ where: { id: 1 } });\n    const orderCount = await prisma.order.count();\n\n    const result = {\n      finalStock: finalProduct.stock,\n      orderCount,\n      insufficientStockCaught,\n    };\n\n    fs.writeFileSync('/home/user/myproject/checkout_result.json', JSON.stringify(result));\n    console.log('Result:', result);\n  } catch (e) {\n    console.error('Error:', e);\n    process.exitCode = 1;\n  } finally {\n    await prisma.$disconnect();\n  }\n})();\nEOF\n"] min_timeout_sec: 0.1 max_timeout_sec: 180.0
