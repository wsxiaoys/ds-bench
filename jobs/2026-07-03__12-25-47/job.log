Sending keys: ['mkdir -p /home/user && cat > /home/user/transcribe.py << \'PYEOF\'\nimport json\nimport numpy as np\nimport librosa\n\n# Load audio\ny, sr = librosa.load(\'/home/user/input.wav\', sr=None)\nduration = float(librosa.get_duration(y=y, sr=sr))\n\n# Detect onsets with backtrack=True\nonset_frames = librosa.onset.onset_detect(y=y, sr=sr, backtrack=True)\nonset_times = librosa.frames_to_time(onset_frames, sr=sr)\n\n# Deduplicate (keep first of equal times)\nif len(onset_times) > 0:\n    unique = [onset_times[0]]\n    for t in onset_times[1:]:\n        if t > unique[-1] + 1e-6:\n            unique.append(t)\n    onset_times = np.array(unique)\n\n# Build segment boundaries: each onset to next onset (or end)\nboundaries = list(onset_times) + [duration]\n\n# Pre-compute RMS across the whole file\nhop_length = 512\nrms_all = librosa.feature.rms(y=y, hop_length=hop_length)[0]\nrms_times = librosa.frames_to_time(np.arange(len(rms_all)), sr=sr, hop_length=hop_length)\n\nfmin_hz = librosa.note_to_hz(\'C2\')\nfmax_hz = librosa.note_to_hz(\'C7\')\n\nraw_notes = []\nfor i in range(len(onset_times)):\n    start = float(onset_times[i])\n    end = float(boundaries[i + 1])\n    if end <= start:\n        # Ensure strict increase\n        end = start + 1.0 / sr\n\n    start_sample = int(start * sr)\n    end_sample = max(end_sample if False else int(end * sr), start_sample + 1)\n    y_seg = y[start_sample:end_sample]\n\n    # Estimate pitch with pyin\n    try:\n        f0, voiced_flag, voiced_prob = librosa.pyin(\n            y_seg, fmin=fmin_hz, fmax=fmax_hz, sr=sr\n        )\n    except Exception:\n        f0 = np.array([np.nan])\n\n    voiced_f0 = f0[~np.isnan(f0)]\n    if len(voiced_f0) == 0:\n        continue\n\n    pitch_hz = float(np.median(voiced_f0))\n    pitch_midi_f = float(librosa.hz_to_midi(pitch_hz))\n    pitch_midi = int(round(pitch_midi_f))\n    pitch_midi = max(0, min(127, pitch_midi))\n\n    # RMS for this segment\n    start_frame = int(np.searchsorted(rms_times, start))\n    end_frame = int(np.searchsorted(rms_times, end))\n    end_frame = max(end_frame, start_frame + 1)\n    seg_rms = rms_all[start_frame:end_frame]\n    if len(seg_rms) == 0:\n        seg_rms = np.array([0.0])\n    rms_val = float(np.mean(seg_rms))\n\n    raw_notes.append({\n        \'onset_sec\': start,\n        \'offset_sec\': end,\n        \'pitch_midi\': pitch_midi,\n        \'rms\': rms_val,\n    })\n\n# Compute velocity from RMS values mapped to [1, 127]\nif len(raw_notes) > 0:\n    rms_vals = np.array([n[\'rms\'] for n in raw_notes])\n    rmin = float(rms_vals.min())\n    rmax = float(rms_vals.max())\n    for n in raw_notes:\n        if rmax > rmin:\n            v = 1 + int(round((n[\'rms\'] - rmin) / (rmax - rmin) * 126))\n        else:\n            v = 100\n        n[\'velocity\'] = max(1, min(127, v))\n\n# Clamp offset_sec to <= duration + 0.1\nmax_offset = duration + 0.1\nfor n in raw_notes:\n    if n[\'offset_sec\'] > max_offset:\n        n[\'offset_sec\'] = max_offset\n    # Ensure strict > onset\n    if n[\'offset_sec\'] <= n[\'onset_sec\']:\n        n[\'offset_sec\'] = n[\'onset_sec\'] + 1.0 / sr\n\n# Build final notes\nfinal_notes = [\n    {\n        \'onset_sec\': float(n[\'onset_sec\']),\n        \'offset_sec\': float(n[\'offset_sec\']),\n        \'pitch_midi\': int(n[\'pitch_midi\']),\n        \'velocity\': int(n[\'velocity\']),\n    }\n    for n in raw_notes\n]\n\n# Sort by onset\nfinal_notes.sort(key=lambda x: x[\'onset_sec\'])\n\nwith open(\'/home/user/notes.json\', \'w\') as f:\n    json.dump(final_notes, f, indent=2)\n\nprint(f"Wrote {len(final_notes)} notes to /home/user/notes.json")\nfor n in final_notes[:5]:\n    print(n)\nPYEOF\n'] min_timeout_sec: 0.2 max_timeout_sec: 180.0
