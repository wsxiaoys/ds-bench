Sending keys: ['cat > /home/user/bytewax-sink/run.py << \'EOF\'\nimport json\nimport os\n\nfrom bytewax.dataflow import Dataflow\nfrom bytewax.inputs import FixedPartitionedSource\nfrom bytewax.outputs import DynamicSink, StatelessSinkPartition\nfrom bytewax.operators import input, output\nfrom bytewax.testing import TestingSource\n\n\n# Read the run-id from the artifacts directory\nRUN_ID_FILE = "/logs/artifacts/run-id"\nwith open(RUN_ID_FILE, "r") as f:\n    RUN_ID = f.read().strip()\n\n# Output directory\nOUTPUT_DIR = "/home/user/bytewax-sink/out"\nos.makedirs(OUTPUT_DIR, exist_ok=True)\n\n\nclass JSONLRotatingPartition(StatelessSinkPartition):\n    """A stateless sink partition that writes items to JSONL files with rotation.\n\n    Each file contains at most RECORDS_PER_FILE records. When the limit is reached,\n    the file is closed and a new file with the next part number is opened.\n    """\n\n    def __init__(self, run_id, worker_index, output_dir, records_per_file=20):\n        self._run_id = run_id\n        self._worker_index = worker_index\n        self._output_dir = output_dir\n        self._records_per_file = records_per_file\n        self._part_number = 0\n        self._records_in_current_file = 0\n        self._current_file = None\n\n    def _current_path(self):\n        return os.path.join(\n            self._output_dir,\n            f"output-{self._run_id}-worker-{self._worker_index}-part-{self._part_number}.jsonl",\n        )\n\n    def _ensure_file(self):\n        """Open a new file if one is not currently open."""\n        if self._current_file is None:\n            path = self._current_path()\n            self._current_file = open(path, "a")\n\n    def _close_file(self):\n        """Close the current file (if any) and reset state."""\n        if self._current_file is not None:\n            self._current_file.close()\n            self._current_file = None\n\n    def _advance_part(self):\n        """Move to the next part number."""\n        self._close_file()\n        self._part_number += 1\n        self._records_in_current_file = 0\n\n    def write_batch(self, items):\n        """Write items to the current file, rotating as needed."""\n        for item in items:\n            # If the current file is full, rotate to a new part\n            if self._records_in_current_file >= self._records_per_file:\n                self._advance_part()\n\n            # Ensure a file is open\n            self._ensure_file()\n\n            # Write the record\n            record = {"worker": self._worker_index, "value": item}\n            self._current_file.write(json.dumps(record) + "\\n")\n            self._records_in_current_file += 1\n\n            # If this write filled up the file, close it immediately\n            if self._records_in_current_file >= self._records_per_file:\n                self._close_file()\n                # Prepare for the next part, but don\'t open a new file yet.\n                # We\'ll advance the part number when we actually need to write again.\n                # But the spec says we need to advance to next part number.\n                self._part_number += 1\n                self._records_in_current_file = 0\n\n    def close(self):\n        """Close any open file when the partition is closed."""\n        self._close_file()\n\n\nclass JSONLRotatingSink(DynamicSink):\n    """A dynamic sink that writes items to rotating JSONL files per worker."""\n\n    def __init__(self, run_id, output_dir, records_per_file=20):\n        self._run_id = run_id\n        self._output_dir = output_dir\n        self._records_per_file = records_per_file\n\n    def build(self, step_id, worker_index, worker_count):\n        return JSONLRotatingPartition(\n            run_id=self._run_id,\n            worker_index=worker_index,\n            output_dir=self._output_dir,\n            records_per_file=self._records_per_file,\n        )\n\n\n# Create a list of 200 integers 0..199\nitems = list(range(200))\n\n# Build the dataflow\nflow = Dataflow("jsonl-rotation")\ninp = input("inp", flow, TestingSource(items))\noutput("out", inp, JSONLRotatingSink(RUN_ID, OUTPUT_DIR))\nEOF\n'] min_timeout_sec: 0.2 max_timeout_sec: 180.0
