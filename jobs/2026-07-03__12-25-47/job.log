Sending keys: ['cat > /tmp/test2.py << \'PYEOF\'\n"""Test with actual JSON input."""\nimport json\nfrom datetime import datetime, timedelta, timezone\nfrom pathlib import Path\nfrom bytewax.dataflow import Dataflow\nimport bytewax.operators as op\nfrom bytewax.operators.windowing import EventClock, SlidingWindower, fold_window\nfrom bytewax.testing import TestingSource, run_main\n\nflow = Dataflow("test")\n\ndata = [\n    json.dumps({"sensor_id": "a", "time": "2026-01-01T00:00:10Z", "temp": 20.0}),\n    json.dumps({"sensor_id": "a", "time": "2026-01-01T00:00:25Z", "temp": 22.0}),\n]\n\ninp = op.input("in", flow, TestingSource(data))\nparsed = op.map("parse", inp, lambda l: json.loads(l))\nkeyed = op.key_on("key", parsed, lambda x: x["sensor_id"])\n\ndef to_event(item):\n    t = item["time"]\n    if t.endswith("Z"):\n        t = t[:-1] + "+00:00"\n    return {"sensor_id": item["sensor_id"], "temp": float(item["temp"]), "time": datetime.fromisoformat(t)}\n\nevents = op.map_value("to_event", keyed, to_event)\n\nclock = EventClock(ts_getter=lambda e: e["time"], wait_for_system_duration=timedelta(0))\nwindower = SlidingWindower(length=timedelta(seconds=60), offset=timedelta(seconds=30), align_to=datetime(2026,1,1,tzinfo=timezone.utc))\n\nwindowed = fold_window("fold", events, clock, windower,\n                       builder=lambda: {"count":0, "sum":0.0, "sumsq":0.0},\n                       folder=lambda acc, e: (acc.update({"count":acc["count"]+1, "sum":acc["sum"]+e["temp"], "sumsq":acc["sumsq"]+e["temp"]**2}) or acc),\n                       merger=lambda a, b: {"count":a["count"]+b["count"], "sum":a["sum"]+b["sum"], "sumsq":a["sumsq"]+b["sumsq"]})\n\nop.inspect("down", windowed.down)\nop.inspect("meta", windowed.meta)\n\njoined = op.join("join", windowed.down, windowed.meta)\nop.inspect("joined", joined)\n\nrun_main(flow)\nPYEOF\ncd /tmp && python3 test2.py 2>&1 | head -30\n'] min_timeout_sec: 5.0 max_timeout_sec: 180.0
