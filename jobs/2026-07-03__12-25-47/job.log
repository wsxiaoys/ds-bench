Sending keys: ['cat > /home/user/apideck_task/workflow.py << \'EOF\'\n#!/usr/bin/env python3\nimport os\nimport json\nimport urllib.request\nimport urllib.parse\nimport urllib.error\n\nAPI_KEY = os.environ[\'APIDECK_API_KEY\']\nAPP_ID = os.environ[\'APIDECK_APP_ID\']\nCONSUMER_ID = os.environ[\'APIDECK_CONSUMER_ID\']\nCOLLECTION_ID = os.environ[\'APIDECK_ISSUE_TRACKING_COLLECTION_ID\']\nSERVICE_ID = \'github\'\n\nwith open(\'/logs/artifacts/run-id\') as f:\n    RUN_ID = f.read().strip()\n\nBASE = \'https://unify.apideck.com\'\n\ndef request(method, path, body=None, query=None):\n    url = BASE + path\n    if query:\n        url += \'?\' + urllib.parse.urlencode(query)\n    data = None\n    headers = {\n        \'Authorization\': \'Bearer \' + API_KEY,\n        \'x-apideck-app-id\': APP_ID,\n        \'x-apideck-consumer-id\': CONSUMER_ID,\n        \'x-apideck-service-id\': SERVICE_ID,\n        \'Accept\': \'application/json\',\n    }\n    if body is not None:\n        data = json.dumps(body).encode(\'utf-8\')\n        headers[\'Content-Type\'] = \'application/json\'\n    req = urllib.request.Request(url, data=data, method=method, headers=headers)\n    try:\n        with urllib.request.urlopen(req) as resp:\n            return resp.status, json.loads(resp.read().decode(\'utf-8\'))\n    except urllib.error.HTTPError as e:\n        return e.code, e.read().decode(\'utf-8\')\n\n# 1. Create ticket\nsubject = f\'[COMMENT-EDIT-DELETE] {RUN_ID}\'\nprint(f\'Creating ticket with subject: {subject}\')\nstatus, resp = request(\'POST\', f\'/issue-tracking/collections/{COLLECTION_ID}/tickets\', {\n    \'subject\': subject,\n    \'status\': \'open\',\n    \'description\': f\'Ticket for comment edit/delete workflow. run-id={RUN_ID}\',\n})\nprint(\'Create ticket status:\', status)\nprint(\'Create ticket response:\', json.dumps(resp, indent=2) if isinstance(resp, dict) else resp)\n\nif status not in (200, 201):\n    raise SystemExit(\'Failed to create ticket\')\n\nticket_id = resp[\'data\'][\'id\']\nprint(f\'Ticket ID: {ticket_id}\')\n\n# Log ticket ID\nwith open(\'/home/user/apideck_task/output.log\', \'w\') as f:\n    f.write(f\'Ticket ID: {ticket_id}\\n\')\n\n# 2. Add 4 comments\ncomment_ids = {}\nfor label in [\'A\', \'B\', \'C\', \'D\']:\n    body = f\'{label}-{RUN_ID}\'\n    print(f\'Creating comment {body}\')\n    status, resp = request(\'POST\', f\'/issue-tracking/collections/{COLLECTION_ID}/tickets/{ticket_id}/comments\', {\n        \'body\': body,\n    })\n    print(f\'  status={status}\')\n    if isinstance(resp, dict):\n        cid = resp.get(\'data\', {}).get(\'id\')\n        comment_ids[body] = cid\n        print(f\'  id={cid}\')\n    else:\n        print(f\'  resp={resp}\')\n    if status not in (200, 201):\n        raise SystemExit(f\'Failed to create comment {body}\')\n\n# 3. Edit comment B\nb_body = f\'B-{RUN_ID}\'\nb_id = comment_ids[b_body]\nb_new = f\'B-EDITED-{RUN_ID}\'\nprint(f\'Editing comment {b_id} -> {b_new}\')\nstatus, resp = request(\'PATCH\', f\'/issue-tracking/collections/{COLLECTION_ID}/tickets/{ticket_id}/comments/{b_id}\', {\n    \'body\': b_new,\n})\nprint(f\'  status={status}\')\nprint(f\'  resp={json.dumps(resp, indent=2) if isinstance(resp, dict) else resp}\')\n\n# 4. Delete comment C\nc_body = f\'C-{RUN_ID}\'\nc_id = comment_ids[c_body]\nprint(f\'Deleting comment {c_id}\')\nstatus, resp = request(\'DELETE\', f\'/issue-tracking/collections/{COLLECTION_ID}/tickets/{ticket_id}/comments/{c_id}\')\nprint(f\'  status={status}\')\nprint(f\'  resp={json.dumps(resp, indent=2) if isinstance(resp, dict) else resp}\')\n\n# 5. Verify by listing comments\nprint(\'\\nVerifying comments...\')\nall_comments = []\ncursor = None\nwhile True:\n    query = {\'limit\': 100}\n    if cursor:\n        query[\'cursor\'] = cursor\n    status, resp = request(\'GET\', f\'/issue-tracking/collections/{COLLECTION_ID}/tickets/{ticket_id}/comments\', query=query)\n    if status != 200 or not isinstance(resp, dict):\n        print(\'List status:\', status, resp)\n        break\n    all_comments.extend(resp.get(\'data\', []))\n    cursor = resp.get(\'meta\', {}).get(\'cursors\', {}).get(\'next\')\n    if not cursor:\n        break\n\nprint(f\'Total comments: {len(all_comments)}\')\nfor c in all_comments:\n    print(f\'  id={c.get("id")} body={c.get("body")!r}\')\n\nprint(f\'\\nLogged ticket ID: {ticket_id}\')\nEOF\necho \'Script created\'\n'] min_timeout_sec: 0.2 max_timeout_sec: 180.0
