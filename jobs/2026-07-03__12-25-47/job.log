Sending keys: ['cat > /home/user/turn-based-game/headless/src/main/java/launcher/HeadlessLauncher.java << \'EOF\'\npackage launcher;\n\nimport com.badlogic.gdx.ApplicationListener;\nimport com.badlogic.gdx.Gdx;\nimport com.badlogic.gdx.backends.headless.HeadlessApplication;\nimport com.badlogic.gdx.backends.headless.HeadlessApplicationConfiguration;\nimport com.badlogic.gdx.files.FileHandle;\nimport game.ScriptedMockInput;\nimport game.TurnBasedGame;\n\nimport java.io.File;\nimport java.util.ArrayList;\nimport java.util.List;\nimport java.util.concurrent.CountDownLatch;\n\n/**\n * Headless launcher. Boots a {@link HeadlessApplication} running a {@link TurnBasedGame}\n * driven by commands read from a script file. The transcript is written via libGDX\'s\n * {@link Gdx#files} subsystem, then the JVM is allowed to terminate cleanly with exit code 0.\n */\npublic final class HeadlessLauncher {\n\n    private HeadlessLauncher() { }\n\n    public static void main(String[] args) {\n        Args parsed = parseArgs(args);\n        if (parsed == null) {\n            System.err.println("Usage: HeadlessLauncher --map=<path> --commands=<path> --transcript=<path>");\n            System.exit(2);\n            return;\n        }\n\n        // Read commands file via standard IO (parsing is independent of libGDX).\n        final List<String> commands = readCommands(parsed.commandsPath);\n        final CountDownLatch mainLoopDone = new CountDownLatch(1);\n        final ScriptedMockInput scripted = new ScriptedMockInput(commands);\n\n        // Bootstrap listener that defers real game construction to create() so we have Gdx.files.\n        ApplicationListener bootstrap = new ApplicationListener() {\n            private TurnBasedGame game;\n\n            @Override\n            public void create() {\n                FileHandle mapHandle = Gdx.files.absolute(new File(parsed.mapPath).getAbsolutePath());\n                FileHandle transcriptHandle = Gdx.files.absolute(new File(parsed.transcriptPath).getAbsolutePath());\n                game = new TurnBasedGame(mapHandle, transcriptHandle, scripted);\n                game.create();\n            }\n\n            @Override\n            public void render() { if (game != null) game.render(); }\n\n            @Override\n            public void pause() { if (game != null) game.pause(); }\n\n            @Override\n            public void resize(int w, int h) { if (game != null) game.resize(w, h); }\n\n            @Override\n            public void resume() { if (game != null) game.resume(); }\n\n            @Override\n            public void dispose() {\n                try { if (game != null) game.dispose(); }\n                finally { mainLoopDone.countDown(); }\n            }\n        };\n\n        HeadlessApplicationConfiguration cfg = new HeadlessApplicationConfiguration();\n        // Run as fast as possible (0 means "uncapped" in the headless backend).\n        cfg.updatesPerSecond = 0;\n\n        new HeadlessApplication(bootstrap, cfg);\n        // Replace Gdx.input with our scripted subclass immediately after construction.\n        Gdx.input = scripted;\n\n        // Block the main thread until the headless main-loop thread finishes.\n        try {\n            mainLoopDone.await();\n        } catch (InterruptedException ie) {\n            Thread.currentThread().interrupt();\n        }\n    }\n\n    private static Args parseArgs(String[] args) {\n        String mapPath = null;\n        String commandsPath = null;\n        String transcriptPath = null;\n        for (String a : args) {\n            if (a == null) continue;\n            if (a.startsWith("--map=")) mapPath = a.substring("--map=".length());\n            else if (a.startsWith("--commands=")) commandsPath = a.substring("--commands=".length());\n            else if (a.startsWith("--transcript=")) transcriptPath = a.substring("--transcript=".length());\n        }\n        if (mapPath == null || commandsPath == null || transcriptPath == null) return null;\n        return new Args(mapPath, commandsPath, transcriptPath);\n    }\n\n    /** Holder for parsed CLI args (immutable so it can be captured by inner classes). */\n    private static final class Args {\n        final String mapPath;\n        final String commandsPath;\n        final String transcriptPath;\n        Args(String mapPath, String commandsPath, String transcriptPath) {\n            this.mapPath = mapPath;\n            this.commandsPath = commandsPath;\n            this.transcriptPath = transcriptPath;\n        }\n    }\n\n    private static List<String> readCommands(String path) {\n        List<String> out = new ArrayList<String>();\n        java.io.BufferedReader br = null;\n        try {\n            br = new java.io.BufferedReader(\n                    new java.io.InputStreamReader(\n                            new java.io.FileInputStream(path), "UTF-8"));\n            String line;\n            while ((line = br.readLine()) != null) {\n                String trimmed = line.trim();\n                if (trimmed.isEmpty()) continue;\n                if (trimmed.startsWith("#")) continue;\n                out.add(trimmed);\n            }\n        } catch (java.io.IOException ioe) {\n            throw new RuntimeException("Failed to read commands file: " + path, ioe);\n        } finally {\n            if (br != null) {\n                try { br.close(); } catch (java.io.IOException ignored) { }\n            }\n        }\n        return out;\n    }\n}\nEOF\n'] min_timeout_sec: 0.1 max_timeout_sec: 180.0
