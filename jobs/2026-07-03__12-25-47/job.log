Sending keys: ['cat > hello/graphql.ts << \'EOF\'\nimport { api } from "encore.dev";\nimport { createSchema, createYoga } from "graphql-yoga";\n\nconst typeDefs = `\n  type Query {\n    """Returns a hello message. If no name is provided, returns \'Hello, World!\'"""\n    hello(name: String): String!\n  }\n`;\n\nconst resolvers = {\n  Query: {\n    hello: (_parent: unknown, args: { name?: string | null }) => {\n      const name = args.name ?? "World";\n      return `Hello, ${name}!`;\n    },\n  },\n};\n\nconst yoga = createYoga({\n  schema: createSchema({ typeDefs, resolvers }),\n  graphqlEndpoint: "/graphql",\n  landingPage: false,\n  graphiql: false,\n});\n\nexport const graphql = api.raw(\n  { expose: true, method: "*", path: "/graphql" },\n  async (ctx) => {\n    const request = ctx.request;\n    const url = new URL(request.url);\n    const headers: Record<string, string> = {};\n    request.headers.forEach((value, key) => {\n      headers[key] = value;\n    });\n\n    const method = request.method;\n    let body: BodyInit | undefined;\n    const contentType = request.headers.get("content-type") ?? "";\n    if (method !== "GET" && method !== "HEAD" && request.body) {\n      const cloned = request.clone();\n      if (contentType.includes("application/json")) {\n        const text = await cloned.text();\n        body = text;\n      } else {\n        body = await cloned.arrayBuffer().then((buf) => new Uint8Array(buf));\n      }\n    }\n\n    const yogaRequest = new Request(request.url, {\n      method,\n      headers,\n      body,\n    } as RequestInit);\n\n    const response = await yoga.handle(yogaRequest, {});\n\n    const responseHeaders: Record<string, string> = {};\n    response.headers.forEach((value, key) => {\n      responseHeaders[key] = value;\n    });\n\n    const responseBody = await response.text();\n    return new Response(responseBody, {\n      status: response.status,\n      headers: responseHeaders,\n    });\n  }\n);\nEOF\n'] min_timeout_sec: 0.2 ma