Sending keys: ['cat > /home/user/myproject/classify.py << \'EOF\'\n#!/usr/bin/env python3\n"""Classify a single PDF document using the LlamaCloud Classifier.\n\nUsage:\n    python3 classify.py <path-to-pdf>\n\nThe script uploads the file to LlamaCloud with purpose="classify", runs the\nclassify job in FAST mode against three fixed rules (invoice, receipt,\ncontract), and prints a single line of JSON to stdout containing the\nclassified `type`, the `confidence` score and the resolved absolute file\npath. Exits with status 0 on success and non-zero on any error.\n"""\n\nfrom __future__ import annotations\n\nimport argparse\nimport json\nimport os\nimport sys\nfrom pathlib import Path\n\nfrom llama_cloud import LlamaCloud\n\n\n# The three classification rules, in the exact order required by the task.\nRULES = [\n    {\n        "type": "invoice",\n        "description": (\n            "documents that contain an invoice number, invoice date, "\n            "bill-to section, and line items with totals."\n        ),\n    },\n    {\n        "type": "receipt",\n        "description": (\n            "short purchase receipts, typically from POS systems, with "\n            "merchant, items and total, often a single page."\n        ),\n    },\n    {\n        "type": "contract",\n        "description": (\n            "multi-section legal agreement with parties, terms, and "\n            "signature lines."\n        ),\n    },\n]\n\n\ndef classify_file(client: LlamaCloud, file_path: Path) -> dict:\n    """Upload `file_path` and run the classify job, returning the JSON payload."""\n    # 1. Upload the file to LlamaCloud.\n    uploaded = client.files.create(file=str(file_path), purpose="classify")\n    file_id = uploaded.id\n\n    # 2. Run the classify job (uploads, polls, returns results in one call).\n    response = client.classifier.classify(\n        file_ids=[file_id],\n        rules=RULES,\n        mode="FAST",\n    )\n\n    items = getattr(response, "items", None) or []\n    if not items:\n        raise RuntimeError("classifier returned no items")\n\n    item = items[0]\n    result = getattr(item, "result", None)\n    if result is None:\n        raise RuntimeError("classifier item has no result")\n\n    classified_type = getattr(result, "type", None)\n    confidence = getattr(result, "confidence", None)\n    if classified_type is None or confidence is None:\n        raise RuntimeError("classifier result missing type or confidence")\n\n    return {\n        "type": classified_type,\n        "confidence": confidence,\n        "file": str(file_path.resolve()),\n    }\n\n\ndef parse_args(argv: list[str] | None = None) -> argparse.Namespace:\n    parser = argparse.ArgumentParser(\n        description="Classify a PDF document with LlamaCloud Classifier."\n    )\n    parser.add_argument(\n        "file",\n        type=Path,\n        help="Local path to a PDF document to classify.",\n    )\n    return parser.parse_args(argv)\n\n\ndef main(argv: list[str] | None = None) -> int:\n    # Fail fast if the API key is missing.\n    if not os.environ.get("LLAMA_CLOUD_API_KEY"):\n        print(\n            "error: LLAMA_CLOUD_API_KEY environment variable is not set",\n            file=sys.stderr,\n        )\n        return 2\n\n    args = parse_args(argv)\n    file_path: Path = args.file\n\n    if not file_path.is_file():\n        print(f"error: file not found: {file_path}", file=sys.stderr)\n        return 2\n\n    client = LlamaCloud()\n\n    try:\n        payload = classify_file(client, file_path)\n    except Exception as exc:  # noqa: BLE001 - report any failure as exit 1.\n        print(f"error: classification failed: {exc}", file=sys.stderr)\n        return 1\n\n    print(json.dumps(payload))\n    return 0\n\n\nif __name__ == "__main__":\n    raise SystemExit(main())\nEOF\n'] min_timeout_sec: 0.2 max_timeout_sec: 180.0
