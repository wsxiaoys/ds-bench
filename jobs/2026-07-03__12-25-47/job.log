Sending keys: ['cat > /home/user/myproject/main.py << \'PYEOF\'\n#!/usr/bin/env python3\n"""Basic Alchemyst AI RAG flow.\n\nAdds a 30-day refund policy document to the Alchemyst context engine and\nthen searches for chunks relevant to a user-supplied question.\n"""\n\nimport argparse\nimport os\nimport sys\n\nfrom alchemyst_ai import AlchemystAI\n\n\nREFUND_POLICY_CONTENT = (\n    "Refund Policy. Customers may request a full refund within 30 days of "\n    "purchase for any product or subscription, no questions asked. To be "\n    "eligible for a refund, the customer must provide the original order "\n    "number and proof of purchase. Refund requests submitted after the "\n    "30-day window will not be honoured. Approved refunds are typically "\n    "credited back to the original payment method within 5-7 business days."\n)\n\n\ndef parse_args() -> argparse.Namespace:\n    parser = argparse.ArgumentParser(\n        description="Run a basic Alchemyst AI RAG flow."\n    )\n    parser.add_argument(\n        "--question",\n        required=True,\n        type=str,\n        help="The user question to search the Alchemyst context engine for.",\n    )\n    return parser.parse_args()\n\n\ndef read_run_id() -> str:\n    run_id_path = "/logs/artifacts/run-id"\n    with open(run_id_path, "r", encoding="utf-8") as fh:\n        return fh.read().strip()\n\n\ndef main() -> int:\n    args = parse_args()\n\n    api_key = os.environ.get("ALCHEMYST_AI_API_KEY")\n    if not api_key:\n        print(\n            "Error: ALCHEMYST_AI_API_KEY environment variable is not set.",\n            file=sys.stderr,\n        )\n        return 1\n\n    run_id = read_run_id()\n\n    client = AlchemystAI(api_key=api_key)\n\n    # 1) Add a single policy document to the context engine.\n    add_response = client.v1.context.add(\n        context_type="resource",\n        source="documentation",\n        scope="internal",\n        documents=[\n            {\n                "content": REFUND_POLICY_CONTENT,\n                "file_name": f"refunds-{run_id}.md",\n                "file_type": "text/markdown",\n                "last_modified": "2024-01-01T00:00:00Z",\n            }\n        ],\n        metadata={\n            "file_name": f"refunds-{run_id}.md",\n        },\n    )\n\n    print(f"[add] {add_response}")\n\n    # 2) Search the context engine for the user question.\n    search_response = client.v1.context.search(\n        query=args.question,\n        scope="internal",\n        similarity_threshold=0.6,\n        minimum_similarity_threshold=0.1,\n    )\n\n    contexts = getattr(search_response, "contexts", None) or []\n    if not contexts:\n        print(\n            "No relevant context chunks were returned for the question: "\n            f"{args.question!r}"\n        )\n        return 0\n\n    for idx, ctx in enumerate(contexts, start=1):\n        content = getattr(ctx, "content", None)\n        print(f"--- chunk {idx} ---")\n        print(content if content is not None else ctx)\n\n    return 0\n\n\nif __name__ == "__main__":\n    sys.exit(main())\nPYEOF\n'] min_timeout_sec: 0.2 max_timeout_sec: 180.0
