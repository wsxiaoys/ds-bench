Sending keys: ['cat > /home/user/myproject/build_chart.py << \'PYEOF\'\nimport altair as alt\n\n# URL-based data source; declare types explicitly.\nurl = "https://cdn.jsdelivr.net/npm/vega-datasets@v1/data/movies.json"\ndata = alt.UrlData(url, format="json")\n\n# Shared predicates to drop nulls on the rating columns on every view.\n# (Scatter adds the Rotten_Tomatoes_Rating null-filter as well.)\nimdb_not_null = "datum.IMDB_Rating != null"\nrt_not_null = "datum.Rotten_Tomatoes_Rating != null"\n\n# Reusable brush that drives all three views.\nbrush = alt.selection_interval(name="brush")\n\n# ----- View A: scatter (brush host) ---------------------------------------\n# IMDB vs Rotten Tomatoes, colored by Major_Genre inside the brush,\n# otherwise flat \'lightgray\'.\nscatter = (\n    alt.Chart(data, title="IMDB vs Rotten Tomatoes")\n    .mark_point()\n    .transform_filter(imdb_not_null)\n    .transform_filter(rt_not_null)\n    .encode(\n        x=alt.X("IMDB_Rating:Q", title="IMDB Rating"),\n        y=alt.Y("Rotten_Tomatoes_Rating:Q", title="Rotten Tomatoes Rating"),\n        color=alt.Color(\n            "Major_Genre:N",\n            legend=alt.Legend(title="Major Genre (inside brush)"),\n        ),\n        tooltip=["Title:N", "Major_Genre:N", "IMDB_Rating:Q", "Rotten_Tomatoes_Rating:Q"],\n    )\n    .properties(width=600, height=400)\n    .add_params(brush)\n    .encode(\n        x=alt.X("IMDB_Rating:Q", title="IMDB Rating"),\n        y=alt.Y("Rotten_Tomatoes_Rating:Q", title="Rotten Tomatoes Rating"),\n        color=alt.condition(\n            brush,\n            alt.Color("Major_Genre:N", legend=alt.Legend(title="Major Genre (inside brush)")),\n            alt.value("lightgray"),\n        ),\n        tooltip=["Title:N", "Major_Genre:N", "IMDB_Rating:Q", "Rotten_Tomatoes_Rating:Q"],\n    )\n    .properties(width=600, height=400)\n)\n\n# ----- View B: bar of top-8 most frequent Major_Genre values ----------------\n# Rank genres globally, then keep the top 8 regardless of the brush.\ngenre_ranking = (\n    alt.Chart(data)\n    .transform_filter(imdb_not_null)\n    .transform_filter(rt_not_null)\n    .transform_aggregate(count="count()", groupby=["Major_Genre"])\n    .transform_window(rank="rank(count)", sort=[alt.SortField("count", order="descending")])\n    .transform_filter("datum.rank <= 8")\n)\n\nbar = (\n    alt.Chart(data, title="Movies by Major Genre (top 8)")\n    .mark_bar()\n    .transform_filter(imdb_not_null)\n    .transform_filter(rt_not_null)\n    .transform_filter(brush)\n    .transform_lookup("Major_Genre", from_=alt.LookupData(genre_ranking, "Major_Genre", ["rank"]))\n    .transform_filter("datum.rank != null")\n    .encode(\n        x=alt.X("count():Q", title="Number of Movies"),\n        y=alt.Y("Major_Genre:N", sort="-x", title="Major Genre"),\n        color=alt.Color("Major_Genre:N", legend=None),\n        tooltip=["Major_Genre:N", alt.Tooltip("count():Q", title="Movies")],\n    )\n    .properties(width=300, height=200)\n)\n\n# ----- View C: IMDB_Rating histogram ---------------------------------------\nhist = (\n    alt.Chart(data, title="IMDB Rating Distribution")\n    .mark_bar()\n    .transform_filter(imdb_not_null)\n    .transform_filter(rt_not_null)\n    .transform_filter(brush)\n    .encode(\n        x=alt.X("IMDB_Rating:Q", bin=alt.Bin(maxbins=20), title="IMDB Rating (binned)"),\n        y=alt.Y("count():Q", title="Number of Movies"),\n        tooltip=[alt.Tooltip("IMDB_Rating:Q", bin=alt.Bin(maxbins=20)), alt.Tooltip("count():Q")],\n    )\n    .properties(width=300, height=200)\n)\n\n# ----- Compose layout: scatter on top, bar and histogram side-by-side -----\ndashboard = scatter & (bar | hist)\n\ndashboard.save("/home/user/myproject/chart.html")\nprint("Saved dashboard to /home/user/myproject/chart.html")\nPYEOF\n'] min_timeout_sec: 0.2 max_timeout_sec: 180.0
