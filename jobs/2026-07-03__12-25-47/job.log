questing markdown\n    # ------------------------------------------------------------------\n    parse_job = client.parsing.create(\n        tier="agentic",\n        version="latest",\n        file_id=uploaded.id,\n        output_options={"markdown": {}},\n    )\n    parse_job_id = parse_job.id\n    print(f"Created parse job {parse_job_id}")\n\n    completed_parse = client.parsing.wait_for_completion(parse_job_id, verbose=True)\n    print(f"Parse job {completed_parse.id} status={completed_parse.status}")\n\n    # Fetch expanded content (markdown) for the completed job\n    parse_result = client.parsing.get(completed_parse.id, expand=["markdown"])\n\n    # ------------------------------------------------------------------\n    # 3) Save the markdown of the first page\n    # ------------------------------------------------------------------\n    first_page_md = ""\n    if parse_result.markdown and parse_result.markdown.pages:\n        page1 = parse_result.markdown.pages[0]\n        if getattr(page1, "success", True):\n            first_page_md = page1.markdown\n        else:\n            first_page_md = f"_parse failed_: {getattr(page1, \'error\', \'\')}"\n    PARSED_MD_PATH.write_text(first_page_md)\n    print(f"Wrote {len(first_page_md)} chars of markdown to {PARSED_MD_PATH}")\n\n    # ------------------------------------------------------------------\n    # 4) Reuse the parse-job ID as file_input for the Extract job\n    # ------------------------------------------------------------------\n    extract_config = {\n        "data_schema": InvoiceSchema.model_json_schema(),\n        "tier": "agentic",\n        "version": "latest",\n    }\n\n    extract_job = client.extract.create(\n        file_input=completed_parse.id,\n        configuration=extract_config,\n    )\n    extract_job_id = extract_job.id\n    print(f"Created extract job {extract_job_id}")\n\n    completed_extract = client.extract.wait_for_completion(extract_job_id, verbose=True)\n    print(f"Extract job {completed_extract.id} status={completed_extract.status}")\n\n    # ------------------------------------------------------------------\n    # 5) Persist the structured extraction result\n    # ------------------------------------------------------------------\n    EXTRACTED_JSON_PATH.write_text(json.dumps(completed_extract.extract_result, indent=2))\n    print(f"Wrote extract result to {EXTRACTED_JSON_PATH}")\n\n    # ------------------------------------------------------------------\n    # 6) Append summary lines to output.log\n    # ------------------------------------------------------------------\n    with open(LOG_PATH, "a") as logf:\n        logf.write(f"Parse Job ID: {completed_parse.id}\\n")\n        logf.write(f"Extract Job ID: {completed_extract.id}\\n")\n    print(f"Appended summary lines to {LOG_PATH}")\n\n\nif __name__ == "__main__":\n    main()\nPYEOF\n'] min_timeout_sec: 0.2 max_timeout_sec: 180.0
