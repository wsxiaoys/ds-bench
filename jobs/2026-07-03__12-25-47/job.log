Sending keys: ['cat > /tmp/segment.py << \'PYEOF\'\nimport json\nimport numpy as np\nimport librosa\nimport librosa.feature\nimport librosa.beat\nimport librosa.segment\n\nHOP = 512\nSR = 22050\n\n# Load audio\ny, sr = librosa.load(\'/home/user/input.wav\', sr=SR)\nduration = len(y) / sr\n\n# Beat tracking\ntempo, beats = librosa.beat.beat_track(y=y, sr=sr, hop_length=HOP)\nbeats = np.asarray(beats)\n\n# Chroma CQT\nchroma = librosa.feature.chroma_cqt(y=y, sr=sr, hop_length=HOP)\n\n# Beat-synchronous chroma\nsync_chroma = librosa.util.sync(chroma, beats)\n\n# Coarse segmentation with agglomerative\n# Choose k so number of segments divides well and segments are meaningful\n# We have beats beats; try a k between 4 and 8\nk = 5\nbounds = librosa.segment.agglomerative(sync_chroma, k)\n# bounds are indices into the beat array (synchronous frames)\n# They always start at 0; length should equal k\nprint(\'agglo bounds:\', bounds, \'k=\', k, \'len beats=\', len(beats))\nprint(\'duration:\', duration)\n\n# Map beat indices to beat frames, then to time\nbeat_times = librosa.frames_to_time(beats, sr=sr, hop_length=HOP)\n\n# Coarse segment: [beats[bounds[i]], beats[bounds[i+1]])\n# Convert to time via librosa.frames_to_time(beat_frames, hop_length=HOP)\ncoarse_segments = []\nfor i in range(len(bounds)):\n    start_frame = int(beats[bounds[i]])\n    if i + 1 < len(bounds):\n        end_frame = int(beats[bounds[i+1]])\n    else:\n        end_frame = int(librosa.frames_to_time(np.array([len(y)//HOP]), sr=sr, hop_length=HOP)[0] * sr / HOP)\n        # use the last beat as end_frame - we just need the last beat frame to compute end time\n        end_frame = int(beats[-1])\n    start_t = float(librosa.frames_to_time(np.array([start_frame]), sr=sr, hop_length=HOP)[0])\n    end_t = float(librosa.frames_to_time(np.array([end_frame]), sr=sr, hop_length=HOP)[0])\n    coarse_segments.append({\'index\': i, \'start_frame\': start_frame, \'end_frame\': end_frame, \'start\': start_t, \'end\': end_t})\n\n# Clamp last end to duration\ncoarse_segments[-1][\'end\'] = duration\n\n# Subsegment each coarse segment\nfine_segments = []\nfor c in coarse_segments:\n    # Use the beat frames as the segment boundaries\n    # We need beat frames for this segment: find beats in [c[\'start_frame\'], c[\'end_frame\']]\n    seg_beats = beats[(beats >= c[\'start_frame\']) & (beats <= c[\'end_frame\'])]\n    if len(seg_beats) < 2:\n        # not enough beats, just split equally? Use the frames\n        # Fallback: use frames\n        seg_beats = np.array([c[\'start_frame\'], c[\'end_frame\']])\n    sub_bounds = librosa.segment.subsegment(chroma, seg_beats, n_segments=3)\n    # sub_bounds merges input boundaries; split into per-interval 3 each\n    # Number of intervals = len(seg_beats)-1, each interval should have up to 3 new boundaries\n    # Total boundaries = (n_intervals) * (n_segments-1) + 1? Actually: per interval we get n_segments+1 boundaries if all exist\n    # But subsegment returns boundaries consistent across intervals. The boundaries array contains all input boundaries AND the internal sub-boundaries.\n    # The structure is: for each interval, returns n_segments boundaries (left boundary at start of interval, then n_segments-1 interior, then end is start of next).\n    # Actually based on docs, subsegment returns "list of sub-divided segment boundaries" merging input boundaries.\n    # Let\'s split: input has len(seg_beats) boundaries. Output should split each interval into n_segments subintervals.\n    # So between input[i] and input[i+1], there are n_segments-1 new boundaries added.\n    # Total = len(seg_beats) + (len(seg_beats)-1)*(n_segments-1) = n_segments*len(seg_beats) - n_segments + 1\n    n_int = len(seg_beats) - 1\n    expected = n_int * n_segments - n_segments + 1\n    print(\'coarse\', c[\'index\'], \'seg_beats:\', seg_beats, \'sub_bounds:\', sub_bounds, \'expected:\', expected)\n    # Walk through intervals\n    all_bounds = list(sub_bounds)\n    idx = 0\n    for interval_i in range(n_int):\n        # take n_segments+1 boundaries: start, n_segments-1 interior, end\n        # But end of interval i == start of interval i+1\n        # To extract exactly 3 sub-segments per interval, we want to read n_segments boundaries that include end of last\n        # Actually let\'s just collect 3 boundaries per sub-seg \n        # sub-seg j in [0..2]: boundary[j] to boundary[j+1]\n        # 4 boundaries per interval (start, two interior, end)\n        # Let\'s check sizes: if each interval is split into 3, we have 4 boundaries per interval\n        # but adjacent intervals share a boundary. So total = (n_int)*(n_segments+1) - (n_int-1) = n_int*n_segments + 1\n        # That\'s what we expect\n        b_sub = all_bounds[idx:idx+n_segments+1]\n        idx += n_segments\n        if len(b_sub) < n_segments+1:\n            break\n        # build 3 sub-segments\n        for j in range(n_segments):\n            sf = int(b_sub[j])\n            ef = int(b_sub[j+1])\n            # sanity: must be within coarse\n            if sf < c[\'start_frame\']: sf = c[\'start_frame\']\n            if ef > c[\'end_frame\']: ef = c[\'end_frame\']\n            start_t = float(librosa.frames_to_time(np.array([sf]), sr=sr, hop_length=HOP)[0])\n            end_t = float(librosa.frames_to_time(np.array([ef]), sr=sr, hop_length=HOP)[0])\n            fine_segments.append({\'start_frame\': sf, \'end_frame\': ef, \'start\': start_t, \'end\': end_t, \'parent_index\': c[\'index\']})\n\n# Clamp last fine segment of each coarse to coarse end\nfor c in coarse_segments:\n    children = [f for f in fine_segments if f[\'parent_index\'] == c[\'index\']]\n    if not children:\n        continue\n    # first start clamp to coarse start\n    if abs(children[0][\'start\'] - c[\'start\']) > 0.001:\n        children[0][\'start\'] = c[\'start\']\n        children[0][\'start_frame\'] = c[\'start_frame\']\n    # last end clamp to coarse end\n    children[-1][\'end\'] = c[\'end\']\n    children[-1][\'end_frame\'] = c[\'end_frame\']\n    # adjust interior adjacency: ensure prev.end == next.start frame\n    for k in range(1, len(children)):\n        if children[k][\'start_frame\'] != children[k-1][\'end_frame\']:\n            children[k][\'start_frame\'] = children[k-1][\'end_frame\']\n            children[k][\'start\'] = children[k-1][\'end\']\n\n# Build final json\ncoarse_out = [{\'index\': c[\'index\'], \'start\': c[\'start\'], \'end\': c[\'end\']} for c in coarse_segments]\nfine_sorted = sorted(fine_segments, key=lambda x: x[\'start\'])\nfine_out = []\nfor i, f in enumerate(fine_sorted):\n    fine_out.append({\'index\': i, \'start\': f[\'start\'], \'end\': f[\'end\'], \'parent_index\': f[\'parent_index\']})\n\nresult = {\'coarse\': coarse_out, \'fine\': fine_out}\n\nwith open(\'/home/user/hierarchy.json\', \'w\') as f:\n    json.dump(result, f, indent=2)\n\nprint(json.dumps(result, indent=2))\nPYEOF\n'] min_timeout_sec: 0.2 max_timeout_sec: 180.0
