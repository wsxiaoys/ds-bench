eleteTask(ctx context.Context, id int64) error {\n\\tres, err := taskdb.Exec(ctx, `DELETE FROM tasks WHERE id = $1`, id)\n\\tif err != nil {\n\\t\\treturn err\n\\t}\n\\tif n, err := res.RowsAffected(); err != nil {\n\\t\\treturn err\n\\t} else if n == 0 {\n\\t\\treturn &errNotFound{fmt.Sprintf("task %d not found", id)}\n\\t}\n\\treturn nil\n}\n\ntype errNotFound struct{ msg string }\n\nfunc (e *errNotFound) Error() string { return e.msg }\n\'\'\'\n\nprint(len(code))\nprint(repr(code[:500]))\nPYEOF\n'] min_timeout_sec: 0.3 max_timeout_sec: 180.0
