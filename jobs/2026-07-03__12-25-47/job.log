Sending keys: ['cat > run.py << \'PYEOF\'\nimport json\nfrom datetime import datetime, timedelta\nfrom pathlib import Path\nfrom typing import Any, Dict, Iterable, Tuple\n\nfrom bytewax import operators as op\nfrom bytewax.connectors.files import FileSource\nfrom bytewax.dataflow import Dataflow\nfrom bytewax.operators import StatefulLogic\nfrom bytewax.outputs import StatelessSinkPartition, DynamicSink\nfrom bytewax.testing import run_main\nfrom typing_extensions import override\n\nWINDOW = timedelta(seconds=10)\n\n\ndef parse_ts(s) -> datetime:\n    """Parse an ISO 8601 timestamp string into a tz-aware datetime."""\n    if isinstance(s, datetime):\n        return s\n    if s.endswith("Z"):\n        s = s[:-1] + "+00:00"\n    return datetime.fromisoformat(s)\n\n\ndef fmt_ts(ts: datetime) -> str:\n    """Render a datetime back to an ISO 8601 string with trailing `Z`."""\n    if ts.tzinfo is not None:\n        ts = ts.astimezone(tz=ts.tzinfo).replace(microsecond=0)\n        return ts.isoformat().replace("+00:00", "Z")\n    return ts.isoformat()\n\n\nclass DedupLogic(StatefulLogic[Dict[str, Any], Dict[str, Any], Dict[str, datetime]]):\n    """Per-user_id event-id deduplication over a sliding 10s window."""\n\n    def __init__(self, resume_state):\n        # `state` maps `event_id` -> last emitted timestamp (datetime).\n        self._state: Dict[str, datetime] = dict(resume_state) if resume_state else {}\n\n    def on_item(\n        self, value: Dict[str, Any]\n    ) -> Tuple[Iterable[Dict[str, Any]], bool]:\n        event_id = value["event_id"]\n        ts = parse_ts(value["timestamp"])\n\n        # Clean up state: any event_id older than the window relative to\n        # the current event\'s timestamp is removed.\n        stale = [\n            eid for eid, last_ts in self._state.items()\n            if ts - last_ts > WINDOW\n        ]\n        for eid in stale:\n            del self._state[eid]\n\n        # Deduplication check: if the same event_id was seen within the\n        # last 10 seconds (inclusive of exactly 10s), drop.\n        prev_ts = self._state.get(event_id)\n        if prev_ts is not None and ts <= prev_ts + WINDOW:\n            return (iter(()), StatefulLogic.RETAIN)\n\n        # Otherwise emit and (re)start the 10-second window for this\n        # event_id.\n        self._state[event_id] = ts\n        return (iter((value,)), StatefulLogic.RETAIN)\n\n    def snapshot(self) -> Dict[str, datetime]:\n        # Must return an effectively immutable copy.\n        return dict(self._state)\n\n\ndef build_logic(resume_state):\n    return DedupLogic(resume_state)\n\n\nclass _JsonlSinkPartition(StatelessSinkPartition[str]):\n    def __init__(self, path: Path):\n        self._path = path\n        self._items: list = []\n\n    @override\n    def write_batch(self, items) -> None:\n        # Buffer everything; we\'ll sort then write on close.\n        self._items.extend(items)\n\n    @override\n    def close(self) -> None:\n        # Preserve input order using the embedded sequence number, then\n        # drop the sequence number field and dump to JSONL.\n        def _key(item):\n            return item["__seq"]\n\n        self._items.sort(key=_key)\n        with self._path.open("wt") as f:\n            for item in self._items:\n                item.pop("__seq", None)\n                f.write(json.dumps(item))\n                f.write("\\n")\n\n\nclass JsonlSink(DynamicSink[str]):\n    """Custom Sink that buffers items, sorts them by a sequence number,\n    and writes them as JSON lines to a single file."""\n\n    def __init__(self, path):\n        self._path = path\n\n    @override\n    def build(self, step_id, worker_index, worker_count):\n        return _JsonlSinkPartition(Path(self._path))\n\n\ndef build_flow(input_path, output_path) -> Dataflow:\n    flow = Dataflow("stateful_dedup")\n\n    # 1) Read raw lines.\n    lines = op.input("input", flow, FileSource(str(input_path)))\n\n    # 2) Parse JSON, attach a sequence number to preserve input order.\n    counter = {"i": 0}\n\n    def _parse_with_seq(line):\n        event = json.loads(line)\n        event["__seq"] = counter["i"]\n        counter["i"] += 1\n        return event\n\n    parsed = op.map("parse_json", lines, _parse_with_seq)\n\n    # 3) Key by user_id so state is maintained per user.\n    keyed = op.key_on("key_user", parsed, lambda e: e["user_id"])\n\n    # 4) Apply stateful deduplication.\n    deduped = op.stateful("dedup", keyed, build_logic)\n\n    # 5) Drop key and serialize. The deduped stream is keyed (user_id, event).\n    def _to_json(item):\n        user_id, event = item\n        out = dict(event)\n        ts = out["timestamp"]\n        if isinstance(ts, datetime):\n            out["timestamp"] = fmt_ts(ts)\n        return out\n\n    events = op.map("to_dict", deduped, _to_json)\n\n    # 6) Write out (the custom sink handles sequencing + JSONL serialization).\n    op.output("output", events, JsonlSink(output_path))\n\n    return flow\n\n\nif __name__ == "__main__":\n    run_main(build_flow(Path("input.jsonl"), Path("output.jsonl")))\nPYEOF\n'] min_timeout_sec: 0.5 max_timeout_sec: 180.0
