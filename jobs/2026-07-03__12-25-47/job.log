Sending keys: ['cat > run.py << \'EOF\'\n#!/usr/bin/env python3\n"""Tumbling Window OHLCV Aggregation using Bytewax."""\n\nimport argparse\nimport json\nfrom datetime import datetime, timedelta, timezone\nfrom pathlib import Path\n\nfrom bytewax.connectors.files import CSVSource, FileSink\nfrom bytewax.dataflow import Dataflow\nimport bytewax.operators as op\nfrom bytewax.operators.windowing import EventClock, TumblingWindower, fold_window\nfrom bytewax.run import cli_main\n\n\ndef parse_iso8601(ts: str) -> datetime:\n    """Parse an ISO 8601 timestamp string to a timezone-aware datetime."""\n    # Handle trailing \'Z\' (Zulu/UTC) by converting to +00:00\n    if ts.endswith("Z"):\n        ts = ts[:-1] + "+00:00"\n    dt = datetime.fromisoformat(ts)\n    if dt.tzinfo is None:\n        dt = dt.replace(tzinfo=timezone.utc)\n    return dt\n\n\ndef build_flow(input_path: Path, output_path: Path) -> Dataflow:\n    """Build the Bytewax dataflow for OHLCV aggregation."""\n    flow = Dataflow("ohlcv_1min")\n\n    # Read CSV file\n    csv_source = CSVSource(input_path)\n    inp = op.input("csv_in", flow, csv_source)\n\n    # Parse each row into (symbol, price, volume, timestamp_dt)\n    parsed = op.map("parse", inp, lambda row: {\n        "symbol": row["symbol"],\n        "price": float(row["price"]),\n        "volume": float(row["volume"]),\n        "timestamp": parse_iso8601(row["timestamp"]),\n    })\n\n    # Key the stream by symbol\n    keyed = op.key_on("key_symbol", parsed, lambda x: x["symbol"])\n\n    # Define the event-time clock using the trade timestamp\n    clock = EventClock(\n        ts_getter=lambda x: x["timestamp"],\n        wait_for_system_duration=timedelta(seconds=0),\n    )\n\n    # Define a 1-minute tumbling window aligned to the minute boundary\n    windower = TumblingWindower(\n        length=timedelta(minutes=1),\n        align_to=datetime(1970, 1, 1, 0, 0, 0, tzinfo=timezone.utc),\n    )\n\n    # Fold OHLCV state for each window. The accumulator is a dict holding:\n    #   open: first trade price seen\n    #   high: max trade price\n    #   low: min trade price\n    #   close: last trade price seen\n    #   volume: sum of trade volumes\n    #   timestamp: latest trade timestamp seen (used for window_start)\n    def builder():\n        return {\n            "open": None,\n            "high": None,\n            "low": None,\n            "close": None,\n            "volume": 0.0,\n            "timestamp": None,\n        }\n\n    def folder(acc, trade):\n        if acc["open"] is None:\n            acc["open"] = trade["price"]\n            acc["high"] = trade["price"]\n            acc["low"] = trade["price"]\n        else:\n            if trade["price"] > acc["high"]:\n                acc["high"] = trade["price"]\n            if trade["price"] < acc["low"]:\n                acc["low"] = trade["price"]\n        acc["close"] = trade["price"]\n        acc["volume"] += trade["volume"]\n        acc["timestamp"] = trade["timestamp"]\n        return acc\n\n    def merger(a, b):\n        # If either side is empty, return the other\n        if a["open"] is None:\n            return b\n        if b["open"] is None:\n            return a\n        # Both have data: open is the earliest, close is the latest.\n        # The downstream folder will pass items in order when ordered=True,\n        # but we still handle the merger defensively.\n        return {\n            "open": a["open"],\n            "high": max(a["high"], b["high"]),\n            "low": min(a["low"], b["low"]),\n            "close": b["close"],\n            "volume": a["volume"] + b["volume"],\n            "timestamp": b["timestamp"],\n        }\n\n    windowed = fold_window(\n        "ohlcv_fold",\n        keyed,\n        clock,\n        windower,\n        builder=builder,\n        folder=folder,\n        merger=merger,\n    )\n\n    # Format the windowed output to JSONL strings\n    # windowed.down emits items shaped as: (symbol, (window_id, (open_time, acc)))\n    def format_output(item):\n        symbol, (window_id, (window_start_dt, acc)) = item\n        record = {\n            "window_start": window_start_dt.strftime("%Y-%m-%dT%H:%M:%SZ"),\n            "symbol": symbol,\n            "open": acc["open"],\n            "high": acc["high"],\n            "low": acc["low"],\n            "close": acc["close"],\n            "volume": acc["volume"],\n        }\n        return json.dumps(record)\n\n    formatted = op.map("format", windowed.down, format_output)\n\n    # Write to a JSONL file\n    out_sink = FileSink(output_path)\n    op.output("jsonl_out", formatted, out_sink)\n\n    return flow\n\n\ndef main():\n    parser = argparse.ArgumentParser(\n        description="Tumbling Window OHLCV Aggregation using Bytewax"\n    )\n    parser.add_argument(\n        "--input",\n        required=True,\n        type=Path,\n        help="Path to input CSV file with columns: timestamp,symbol,price,volume",\n    )\n    parser.add_argument(\n        "--output",\n        required=True,\n        type=Path,\n        help="Path to output JSONL file",\n    )\n    args = parser.parse_args()\n\n    flow = build_flow(args.input, args.output)\n    cli_main(flow)\n\n\nif __name__ == "__main__":\n    main()\nEOF\n'] min_timeout_sec: 0.2 max_timeout_sec: 180.0
