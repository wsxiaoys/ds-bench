Sending keys: ['cat > hello/graphql.ts << \'EOF\'\nimport { api } from "encore.dev/api";\nimport {\n  GraphQLSchema,\n  GraphQLObjectType,\n  GraphQLString,\n  graphql,\n} from "graphql";\n\nconsole.log("LOAD");\n\nconst schema = new GraphQLSchema({\n  query: new GraphQLObjectType({\n    name: "Query",\n    fields: {\n      hello: {\n        type: GraphQLString,\n        args: {\n          name: { type: GraphQLString },\n        },\n        resolve: (_root: unknown, args: { name?: string | null }) => {\n          const name = args.name ?? "World";\n          return `Hello, ${name}!`;\n        },\n      },\n    },\n  }),\n});\n\nasync function readBody(req: any): Promise<string> {\n  console.log("reading body");\n  return new Promise((resolve, reject) => {\n    const chunks: Buffer[] = [];\n    req.on("data", (chunk: Buffer) => chunks.push(chunk));\n    req.on("end", () => resolve(Buffer.concat(chunks).toString("utf8")));\n    req.on("error", reject);\n  });\n}\n\nexport const graphql = api.raw(\n  { expose: true, method: "*", path: "/graphql" },\n  async (req: any, resp: any) => {\n    console.log("HANDLER ENTRY", req.method, req.url);\n    try {\n      let query = "";\n      let operationName: string | null | undefined;\n      let variables: Record<string, unknown> | undefined;\n\n      if (req.method === "GET") {\n        const url = new URL(req.url ?? "/graphql", "http://localhost");\n        query = url.searchParams.get("query") ?? "";\n        operationName = url.searchParams.get("operationName");\n        const variablesParam = url.searchParams.get("variables");\n        if (variablesParam) {\n          variables = JSON.parse(variablesParam);\n        }\n      } else {\n        const body = await readBody(req);\n        console.log("BODY:", body);\n        const contentType = (req.headers["content-type"] ?? "") as string;\n        if (contentType.includes("application/graphql")) {\n          query = body;\n        } else {\n          const payload = JSON.parse(body) as {\n            query?: string;\n            operationName?: string | null;\n            variables?: Record<string, unknown>;\n          };\n          query = payload.query ?? "";\n          operationName = payload.operationName ?? undefined;\n          variables = payload.variables ?? undefined;\n        }\n      }\n\n      console.log("QUERY:", query);\n\n      if (!query) {\n        resp.statusCode = 400;\n        resp.setHeader("Content-Type", "application/json");\n        resp.end(JSON.stringify({ errors: [{ message: "Missing query" }] }));\n        return;\n      }\n\n      const result = await graphql({\n        schema,\n        source: query,\n        variableValues: variables,\n        operationName,\n      });\n      console.log("RESULT:", JSON.stringify(result));\n\n      resp.statusCode = 200;\n      resp.setHeader("Content-Type", "application/json");\n      resp.end(JSON.stringify(result));\n    } catch (err) {\n      console.log("ERROR:", err);\n      const message = err instanceof Error ? err.message : String(err);\n      resp.statusCode = 400;\n      resp.setHeader("Content-Type", "application/json");\n      resp.end(JSON.stringify({ errors: [{ message }] }));\n    }\n  }\n);\nEOF\n'] min_timeout_sec: 0.3 max_timeout_sec: 180.0
