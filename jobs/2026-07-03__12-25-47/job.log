ps.containsKey(code)) {\n                        try {\n                            localeProps.put(code, loadProps(localeResourcePath(code)));\n                        } catch (Exception ex) {\n                            localeProps.put(code, new Properties());\n                        }\n                    }\n                    if ("en".equals(code)) {\n                        activeLocaleProps = baseProps;\n                    } else {\n                        activeLocaleProps = localeProps.get(code);\n                    }\n                } else if ("GET".equals(cmd)) {\n                    if (tokens.length < 2) {\n                        System.err.println("Error: missing key ");\n                        localExit = 1;\n                        break;\n                    }\n                    String key = tokens[1];\n                    if (activeBundle == null) {\n                        System.err.println("Error: no locale selected");\n                        localExit = 1;\n                        break;\n                    }\n                    if (!activeLocaleProps.containsKey(key) && !baseProps.containsKey(key)) {\n                        System.err.println("Error: missing key " + key);\n                        localExit = 1;\n                        break;\n                    }\n                    String value = activeBundle.get(key);\n                    System.out.println(key + "=" + value);\n                } else if ("FORMAT".equals(cmd)) {\n                    if (tokens.length < 2) {\n                        System.err.println("Error: missing key ");\n                        localExit = 1;\n                        break;\n                    }\n                    String key = tokens[1];\n                    if (activeBundle == null) {\n                        System.err.println("Error: no locale selected");\n                        localExit = 1;\n                        break;\n                    }\n                    if (!activeLocaleProps.containsKey(key) && !baseProps.containsKey(key)) {\n                        System.err.println("Error: missing key " + key);\n                        localExit = 1;\n                        break;\n                    }\n                    int argCount = tokens.length - 2;\n                    Object[] args = new Object[argCount];\n                    for (int i = 0; i < argCount; i++) {\n                        args[i] = tokens[2 + i];\n                    }\n                    String value = activeBundle.format(key, args);\n                    System.out.println(key + "=" + value);\n                } else {\n                    System.err.println("Error: unknown command " + cmd);\n                    localExit = 1;\n                    break;\n                }\n            }\n        } catch (Exception e) {\n            System.err.println("Error: " + e.getMessage());\n            localExit = 1;\n        }\n\n        exitCode = localExit;\n        finished = true;\n    }\n\n    @Override\n    public void render() {\n    }\n\n    @Override\n    public void resize(int width, int height) {\n    }\n\n    @Override\n    public void pause() {\n    }\n\n    @Override\n    public void resume() {\n    }\n\n    @Override\n    public void dispose() {\n    }\n}\nJAVAEOF\n'] min_timeout_sec: 0.3 max_timeout_sec: 180.0
