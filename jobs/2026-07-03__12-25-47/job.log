Sending keys: ['cat > /tmp/segment.py << \'PYEOF\'\nimport json\nimport numpy as np\nimport librosa\nimport librosa.feature\nimport librosa.beat\nimport librosa.segment\n\nHOP = 512\nSR = 22050\nN_SEG = 3\n\n# Load audio\ny, sr = librosa.load(\'/home/user/input.wav\', sr=SR)\nduration = len(y) / float(sr)\n\n# Beat tracking\ntempo, beats = librosa.beat.beat_track(y=y, sr=sr, hop_length=HOP)\nbeats = np.asarray(beats)\nn_beats_total = len(beats)\nprint(\'duration:\', duration, \'tempo:\', tempo, \'beats:\', n_beats_total)\n\n# Chroma CQT\nchroma = librosa.feature.chroma_cqt(y=y, sr=sr, hop_length=HOP)\n\n# Beat-synchronous chroma\nsync_chroma = librosa.util.sync(chroma, beats)\n\n# Coarse segmentation with k in [4,8]\n# Try k values that yield well-balanced segments (no degenerate initial segment)\nbest_k = None\nbest_bounds = None\nbest_score = -np.inf\nfor k_candidate in range(4, 9):\n    b_cand = np.asarray(librosa.segment.agglomerative(sync_chroma, k_candidate))\n    # Evaluate: avoid short segments; require at least 3 beats between boundaries\n    diffs = np.diff(np.concatenate([b_cand, [n_beats_total - 1]]))\n    min_diff = int(diffs.min())\n    # We need each interval to have enough beats for subsegment to yield 3 sub-segments\n    # If an interval has few beats (< 4), it will fall back to even split\n    score = -min_diff\n    if min_diff < 2:\n        score -= 100\n    print(f\'k={k_candidate} bounds={b_cand.tolist()} diffs={diffs.tolist()} min_diff={min_diff}\')\n    if score > best_score:\n        best_score = score\n        best_k = k_candidate\n        best_bounds = b_cand\n\nk = best_k\nbounds = best_bounds\nprint(\'chosen k=\', k, \'bounds=\', bounds)\n\ntotal_frames = chroma.shape[1]\nprint(\'chroma shape:\', chroma.shape, \'total_frames:\', total_frames)\n\n# Build coarse segments\ncoarse_segments = []\nfor i in range(len(bounds)):\n    bi_start = int(bounds[i])\n    if i + 1 < len(bounds):\n        end_frame = int(beats[bounds[i+1]])\n    else:\n        end_frame = total_frames\n    # Start frame: if first segment, use 0; else use beats[bi_start]\n    if i == 0:\n        start_frame = 0\n    else:\n        start_frame = int(beats[bi_start])\n    start_t = float(librosa.frames_to_time(np.array([start_frame]), sr=sr, hop_length=HOP)[0])\n    end_t = float(librosa.frames_to_time(np.array([end_frame]), sr=sr, hop_length=HOP)[0])\n    coarse_segments.append({\'index\': i, \'start_frame\': start_frame, \'end_frame\': end_frame, \'start\': start_t, \'end\': end_t})\n\n# Ensure last segment ends at duration\ncoarse_segments[-1][\'end_frame\'] = total_frames\ncoarse_segments[-1][\'end\'] = duration\n\n# Ensure coarse segments are contiguous: segment[i].end_frame == segment[i+1].start_frame\nfor i in range(len(coarse_segments) - 1):\n    coarse_segments[i+1][\'start_frame\'] = coarse_segments[i][\'end_frame\']\n    coarse_segments[i+1][\'start\'] = coarse_segments[i][\'end\']\n\nprint(\'coarse segments:\', coarse_segments)\n\n# Subsegment each coarse segment into 3 sub-segments\n# We always use 4 evenly-spaced beat-aligned boundaries per coarse segment when possible,\n# falling back to frame-based boundaries for short segments.\nfine_segments = []\nfor c in coarse_segments:\n    # Find beat frames within this coarse segment\n    seg_beats = beats[(beats >= c[\'start_frame\']) & (beats < c[\'end_frame\'])]\n    if len(seg_beats) < 2:\n        # No beats inside; we\'ll just use evenly spaced frame boundaries\n        children = []\n        for j in range(N_SEG):\n            sf = c[\'start_frame\'] + (c[\'end_frame\'] - c[\'start_frame\']) * j // N_SEG\n            ef = c[\'start_frame\'] + (c[\'end_frame\'] - c[\'start_frame\']) * (j + 1) // N_SEG\n            start_t = float(librosa.frames_to_time(np.array([sf]), sr=sr, hop_length=HOP)[0])\n            end_t = float(librosa.frames_to_time(np.array([ef]), sr=sr, hop_length=HOP)[0])\n            children.append({\'start_frame\': sf, \'end_frame\': ef, \'start\': start_t, \'end\': end_t, \'parent_index\': c[\'index\']})\n    else:\n        # Use seg_beats as input boundaries for subsegment\n        sub_bounds = librosa.segment.subsegment(chroma, seg_beats, n_segments=N_SEG)\n        sub_bounds = np.asarray(sub_bounds)\n        n_int = len(seg_beats) - 1\n        # Walk: take n_segments+1 boundaries per interval\n        # interval 0 uses idx 0..n_seg, interval 1 uses idx n_seg..2n_seg, etc.\n        # Total expected length: n_int * n_seg + 1\n        children = []\n        all_b = sub_bounds.tolist()\n        expected_len = n_int * N_SEG + 1\n        if len(all_b) < expected_len:\n            # Some intervals may have been degraded due to too few frames.\n            # In that case, the boundaries might be fewer.\n            pass\n        # Just use the structure: n_seg boundaries per interval (sharing endpoints)\n        idx = 0\n        # The pattern: bounds = [b0, int_0_1, int_0_2, b1, int_1_1, int_1_2, b2, ...]\n        # For each interval i, subsegments are pairs: (b[i*n_seg + j], b[i*n_seg + j+1]) for j=0..n_seg-1\n        # So need n_seg+1 boundaries per interval: from idx i*n_seg to (i+1)*n_seg inclusive (n_seg+1 entries)\n        for interval_i in range(n_int):\n            start_idx = interval_i * N_SEG\n            end_idx = start_idx + N_SEG + 1\n            if end_idx > len(all_b):\n                end_idx = len(all_b)\n            b_sub = all_b[start_idx:end_idx]\n            # pad if needed\n            while len(b_sub) < N_SEG + 1:\n                b_sub.append(c[\'end_frame\'])\n            # truncate if too many (shouldn\'t happen)\n            if len(b_sub) > N_SEG + 1:\n                b_sub = b_sub[:N_SEG + 1]\n            for j in range(N_SEG):\n                sf = int(b_sub[j])\n                ef = int(b_sub[j+1])\n                if sf < c[\'start_frame\']: sf = c[\'start_frame\']\n                if ef > c[\'end_frame\']: ef = c[\'end_frame\']\n                if ef <= sf:\n                    ef = sf + 1\n                start_t = float(librosa.frames_to_time(np.array([sf]), sr=sr, hop_length=HOP)[0])\n                end_t = float(librosa.frames_to_time(np.array([ef]), sr=sr, hop_length=HOP)[0])\n                children.append({\'start_frame\': sf, \'end_frame\': ef, \'start\': start_t, \'end\': end_t, \'parent_index\': c[\'index\']})\n        if len(children) != N_SEG:\n            # Fall back to even split\n            children = []\n            for j in range(N_SEG):\n                sf = c[\'start_frame\'] + (c[\'end_frame\'] - c[\'start_frame\']) * j // N_SEG\n                ef = c[\'start_frame\'] + (c[\'end_frame\'] - c[\'start_frame\']) * (j + 1) // N_SEG\n                start_t = float(librosa.frames_to_time(np.array([sf]), sr=sr, hop_length=HOP)[0])\n                end_t = float(librosa.frames_to_time(np.array([ef]), sr=sr, hop_length=HOP)[0])\n                children.append({\'start_frame\': sf, \'end_frame\': ef, \'start\': start_t, \'end\': end_t, \'parent_index\': c[\'index\']})\n\n    fine_segments.extend(children)\n\n# Ensure each coarse segment\'s children cover it exactly: first.start = c.start, last.end = c.end\n# and adjacency\nfor c in coarse_segments:\n    children = [f for f in fine_segments if f[\'parent_index\'] == c[\'index\']]\n    children.sort(key=lambda x: x[\'start_frame\'])\n    children[0][\'start_frame\'] = c[\'start_frame\']\n    children[0][\'start\'] = c[\'start\']\n    children[-1][\'end_frame\'] = c[\'end_frame\']\n    children[-1][\'end\'] = c[\'end\']\n    # Make adjacent children share boundary\n    for k in range(1, len(children)):\n        children[k][\'start_frame\'] = children[k-1][\'end_frame\']\n        children[k][\'start\'] = children[k-1][\'end\']\n    # Ensure each child has minimum duration (>0.1s i.e. > ~4-5 frames at hop=512 and sr=22050: 0.1s = 4.3 frames)\n    for k in range(len(children)):\n        min_frames = int(np.ceil(0.1 * sr / HOP)) + 1  # at least 5 frames for >0.1s\n        if children[k][\'end_frame\'] - children[k][\'start_frame\'] < min_frames:\n            # Steal from next if exists\n            if k + 1 < len(children) and children[k+1][\'end_frame\'] - children[k+1][\'start_frame\'] > min_frames:\n                steal = min_frames - (children[k][\'end_frame\'] - children[k][\'start_frame\'])\n                children[k][\'end_frame\'] += steal\n                children[k][\'end\'] = float(librosa.frames_to_time(np.array([children[k][\'end_frame\']]), sr=sr, hop_length=HOP)[0])\n                children[k+1][\'start_frame\'] = children[k][\'end_frame\']\n                children[k+1][\'start\'] = children[k][\'end\']\n            elif k - 1 >= 0 and children[k-1][\'end_frame\'] - children[k-1][\'start_frame\'] > min_frames:\n                steal = min_frames - (children[k][\'end_frame\'] - children[k][\'start_frame\'])\n                children[k][\'start_frame\'] -= steal\n                children[k][\'start\'] = float(librosa.frames_to_time(np.array([children[k][\'start_frame\']]), sr=sr, hop_length=HOP)[0])\n                children[k-1][\'end_frame\'] = children[k][\'start_frame\']\n                children[k-1][\'end\'] = children[k][\'start\']\n\n# Verify each coarse segment has exactly 3 fine segments\nfor c in coarse_segments:\n    n_children = sum(1 for f in fine_segments if f[\'parent_index\'] == c[\'index\'])\n    if n_children != N_SEG:\n        print(f\'WARNING: coarse {c["index"]} has {n_children} fine segments\')\n\n# Build final json\ncoarse_out = [{\'index\': c[\'index\'], \'start\': round(float(c[\'start\']), 6), \'end\': round(float(c[\'end\']), 6)} for c in coarse_segments]\n# Sort fine by start time globally\nfine_sorted = sorted(fine_segments, key=lambda x: x[\'start\'])\nfine_out = []\nfor i, f in enumerate(fine_sorted):\n    fine_out.append({\'index\': i, \'start\': round(float(f[\'start\']), 6), \'end\': round(float(f[\'end\']), 6), \'parent_index\': int(f[\'parent_index\'])})\n\nresult = {\'coarse\': coarse_out, \'fine\': fine_out}\n\nwith open(\'/home/user/hierarchy.json\', \'w\') as f:\n    json.dump(result, f, indent=2)\n\nprint(json.dumps(result, indent=2))\nPYEOF\n'] min_timeout_sec: 0.2 max_timeout_sec: 180.0
