Sending keys: ['cat > /root/project/src/worker.tsx << \'WORKEREOF\'\nimport { defineApp } from "rwsdk/worker";\nimport { route } from "rwsdk/router";\nimport { env } from "cloudflare:workers";\n\nexport { ServerEntry, Document } from "./Document";\n\nasync function sha256Hex(bytes: Uint8Array): Promise<string> {\n  const digest = await crypto.subtle.digest("SHA-256", bytes);\n  const hashArray = Array.from(new Uint8Array(digest));\n  return hashArray.map((b) => b.toString(16).padStart(2, "0")).join("");\n}\n\nfunction getExtension(filename: string): string {\n  const dot = filename.lastIndexOf(".");\n  if (dot <= 0 || dot === filename.length - 1) return "";\n  return filename.slice(dot + 1);\n}\n\nfunction jsonResponse(data: unknown, status = 200): Response {\n  return new Response(JSON.stringify(data), {\n    status,\n    headers: { "content-type": "application/json" },\n  });\n}\n\nfunction getBucket(): R2Bucket {\n  return env.BUCKET as unknown as R2Bucket;\n}\n\nexport default defineApp([\n  // POST /api/files - upload a file\n  route("/api/files", {\n    post: async ({ request }) => {\n      let form: FormData;\n      try {\n        form = await request.formData();\n      } catch {\n        return jsonResponse({ error: "Invalid form data" }, 400);\n      }\n      const file = form.get("file");\n      if (!file || typeof file === "string") {\n        return jsonResponse({ error: "Missing \'file\' field" }, 400);\n      }\n      // file is a File\n      const filename = file.name || "";\n      const ext = getExtension(filename);\n      const arrayBuffer = await file.arrayBuffer();\n      const bytes = new Uint8Array(arrayBuffer);\n      const sha256 = await sha256Hex(bytes);\n      const key = ext ? `uploads/${sha256}.${ext}` : `uploads/${sha256}`;\n\n      const contentType = file.type || "application/octet-stream";\n\n      await getBucket().put(key, bytes, {\n        httpMetadata: {\n          contentType,\n        },\n        customMetadata: {\n          originalFilename: filename,\n          sha256,\n        },\n      });\n\n      return jsonResponse(\n        {\n          key,\n          size: bytes.byteLength,\n          contentType,\n          sha256,\n        },\n        201,\n      );\n    },\n\n    // GET /api/files - list all files\n    get: async () => {\n      const objects: Array<{\n        key: string;\n        size: number;\n        uploaded: string;\n      }> = [];\n      let cursor: string | undefined = undefined;\n      // R2 list requires the prefix to end with `/` if provided\n      while (true) {\n        const result = await getBucket().list({\n          prefix: "uploads/",\n          cursor,\n        });\n        for (const obj of result.objects) {\n          objects.push({\n            key: obj.key,\n            size: obj.size,\n            uploaded: obj.uploaded.toISOString(),\n          });\n        }\n        if (!result.truncated || !result.cursor) break;\n        cursor = result.cursor;\n      }\n      return jsonResponse({ objects });\n    },\n  }),\n\n  // GET /api/files/:key - retrieve a file\n  route("/api/files/:key", {\n    get: async ({ params }) => {\n      const key = decodeURIComponent(params.key as string);\n      const obj = await getBucket().get(key);\n      if (!obj) {\n        return jsonResponse({ error: "Not found" }, 404);\n      }\n      const body = await obj.arrayBuffer();\n      const headers = new Headers();\n      const contentType =\n        obj.httpMetadata?.contentType || "application/octet-stream";\n      headers.set("content-type", contentType);\n      headers.set("content-length", String(obj.size));\n      return new Response(body, { status: 200, headers });\n    },\n\n    // DELETE /api/files/:key - delete a file\n    delete: async ({ params }) => {\n      const key = decodeURIComponent(params.key as string);\n      // Check existence first to return 404 if not present\n      const obj = await getBucket().get(key);\n      if (!obj) {\n        return jsonResponse({ error: "Not found" }, 404);\n      }\n      await getBucket().delete(key);\n      return new Response(null, { status: 204 });\n    },\n  }),\n]);\nWORKEREOF\necho \'Created worker.tsx\'\n'] min_timeout_sec: 0.2 max_timeout_sec: 180.0
