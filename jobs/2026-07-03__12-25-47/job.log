Sending keys: ["cat > query.js << 'EOF'\nconst fs = require('fs');\nconst { Company, Department, Employee, Project, EmployeeProject, sequelize } = require('./models');\n\n(async () => {\n  try {\n    // Sync all models (drop existing tables for a clean seed)\n    await sequelize.sync({ force: true });\n\n    // Seed sample data\n    const techCorp = await Company.create({ name: 'TechCorp' });\n    const otherCo = await Company.create({ name: 'OtherCo' });\n\n    const engineering = await Department.create({ name: 'Engineering', CompanyId: techCorp.id });\n    const marketing = await Department.create({ name: 'Marketing', CompanyId: techCorp.id });\n    const sales = await Department.create({ name: 'Sales', CompanyId: otherCo.id });\n\n    const alice = await Employee.create({ name: 'Alice', DepartmentId: engineering.id });\n    const bob = await Employee.create({ name: 'Bob', DepartmentId: engineering.id });\n    const carol = await Employee.create({ name: 'Carol', DepartmentId: marketing.id });\n\n    const projA = await Project.create({ name: 'Project Alpha', status: 'active' });\n    const projB = await Project.create({ name: 'Project Beta', status: 'active' });\n    const projC = await Project.create({ name: 'Project Gamma', status: 'inactive' });\n\n    // Use unscoped Project to create assignments involving inactive project\n    const ProjectUnscoped = Project.unscoped();\n    await alice.addProject(projA, { through: { role: 'Lead' } });\n    await alice.addProject(projC, { through: { role: 'Helper' } }); // inactive - should be filtered out by default scope\n    await bob.addProject(projB, { through: { role: 'Developer' } });\n    await carol.addProject(projA, { through: { role: 'Coordinator' } });\n\n    // Query: Find TechCorp, eagerly loading divisions -> staff -> assignments\n    const company = await Company.findOne({\n      where: { name: 'TechCorp' },\n      include: [{\n        association: 'divisions',\n        include: [{\n          association: 'staff',\n          include: [{\n            association: 'assignments'\n          }]\n        }]\n      }]\n    });\n\n    const result = company.toJSON();\n    fs.writeFileSync('output.json', JSON.stringify(result, null, 2));\n    console.log('Wrote output.json');\n    console.log(JSON.stringify(result, null, 2));\n  } catch (err) {\n    console.error('Error:', err);\n    process.exit(1);\n  } finally {\n    await sequelize.close();\n  }\n})();\nEOF\n"] min_timeout_sec: 0.1 max_timeout_sec: 180.0
