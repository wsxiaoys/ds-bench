Sending keys: ['cat > /home/user/bytewax_recovery/dataflow.py << \'PYEOF\'\n"""Bytewax dataflow that maintains running maximum per key with recovery."""\n\nimport csv\nfrom pathlib import Path\nfrom typing import List, Optional\n\nfrom bytewax.connectors.files import FileSink\nfrom bytewax.dataflow import Dataflow\nfrom bytewax.inputs import FixedPartitionedSource, StatefulSourcePartition\nimport bytewax.operators as op\n\n\nclass _CsvPartition(StatefulSourcePartition[dict, int]):\n    def __init__(self, path: Path, resume_state: Optional[int]):\n        self._path = path\n        self._f = open(path, "rt", newline="")\n        self._reader = csv.DictReader(self._f)\n        self._consumed = 0\n        if resume_state is not None:\n            for _ in range(resume_state):\n                try:\n                    next(self._reader)\n                    self._consumed += 1\n                except StopIteration:\n                    break\n\n    def next_batch(self) -> List[dict]:\n        batch = []\n        try:\n            while True:\n                row = next(self._reader)\n                batch.append(row)\n        except StopIteration:\n            pass\n        self._consumed += len(batch)\n        return batch\n\n    def snapshot(self) -> int:\n        return self._consumed\n\n    def close(self) -> None:\n        try:\n            self._f.close()\n        except Exception:\n            pass\n\n\nclass CsvSource(FixedPartitionedSource[dict, int]):\n    """CSV file source. The partition key is the file path, so a different\n    input file across resumes is naturally handled."""\n\n    def __init__(self, path):\n        self._path = Path(path)\n\n    def list_parts(self) -> List[str]:\n        if self._path.exists():\n            return [str(self._path)]\n        return []\n\n    def build_part(self, step_id: str, for_part: str, resume_state: Optional[int]):\n        return _CsvPartition(Path(for_part), resume_state)\n\n\ndef _running_max(state, item):\n    value = int(item["value"])\n    if state is None:\n        new_state = value\n    elif state >= value:\n        new_state = state\n    else:\n        new_state = value\n    return (new_state, new_state)\n\n\ndef build_flow(input_file: str, output_file: str) -> Dataflow:\n    flow = Dataflow("running_max_recovery")\n    inp = CsvSource(input_file)\n    s = op.input("in", flow, inp)\n    keyed = op.key_on("key", s, lambda item: item["key"])\n    maxed = op.stateful_map("running_max", keyed, _running_max)\n    formatted = op.map_value("format", maxed, lambda v: f"{v}")\n\n    def to_pair(kv):\n        return f"{kv[0]},{kv[1]}"\n\n    paired = op.map("pair", formatted, to_pair)\n    op.output("out", paired, FileSink(Path(output_file)))\n    return flow\nPYEOF\n'] min_timeout_sec: 0.3 max_timeout_sec: 180.0
