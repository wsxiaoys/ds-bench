Sending keys: ['cat > /home/user/myproject/solution.py << \'PYEOF\'\n"""\nCross-lingual semantic search using Cohere\'s embed-multilingual-v3.0 and LanceDB.\n"""\nimport os\nimport json\nimport pathlib\nimport numpy as np\n\nimport cohere\nimport lancedb\nimport pyarrow as pa\n\n# ---------------------------------------------------------------------------\n# Paths / config\n# ---------------------------------------------------------------------------\nPROJECT_DIR = pathlib.Path("/home/user/myproject")\nCORPUS_PATH = PROJECT_DIR / "corpus.json"\n\nRUN_ID_PATH = pathlib.Path("/logs/artifacts/run-id")\nif RUN_ID_PATH.exists():\n    RUN_ID = RUN_ID_PATH.read_text().strip()\nelse:\n    RUN_ID = "default"\n\nDB_DIR = PROJECT_DIR / "lancedb_data"\nDB_DIR.mkdir(parents=True, exist_ok=True)\n\nTABLE_NAME = f"multilingual_{RUN_ID}"\n\nCOHERE_MODEL = "embed-multilingual-v3.0"\nVECTOR_DIM = 1024\n\n# ---------------------------------------------------------------------------\n# Lazy singletons\n# ---------------------------------------------------------------------------\n_client = None\n_db = None\n_table = None\n_built = False\n\n\ndef _get_client() -> cohere.Client:\n    global _client\n    if _client is None:\n        api_key = os.environ.get("COHERE_API_KEY")\n        if not api_key:\n            raise RuntimeError("COHERE_API_KEY is not set")\n        _client = cohere.Client(api_key=api_key)\n    return _client\n\n\ndef _get_db() -> lancedb.DBConnection:\n    global _db\n    if _db is None:\n        _db = lancedb.connect(str(DB_DIR))\n    return _db\n\n\ndef _schema():\n    """Return an Arrow schema with a fixed-size 1024-d float32 list for vectors."""\n    return pa.schema(\n        [\n            pa.field("concept_id", pa.int32()),\n            pa.field("language", pa.string()),\n            pa.field("text", pa.string()),\n            pa.field("vector", pa.list_(pa.float32(), VECTOR_DIM)),\n        ]\n    )\n\n\ndef _extract_embeddings(response) -> list:\n    """Pull a list of embedding vectors out of a Cohere embed response."""\n    emb = getattr(response, "embeddings", None)\n    if isinstance(emb, list) and len(emb) > 0 and not isinstance(emb[0], (list, tuple)):\n        # Possibly an EmbeddingsByType object exposing .float / .float_\n        if hasattr(emb, "float_"):\n            emb = emb.float_\n        elif hasattr(emb, "float"):\n            emb = emb.float\n    # Some versions put vectors under embeddings.float_\n    if hasattr(emb, "float_"):\n        emb = emb.float_\n    elif hasattr(emb, "float"):\n        emb = emb.float\n    return [list(map(float, v)) for v in emb]\n\n\ndef build_index() -> None:\n    """Read the corpus, embed every text with Cohere, and persist to LanceDB."""\n    global _table, _built\n\n    if _built:\n        return\n\n    # Load corpus\n    with open(CORPUS_PATH, "r", encoding="utf-8") as f:\n        rows = json.load(f)\n    if not isinstance(rows, list):\n        raise ValueError("corpus.json must contain a list of rows")\n\n    texts = [r["text"] for r in rows]\n    languages = [r["language"] for r in rows]\n    concept_ids = [int(r["concept_id"]) for r in rows]\n\n    co = _get_client()\n\n    # Embed documents with the proper input type.\n    # Cohere accepts up to 96 texts per call and we have 90, so a single call works,\n    # but we still batch defensively.\n    all_vectors: list[list[float]] = []\n    batch_size = 96\n    for start in range(0, len(texts), batch_size):\n        batch = texts[start : start + batch_size]\n        resp = co.embed(\n            texts=batch,\n            model=COHERE_MODEL,\n            input_type="search_document",\n        )\n        all_vectors.extend(_extract_embeddings(resp))\n\n    # Convert to float32 numpy arrays (and verify dim) for storage.\n    arrays: list[np.ndarray] = []\n    for v in all_vectors:\n        arr = np.asarray(v, dtype=np.float32)\n        if arr.shape[0] != VECTOR_DIM:\n            raise ValueError(\n                f"unexpected embedding dim {arr.shape[0]}, expected {VECTOR_DIM}"\n            )\n        arrays.append(arr)\n\n    # Build records for LanceDB.\n    records = [\n        {\n            "concept_id": np.int32(concept_ids[i]),\n            "language": languages[i],\n            "text": texts[i],\n            "vector": arrays[i],\n        }\n        for i in range(len(texts))\n    ]\n\n    db = _get_db()\n\n    # Drop existing table if rerun in same dir.\n    try:\n        if TABLE_NAME in db.table_names():\n            db.drop_table(TABLE_NAME)\n    except Exception:\n        pass\n\n    tbl = db.create_table(TABLE_NAME, data=records, schema=_schema(), mode="overwrite")\n\n    # Make sure a vector index exists (helps recall and speed for top-k).\n    try:\n        tbl.create_index(num_partitions=1, num_sub_vectors=16, metric="cosine")\n    except Exception:\n        # Index creation is optional; an exact search will still work.\n        pass\n\n    _table = tbl\n    _built = True\n\n\ndef _ensure_table():\n    global _table\n    if _table is not None:\n        return _table\n    db = _get_db()\n    # If the verifier previously called build_index, the table should exist.\n    names = db.table_names()\n    if TABLE_NAME in names:\n        _table = db.open_table(TABLE_NAME)\n        return _table\n    # Otherwise build it lazily.\n    build_index()\n    return _table\n\n\ndef cross_lingual_search(query: str, k: int = 3) -> list[dict]:\n    """Embed ``query`` and return the top-k documents across all three languages."""\n    if not isinstance(query, str):\n        raise TypeError("query must be a string")\n    if not isinstance(k, int) or k <= 0:\n        raise ValueError("k must be a positive int")\n\n    tbl = _ensure_table()\n\n    co = _get_client()\n    resp = co.embed(\n        texts=[query],\n        model=COHERE_MODEL,\n        input_type="search_query",\n    )\n    vecs = _extract_embeddings(resp)\n    qvec = np.asarray(vecs[0], dtype=np.float32)\n    if qvec.shape[0] != VECTOR_DIM:\n        raise ValueError(\n            f"unexpected query embedding dim {qvec.shape[0]}, expected {VECTOR_DIM}"\n        )\n\n    # Search across all languages (no filter), sorted by ascending distance.\n    results = (\n        tbl.search(qvec.tolist())\n        .metric("cosine")\n        .limit(k)\n        .to_pandas()\n    )\n\n    out: list[dict] = []\n    for _, row in results.iterrows():\n        out.append(\n            {\n                "concept_id": int(row["concept_id"]),\n                "language": str(row["language"]),\n                "text": str(row["text"]),\n            }\n        )\n    return out\n\n\nif __name__ == "__main__":  # quick smoke test when run directly\n    build_index()\n    hits = cross_lingual_search("Where is the Eiffel Tower?", k=3)\n    for h in hits:\n        print(h)\nPYEOF\n'] min_timeout_sec: 0.2 max_timeout_sec: 180.0
