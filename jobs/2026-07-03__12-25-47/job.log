lorRect or c is Polygon2D:\n                    has_visual = true\n            if not has_visual:\n                failures.append(child.name + " missing visual placeholder")\n    \n    if rigid_body_count != 6:\n        failures.append("expected 6 RigidBody2D, got " + str(rigid_body_count))\n    \n    # Check pin joints\n    var pin_count := 0\n    var pin_pairs: Array = []\n    for child in root.get_children():\n        if child is PinJoint2D:\n            pin_count += 1\n            var pj: PinJoint2D = child\n            var a_node: Node = pj.get_node_or_null(pj.node_a)\n            var b_node: Node = pj.get_node_or_null(pj.node_b)\n            if a_node == null:\n                failures.append("PinJoint " + child.name + " node_a doesn\'t resolve")\n            elif not (a_node is RigidBody2D):\n                failures.append("PinJoint " + child.name + " node_a is not RigidBody2D")\n            if b_node == null:\n                failures.append("PinJoint " + child.name + " node_b doesn\'t resolve")\n            elif not (b_node is RigidBody2D):\n                failures.append("PinJoint " + child.name + " node_b is not RigidBody2D")\n            if a_node and b_node:\n                pin_pairs.append([String(a_node.name), String(b_node.name)])\n    \n    if pin_count != 5:\n        failures.append("expected 5 PinJoint2D, got " + str(pin_count))\n    \n    var required_pairs := [\n        ["Head", "Torso"],\n        ["LeftArm", "Torso"],\n        ["RightArm", "Torso"],\n        ["LeftLeg", "Torso"],\n        ["RightLeg", "Torso"],\n    ]\n    for rp in required_pairs:\n        var found := false\n        for pp in pin_pairs:\n            if (pp[0] == rp[0] and pp[1] == rp[1]) or (pp[0] == rp[1] and pp[1] == rp[0]):\n                found = true\n                break\n        if not found:\n            failures.append("missing pin joint " + str(rp))\n    \n    # Check methods on root\n    var ragdoll: Ragdoll = root as Ragdoll\n    if ragdoll == null:\n        failures.append("root is not Ragdoll instance")\n    else:\n        # Check signal exists\n        if not ragdoll.has_signal("ragdoll_collapsed"):\n            failures.append("missing ragdoll_collapsed signal")\n        \n        # Check methods\n        if not ragdoll.has_method("apply_impulse_to"):\n            failures.append("missing apply_impulse_to method")\n        if not ragdoll.has_method("freeze_all"):\n            failures.append("missing freeze_all method")\n        if not ragdoll.has_method("get_part"):\n            failures.append("missing get_part method")\n        if not ragdoll.has_method("get_average_position"):\n            failures.append("missing get_average_position method")\n    \n    if failures.is_empty():\n        print("ALL CHECKS PASSED")\n    else:\n        print("FAILURES:")\n        for f in failures:\n            print("  - ", f)\n    \n    quit()\nEOF\n'] min_timeout_sec: 0.1 max_timeout_sec: 180.0
