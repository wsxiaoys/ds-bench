Sending keys: ['cat > /home/user/segment.py << \'PYEOF\'\nimport json\nimport numpy as np\nimport librosa\nfrom sklearn.cluster import AgglomerativeClustering\n\nAUDIO_PATH = \'/home/user/input.wav\'\nOUT_PATH = \'/home/user/segments.json\'\n\n# --- Load audio ---\ny, sr = librosa.load(AUDIO_PATH, sr=22050, mono=True)\nduration = float(len(y) / sr)\n\n# --- Beat tracking ---\nonset_env = librosa.onset.onset_strength(y=y, sr=sr)\ntempo, beat_frames = librosa.beat.beat_track(onset_envelope=onset_env, sr=sr)\nbeat_times = librosa.frames_to_time(beat_frames, sr=sr)\nprint(f\'tempo={tempo} n_beats={len(beat_frames)} duration={duration}\')\n\n# --- Tonal feature (chroma_cqt) ---\nchroma = librosa.feature.chroma_cqt(y=y, sr=sr)\n# Beat-synchronous aggregation\nchroma_sync = librosa.util.sync(chroma, beat_frames, aggregate=np.median)\n\n# --- Recurrence / self-similarity ---\nR = librosa.segment.recurrence_matrix(\n    chroma_sync,\n    mode=\'affinity\',\n    metric=\'cosine\',\n    sparse=False,\n)\nn = chroma_sync.shape[1]\nn_seg_path = max(2, int(np.ceil(n / 7.0)))\nR_path = librosa.segment.path_enhance(R, n_seg_path)\n\n# --- Sequential / local affinity ---\nseq = np.zeros((n, n), dtype=np.float64)\nband = 7\nfor i in range(n):\n    lo = max(0, i - band)\n    hi = min(n, i + band + 1)\n    d = np.abs(np.arange(lo, hi) - i)\n    seq[i, lo:hi] = np.exp(-(d ** 2) / (2.0 * (band / 2.0) ** 2))\n\n# Combine repetition (path-enhanced) with sequential affinity\nalpha = 0.5\nA = alpha * R_path + (1.0 - alpha) * seq\nnp.fill_diagonal(A, 1.0)\nA = 0.5 * (A + A.T)\n\n# --- Symmetric normalized graph Laplacian ---\ndeg = A.sum(axis=1)\nwith np.errstate(divide=\'ignore\'):\n    d_inv_sqrt = np.where(deg > 0, 1.0 / np.sqrt(deg), 0.0)\nD_inv_sqrt = np.diag(d_inv_sqrt)\nL = np.eye(n) - D_inv_sqrt @ A @ D_inv_sqrt\n\n# Bottom K eigenvectors (smallest eigenvalues), skip first trivial\nK = 5\neigvals, eigvecs = np.linalg.eigh(L)\nidx_sort = np.argsort(eigvals)\neigvals = eigvals[idx_sort]\neigvecs = eigvecs[:, idx_sort]\nemb = eigvecs[:, 1:K+1]\nrow_norm = np.linalg.norm(emb, axis=1, keepdims=True)\nrow_norm = np.where(row_norm > 0, row_norm, 1.0)\nemb_norm = emb / row_norm\n\n# --- Cluster per-beat embeddings ---\n# Use agglomerative clustering on the embedding to get section labels per beat\nn_label_types = 3\nper_beat_labels = AgglomerativeClustering(\n    n_clusters=n_label_types, metric=\'euclidean\', linkage=\'average\'\n).fit_predict(emb_norm)\nprint(\'per_beat_labels (first 30):\', per_beat_labels[:30])\nprint(\'label counts:\', np.bincount(per_beat_labels))\n\n# --- Derive contiguous segments from runs of same label ---\nruns = []\ni = 0\nwhile i < n:\n    j = i\n    while j < n and per_beat_labels[j] == per_beat_labels[i]:\n        j += 1\n    runs.append((i, j, per_beat_labels[i]))\n    i = j\nprint(\'initial runs:\', runs)\n\n# Merge tiny runs (< 3 beats) into neighbor with most similar mean chroma\nwhile True:\n    merged = False\n    for k in range(len(runs)):\n        s, e, lab = runs[k]\n        if (e - s) < 3 and len(runs) > 1:\n            # find best neighbor to merge with\n            this_mean = chroma_sync[:, s:e].mean(axis=1)\n            best = -1\n            best_sim = -np.inf\n            for kk in [k-1, k+1]:\n                if 0 <= kk < len(runs):\n                    ns, ne, nlab = runs[kk]\n                    nm = chroma_sync[:, ns:ne].mean(axis=1)\n                    sim = float(np.dot(this_mean, nm) / (np.linalg.norm(this_mean) * np.linalg.norm(nm) + 1e-12))\n                    if sim > best_sim:\n                        best_sim = sim\n                        best = kk\n            if best == k - 1:\n                # merge into previous\n                ps, pe, plab = runs[k-1]\n                runs[k-1] = (ps, e, plab)\n                del runs[k]\n            elif best == k + 1:\n                # merge into next\n                ns, ne, nlab = runs[k+1]\n                runs[k] = (s, ne, nlab)\n                del runs[k+1]\n            else:\n                # fallback: merge into previous\n                ps, pe, plab = runs[k-1]\n                runs[k-1] = (ps, e, plab)\n                del runs[k]\n            merged = True\n            break\n    if not merged:\n        break\nprint(\'after tiny merge:\', runs)\n\n# Map numeric labels to uppercase letters in order of first appearance\nletters_per_run = []\nseen = {}\nfor (s, e, lab) in runs:\n    if lab not in seen:\n        seen[lab] = chr(ord(\'A\') + len(seen))\n    letters_per_run.append(seen[lab])\nprint(\'letters:\', letters_per_run)\n\n# --- Build time intervals ---\nsegments = []\nfor (s, e, lab), letter in zip(runs, letters_per_run):\n    if e > s:\n        t_start = float(beat_times[s])\n        if e < n:\n            t_end = float(beat_times[e])\n        else:\n            t_end = duration\n        segments.append({\'start\': t_start, \'end\': t_end, \'label\': letter})\n\n# Snap first start to 0 and last end to duration\nsegments[0][\'start\'] = 0.0\nsegments[-1][\'end\'] = duration\n\n# Merge adjacent segments with same label\nmerged = []\nfor seg in segments:\n    if merged and merged[-1][\'label\'] == seg[\'label\']:\n        merged[-1][\'end\'] = seg[\'end\']\n    else:\n        merged.append(dict(seg))\n\n# Drop / merge segments shorter than 0.5s\nfinal = []\nfor seg in merged:\n    dur = seg[\'end\'] - seg[\'start\']\n    if dur <= 0.5:\n        if final:\n            final[-1][\'end\'] = seg[\'end\']\n        else:\n            seg[\'start\'] = 0.0\n            final.append(seg)\n    else:\n        final.append(seg)\n\n# Bridge large gaps / overlaps\nfor i in range(1, len(final)):\n    gap = final[i][\'start\'] - final[i-1][\'end\']\n    if gap > 0.3:\n        mid = (final[i-1][\'end\'] + final[i][\'start\']) / 2.0\n        final[i-1][\'end\'] = mid\n        final[i][\'start\'] = mid\n    elif gap < -0.05:\n        mid = (final[i-1][\'end\'] + final[i][\'start\']) / 2.0\n        final[i-1][\'end\'] = mid\n        final[i][\'start\'] = mid\n\n# Recheck min duration\nfinal = [s for s in final if (s[\'end\'] - s[\'start\']) > 0.5]\n\n# Reassign labels in order of appearance\nrenamed = []\nlabel_map = {}\nfor s in final:\n    if s[\'label\'] not in label_map:\n        label_map[s[\'label\']] = chr(ord(\'A\') + len(label_map))\n    renamed.append({\'start\': float(s[\'start\']), \'end\': float(s[\'end\']), \'label\': label_map[s[\'label\']]})\n\nrenamed.sort(key=lambda x: x[\'start\'])\n\nprint(\'FINAL SEGMENTS:\')\nfor s in renamed:\n    print(f"  {s[\'start\']:.3f} -> {s[\'end\']:.3f}  {s[\'label\']}  (dur={s[\'end\']-s[\'start\']:.3f})")\n\nwith open(OUT_PATH, \'w\') as f:\n    json.dump(renamed, f, indent=2)\nprint(\'Wrote\', OUT_PATH)\nPYEOF\necho done\n'] min_timeout_sec: 0.3 max_timeout_sec: 180.0
