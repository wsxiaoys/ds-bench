Sending keys: ['cat > /home/user/turn-based-game/core/src/main/java/game/TurnBasedGame.java << \'EOF\'\npackage game;\n\nimport com.badlogic.gdx.ApplicationListener;\nimport com.badlogic.gdx.Gdx;\nimport com.badlogic.gdx.Input;\nimport com.badlogic.gdx.files.FileHandle;\n\nimport java.io.BufferedWriter;\nimport java.io.IOException;\nimport java.io.OutputStreamWriter;\nimport java.io.PrintStream;\nimport java.nio.charset.StandardCharsets;\nimport java.util.ArrayList;\nimport java.util.List;\n\n/**\n * Turn-based dungeon crawler core. Drives one turn per render tick, consuming a single\n * command from the scripted input, mutating the world, and appending a line to the transcript.\n */\npublic class TurnBasedGame implements ApplicationListener {\n\n    private FileHandle mapHandle;\n    private FileHandle transcriptHandle;\n    private ScriptedMockInput scriptedInput;\n\n    // World state\n    private int width;\n    private int height;\n    private int playerX;\n    private int playerY;\n    private final List<Item> items = new ArrayList<Item>();\n    private final List<String> inventory = new ArrayList<String>();\n\n    // Loop state\n    private int turn = 0;\n    private boolean shouldExit = false;\n    private boolean firstTick = true;\n\n    public TurnBasedGame(FileHandle mapHandle,\n                         FileHandle transcriptHandle,\n                         ScriptedMockInput scriptedInput) {\n        this.mapHandle = mapHandle;\n        this.transcriptHandle = transcriptHandle;\n        this.scriptedInput = scriptedInput;\n    }\n\n    @Override\n    public void create() {\n        loadMap(mapHandle);\n    }\n\n    /** Loads the map file using libGDX FileHandle parsing. */\n    private void loadMap(FileHandle handle) {\n        String content = handle.readString("UTF-8");\n        List<String> tokens = new ArrayList<String>();\n        for (String line : content.split("\\n")) {\n            // Strip comments; ignore blank lines; keep tokens inside useful lines.\n            int hashIdx = line.indexOf(\'#\');\n            if (hashIdx >= 0) line = line.substring(0, hashIdx);\n            line = line.trim();\n            if (line.isEmpty()) continue;\n            for (String tok : line.split("\\\\s+")) {\n                if (!tok.isEmpty()) tokens.add(tok);\n            }\n        }\n        if (tokens.size() < 4) {\n            throw new IllegalArgumentException("Map file too small: " + tokens.size() + " tokens");\n        }\n        int idx = 0;\n        width = parseInt(tokens.get(idx++));\n        height = parseInt(tokens.get(idx++));\n        playerX = parseInt(tokens.get(idx++));\n        playerY = parseInt(tokens.get(idx++));\n        int itemCount = parseInt(tokens.get(idx++));\n        items.clear();\n        for (int i = 0; i < itemCount; i++) {\n            if (idx + 2 >= tokens.size()) break;\n            int ix = parseInt(tokens.get(idx++));\n            int iy = parseInt(tokens.get(idx++));\n            String name = tokens.get(idx++);\n            items.add(new Item(ix, iy, name));\n        }\n    }\n\n    private static int parseInt(String s) {\n        try { return Integer.parseInt(s); }\n        catch (NumberFormatException nfe) {\n            throw new IllegalArgumentException("Not an integer: \'" + s + "\'", nfe);\n        }\n    }\n\n    @Override\n    public void render() {\n        // Drive the scripted input on every tick.\n        scriptedInput.tick();\n\n        if (firstTick) {\n            firstTick = false;\n            // Wait until the first real command before writing any turn lines.\n            if (!scriptedInput.hasCommand()) {\n                // No commands at all: write FINAL and exit.\n                finish();\n                return;\n            }\n        }\n\n        if (!scriptedInput.hasCommand()) {\n            finish();\n            return;\n        }\n\n        String raw = scriptedInput.getCurrentCommand();\n        turn++;\n        applyCommand(raw);\n        writeTurnLine(raw);\n\n        if (shouldExit || raw.equals("QUIT")) {\n            finish();\n            return;\n        }\n        // Loop ends when command file is exhausted: scriptedInput.hasCommand() is false next tick.\n    }\n\n    /** Mutate world state based on the raw command and current input key state. */\n    private void applyCommand(String raw) {\n        // First handle the known movement and action keys via MockInput.\n        if (Gdx.input.isKeyJustPressed(Input.Keys.UP)) {\n            tryMove(0, 1);\n            return;\n        }\n        if (Gdx.input.isKeyJustPressed(Input.Keys.DOWN)) {\n            tryMove(0, -1);\n            return;\n        }\n        if (Gdx.input.isKeyJustPressed(Input.Keys.RIGHT)) {\n            tryMove(1, 0);\n            return;\n        }\n        if (Gdx.input.isKeyJustPressed(Input.Keys.LEFT)) {\n            tryMove(-1, 0);\n            return;\n        }\n        if (Gdx.input.isKeyJustPressed(Input.Keys.SPACE)) {\n            pickUp();\n            return;\n        }\n        if (Gdx.input.isKeyJustPressed(Input.Keys.ESCAPE)) {\n            shouldExit = true;\n            return;\n        }\n        // Unknown command: no state change.\n    }\n\n    private void tryMove(int dx, int dy) {\n        int nx = playerX + dx;\n        int ny = playerY + dy;\n        if (nx < 0 || nx >= width || ny < 0 || ny >= height) {\n            // Rejected: stay in place.\n            return;\n        }\n        playerX = nx;\n        playerY = ny;\n    }\n\n    /** Pick the earliest-defined item at the current cell; remove from world; add to inventory. */\n    private void pickUp() {\n        for (int i = 0; i < items.size(); i++) {\n            Item it = items.get(i);\n            if (it.x == playerX && it.y == playerY) {\n                inventory.add(it.name);\n                items.remove(i);\n                return;\n            }\n        }\n        // No item here: no-op.\n    }\n\n    /** Append a turn line to the transcript using FileHandle.appendString. */\n    private void writeTurnLine(String raw) {\n        StringBuilder sb = new StringBuilder(32);\n        sb.append("turn=").append(turn)\n          .append(" cmd=").append(raw)\n          .append(" pos=").append(playerX).append(\',\').append(playerY)\n          .append(" inv=");\n        for (int i = 0; i < inventory.size(); i++) {\n            if (i > 0) sb.append(\',\');\n            sb.append(inventory.get(i));\n        }\n        sb.append(\'\\n\');\n        appendToTranscript(sb.toString());\n    }\n\n    /** Append the FINAL line and call {@link Gdx#app#exit()}. */\n    private void finish() {\n        StringBuilder sb = new StringBuilder(32);\n        sb.append("FINAL pos=").append(playerX).append(\',\').append(playerY).append(" inv=");\n        for (int i = 0; i < inventory.size(); i++) {\n            if (i > 0) sb.append(\',\');\n            sb.append(inventory.get(i));\n        }\n        sb.append(" turns=").append(turn).append(\'\\n\');\n        appendToTranscript(sb.toString());\n        // Allow the next render tick to actually exit the headless loop cleanly.\n        Gdx.app.exit();\n    }\n\n    /**\n     * All transcript appends use libGDX FileHandle so the file is flushed via the\n     * Gdx.files subsystem. We accumulate into a single string and write atomically at the end.\n     */\n    private final StringBuilder transcriptBuf = new StringBuilder();\n\n    private void appendToTranscript(String line) {\n        transcriptBuf.append(line);\n    }\n\n    /** Called when the application is exiting so the final state is flushed. */\n    @Override\n    public void dispose() {\n        // Write the transcript in one shot to avoid partial writes being visible.\n        transcriptHandle.writeString(transcriptBuf.toString(), false, "UTF-8");\n    }\n\n    @Override\n    public void pause() { }\n\n    @Override\n    public void resize(int width, int height) { }\n\n    @Override\n    public void resume() { }\n\n    /** A world item with absolute coordinates (lower-left origin). */\n    private static final class Item {\n        final int x;\n        final int y;\n        final String name;\n        Item(int x, int y, String name) {\n            this.x = x;\n            this.y = y;\n            this.name = name;\n        }\n    }\n}\nEOF\n'] min_timeout_sec: 0.1 max_timeout_sec: 180.0
