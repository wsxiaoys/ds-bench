Sending keys: ['cat > run.py << \'PYEOF\'\n"""Bytewax stateful deduplication over a sliding 10-second window.\n\nReads events from `input.jsonl`, groups by `user_id`, deduplicates per\n`(user_id, event_id)` pair using a 10-second time window (inclusive at\nexactly 10s), and writes the surviving events to `output.jsonl` in the\noriginal relative order.\n"""\n\nimport json\nfrom datetime import datetime, timedelta\nfrom pathlib import Path\nfrom typing import Any, Dict, Iterable, Tuple\n\nfrom bytewax import operators as op\nfrom bytewax.connectors.files import FileSource\nfrom bytewax.dataflow import Dataflow\nfrom bytewax.operators import StatefulLogic\nfrom bytewax.outputs import DynamicSink, StatelessSinkPartition\nfrom bytewax.testing import run_main\nfrom typing_extensions import override\n\nWINDOW = timedelta(seconds=10)\n\n\ndef _parse_ts(s: Any) -> datetime:\n    """Parse an ISO 8601 timestamp string into a tz-aware `datetime`."""\n    if isinstance(s, datetime):\n        return s\n    if s.endswith("Z"):\n        s = s[:-1] + "+00:00"\n    return datetime.fromisoformat(s)\n\n\nclass DedupLogic(\n    StatefulLogic[Dict[str, Any], Dict[str, Any], Dict[str, datetime]]\n):\n    """Per-user_id event-id deduplication with a sliding 10s window.\n\n    State is a mapping `event_id -> last_emitted_datetime` for the\n    current `user_id`. On every event:\n\n      1. Any `event_id` whose stored timestamp is older than 10 seconds\n         from the current event\'s timestamp is dropped from the state\n         so memory cannot grow without bound.\n      2. If the same `event_id` was emitted within the last 10 seconds\n         (inclusive of exactly 10s, i.e. `ts <= last + 10s`), the new\n         event is dropped.\n      3. Otherwise the event is emitted and the 10-second window is\n         restarted for that `event_id`.\n    """\n\n    def __init__(self, resume_state):\n        # Map of event_id -> last emitted timestamp (datetime).\n        self._state: Dict[str, datetime] = (\n            dict(resume_state) if resume_state else {}\n        )\n\n    def on_item(\n        self, value: Dict[str, Any]\n    ) -> Tuple[Iterable[Dict[str, Any]], bool]:\n        event_id = value["event_id"]\n        ts = _parse_ts(value["timestamp"])\n\n        # 1) Drop entries outside the sliding window (strictly older than\n        #    10s from the current event\'s timestamp).\n        stale = [\n            eid for eid, last_ts in self._state.items()\n            if ts - last_ts > WINDOW\n        ]\n        for eid in stale:\n            del self._state[eid]\n\n        # 2) Deduplication check against the freshly-cleared state.\n        prev_ts = self._state.get(event_id)\n        if prev_ts is not None and ts <= prev_ts + WINDOW:\n            # Duplicate within the window (or exactly at the boundary).\n            return (iter(()), StatefulLogic.RETAIN)\n\n        # 3) Emit and (re)start the 10-second window for this event_id.\n        self._state[event_id] = ts\n        return (iter((value,)), StatefulLogic.RETAIN)\n\n    def snapshot(self) -> Dict[str, datetime]:\n        # Must return an effectively immutable copy.\n        return dict(self._state)\n\n\ndef _build_logic(resume_state):\n    return DedupLogic(resume_state)\n\n\nclass _OrderedJsonlSinkPartition(StatelessSinkPartition[Any]):\n    """Buffers items, then writes them sorted by an embedded sequence\n    number so the resulting JSONL file preserves input ordering.\n    """\n\n    def __init__(self, path: Path) -> None:\n        self._path = path\n        self._items: list = []\n\n    @override\n    def write_batch(self, items) -> None:\n        self._items.extend(items)\n\n    @override\n    def close(self) -> None:\n        self._items.sort(key=lambda it: it["__seq"])\n        with self._path.open("wt") as f:\n            for item in self._items:\n                item.pop("__seq", None)\n                f.write(json.dumps(item))\n                f.write("\\n")\n\n\nclass OrderedJsonlSink(DynamicSink[Any]):\n    """Custom sink that writes a JSONL file while preserving the order\n    of items received from upstream."""\n\n    def __init__(self, path) -> None:\n        self._path = path\n\n    @override\n    def build(self, step_id, worker_index, worker_count):\n        return _OrderedJsonlSinkPartition(Path(self._path))\n\n\ndef build_flow(input_path, output_path) -> Dataflow:\n    flow = Dataflow("stateful_dedup")\n\n    # 1) Read raw lines from the input file.\n    lines = op.input("input", flow, FileSource(str(input_path)))\n\n    # 2) Parse each JSON line into a dict, attaching a sequence number\n    #    used later to recover input ordering after the keyed/stateful\n    #    step (which may interleave keys across workers).\n    counter = {"i": 0}\n\n    def _parse_with_seq(line):\n        event = json.loads(line)\n        event["__seq"] = counter["i"]\n        counter["i"] += 1\n        return event\n\n    parsed = op.map("parse_json", lines, _parse_with_seq)\n\n    # 3) Key by user_id so the per-key state is partitioned per user.\n    keyed = op.key_on("key_user", parsed, lambda event: event["user_id"])\n\n    # 4) Apply stateful deduplication keyed on user_id.\n    deduped = op.stateful("dedup", keyed, _build_logic)\n\n    # 5) Drop the key produced by `stateful` and forward the event dict.\n    unkeyed = op.key_rm("unkey", deduped)\n\n    # 6) Write out as JSONL preserving input order.\n    op.output("output", unkeyed, OrderedJsonlSink(output_path))\n\n    return flow\n\n\nif __name__ == "__main__":\n    run_main(build_flow(Path("input.jsonl"), Path("output.jsonl")))\nPYEOF\n'] min_timeout_sec: 0.5 max_timeout_sec: 180.0
