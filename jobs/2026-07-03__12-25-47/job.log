= new HashMap<>();\n        Properties baseProps;\n        try {\n            baseProps = loadProps("i18n/Messages.properties");\n        } catch (Exception e) {\n            System.err.println("Error: " + e.getMessage());\n            exitCode = 1;\n            finished = true;\n            return;\n        }\n\n        I18NBundle activeBundle = null;\n        Properties activeLocaleProps = null;\n        int localExit = 0;\n        boolean done = false;\n\n        try (BufferedReader reader = new BufferedReader(new FileReader(inputFile))) {\n            String line;\n            while (!done && (line = reader.readLine()) != null) {\n                String trimmed = line.trim();\n                if (trimmed.isEmpty() || trimmed.startsWith("#")) {\n                    continue;\n                }\n                String[] tokens = trimmed.split("\\\\s+");\n                String cmd = tokens[0];\n\n                if ("LOCALE".equals(cmd)) {\n                    if (tokens.length < 2) {\n                        System.err.println("Error: unsupported locale ");\n                        localExit = 1;\n                        done = true;\n                        break;\n                    }\n                    String code = tokens[1];\n                    Locale locale;\n                    switch (code) {\n                        case "en":\n                            locale = new Locale("en");\n                            break;\n                        case "fr":\n                            locale = new Locale("fr");\n                            break;\n                        case "de":\n                            locale = new Locale("de");\n                            break;\n                        default:\n                            System.err.println("Error: unsupported locale " + code);\n                            localExit = 1;\n                            done = true;\n                            continue;\n                    }\n                    activeBundle = I18NBundle.createBundle(baseFile, locale);\n                    if (!localeProps.containsKey(code)) {\n                        try {\n                            localeProps.put(code, loadProps(localeResourcePath(code)));\n                        } catch (Exception ex) {\n                            localeProps.put(code, new Properties());\n                        }\n                    }\n                    if ("en".equals(code)) {\n                        activeLocaleProps = baseProps;\n                    } else {\n                        activeLocaleProps = localeProps.get(code);\n                    }\n                } else if ("GET".equals(cmd)) {\n                    if (tokens.length < 2) {\n                        System.err.println("Error: missing key ");\n                        localExit = 1;\n                        done = true;\n                        break;\n                    }\n                    String key = tokens[1];\n                    if (activeBundle == null) {\n                        System.err.println("Error: no locale selected");\n                        localExit = 1;\n                        done = true;\n                        break;\n                    }\n                    if (!activeLocaleProps.containsKey(key) && !baseProps.containsKey(key)) {\n                        System.err.println("Error: missing key " + key);\n                        localExit = 1;\n                        done = true;\n                        break;\n                    }\n                    String value = activeBundle.get(key);\n                    System.out.println(key + "=" + value);\n                } else if ("FORMAT".equals(cmd)) {\n                    if (tokens.length < 2) {\n                        System.err.println("Error: missing key ");\n                        localExit = 1;\n                        done = true;\n                        break;\n                    }\n                    String key = tokens[1];\n                    if (activeBundle == null) {\n                        System.err.println("Error: no locale selected");\n                        localExit = 1;\n                        done = true;\n                        break;\n                    }\n                    if (!activeLocaleProps.containsKey(key) && !baseProps.containsKey(key)) {\n                        System.err.println("Error: missing key " + key);\n                        localExit = 1;\n                        done = true;\n                        break;\n                    }\n                    int argCount = tokens.length - 2;\n                    Object[] args = new Object[argCount];\n                    for (int i = 0; i < argCount; i++) {\n                        args[i] = tokens[2 + i];\n                    }\n                    String value = activeBundle.format(key, args);\n                    System.out.println(key + "=" + value);\n                } else {\n                    System.err.println("Error: unknown command " + cmd);\n                    localExit = 1;\n                    done = true;\n                    break;\n                }\n            }\n        } catch (Exception e) {\n            System.err.println("Error: " + e.getMessage());\n            localExit = 1;\n        }\n\n        exitCode = localExit;\n        finished = true;\n    }\n\n    @Override\n    public void render() {\n    }\n\n    @Override\n    public void resize(int width, int height) {\n    }\n\n    @Override\n    public void pause() {\n    }\n\n    @Override\n    public void resume() {\n    }\n\n    @Override\n    public void dispose() {\n    }\n}\nJAVAEOF\n'] min_timeout_sec: 0.3 max_timeout_sec: 180.0
