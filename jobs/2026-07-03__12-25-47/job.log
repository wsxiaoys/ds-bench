Sending keys: ["cat > parse.ts << 'EOF'\nimport { LlamaCloud } from '@llamaindex/llama-cloud';\nimport * as fs from 'fs';\nimport * as path from 'path';\n\nasync function main(): Promise<void> {\n  // Create output directory if it doesn't exist\n  const outputDir = path.join(__dirname, 'output');\n  if (!fs.existsSync(outputDir)) {\n    fs.mkdirSync(outputDir, { recursive: true });\n  }\n\n  // Initialize the client. The SDK reads LLAMA_CLOUD_API_KEY from the environment REDACTEDmatically.\n  const client = new LlamaCloud();\n\n  // Upload the PDF file with the correct purpose for a parse job.\n  const fileStream = fs.createReadStream(path.join(__dirname, 'sample.pdf'));\n  const uploadedFile = await client.files.create({\n    file: fileStream as any,\n    purpose: 'parse',\n  });\n  const fileId = uploadedFile.id;\n  console.log(`Uploaded file with ID: ${fileId}`);\n\n  // Run a synchronous parse job (this blocks until the job is COMPLETED).\n  const result = await client.parsing.parse({\n    file_id: fileId,\n    tier: 'cost_effective',\n    version: 'latest',\n    expand: ['markdown'],\n  });\n\n  const jobId = result.job.id;\n  const jobStatus = result.job.status;\n  console.log(`Parse job ID: ${jobId}, status: ${jobStatus}`);\n\n  // Verify the job can be retrieved via client.parsing.get (sanity check).\n  const retrieved = await client.parsing.get(jobId);\n  console.log(`Retrieved job status: ${retrieved.job.status}`);\n\n  // Collect markdown from every page.\n  const pages = result.markdown?.pages ?? [];\n  const pageMarkdownList: string[] = [];\n  for (const page of pages) {\n    if ('markdown' in page && page.success) {\n      pageMarkdownList.push(page.markdown);\n    } else {\n      console.warn(`Page ${page.page_number} failed: ${('error' in page) ? page.error : 'unknown'}`);\n    }\n  }\n  const pageCount = pageMarkdownList.length;\n\n  // Concatenate pages with `---` between them.\n  const combinedMarkdown = pageMarkdownList.join('\\n---\\n');\n\n  // Persist the parsed markdown.\n  const parsedMdPath = path.join(outputDir, 'parsed.md');\n  fs.writeFileSync(parsedMdPath, combinedMarkdown, 'utf8');\n  console.log(`Wrote parsed markdown to ${parsedMdPath}`);\n\n  // Append a human-readable log entry.\n  const logPath = path.join(outputDir, 'result.log');\n  const logLines = [\n    `File ID: ${fileId}`,\n    `Job ID: ${jobId}`,\n    `Job Status: COMPLETED`,\n    `Page Count: ${pageCount}`,\n  ];\n  fs.appendFileSync(logPath, logLines.join('\\n') + '\\n', 'utf8');\n  console.log(`Appended log to ${logPath}`);\n}\n\nmain().catch((err) => {\n  console.error('Error during parsing:', err);\n  process.exit(1);\n});\nEOF\n"] min_timeout_sec: 0.1 max_timeout_sec: 180.0
