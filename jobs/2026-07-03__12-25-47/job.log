Sending keys: ['cat > /home/user/myproject/pb_hooks/rate_limit.pb.js << \'EOF\'\n/// <reference path="../pb_data/types.d.ts" />\n\n// Per-IP rate limiter for user signup endpoint.\n// Limits POST /api/collections/users/records to 3 requests per 60 seconds per IP.\n// On the 4th request within the window, returns 429 with Retry-After header\n// and a JSON body containing a top-level `retryAfter` field.\n\nconst RATE_LIMIT_WINDOW_MS = 60 * 1000;\nconst RATE_LIMIT_MAX = 3;\n\n// IP -> array of request timestamps (ms) in chronological order\nconst rateLimitStore = {};\n\nfunction getClientIp(e) {\n    try {\n        const ip = e.realIP();\n        if (ip) {\n            return ip;\n        }\n    } catch (_) {}\n    try {\n        return e.remoteIP();\n    } catch (_) {\n        return "unknown";\n    }\n}\n\nfunction pruneOldEntries(timestamps, now) {\n    const cutoff = now - RATE_LIMIT_WINDOW_MS;\n    let i = 0;\n    while (i < timestamps.length && timestamps[i] <= cutoff) {\n        i++;\n    }\n    if (i > 0) {\n        timestamps.splice(0, i);\n    }\n}\n\nonRecordCreateRequest((e) => {\n    if (!e.collection || e.collection.name !== "users") {\n        return;\n    }\n\n    const ip = getClientIp(e);\n    const now = Date.now();\n\n    let timestamps = rateLimitStore[ip];\n    if (!timestamps) {\n        timestamps = [];\n        rateLimitStore[ip] = timestamps;\n    }\n\n    pruneOldEntries(timestamps, now);\n\n    if (timestamps.length >= RATE_LIMIT_MAX) {\n        const oldest = timestamps[0];\n        const retryAfterMs = (oldest + RATE_LIMIT_WINDOW_MS) - now;\n        let retryAfterSec = Math.ceil(retryAfterMs / 1000);\n        if (retryAfterSec < 1) {\n            retryAfterSec = 1;\n        }\n\n        // Set the Retry-After header on the underlying response writer\n        e.response.header().set("Retry-After", String(retryAfterSec));\n\n        // Write a 429 JSON response with retryAfter at the top level\n        e.json(429, {\n            status: 429,\n            message: "Too many signup attempts. Please try again later.",\n            retryAfter: retryAfterSec,\n        });\n\n        // Stop processing this request\n        throw new ApiError(429, "stop", {});\n    }\n\n    timestamps.push(now);\n}, "users");\nEOF\n'] min_timeout_sec: 0.1 max_timeout_sec: 180.0
