Sending keys: ['cat > /home/user/myproject/extract.py << \'PYEOF\'\n#!/usr/bin/env python3\n"""Async batch extraction with LlamaCloud v2 SDK."""\nimport asyncio\nimport json\nimport os\nfrom pathlib import Path\nfrom typing import List, Optional\n\nfrom pydantic import BaseModel\nfrom llama_cloud import AsyncLlamaCloud\n\n\nclass LineItem(BaseModel):\n    description: str\n    quantity: Optional[float] = None\n    unit_price: Optional[float] = None\n    amount: Optional[float] = None\n\n\nclass InvoiceSchema(BaseModel):\n    vendor_name: str\n    invoice_number: str\n    total_amount: float\n    line_items: List[str]\n\n\nDATA_DIR = Path("/home/user/myproject/data")\nRESULTS_PATH = Path("/home/user/myproject/results.json")\nLOG_PATH = Path("/home/user/myproject/output.log")\nRUN_ID_PATH = Path("/logs/artifacts/run-id")\n\n\nasync def process_file(\n    client: AsyncLlamaCloud,\n    semaphore: asyncio.Semaphore,\n    filepath: Path,\n    run_id: str,\n):\n    external_file_id = f"{filepath.stem}-{run_id}"\n    async with semaphore:\n        # Upload\n        with open(filepath, "rb") as f:\n            uploaded = await client.files.create(\n                file=f,\n                purpose="extract",\n                external_file_id=external_file_id,\n            )\n\n        file_id = uploaded.id\n\n        # Create extract job\n        job = await client.extract.create(\n            file_input=file_id,\n            configuration={\n                "extraction_target": "per_doc",\n                "tier": "cost_effective",\n                "data_schema": InvoiceSchema.model_json_schema(),\n            },\n        )\n\n        # Poll\n        while True:\n            job = await client.extract.get(job.id)\n            if job.status in ("COMPLETED", "FAILED", "CANCELED"):\n                break\n            await asyncio.sleep(2)\n\n        # Log line\n        with open(LOG_PATH, "a") as logf:\n            logf.write(f"Extract Job: {filepath.name} {job.id} {job.status}\\n")\n\n        record = {}\n        if job.status == "COMPLETED" and getattr(job, "extract_result", None) is not None:\n            er = job.extract_result\n            # try common shapes\n            if isinstance(er, dict):\n                data = er.get("data", er)\n            else:\n                data = er\n            record = {\n                "vendor_name": data.get("vendor_name") if isinstance(data, dict) else None,\n                "invoice_number": data.get("invoice_number") if isinstance(data, dict) else None,\n                "total_amount": data.get("total_amount") if isinstance(data, dict) else None,\n                "line_items": data.get("line_items") if isinstance(data, dict) else [],\n            }\n        else:\n            record = {\n                "vendor_name": None,\n                "invoice_number": None,\n                "total_amount": None,\n                "line_items": [],\n            }\n\n        return filepath.name, record\n\n\nasync def main():\n    run_id = RUN_ID_PATH.read_text().strip()\n    client = AsyncLlamaCloud(api_key=os.environ["LLAMA_CLOUD_API_KEY"])\n    semaphore = asyncio.Semaphore(3)\n\n    files = sorted(DATA_DIR.glob("invoice_*.pdf"))\n    tasks = [process_file(client, semaphore, f, run_id) for f in files]\n    results_list = await asyncio.gather(*tasks)\n\n    results = {name: rec for name, rec in results_list}\n    # If an existing results.json exists, merge - but spec says "persist", so we overwrite\n    RESULTS_PATH.write_text(json.dumps(results, indent=2))\n    print(f"Wrote {RESULTS_PATH}")\n\n\nif __name__ == "__main__":\n    asyncio.run(main())\nPYEOF\n'] min_timeout_sec: 0.2 max_timeout_sec: 180.0
