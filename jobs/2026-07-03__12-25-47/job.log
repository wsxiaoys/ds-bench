Sending keys: ['cat > /home/user/myproject/build_chart.py << \'PYEOF\'\nimport altair as alt\nfrom vega_datasets import data\n\n# ---- Data --------------------------------------------------------------\nmovies_url = data.movies.url        # URL-based source, declared explicitly\nmovies_data = alt.UrlData(movies_url)\n\n# Null-row filters, applied to every view. (Scatter also filters rotten nulls.)\nimdb_not_null = "datum.IMDB_Rating != null"\nrt_not_null = "datum.Rotten_Tomatoes_Rating != null"\n\n# ---- Shared 2D interval brush -------------------------------------------\nbrush = alt.selection_interval(name="brush")\n\n# ---- View A: scatter (brush host) --------------------------------------\n# IMDB rating (x) vs Rotten Tomatoes rating (y).  Points inside the brush\n# are colored by Major_Genre; points outside are flat \'lightgray\'.\nscatter = (\n    alt.Chart(movies_data, title="IMDB vs Rotten Tomatoes")\n    .mark_point(filled=True, size=60, opacity=0.7)\n    .transform_filter(imdb_not_null)\n    .transform_filter(rt_not_null)\n    .encode(\n        x=alt.X("IMDB_Rating:Q", title="IMDB Rating"),\n        y=alt.Y("Rotten_Tomatoes_Rating:Q", title="Rotten Tomatoes Rating"),\n        color=alt.when(brush).then(\n            alt.Color(\n                "Major_Genre:N",\n                legend=alt.Legend(title="Major Genre (inside brush)"),\n            )\n        ).otherwise(alt.value("lightgray")),\n        tooltip=[\n            "Title:N",\n            "Major_Genre:N",\n            "IMDB_Rating:Q",\n            "Rotten_Tomatoes_Rating:Q",\n        ],\n    )\n    .properties(width=600, height=400)\n    .add_params(brush)\n)\n\n# ---- View B: genre bar (top-8 most frequent genres) ---------------------\n# Aggregate -> window-rank -> keep top 8, all done *after* applying the brush.\nbar = (\n    alt.Chart(movies_data, title="Movies by Major Genre (top 8)")\n    .mark_bar()\n    .transform_filter(imdb_not_null)\n    .transform_filter(rt_not_null)\n    .transform_filter(brush)\n    .transform_aggregate(count="count()", groupby=["Major_Genre"])\n    .transform_window(\n        rank="rank(count)",\n        sort=[alt.SortField("count", order="descending")],\n    )\n    .transform_filter("datum.rank <= 8")\n    .encode(\n        x=alt.X("count:Q", title="Number of Movies"),\n        y=alt.Y("Major_Genre:N", sort="-x", title="Major Genre"),\n        color=alt.Color("Major_Genre:N", legend=None),\n        tooltip=["Major_Genre:N", alt.Tooltip("count:Q", title="Movies")],\n    )\n    .properties(width=300, height=200)\n)\n\n# ---- View C: IMDB rating histogram -------------------------------------\nhist = (\n    alt.Chart(movies_data, title="IMDB Rating Distribution")\n    .mark_bar()\n    .transform_filter(imdb_not_null)\n    .transform_filter(rt_not_null)\n    .transform_filter(brush)\n    .encode(\n        x=alt.X(\n            "IMDB_Rating:Q",\n            bin=alt.Bin(maxbins=20),\n            title="IMDB Rating (binned)",\n        ),\n        y=alt.Y("count():Q", title="Number of Movies"),\n        tooltip=[\n            alt.Tooltip("IMDB_Rating:Q", bin=alt.Bin(maxbins=20)),\n            alt.Tooltip("count():Q"),\n        ],\n    )\n    .properties(width=300, height=200)\n)\n\n# ---- Layout -------------------------------------------------------------\n# View A on top; View B and View C side-by-side underneath.\ndashboard = scatter & (bar | hist)\n\ndashboard.save("/home/user/myproject/chart.html")\nprint("Saved dashboard to /home/user/myproject/chart.html")\nPYEOF\n'] min_timeout_sec: 0.2 max_timeout_sec: 180.0
