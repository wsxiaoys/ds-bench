\t\t}\n\n\t\tvar body finalizeRequest\n\t\tif err := e.BindBody(&body); err != nil {\n\t\t\treturn apis.NewBadRequestError("invalid body", err)\n\t\t}\n\t\tkey := strings.TrimSpace(body.Key)\n\t\tif key == "" {\n\t\t\treturn apis.NewBadRequestError("missing key", nil)\n\t\t}\n\n\t\tpendingCol, err := app.Dao().FindCollectionByNameOrId("pending_upload")\n\t\tif err != nil {\n\t\t\treturn apis.NewApiError(500, "pending_upload collection missing", err)\n\t\t}\n\n\t\tpending, err := app.Dao().FindFirstRecordByFilter(pendingCol, "[[key]] = {:key}", map[string]any{"key": key})\n\t\tif err != nil {\n\t\t\treturn apis.NewNotFoundError("pending upload not found", err)\n\t\t}\n\t\tuserVal := pending.Get("user")\n\t\tuserId, _ := userVal.(string)\n\t\tif userId == "" {\n\t\t\treturn apis.NewNotFoundError("pending upload not found", nil)\n\t\t}\n\t\tif userId != rec.Id {\n\t\t\treturn apis.NewNotFoundError("pending upload not found", nil)\n\t\t}\n\n\t\t// HEAD request to verify object exists\n\t\tctx, cancel := context.WithTimeout(context.Background(), 10*time.Second)\n\t\tdefer cancel()\n\t\t_, headErr := s3Client.HeadObject(ctx, &s3.HeadObjectInput{\n\t\t\tBucket: aws.String(cfg.Bucket),\n\t\t\tKey:    aws.String(key),\n\t\t})\n\t\tif headErr != nil {\n\t\t\tvar apiErr smithy.APIError\n\t\t\tif errors.As(headErr, &apiErr) {\n\t\t\t\tif apiErr.ErrorCode() == "NotFound" || apiErr.ErrorCode() == "NoSuchKey" {\n\t\t\t\t\treturn apis.NewNotFoundError("object not found", headErr)\n\t\t\t\t}\n\t\t\t}\n\t\t\t// Network or other errors => also treat as not found to avoid leaking object info\n\t\t\treturn apis.NewNotFoundError("object not found", headErr)\n\t\t}\n\n\t\t// delete pending_upload record\n\t\tif err := app.Dao().DeleteRecord(pending); err != nil {\n\t\t\treturn apis.NewApiError(500, "failed to delete pending upload", err)\n\t\t}\n\n\t\tuploadsCol, err := app.Dao().FindCollectionByNameOrId("uploads")\n\t\tif err != nil {\n\t\t\treturn apis.NewApiError(500, "uploads collection missing", err)\n\t\t}\n\n\t\tnewRec := models.NewRecord(uploadsCol)\n\t\tnewRec.Set("user", rec.Id)\n\t\tnewRec.Set("key", key)\n\t\tif err := app.Dao().SaveRecord(newRec); err != nil {\n\t\t\treturn apis.NewApiError(500, "failed to save upload", err)\n\t\t}\n\n\t\treturn e.JSON(200, map[string]any{\n\t\t\t"key": key,\n\t\t})\n\t}\n}\n\nfunc main() {\n\tapp := pocketbase.New()\n\n\tapp.OnServe().Bind(&hook.Handler[*core.ServeEvent]{\n\t\tFunc: func(e *core.ServeEvent) error {\n\t\t\tif err := ensureCollections(e.App); err != nil {\n\t\t\t\treturn err\n\t\t\t}\n\t\t\tcfg := loadS3Config()\n\t\t\ts3Client, err := newS3Client(context.Background(), cfg)\n\t\t\tif err != nil {\n\t\t\t\treturn err\n\t\t\t}\n\n\t\t\t// Auth middleware\n\t\t\tauth := apis.RequireAuth()\n\n\t\t\te.Router.POST("/api/uploads/presign", auth, handlePresign(e.App, s3Client))\n\t\t\te.Router.POST("/api/uploads/finalize", auth, handleFinalize(e.App, s3Client))\n\t\t\treturn nil\n\t\t},\n\t})\n\n\tif err := app.Start(); err != nil {\n\t\tlog.Fatal(err)\n\t}\n\t_ = url.URL{}\n\t_ = http.StatusOK\n\t_ = routine.FireAndForget\n\t_ = tls.Config{}\n}\n\'\'\'\n\nwith open(\'/home/user/myapp/main.go\', \'a\') as f:\n    f.write(code)\nprint(\'appended part 2\')\nPYEOF\n'] min_timeout_sec: 1.0 max_timeout_sec: 180.0
