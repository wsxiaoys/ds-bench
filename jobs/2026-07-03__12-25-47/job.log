FAIL: %s missing visual placeholder" % p)\n            quit(1)\n            return\n    \n    # Check exactly 5 PinJoint2D nodes\n    var pin_joint_count := 0\n    var pin_pairs := []\n    for child in root.get_children():\n        if child is PinJoint2D:\n            pin_joint_count += 1\n            var pj: PinJoint2D = child\n            var a: String = String(pj.node_a)\n            var b: String = String(pj.node_b)\n            pin_pairs.append([a, b])\n            if pj.get_node_or_null(pj.node_a) == null:\n                print("FAIL: pin joint %s node_a doesn\'t resolve" % child.name)\n                quit(1)\n                return\n            if pj.get_node_or_null(pj.node_b) == null:\n                print("FAIL: pin joint %s node_b doesn\'t resolve" % child.name)\n                quit(1)\n                return\n    \n    if pin_joint_count != 5:\n        print("FAIL: expected 5 PinJoint2D nodes, found %d" % pin_joint_count)\n        quit(1)\n        return\n    \n    var required_pairs := [\n        ["Head", "Torso"],\n        ["LeftArm", "Torso"],\n        ["RightArm", "Torso"],\n        ["LeftLeg", "Torso"],\n        ["RightLeg", "Torso"],\n    ]\n    for rp in required_pairs:\n        var found := false\n        for pp in pin_pairs:\n            if (pp[0] == rp[0] and pp[1] == rp[1]) or (pp[0] == rp[1] and pp[1] == rp[0]):\n                found = true\n                break\n        if not found:\n            print("FAIL: missing pin joint connecting %s" % rp)\n            quit(1)\n            return\n    \n    print("PASS: All checks passed")\n    quit(0)\nEOF\n'] min_timeout_sec: 0.1 max_timeout_sec: 180.0
