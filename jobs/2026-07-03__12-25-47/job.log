t\\t\\t\\tamount: number\\n\\t\\t\\t\\tkind: "purchase"\\n\\t\\t\\t}\\n\\t\\t\\t& {\\n\\t\\t\\t\\t\\tkind: "logout"\\n\\t\\t\\t}\\n\\t\\t\\t& {\\n\\t\\t\\t\\t\\tkind: "login"\\n\\t\\t\\t}`\n\\t\\t)\n\n\\t\\t// Runtime: each tag should be validated correctly\n\\t\\tattest(Event({ kind: "login" })).snap({ kind: "login" })\n\\t\\tattest(Event({ kind: "purchase", amount: 9.99 })).snap({\n\\t\\t\\tkind: "purchase",\n\\t\\t\\tamount: 9.99\n\\t\\t})\n\n\\t\\t// Throwing assertion: a `purchase` event missing amount\n\\t\\tconst evErr = Event({ kind: "purchase" })\n\\t\\tattest(evErr).throws.snap("amount must be a number (was undefined)")\n\\t})\n\n\\tit("TrimmedEmail — built-in morph pipe on `string.trim`", () => {\n\\t\\t// Runtime: morph trims surrounding whitespace\n\\t\\tconst trimmed = TrimmedEmail("   hello@example.com   ")\n\\t\\tattest(trimmed).snap("hello@example.com")\n\\t\\tattest(TrimmedEmail("plain")).snap("plain")\n\n\\t\\t// Non-string should throw\n\\t\\tconst e = TrimmedEmail(123)\n\\t\\tattest(e).throws.snap("must be a string (was a number)")\n\\t})\n\n\\tit("UpperName — morph pipe with `|>` operator", () => {\n\\t\\t// Trim+upper output\n\\t\\tattest(UpperName("  alice  ")).snap("ALICE")\n\\t\\tattest(UpperName("bob")).snap("BOB")\n\n\\t\\t// Pure compile-time type equality check\n\\t\\tattest<string, typeof UpperName.infer>()\n\n\\t\\t// Negative compile-time assertion guarded by @ts-expect-error:\n\\t\\t// the morph output type is `string`, not the literal `"ALICE"`.\n\\t\\t// @ts-expect-error — output type does not narrow to a string literal\n\\t\\tattest(() => UpperName("  alice  ")).throwsAndHasTypeError(\n\\t\\t\\t/Type \'string\' is not assignable to type \'"ALICE"\'"/\n\\t\\t)\n\\t})\n\n\\tit("completion snapshots are populated with @ts-expect-error", () => {\n\\t\\t// (6) Completions: snapshot the builtin keywords completions for a `type` parser.\n\\t\\t// The deliberately-broken type expression below is guarded by @ts-expect-error.\n\\t\\t// @ts