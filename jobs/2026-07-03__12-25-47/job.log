Sending keys: ['cat > /home/user/myproject/test_error_return.ts << \'EOF\'\nimport { type, ArkError } from \'arktype\'\n\nconst UserT = type({\n  id: \'string.uuid\',\n  age: type.pipe(type(\'string.integer.parse\'), type(\'0 <= number <= 150\')),\n  email: \'string.email\',\n  signupAt: \'string.date.iso.parse\'\n})\n\nconst parseCsv = (csv: string): Array<{ id: string; age: string; email: string; signupAt: string }> | ArkError => {\n  if (csv.length === 0) {\n    return new ArkError(\'input is empty\')\n  }\n  const lines = csv.split(\'\\n\')\n  const header = lines[0]\n  if (header !== \'id,age,email,signupAt\') {\n    return new ArkError(\'header row must be exactly "id,age,email,signupAt"\')\n  }\n  const records = []\n  for (let i = 1; i < lines.length; i++) {\n    if (lines[i].length === 0) continue\n    const cells = lines[i].split(\',\')\n    if (cells.length !== 4) {\n      return new ArkError(`row ${i + 1} has ${cells.length} columns, expected 4`)\n    }\n    records.push({ id: cells[0], age: cells[1], email: cells[2], signupAt: cells[3] })\n  }\n  return records\n}\n\nconst StringT = type(\'string\')\nconst PipelineT = type.pipe(StringT, parseCsv, UserT.array())\n\n// Test empty input\nconsole.log(\'--- empty ---\')\nlet r = PipelineT(\'\')\nconsole.log(\'is errors:\', r instanceof type.errors)\nif (r instanceof type.errors) console.log(\'Summary:\', r.summary)\n\n// Test bad header\nconsole.log(\'--- bad header ---\')\nr = PipelineT(\'id,age,email,name\\n1,2,3,4\')\nconsole.log(\'is errors:\', r instanceof type.errors)\nif (r instanceof type.errors) console.log(\'Summary:\', r.summary)\n\n// Test wrong column count\nconsole.log(\'--- wrong columns ---\')\nr = PipelineT(\'id,age,email,signupAt\\n1,2,3\')\nconsole.log(\'is errors:\', r instanceof type.errors)\nif (r instanceof type.errors) console.log(\'Summary:\', r.summary)\nEOF\n'] min_timeout_sec: 0.1 max_timeout_sec: 180.0
