[358.990432, "i", "cat > test_match.ts << 'EOF'\nimport { match, scope, type } from 'arktype';\n\n// Create a scope\nconst $ = scope({\n  success: { status: '\"success\"', data: 'object' },\n  error: { status: '\"error\"', code: 'number', reason: 'string' },\n  pending: { status: '\"pending\"' },\n});\n\n// Try the imported match with the scope's types\n// I think the only way is to use the scope's match\n// But maybe there's a way to make it work with the imported match\n\nconst input = { status: 'success', data: { name: 'Alice' } };\n\n// Use the imported match with at\nconst result = match.at('status')({\n  '\"success\"': (data) => `OK: ${JSON.stringify((data as any).data)}`,\n  '\"error\"': (e) => `ERR ${(e as any).code} ${(e as any).reason}`,\n  '\"pending\"': () => `PENDING`,\n  default: \"assert\"\n})(input);\n\nconsole.log('Result:', result);\nEOF\nnpx tsx test_match.ts\n"]
