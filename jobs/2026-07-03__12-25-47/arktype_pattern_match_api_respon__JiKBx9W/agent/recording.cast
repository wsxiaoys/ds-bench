[500.31989, "i", "cat > test_match.ts << 'EOF'\nimport { match, scope, type } from 'arktype';\n\n// Create a scope with our types\nconst $ = scope({\n  success: { status: '\"success\"', data: 'object' },\n  error: { status: '\"error\"', code: 'number', reason: 'string' },\n  pending: { status: '\"pending\"' },\n});\n\nconst input = { status: 'success', data: { name: 'Alice' } };\n\n// Try using the scope's match - call it with the same name as match\nconst myMatch = $.match;\nconsole.log('myMatch type:', typeof myMatch);\n\n// This is the two-call form using the scope's match\nconst result = myMatch({\n  success: (data: any) => `OK: ${JSON.stringify(data.data)}`,\n  error: (e: any) => `ERR ${e.code} ${e.reason}`,\n  pending: () => `PENDING`,\n  default: 'assert'\n})(input);\n\nconsole.log('Result:', result);\nEOF\nnpx tsx test_match.ts\n"]
