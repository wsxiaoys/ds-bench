[274.927085, "i", "cat > test_match.ts << 'EOF'\nimport { match } from 'arktype';\n\nconst input = { status: 'success', data: { name: 'Alice' } };\n\n// Use match.at to discriminate by status field\nconst result = match.at('status')({\n  '\"success\"': (data) => {\n    console.log('handler received:', data);\n    return `OK: ${JSON.stringify(data.data)}`;\n  },\n  '\"error\"': (e) => `ERR ${e.code} ${e.reason}`,\n  '\"pending\"': () => `PENDING`,\n  default: \"assert\"\n})(input);\n\nconsole.log('Result:', result);\nEOF\nnpx tsx test_match.ts\n"]
