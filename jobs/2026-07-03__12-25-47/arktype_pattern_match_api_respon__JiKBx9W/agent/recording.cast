[407.379602, "i", "cat > test_match.ts << 'EOF'\nimport { match, type } from 'arktype';\n\nconst successT = type({ status: '\"success\"', data: 'object' });\nconst input = { status: 'success', data: { name: 'Alice' } };\n\n// Let me see what match(cases) returns\nconst r1 = match({\n  '\"success\"': (data: any) => `OK: ${JSON.stringify(data)}`,\n  default: 'assert'\n});\n\nconsole.log('r1 type:', typeof r1);\nconsole.log('r1:', r1);\nconsole.log('r1 is callable:', typeof r1 === 'function');\n\n// Try calling r1 with input\ntry {\n  const result = r1(input);\n  console.log('Result:', result);\n} catch (e: any) {\n  console.log('Error:', e.message);\n}\nEOF\nnpx tsx test_match.ts\n"]
