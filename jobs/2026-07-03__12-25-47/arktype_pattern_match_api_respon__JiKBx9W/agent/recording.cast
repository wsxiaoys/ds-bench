[137.40656, "i", "cat > test_match.ts << 'EOF'\nimport { match, type } from 'arktype';\n\n// Test what we can pass as a key\nconst successType = type({ status: '\"success\"', data: 'object' });\nconsole.log('successType:', successType.toString ? successType.toString() : 'no toString');\n\n// Try using the type as a property key\nconst matchers = {\n  [successType.out]: (data: any) => `OK: ${JSON.stringify(data)}`,\n  default: \"assert\"\n} as any;\n\nconsole.log('matchers keys:', Object.keys(matchers));\nEOF\nnpx tsx test_match.ts\n"]
