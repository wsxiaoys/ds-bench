[316.213938, "i", "cat > test_match.ts << 'EOF'\nimport { match, type } from 'arktype';\n\n// Try different key formats that don't require named types\nconst input = { status: 'success', data: { name: 'Alice' } };\n\n// Test various formats\nconst tests: Array<[string, string]> = [\n  ['success', '\"success\"'],\n  ['object', 'object'],\n  ['1', '1'],\n  ['data: object', 'data: object'],\n  ['{data: object}', '{data: object}'],\n  ['object[]', 'object[]'],\n  ['Date', 'Date'],\n];\n\nfor (const [name, key] of tests) {\n  try {\n    const r = type(key);\n    console.log(`type('${key}') -> OK:`, r.toString());\n  } catch (e: any) {\n    console.log(`type('${key}') -> ERROR:`, e.message?.split('\\n')[0]);\n  }\n}\nEOF\nnpx tsx test_match.ts\n"]
