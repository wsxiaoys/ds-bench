[175.341136, "i", "cat > test_match.ts << 'EOF'\nimport { match, type } from 'arktype';\n\n// Try various string formats for match keys\nconst tests = [\n  'string',\n  'number',\n  'boolean',\n  'string | number',\n  '\"success\"',\n  '\"success\" | \"error\"',\n];\n\nfor (const t of tests) {\n  try {\n    const r = type(t);\n    console.log(`'${t}' -> OK:`, r.toString());\n  } catch (e: any) {\n    console.log(`'${t}' -> ERROR:`, e.message?.split('\\n')[0]);\n  }\n}\nEOF\nnpx tsx test_match.ts\n"]
