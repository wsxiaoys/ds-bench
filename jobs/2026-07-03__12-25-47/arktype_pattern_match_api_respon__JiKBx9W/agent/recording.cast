[388.635411, "i", "cat > test_match.ts << 'EOF'\nimport { match, type } from 'arktype';\n\nconst successT = type({ status: '\"success\"', data: 'object' });\n\nconst input = { status: 'success', data: { name: 'Alice' } };\n\n// Try using case with type instance\ntry {\n  const result = match\n    .case(successT, (data: any) => `OK: ${JSON.stringify(data.data)}`)\n    .default('assert')(input);\n  console.log('Result:', result);\n} catch (e: any) {\n  console.log('Error:', e.message);\n}\nEOF\nnpx tsx test_match.ts\n"]
