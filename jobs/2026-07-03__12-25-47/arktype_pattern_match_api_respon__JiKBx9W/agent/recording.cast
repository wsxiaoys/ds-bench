[264.608785, "i", "cat > test_match.ts << 'EOF'\nimport { match, scope, type } from 'arktype';\n\n// Create a custom scope with the types\nconst customScope = scope({\n  success: { status: '\"success\"', data: 'object' },\n  error: { status: '\"error\"', code: 'number', reason: 'string' },\n  pending: { status: '\"pending\"' },\n});\n\nconst input = { status: 'success', data: { name: 'Alice' } };\n\n// Try the scope's match\nconst customMatch = customScope.match;\nconst result = customMatch({\n  success: (data: any) => `OK: ${JSON.stringify(data)}`,\n  error: (e: any) => `ERR ${e.code} ${e.reason}`,\n  pending: () => `PENDING`,\n  default: \"assert\"\n})(input);\n\nconsole.log(result);\nEOF\nnpx tsx test_match.ts\n"]
