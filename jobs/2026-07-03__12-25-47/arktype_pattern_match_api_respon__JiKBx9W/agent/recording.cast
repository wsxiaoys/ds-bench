[546.577724, "i", "cat > test_match.ts << 'EOF'\nimport { match, type, ark } from 'arktype';\n\n// Add custom types to the ark scope\nconst successT = type({ status: '\"success\"', data: 'object' });\nconst errorT = type({ status: '\"error\"', code: 'number', reason: 'string' });\nconst pendingT = type({ status: '\"pending\"' });\n\n// Try to add to the ark scope properly\n// The hack: directly add to the alias map\n(ark as any).aliases['success'] = successT;\n(ark as any).aliases['error'] = errorT;\n(ark as any).aliases['pending'] = pendingT;\n(ark as any).resolutions['success'] = successT;\n(ark as any).resolutions['error'] = errorT;\n(ark as any).resolutions['pending'] = pendingT;\n\nconst input = { status: 'success', data: { name: 'Alice' } };\ntry {\n  const result = match({\n    success: (data: any) => `OK: ${JSON.stringify(data.data)}`,\n    error: (e: any) => `ERR ${e.code} ${e.reason}`,\n    pending: () => `PENDING`,\n    default: 'assert'\n  } as any)(input);\n  console.log('Result:', result);\n} catch (e: any) {\n  console.log('Error:', e.message);\n}\nEOF\nnpx tsx test_match.ts\n"]
