[159.424897, "i", "cat > test_match.ts << 'EOF'\nimport { match, type } from 'arktype';\n\nconst successType = type({ status: '\"success\"', data: 'object' });\nconst errorType = type({ status: '\"error\"', code: 'number', reason: 'string' });\nconst pendingType = type({ status: '\"pending\"' });\n\nconst input = { status: 'success', data: { name: 'Alice' } };\n\nconst result = match({\n  [successType]: (data: any) => `OK: ${JSON.stringify(data)}`,\n  [errorType]: (e: any) => `ERR ${e.code} ${e.reason}`,\n  [pendingType]: () => `PENDING`,\n  default: \"assert\"\n} as any)(input);\n\nconsole.log(result);\nEOF\nnpx tsx test_match.ts\n"]
