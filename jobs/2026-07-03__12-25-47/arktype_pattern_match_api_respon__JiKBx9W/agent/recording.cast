[234.17935, "i", "cat > test_match.ts << 'EOF'\nimport { match, scope, type } from 'arktype';\n\n// Create a scope with the types as a discriminated union\nconst $ = scope({\n  success: { status: '\"success\"', data: 'object' },\n  error: { status: '\"error\"', code: 'number', reason: 'string' },\n  pending: { status: '\"pending\"' },\n});\n\nconst input = { status: 'success', data: { name: 'Alice' } };\n\n// Use the scope's match with the named types as keys\nconst result = $.match({\n  success: (data) => `OK: ${JSON.stringify(data)}`,\n  error: (e) => `ERR ${e.code} ${e.reason}`,\n  pending: () => `PENDING`,\n  default: \"assert\"\n})(input);\n\nconsole.log(result);\nEOF\nnpx tsx test_match.ts\n"]
