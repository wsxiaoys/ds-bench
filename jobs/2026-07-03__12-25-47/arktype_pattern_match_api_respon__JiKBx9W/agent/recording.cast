[475.174646, "i", "cat > test_match.ts << 'EOF'\nimport { match, scope, type, ark } from 'arktype';\n\n// Create a scope with our types\nconst types = scope({\n  success: { status: '\"success\"', data: 'object' },\n  error: { status: '\"error\"', code: 'number', reason: 'string' },\n  pending: { status: '\"pending\"' },\n});\n\n// Try to import types from our scope into ark\nconsole.log('types.import:', typeof types.import);\nconsole.log('ark.import:', typeof ark.import);\n\n// Try to import our types into the ark scope\ntry {\n  ark.import(types, 'success', 'error', 'pending');\n  console.log('Imported successfully');\n  \n  const input = { status: 'success', data: { name: 'Alice' } };\n  const result = match({\n    success: (data: any) => `OK: ${JSON.stringify(data.data)}`,\n    error: (e: any) => `ERR ${e.code} ${e.reason}`,\n    pending: () => `PENDING`,\n    default: 'assert'\n  } as any)(input);\n  console.log('Result:', result);\n} catch (e: any) {\n  console.log('Error:', e.message);\n}\nEOF\nnpx tsx test_match.ts\n"]
