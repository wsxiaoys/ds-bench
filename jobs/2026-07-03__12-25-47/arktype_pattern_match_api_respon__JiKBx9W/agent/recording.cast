[126.622601, "i", "cat > test_match.ts << 'EOF'\nimport { match, type } from 'arktype';\n\nconst input = { status: 'success', data: { name: 'Alice' } };\n\n// Try with object literal that has status field\nconst result = match({\n  '{ status: \"success\", data: object }': (data) => `OK: ${JSON.stringify(data)}`,\n  '{ status: \"error\", code: number, reason: string }': (e) => `ERR ${e.code} ${e.reason}`,\n  '{ status: \"pending\" }': () => `PENDING`,\n  default: \"assert\"\n})(input);\n\nconsole.log(result);\nEOF\nnpx tsx test_match.ts\n"]
