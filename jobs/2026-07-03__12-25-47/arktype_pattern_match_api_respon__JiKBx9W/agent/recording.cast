[349.837073, "i", "cat > src/handler.ts << 'EOF'\nimport { match, scope } from 'arktype';\n\n// Define a scope with the discriminated union types\nconst $ = scope({\n  success: { status: '\"success\"', data: 'object' },\n  error: { status: '\"error\"', code: 'number', reason: 'string' },\n  pending: { status: '\"pending\"' },\n});\n\nconst handle = $.match({\n  success: (data) => `OK: ${JSON.stringify((data as any).data)}`,\n  error: (e) => `ERR ${(e as any).code} ${(e as any).reason}`,\n  pending: () => `PENDING`,\n  default: \"assert\"\n});\n\n// Read input from stdin\nconst chunks: Buffer[] = [];\nprocess.stdin.on('data', (chunk) => chunks.push(chunk));\nprocess.stdin.on('end', () => {\n  try {\n    const input = JSON.parse(Buffer.concat(chunks).toString('utf8'));\n    const result = handle(input);\n    process.stdout.write(result + '\\n');\n  } catch (err) {\n    process.exit(1);\n  }\n});\nEOF\ncat src/handler.ts\n"]
