[289.524084, "i", "cat > test_match.ts << 'EOF'\nimport { match, type } from 'arktype';\n\n// Define types\nconst successT = type({ status: '\"success\"', data: 'object' });\nconst errorT = type({ status: '\"error\"', code: 'number', reason: 'string' });\nconst pendingT = type({ status: '\"pending\"' });\n\n// Try using match.in() with discriminated types\nconst result = match\n  .in(successT.or(errorT).or(pendingT))\n  .match({\n    [successT.expression]: (data: any) => `OK: ${JSON.stringify(data.data)}`,\n    [errorT.expression]: (e: any) => `ERR ${e.code} ${e.reason}`,\n    [pendingT.expression]: () => `PENDING`,\n    default: \"assert\"\n  })({ status: 'success', data: { name: 'Alice' } });\n\nconsole.log(result);\nEOF\nnpx tsx test_match.ts\n"]
