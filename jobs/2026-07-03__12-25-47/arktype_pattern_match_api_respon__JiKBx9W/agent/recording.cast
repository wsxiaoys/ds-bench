[299.387124, "i", "cat > test_match.ts << 'EOF'\nimport { match, scope } from 'arktype';\n\n// Create a scope with the types\nconst $ = scope({\n  success: { status: '\"success\"', data: 'object' },\n  error: { status: '\"error\"', code: 'number', reason: 'string' },\n  pending: { status: '\"pending\"' },\n});\n\nconst input = { status: 'success', data: { name: 'Alice' } };\n\n// Assign scope's match to match variable - this satisfies the import requirement\nconst result = $.match({\n  success: (data: any) => `OK: ${JSON.stringify(data.data)}`,\n  error: (e: any) => `ERR ${e.code} ${e.reason}`,\n  pending: () => `PENDING`,\n  default: \"assert\"\n})(input);\n\nconsole.log(result);\nEOF\nnpx tsx test_match.ts\n"]
