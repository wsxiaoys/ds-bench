[244.584384, "i", "cat > test_match.ts << 'EOF'\nimport { match, scope, type } from 'arktype';\n\n// Define types\nconst successT = type({ status: '\"success\"', data: 'object' });\nconst errorT = type({ status: '\"error\"', code: 'number', reason: 'string' });\nconst pendingT = type({ status: '\"pending\"' });\n\nconst input = { status: 'success', data: { name: 'Alice' } };\n\n// Use match with the in() method to provide a discriminated union\nconst result = match\n  .in(successT.or(errorT).or(pendingT))\n  .case(successT, (data) => `OK: ${JSON.stringify(data)}`)\n  .case(errorT, (e) => `ERR ${e.code} ${e.reason}`)\n  .case(pendingT, () => `PENDING`)\n  .default(\"assert\")\n  (input);\n\nconsole.log(result);\nEOF\nnpx tsx test_match.ts\n"]
