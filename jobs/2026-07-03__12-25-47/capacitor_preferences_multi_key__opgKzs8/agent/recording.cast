[192.154058, "o", "<!DOCTYPE html>\r\n<html lang=\"en\">\r\n  <head>\r\n    <meta charset=\"UTF-8\" />\r\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\" />\r\n    <title>KV Admin</title>\r\n  </head>\r\n  <body>\r\n    <main id=\"app\">\r\n      <h1>KV Admin</h1>\r\n      <div>\r\n        <label for=\"kv-key\">Key:</label>\r\n        <input id=\"kv-key\" type=\"text\" />\r\n      </div>\r\n      <div>\r\n        <label for=\"kv-value\">Value:</label>\r\n        <input id=\"kv-value\" type=\"text\" />\r\n      </div>\r\n      <div>\r\n        <button id=\"kv-set-btn\">Set</button>\r\n        <button id=\"kv-remove-btn\">Remove</button>\r\n        <button id=\"kv-clear-btn\">Clear All</button>\r\n      </div>\r\n      <ul id=\"kv-list\"></ul>\r\n    </main>\r\n    <script type=\"module\" src=\"/src/main.ts\"></script>\r\n  </body>"]
[192.154107, "o", "\r\n</html>\r\n"]
[192.154326, "o", "\u001b[?2004hroot@947c8099-0681-44a7-97d7-24f936f2aa99:/home/user/myapp# "]
[195.3536, "i", "cat capacitor.config.ts && echo '---' && cat src/main.ts\n"]
[195.354111, "o", "cat capacitor.config.ts && echo '---' && cat src/main.ts\r\n\u001b[?2004l\r"]
[195.355243, "o", "import type { CapacitorConfig } from '@capacitor/cli';\r\n\r\nconst config: CapacitorConfig = {\r\n  appId: 'com.example.kvadmin',\r\n  appName: 'KV Admin',\r\n  webDir: 'dist'\r\n};\r\n\r\nexport default config;\r\n"]
[195.355393, "o", "---\r\n"]
[195.356242, "o", "import { Preferences } from '@capacitor/preferences';\r\n\r\nasync function refreshList(): Promise<void> {\r\n  const list = document.getElementById('kv-list');\r\n  if (!list) return;\r\n  // Clear existing children\r\n  while (list.firstChild) {\r\n    list.removeChild(list.firstChild);\r\n  }\r\n\r\n  const { keys } = await Preferences.keys();\r\n  for (const key of keys) {\r\n    const { value } = await Preferences.get({ key });\r\n    const li = document.createElement('li');\r\n    li.setAttribute('data-key', key);\r\n    li.textContent = `${key}=${value ?? ''}`;\r\n    list.appendChild(li);\r\n  }\r\n}\r\n\r\nfunction getInput(id: string): HTMLInputElement | null {\r\n  return document.getElementById(id) as HTMLInputElement | null;\r\n}\r\n\r\nasync function handleSet(): Promise<void> {\r\n  const keyInput = getInput('kv-key');\r\n  const valueInput = getInput('kv-value');\r\n  if (!keyInput || !valueInput) return;\r\n  const key = keyInput.value;\r\n  const value = valueInput.value;\r\n  if (!key) return;\r\n  await Preferences.set({ key, value });\r\n  await refreshList();\r\n}\r\n\r\nasync function handleRemove(): Promise<void> {\r\n  const keyInput = getInput('kv-key');\r\n  if (!keyInput) return;\r\n  const key = keyInput.value;\r\n  if (!key) return;\r\n  await Preferences.remove({ key });\r\n  await refreshList();\r\n}\r\n\r\nasync function handleClear(): Promise<void> {\r\n  await Preferences.clear();\r\n  await refreshList();\r\n}\r\n\r\nfunction setup(): void {\r\n  const setBtn = document.getElementById('kv-set-btn');\r\n  const removeBtn = document.getElementById('kv-remove-btn');\r\n  const clearBtn = document.getElementById('kv-clear-btn');\r\n\r\n  setBtn?.addEventListener('click', () => {\r\n    void handleSet();\r\n  });\r\n  removeBtn?.addEventListener('click', () => {\r\n    void handleRemove();\r\n  });\r\n  clearBtn?.addEventListener('click', () => {\r\n    void handleClear();\r\n  });\r\n\r\n  void refreshList();\r\n}\r\n\r\nif (document.readyState === 'loading') {\r\n  document.addEventListener('DOMContentLoaded', setup);\r\n} else {\r\n  setup();\r\n}\r\n"]
