[106.341804, "o", "> "]
[106.341839, "o", "      </div>\r\n\u001b[?2004l\r"]
[106.341858, "o", "\u001b[?2004h> "]
[106.341933, "o", "      <ul id=\"kv-list\"></ul>\r\n\u001b[?2004l\r"]
[106.341951, "o", "\u001b[?2004h> "]
[106.341989, "o", "    </main>\r\n\u001b[?2004l\r\u001b[?2004h"]
