[322.004626, "o", ">     else:\r\n\u001b[?2004l\r"]
[322.004646, "o", "\u001b[?2004h> "]
[322.004663, "o", "        final.append(seg)\r\n\u001b[?2004l\r\u001b[?2004h"]
[322.004673, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h"]
[322.00468, "o", "> "]
