[322.003599, "o", "> "]
[322.003613, "o", "    if e > s:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[322.003644, "o", "        t_start = float(beat_times[s])\r\n\u001b[?2004l\r"]
[322.003662, "o", "\u001b[?2004h> "]
