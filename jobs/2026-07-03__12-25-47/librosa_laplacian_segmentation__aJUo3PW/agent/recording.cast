[322.00424, "o", "\u001b[?2004h>     else:\r\n\u001b[?2004l\r"]
[322.004247, "o", "\u001b[?2004h> "]
[322.004283, "o", "        merged.append(dict(seg))\r\n\u001b[?2004l\r\u001b[?2004h"]
