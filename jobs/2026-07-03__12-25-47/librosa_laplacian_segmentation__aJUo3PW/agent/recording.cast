[329.714728, "o", "\u001b[?2004hroot@c4161dc2-ada9-49cc-8b9e-0d9ae7705c95:~# "]
[373.761288, "i", "cat > /home/user/segment.py << 'PYEOF'\nimport json\nimport numpy as np\nimport librosa\nfrom sklearn.cluster import AgglomerativeClustering\n\nAUDIO_PATH = '/home/user/input.wav'\nOUT_PATH = '/home/user/segments.json'\n\n# --- Load audio ---\ny, sr = librosa.load(AUDIO_PATH, sr=22050, mono=True)\nduration = float(len(y) / sr)\n\n# --- Beat tracking ---\nonset_env = librosa.onset.onset_strength(y=y, sr=sr)\ntempo, beat_frames = librosa.beat.beat_track(onset_envelope=onset_env, sr=sr)\nbeat_times = librosa.frames_to_time(beat_frames, sr=sr)\nprint(f'tempo={tempo} n_beats={len(beat_frames)} duration={duration}')\n\n# --- Tonal feature (chroma_cqt) ---\nchroma = librosa.feature.chroma_cqt(y=y, sr=sr)\nchroma_sync = librosa.util.sync(chroma, beat_frames, aggregate=np.median)\n\n# --- Recurrence matrix + path enhancement ---\nR = librosa.segment.recurrence_matrix(\n    chroma_sync, mode='affinity', metric='cosine', sparse=False,\n)\nn = chroma_sync.shape[1]\nn_seg_path = max(2, int(np.ceil(n / 7.0)))\nR_path = librosa.segment.path_enhance(R, n_seg_path)\n\n# --- Sequential affinity ---\nseq = np.zeros((n, n), dtype=np.float64)\nband = 7\nfor i in range(n):\n    lo = max(0, i - band)\n    hi = min(n, i + band + 1)\n    d = np.abs(np.arange(lo, hi) - i)\n    seq[i, lo:hi] = np.exp(-(d ** 2) / (2.0 * (band / 2.0) ** 2))\n\nalpha = 0.5\nA = alpha * R_path + (1.0 - alpha) * seq\nnp.fill_diagonal(A, 1.0)\nA = 0.5 * (A + A.T)\n\n# --- Symmetric normalized graph Laplacian ---\ndeg = A.sum(axis=1)\nwith np.errstate(divide='ignore'):\n    d_inv_sqrt = np.where(deg > 0, 1.0 / np.sqrt(deg), 0.0)\nD_inv_sqrt = np.diag(d_inv_sqrt)\nL = np.eye(n) - D_inv_sqrt @ A @ D_inv_sqrt\n\nK = 5\neigvals, eigvecs = np.linalg.eigh(L)\nidx_sort = np.argsort(eigvals)\neigvals = eigvals[idx_sort]\neigvecs = eigvecs[:, idx_sort]\nemb = eigvecs[:, 1:K+1]\nrow_norm = np.linalg.norm(emb, axis=1, keepdims=True)\nrow_norm = np.where(row_norm > 0, row_norm, 1.0)\nemb_norm = emb / row_norm\n\n# --- Cluster per-beat embeddings ---\nn_label_types = 3\nper_beat_labels = AgglomerativeClustering(\n    n_clusters=n_label_types, metric='euclidean', linkage='average'\n).fit_predict(emb_norm)\nprint('label counts:', np.bincount(per_beat_labels))\n\n# --- Derive contiguous runs ---\nruns = []\ni = 0\nwhile i < n:\n    j = i\n    while j < n and per_beat_labels[j] == per_beat_labels[i]:\n        j += 1\n    runs.append((i, j, int(per_beat_labels[i])))\n    i = j\nprint('initial runs:', runs)\n\n# Merge tiny runs (< 3 beats) into neighbor with most similar mean chroma\nwhile True:\n    merged = False\n    for k in range(len(runs)):\n        s, e, lab = runs[k]\n        if (e - s) < 3 and len(runs) > 1:\n            this_mean = chroma_sync[:, s:e].mean(axis=1)\n            best = -1\n            best_sim = -np.inf\n            for kk in [k-1, k+1]:\n                if 0 <= kk < len(runs):\n                    ns, ne, nlab = runs[kk]\n                    nm = chroma_sync[:, ns:ne].mean(axis=1)\n                    sim = float(np.dot(this_mean, nm) / (np.linalg.norm(this_mean) * np.linalg.norm(nm) + 1e-12))\n                    if sim > best_sim:\n                        best_sim = sim\n                        best = kk\n            if best == k - 1:\n                ps, pe, plab = runs[k-1]\n                runs[k-1] = (ps, e, int(plab))\n                del runs[k]\n            elif best == k + 1:\n                ns, ne, nlab = runs[k+1]\n                runs[k] = (s, ne, int(nlab))\n                del runs[k+1]\n            else:\n                ps, pe, plab = runs[k-1]\n                runs[k-1] = (ps, e, int(plab))\n                del runs[k]\n            merged = True\n            break\n    if not merged:\n        break\nprint('after tiny merge:', runs)\n\n# --- Reassign labels so that runs with similar chroma content share the same letter ---\n# Compute mean chroma per run\nrun_means = np.stack([chroma_sync[:, s:e].mean(axis=1) for (s, e, lab) in runs], axis=0)\n# Normalize\nrm_norms = np.linalg.norm(run_means, axis=1, keepdims=True)\nrm_norms = np.where(rm_norms > 0, rm_norms, 1.0)\nrun_means_n = run_means / rm_norms\n# Compute pairwise cosine similarity\nsim_matrix = run_means_n @ ru"]
[373.761327, "i", "n_means_n.T\n# Cluster the runs themselves into label types based on chroma similarity\nnr = len(runs)\nif nr >= 2:\n    # Use a threshold: merge runs with cosine sim > threshold\n    # First, greedily assign letters\n    letters = [None] * nr\n    next_letter_idx = 0\n    for k in range(nr):\n        if letters[k] is not None:\n            continue\n        cur_letter = chr(ord('A') + next_letter_idx)\n        next_letter_idx += 1\n        letters[k] = cur_letter\n        for kk in range(k+1, nr):\n            if letters[kk] is None and sim_matrix[k, kk] > 0.85:\n                letters[kk] = cur_letter\nelse:\n    letters = ['A'] * nr\nprint('letters per run:', letters)\n\n# --- Build time intervals ---\nsegments = []\nfor (s, e, lab), letter in zip(runs, letters):\n    if e > s:\n        t_start = float(beat_times[s])\n        if e < n:\n            t_end = float(beat_times[e])\n        else:\n            t_end = duration\n        segments.append({'start': t_start, 'end': t_end, 'label': letter})\n\nsegments[0]['start'] = 0.0\nsegments[-1]['end'] = duration\n\n# Merge adjacent segments with same label\nmerged = []\nfor seg in segments:\n    if merged and merged[-1]['label'] == seg['label']:\n        merged[-1]['end'] = seg['end']\n    else:\n        merged.append(dict(seg))\n\n# Drop / merge segments shorter than 0.5s\nfinal = []\nfor seg in merged:\n    dur = seg['end'] - seg['start']\n    if dur <= 0.5:\n        if final:\n            final[-1]['end'] = seg['end']\n        else:\n            seg['start'] = 0.0\n            final.append(seg)\n    else:\n        final.append(seg)\n\n# Bridge large gaps / overlaps\nfor i in range(1, len(final)):\n    gap = final[i]['start'] - final[i-1]['end']\n    if gap > 0.3:\n        mid = (final[i-1]['end'] + final[i]['start']) / 2.0\n        final[i-1]['end'] = mid\n        final[i]['start'] = mid\n    elif gap < -0.05:\n        mid = (final[i-1]['end'] + final[i]['start']) / 2.0\n        final[i-1]['end'] = mid\n        final[i]['start'] = mid\n\nfinal = [s for s in final if (s['end'] - s['start']) > 0.5]\n\nrenamed = []\nlabel_map = {}\nfor s in final:\n    if s['label'] not in label_map:\n        label_map[s['label']] = chr(ord('A') + len(label_map))\n    renamed.append({'start': float(s['start']), 'end': float(s['end']), 'label': label_map[s['label']]})\n\nrenamed.sort(key=lambda x: x['start'])\n\nprint('FINAL SEGMENTS:')\nfor s in renamed:\n    print(f\"  {s['start']:.3f} -> {s['end']:.3f}  {s['label']}  (dur={s['end']-s['start']:.3f})\")\n\nwith open(OUT_PATH, 'w') as f:\n    json.dump(renamed, f, indent=2)\nprint('Wrote', OUT_PATH)\nPYEOF\necho done\n"]
[373.761589, "o", "cat > /home/user/segment.py << 'PYEOF'\r\n\u001b[?2004l\r"]
[373.761692, "o", "\u001b[?2004h"]
[373.761712, "o", "> "]
[373.761782, "o", "import json\r\n\u001b[?2004l\r\u001b[?2004h> "]
[373.761862, "o", "import numpy as np\r\n\u001b[?2004l\r"]
[373.761904, "o", "\u001b[?2004h> "]
[373.761955, "o", "import librosa\r\n\u001b[?2004l\r"]
[373.761979, "o", "\u001b[?2004h> "]
[373.762206, "o", "from sklearn.cluster import AgglomerativeClustering\r\n\u001b[?2004l\r"]
[373.762252, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[373.762291, "o", "\u001b[?2004h"]
[373.76231, "o", "> "]
[373.762435, "o", "AUDIO_PATH = '/home/user/input.wav'\r\n\u001b[?2004l\r\u001b[?2004h"]
[373.762459, "o", "> "]
[373.762589, "o", "OUT_PATH = '/home/user/segments.json'\r\n\u001b[?2004l\r"]
[373.762613, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[373.762664, "o", "> "]
[373.762707, "o", "# --- Load audio ---\r\n\u001b[?2004l\r"]
[373.762828, "o", "\u001b[?2004h> "]
[373.762932, "o", "y, sr = librosa.load(AUDIO_PATH, sr=22050, mono=True)\r\n\u001b[?2004l\r"]
[373.762959, "o", "\u001b[?2004h> "]
[373.763041, "o", "duration = float(len(y) / sr)\r\n\u001b[?2004l\r"]
[373.763101, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[373.763119, "o", "\u001b[?2004h> "]
[373.763181, "o", "# --- Beat tracking ---\r\n\u001b[?2004l\r\u001b[?2004h> "]
[373.763318, "o", "onset_env = librosa.onset.onset_strength(y=y, sr=sr)\r\n\u001b[?2004l\r"]
[373.76334, "o", "\u001b[?2004h> "]
[373.763579, "o", "tempo, beat_frames = librosa.beat.beat_track(onset_envelope=onset_env, sr=sr)\r\n\u001b[?2004l\r"]
[373.763622, "o", "\u001b[?2004h> "]
[373.763759, "o", "beat_times = librosa.frames_to_time(beat_frames, sr=sr)\r\n\u001b[?2004l\r"]
[373.763779, "o", "\u001b[?2004h> "]
[373.763986, "o", "print(f'tempo={tempo} n_beats={len(beat_frames)} duration={duration}')\r\n\u001b[?2004l\r"]
[373.764005, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[373.764023, "o", "\u001b[?2004h> "]
[373.76414, "o", "# --- Tonal feature (chroma_cqt) ---\r\n\u001b[?2004l\r"]
[373.764157, "o", "\u001b[?2004h> "]
[373.764307, "o", "chroma = librosa.feature.chroma_cqt(y=y, sr=sr)\r\n\u001b[?2004l\r"]
[373.764324, "o", "\u001b[?2004h> "]
[373.764555, "o", "chroma_sync = librosa.util.sync(chroma, beat_frames, aggregate=np.median)\r\n\u001b[?2004l\r"]
[373.764572, "o", "\u001b[?2004h> \r\n"]
[373.764586, "o", "\u001b[?2004l\r"]
[373.7646, "o", "\u001b[?2004h> "]
[373.764743, "o", "# --- Recurrence matrix + path enhancement ---\r\n\u001b[?2004l\r"]
[373.764759, "o", "\u001b[?2004h> "]
[373.76488, "o", "R = librosa.segment.recurrence_matrix(\r\n\u001b[?2004l\r"]
[373.764896, "o", "\u001b[?2004h> "]
[373.765096, "o", "    chroma_sync, mode='affinity', metric='cosine', sparse=False,\r\n\u001b[?2004l\r"]
[373.765118, "o", "\u001b[?2004h> "]
[373.765133, "o", ")\r\n\u001b[?2004l\r\u001b[?2004h"]
[373.765149, "o", "> "]
[373.765228, "o", "n = chroma_sync.shape[1]\r\n\u001b[?2004l\r"]
[373.765244, "o", "\u001b[?2004h> "]
[373.765375, "o", "n_seg_path = max(2, int(np.ceil(n / 7.0)))\r\n\u001b[?2004l\r"]
[373.765392, "o", "\u001b[?2004h> "]
[373.765554, "o", "R_path = librosa.segment.path_enhance(R, n_seg_path)\r\n\u001b[?2004l\r"]
[373.765574, "o", "\u001b[?2004h> "]
[373.765588, "o", "\r\n\u001b[?2004l\r\u001b[?2004h"]
[373.765602, "o", "> "]
[373.765696, "o", "# --- Sequential affinity ---\r\n\u001b[?2004l\r"]
[373.765711, "o", "\u001b[?2004h> "]
[373.765838, "o", "seq = np.zeros((n, n), dtype=np.float64)\r\n\u001b[?2004l\r"]
[373.765856, "o", "\u001b[?2004h> "]
[373.765885, "o", "band = 7\r\n\u001b[?2004l\r"]
[373.765903, "o", "\u001b[?2004h> "]
[373.765964, "o", "for i in range(n):\r\n\u001b[?2004l\r"]
[373.765979, "o", "\u001b[?2004h> "]
[373.766065, "o", "    lo = max(0, i - band)\r\n\u001b[?2004l\r"]
[373.766082, "o", "\u001b[?2004h> "]
[373.766177, "o", "    hi = min(n, i + band + 1)\r\n\u001b[?2004l\r"]
[373.766197, "o", "\u001b[?2004h> "]
[373.766309, "o", "    d = np.abs(np.arange(lo, hi) - i)\r\n\u001b[?2004l\r"]
[373.766327, "o", "\u001b[?2004h> "]
[373.766531, "o", "    seq[i, lo:hi] = np.exp(-(d ** 2) / (2.0 * (band / 2.0) ** 2))\r\n\u001b[?2004l\r"]
[373.766548, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[373.766566, "o", ".\u001b[?2004h"]
[373.766581, "o", "> "]
[373.766614, "o", "alpha = 0.5\r\n\u001b[?2004l\r"]
[373.76663, "o", "\u001b[?2004h> "]
[373.766767, "o", "A = alpha * R_path + (1.0 - alpha) * seq\r\n\u001b[?2004l\r"]
[373.766782, "o", "\u001b[?2004h> "]
[373.766864, "o", "np.fill_diagonal(A, 1.0)\r\n\u001b[?2004l\r"]
[373.766879, "o", "\u001b[?2004h> "]
[373.766951, "o", "A = 0.5 * (A + A.T)\r\n\u001b[?2004l\r"]
[373.766966, "o", "\u001b[?2004h> "]
[373.76698, "o", "\r\n\u001b[?2004l\r"]
[373.766994, "o", "\u001b[?2004h> "]
[373.767148, "o", "# --- Symmetric normalized graph Laplacian ---\r\n\u001b[?2004l\r"]
[373.767165, "o", "\u001b[?2004h> "]
[373.767231, "o", "deg = A.sum(axis=1)\r\n\u001b[?2004l\r"]
[373.767251, "o", "\u001b[?2004h> "]
[373.76736, "o", "with np.errstate(divide='ignore'):\r\n\u001b[?2004l\r"]
[373.767377, "o", "\u001b[?2004h> "]
[373.767572, "o", "    d_inv_sqrt = np.where(deg > 0, 1.0 / np.sqrt(deg), 0.0)\r\n\u001b[?2004l\r"]
[373.767587, "o", "\u001b[?2004h> "]
[373.76769, "o", "D_inv_sqrt = np.diag(d_inv_sqrt)\r\n\u001b[?2004l\r"]
[373.767707, "o", "\u001b[?2004h> "]
[373.767844, "o", "L = np.eye(n) - D_inv_sqrt @ A @ D_inv_sqrt\r\n\u001b[?2004l\r"]
[373.767863, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[373.767883, "o", "\u001b[?2004h> "]
[373.767911, "o", "K = 5\r\n\u001b[?2004l\r"]
[373.767925, "o", "\u001b[?2004h> "]
[373.768044, "o", "eigvals, eigvecs = np.linalg.eigh(L)\r\n\u001b[?2004l\r"]
[373.768059, "o", "\u001b[?2004h> "]
[373.768159, "o", "idx_sort = np.argsort(eigvals)\r\n\u001b[?2004l\r"]
[373.768174, "o", "\u001b[?2004h> "]
[373.768271, "o", "eigvals = eigvals[idx_sort]\r\n\u001b[?2004l\r"]
[373.768289, "o", "\u001b[?2004h> "]
[373.768381, "o", "eigvecs = eigvecs[:, idx_sort]\r\n\u001b[?2004l\r"]
[373.768397, "o", "\u001b[?2004h> "]
[373.768477, "o", "emb = eigvecs[:, 1:K+1]\r\n\u001b[?2004l\r"]
[373.768496, "o", "\u001b[?2004h> "]
[373.768668, "o", "row_norm = np.linalg.norm(emb, axis=1, keepdims=True)\r\n\u001b[?2004l\r"]
[373.768682, "o", "\u001b[?2004h> "]
[373.768835, "o", "row_norm = np.where(row_norm > 0, row_norm, 1.0)\r\n\u001b[?2004l\r"]
[373.76885, "o", "\u001b[?2004h> "]
[373.768936, "o", "emb_norm = emb / row_norm\r\n\u001b[?2004l\r"]
[373.768952, "o", "\u001b[?2004h> "]
[373.768965, "o", "\r\n\u001b[?2004l\r\u001b[?2004h"]
[373.768979, "o", "> "]
[373.769096, "o", "# --- Cluster per-beat embeddings ---\r\n\u001b[?2004l\r"]
[373.769112, "o", "\u001b[?2004h> "]
[373.769171, "o", "n_label_types = 3\r\n\u001b[?2004l\r"]
[373.769195, "o", "\u001b[?2004h> "]
[373.769321, "o", "per_beat_labels = AgglomerativeClustering(\r\n\u001b[?2004l\r"]
[373.769338, "o", "\u001b[?2004h> "]
[373.769545, "o", "    n_clusters=n_label_types, metric='euclidean', linkage='average'\r\n\u001b[?2004l\r"]
[373.769563, "o", "\u001b[?2004h> "]
[373.769639, "o", ").fit_predict(emb_norm)\r\n\u001b[?2004l\r"]
[373.769654, "o", "\u001b[?2004h> "]
[373.769819, "o", "print('label counts:', np.bincount(per_beat_labels))\r\n\u001b[?2004l\r"]
[373.769834, "o", "\u001b[?2004h> "]
[373.769848, "o", "\r\n\u001b[?2004l\r"]
[373.769862, "o", "\u001b[?2004h> "]
[373.769962, "o", "# --- Derive contiguous runs ---\r\n\u001b[?2004l\r"]
[373.769976, "o", "\u001b[?2004h> "]
[373.770016, "o", "runs = []\r\n\u001b[?2004l\r"]
[373.770029, "o", "\u001b[?2004h> "]
[373.770054, "o", "i = 0\r\n\u001b[?2004l\r"]
[373.770071, "o", "\u001b[?2004h> "]
[373.77012, "o", "while i < n:\r\n\u001b[?2004l\r"]
[373.770134, "o", "\u001b[?2004h> "]
[373.770172, "o", "    j = i\r\n\u001b[?2004l\r"]
[373.770191, "o", "\u001b[?2004h> "]
[373.770384, "o", "    while j < n and per_beat_labels[j] == per_beat_labels[i]:\r\n\u001b[?2004l\r"]
[373.770399, "o", "\u001b[?2004h"]
[373.770411, "o", "> "]
[373.770453, "o", "        j += 1\r\n\u001b[?2004l\r"]
[373.770468, "o", "\u001b[?2004h> "]
[373.770613, "o", "    runs.append((i, j, int(per_beat_labels[i])))\r\n\u001b[?2004l\r"]
[373.770627, "o", "\u001b[?2004h> "]
[373.770665, "o", "    i = j\r\n\u001b[?2004l\r"]
[373.770678, "o", "\u001b[?2004h> "]
[373.770774, "o", "print('initial runs:', runs)\r\n\u001b[?2004l\r"]
[373.770788, "o", "\u001b[?2004h> "]
[373.770802, "o", "\r\n\u001b[?2004l\r"]
[373.770815, "o", "\u001b[?2004h> "]
[373.771039, "o", "# Merge tiny runs (< 3 beats) into neighbor with most similar mean chroma\r\n\u001b[?2004l\r"]
[373.771054, "o", "\u001b[?2004h> "]
[373.771098, "o", "while True:\r\n\u001b[?2004l\r"]
[373.771112, "o", "\u001b[?2004h> "]
[373.771173, "o", "    merged = False\r\n\u001b[?2004l\r"]
[373.771192, "o", "\u001b[?2004h> "]
[373.771289, "o", "    for k in range(len(runs)):\r\n\u001b[?2004l\r"]
[373.771306, "o", "\u001b[?2004h> "]
[373.77138, "o", "        s, e, lab = runs[k]\r\n\u001b[?2004l\r"]
[373.771394, "o", "\u001b[?2004h> "]
[373.771486, "o", "        if (e - s) < 3 and len(runs) > 1:\r\n\u001b[?2004l\r"]
[373.771502, "o", "\u001b[?2004h> "]
[373.771622, "o", "            this_mean = chroma_sync[:, s:e].mean(axis=1)\r\n\u001b[?2004l\r"]
[373.771639, "o", "\u001b[?2004h> "]
[373.771691, "o", "            best = -1\r\n\u001b[?2004l\r"]
[373.771705, "o", "\u001b[?2004h> "]
[373.771773, "o", "            best_sim = -np.inf\r\n\u001b[?2004l\r"]
[373.771787, "o", "\u001b[?2004h> "]
[373.771863, "o", "            for kk in [k-1, k+1]:\r\n\u001b[?2004l\r"]
[373.771877, "o", "\u001b[?2004h> "]
[373.771967, "o", "                if 0 <= kk < len(runs):\r\n\u001b[?2004l\r"]
[373.771986, "o", "\u001b[?2004h"]
[373.771999, "o", "> "]
[373.772105, "o", "                    ns, ne, nlab = runs[kk]\r\n\u001b[?2004l\r"]
[373.772123, "o", "\u001b[?2004h> "]
[373.772256, "o", "                    nm = chroma_sync[:, ns:ne].mean(axis=1)\r\n\u001b[?2004l\r"]
[373.772277, "o", "\u001b[?2004h> "]
[373.77251, "o", "                    sim = float(np.dot(this_mean, nm) / (np.linalg.norm(this_mean) * np.linalg.norm(nm) + 1e-12))\r\n\u001b[?2004l\r"]
[373.772527, "o", "\u001b[?2004h> "]
[373.772611, "o", "                    if sim > best_sim:\r\n\u001b[?2004l\r"]
[373.772628, "o", "\u001b[?2004h> "]
[373.772709, "o", "                        best_sim = sim\r\n\u001b[?2004l\r"]
[373.772725, "o", "\u001b[?2004h> "]
[373.772797, "o", "                        best = kk\r\n\u001b[?2004l\r"]
[373.772821, "o", "\u001b[?2004h> "]
[373.77289, "o", "            if best == k - 1:\r\n\u001b[?2004l\r"]
[373.772908, "o", "\u001b[?2004h> "]
[373.772997, "o", "                ps, pe, plab = runs[k-1]\r\n\u001b[?2004l\r"]
[373.773017, "o", "\u001b[?2004h> "]
[373.773113, "o", "                runs[k-1] = (ps, e, int(plab))\r\n\u001b[?2004l\r"]
[373.773123, "o", "\u001b[?2004h> "]
[373.773228, "o", "                del runs[k]\r\n\u001b[?2004l\r\u001b[?2004h"]
[373.773279, "o", "> "]
[373.773308, "o", "            elif best == k + 1:\r\n\u001b[?2004l\r\u001b[?2004h"]
[373.773319, "o", "> "]
[373.773385, "o", "                ns, ne, nlab = runs[k+1]\r\n\u001b[?2004l\r"]
[373.773415, "o", "\u001b[?2004h> "]
[373.773494, "o", "                runs[k] = (s, ne, int(nlab))\r\n\u001b[?2004l\r"]
[373.773516, "o", "\u001b[?2004h> "]
[373.773574, "o", "                del runs[k+1]\r\n\u001b[?2004l\r"]
[373.773591, "o", "\u001b[?2004h> "]
[373.77363, "o", "            else:\r\n\u001b[?2004l\r"]
[373.773646, "o", "\u001b[?2004h> "]
[373.773732, "o", "                ps, pe, plab = runs[k-1]\r\n\u001b[?2004l\r"]
[373.773748, "o", "\u001b[?2004h> "]
[373.773855, "o", "                runs[k-1] = (ps, e, int(plab))\r\n\u001b[?2004l\r"]
[373.77387, "o", "\u001b[?2004h> "]
[373.773945, "o", "                del runs[k]\r\n\u001b[?2004l\r"]
[373.77396, "o", "\u001b[?2004h> "]
[373.774017, "o", "            merged = True\r\n\u001b[?2004l\r"]
[373.774033, "o", "\u001b[?2004h> "]
[373.774074, "o", "            break\r\n\u001b[?2004l\r"]
[373.774089, "o", "\u001b[?2004h> "]
[373.774133, "o", "    if not merged:\r\n\u001b[?2004l\r"]
[373.774149, "o", "\u001b[?2004h> "]
[373.774182, "o", "        break\r\n\u001b[?2004l\r"]
[373.774205, "o", "\u001b[?2004h> "]
[373.774284, "o", "print('after tiny merge:', runs)\r\n\u001b[?2004l\r"]
[373.774295, "o", "\u001b[?2004h"]
[373.774332, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[373.774502, "o", "# --- Reassign labels so that runs with similar chroma content share the same letter ---\r\n\u001b[?2004l\r"]
[373.774552, "o", "\u001b[?2004h"]
[373.774563, "o", "> "]
[373.774599, "o", "# Compute mean chroma per run\r\n\u001b[?2004l\r\u001b[?2004h"]
[373.774612, "o", "> "]
[373.774786, "o", "run_means = np.stack([chroma_sync[:, s:e].mean(axis=1) for (s, e, lab) in runs], axis=0)\r\n\u001b[?2004l\r"]
[373.774803, "o", "\u001b[?2004h> "]
[373.774833, "o", "# Normalize\r\n\u001b[?2004l\r"]
[373.774848, "o", "\u001b[?2004h> "]
[373.774971, "o", "rm_norms = np.linalg.norm(run_means, axis=1, keepdims=True)\r\n\u001b[?2004l\r"]
[373.774986, "o", "\u001b[?2004h> "]
[373.775089, "o", "rm_norms = np.where(rm_norms > 0, rm_norms, 1.0)\r\n\u001b[?2004l\r"]
[373.775104, "o", "\u001b[?2004h> "]
[373.775181, "o", "run_means_n = run_means / rm_norms\r\n\u001b[?2004l\r"]
[373.775212, "o", "\u001b[?2004h> "]
[373.775288, "o", "# Compute pairwise cosine similarity\r\n\u001b[?2004l\r"]
[373.775318, "o", "\u001b[?2004h> "]
[373.775392, "o", "sim_matrix = run_means_n @ run_means_n.T\r\n\u001b[?2004l\r"]
[373.775418, "o", "\u001b[?2004h> "]
[373.775556, "o", "# Cluster the runs themselves into label types based on chroma similarity\r\n\u001b[?2004l\r"]
[373.775581, "o", "\u001b[?2004h"]
[373.775592, "o", "> "]
[373.775633, "o", "nr = len(runs)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[373.775656, "o", "if nr >= 2:\r\n\u001b[?2004l\r"]
[373.775682, "o", "\u001b[?2004h"]
[373.775693, "o", "> "]
[373.775802, "o", "    # Use a threshold: merge runs with cosine sim > threshold\r\n\u001b[?2004l\r"]
[373.77583, "o", "\u001b[?2004h"]
[373.775854, "o", "> "]
[373.775899, "o", "    # First, greedily assign letters\r\n\u001b[?2004l\r"]
[373.775924, "o", "\u001b[?2004h"]
[373.775948, "o", "> "]
[373.775977, "o", "    letters = [None] * nr\r\n\u001b[?2004l\r"]
[373.776004, "o", "\u001b[?2004h> "]
[373.776044, "o", "    next_letter_idx = 0\r\n\u001b[?2004l\r"]
[373.776057, "o", "\u001b[?2004h> "]
[373.776112, "o", "    for k in range(nr):\r\n\u001b[?2004l\r"]
[373.776128, "o", "\u001b[?2004h"]
[373.776143, "o", "> "]
[373.776216, "o", "        if letters[k] is not None:\r\n\u001b[?2004l\r"]
[373.776253, "o", "\u001b[?2004h> "]
[373.776281, "o", "            continue\r\n\u001b[?2004l\r"]
[373.776312, "o", "\u001b[?2004h> "]
[373.776402, "o", "        cur_letter = chr(ord('A') + next_letter_idx)\r\n\u001b[?2004l\r"]
[373.776431, "o", "\u001b[?2004h"]
[373.776442, "o", "> "]
[373.776482, "o", "        next_letter_idx += 1\r\n\u001b[?2004l\r"]
[373.776494, "o", "\u001b[?2004h> "]
[373.77658, "o", "        letters[k] = cur_letter\r\n\u001b[?2004l\r"]
[373.776593, "o", "\u001b[?2004h> "]
[373.77667, "o", "        for kk in range(k+1, nr):\r\n\u001b[?2004l\r"]
[373.776681, "o", "\u001b[?2004h> "]
[373.776826, "o", "            if letters[kk] is None and sim_matrix[k, kk] > 0.85:\r\n\u001b[?2004l\r"]
[373.776842, "o", "\u001b[?2004h> "]
[373.776931, "o", "                letters[kk] = cur_letter\r\n\u001b[?2004l\r"]
[373.776943, "o", "\u001b[?2004h> "]
[373.776982, "o", "else:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[373.777033, "o", "    letters = ['A'] * nr\r\n\u001b[?2004l\r"]
[373.777063, "o", "\u001b[?2004h"]
[373.777077, "o", "> "]
[373.777137, "o", "print('letters per run:', letters)\r\n\u001b[?2004l\r"]
[373.77715, "o", "\u001b[?2004h> "]
[373.777181, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[373.777251, "o", "# --- Build time intervals ---\r\n\u001b[?2004l\r"]
[373.777264, "o", "\u001b[?2004h> "]
[373.777305, "o", "segments = []\r\n\u001b[?2004l\r\u001b[?2004h"]
[373.777336, "o", "> "]
[373.777412, "o", "for (s, e, lab), letter in zip(runs, letters):\r\n\u001b[?2004l\r"]
[373.777447, "o", "\u001b[?2004h> "]
[373.77748, "o", "    if e > s:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[373.777562, "o", "        t_start = float(beat_times[s])\r\n\u001b[?2004l\r"]
[373.777577, "o", "\u001b[?2004h"]
[373.77762, "o", "> "]
[373.777652, "o", "        if e < n:\r\n\u001b[?2004l\r"]
[373.777683, "o", "\u001b[?2004h> "]
[373.777737, "o", "            t_end = float(beat_times[e])\r\n\u001b[?2004l\r"]
[373.777766, "o", "\u001b[?2004h"]
[373.77778, "o", "> "]
[373.777808, "o", "        else:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[373.777876, "o", "            t_end = duration\r\n\u001b[?2004l\r"]
[373.77789, "o", "\u001b[?2004h> "]
[373.778045, "o", "        segments.append({'start': t_start, 'end': t_end, 'label': letter})\r\n\u001b[?2004l\r"]
[373.778057, "o", "\u001b[?2004h> "]
[373.778084, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[373.778141, "o", "segments[0]['start'] = 0.0\r\n\u001b[?2004l\r"]
[373.778168, "o", "\u001b[?2004h> "]
[373.778241, "o", "segments[-1]['end'] = duration\r\n\u001b[?2004l\r"]
[373.778266, "o", "\u001b[?2004h> \r\n"]
[373.778291, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[373.778367, "o", "# Merge adjacent segments with same label\r\n\u001b[?2004l\r"]
[373.778392, "o", "\u001b[?2004h> "]
[373.778428, "o", "merged = []\r\n\u001b[?2004l\r\u001b[?2004h> "]
[373.778476, "o", "for seg in segments:\r\n\u001b[?2004l\r"]
[373.778502, "o", "\u001b[?2004h"]
[373.778528, "o", "> "]
[373.778607, "o", "    if merged and merged[-1]['label'] == seg['label']:\r\n\u001b[?2004l\r"]
[373.778636, "o", "\u001b[?2004h> "]
[373.778708, "o", "        merged[-1]['end'] = seg['end']\r\n\u001b[?2004l\r"]
[373.778737, "o", "\u001b[?2004h"]
[373.778751, "o", ">     else:\r\n\u001b[?2004l\r"]
[373.778783, "o", "\u001b[?2004h"]
[373.778797, "o", "> "]
[373.778847, "o", "        merged.append(dict(seg))\r\n\u001b[?2004l\r"]
[373.778876, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[373.778962, "o", "# Drop / merge segments shorter than 0.5s\r\n\u001b[?2004l\r"]
[373.778991, "o", "\u001b[?2004h> "]
[373.779006, "o", "final = []\r\n\u001b[?2004l\r"]
[373.779044, "o", "\u001b[?2004h> "]
[373.779076, "o", "for seg in merged:\r\n\u001b[?2004l\r\u001b[?2004h"]
[373.779101, "o", "> "]
[373.77916, "o", "    dur = seg['end'] - seg['start']\r\n\u001b[?2004l\r"]
[373.779193, "o", "\u001b[?2004h> "]
[373.779227, "o", "    if dur <= 0.5:\r\n\u001b[?2004l\r"]
[373.779256, "o", "\u001b[?2004h> "]
[373.779313, "o", "        if final:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[373.779393, "o", "            final[-1]['end'] = seg['end']\r\n\u001b[?2004l\r"]
[373.779407, "o", "\u001b[?2004h> "]
[373.779445, "o", "        else:\r\n\u001b[?2004l\r\u001b[?2004h"]
[373.77949, "o", "> "]
[373.779521, "o", "            seg['start'] = 0.0\r\n\u001b[?2004l\r"]
[373.779554, "o", "\u001b[?2004h> "]
[373.779602, "o", "            final.append(seg)\r\n\u001b[?2004l\r"]
[373.779619, "o", "\u001b[?2004h> "]
[373.77965, "o", "    else:\r\n\u001b[?2004l\r\u001b[?2004h"]
[373.779694, "o", "> "]
[373.779728, "o", "        final.append(seg)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[373.779757, "o", "\r\n\u001b[?2004l\r"]
[373.779785, "o", "\u001b[?2004h> "]
[373.779822, "o", "# Bridge large gaps / overlaps\r\n\u001b[?2004l\r"]
[373.779855, "o", "\u001b[?2004h> "]
[373.779905, "o", "for i in range(1, len(final)):\r\n\u001b[?2004l\r"]
[373.779929, "o", "\u001b[?2004h> "]
[373.780022, "o", "    gap = final[i]['start'] - final[i-1]['end']\r\n\u001b[?2004l\r"]
[373.780045, "o", "\u001b[?2004h> "]
[373.780077, "o", "    if gap > 0.3:\r\n\u001b[?2004l\r"]
[373.780107, "o", "\u001b[?2004h> "]
[373.780224, "o", "        mid = (final[i-1]['end'] + final[i]['start']) / 2.0\r\n\u001b[?2004l\r"]
[373.780253, "o", "\u001b[?2004h> "]
[373.780321, "o", "        final[i-1]['end'] = mid\r\n\u001b[?2004l\r"]
[373.780345, "o", "\u001b[?2004h> "]
[373.780404, "o", "        final[i]['start'] = mid\r\n\u001b[?2004l\r"]
[373.780428, "o", "\u001b[?2004h> "]
[373.780472, "o", "    elif gap < -0.05:\r\n\u001b[?2004l\r"]
[373.780495, "o", "\u001b[?2004h> "]
[373.780612, "o", "        mid = (final[i-1]['end'] + final[i]['start']) / 2.0\r\n\u001b[?2004l\r"]
[373.780634, "o", "\u001b[?2004h> "]
[373.780696, "o", "        final[i-1]['end'] = mid\r\n\u001b[?2004l\r"]
[373.780706, "o", "\u001b[?2004h> "]
[373.780785, "o", "        final[i]['start'] = mid\r\n\u001b[?2004l\r"]
[373.780798, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[373.780817, "o", "\u001b[?2004h> "]
[373.780947, "o", "final = [s for s in final if (s['end'] - s['start']) > 0.5]\r\n\u001b[?2004l\r"]
[373.78098, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[373.780997, "o", "\u001b[?2004h> "]
[373.781014, "o", "renamed = []\r\n\u001b[?2004l\r"]
[373.781036, "o", "\u001b[?2004h> "]
[373.781064, "o", "label_map = {}\r\n\u001b[?2004l\r"]
[373.781081, "o", "\u001b[?2004h> "]
[373.781118, "o", "for s in final:\r\n\u001b[?2004l\r"]
[373.781135, "o", "\u001b[?2004h> "]
[373.781215, "o", "    if s['label'] not in label_map:\r\n\u001b[?2004l\r"]
[373.78123, "o", "\u001b[?2004h> "]
[373.78136, "o", "        label_map[s['label']] = chr(ord('A') + len(label_map))\r\n\u001b[?2004l\r"]
[373.78138, "o", "\u001b[?2004h> "]
[373.781591, "o", "    renamed.append({'start': float(s['start']), 'end': float(s['end']), 'label': label_map[s['label']]})\r\n\u001b[?2004l\r"]
[373.78161, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[373.781628, "o", "\u001b[?2004h> "]
[373.781714, "o", "renamed.sort(key=lambda x: x['start'])\r\n\u001b[?2004l\r"]
[373.781732, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[373.781753, "o", "\u001b[?2004h> "]
[373.781806, "o", "print('FINAL SEGMENTS:')\r\n\u001b[?2004l\r"]
[373.781825, "o", "\u001b[?2004h> "]
[373.781863, "o", "for s in renamed:\r\n\u001b[?2004l\r"]
[373.781881, "o", "\u001b[?2004h> "]
[373.782083, "o", "    print(f\"  {s['start']:.3f} -> {s['end']:.3f}  {s['label']}  (dur={s['end']-s['start']:.3f})\")\r\n\u001b[?2004l\r"]
[373.782103, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[373.782122, "o", "\u001b[?2004h> "]
[373.782192, "o", "with open(OUT_PATH, 'w') as f:\r\n\u001b[?2004l\r"]
[373.782211, "o", "\u001b[?2004h> "]
[373.782297, "o", "    json.dump(renamed, f, indent=2)\r\n\u001b[?2004l\r\u001b[?2004h"]
[373.782318, "o", "> "]
[373.782363, "o", "print('Wrote', OUT_PATH)\r\n\u001b[?2004l\r"]
[373.782385, "o", "\u001b[?2004h> "]
[373.782416, "o", "PYEOF\r\n\u001b[?2004l\r"]
[373.783461, "o", "\u001b[?2004h"]
[373.783535, "o", "root@c4161dc2-ada9-49cc-8b9e-0d9ae7705c95:~# "]
[373.783567, "o", "echo done\r\n\u001b[?2004l\rdone\r\n\u001b[?2004hroot@c4161dc2-ada9-49cc-8b9e-0d9ae7705c95:~# "]
[374.113648, "i", "python3 /home/user/segment.py\n"]
[374.113925, "o", "python3 /home/user/segment.py\r\n\u001b[?2004l\r"]
[377.061889, "o", "tempo=[89.10290948] n_beats=50 duration=33.0\r\n"]
[377.460328, "o", "label counts: [19 18 14]\r\ninitial runs: [(0, 18, 1), (18, 32, 2), (32, 51, 0)]\r\nafter tiny merge: [(0, 18, 1), (18, 32, 2), (32, 51, 0)]\r\n"]
[377.460441, "o", "letters per run: ['A', 'B', 'A']\r\nFINAL SEGMENTS:\r\n  0.000 -> 12.330  A  (dur=12.330)\r\n  12.330 -> 21.478  B  (dur=9.149)\r\n  21.478 -> 33.000  A  (dur=11.522)\r\n"]
[377.46059, "o", "Wrote /home/user/segments.json\r\n"]
[377.764056, "o", "\u001b[?2004hroot@c4161dc2-ada9-49cc-8b9e-0d9ae7705c95:~# "]
[409.949677, "i", "cat /home/user/segments.json\n"]
[409.949904, "o", "cat /home/user/segments.json\r\n"]
[409.949942, "o", "\u001b[?2004l\r"]
[409.950614, "o", "[\r\n  {\r\n    \"start\": 0.0,\r\n    \"end\": 12.329795918367347,\r\n    \"label\": \"A\"\r\n  },\r\n  {\r\n    \"start\": 12.329795918367347,\r\n    \"end\": 21.478458049886623,\r\n    \"label\": \"B\"\r\n  },\r\n  {\r\n    \"start\": 21.478458049886623,\r\n    \"end\": 33.0,\r\n    \"label\": \"A\"\r\n  }\r\n]"]
[409.95074, "o", "\u001b[?2004hroot@c4161dc2-ada9-49cc-8b9e-0d9ae7705c95:~# "]
[410.264351, "i", "python3 << 'EOF'\nimport json, re\nwith open('/home/user/segments.json') as f:\n    segs = json.load(f)\nlabels = [s['label'] for s in segs]\nassert len(segs) >= 3, 'need >=3 segments'\nassert len(set(labels)) >= 2, 'need >=2 distinct labels'\nassert max(labels.count(l) for l in set(labels)) >= 2, 'need reused label'\nassert segs[0]['start'] <= 0.3, f'first start too late: {segs[0][\"start\"]}'\nassert abs(segs[-1]['end'] - 33.0) < 0.5, f'last end off: {segs[-1][\"end\"]}'\nfor i, s in enumerate(segs):\n    assert s['start'] < s['end'], f'seg {i} start>=end'\n    assert s['end'] - s['start'] > 0.5, f'seg {i} too short'\n    assert re.match(r'^[A-Z]$', s['label']), f'bad label {s[\"label\"]}'\n    if i > 0:\n        gap = s['start'] - segs[i-1]['end']\n        assert gap <= 0.3, f'gap too large {i}: {gap}'\n        assert gap >= -0.05, f'overlap too large {i}: {gap}'\nprint('ALL CONSTRAINTS SATISFIED')\nprint('Labels:', labels)\nprint('Segments:')\nfor s in segs:\n    print(f\"  {s['start']:.3f} -> {s['end']:.3f}  {s['label']}\")\nEOF\n"]
[410.264678, "o", "python3 << 'EOF'\r\n\u001b[?2004l\r"]
[410.26476, "o", "\u001b[?2004h> "]
[410.264795, "o", "import json, re\r\n\u001b[?2004l\r\u001b[?2004h> "]
[410.264905, "o", "with open('/home/user/segments.json') as f:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[410.264965, "o", "    segs = json.load(f)\r\n\u001b[?2004l\r\u001b[?2004h"]
[410.265018, "o", "> "]
[410.265083, "o", "labels = [s['label'] for s in segs]\r\n\u001b[?2004l\r\u001b[?2004h> "]
[410.26517, "o", "assert len(segs) >= 3, 'need >=3 segments'\r\n\u001b[?2004l\r\u001b[?2004h> "]
[410.265319, "o", "assert len(set(labels)) >= 2, 'need >=2 distinct labels'\r\n\u001b[?2004l\r\u001b[?2004h> "]
[410.265503, "o", "assert max(labels.count(l) for l in set(labels)) >= 2, 'need reused label'\r\n\u001b[?2004l\r"]
[410.265558, "o", "\u001b[?2004h> "]
[410.265681, "o", "assert segs[0]['start'] <= 0.3, f'first start too late: {segs[0][\"start\"]}'\r\n\u001b[?2004l\r\u001b[?2004h"]
[410.265732, "o", "> "]
[410.265856, "o", "assert abs(segs[-1]['end'] - 33.0) < 0.5, f'last end off: {segs[-1][\"end\"]}'\r\n\u001b[?2004l\r\u001b[?2004h> "]
[410.265932, "o", "for i, s in enumerate(segs):\r\n\u001b[?2004l\r\u001b[?2004h"]
[410.265963, "o", "> "]
[410.266067, "o", "    assert s['start'] < s['end'], f'seg {i} start>=end'\r\n\u001b[?2004l\r\u001b[?2004h"]
[410.266122, "o", "> "]
[410.266221, "o", "    assert s['end'] - s['start'] > 0.5, f'seg {i} too short'\r\n\u001b[?2004l\r\u001b[?2004h"]
[410.266271, "o", "> "]
[410.26638, "o", "    assert re.match(r'^[A-Z]$', s['label']), f'bad label {s[\"label\"]}'\r\n\u001b[?2004l\r"]
[410.266404, "o", "\u001b[?2004h> "]
[410.266473, "o", "    if i > 0:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[410.266538, "o", "        gap = s['start'] - segs[i-1]['end']\r\n\u001b[?2004l\r\u001b[?2004h"]
[410.266562, "o", "> "]
[410.266667, "o", "        assert gap <= 0.3, f'gap too large {i}: {gap}'\r\n\u001b[?2004l\r\u001b[?2004h"]
[410.26669, "o", "> "]
[410.26683, "o", "        assert gap >= -0.05, f'overlap too large {i}: {gap}'\r\n\u001b[?2004l\r\u001b[?2004h> "]
[410.266963, "o", "print('ALL CONSTRAINTS SATISFIED')\r\n\u001b[?2004l\r\u001b[?2004h> "]
[410.267006, "o", "print('Labels:', labels)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[410.267092, "o", "print('Segments:')\r\n\u001b[?2004l\r\u001b[?2004h"]
[410.267142, "o", "> for s in segs:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[410.267223, "o", "    print(f\"  {s['start']:.3f} -> {s['end']:.3f}  {s['label']}\")\r\n\u001b[?2004l\r"]
