[322.00472, "o", "> "]
[322.004754, "o", "for i in range(1, len(final)):\r\n\u001b[?2004l\r\u001b[?2004h"]
[322.00477, "o", "> "]
[322.004811, "o", "    gap = final[i]['start'] - final[i-1]['end']\r\n\u001b[?2004l\r"]
[322.004819, "o", "\u001b[?2004h> "]
