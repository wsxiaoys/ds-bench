[95.386533, "i", "python3 << 'EOF'\nimport librosa, numpy as np\ny, sr = librosa.load('/home/user/input.wav', sr=22050, mono=True)\nprint('y shape:', y.shape, 'sr:', sr)\ntempo, beats = librosa.beat.beat_track(y=y, sr=sr)\nprint('tempo type:', type(tempo), 'tempo:', tempo, 'beats len:', len(beats))\n# Try with start_bpm\nfor sbpm in [60, 90, 120, 150]:\n    t2, b2 = librosa.beat.beat_track(y=y, sr=sr, start_bpm=sbpm)\n    print(f'start_bpm={sbpm}: tempo={t2}, beats={len(b2)}')\nEOF\n"]
