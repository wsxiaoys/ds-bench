[50.056392, "o", "        seg_means.append(chroma_sync[:, s:e].mean(axis=1))\r\n\u001b[?2004l\r\u001b[?2004h> "]
[50.056423, "o", "    else:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[50.056457, "o", "        seg_means.append(chroma_sync[:, s])\r\n\u001b[?2004l\r\u001b[?2004h> "]
[50.056483, "o", "seg_means = np.stack(seg_means, axis=0)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[50.056624, "o", "# Cluster segment means into a small number of label types\r\n\u001b[?2004l\r\u001b[?2004h> n_label_types = min(3, len(seg_means))\r\n\u001b[?2004l\r\u001b[?2004h> seg_labels = AgglomerativeClustering(\r\n\u001b[?2004l\r\u001b[?2004h>     n_clusters=n_label_types, metric='cosine', linkage='average'\r\n\u001b[?2004l\r\u001b[?2004h"]
[50.056654, "o", "> ).fit_predict(seg_means)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[50.056713, "o", "# Map numeric labels to uppercase letters in order of first appearance\r\n\u001b[?2004l\r\u001b[?2004h> letters = []\r\n\u001b[?2004l\r"]
[50.05674, "o", "\u001b[?2004h> seen = {}\r\n\u001b[?2004l\r\u001b[?2004h> "]
[50.056767, "o", "for lab in seg_labels:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[50.056799, "o", "    if lab not in seen:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[50.05683, "o", "        seen[lab] = chr(ord('A') + len(seen))\r\n\u001b[?2004l\r\u001b[?2004h> "]
[50.056857, "o", "    letters.append(seen[lab])\r\n\u001b[?2004l\r\u001b[?2004h> "]
[50.056967, "o", "print('seg_labels (raw):', seg_labels, 'letters:', letters)\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> # --- Build time intervals from beat indices ---\r\n\u001b[?2004l\r\u001b[?2004h> "]
[50.056997, "o", "# Use beat_times (in seconds). For each beat-range, start = beat_times[s]\r\n\u001b[?2004l\r\u001b[?2004h> "]
[50.057052, "o", "# and end = beat_times[e-1] + beat_duration. Actually let's use the audio\r\n\u001b[?2004l\r\u001b[?2004h> "]
[50.057094, "o", "# time grid from frames_to_time on beat_frames: but for end we want the\r\n\u001b[?2004l\r\u001b[?2004h> "]
[50.057132, "o", "# next beat time (or audio duration for last segment).\r\n\u001b[?2004l\r\u001b[?2004h> "]
[50.05717, "o", "segments = []\r\n\u001b[?2004l\r\u001b[?2004h> "]
[50.057224, "o", "for (s, e), lab in zip(beats_per_segment, letters):\r\n\u001b[?2004l\r\u001b[?2004h>     if e > s:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[50.057256, "o", "        t_start = float(beat_times[s])\r\n\u001b[?2004l\r\u001b[?2004h> "]
[50.057283, "o", "        if e < n:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[50.057314, "o", "            t_end = float(beat_times[e])\r\n\u001b[?2004l\r\u001b[?2004h>         else:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[50.057344, "o", "            t_end = duration\r\n\u001b[?2004l\r\u001b[?2004h>     else:\r\n\u001b[?2004l\r"]
[50.057374, "o", "\u001b[?2004h>         continue\r\n\u001b[?2004l\r\u001b[?2004h> "]
[50.05748, "o", "    segments.append({'start': t_start, 'end': t_end, 'label': lab})\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[50.057522, "o", "# Ensure first segment starts within 0.3s of 0 and last segment ends within 0.5s of duration\r\n\u001b[?2004l\r\u001b[?2004h> segments[0]['start'] = 0.0\r\n\u001b[?2004l\r\u001b[?2004h> "]
[50.05755, "o", "segments[-1]['end'] = duration\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[50.057604, "o", "# Merge adjacent segments with same label\r\n\u001b[?2004l\r\u001b[?2004h> merged = []\r\n\u001b[?2004l\r\u001b[?2004h> "]
[50.057633, "o", "for seg in segments:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[50.057682, "o", "    if merged and merged[-1]['label'] == seg['label']:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[50.05772, "o", "        merged[-1]['end'] = seg['end']\r\n\u001b[?2004l\r\u001b[?2004h>     else:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[50.057748, "o", "        merged.append(dict(seg))\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[50.057803, "o", "# Drop any segment shorter than 0.5s; if dropped, merge with neighbor\r\n\u001b[?2004l\r\u001b[?2004h> final = []\r\n\u001b[?2004l\r"]
[50.057831, "o", "\u001b[?2004h> for seg in merged:\r\n\u001b[?2004l\r\u001b[?2004h"]
[50.057859, "o", ">     dur = seg['end'] - seg['start']\r\n\u001b[?2004l\r"]
[50.057887, "o", "\u001b[?2004h>     if dur <= 0.5:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[50.057916, "o", "        if final:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[50.058015, "o", "            final[-1]['end'] = seg['end']\r\n\u001b[?2004l\r\u001b[?2004h>         else:\r\n\u001b[?2004l\r\u001b[?2004h>             seg['start'] = 0.0\r\n\u001b[?2004l\r\u001b[?2004h>             final.append(seg)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[50.058044, "o", "    else:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[50.058072, "o", "        final.append(seg)\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[50.058122, "o", "# Ensure gaps between adjacent segments <= 0.3s and overlaps <= 0.05s.\r\n\u001b[?2004l\r\u001b[?2004h> "]
[50.058151, "o", "# Bridge small gaps by snapping boundaries.\r\n\u001b[?2004l\r\u001b[?2004h> "]
[50.058179, "o", "for i in range(1, len(final)):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[50.058286, "o", "    gap = final[i]['start'] - final[i-1]['end']\r\n\u001b[?2004l\r\u001b[?2004h>     if gap > 0.3:\r\n\u001b[?2004l\r\u001b[?2004h>         # Move boundary halfway\r\n\u001b[?2004l\r\u001b[?2004h> "]
[50.058316, "o", "        mid = (final[i-1]['end'] + final[i]['start']) / 2.0\r\n\u001b[?2004l\r\u001b[?2004h> "]
[50.058341, "o", "        final[i-1]['end'] = mid\r\n\u001b[?2004l\r\u001b[?2004h> "]
[50.058369, "o", "        final[i]['start'] = mid\r\n\u001b[?2004l\r\u001b[?2004h> "]
[50.058398, "o", "    elif gap < -0.05:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[50.058425, "o", "        # Overlap too big: shift boundary\r\n\u001b[?2004l\r\u001b[?2004h> "]
[50.058528, "o", "        mid = (final[i-1]['end'] + final[i]['start']) / 2.0\r\n\u001b[?2004l\r\u001b[?2004h>         final[i-1]['end'] = mid\r\n\u001b[?2004l\r\u001b[?2004h>         final[i]['start'] = mid\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[50.058557, "o", "# Recheck min duration\r\n\u001b[?2004l\r\u001b[?2004h> "]
[50.058616, "o", "final = [s for s in final if (s['end'] - s['start']) > 0.5]\r\n\u001b[?2004l\r\u001b[?2004h> "]
[50.058643, "o", "# Reassign labels in order of appearance (so we always have A,B,... contiguous)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[50.058668, "o", "renamed = []\r\n\u001b[?2004l\r\u001b[?2004h> label_map = {}\r\n\u001b[?2004l\r"]
[50.058695, "o", "\u001b[?2004h> for s in final:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[50.058724, "o", "    if s['label'] not in label_map:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[50.058772, "o", "        label_map[s['label']] = chr(ord('A') + len(label_map))\r\n\u001b[?2004l\r\u001b[?2004h> "]
[50.05885, "o", "    renamed.append({'start': float(s['start']), 'end': float(s['end']), 'label': label_map[s['label']]})\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[50.05889, "o", "# Sort by start\r\n\u001b[?2004l\r\u001b[?2004h> renamed.sort(key=lambda x: x['start'])\r\n\u001b[?2004l\r\u001b[?2004h> "]
[50.05893, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> print('FINAL SEGMENTS:')\r\n\u001b[?2004l\r\u001b[?2004h> "]
[50.058957, "o", "for s in renamed:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[50.05902, "o", "    print(f\"  {s['start']:.3f} -> {s['end']:.3f}  {s['label']}  (dur={s['end']-s['start']:.3f})\")\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[50.059049, "o", "with open(OUT_PATH, 'w') as f:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[50.059104, "o", "    json.dump(renamed, f, indent=2)\r\n\u001b[?2004l\r\u001b[?2004h> print('Wrote', OUT_PATH)\r\n\u001b[?2004l\r\u001b[?2004h> PYEOF\r\n\u001b[?2004l\r"]
[50.060235, "o", "\u001b[?2004hroot@c4161dc2-ada9-49cc-8b9e-0d9ae7705c95:~# "]
[50.060266, "o", "echo \"wrote script\"\r\n\u001b[?2004l\rwrote script\r\n\u001b[?2004hroot@c4161dc2-ada9-49cc-8b9e-0d9ae7705c95:~# "]
