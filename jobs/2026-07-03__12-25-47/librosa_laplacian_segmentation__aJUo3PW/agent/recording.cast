[322.005777, "o", "\u001b[?2004h> "]
[322.005859, "o", "    print(f\"  {s['start']:.3f} -> {s['end']:.3f}  {s['label']}  (dur={s['end']-s['start']:.3f})\")\r\n\u001b[?2004l\r"]
[322.005877, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
