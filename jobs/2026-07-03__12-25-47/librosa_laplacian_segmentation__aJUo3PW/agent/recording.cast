[256.230812, "i", "python3 << 'EOF'\nimport json\nwith open('/home/user/segments.json') as f:\n    segs = json.load(f)\nprint('count:', len(segs))\nlabels = [s['label'] for s in segs]\nprint('labels:', labels)\nprint('distinct labels:', set(labels))\nprint('label reuse count:', {l: labels.count(l) for l in set(labels)})\n# Check constraints\nassert segs[0]['start'] < 0.3, f\"first start too late: {segs[0]['start']}\"\nassert abs(segs[-1]['end'] - 33.0) < 0.5, f\"last end too far from duration: {segs[-1]['end']}\"\nfor i, s in enumerate(segs):\n    assert s['start'] < s['end'], f\"seg {i}: start >= end\"\n    assert s['end'] - s['start'] > 0.5, f\"seg {i}: too short\"\n    import re\n    assert re.match(r'^[A-Z]$', s['label']), f\"seg {i}: bad label\"\n    if i > 0:\n        gap = s['start'] - segs[i-1]['end']\n        assert gap <= 0.3, f\"gap too large at {i}: {gap}\"\n        assert gap >= -0.05, f\"overlap too large at {i}: {gap}\"\nassert len(segs) >= 3, \"need at least 3 segments\"\nassert len(set(labels)) >= 2, \"need at least 2 distinct labels\"\nassert max(labels.count(l) for l in set(labels)) >= 2, \"need at least one reused label\"\nprint('ALL CHECKS PASSED')\nEOF\n"]
