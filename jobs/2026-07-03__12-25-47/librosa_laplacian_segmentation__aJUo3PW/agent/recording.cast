[322.005039, "o", "> "]
[322.005096, "o", "        mid = (final[i-1]['end'] + final[i]['start']) / 2.0\r\n\u001b[?2004l\r"]
[322.005114, "o", "\u001b[?2004h> "]
[322.005136, "o", "        final[i-1]['end'] = mid\r\n\u001b[?2004l\r\u001b[?2004h"]
[322.005152, "o", "> "]
[322.005176, "o", "        final[i]['start'] = mid\r\n\u001b[?2004l\r"]
[322.005196, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[322.005211, "o", "> "]
[322.005228, "o", "# Recheck min duration\r\n\u001b[?2004l\r\u001b[?2004h> "]
[322.005281, "o", "final = [s for s in final if (s['end'] - s['start']) > 0.5]\r\n\u001b[?2004l\r\u001b[?2004h"]
[322.005298, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h"]
[322.005314, "o", "> "]
[322.005337, "o", "# Reassign labels in order of appearance\r\n\u001b[?2004l\r"]
[322.005344, "o", "\u001b[?2004h> "]
[322.005375, "o", "renamed = []\r\n\u001b[?2004l\r\u001b[?2004h> "]
[322.005392, "o", "label_map = {}\r\n\u001b[?2004l\r\u001b[?2004h> "]
[322.005409, "o", "for s in final:\r\n\u001b[?2004l\r"]
[322.005425, "o", "\u001b[?2004h> "]
[322.005442, "o", "    if s['label'] not in label_map:\r\n\u001b[?2004l\r\u001b[?2004h"]
[322.005459, "o", "> "]
[322.005501, "o", "        label_map[s['label']] = chr(ord('A') + len(label_map))\r\n\u001b[?2004l\r\u001b[?2004h"]
[322.005516, "o", "> "]
[322.005619, "o", "    renamed.append({'start': float(s['start']), 'end': float(s['end']), 'label': label_map[s['label']]})\r\n\u001b[?2004l\r"]
[322.005635, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[322.00568, "o", "renamed.sort(key=lambda x: x['start'])\r\n\u001b[?2004l\r"]
[322.005696, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[322.005726, "o", "print('FINAL SEGMENTS:')\r\n\u001b[?2004l\r"]
[322.005742, "o", "\u001b[?2004h> "]
