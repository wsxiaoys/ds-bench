[50.05216, "i", "cat > /home/user/segment.py << 'PYEOF'\nimport json\nimport numpy as np\nimport librosa\nfrom sklearn.cluster import AgglomerativeClustering\n\nAUDIO_PATH = '/home/user/input.wav'\nOUT_PATH = '/home/user/segments.json'\n\n# --- Load audio ---\ny, sr = librosa.load(AUDIO_PATH, sr=22050, mono=True)\nduration = float(len(y) / sr)\n\n# --- Beat tracking ---\ntempo, beat_frames = librosa.beat.beat_track(y=y, sr=sr)\nbeat_times = librosa.frames_to_time(beat_frames, sr=sr)\nprint(f'tempo={tempo} n_beats={len(beat_frames)} duration={duration}')\n\n# --- Tonal feature (chroma_cqt) ---\nchroma = librosa.feature.chroma_cqt(y=y, sr=sr)\n# Beat-synchronous aggregation\nchroma_sync = librosa.util.sync(chroma, beat_frames, aggregate=np.median)\n\n# --- Recurrence / self-similarity ---\n# Use a wider context to capture structure\nR = librosa.segment.recurrence_matrix(\n    chroma_sync,\n    mode='affinity',\n    metric='cosine',\n    sparse=False,\n)\n# Enhance diagonals\nR_path = librosa.segment.path_enhance(R, n_segments=int(np.ceil(len(beat_frames) / 7.0)))\n\n# --- Sequential / local affinity ---\n# Local affinity: penalize distance to diagonal\nn = chroma_sync.shape[1]\nseq = np.zeros((n, n), dtype=np.float64)\nband = 7  # half-bandwidth\nfor i in range(n):\n    lo = max(0, i - band)\n    hi = min(n, i + band + 1)\n    d = np.abs(np.arange(lo, hi) - i)\n    seq[i, lo:hi] = np.exp(-(d ** 2) / (2.0 * (band / 2.0) ** 2))\n\n# Combine repetition (path-enhanced) with sequential affinity\nalpha = 0.5\nA = alpha * R_path + (1.0 - alpha) * seq\nnp.fill_diagonal(A, 1.0)\n# Symmetrize\nA = 0.5 * (A + A.T)\n\n# --- Symmetric normalized graph Laplacian ---\ndeg = A.sum(axis=1)\nwith np.errstate(divide='ignore'):\n    d_inv_sqrt = np.where(deg > 0, 1.0 / np.sqrt(deg), 0.0)\nD_inv_sqrt = np.diag(d_inv_sqrt)\nL = np.eye(n) - D_inv_sqrt @ A @ D_inv_sqrt\n\n# Bottom K eigenvectors (smallest eigenvalues)\nK = 5\neigvals, eigvecs = np.linalg.eigh(L)\nidx_sort = np.argsort(eigvals)\neigvals = eigvals[idx_sort]\neigvecs = eigvecs[:, idx_sort]\n# Skip the first trivial eigenvector (eigval ~ 0)\nemb = eigvecs[:, 1:K+1]\n# Row-normalize embedding\nrow_norm = np.linalg.norm(emb, axis=1, keepdims=True)\nrow_norm = np.where(row_norm > 0, row_norm, 1.0)\nemb_norm = emb / row_norm\n\n# --- Agglomerative clustering ---\n# Choose number of clusters. We want at least 3 segments and reuse of labels.\n# Use librosa.segment.agglomerative on the chroma_sync directly with cosine\n# to get a hierarchical segmentation that often yields A/B/A patterns.\n# That function returns boundary frame indices.\nboundary_frames = librosa.segment.agglomerative(chroma_sync, n_clusters=3)\n# This gives frame indices of segment boundaries (not including last frame).\nprint('boundary_frames:', boundary_frames)\n\n# Convert boundary frames to beat indices\n# boundary_frames are frame indices into chroma_sync (== beat indices)\nbeats_per_segment = []\nprev = 0\nfor bf in boundary_frames:\n    beats_per_segment.append((prev, int(bf)))\n    prev = int(bf)\nbeats_per_segment.append((prev, n))\nprint('beats_per_segment:', beats_per_segment)\n\n# Now, assign a label to each segment such that segments with similar\n# chroma content reuse labels (A/B/A pattern).\n# Compute mean chroma per segment and cluster these mean vectors.\nseg_means = []\nfor (s, e) in beats_per_segment:\n    if e > s:\n        seg_means.append(chroma_sync[:, s:e].mean(axis=1))\n    else:\n        seg_means.append(chroma_sync[:, s])\nseg_means = np.stack(seg_means, axis=0)\n# Cluster segment means into a small number of label types\nn_label_types = min(3, len(seg_means))\nseg_labels = AgglomerativeClustering(\n    n_clusters=n_label_types, metric='cosine', linkage='average'\n).fit_predict(seg_means)\n# Map numeric labels to uppercase letters in order of first appearance\nletters = []\nseen = {}\nfor lab in seg_labels:\n    if lab not in seen:\n        seen[lab] = chr(ord('A') + len(seen))\n    letters.append(seen[lab])\nprint('seg_labels (raw):', seg_labels, 'letters:', letters)\n\n# --- Build time intervals from beat indices ---\n# Use beat_times (in seconds). For each beat-range, start = beat_times[s]\n# and end = beat_times[e-1] + be"]
[50.052206, "i", "at_duration. Actually let's use the audio\n# time grid from frames_to_time on beat_frames: but for end we want the\n# next beat time (or audio duration for last segment).\nsegments = []\nfor (s, e), lab in zip(beats_per_segment, letters):\n    if e > s:\n        t_start = float(beat_times[s])\n        if e < n:\n            t_end = float(beat_times[e])\n        else:\n            t_end = duration\n    else:\n        continue\n    segments.append({'start': t_start, 'end': t_end, 'label': lab})\n\n# Ensure first segment starts within 0.3s of 0 and last segment ends within 0.5s of duration\nsegments[0]['start'] = 0.0\nsegments[-1]['end'] = duration\n\n# Merge adjacent segments with same label\nmerged = []\nfor seg in segments:\n    if merged and merged[-1]['label'] == seg['label']:\n        merged[-1]['end'] = seg['end']\n    else:\n        merged.append(dict(seg))\n\n# Drop any segment shorter than 0.5s; if dropped, merge with neighbor\nfinal = []\nfor seg in merged:\n    dur = seg['end'] - seg['start']\n    if dur <= 0.5:\n        if final:\n            final[-1]['end'] = seg['end']\n        else:\n            seg['start'] = 0.0\n            final.append(seg)\n    else:\n        final.append(seg)\n\n# Ensure gaps between adjacent segments <= 0.3s and overlaps <= 0.05s.\n# Bridge small gaps by snapping boundaries.\nfor i in range(1, len(final)):\n    gap = final[i]['start'] - final[i-1]['end']\n    if gap > 0.3:\n        # Move boundary halfway\n        mid = (final[i-1]['end'] + final[i]['start']) / 2.0\n        final[i-1]['end'] = mid\n        final[i]['start'] = mid\n    elif gap < -0.05:\n        # Overlap too big: shift boundary\n        mid = (final[i-1]['end'] + final[i]['start']) / 2.0\n        final[i-1]['end'] = mid\n        final[i]['start'] = mid\n\n# Recheck min duration\nfinal = [s for s in final if (s['end'] - s['start']) > 0.5]\n# Reassign labels in order of appearance (so we always have A,B,... contiguous)\nrenamed = []\nlabel_map = {}\nfor s in final:\n    if s['label'] not in label_map:\n        label_map[s['label']] = chr(ord('A') + len(label_map))\n    renamed.append({'start': float(s['start']), 'end': float(s['end']), 'label': label_map[s['label']]})\n\n# Sort by start\nrenamed.sort(key=lambda x: x['start'])\n\nprint('FINAL SEGMENTS:')\nfor s in renamed:\n    print(f\"  {s['start']:.3f} -> {s['end']:.3f}  {s['label']}  (dur={s['end']-s['start']:.3f})\")\n\nwith open(OUT_PATH, 'w') as f:\n    json.dump(renamed, f, indent=2)\nprint('Wrote', OUT_PATH)\nPYEOF\necho \"wrote script\"\n"]
