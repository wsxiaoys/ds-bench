[322.004555, "o", "\u001b[?2004h> "]
[322.004572, "o", "        else:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[322.004594, "o", "            seg['start'] = 0.0\r\n\u001b[?2004l\r\u001b[?2004h> "]
