[140.819627, "i", "python3 << 'EOF'\nimport librosa, numpy as np\ny, sr = librosa.load('/home/user/input.wav', sr=22050, mono=True)\n\n# Pass onset_envelope explicitly\noe = librosa.onset.onset_strength(y=y, sr=sr, hop_length=512)\nprint('oe shape:', oe.shape)\nfor tight in [50, 100, 200, 400]:\n    t, b = librosa.beat.beat_track(onset_envelope=oe, sr=sr, hop_length=512, tightness=tight)\n    print(f'tightness={tight}: tempo={t}, beats={len(b)}')\n\n# Maybe the issue is librosa 0.11.0 has a bug. Try with looser settings.\nt, b = librosa.beat.beat_track(onset_envelope=oe, sr=sr, hop_length=512, tightness=200, start_bpm=120.0)\nprint('explicit:', t, len(b), b[:10] if len(b)>0 else 'empty')\nEOF\n"]
