[120.21865, "i", "python3 << 'EOF'\nimport librosa, numpy as np\ny, sr = librosa.load('/home/user/input.wav', sr=22050, mono=True)\nprint('y non-zero:', np.count_nonzero(y), '/', len(y))\nprint('RMS:', np.sqrt(np.mean(y**2)))\nprint('max abs:', np.max(np.abs(y)))\n# Onset envelope\noe = librosa.onset.onset_strength(y=y, sr=sr)\nprint('onset envelope shape:', oe.shape, 'min:', oe.min(), 'max:', oe.max(), 'mean:', oe.mean())\n# Try with sparse=False\nimport inspect\nprint('beat_track defaults...')\nt, b = librosa.beat.beat_track(y=y, sr=sr, sparse=False)\nprint('sparse=False:', t, len(b))\nEOF\n"]
