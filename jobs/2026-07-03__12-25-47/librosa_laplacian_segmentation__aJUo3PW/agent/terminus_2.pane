[?2004l[?2004h> n_seg_path = max(2, int(np.ceil(n / 7.0)))
[?2004l[?2004h> R_path = librosa.segment.path_enhance(R, n_seg_path)
[?2004l[?2004h> 
[?2004l[?2004h> # --- Sequential / local affinity ---
[?2004l[?2004h> seq = np.zeros((n, n), dtype=np.float64)
[?2004l[?2004h> band = 7
[?2004l[?2004h> for i in range(n):
[?2004l[?2004h>     lo = max(0, i - band)
[?2004l=[?2004h>     hi = min(n, i + band + 1)
[?2004l[?2004h>     d = np.abs(np.arange(lo, hi) - i)
[?2004l[?2004h>     seq[i, lo:hi] = np.exp(-(d ** 2) / (2.0 * (band / 2.0) ** 2))
[?2004l[?2004h> 
[?2004l[?2004h> # Combine repetition (path-enhanced) with sequential affinity
[?2004l[?2004h> alpha = 0.5
[?2004l[?2004h> A = alpha * R_path + (1.0 - alpha) * seq
[?2004l[?2004h> np.fill_diagonal(A, 1.0)
