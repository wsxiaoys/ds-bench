[?2004l[?2004h> 
[?2004l[?2004h> # --- Tonal feature (chroma_cqt) ---
[?2004l[?2004h> chroma = librosa.feature.chroma_cqt(y=y, sr=sr)
[?2004l[?2004h> # Beat-synchronous aggregation
[?2004l[?2004h> chroma_sync = librosa.util.sync(chroma, beat_frames, aggregate=np.median)
[?2004l[?2004h> 
[?2004l[?2004h> # --- Recurrence / self-similarity ---
[?2004l[?2004h> # Use a wider context to capture structure
[?2004l[?2004h> R = librosa.segment.recurrence_matrix(
[?2004l[?2004h>     chroma_sync,
[?2004l[?2004h>     mode='affinity',
[?2004l[?2004h>     metric='cosine',
[?2004l[?2004h>     sparse=False,
[?2004l[?2004h> )
[?2004l[?2004h> # Enhance diagonals
[?2004leg[?2004h> R_path = librosa.segment.path_enhance(R, n_segments=int(np.ceil(len(beat_frames) / 7.0)))
[?2004l[?2004h> 
[?2004l[?2004h> # --- Sequential / local affinity ---
[?2004l[?2004h> # Local affinity: penalize distance to diagonal
[?2004l[?2004h> n = chroma_sync.shape[1]
[?2004leg)
[?2004h> seq = np.zeros((n, n), dtype=np.float64)
[?2004ln[?2004h> band = 7  # half-bandwidth
[?2004l[?2004h> for i in range(n):
[?2004ln[?2004h>     lo = max(0, i - band)
[?2004l[?2004h>     hi = min(n, i + band + 1)
[?2004l[?2004h>     d = np.abs(np.arange(lo, hi) - i)
[?2004l[?2004h>     seq[i, lo:hi] = np.exp(-(d ** 2) / (2.0 * (band / 2.0) ** 2))
[?2004l[?2004h> 
[?2004l[?2004h> # Combine repetition (path-enhanced) with sequential affinity
[?2004l[?2004h> alpha = 0.5
[?2004l[?2004h> A = alpha * R_path + (1.0 - alpha) * seq
[?2004l[?2004h> np.fill_diagonal(A, 1.0)
[?2004l[?2004h> # Symmetrize
[?2004l[?2004h> A = 0.5 * (A + A.T)
[?2004l[?2004h> 
[?2004l[?2004h> # --- Symmetric normalized graph Laplacian ---
[?2004l[?2004h> deg = A.sum(axis=1)
[?2004l[?2004h> with np.errstate(divide='ignore'):
[?2004l[?2004h>     d_inv_sqrt = np.where(deg > 0, 1.0 / np.sqrt(deg), 0.0)
[?2004l[?2004h> D_inv_sqrt = np.diag(d_inv_sqrt)
[?2004l[?2004h> L = np.eye(n) - D_inv_sqrt @ A @ D_inv_sqrt
[?2004l[?2004h> 
[?2004l[?2004h> # Bottom K eigenvectors (smallest eigenvalues)
[?2004l[?2004h> K = 5
[?2004l[?2004h> eigvals, eigvecs = np.linalg.eigh(L)
[?2004l[?2004h> idx_sort = np.argsort(eigvals)
[?2004l[?2004h> eigvals = eigvals[idx_sort]
[?2004l[?2004h> eigvecs = eigvecs[:, idx_sort]
[?2004l[?2004h> # Skip the first trivial eigenvector (eigval ~ 0)
[?2004l[?2004h> emb = eigvecs[:, 1:K+1]
[?2004l[?2004h> # Row-normalize embedding
[?2004l[?2004h> row_norm = np.linalg.norm(emb, axis=1, keepdims=True)
[?2004l[?2004h> row_norm = np.where(row_norm > 0, row_norm, 1.0)
[?2004l[?2004h> emb_norm = emb / row_norm
[?2004l[?2004h> 
[?2004lN[?2004h> # --- Agglomerative clustering ---
[?2004l[?2004h> # Choose number of clusters. We want at least 3 segments and reuse of labels.
[?2004l[?2004h> # Use librosa.segment.agglomerative on the chroma_sync directly with cosine
[?2004l[?2004h> # to get a hierarchical segmentation that often yields A/B/A patterns.
[?2004l[?2004h> # That function returns boundary frame indices.
[?2004l[?2004h> boundary_frames = librosa.segment.agglomerative(chroma_sync, n_clusters=3)
[?2004l[?2004h> # This gives frame indices of segment boundaries (not including last frame).
[?2004l[?2004h> print('boundary_frames:', boundary_frames)
[?2004l[?2004h> 
[?2004l[?2004h> # Convert boundary frames to beat indices
[?2004l[?2004h> # boundary_frames are frame indices into chroma_sync (== beat indices)
[?2004l[?2004h> beats_per_segment = []
[?2004l[?2004h> prev = 0
[?2004l[?2004h> for bf in boundary_frames:
[?2004l[?2004h>     beats_per_segment.append((prev, int(bf)))
[?2004l[?2004h>     prev = int(bf)
[?2004l[?2004h> beats_per_segment.append((prev, n))
[?2004l[?2004h> print('beats_per_segment:', beats_per_segment)
[?2004l[?2004h> 
[?2004l[?2004h> # Now, assign a label to each segment such that segments with similar
[?2004l[?2004h> # chroma content reuse labels (A/B/A pattern).
[?2004l[?2004h> # Compute mean chroma per segment and cluster these mean vectors.
[?2004l[?2004h> seg_means = []
[?2004l[?2004h> for (s, e) in beats_per_segment:
[?2004l[?2004h>     if e > s:
[?2004l[?2004h>         seg_means.append(chroma_sync[:, s:e].mean(axis=1))
[?2004l[?2004h>     else:
[?2004l[?2004h>         seg_means.append(chroma_sync[:, s])
[?2004l[?2004h> seg_means = np.stack(seg_means, axis=0)
[?2004l[?2004h> # Cluster segment means into a small number of label types
[?2004l[?2004h> n_label_types = min(3, len(seg_means))
[?2004l[?2004h> seg_labels = AgglomerativeClustering(
[?2004l[?2004h>     n_clusters=n_label_types, metric='cosine', linkage='average'
[?2004l[?2004h> ).fit_predict(seg_means)
[?2004l[?2004h> # Map numeric labels to uppercase letters in order of first appearance
[?2004l[?2004h> letters = []
[?2004l[?2004h> seen = {}
[?2004l[?2004h> for lab in seg_labels:
[?2004l[?2004h>     if lab not in seen:
[?2004l[?2004h>         seen[lab] = chr(ord('A') + len(seen))
[?2004l[?2004h>     letters.append(seen[lab])
[?2004l[?2004h> print('seg_labels (raw):', seg_labels, 'letters:', letters)
[?2004l[?2004h> 
[?2004l[?2004h> # --- Build time intervals from beat indices ---
[?2004l[?2004h> # Use beat_times (in seconds). For each beat-range, start = beat_times[s]
[?2004l[?2004h> # and end = beat_times[e-1] + beat_duration. Actually let's use the audio
[?2004l[?2004h> # time grid from frames_to_time on beat_frames: but for end we want the
[?2004l[?2004h> # next beat time (or audio duration for last segment).
[?2004l[?2004h> segments = []
[?2004l[?2004h> for (s, e), lab in zip(beats_per_segment, letters):
[?2004l[?2004h>     if e > s:
[?2004l[?2004h>         t_start = float(beat_times[s])
[?2004l[?2004h>         if e < n:
[?2004l[?2004h>             t_end = float(beat_times[e])
[?2004l[?2004h>         else:
[?2004l[?2004h>             t_end = duration
[?2004l[?2004h>     else:
[?2004l[?2004h>         continue
[?2004l[?2004h>     segments.append({'start': t_start, 'end': t_end, 'label': lab})
[?2004l[?2004h> 
[?2004l[?2004h> # Ensure first segment starts within 0.3s of 0 and last segment ends within 0.5s of duration
[?2004l[?2004h> segments[0]['start'] = 0.0
[?2004l[?2004h> segments[-1]['end'] = duration
[?2004l[?2004h> 
[?2004l[?2004h> # Merge adjacent segments with same label
[?2004l[?2004h> merged = []
[?2004l[?2004h> for seg in segments:
[?2004l[?2004h>     if merged and merged[-1]['label'] == seg['label']:
[?2004l[?2004h>         merged[-1]['end'] = seg['end']
[?2004l[?2004h>     else:
[?2004l[?2004h>         merged.append(dict(seg))
[?2004l[?2004h> 
[?2004l[?2004h> # Drop any segment shorter than 0.5s; if dropped, merge with neighbor
[?2004l[?2004h> final = []
[?2004l[?2004h> for seg in merged:
[?2004l[?2004h>     dur = seg['end'] - seg['start']
[?2004l[?2004h>     if dur <= 0.5:
[?2004l[?2004h>         if final:
[?2004l[?2004h>             final[-1]['end'] = seg['end']
[?2004l[?2004h>         else:
[?2004l[?2004h>             seg['start'] = 0.0
[?2004l[?2004h>             final.append(seg)
[?2004l[?2004h>     else:
[?2004l[?2004h>         final.append(seg)
[?2004l[?2004h> 
[?2004l[?2004h> # Ensure gaps between adjacent segments <= 0.3s and overlaps <= 0.05s.
[?2004l[?2004h> # Bridge small gaps by snapping boundaries.
[?2004l[?2004h> for i in range(1, len(final)):
[?2004l[?2004h>     gap = final[i]['start'] - final[i-1]['end']
[?2004l[?2004h>     if gap > 0.3:
[?2004l[?2004h>         # Move boundary halfway
[?2004l[?2004h>         mid = (final[i-1]['end'] + final[i]['start']) / 2.0
[?2004l[?2004h>         final[i-1]['end'] = mid
[?2004l[?2004h>         final[i]['start'] = mid
[?2004l[?2004h>     elif gap < -0.05:
