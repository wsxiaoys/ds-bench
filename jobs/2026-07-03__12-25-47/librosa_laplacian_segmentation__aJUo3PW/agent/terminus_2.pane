[?2004l[?2004h>             # find best neighbor to merge with
[?2004l[?2004h>             this_mean = chroma_sync[:, s:e].mean(axis=1)
[?2004l[?2004h>             best = -1
[?2004l[?2004h>             best_sim = -np.inf
[?2004l[?2004h>             for kk in [k-1, k+1]:
