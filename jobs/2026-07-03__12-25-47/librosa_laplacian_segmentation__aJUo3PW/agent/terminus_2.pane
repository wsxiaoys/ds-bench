[?2004l[?2004h> n = chroma_sync.shape[1]
[?2004l[?2004h> n_seg_path = max(2, int(np.ceil(n / 7.0)))
[?2004l[?2004h> R_path = librosa.segment.path_enhance(R, n_seg_path)
[?2004l[?2004h> 
[?2004l[?2004h> # --- Sequential affinity ---
[?2004l[?2004h> seq = np.zeros((n, n), dtype=np.float64)
[?2004l[?2004h> band = 7
[?2004l[?2004h> for i in range(n):
[?2004l[?2004h>     lo = max(0, i - band)
[?2004l[?2004h>     hi = min(n, i + band + 1)
[?2004l[?2004h>     d = np.abs(np.arange(lo, hi) - i)
[?2004l[?2004h>     seq[i, lo:hi] = np.exp(-(d ** 2) / (2.0 * (band / 2.0) ** 2))
[?2004l[?2004h> 
[?2004l.[?2004h> alpha = 0.5
[?2004l[?2004h> A = alpha * R_path + (1.0 - alpha) * seq
[?2004l[?2004h> np.fill_diagonal(A, 1.0)
[?2004l[?2004h> A = 0.5 * (A + A.T)
[?2004l[?2004h> 
[?2004l[?2004h> # --- Symmetric normalized graph Laplacian ---
[?2004l[?2004h> deg = A.sum(axis=1)
[?2004l[?2004h> with np.errstate(divide='ignore'):
[?2004l[?2004h>     d_inv_sqrt = np.where(deg > 0, 1.0 / np.sqrt(deg), 0.0)
[?2004l[?2004h> D_inv_sqrt = np.diag(d_inv_sqrt)
[?2004l[?2004h> L = np.eye(n) - D_inv_sqrt @ A @ D_inv_sqrt
[?2004l[?2004h> 
[?2004l[?2004h> K = 5
[?2004l[?2004h> eigvals, eigvecs = np.linalg.eigh(L)
[?2004l[?2004h> idx_sort = np.argsort(eigvals)
[?2004l[?2004h> eigvals = eigvals[idx_sort]
[?2004l[?2004h> eigvecs = eigvecs[:, idx_sort]
[?2004l[?2004h> emb = eigvecs[:, 1:K+1]
[?2004l[?2004h> row_norm = np.linalg.norm(emb, axis=1, keepdims=True)
[?2004l[?2004h> row_norm = np.where(row_norm > 0, row_norm, 1.0)
[?2004l[?2004h> emb_norm = emb / row_norm
[?2004l[?2004h> 
[?2004l[?2004h> # --- Cluster per-beat embeddings ---
[?2004l[?2004h> n_label_types = 3
[?2004l[?2004h> per_beat_labels = AgglomerativeClustering(
[?2004l[?2004h>     n_clusters=n_label_types, metric='euclidean', linkage='average'
[?2004l[?2004h> ).fit_predict(emb_norm)
[?2004l[?2004h> print('label counts:', np.bincount(per_beat_labels))
[?2004l[?2004h> 
[?2004l[?2004h> # --- Derive contiguous runs ---
[?2004l[?2004h> runs = []
[?2004l[?2004h> i = 0
[?2004l[?2004h> while i < n:
[?2004l[?2004h>     j = i
[?2004l[?2004h>     while j < n and per_beat_labels[j] == per_beat_labels[i]:
[?2004l[?2004h>         j += 1
[?2004l[?2004h>     runs.append((i, j, int(per_beat_labels[i])))
[?2004l[?2004h>     i = j
[?2004l[?2004h> print('initial runs:', runs)
[?2004l[?2004h> 
[?2004l[?2004h> # Merge tiny runs (< 3 beats) into neighbor with most similar mean chroma
[?2004l[?2004h> while True:
[?2004l[?2004h>     merged = False
[?2004l[?2004h>     for k in range(len(runs)):
[?2004l[?2004h>         s, e, lab = runs[k]
[?2004l[?2004h>         if (e - s) < 3 and len(runs) > 1:
[?2004l[?2004h>             this_mean = chroma_sync[:, s:e].mean(axis=1)
[?2004l[?2004h>             best = -1
[?2004l[?2004h>             best_sim = -np.inf
[?2004l[?2004h>             for kk in [k-1, k+1]:
[?2004l[?2004h>                 if 0 <= kk < len(runs):
[?2004l[?2004h>                     ns, ne, nlab = runs[kk]
[?2004l[?2004h>                     nm = chroma_sync[:, ns:ne].mean(axis=1)
[?2004l[?2004h>                     sim = float(np.dot(this_mean, nm) / (np.linalg.norm(this_mean) * np.linalg.norm(nm) + 1e-12))
[?2004l[?2004h>                     if sim > best_sim:
[?2004l[?2004h>                         best_sim = sim
[?2004l[?2004h>                         best = kk
[?2004l[?2004h>             if best == k - 1:
[?2004l[?2004h>                 ps, pe, plab = runs[k-1]
[?2004l[?2004h>                 runs[k-1] = (ps, e, int(plab))
[?2004l[?2004h>                 del runs[k]
[?2004l[?2004h>             elif best == k + 1:
[?2004l[?2004h>                 ns, ne, nlab = runs[k+1]
[?2004l[?2004h>                 runs[k] = (s, ne, int(nlab))
[?2004l[?2004h>                 del runs[k+1]
[?2004l[?2004h>             else:
[?2004l[?2004h>                 ps, pe, plab = runs[k-1]
[?2004l[?2004h>                 runs[k-1] = (ps, e, int(plab))
[?2004l[?2004h>                 del runs[k]
[?2004l[?2004h>             merged = True
[?2004l[?2004h>             break
[?2004l[?2004h>     if not merged:
[?2004l[?2004h>         break
[?2004l[?2004h> print('after tiny merge:', runs)
[?2004l[?2004h> 
[?2004l[?2004h> # --- Reassign labels so that runs with similar chroma content share the same letter ---
[?2004l[?2004h> # Compute mean chroma per run
[?2004l[?2004h> run_means = np.stack([chroma_sync[:, s:e].mean(axis=1) for (s, e, lab) in runs], axis=0)
[?2004l[?2004h> # Normalize
[?2004l[?2004h> rm_norms = np.linalg.norm(run_means, axis=1, keepdims=True)
[?2004l[?2004h> rm_norms = np.where(rm_norms > 0, rm_norms, 1.0)
[?2004l[?2004h> run_means_n = run_means / rm_norms
[?2004l[?2004h> # Compute pairwise cosine similarity
[?2004l[?2004h> sim_matrix = run_means_n @ run_means_n.T
[?2004l[?2004h> # Cluster the runs themselves into label types based on chroma similarity
[?2004l[?2004h> nr = len(runs)
[?2004l[?2004h> if nr >= 2:
[?2004l[?2004h>     # Use a threshold: merge runs with cosine sim > threshold
[?2004l[?2004h>     # First, greedily assign letters
[?2004l[?2004h>     letters = [None] * nr
[?2004l[?2004h>     next_letter_idx = 0
[?2004l[?2004h>     for k in range(nr):
[?2004l[?2004h>         if letters[k] is not None:
[?2004l[?2004h>             continue
[?2004l[?2004h>         cur_letter = chr(ord('A') + next_letter_idx)
[?2004l[?2004h>         next_letter_idx += 1
[?2004l[?2004h>         letters[k] = cur_letter
[?2004l[?2004h>         for kk in range(k+1, nr):
[?2004l[?2004h>             if letters[kk] is None and sim_matrix[k, kk] > 0.85:
[?2004l[?2004h>                 letters[kk] = cur_letter
[?2004l[?2004h> else:
[?2004l[?2004h>     letters = ['A'] * nr
[?2004l[?2004h> print('letters per run:', letters)
[?2004l[?2004h> 
[?2004l[?2004h> # --- Build time intervals ---
[?2004l[?2004h> segments = []
[?2004l[?2004h> for (s, e, lab), letter in zip(runs, letters):
[?2004l[?2004h>     if e > s:
[?2004l[?2004h>         t_start = float(beat_times[s])
[?2004l[?2004h>         if e < n:
[?2004l[?2004h>             t_end = float(beat_times[e])
[?2004l[?2004h>         else:
[?2004l[?2004h>             t_end = duration
[?2004l[?2004h>         segments.append({'start': t_start, 'end': t_end, 'label': letter})
[?2004l[?2004h> 
[?2004l[?2004h> segments[0]['start'] = 0.0
[?2004l[?2004h> segments[-1]['end'] = duration
[?2004l[?2004h> 
[?2004l[?2004h> # Merge adjacent segments with same label
[?2004l[?2004h> merged = []
[?2004l[?2004h> for seg in segments:
[?2004l[?2004h>     if merged and merged[-1]['label'] == seg['label']:
[?2004l[?2004h>         merged[-1]['end'] = seg['end']
[?2004l[?2004h>     else:
[?2004l[?2004h>         merged.append(dict(seg))
[?2004l[?2004h> 
[?2004l[?2004h> # Drop / merge segments shorter than 0.5s
[?2004l[?2004h> final = []
[?2004l[?2004h> for seg in merged:
[?2004l[?2004h>     dur = seg['end'] - seg['start']
[?2004l[?2004h>     if dur <= 0.5:
[?2004l[?2004h>         if final:
[?2004l[?2004h>             final[-1]['end'] = seg['end']
[?2004l[?2004h>         else:
[?2004l[?2004h>             seg['start'] = 0.0
[?2004l[?2004h>             final.append(seg)
[?2004l[?2004h>     else:
[?2004l[?2004h>         final.append(seg)
[?2004l[?2004h> 
[?2004l[?2004h> # Bridge large gaps / overlaps
[?2004l[?2004h> for i in range(1, len(final)):
[?2004l[?2004h>     gap = final[i]['start'] - final[i-1]['end']
[?2004l[?2004h>     if gap > 0.3:
[?2004l[?2004h>         mid = (final[i-1]['end'] + final[i]['start']) / 2.0
[?2004l[?2004h>         final[i-1]['end'] = mid
[?2004l[?2004h>         final[i]['start'] = mid
[?2004l[?2004h>     elif gap < -0.05:
[?2004l[?2004h>         mid = (final[i-1]['end'] + final[i]['start']) / 2.0
[?2004l[?2004h>         final[i-1]['end'] = mid
[?2004l[?2004h>         final[i]['start'] = mid
[?2004l[?2004h> 
[?2004l[?2004h> final = [s for s in final if (s['end'] - s['start']) > 0.5]
[?2004l[?2004h> 
[?2004l[?2004h> renamed = []
[?2004l[?2004h> label_map = {}
[?2004l[?2004h> for s in final:
[?2004l[?2004h>     if s['label'] not in label_map:
[?2004l[?2004h>         label_map[s['label']] = chr(ord('A') + len(label_map))
[?2004l[?2004h>     renamed.append({'start': float(s['start']), 'end': float(s['end']), 'label': label_map[s['label']]})
[?2004l[?2004h> 
[?2004l[?2004h> renamed.sort(key=lambda x: x['start'])
[?2004l[?2004h> 
[?2004l[?2004h> print('FINAL SEGMENTS:')
[?2004l[?2004h> for s in renamed:
[?2004l[?2004h>     print(f"  {s['start']:.3f} -> {s['end']:.3f}  {s['label']}  (dur={s['end']-s['start']:.3f})")
[?2004l[?2004h> 
[?2004l[?2004h> with open(OUT_PATH, 'w') as f:
[?2004l[?2004h>     json.dump(renamed, f, indent=2)
[?2004l[?2004h> print('Wrote', OUT_PATH)
