[?2004l[?2004h>         final[i-1]['end'] = mid
[?2004l[?2004h>         final[i]['start'] = mid
[?2004l[?2004h> 
[?2004l[?2004h> # Recheck min duration
[?2004l[?2004h> final = [s for s in final if (s['end'] - s['start']) > 0.5]
[?2004l[?2004h> # Reassign labels in order of appearance (so we always have A,B,... contiguous)
[?2004l[?2004h> renamed = []
[?2004l[?2004h> label_map = {}
