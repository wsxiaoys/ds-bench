[29.725869, "o", "cat solve.py\r\n\u001b[?2004l\r"]
[29.727189, "o", "import json\r\nimport time\r\nimport os\r\nfrom e2b import Sandbox\r\n\r\n# Step 1: Create a new E2B sandbox\r\n# Set timeout to at least 5 minutes (300 seconds) so sandbox stays alive\r\nsandbox = Sandbox.create(timeout=600)  # 10 minutes to be safe\r\n\r\nprint(f\"Created sandbox with ID: {sandbox.sandbox_id}\")\r\n\r\n# Step 2: Write index.html file in /home/user/ inside the sandbox\r\nindex_html_content = \"Hello from E2B Sandbox!\"\r\nsandbox.files.write(\"/home/user/index.html\", index_html_content)\r\nprint(\"Wrote index.html to /home/user/index.html\")\r\n\r\n# Step 3: Start a Python HTTP server in the background on port 8000 serving /home/user/\r\n# Use nohup and run in background\r\nsandbox.commands.run(\r\n    \"nohup python3 -m http.server 8000 > /tmp/http_server.log 2>&1 &\",\r\n    background=True,\r\n)\r\nprint(\"Started HTTP server on port 8000\")\r\n\r\n# Wait a moment for the server to start\r\ntime.sleep(3)\r\n\r\n# Verify the server is running\r\nresult = sandbox.commands.run(\"curl -s http://localhost:8000/\")\r\nprint(f\"HTTP server response: {result.stdout}\")\r\n\r\n# Step 4: Retrieve the public URL for port 8000\r\nhost = sandbox.get_host(8000)\r\npublic_url = f\"https://{host}\"\r\nprint(f\"Public URL: {public_url}\")\r\n\r\n# Step 5: Save the sandbox ID and public URL to /home/user/e2b_task_info.json on the local machine\r\ninfo = {\r\n    \"sandbox_id\": sandbox.sandbox_id,\r\n    \"url\": public_url,\r\n}\r\n\r\nlocal_path = \"/home/user/e2b_task_info.json\"\r\nwith open(local_path, \"w\") as f:\r\n    json.dump(info, f, indent=2)\r\n\r\nprint(f\"Saved info to {local_path}\")\r\nprint(json.dumps(info, indent=2))\r\n\r\n# Step 6: Keep the sandbox alive for at least 5 minutes (300 seconds)\r\n# We'll wait 310 seconds to ensure it's kept alive\r\nkeep_alive_seconds = 310\r\nprint(f\"Keeping sandbox alive for {keep_alive_seconds} seconds...\")\r\ntime.sleep(keep_alive_seconds)\r\n\r\nprint(\"Done!\")\r\n"]
[29.727451, "o", "\u001b[?2004hroot@71eee99e-5dc4-48ea-af92-59c397d848b0:/home/user# "]
[40.792123, "i", "cat > solve.py << 'PYEOF'\nimport json\nimport time\nimport os\nfrom e2b import Sandbox\n\n# Step 1: Create a new E2B sandbox\n# Set timeout to at least 5 minutes (300 seconds) so sandbox stays alive\nsandbox = Sandbox.create(timeout=600)  # 10 minutes to be safe\n\nprint(f\"Created sandbox with ID: {sandbox.sandbox_id}\")\n\n# Step 2: Write index.html file in /home/user/ inside the sandbox\nindex_html_content = \"Hello from E2B Sandbox!\"\nsandbox.files.write(\"/home/user/index.html\", index_html_content)\nprint(\"Wrote index.html to /home/user/index.html\")\n\n# Step 3: Start a Python HTTP server in the background on port 8000 serving /home/user/\n# Use the --directory flag to serve /home/user/\n# Start the server with nohup in background, detached from this shell\nstart_cmd = \"nohup python3 -m http.server 8000 --directory /home/user > /tmp/http_server.log 2>&1 & echo $! > /tmp/http_server.pid; disown; sleep 1\"\nsandbox.commands.run(start_cmd, background=True)\nprint(\"Started HTTP server on port 8000\")\n\n# Wait a moment for the server to start\ntime.sleep(5)\n\n# Verify the server is running\nresult = sandbox.commands.run(\"ps aux | grep http.server | grep -v grep\")\nprint(f\"Server process: {result.stdout}\")\n\nresult = sandbox.commands.run(\"curl -s http://localhost:8000/\")\nprint(f\"HTTP server response: {result.stdout}\")\n\n# Step 4: Retrieve the public URL for port 8000\nhost = sandbox.get_host(8000)\npublic_url = f\"https://{host}\"\nprint(f\"Public URL: {public_url}\")\n\n# Step 5: Save the sandbox ID and public URL to /home/user/e2b_task_info.json on the local machine\ninfo = {\n    \"sandbox_id\": sandbox.sandbox_id,\n    \"url\": public_url,\n}\n\nlocal_path = \"/home/user/e2b_task_info.json\"\nwith open(local_path, \"w\") as f:\n    json.dump(info, f, indent=2)\n\nprint(f\"Saved info to {local_path}\")\nprint(json.dumps(info, indent=2))\n\n# Step 6: Keep the sandbox alive for at least 5 minutes (300 seconds)\n# We'll wait 310 seconds to ensure it's kept alive\nkeep_alive_seconds = 310\nprint(f\"Keeping sandbox alive for {keep_alive_seconds} seconds...\")\ntime.sleep(keep_alive_seconds)\n\nprint(\"Done!\")\nPYEOF\n"]
[40.79242, "o", "cat > solve.py << 'PYEOF'\r\n\u001b[?2004l\r"]
[40.792498, "o", "\u001b[?2004h> "]
[40.79253, "o", "import json\r\n\u001b[?2004l\r\u001b[?2004h> "]
[40.792645, "o", "import time\r\n\u001b[?2004l\r\u001b[?2004h> "]
[40.792688, "o", "import os\r\n\u001b[?2004l\r\u001b[?2004h"]
[40.792724, "o", "> "]
[40.792813, "o", "from e2b import Sandbox\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[40.792842, "o", "\u001b[?2004h> "]
[40.792936, "o", "# Step 1: Create a new E2B sandbox\r\n\u001b[?2004l\r"]
[40.79296, "o", "\u001b[?2004h> "]
[40.793163, "o", "# Set timeout to at least 5 minutes (300 seconds) so sandbox stays alive\r\n\u001b[?2004l\r"]
[40.793191, "o", "\u001b[?2004h> "]
[40.793365, "o", "sandbox = Sandbox.create(timeout=600)  # 10 minutes to be safe\r\n\u001b[?2004l\r"]
[40.793389, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[40.793445, "o", "> "]
[40.793558, "o", "print(f\"Created sandbox with ID: {sandbox.sandbox_id}\")\r\n\u001b[?2004l\r"]
[40.793585, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[40.793668, "o", "\u001b[?2004h> "]
[40.7938, "o", "# Step 2: Write index.html file in /home/user/ inside the sandbox\r\n\u001b[?2004l\r"]
[40.793838, "o", "\u001b[?2004h> "]
[40.793952, "o", "index_html_content = \"Hello from E2B Sandbox!\"\r\n\u001b[?2004l\r"]
[40.793988, "o", "\u001b[?2004h> "]
[40.794146, "o", "sandbox.files.write(\"/home/user/index.html\", index_html_content)\r\n\u001b[?2004l\r"]
[40.794174, "o", "\u001b[?2004h> "]
[40.794306, "o", "print(\"Wrote index.html to /home/user/index.html\")\r\n\u001b[?2004l\r"]
[40.794333, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[40.79436, "o", "\u001b[?2004h> "]
[40.794604, "o", "# Step 3: Start a Python HTTP server in the background on port 8000 serving /home/user/\r\n\u001b[?2004l\r"]
[40.794633, "o", "\u001b[?2004h"]
[40.794705, "o", "> "]
[40.794771, "o", "# Use the --directory flag to serve /home/user/\r\n\u001b[?2004l\r"]
[40.794799, "o", "\u001b[?2004h> "]
[40.794975, "o", "# Start the server with nohup in background, detached from this shell\r\n\u001b[?2004l\r"]
[40.795003, "o", "\u001b[?2004h> "]
[40.795388, "o", "start_cmd = \"nohup python3 -m http.server 8000 --directory /home/user > /tmp/http_server.log 2>&1 & echo $! > /tmp/http_server.pid; disown; sleep 1\"\r\n\u001b[?2004l\r"]
[40.795416, "o", "\u001b[?2004h> "]
[40.795551, "o", "sandbox.commands.run(start_cmd, background=True)\r\n\u001b[?2004l\r"]
[40.795577, "o", "\u001b[?2004h> "]
[40.795704, "o", "print(\"Started HTTP server on port 8000\")\r\n\u001b[?2004l\r"]
[40.795731, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[40.795796, "o", "\u001b[?2004h> "]
[40.795859, "o", "# Wait a moment for the server to start\r\n\u001b[?2004l\r"]
[40.795886, "o", "\u001b[?2004h> "]
[40.795941, "o", "time.sleep(5)\r\n\u001b[?2004l\r\u001b[?2004h> \r\n"]
[40.795966, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[40.796058, "o", "# Verify the server is running\r\n\u001b[?2004l\r"]
[40.796084, "o", "\u001b[?2004h> "]
[40.796272, "o", "result = sandbox.commands.run(\"ps aux | grep http.server | grep -v grep\")\r\n\u001b[?2004l\r"]
[40.796321, "o", "\u001b[?2004h> "]
[40.796412, "o", "print(f\"Server process: {result.stdout}\")\r\n\u001b[?2004l\r\u001b[?2004h"]
[40.79644, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h"]
[40.796502, "o", "> "]
[40.796628, "o", "result = sandbox.commands.run(\"curl -s http://localhost:8000/\")\r\n\u001b[?2004l\r"]
[40.796654, "o", "\u001b[?2004h> "]
[40.796773, "o", "print(f\"HTTP server response: {result.stdout}\")\r\n\u001b[?2004l\r"]
[40.796799, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[40.796848, "o", "> "]
[40.796944, "o", "# Step 4: Retrieve the public URL for port 8000\r\n\u001b[?2004l\r"]
[40.796969, "o", "\u001b[?2004h> "]
[40.797047, "o", "host = sandbox.get_host(8000)\r\n\u001b[?2004l\r"]
[40.797074, "o", "\u001b[?2004h> "]
[40.797152, "o", "public_url = f\"https://{host}\"\r\n\u001b[?2004l\r"]
[40.797177, "o", "\u001b[?2004h> "]
[40.797269, "o", "print(f\"Public URL: {public_url}\")\r\n\u001b[?2004l\r"]
[40.797295, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[40.797341, "o", "\u001b[?2004h> "]
[40.797573, "o", "# Step 5: Save the sandbox ID and public URL to /home/user/e2b_task_info.json on the local machine\r\n\u001b[?2004l\r"]
[40.797634, "o", "\u001b[?2004h> "]
[40.79766, "o", "info = {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[40.79776, "o", "    \"sandbox_id\": sandbox.sandbox_id,\r\n\u001b[?2004l\r\u001b[?2004h"]
[40.797786, "o", "> "]
[40.797846, "o", "    \"url\": public_url,\r\n\u001b[?2004l\r\u001b[?2004h"]
[40.797874, "o", "> }\r\n\u001b[?2004l\r"]
[40.797926, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[40.798044, "o", "local_path = \"/home/user/e2b_task_info.json\"\r\n\u001b[?2004l\r"]
[40.798071, "o", "\u001b[?2004h> "]
[40.798156, "o", "with open(local_path, \"w\") as f:\r\n\u001b[?2004l\r"]
[40.798194, "o", "\u001b[?2004h> "]
[40.79827, "o", "    json.dump(info, f, indent=2)\r\n\u001b[?2004l\r"]
[40.798307, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[40.798413, "o", "print(f\"Saved info to {local_path}\")\r\n\u001b[?2004l\r"]
[40.798439, "o", "\u001b[?2004h> "]
[40.798537, "o", "print(json.dumps(info, indent=2))\r\n\u001b[?2004l\r"]
[40.798563, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[40.798589, "o", "> "]
[40.798777, "o", "# Step 6: Keep the sandbox alive for at least 5 minutes (300 seconds)\r\n\u001b[?2004l\r\u001b[?2004h"]
[40.798802, "o", "> "]
[40.798933, "o", "# We'll wait 310 seconds to ensure it's kept alive\r\n\u001b[?2004l\r"]
[40.798959, "o", "\u001b[?2004h> "]
[40.799037, "o", "keep_alive_seconds = 310\r\n\u001b[?2004l\r\u001b[?2004h"]
[40.799074, "o", "> "]
[40.799242, "o", "print(f\"Keeping sandbox alive for {keep_alive_seconds} seconds...\")\r\n\u001b[?2004l\r"]
[40.79927, "o", "\u001b[?2004h> "]
[40.799368, "o", "time.sleep(keep_alive_seconds)\r\n\u001b[?2004l\r"]
[40.799412, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[40.799457, "o", "\u001b[?2004h> "]
[40.799482, "o", "print(\"Done!\")\r\n\u001b[?2004l\r\u001b[?2004h"]
[40.799541, "o", "> PYEOF\r\n\u001b[?2004l\r"]
[40.800895, "o", "\u001b[?2004hroot@71eee99e-5dc4-48ea-af92-59c397d848b0:/home/user# "]
[41.346955, "i", "cat solve.py\n"]
[41.347172, "o", "cat solve.py\r\n\u001b[?2004l\r"]
[41.348402, "o", "import json\r\nimport time\r\nimport os\r\nfrom e2b import Sandbox\r\n\r\n# Step 1: Create a new E2B sandbox\r\n# Set timeout to at least 5 minutes (300 seconds) so sandbox stays alive\r\nsandbox = Sandbox.create(timeout=600)  # 10 minutes to be safe\r\n\r\nprint(f\"Created sandbox with ID: {sandbox.sandbox_id}\")\r\n\r\n# Step 2: Write index.html file in /home/user/ inside the sandbox\r\nindex_html_content = \"Hello from E2B Sandbox!\"\r\nsandbox.files.write(\"/home/user/index.html\", index_html_content)\r\nprint(\"Wrote index.html to /home/user/index.html\")\r\n\r\n# Step 3: Start a Python HTTP server in the background on port 8000 serving /home/user/\r\n# Use the --directory flag to serve /home/user/\r\n# Start the server with nohup in background, detached from this shell\r\nstart_cmd = \"nohup python3 -m http.server 8000 --directory /home/user > /tmp/http_server.log 2>&1 & echo $! > /tmp/http_server.pid; disown; sleep 1\"\r\nsandbox.commands.run(start_cmd, background=True)\r\nprint(\"Started HTTP server on port 8000\")\r\n\r\n# Wait a moment for the server to start\r\ntime.sleep(5)\r\n\r\n# Verify the server is running\r\nresult = sandbox.commands.run(\"ps aux | grep http.server | grep -v grep\")\r\nprint(f\"Server process: {result.stdout}\")\r\n\r\nresult = sandbox.commands.run(\"curl -s http://localhost:8000/\")\r\nprint(f\"HTTP server response: {result.stdout}\")\r\n\r\n# Step 4: Retrieve the public URL for port 8000\r\nhost = sandbox.get_host(8000)\r\npublic_url = f\"https://{host}\"\r\nprint(f\"Public URL: {public_url}\")\r\n\r\n# Step 5: Save the sandbox ID and public URL to /home/user/e2b_task_info.json on the local machine\r\ninfo = {\r\n    \"sandbox_id\": sandbox.sandbox_id,\r\n    \"url\": public_url,\r\n}\r\n\r\nlocal_path = \"/home/user/e2b_task_info.json\"\r\nwith open(local_path, \"w\") as f:\r\n    json.dump(info, f, indent=2)\r\n\r\nprint(f\"Saved info to {local_path}\")\r\n"]
[41.348432, "o", "print(json.dumps(info, indent=2))\r\n\r\n# Step 6: Keep the sandbox alive for at least 5 minutes (300 seconds)\r\n# We'll wait 310 seconds to ensure it's kept alive\r\nkeep_alive_seconds = 310\r\nprint(f\"Keeping sandbox alive for {keep_alive_seconds} seconds...\")\r\ntime.sleep(keep_alive_seconds)\r\n\r\nprint(\"Done!\")\r\n"]
