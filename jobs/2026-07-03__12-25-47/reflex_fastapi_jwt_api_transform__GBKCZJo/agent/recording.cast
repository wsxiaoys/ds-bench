[347.404751, "o", "\u001b[?2004h> "]
[347.404919, "o", "            detail=\"Invalid credentials\",\r\n\u001b[?2004l\r"]
[347.404962, "o", "\u001b[?2004h> "]
[347.405004, "o", "        )\r\n\u001b[?2004l\r"]
[347.405047, "o", "\u001b[?2004h> "]
[347.405162, "o", "    token = jwt.encode(\r\n\u001b[?2004l\r"]
[347.405205, "o", "\u001b[?2004h> "]
[347.405355, "o", "        {\"sub\": payload.username},\r\n\u001b[?2004l\r"]
[347.405383, "o", "\u001b[?2004h> "]
[347.405478, "o", "        JWT_SECRET,\r\n\u001b[?2004l\r"]
[347.405518, "o", "\u001b[?2004h> "]
[347.40566, "o", "        algorithm=JWT_ALGORITHM,\r\n\u001b[?2004l\r"]
[347.405697, "o", "\u001b[?2004h> "]
[347.405742, "o", "    )\r\n\u001b[?2004l\r"]
[347.405781, "o", "\u001b[?2004h> "]
[347.405972, "o", "    return {\"access_token\": token}\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[347.406012, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[347.40605, "o", "\u001b[?2004h> "]
[347.406169, "o", "@fastapi_app.get(\"/api/me\")\r\n\u001b[?2004l\r"]
[347.406208, "o", "\u001b[?2004h> "]
[347.406554, "o", "async def api_me(authorization: str | None = Header(default=None)):\r\n\u001b[?2004l\r"]
[347.406584, "o", "\u001b[?2004h> "]
[347.406726, "o", "    if authorization is None:\r\n\u001b[?2004l\r"]
[347.406754, "o", "\u001b[?2004h> "]
[347.406899, "o", "        raise HTTPException(\r\n\u001b[?2004l\r"]
[347.406941, "o", "\u001b[?2004h> "]
[347.40716, "o", "            status_code=status.HTTP_401_UNAUTHORIZED,\r\n\u001b[?2004l\r"]
[347.407198, "o", "\u001b[?2004h> "]
[347.40743, "o", "            detail=\"Missing Authorization header\",\r\n\u001b[?2004l\r"]
[347.40746, "o", "\u001b[?2004h"]
[347.407512, "o", "> "]
[347.407691, "o", "            headers={\"WWW-Authenticate\": \"Bearer\"},\r\n\u001b[?2004l\r"]
[347.407735, "o", "\u001b[?2004h> "]
[347.407777, "o", "        )\r\n\u001b[?2004l\r"]
[347.407805, "o", "\u001b[?2004h> "]
[347.407955, "o", "    parts = authorization.split()\r\n\u001b[?2004l\r"]
[347.407983, "o", "\u001b[?2004h"]
[347.408032, "o", "> "]
[347.408239, "o", "    if len(parts) != 2 or parts[0].lower() != \"bearer\":\r\n"]
[347.408283, "o", "\u001b[?2004l\r\u001b[?2004h"]
[347.408327, "o", "> "]
[347.40843, "o", "        raise HTTPException(\r\n\u001b[?2004l\r"]
[347.408473, "o", "\u001b[?2004h> "]
[347.408704, "o", "            status_code=status.HTTP_401_UNAUTHORIZED,\r\n\u001b[?2004l\r"]
[347.408743, "o", "\u001b[?2004h> "]
[347.408953, "o", "            detail=\"Malformed Authorization header\",\r\n\u001b[?2004l\r"]
[347.408981, "o", "\u001b[?2004h> "]
[347.409154, "o", "            headers={\"WWW-Authenticate\": \"Bearer\"},\r\n\u001b[?2004l\r"]
[347.409182, "o", "\u001b[?2004h> "]
[347.409244, "o", "        )\r\n\u001b[?2004l\r\u001b[?2004h"]
[347.409288, "o", "> "]
[347.409333, "o", "    token = parts[1]\r\n\u001b[?2004l\r"]
[347.409372, "o", "\u001b[?2004h> "]
[347.409411, "o", "    try:\r\n\u001b[?2004l\r\u001b[?2004h"]
[347.409454, "o", "> "]
[347.409536, "o", "        decoded = jwt.decode(\r\n\u001b[?2004l\r"]
[347.409563, "o", "\u001b[?2004h> "]
[347.409642, "o", "            token,\r\n\u001b[?2004l\r"]
[347.409686, "o", "\u001b[?2004h> "]
[347.409789, "o", "            JWT_SECRET,\r\n\u001b[?2004l\r"]
[347.409816, "o", "\u001b[?2004h"]
[347.409865, "o", "> "]
[347.410012, "o", "            algorithms=[JWT_ALGORITHM],\r\n\u001b[?2004l\r"]
[347.410055, "o", "\u001b[?2004h> "]
[347.410095, "o", "        )\r\n\u001b[?2004l\r"]
[347.410134, "o", "\u001b[?2004h> "]
[347.410256, "o", "    except jwt.PyJWTError:\r\n\u001b[?2004l\r"]
[347.410298, "o", "\u001b[?2004h> "]
[347.410421, "o", "        raise HTTPException(\r\n\u001b[?2004l\r"]
[347.410464, "o", "\u001b[?2004h> "]
[347.41068, "o", "            status_code=status.HTTP_401_UNAUTHORIZED,\r\n\u001b[?2004l\r"]
[347.410724, "o", "\u001b[?2004h> "]
[347.410873, "o", "            detail=\"Invalid token\",\r\n\u001b[?2004l\r"]
[347.410913, "o", "\u001b[?2004h> "]
[347.411153, "o", "            headers={\"WWW-Authenticate\": \"Bearer\"},\r\n\u001b[?2004l\r"]
[347.411192, "o", "\u001b[?2004h> "]
[347.41124, "o", "        )\r\n\u001b[?2004l\r"]
[347.411269, "o", "\u001b[?2004h> "]
[347.41143, "o", "    user = decoded.get(\"sub\", \"admin\")\r\n\u001b[?2004l\r"]
[347.411474, "o", "\u001b[?2004h> "]
[347.411574, "o", "    return {\"user\": user}\r\n\u001b[?2004l\r"]
[347.411616, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[347.411653, "o", "\u001b[?2004h> "]
[347.411693, "o", "\r\n\u001b[?2004l\r\u001b[?2004h"]
[347.411733, "o", "> "]
[347.411815, "o", "class State(rx.State):\r\n\u001b[?2004l\r"]
[347.411854, "o", "\u001b[?2004h> "]
[347.411964, "o", "    \"\"\"The app state.\"\"\"\r\n\u001b[?2004l\r"]
[347.411992, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[347.412041, "o", "\u001b[?2004h> "]
[347.412381, "o", "    # Frontend-visible state var so the page can render whether we're logged in.\r\n\u001b[?2004l\r"]
[347.412409, "o", "\u001b[?2004h"]
[347.412459, "o", "> "]
[347.412567, "o", "    is_logged_in: bool = False\r\n\u001b[?2004l\r"]
[347.41261, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[347.412653, "o", "\u001b[?2004h> "]
[347.412975, "o", "    # Backend-only state var (leading underscore) that holds the decoded user.\r\n\u001b[?2004l\r"]
[347.413015, "o", "\u001b[?2004h> "]
[347.413147, "o", "    _current_user: str = \"\"\r\n\u001b[?2004l\r"]
[347.413185, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[347.413222, "o", "\u001b[?2004h> "]
[347.413298, "o", "    @rx.event\r\n\u001b[?2004l\r"]
[347.413336, "o", "\u001b[?2004h> "]
[347.413497, "o", "    async def login_and_fetch_me(self):\r\n\u001b[?2004l\r"]
[347.413525, "o", "\u001b[?2004h> "]
[347.413883, "o", "        \"\"\"Log in against the FastAPI sub-app and update state accordingly.\"\"\"\r\n\u001b[?2004l\r"]
[347.413928, "o", "\u001b[?2004h> "]
[347.413971, "o", "        try:\r\n\u001b[?2004l\r"]
[347.413998, "o", "\u001b[?2004h"]
[347.414049, "o", "> "]
[347.414256, "o", "            async with httpx.AsyncClient() as client:\r\n"]
[347.414325, "o", "\u001b[?2004l\r"]
[347.414354, "o", "\u001b[?2004h"]
[347.414407, "o", "> "]
[347.414559, "o", "                login_resp = await client.post(\r\n\u001b[?2004l\r"]
[347.414588, "o", "\u001b[?2004h> "]
[347.41484, "o", "                    \"http://localhost:8000/api/login\",\r\n\u001b[?2004l\r"]
[347.414868, "o", "\u001b[?2004h"]
[347.414918, "o", "> "]
[347.415233, "o", "                    json={\"username\": VALID_USERNAME, \"password\": VALID_PASSWORD},\r\n\u001b[?2004l\r"]
[347.415276, "o", "\u001b[?2004h> "]
[347.41536, "o", "                )\r\n\u001b[?2004l\r"]
[347.415399, "o", "\u001b[?2004h> "]
[347.415618, "o", "                if login_resp.status_code != 200:\r\n\u001b[?2004l\r"]
[347.415663, "o", "\u001b[?2004h> "]
[347.415849, "o", "                    self.is_logged_in = False\r\n\u001b[?2004l\r"]
[347.415877, "o", "\u001b[?2004h"]
[347.415927, "o", "> "]
[347.416089, "o", "                    self._current_user = \"\"\r\n\u001b[?2004l\r"]
[347.416132, "o", "\u001b[?2004h> "]
[347.416288, "o", "                    return\r\n\u001b[?2004l\r\u001b[?2004h> "]
[347.416551, "o", "                token = login_resp.json().get(\"access_token\")\r\n\u001b[?2004l\r"]
[347.41659, "o", "\u001b[?2004h> "]
[347.416798, "o", "                me_resp = await client.get(\r\n\u001b[?2004l\r"]
[347.416826, "o", "\u001b[?2004h> "]
[347.417055, "o", "                    \"http://localhost:8000/api/me\",\r\n\u001b[?2004l\r"]
[347.4171, "o", "\u001b[?2004h> "]
[347.417389, "o", "                    headers={\"Authorization\": f\"Bearer {token}\"},\r\n\u001b[?2004l\r"]
[347.417436, "o", "\u001b[?2004h> "]
[347.417504, "o", "                )\r\n\u001b[?2004l\r"]
[347.417543, "o", "\u001b[?2004h> "]
[347.41774, "o", "                if me_resp.status_code == 200:\r\n\u001b[?2004l\r"]
[347.417779, "o", "\u001b[?2004h> "]
[347.418092, "o", "                    self._current_user = me_resp.json().get(\"user\", \"\")\r\n\u001b[?2004l\r"]
[347.41812, "o", "\u001b[?2004h"]
[347.418169, "o", "> "]
[347.418344, "o", "                    self.is_logged_in = True\r\n\u001b[?2004l\r"]
[347.418373, "o", "\u001b[?2004h"]
[347.418423, "o", "> "]
[347.418489, "o", "                else:\r\n\u001b[?2004l\r"]
[347.418532, "o", "\u001b[?2004h> "]
[347.418712, "o", "                    self.is_logged_in = False\r\n\u001b[?2004l\r"]
[347.418754, "o", "\u001b[?2004h> "]
[347.418935, "o", "                    self._current_user = \"\"\r\n\u001b[?2004l\r"]
[347.418963, "o", "\u001b[?2004h"]
[347.419013, "o", "> "]
[347.419098, "o", "        except Exception:\r\n\u001b[?2004l\r"]
[347.419141, "o", "\u001b[?2004h> "]
[347.419296, "o", "            self.is_logged_in = False\r\n\u001b[?2004l\r"]
[347.419326, "o", "\u001b[?2004h> "]
[347.419489, "o", "            self._current_user = \"\"\r\n\u001b[?2004l\r"]
[347.419528, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[347.41957, "o", "\u001b[?2004h> \r\n"]
[347.419613, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[347.419752, "o", "def index() -> rx.Component:\r\n\u001b[?2004l\r"]
[347.419791, "o", "\u001b[?2004h"]
[347.420271, "o", ">     # Welcome Page (Index)\r\n\u001b[?2004l\r\u001b[?2004h>     return rx.container(\r\n\u001b[?2004l\r\u001b[?2004h>         rx.color_mode.button(position=\"top-right\"),\r\n\u001b[?2004l\r\u001b[?2004h> "]
[347.420301, "o", "        rx.vstack(\r\n\u001b[?2004l\r"]
[347.42033, "o", "\u001b[?2004h> "]
[347.420554, "o", "            rx.heading(\"Welcome to Reflex!\", size=\"9\"),\r\n\u001b[?2004l\r"]
[347.420582, "o", "\u001b[?2004h"]
[347.420634, "o", "> "]
[347.420695, "o", "            rx.text(\r\n\u001b[?2004l\r"]
[347.420738, "o", "\u001b[?2004h> "]
[347.420917, "o", "                \"Get started by editing \",\r\n\u001b[?2004l\r"]
[347.420959, "o", "\u001b[?2004h> "]
[347.421265, "o", "                rx.code(f\"{config.app_name}/{config.app_name}.py\"),\r\n\u001b[?2004l\r"]
[347.421321, "o", "\u001b[?2004h> "]
[347.421425, "o", "                size=\"5\",\r\n\u001b[?2004l\r"]
[347.42145, "o", "\u001b[?2004h> "]
[347.421512, "o", "            ),\r\n\u001b[?2004l\r"]
[347.421547, "o", "\u001b[?2004h> "]
[347.421645, "o", "            rx.link(\r\n\u001b[?2004l\r"]
[347.421668, "o", "\u001b[?2004h> "]
[347.421923, "o", "                rx.button(\"Check out our docs!\"),\r\n\u001b[?2004l\r"]
[347.421967, "o", "\u001b[?2004h> "]
[347.422273, "o", "                href=\"https://reflex.dev/docs/getting-started/introduction/\",\r\n\u001b[?2004l\r"]
[347.422314, "o", "\u001b[?2004h> "]
[347.422478, "o", "                is_external=True,\r\n\u001b[?2004l\r"]
[347.422515, "o", "\u001b[?2004h> "]
[347.422581, "o", "            ),\r\n\u001b[?2004l\r"]
[347.422607, "o", "\u001b[?2004h> "]
[347.422872, "o", "            rx.text(f\"is_logged_in: {State.is_logged_in}\"),\r\n\u001b[?2004l\r"]
[347.422898, "o", "\u001b[?2004h"]
[347.422953, "o", "> "]
[347.423207, "o", "            rx.button(\"Login\", on_click=State.login_and_fetch_me),\r\n\u001b[?2004l\r"]
[347.423253, "o", "\u001b[?2004h> "]
[347.423356, "o", "            spacing=\"5\",\r\n\u001b[?2004l\r"]
[347.423381, "o", "\u001b[?2004h> "]
[347.423529, "o", "            justify=\"center\",\r\n\u001b[?2004l\r"]
[347.423555, "o", "\u001b[?2004h"]
[347.423607, "o", "> "]
[347.423716, "o", "            min_height=\"85vh\",\r\n\u001b[?2004l\r"]
[347.423758, "o", "\u001b[?2004h> "]
[347.423797, "o", "        ),\r\n\u001b[?2004l\r"]
[347.423841, "o", "\u001b[?2004h> "]
[347.423877, "o", "    )\r\n\u001b[?2004l\r\u001b[?2004h"]
[347.423903, "o", "> \r\n\u001b[?2004l\r"]
[347.423955, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[347.42398, "o", "\u001b[?2004h"]
[347.424039, "o", "> "]
[347.424191, "o", "app = rx.App(api_transformer=fastapi_app)\r\n\u001b[?2004l\r"]
[347.424216, "o", "\u001b[?2004h"]
[347.42428, "o", "> "]
[347.424335, "o", "app.add_page(index)\r\n\u001b[?2004l\r"]
[347.424361, "o", "\u001b[?2004h> "]
[347.424412, "o", "EOF\r\n\u001b[?2004l\r"]
