[110.299468, "i", "cat > index.html << 'EOF'\n<!DOCTYPE html>\n<html lang=\"en\">\n  <head>\n    <meta charset=\"UTF-8\" />\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\" />\n    <title>Theme Demo</title>\n    <style>\n      :root {\n        --bg: #ffffff;\n        --fg: #111111;\n      }\n      html.dark {\n        --bg: #111111;\n        --fg: #ffffff;\n      }\n      html, body {\n        margin: 0;\n        padding: 0;\n        background: var(--bg);\n        color: var(--fg);\n        font-family: system-ui, -apple-system, sans-serif;\n        min-height: 100vh;\n      }\n      main {\n        padding: 2rem;\n      }\n      button {\n        background: var(--fg);\n        color: var(--bg);\n        border: 1px solid var(--fg);\n        padding: 0.5rem 1rem;\n        cursor: pointer;\n        font-size: 1rem;\n      }\n    </style>\n  </head>\n  <body>\n    <main id=\"app\">\n      <h1>Theme Demo</h1>\n      <button id=\"theme-toggle\" type=\"button\">Toggle Theme</button>\n    </main>\n    <script type=\"module\" src=\"/src/main.ts\"></script>\n  </body>\n</html>\nEOF\n"]
