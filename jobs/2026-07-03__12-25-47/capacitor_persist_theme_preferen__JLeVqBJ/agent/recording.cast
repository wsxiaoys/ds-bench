[163.01513, "o", "<!DOCTYPE html>\r\n<html lang=\"en\">\r\n  <head>\r\n    <meta charset=\"UTF-8\" />\r\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\" />\r\n    <title>Theme Demo</title>\r\n    <style>\r\n      :root {\r\n        --bg: #ffffff;\r\n        --fg: #111111;\r\n      }\r\n      html.dark {\r\n        --bg: #111111;\r\n        --fg: #ffffff;\r\n      }\r\n      html, body {\r\n        margin: 0;\r\n        padding: 0;\r\n        background: var(--bg);\r\n        color: var(--fg);\r\n        font-family: system-ui, -apple-system, sans-serif;\r\n        min-height: 100vh;\r\n      }\r\n      main {\r\n        padding: 2rem;\r\n      }\r\n      button {\r\n        background: var(--fg);\r\n        color: var(--bg);\r\n        border: 1px solid var(--fg);\r\n        padding: 0.5rem 1rem;\r\n        cursor: pointer;\r\n        font-size: 1rem;\r\n      }\r\n    </style>\r\n    <script type=\"module\" crossorigin src=\"/assets/index-B5_0zCMU.js\"></script>\r\n  </head>\r\n  <body>\r\n    <main id=\"app\">\r\n      <h1>Theme Demo</h1>\r\n      <button id=\"theme-toggle\" type=\"button\">Toggle Theme</button>\r\n    </main>\r\n  </body>\r\n</html>\r\n"]
