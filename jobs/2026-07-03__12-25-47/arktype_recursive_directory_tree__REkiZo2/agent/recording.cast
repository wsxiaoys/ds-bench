[182.448757, "i", "cat > /home/user/myproject/test_scope.ts << 'EOF'\nimport { scope } from \"arktype\";\n\nconst treeScope = scope({\n  node: () => ({\n    name: \"string > 0\",\n    size: \"number.integer > 0?\",\n    children: \"$node[]?\"\n  })\n}).export();\n\n// Validate\nconst valid = treeScope.node({\n  name: \"root\",\n  children: [\n    { name: \"file1\", size: 100 },\n    { name: \"dir1\", children: [{ name: \"file2\", size: 200 }] }\n  ]\n});\nconsole.log(\"valid:\", valid);\nconst invalid = treeScope.node({ size: 100 });\nconsole.log(\"invalid:\", invalid);\nconst emptyName = treeScope.node({ name: \"\" });\nconsole.log(\"emptyName:\", emptyName);\nconst fileWithChildren = treeScope.node({ name: \"f\", size: 1, children: [] });\nconsole.log(\"fileWithChildren:\", fileWithChildren);\nEOF\nnpx tsx test_scope.ts\n"]
