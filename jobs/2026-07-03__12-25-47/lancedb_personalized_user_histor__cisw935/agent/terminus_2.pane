[?2004l[?2004h> #!/usr/bin/env python3
[?2004l[?2004h> """Personalized user-history recommender backed by LanceDB."""
[?2004l[?2004h> import argparse
[?2004l[?2004h> import json
[?2004l[?2004h> import os
[?2004l[?2004h> 
[?2004l[?2004h> import lancedb
[?2004l[?2004h> import numpy as np
[?2004l[?2004h> import pandas as pd
[?2004l[?2004h> 
[?2004l[?2004h> 
[?2004l[?2004h> def parse_args() -> argparse.Namespace:
[?2004l[?2004h>     parser = argparse.ArgumentParser(description="Personalized recommender using LanceDB")
[?2004l[?2004h>     parser.add_argument("--user-id", required=True, help="Target user ID")
[?2004l[?2004h>     parser.add_argument("--query-vec", required=True, help="Path to .npy file with query vector")
[?2004l[?2004h>     parser.add_argument("--k", required=True, type=int, help="Number of recommendations")
[?2004l[?2004h>     parser.add_argument("--output", required=True, help="Path to output JSON file")
[?2004l[?2004h>     return parser.parse_args()
[?2004l[?2004h> 
[?2004l[?2004h> 
[?2004l[?2004h> def get_recent_user_history(db: lancedb.DBConnection, user_id: str, limit: int = 10) -> pd.DataFrame:
[?2004l[?2004h>     """Return up to `limit` most-recent rows for the user, ordered by timestamp descending."""
[?2004l[?2004h>     history = (
[?2004l[?2004h>         db.open_table("user_history")
[?2004l[?2004h>         .search()
[?2004l[?2004h>         .where(f"user_id = '{user_id}'")
[?2004l[?2004h>         .limit(limit * 4)  # fetch extra to be safe, then sort/trim
[?2004l[?2004h>         .to_pandas()
[?2004l[?2004h>     )
[?2004l[?2004h>     if history.empty:
[?2004l[?2004h>         return history
[?2004l[?2004h>     history = history.sort_values("ts", ascending=False).head(limit)
[?2004l[?2004h>     return history
[?2004l[?2004h> 
[?2004l[?2004h> 
[?2004l[?2004h> def build_seen_clause(seen_ids) -> str:
[?2004l[?2004h>     if not seen_ids:
[?2004l[?2004h>         # Always-true filter; avoids `NOT IN ()` which is invalid SQL.
[?2004l[?2004h>         return "1 = 1"
[?2004l[?2004h>     ids_csv = ",".join(str(int(i)) for i in seen_ids)
[?2004l[?2004h>     return f"id NOT IN ({ids_csv})"
[?2004l[?2004h> 
[?2004l[?2004h> 
[?2004l[?2004h> def main() -> None:
[?2004l[?2004h>     args = parse_args()
[?2004l[?2004h> 
[?2004l[?2004h>     alpha = float(os.environ.get("BLEND_ALPHA", "0.3"))
[?2004l[?2004h> 
[?2004l[?2004h>     # Load query vector.
[?2004l[?2004h>     query_vec = np.load(args.query_vec).astype("float32")
[?2004l[?2004h>     if query_vec.ndim != 1:
[?2004l[?2004h>         query_vec = query_vec.reshape(-1)
[?2004l[?2004h> 
[?2004l[?2004h>     db = lancedb.connect("/home/user/project/data")
[?2004l[?2004h>     items = db.open_table("items")
[?2004l[?2004h> 
[?2004l[?2004h>     # Recent user history (most recent 10).
[?2004l[?2004h>     history = get_recent_user_history(db, args.user_id, limit=10)
[?2004l[?2004h>     seen_ids = []
[?2004l[?2004h>     if not history.empty:
[?2004l[?2004h>         seen_ids = history["item_id"].astype(int).tolist()
[?2004l[?2004h> 
[?2004l[?2004h>     # Compute taste vector by joining history with items.
[?2004l[?2004h>     if seen_ids:
[?2004l[?2004h>         items_df = items.to_pandas()
[?2004l[?2004h>         taste_df = items_df[items_df["id"].astype(int).isin(seen_ids)]
[?2004l[?2004h>         if not taste_df.empty:
[?2004l[?2004h>             embeddings = np.stack([np.asarray(v, dtype=np.float32) for v in taste_df["vector"].values])
[?2004l[?2004h>             taste_vec = embeddings.mean(axis=0)
[?2004l[?2004h>         else:
[?2004l[?2004h>             taste_vec = None
[?2004l[?2004h>     else:
[?2004l[?2004h>         taste_vec = None
[?2004l[?2004h> 
[?2004l[?2004h>     # Blend.
[?2004l[?2004h>     if taste_vec is None:
[?2004l[?2004h>         blended = query_vec
[?2004l[?2004h>     else:
[?2004l[?2004h>         blended = (1.0 - alpha) * query_vec + alpha * taste_vec.astype(np.float32)
[?2004l[?2004h>     blended = np.asarray(blended, dtype=np.float32)
[?2004l[?2004h> 
[?2004l[?2004h>     # Vector search excluding already-seen items.
[?2004l[?2004h>     where_clause = build_seen_clause(seen_ids)
[?2004l[?2004h>     results = (
[?2004l[?2004h>         items.search(blended)
[?2004l[?2004h>         .where(where_clause)
[?2004l[?2004h>         .limit(args.k)
[?2004l[?2004h>         .to_pandas()
[?2004l[?2004h>     )
[?2004l[?2004h> 
[?2004l[?2004h>     top_ids = results["id"].astype(int).tolist()
[?2004l[?2004h> 
