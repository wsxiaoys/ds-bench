[56.986799, "o", "\u001b[?2004h> "]
[56.986888, "o", "    )\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[56.986928, "o", "\u001b[?2004h> "]
