[132.765291, "o", "BLEND_ALPHA=0.5 python3 /home/user/project/recommend.py --user-id u_test --query-vec /home/user/project/query.npy --k 10 --output /tmp/test10.json && cat /tmp/test10.json && echo\r\n\u001b[?2004l\r"]
