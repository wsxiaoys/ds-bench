[56.984028, "o", "\u001b[?2004h> "]
[56.984094, "o", "    else:\r\n\u001b[?2004l\r"]
[56.984132, "o", "\u001b[?2004h> "]
[56.984723, "o", "        blended = (1.0 - alpha) * query_vec + alpha * taste_vec.astype(np.float32)\r\n\u001b[?2004l\r"]
[56.98476, "o", "\u001b[?2004h> "]
[56.985124, "o", "    blended = np.asarray(blended, dtype=np.float32)\r\n\u001b[?2004l\r"]
[56.985162, "o", "\u001b[?2004h> "]
[56.985205, "o", "\r\n\u001b[?2004l\r"]
[56.98529, "o", "\u001b[?2004h> "]
[56.985559, "o", "    # Vector search excluding already-seen items.\r\n\u001b[?2004l\r"]
[56.985606, "o", "\u001b[?2004h> "]
[56.985868, "o", "    where_clause = build_seen_clause(seen_ids)\r\n\u001b[?2004l\r"]
[56.985938, "o", "\u001b[?2004h> "]
[56.986057, "o", "    results = (\r\n\u001b[?2004l\r\u001b[?2004h> "]
