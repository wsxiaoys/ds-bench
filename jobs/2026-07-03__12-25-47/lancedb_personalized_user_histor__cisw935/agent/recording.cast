[121.057447, "i", "cat > /home/user/project/recommend.py << 'PYEOF'\n#!/usr/bin/env python3\n\"\"\"Personalized user-history recommender backed by LanceDB.\"\"\"\nimport argparse\nimport json\nimport os\n\nimport lancedb\nimport numpy as np\n\n\ndef parse_args() -> argparse.Namespace:\n    parser = argparse.ArgumentParser(description=\"Personalized recommender using LanceDB\")\n    parser.add_argument(\"--user-id\", required=True, help=\"Target user ID\")\n    parser.add_argument(\"--query-vec\", required=True, help=\"Path to .npy file with query vector\")\n    parser.add_argument(\"--k\", required=True, type=int, help=\"Number of recommendations\")\n    parser.add_argument(\"--output\", required=True, help=\"Path to output JSON file\")\n    return parser.parse_args()\n\n\ndef get_recent_user_history(db: lancedb.DBConnection, user_id: str, limit: int = 10):\n    \"\"\"Return up to `limit` most-recent rows for the user, sorted by ts descending.\"\"\"\n    history_tbl = db.open_table(\"user_history\")\n    df = history_tbl.to_pandas()\n    if df.empty:\n        return df\n    df = df[df[\"user_id\"] == user_id]\n    if df.empty:\n        return df\n    df = df.sort_values(\"ts\", ascending=False).head(limit)\n    return df\n\n\ndef build_seen_clause(seen_ids) -> str:\n    if not seen_ids:\n        # Always-true filter; avoids `NOT IN ()` which is invalid SQL.\n        return \"1 = 1\"\n    ids_csv = \",\".join(str(int(i)) for i in seen_ids)\n    return f\"id NOT IN ({ids_csv})\"\n\n\ndef main() -> None:\n    args = parse_args()\n\n    alpha = float(os.environ.get(\"BLEND_ALPHA\", \"0.3\"))\n\n    # Load query vector.\n    query_vec = np.load(args.query_vec).astype(\"float32\")\n    if query_vec.ndim != 1:\n        query_vec = query_vec.reshape(-1)\n\n    db = lancedb.connect(\"/home/user/project/data\")\n    items = db.open_table(\"items\")\n\n    # Recent user history (most recent 10).\n    history = get_recent_user_history(db, args.user_id, limit=10)\n    seen_ids = []\n    if not history.empty:\n        seen_ids = history[\"item_id\"].astype(int).tolist()\n\n    # Compute taste vector by joining history with items.\n    taste_vec = None\n    if seen_ids:\n        items_df = items.to_pandas()\n        taste_df = items_df[items_df[\"id\"].astype(int).isin(seen_ids)]\n        if not taste_df.empty:\n            embeddings = np.stack(\n                [np.asarray(v, dtype=np.float32) for v in taste_df[\"vector\"].values]\n            )\n            taste_vec = embeddings.mean(axis=0)\n\n    # Blend.\n    if taste_vec is None:\n        blended = query_vec\n    else:\n        blended = (1.0 - alpha) * query_vec + alpha * taste_vec.astype(np.float32)\n    blended = np.asarray(blended, dtype=np.float32)\n\n    # Vector search excluding already-seen items.\n    where_clause = build_seen_clause(seen_ids)\n    results = (\n        items.search(blended)\n        .where(where_clause)\n        .limit(args.k)\n        .to_pandas()\n    )\n\n    top_ids = results[\"id\"].astype(int).tolist()\n\n    with open(args.output, \"w\") as f:\n        json.dump(top_ids, f)\n\n\nif __name__ == \"__main__\":\n    main()\nPYEOF\n"]
[121.057743, "o", "cat > /home/user/project/recommend.py << 'PYEOF'\r\n\u001b[?2004l\r"]
