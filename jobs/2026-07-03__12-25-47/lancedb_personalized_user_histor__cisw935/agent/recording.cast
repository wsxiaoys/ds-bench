[121.05997, "o", "def get_recent_user_history(db: lancedb.DBConnection, user_id: str, limit: int = 10):\r\n\u001b[?2004l\r"]
[121.060015, "o", "\u001b[?2004h> "]
[121.060193, "o", "    \"\"\"Return up to `limit` most-recent rows for the user, sorted by ts descending.\"\"\"\r\n\u001b[?2004l\r"]
[121.060238, "o", "\u001b[?2004h> "]
[121.060325, "o", "    history_tbl = db.open_table(\"user_history\")\r\n\u001b[?2004l\r"]
[121.060384, "o", "\u001b[?2004h> "]
[121.060427, "o", "    df = history_tbl.to_pandas()\r\n\u001b[?2004l\r"]
[121.060484, "o", "\u001b[?2004h> "]
[121.060509, "o", "    if df.empty:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[121.060548, "o", "        return df\r\n\u001b[?2004l\r\u001b[?2004h"]
[121.060615, "o", "> "]
[121.060672, "o", "    df = df[df[\"user_id\"] == user_id]\r\n\u001b[?2004l\r"]
[121.060728, "o", "\u001b[?2004h> "]
[121.060782, "o", "    if df.empty:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[121.060822, "o", "        return df\r\n\u001b[?2004l\r\u001b[?2004h"]
[121.060878, "o", "> "]
[121.060954, "o", "    df = df.sort_values(\"ts\", ascending=False).head(limit)\r\n\u001b[?2004l\r"]
[121.060999, "o", "\u001b[?2004h> "]
[121.061043, "o", "    return df\r\n\u001b[?2004l\r\u001b[?2004h> "]
[121.061099, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[121.061173, "o", "def build_seen_clause(seen_ids) -> str:\r\n\u001b[?2004l\r"]
[121.061218, "o", "\u001b[?2004h> "]
[121.061265, "o", "    if not seen_ids:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[121.061446, "o", "        # Always-true filter; avoids `NOT IN ()` which is invalid SQL.\r\n\u001b[?2004l\r\u001b[?2004h> "]
[121.061509, "o", "        return \"1 = 1\"\r\n\u001b[?2004l\r\u001b[?2004h"]
[121.061571, "o", "> "]
[121.061655, "o", "    ids_csv = \",\".join(str(int(i)) for i in seen_ids)\r\n\u001b[?2004l\r"]
[121.061677, "o", "\u001b[?2004h> "]
[121.061785, "o", "    return f\"id NOT IN ({ids_csv})\"\r\n\u001b[?2004l\r\u001b[?2004h"]
[121.061835, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h"]
[121.061895, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[121.061953, "o", "def main() -> None:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[121.062008, "o", "    args = parse_args()\r\n\u001b[?2004l\r\u001b[?2004h"]
[121.062062, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[121.062147, "o", "    alpha = float(os.environ.get(\"BLEND_ALPHA\", \"0.3\"))\r\n\u001b[?2004l\r"]
[121.06221, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[121.062238, "o", "\u001b[?2004h> "]
[121.062308, "o", "    # Load query vector.\r\n\u001b[?2004l\r\u001b[?2004h> "]
[121.06241, "o", "    query_vec = np.load(args.query_vec).astype(\"float32\")\r\n\u001b[?2004l\r"]
[121.062458, "o", "\u001b[?2004h> "]
[121.062502, "o", "    if query_vec.ndim != 1:\r\n\u001b[?2004l\r"]
[121.062556, "o", "\u001b[?2004h> "]
[121.062618, "o", "        query_vec = query_vec.reshape(-1)\r\n\u001b[?2004l\r"]
[121.062686, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[121.062787, "o", "    db = lancedb.connect(\"/home/user/project/data\")\r\n\u001b[?2004l\r"]
[121.062838, "o", "\u001b[?2004h> "]
[121.062889, "o", "    items = db.open_table(\"items\")\r\n\u001b[?2004l\r"]
[121.062948, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[121.063002, "o", "> "]
[121.063055, "o", "    # Recent user history (most recent 10).\r\n\u001b[?2004l\r"]
[121.06308, "o", "\u001b[?2004h> "]
[121.063207, "o", "    history = get_recent_user_history(db, args.user_id, limit=10)\r\n\u001b[?2004l\r"]
[121.063255, "o", "\u001b[?2004h> "]
[121.063274, "o", "    seen_ids = []\r\n\u001b[?2004l\r\u001b[?2004h> "]
[121.06335, "o", "    if not history.empty:\r\n\u001b[?2004l\r"]
[121.063406, "o", "\u001b[?2004h> "]
[121.063506, "o", "        seen_ids = history[\"item_id\"].astype(int).tolist()\r\n\u001b[?2004l\r"]
[121.063529, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[121.063551, "o", "\u001b[?2004h> "]
[121.063697, "o", "    # Compute taste vector by joining history with items.\r\n\u001b[?2004l\r\u001b[?2004h"]
[121.063724, "o", "> "]
[121.063807, "o", "    taste_vec = None\r\n\u001b[?2004l\r\u001b[?2004h> "]
[121.06384, "o", "    if seen_ids:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[121.063936, "o", "        items_df = items.to_pandas()\r\n\u001b[?2004l\r\u001b[?2004h"]
[121.063961, "o", "> "]
[121.064116, "o", "        taste_df = items_df[items_df[\"id\"].astype(int).isin(seen_ids)]\r\n\u001b[?2004l\r\u001b[?2004h"]
[121.06414, "o", "> "]
[121.064205, "o", "        if not taste_df.empty:\r\n\u001b[?2004l\r"]
[121.064252, "o", "\u001b[?2004h> "]
[121.064307, "o", "            embeddings = np.stack(\r\n\u001b[?2004l\r"]
[121.064344, "o", "\u001b[?2004h> "]
[121.064526, "o", "                [np.asarray(v, dtype=np.float32) for v in taste_df[\"vector\"].values]\r\n\u001b[?2004l\r"]
[121.064565, "o", "\u001b[?2004h> "]
[121.064615, "o", "            )\r\n\u001b[?2004l\r\u001b[?2004h> "]
[121.064718, "o", "            taste_vec = embeddings.mean(axis=0)\r\n\u001b[?2004l\r"]
[121.064767, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[121.064814, "o", ">     # Blend.\r\n\u001b[?2004l\r"]
[121.064857, "o", "\u001b[?2004h> "]
[121.064907, "o", "    if taste_vec is None:\r\n\u001b[?2004l\r\u001b[?2004h"]
[121.064951, "o", "> "]
[121.065003, "o", "        blended = query_vec\r\n\u001b[?2004l\r\u001b[?2004h> "]
[121.065047, "o", "    else:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[121.065218, "o", "        blended = (1.0 - alpha) * query_vec + alpha * taste_vec.astype(np.float32)\r\n\u001b[?2004l\r"]
[121.065268, "o", "\u001b[?2004h> "]
[121.065359, "o", "    blended = np.asarray(blended, dtype=np.float32)\r\n\u001b[?2004l\r"]
[121.065407, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[121.065449, "o", "> "]
[121.065517, "o", "    # Vector search excluding already-seen items.\r\n\u001b[?2004l\r"]
[121.065557, "o", "\u001b[?2004h> "]
[121.065655, "o", "    where_clause = build_seen_clause(seen_ids)\r\n\u001b[?2004l\r"]
[121.065685, "o", "\u001b[?2004h> "]
[121.06576, "o", "    results = (\r\n\u001b[?2004l\r\u001b[?2004h> "]
[121.065815, "o", "        items.search(blended)\r\n\u001b[?2004l\r"]
[121.065863, "o", "\u001b[?2004h> "]
[121.065904, "o", "        .where(where_clause)\r\n\u001b[?2004l\r"]
[121.065955, "o", "\u001b[?2004h> "]
[121.066005, "o", "        .limit(args.k)\r\n\u001b[?2004l\r\u001b[?2004h"]
[121.066051, "o", "> "]
[121.066098, "o", "        .to_pandas()\r\n\u001b[?2004l\r\u001b[?2004h>     )\r\n"]
[121.066141, "o", "\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[121.066241, "o", "    top_ids = results[\"id\"].astype(int).tolist()\r\n\u001b[?2004l\r"]
[121.06629, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[121.066336, "o", "\u001b[?2004h> "]
[121.066378, "o", "    with open(args.output, \"w\") as f:\r\n\u001b[?2004l\r"]
[121.066417, "o", "\u001b[?2004h> "]
[121.066471, "o", "        json.dump(top_ids, f)\r\n\u001b[?2004l\r"]
[121.066515, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[121.066564, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[121.066601, "o", "if __name__ == \"__main__\":\r\n\u001b[?2004l\r"]
[121.066654, "o", "\u001b[?2004h> "]
[121.066698, "o", "    main()\r\n\u001b[?2004l\r\u001b[?2004h> "]
[121.066743, "o", "PYEOF\r\n\u001b[?2004l\r"]
