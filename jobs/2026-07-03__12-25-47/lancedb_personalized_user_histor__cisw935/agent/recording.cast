[56.977805, "o", "    items = db.open_table(\"items\")\r\n\u001b[?2004l\r"]
[56.97784, "o", "\u001b[?2004h> "]
[56.977922, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[56.978211, "o", "    # Recent user history (most recent 10).\r\n\u001b[?2004l\r"]
[56.97825, "o", "\u001b[?2004h"]
[56.978338, "o", "> "]
[56.978715, "o", "    history = get_recent_user_history(db, args.user_id, limit=10)\r\n\u001b[?2004l\r"]
[56.978754, "o", "\u001b[?2004h> "]
[56.978893, "o", "    seen_ids = []\r\n\u001b[?2004l\r"]
[56.978932, "o", "\u001b[?2004h> "]
[56.979132, "o", "    if not history.empty:\r\n\u001b[?2004l\r"]
[56.979167, "o", "\u001b[?2004h> "]
[56.979581, "o", "        seen_ids = history[\"item_id\"].astype(int).tolist()\r\n\u001b[?2004l\r"]
[56.979616, "o", "\u001b[?2004h> "]
[56.979653, "o", "\r\n\u001b[?2004l\r"]
[56.979784, "o", "\u001b[?2004h> "]
[56.980093, "o", "    # Compute taste vector by joining history with items.\r\n\u001b[?2004l\r"]
[56.980132, "o", "\u001b[?2004h> "]
[56.980263, "o", "    if seen_ids:\r\n\u001b[?2004l\r"]
[56.980303, "o", "\u001b[?2004h"]
[56.980392, "o", "> "]
[56.980574, "o", "        items_df = items.to_pandas()\r\n\u001b[?2004l\r"]
[56.980611, "o", "\u001b[?2004h> "]
[56.981116, "o", "        taste_df = items_df[items_df[\"id\"].astype(int).isin(seen_ids)]\r\n\u001b[?2004l\r"]
[56.981152, "o", "\u001b[?2004h> "]
[56.98138, "o", "        if not taste_df.empty:\r\n\u001b[?2004l\r"]
[56.981415, "o", "\u001b[?2004h> "]
[56.98213, "o", "            embeddings = np.stack([np.asarray(v, dtype=np.float32) for v in taste_df[\"vector\"].values])\r\n\u001b[?2004l\r"]
[56.982166, "o", "\u001b[?2004h> "]
[56.982504, "o", "            taste_vec = embeddings.mean(axis=0)\r\n\u001b[?2004l\r"]
[56.982539, "o", "\u001b[?2004h> "]
[56.982672, "o", "        else:\r\n\u001b[?2004l\r"]
[56.982707, "o", "\u001b[?2004h"]
[56.982788, "o", "> "]
[56.982927, "o", "            taste_vec = None\r\n\u001b[?2004l\r"]
[56.982992, "o", "\u001b[?2004h> "]
[56.983054, "o", "    else:\r\n\u001b[?2004l\r"]
[56.983094, "o", "\u001b[?2004h> "]
[56.983276, "o", "        taste_vec = None\r\n\u001b[?2004l\r"]
[56.983316, "o", "\u001b[?2004h> "]
[56.983437, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[56.983508, "o", "    # Blend.\r\n\u001b[?2004l\r\u001b[?2004h"]
[56.983566, "o", "> "]
[56.983727, "o", "    if taste_vec is None:\r\n\u001b[?2004l\r"]
[56.983768, "o", "\u001b[?2004h> "]
