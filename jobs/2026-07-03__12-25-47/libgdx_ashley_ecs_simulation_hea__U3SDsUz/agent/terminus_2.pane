    id 'application'
    id 'java'
}

repositories {
    mavenCentral()
}

java {
    toolchain {
        languageVersion = JavaLanguageVersion.of(17)
    }
}

dependencies {
    implementation 'com.badlogicgames.gdx:gdx:1.13.1'
    implementation 'com.badlogicgames.gdx:gdx-backend-headless:1.13.1'
    implementation 'com.badlogicgames.gdx:gdx-platform:1.13.1:natives-desktop'
    implementation 'com.badlogicgames.ashley:ashley:1.7.4'
}

application {
    mainClass = 'gdxecs.Main'
    applicationDefaultJvmArgs = []
}

// Quiet down Gradle's stdout chatter so the headless run only emits the
// simulation output.
tasks.withType(JavaCompile).configureEach {
    options.encoding = 'UTF-8'
}
