[?2004l[?2004h> package gdxecs;
[?2004l[?2004h> 
[?2004l[?2004h> import com.badlogic.ashley.core.Engine;
[?2004l[?2004h> import com.badlogic.ashley.core.Entity;
[?2004l[?2004h> import com.badlogic.gdx.ApplicationListener;
[?2004l[?2004h> import com.badlogic.gdx.Gdx;
[?2004l[?2004h> import com.badlogic.gdx.files.FileHandle;
[?2004l[?2004h> 
[?2004l[?2004h> import java.io.BufferedReader;
[?2004l[?2004h> import java.io.IOException;
[?2004l[?2004h> import java.io.InputStreamReader;
[?2004l[?2004h> import java.nio.charset.StandardCharsets;
[?2004l[?2004h> import java.util.ArrayList;
[?2004l[?2004h> import java.util.List;
[?2004l[?2004h> import java.util.Locale;
[?2004l[?2004h> 
[?2004l[?2004h> /**
[?2004l[?2004h>  * Bootstraps an Ashley ECS world from a scenario file and runs a fixed-tick
[?2004l[?2004h>  * deterministic simulation on the libGDX headless backend.
[?2004l[?2004h>  *
[?2004l[?2004h>  * <p>On each invocation of {@link #render()} the engine is advanced by
[?2004l[?2004h>  * <code>1.0 / 60.0</code> seconds (NOT whatever {@code Gdx.graphics.getDeltaTime()}
[?2004l[?2004h>  * happens to return).  Once <code>TICKS</code> updates have been dispatched the
[?2004l[?2004h>  * final state of every entity is written to stdout and the headless app is
[?2004l[?2004h>  * asked to exit.  The <code>TICKS</code>=0 special case writes the initial
[?2004l[?2004h>  * state and exits on the very first render call.</p>
[?2004l[?2004h>  */
[?2004l[?2004h> public class GdxEcsSimulator implements ApplicationListener {
[?2004l[?2004h> 
[?2004l[?2004h>     /** Deterministic fixed time step used for every engine update. */
[?2004l[?2004h>     public static final float FIXED_DT = 1.0f / 60.0f;
[?2004l[?2004h> 
[?2004l[?2004h>     private final String scenarioPath;
[?2004l[?2004h> 
[?2004l[?2004h>     private Engine engine;
[?2004l[?2004h>     private int targetTicks;
[?2004l[?2004h>     /** The number of engine updates we have already dispatched. */
[?2004l[?2004h>     private int ticksDispatched;
[?2004l[?2004h>     /** Set to true exactly once we have produced the final-state report. */
[?2004l[?2004h>     private boolean finished;
[?2004l[?2004h> 
[?2004l[?2004h>     /** Entities in the order they were declared in the scenario file. */
[?2004l[?2004h>     private final List<EntityRecord> records = new ArrayList<EntityRecord>();
[?2004l[?2004h> 
[?2004l[?2004h>     /** Carries the original id and components for one entity so we can
[?2004l[?2004h>      *  reproduce the final output ordering regardless of internal storage. */
[?2004l[?2004h>     private static final class EntityRecord {
[?2004l[?2004h>         final String id;
[?2004l[?2004h>         final Entity entity;
[?2004l[?2004h>         EntityRecord(String id, Entity entity) {
[?2004l[?2004h>             this.id = id;
[?2004l[?2004h>             this.entity = entity;
[?2004l[?2004h>         }
[?2004l[?2004h>     }
[?2004l[?2004h> 
[?2004l[?2004h>     public GdxEcsSimulator(String scenarioPath) {
[?2004l[?2004h>         this.scenarioPath = scenarioPath;
[?2004l[?2004h>     }
[?2004l[?2004h> 
[?2004l[?2004h>     @Override
[?2004l[?2004h>     public void create() {
[?2004l[?2004h>         engine = new Engine();
[?2004l[?2004h>         engine.addSystem(new MovementSystem());
[?2004l[?2004h> 
[?2004l[?2004h>         loadScenario(scenarioPath);
[?2004l[?2004h>     }
[?2004l[?2004h> 
[?2004l[?2004h>     /**
[?2004l[?2004h>      * Parses the scenario file.  Lines beginning with {@code #} and blank
[?2004l[?2004h>      * lines are ignored.  Exactly one {@code TICKS <n>} line and zero or
[?2004l[?2004h>      * more {@code ENTITY <id> <x> <y> <vx> <vy>} lines are required.
[?2004l[?2004h>      */
[?2004l[?2004h>     private void loadScenario(String path) {
[?2004l[?2004h>         FileHandle handle = Gdx.files.absolute(path);
[?2004l[?2004h>         if (!handle.exists()) {
[?2004l[?2004h>             throw new IllegalArgumentException("Scenario file does not exist: " + path);
[?2004l[?2004h>         }
[?2004l[?2004h> 
[?2004l[?2004h>         BufferedReader reader = new BufferedReader(
[?2004l[?2004h>                 new InputStreamReader(handle.read(), StandardCharsets.UTF_8));
[?2004l[?2004h>         try {
[?2004l[?2004h>             String line;
[?2004l[?2004h>             boolean ticksSeen = false;
[?2004l[?2004h>             int lineNo = 0;
[?2004l[?2004h>             while ((line = reader.readLine()) != null) {
[?2004l[?2004h>                 lineNo++;
[?2004l[?2004h>                 String trimmed = line.trim();
[?2004l[?2004h>                 if (trimmed.isEmpty() || trimmed.startsWith("#")) {
[?2004l[?2004h>                     continue;
[?2004l[?2004h>                 }
[?2004l[?2004h>                 String[] parts = trimmed.split("\\s+");
[?2004l[?2004h>                 String head = parts[0];
[?2004l[?2004h>                 if ("TICKS".equals(head)) {
[?2004l[?2004h>                     if (parts.length != 2) {
[?2004l[?2004h>                         throw new IllegalArgumentException(
[?2004l[?2004h>                                 "Malformed TICKS line at " + lineNo + ": " + line);
[?2004l[?2004h>                     }
[?2004l[?2004h>                     targetTicks = Integer.parseInt(parts[1]);
[?2004l[?2004h>                     if (targetTicks < 0) {
[?2004l[?2004h>                         throw new IllegalArgumentException(
[?2004l[?2004h>                                 "TICKS must be non-negative at line " + lineNo);
[?2004l[?2004h>                     }
[?2004l[?2004h>                     ticksSeen = true;
[?2004l[?2004h>                 } else if ("ENTITY".equals(head)) {
[?2004l[?2004h>                     if (parts.length != 6) {
[?2004l[?2004h>                         throw new IllegalArgumentException(
[?2004l[?2004h>                                 "Malformed ENTITY line at " + lineNo + ": " + line);
[?2004l[?2004h>                     }
[?2004l[?2004h>                     String id = parts[1];
[?2004l[?2004h>                     if (!id.matches("[A-Za-z0-9_]+")) {
[?2004l[?2004h>                         throw new IllegalArgumentException(
[?2004l[?2004h>                                 "Invalid entity id at line " + lineNo + ": " + id);
[?2004l[?2004h>                     }
[?2004l[?2004h>                     float x  = Float.parseFloat(parts[2]);
[?2004l[?2004h>                     float y  = Float.parseFloat(parts[3]);
[?2004l[?2004h>                     float vx = Float.parseFloat(parts[4]);
[?2004l[?2004h>                     float vy = Float.parseFloat(parts[5]);
[?2004l[?2004h> 
[?2004l[?2004h>                     Entity e = new Entity();
[?2004l[?2004h>                     e.add(new PositionComponent(x, y));
[?2004l[?2004h>                     e.add(new VelocityComponent(vx, vy));
[?2004l[?2004h>                     engine.addEntity(e);
[?2004l[?2004h>                     records.add(new EntityRecord(id, e));
[?2004l[?2004h>                 } else {
[?2004l[?2004h>                     throw new IllegalArgumentException(
[?2004l[?2004h>                             "Unknown directive at line " + lineNo + ": " + head);
[?2004l[?2004h>                 }
[?2004l[?2004h>             }
[?2004l[?2004h>             if (!ticksSeen) {
[?2004l[?2004h>                 throw new IllegalArgumentException("Scenario is missing a TICKS line");
[?2004l[?2004h>             }
[?2004l[?2004h>         } catch (IOException ioe) {
[?2004l[?2004h>             throw new RuntimeException("Failed reading scenario file: " + path, ioe);
[?2004l[?2004h>         } finally {
[?2004l[?2004h>             try { reader.close(); } catch (IOException ignored) { }
[?2004l[?2004h>         }
[?2004l[?2004h>     }
[?2004l[?2004h> 
[?2004l[?2004h>     @Override
[?2004l[?2004h>     public void render() {
[?2004l[?2004h>         if (finished) {
[?2004l[?2004h>             return;
[?2004l[?2004h>         }
[?2004l[?2004h>         // Run one fixed step until we've reached the requested tick count.
[?2004l[?2004h>         if (ticksDispatched < targetTicks) {
[?2004l[?2004h>             engine.update(FIXED_DT);
[?2004l[?2004h>             ticksDispatched++;
[?2004l[?2004h>         }
[?2004l[?2004h>         // Whether or not we just dispatched a step, when we've reached the
[?2004l[?2004h>         // target tick count we emit the report and ask the headless app to
[?2004l[?2004h>         // exit (this also handles the TICKS=0 special case).
[?2004l[?2004h>         if (ticksDispatched >= targetTicks) {
[?2004l[?2004h>             finished = true;
[?2004l[?2004h>             writeFinalState();
[?2004l[?2004h>             Gdx.app.exit();
[?2004l[?2004h>         }
[?2004l[?2004h>     }
[?2004l[?2004h> 
[?2004l[?2004h>     /** Emits the deterministic final-state report to stdout. */
[?2004l[?2004h>     private void writeFinalState() {
[?2004l[?2004h>         StringBuilder sb = new StringBuilder();
[?2004l[?2004h>         sb.append("TICK_COUNT ").append(targetTicks).append('\n');
[?2004l[?2004h>         for (EntityRecord r : records) {
[?2004l[?2004h>             PositionComponent pos = r.entity.getComponent(PositionComponent.class);
[?2004l[?2004h>             sb.append("ENTITY ")
[?2004l[?2004h>               .append(r.id)
[?2004l[?2004h>               .append(" x=").append(formatFloat(pos.x))
[?2004l[?2004h>               .append(" y=").append(formatFloat(pos.y))
[?2004l[?2004h>               .append('\n');
[?2004l[?2004h>         }
[?2004l[?2004h>         System.out.print(sb.toString());
[?2004l[?2004h>         System.out.flush();
[?2004l[?2004h>     }
[?2004l[?2004h> 
[?2004l[?2004h>     /** Formats a float with exactly three decimal places using Locale.ROOT. */
[?2004l[?2004h>     public static String formatFloat(float v) {
[?2004l[?2004h>         return String.format(Locale.ROOT, "%.3f", v);
[?2004l[?2004h>     }
[?2004l[?2004h> 
[?2004l[?2004h>     @Override public void resize(int width, int height) { }
[?2004l[?2004h>     @Override public void pause() { }
[?2004l[?2004h>     @Override public void resume() { }
[?2004l[?2004h>     @Override public void dispose() { }
[?2004l[?2004h> }
