[110.287087, "o", "        }\r\n\u001b[?2004l\r\u001b[?2004h>         // Fallback: hunt through live threads.\r\n\u001b[?2004l\r\u001b[?2004h>         Map<Thread, StackTraceElement[]> traces = Thread.getAllStackTraces();\r\n\u001b[?2004l\r\u001b[?2004h>         for (Thread t : traces.keySet()) {\r\n\u001b[?2004l\r\u001b[?2004h>             if (\"HeadlessApplication\".equals(t.getName())) {\r\n\u001b[?2004l\r"]
[110.287158, "o", "\u001b[?2004h> "]
