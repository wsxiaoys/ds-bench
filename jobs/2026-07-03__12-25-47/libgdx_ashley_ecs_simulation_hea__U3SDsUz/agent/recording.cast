[120.903739, "i", "cat > /home/user/gdx-ecs/run.sh << 'EOF'\n#!/usr/bin/env bash\n# Entry point for the deterministic Ashley ECS simulation.\n# Usage: run.sh <scenario-file>\n#\n# Only the simulation's stdout is propagated.  All Gradle progress output\n# and any other chatter are diverted to stderr so they don't pollute the\n# captured simulation result.\n\nset -eu\n\nHERE=\"$(cd \"$(dirname \"$0\")\" && pwd)\"\ncd \"$HERE\"\n\nif [ \"$#\" -lt 1 ]; then\n    echo \"usage: run.sh <scenario-file>\" >&2\n    exit 2\nfi\n\nSCENARIO=\"$1\"\n\n# Run via `gradle -q` so Gradle swallows its own logging on stdout/stderr.\n# -q still lets our program's System.out through (because System.out is\n# inherited from the Java process Gradle launches).\n#\n# To make absolutely sure NO Gradle noise reaches stdout (some tasks can still\n# print under -q), we explicitly redirect Gradle's 1/2 file descriptors and\n# capture only the standard streams of the launched JVM.\n\ngradle -q --console=plain run --args=\"\\\"$SCENARIO\\\"\" '\n' 2> >(grep -v -E '^(BUILD|FAILURE|> Configure|> Task|> :)' >&2 || true) > /tmp/gdx_ecs_stdout.tmp\nstatus=$?\n\n# If gradle itself errored, bubble that error up.\nif [ $status -ne 0 ]; then\n    cat /tmp/gdx_ecs_stdout.tmp >&2 || true\n    rm -f /tmp/gdx_ecs_stdout.tmp\n    exit \"$status\"\nfi\n\ncat /tmp/gdx_ecs_stdout.tmp\nrm -f /tmp/gdx_ecs_stdout.tmp\nexit 0\nEOF\n"]
