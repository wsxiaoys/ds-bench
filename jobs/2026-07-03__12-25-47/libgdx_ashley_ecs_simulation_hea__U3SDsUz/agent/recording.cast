[357.768525, "o", "\u001b[?2004h> "]
[357.769086, "o", "        engine.addSystem(new MovementSystem());\r\n\u001b[?2004l\r"]
[357.769163, "o", "\u001b[?2004h"]
[357.769211, "o", "> \r\n\u001b[?2004l\r"]
[357.769268, "o", "\u001b[?2004h"]
