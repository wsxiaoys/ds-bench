[98.595952, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[98.59601, "o", "\u001b[?2004h"]
[98.596079, "o", "> /**\r\n"]
[98.596233, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[98.596995, "o", " * Bootstraps an Ashley ECS world from a scenario file and runs a fixed-tick\r\n\u001b[?2004l\r"]
[98.597059, "o", "\u001b[?2004h> "]
[98.597716, "o", " * deterministic simulation on the libGDX headless backend.\r\n\u001b[?2004l\r"]
[98.597774, "o", "\u001b[?2004h> "]
[98.597832, "o", " *\r\n\u001b[?2004l\r"]
[98.597956, "o", "\u001b[?2004h> "]
[98.598664, "o", " * <p>On each invocation of {@link #render()} the engine is advanced by\r\n\u001b[?2004l\r"]
[98.598723, "o", "\u001b[?2004h> "]
[98.599615, "o", " * <code>1.0 / 60.0</code> seconds (NOT whatever {@code Gdx.graphics.getDeltaTime()}\r\n\u001b[?2004l\r"]
[98.599677, "o", "\u001b[?2004h> "]
[98.600558, "o", " * happens to return).  Once <code>TICKS</code> updates have been dispatched the\r\n\u001b[?2004l\r"]
[98.600617, "o", "\u001b[?2004h> "]
[98.601468, "o", " * final state of every entity is written to stdout and the headless app is\r\n\u001b[?2004l\r"]
[98.601529, "o", "\u001b[?2004h> "]
[98.601809, "o", " * asked to exit.</p>\r\n\u001b[?2004l\r"]
[98.601869, "o", "\u001b[?2004h> "]
[98.601924, "o", " */\r\n\u001b[?2004l\r"]
[98.601984, "o", "\u001b[?2004h> "]
[98.602707, "o", "public class GdxEcsSimulator implements ApplicationListener {\r\n\u001b[?2004l\r"]
[98.602766, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[98.602872, "o", "\u001b[?2004h> "]
[98.603596, "o", "    /** Deterministic fixed time step used for every engine update. */\r\n\u001b[?2004l\r"]
[98.603654, "o", "\u001b[?2004h> "]
[98.604265, "o", "    public static final float FIXED_DT = 1.0f / 60.0f;\r\n\u001b[?2004l\r"]
[98.604325, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[98.604426, "o", "\u001b[?2004h> "]
[98.604853, "o", "    private final String scenarioPath;\r\n\u001b[?2004l\r"]
[98.604908, "o", "\u001b[?2004h> "]
[98.605009, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[98.605339, "o", "    private Engine engine;\r\n\u001b[?2004l\r"]
[98.605399, "o", "\u001b[?2004h> "]
[98.605735, "o", "    private int targetTicks;\r\n\u001b[?2004l\r"]
[98.605793, "o", "\u001b[?2004h> "]
[98.606516, "o", "    /** The number of engine updates we have already dispatched. */\r\n\u001b[?2004l\r"]
[98.606612, "o", "\u001b[?2004h> "]
[98.606948, "o", "    private int ticksDispatched;\r\n\u001b[?2004l\r"]
[98.607006, "o", "\u001b[?2004h> "]
[98.607126, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[98.607879, "o", "    /** Entities in the order they were declared in the scenario file. */\r\n\u001b[?2004l\r"]
[98.607934, "o", "\u001b[?2004h> "]
[98.608794, "o", "    private final List<EntityRecord> records = new ArrayList<EntityRecord>();\r\n\u001b[?2004l\r"]
[98.608851, "o", "\u001b[?2004h> "]
[98.60895, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[98.609714, "o", "    /** Carries the original id and components for one entity so we can\r\n\u001b[?2004l\r"]
[98.609772, "o", "\u001b[?2004h> "]
[98.610611, "o", "     *  reproduce the final output ordering regardless of internal storage. */\r\n\u001b[?2004l\r"]
[98.610668, "o", "\u001b[?2004h> "]
[98.611193, "o", "    private static final class EntityRecord {\r\n\u001b[?2004l\r"]
[98.611251, "o", "\u001b[?2004h> "]
[98.611558, "o", "        final String id;\r\n\u001b[?2004l\r"]
[98.611615, "o", "\u001b[?2004h> "]
[98.611953, "o", "        final Entity entity;\r\n\u001b[?2004l\r"]
[98.612012, "o", "\u001b[?2004h> "]
[98.612569, "o", "        EntityRecord(String id, Entity entity) {\r\n\u001b[?2004l\r"]
[98.612629, "o", "\u001b[?2004h> "]
[98.612946, "o", "            this.id = id;\r\n\u001b[?2004l\r"]
[98.613006, "o", "\u001b[?2004h> "]
[98.613396, "o", "            this.entity = entity;\r\n\u001b[?2004l\r"]
[98.61352, "o", "\u001b[?2004h> "]
[98.61358, "o", "        }\r\n\u001b[?2004l\r"]
[98.613706, "o", "\u001b[?2004h> "]
[98.613766, "o", "    }\r\n\u001b[?2004l\r"]
[98.61386, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[98.613924, "o", "\u001b[?2004h> "]
[98.614444, "o", "    public GdxEcsSimulator(String scenarioPath) {\r\n\u001b[?2004l\r"]
[98.614504, "o", "\u001b[?2004h> "]
[98.614924, "o", "        this.scenarioPath = scenarioPath;\r\n\u001b[?2004l\r"]
[98.614983, "o", "\u001b[?2004h> "]
[98.615121, "o", "    }\r\n\u001b[?2004l\r\u001b[?2004h"]
[98.615181, "o", "> \r\n\u001b[?2004l\r"]
[98.61529, "o", "\u001b[?2004h> "]
[98.615378, "o", "    @Override\r\n\u001b[?2004l\r"]
[98.615434, "o", "\u001b[?2004h> "]
[98.615716, "o", "    public void create() {\r\n\u001b[?2004l\r"]
[98.615779, "o", "\u001b[?2004h> "]
[98.616104, "o", "        engine = new Engine();\r\n\u001b[?2004l\r"]
[98.616162, "o", "\u001b[?2004h> "]
[98.616656, "o", "        engine.addSystem(new MovementSystem());\r\n\u001b[?2004l\r"]
[98.616715, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[98.61684, "o", "\u001b[?2004h> "]
[98.61718, "o", "        loadScenario(scenarioPath);\r\n\u001b[?2004l\r"]
[98.61724, "o", "\u001b[?2004h> "]
[98.61732, "o", "    }\r\n\u001b[?2004l\r"]
[98.617429, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[98.617485, "o", "> "]
[98.617571, "o", "    /**\r\n\u001b[?2004l\r"]
[98.617685, "o", "\u001b[?2004h> "]
[98.618368, "o", "     * Parses the scenario file.  Lines beginning with {@code #} and blank\r\n\u001b[?2004l\r"]
[98.618422, "o", "\u001b[?2004h> "]
[98.619169, "o", "     * lines are ignored.  Exactly one {@code TICKS <n>} line and zero or\r\n\u001b[?2004l\r"]
[98.619226, "o", "\u001b[?2004h> "]
[98.619917, "o", "     * more {@code ENTITY <id> <x> <y> <vx> <vy>} lines are required.\r\n\u001b[?2004l\r"]
[98.619974, "o", "\u001b[?2004h> "]
[98.620094, "o", "     */\r\n\u001b[?2004l\r"]
[98.620178, "o", "\u001b[?2004h> "]
[98.620588, "o", "    private void loadScenario(String path) {\r\n\u001b[?2004l\r"]
[98.620644, "o", "\u001b[?2004h> "]
[98.621195, "o", "        FileHandle handle = Gdx.files.absolute(path);\r\n\u001b[?2004l\r"]
[98.621255, "o", "\u001b[?2004h> "]
[98.621583, "o", "        if (!handle.exists()) {\r\n\u001b[?2004l\r"]
[98.621639, "o", "\u001b[?2004h> "]
[98.622518, "o", "            throw new IllegalArgumentException(\"Scenario file does not exist: \" + path);\r\n\u001b[?2004l\r"]
[98.622573, "o", "\u001b[?2004h> "]
[98.622692, "o", "        }\r\n\u001b[?2004l\r"]
[98.62275, "o", "\u001b[?2004h> "]
[98.62286, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[98.623305, "o", "        BufferedReader reader = new BufferedReader(\r\n\u001b[?2004l\r"]
[98.623365, "o", "\u001b[?2004h> "]
[98.624023, "o", "                new InputStreamReader(handle.read(), StandardCharsets.UTF_8));\r\n\u001b[?2004l\r"]
[98.62409, "o", "\u001b[?2004h> "]
[98.624231, "o", "        try {\r\n\u001b[?2004l\r"]
[98.624291, "o", "\u001b[?2004h> "]
[98.624536, "o", "            String line;\r\n\u001b[?2004l\r"]
[98.624597, "o", "\u001b[?2004h> "]
[98.624907, "o", "            boolean ticksSeen = false;\r\n\u001b[?2004l\r"]
[98.624967, "o", "\u001b[?2004h> "]
[98.625227, "o", "            int lineNo = 0;\r\n\u001b[?2004l\r"]
[98.625286, "o", "\u001b[?2004h> "]
[98.625763, "o", "            while ((line = reader.readLine()) != null) {\r\n\u001b[?2004l\r"]
[98.625821, "o", "\u001b[?2004h> "]
[98.626061, "o", "                lineNo++;\r\n\u001b[?2004l\r"]
[98.626119, "o", "\u001b[?2004h> "]
[98.626517, "o", "                String trimmed = line.trim();\r\n\u001b[?2004l\r"]
[98.626575, "o", "\u001b[?2004h> "]
[98.627153, "o", "                if (trimmed.isEmpty() || trimmed.startsWith(\"#\")) {\r\n\u001b[?2004l\r"]
[98.627212, "o", "\u001b[?2004h> "]
[98.627473, "o", "                    continue;\r\n\u001b[?2004l\r"]
[98.627533, "o", "\u001b[?2004h> "]
[98.6277, "o", "                }\r\n\u001b[?2004l\r"]
[98.627759, "o", "\u001b[?2004h> "]
[98.628245, "o", "                String[] parts = trimmed.split(\"\\\\s+\");\r\n\u001b[?2004l\r"]
[98.628304, "o", "\u001b[?2004h> "]
[98.628644, "o", "                String head = parts[0];\r\n\u001b[?2004l\r"]
[98.628703, "o", "\u001b[?2004h> "]
[98.629092, "o", "                if (\"TICKS\".equals(head)) {\r\n\u001b[?2004l\r"]
[98.629153, "o", "\u001b[?2004h> "]
[98.629531, "o", "                    if (parts.length != 2) {\r\n\u001b[?2004l\r"]
[98.629588, "o", "\u001b[?2004h> "]
[98.630102, "o", "                        throw new IllegalArgumentException(\r\n\u001b[?2004l\r"]
[98.630162, "o", "\u001b[?2004h> "]
[98.63086, "o", "                                \"Malformed TICKS line at \" + lineNo + \": \" + line);\r\n\u001b[?2004l\r"]
[98.63092, "o", "\u001b[?2004h> "]
[98.631132, "o", "                    }\r\n\u001b[?2004l\r"]
[98.631192, "o", "\u001b[?2004h> "]
[98.631717, "o", "                    targetTicks = Integer.parseInt(parts[1]);\r\n\u001b[?2004l\r"]
[98.63178, "o", "\u001b[?2004h> "]
[98.632156, "o", "                    if (targetTicks < 0) {\r\n\u001b[?2004l\r"]
[98.632215, "o", "\u001b[?2004h> "]
[98.632721, "o", "                        throw new IllegalArgumentException(\r\n\u001b[?2004l\r"]
[98.632782, "o", "\u001b[?2004h> "]
[98.633505, "o", "                                \"TICKS must be non-negative at line \" + lineNo);\r\n\u001b[?2004l\r\u001b[?2004h"]
[98.633625, "o", "> "]
[98.633733, "o", "                    }\r\n\u001b[?2004l\r"]
[98.633804, "o", "\u001b[?2004h> "]
[98.634135, "o", "                    ticksSeen = true;\r\n\u001b[?2004l\r"]
[98.634204, "o", "\u001b[?2004h> "]
[98.634636, "o", "                } else if (\"ENTITY\".equals(head)) {\r\n\u001b[?2004l\r"]
[98.634707, "o", "\u001b[?2004h> "]
[98.635086, "o", "                    if (parts.length != 6) {\r\n\u001b[?2004l\r"]
[98.635156, "o", "\u001b[?2004h> "]
[98.635651, "o", "                        throw new IllegalArgumentException(\r\n\u001b[?2004l\r"]
[98.635721, "o", "\u001b[?2004h> "]
[98.636439, "o", "                                \"Malformed ENTITY line at \" + lineNo + \": \" + line);\r\n\u001b[?2004l\r"]
[98.636509, "o", "\u001b[?2004h> "]
[98.636694, "o", "                    }\r\n\u001b[?2004l\r"]
[98.636765, "o", "\u001b[?2004h> "]
[98.637117, "o", "                    String id = parts[1];\r\n\u001b[?2004l\r"]
[98.637187, "o", "\u001b[?2004h> "]
[98.637637, "o", "                    if (!id.matches(\"[A-Za-z0-9_]+\")) {\r\n\u001b[?2004l\r\u001b[?2004h"]
[98.637707, "o", "> "]
[98.638019, "o", "                        throw new IllegalArgumentException(\r\n\u001b[?2004l\r\u001b[?2004h"]
[98.63822, "o", "> "]
[98.638544, "o", "                                \"Invalid entity id at line \" + lineNo + \": \" + id);\r\n\u001b[?2004l\r\u001b[?2004h"]
[98.638655, "o", "> "]
[98.638759, "o", "                    }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[98.639116, "o", "                    float x  = Float.parseFloat(parts[2]);\r\n\u001b[?2004l\r\u001b[?2004h"]
[98.639214, "o", "> "]
[98.639486, "o", "                    float y  = Float.parseFloat(parts[3]);\r\n\u001b[?2004l\r\u001b[?2004h"]
[98.639578, "o", "> "]
[98.639741, "o", "                    float vx = Float.parseFloat(parts[4]);\r\n\u001b[?2004l\r\u001b[?2004h> "]
[98.639929, "o", "                    float vy = Float.parseFloat(parts[5]);\r\n\u001b[?2004l\r\u001b[?2004h> \r\n"]
[98.63998, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[98.687307, "o", "                    Entity e = new Entity();\r\n\u001b[?2004l\r\u001b[?2004h>                     e.add(new PositionComponent(x, y));\r\n\u001b[?2004l\r\u001b[?2004h>                     e.add(new VelocityComponent(vx, vy));\r\n\u001b[?2004l\r\u001b[?2004h>                     engine.addEntity(e);\r\n\u001b[?2004l\r\u001b[?2004h>                     records.add(new EntityRecord(id, e));\r\n\u001b[?2004l\r\u001b[?2004h>                 } else {\r\n\u001b[?2004l\r\u001b[?2004h>                     throw new IllegalArgumentException(\r\n\u001b[?2004l\r\u001b[?2004h>                             \"Unknown directive at line \" + lineNo + \": \" + head);\r\n\u001b[?2004l\r\u001b[?2004h>                 }\r\n\u001b[?2004l\r\u001b[?2004h>             }\r\n\u001b[?2004l\r\u001b[?2004h>             if (!ticksSeen) {\r\n\u001b[?2004l\r\u001b[?2004h>                 throw new IllegalArgumentException(\"Scenario is missing a TICKS line\");\r\n\u001b[?2004l\r\u001b[?2004h>             }\r\n\u001b[?2004l\r\u001b[?2004h>         } catch (IOException ioe) {\r\n\u001b[?2004l\r\u001b[?2004h>             throw new RuntimeException(\"Failed reading scenario file: \" + path, ioe);\r\n\u001b[?2004l\r\u001b[?2004h>         } finally {\r\n\u001b[?2004l\r\u001b[?2004h>             try { reader.close(); } catch (IOException ignored) { }\r\n\u001b[?2004l\r\u001b[?2004h>         }\r\n\u001b[?2004l\r\u001b[?2004h>     }\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h>     @Override\r\n\u001b[?2004l\r\u001b[?2004h>     public void render() {\r\n\u001b[?2004l\r\u001b[?2004h>         // Drive the world exactly one fixed step per render() call.\r\n\u001b[?2004l\r\u001b[?2004h>         if (ticksDispatched < targetTicks) {\r\n\u001b[?2004l\r\u001b[?2004h>             engine.update(FIXED_DT);\r\n\u001b[?2004l\r\u001b[?2004h>             ticksDispatched++;\r\n\u001b[?2004l\r\u001b[?2004h>             if (ticksDispatched >= targetTicks) {\r\n\u001b[?2004l\r\u001b[?2004h>                 writeFinalState();\r\n\u001b[?2004l\r\u001b[?2004h>                 Gdx.app.exit();\r\n\u001b[?2004l\r\u001b[?2004h>             }\r\n\u001b[?2004l\r\u001b[?2004h>         }\r\n\u001b[?2004l\r\u001b[?2004h>     }\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h>     /** Emits the deterministic final-state report to stdout. */\r\n\u001b[?2004l\r\u001b[?2004h>     private void writeFinalState() {\r\n\u001b[?2004l\r\u001b[?2004h>         StringBuilder sb = new StringBuilder();\r\n\u001b[?2004l\r\u001b[?2004h>         sb.append(\"TICK_COUNT \").append(targetTicks).append('\\n');\r\n\u001b[?2004l\r"]
