[357.793423, "o", "> "]
[357.793526, "o", "    private void writeFinalState() {\r\n\u001b[?2004l\r"]
[357.793554, "o", "\u001b[?2004h> "]
[357.79372, "o", "        StringBuilder sb = new StringBuilder();\r\n\u001b[?2004l\r"]
[357.793763, "o", "\u001b[?2004h> "]
[357.793965, "o", "        sb.append(\"TICK_COUNT \").append(targetTicks).append('\\n');\r\n\u001b[?2004l\r\u001b[?2004h"]
[357.793994, "o", "> "]
[357.794138, "o", "        for (EntityRecord r : records) {\r\n\u001b[?2004l\r"]
[357.794167, "o", "\u001b[?2004h> "]
[357.794442, "o", "            PositionComponent pos = r.entity.getComponent(PositionComponent.class);\r\n\u001b[?2004l\r\u001b[?2004h"]
[357.794483, "o", "> "]
[357.794573, "o", "            sb.append(\"ENTITY \")\r\n\u001b[?2004l\r"]
[357.794598, "o", "\u001b[?2004h> "]
[357.794702, "o", "              .append(r.id)\r\n\u001b[?2004l\r"]
[357.794728, "o", "\u001b[?2004h> "]
[357.794915, "o", "              .append(\" x=\").append(formatFloat(pos.x))\r\n\u001b[?2004l\r"]
[357.794942, "o", "\u001b[?2004h> "]
[357.795139, "o", "              .append(\" y=\").append(formatFloat(pos.y))\r\n\u001b[?2004l\r"]
[357.795165, "o", "\u001b[?2004h> "]
[357.795271, "o", "              .append('\\n');\r\n\u001b[?2004l\r"]
[357.795295, "o", "\u001b[?2004h> "]
[357.795341, "o", "        }\r\n\u001b[?2004l\r"]
[357.795365, "o", "\u001b[?2004h> "]
[357.795514, "o", "        System.out.print(sb.toString());\r\n\u001b[?2004l\r"]
[357.795538, "o", "\u001b[?2004h> "]
[357.795644, "o", "        System.out.flush();\r\n\u001b[?2004l\r"]
[357.795669, "o", "\u001b[?2004h> "]
[357.795723, "o", "    }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[357.795747, "o", "\r\n\u001b[?2004l\r\u001b[?2004h"]
[357.795801, "o", "> "]
[357.796028, "o", "    /** Formats a float with exactly three decimal places using Locale.ROOT. */\r\n\u001b[?2004l\r"]
[357.79613, "o", "\u001b[?2004h> "]
