[357.769714, "o", "> "]
[357.769752, "o", "    }\r\n\u001b[?2004l\r"]
[357.7698, "o", "\u001b[?2004h"]
[357.769826, "o", "> \r\n"]
[357.769855, "o", "\u001b[?2004l\r"]
[357.769887, "o", "\u001b[?2004h"]
[357.769919, "o", "> "]
[357.770026, "o", "    /**\r\n\u001b[?2004l\r\u001b[?2004h"]
[357.770085, "o", "> "]
[357.77074, "o", "     * Parses the scenario file.  Lines beginning with {@code #} and blank\r\n\u001b[?2004l\r"]
[357.770779, "o", "\u001b[?2004h"]
[357.770806, "o", "> "]
[357.771469, "o", "     * lines are ignored.  Exactly one {@code TICKS <n>} line and zero or\r\n\u001b[?2004l\r"]
[357.771511, "o", "\u001b[?2004h> "]
[357.772144, "o", "     * more {@code ENTITY <id> <x> <y> <vx> <vy>} lines are required.\r\n\u001b[?2004l\r"]
[357.772196, "o", "\u001b[?2004h"]
[357.772233, "o", "> "]
[357.772295, "o", "     */\r\n\u001b[?2004l\r"]
[357.772342, "o", "\u001b[?2004h"]
[357.772379, "o", "> "]
[357.772764, "o", "    private void loadScenario(String path) {\r\n\u001b[?2004l\r"]
[357.772824, "o", "\u001b[?2004h"]
[357.772923, "o", "> "]
[357.773376, "o", "        FileHandle handle = Gdx.files.absolute(path);\r\n\u001b[?2004l\r"]
[357.773458, "o", "\u001b[?2004h"]
[357.773525, "o", "> "]
[357.773787, "o", "        if (!handle.exists()) {\r\n\u001b[?2004l\r"]
[357.773865, "o", "\u001b[?2004h"]
[357.77393, "o", "> "]
[357.774708, "o", "            throw new IllegalArgumentException(\"Scenario file does not exist: \" + path);\r\n\u001b[?2004l\r"]
[357.774782, "o", "\u001b[?2004h> "]
[357.774902, "o", "        }\r\n\u001b[?2004l\r"]
[357.774969, "o", "\u001b[?2004h"]
[357.775038, "o", "> \r\n\u001b[?2004l\r"]
[357.775067, "o", "\u001b[?2004h"]
[357.775091, "o", "> "]
[357.775609, "o", "        BufferedReader reader = new BufferedReader(\r\n\u001b[?2004l\r"]
[357.775686, "o", "\u001b[?2004h"]
[357.775748, "o", "> "]
[357.776432, "o", "                new InputStreamReader(handle.read(), StandardCharsets.UTF_8));\r\n\u001b[?2004l\r"]
[357.77651, "o", "\u001b[?2004h> "]
[357.776659, "o", "        try {\r\n\u001b[?2004l\r"]
[357.776735, "o", "\u001b[?2004h"]
[357.7768, "o", "> "]
[357.777004, "o", "            String line;\r\n\u001b[?2004l\r"]
[357.77709, "o", "\u001b[?2004h"]
[357.777156, "o", "> "]
[357.777461, "o", "            boolean ticksSeen = false;\r\n\u001b[?2004l\r"]
[357.777526, "o", "\u001b[?2004h"]
[357.777559, "o", "> "]
[357.77776, "o", "            int lineNo = 0;\r\n\u001b[?2004l\r"]
[357.777793, "o", "\u001b[?2004h"]
[357.777871, "o", "> "]
[357.778258, "o", "            while ((line = reader.readLine()) != null) {\r\n\u001b[?2004l\r"]
[357.778321, "o", "\u001b[?2004h> "]
[357.778501, "o", "                lineNo++;\r\n\u001b[?2004l\r"]
[357.778561, "o", "\u001b[?2004h> "]
[357.778864, "o", "                String trimmed = line.trim();\r\n\u001b[?2004l\r"]
[357.778925, "o", "\u001b[?2004h> "]
[357.779364, "o", "                if (trimmed.isEmpty() || trimmed.startsWith(\"#\")) {\r\n\u001b[?2004l\r"]
[357.779393, "o", "\u001b[?2004h> "]
[357.779496, "o", "                    continue;\r\n\u001b[?2004l\r"]
[357.779525, "o", "\u001b[?2004h> "]
[357.779597, "o", "                }\r\n\u001b[?2004l\r"]
[357.779625, "o", "\u001b[?2004h> "]
[357.779815, "o", "                String[] parts = trimmed.split(\"\\\\s+\");\r\n\u001b[?2004l\r"]
[357.779846, "o", "\u001b[?2004h> "]
[357.779983, "o", "                String head = parts[0];\r\n\u001b[?2004l\r"]
[357.780012, "o", "\u001b[?2004h> "]
[357.780167, "o", "                if (\"TICKS\".equals(head)) {\r\n\u001b[?2004l\r"]
[357.780195, "o", "\u001b[?2004h> "]
[357.780348, "o", "                    if (parts.length != 2) {\r\n\u001b[?2004l\r"]
[357.780375, "o", "\u001b[?2004h> "]
[357.780577, "o", "                        throw new IllegalArgumentException(\r\n\u001b[?2004l\r"]
[357.780604, "o", "\u001b[?2004h> "]
[357.780881, "o", "                                \"Malformed TICKS line at \" + lineNo + \": \" + line);\r\n\u001b[?2004l\r"]
[357.780912, "o", "\u001b[?2004h> "]
[357.780994, "o", "                    }\r\n\u001b[?2004l\r"]
[357.781024, "o", "\u001b[?2004h> "]
[357.781234, "o", "                    targetTicks = Integer.parseInt(parts[1]);\r\n\u001b[?2004l\r"]
[357.781265, "o", "\u001b[?2004h> "]
[357.787037, "o", "                    if (targetTicks < 0) {\r\n\u001b[?2004l\r\u001b[?2004h>                         throw new IllegalArgumentException(\r\n\u001b[?2004l\r\u001b[?2004h>                                 \"TICKS must be non-negative at line \" + lineNo);\r\n\u001b[?2004l\r\u001b[?2004h>                     }\r\n\u001b[?2004l\r\u001b[?2004h>                     ticksSeen = true;\r\n\u001b[?2004l\r\u001b[?2004h>                 } else if (\"ENTITY\".equals(head)) {\r\n\u001b[?2004l\r\u001b[?2004h>                     if (parts.length != 6) {\r\n\u001b[?2004l\r\u001b[?2004h>                         throw new IllegalArgumentException(\r\n\u001b[?2004l\r\u001b[?2004h>                                 \"Malformed ENTITY line at \" + lineNo + \": \" + line);\r\n\u001b[?2004l\r\u001b[?2004h>                     }\r\n\u001b[?2004l\r\u001b[?2004h>                     String id = parts[1];\r\n\u001b[?2004l\r\u001b[?2004h>                     if (!id.matches(\"[A-Za-z0-9_]+\")) {\r\n\u001b[?2004l\r\u001b[?2004h>                         throw new IllegalArgumentException(\r\n\u001b[?2004l\r\u001b[?2004h>                                 \"Invalid entity id at line \" + lineNo + \": \" + id);\r\n\u001b[?2004l\r\u001b[?2004h>                     }\r\n\u001b[?2004l\r\u001b[?2004h>                     float x  = Float.parseFloat(parts[2]);\r\n\u001b[?2004l\r\u001b[?2004h>                     float y  = Float.parseFloat(parts[3]);\r\n\u001b[?2004l\r\u001b[?2004h>                     float vx = Float.parseFloat(parts[4]);\r\n\u001b[?2004l\r\u001b[?2004h>                     float vy = Float.parseFloat(parts[5]);\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h>                     Entity e = new Entity();\r\n\u001b[?2004l\r\u001b[?2004h"]
[357.787111, "o", "> "]
[357.787235, "o", "                    e.add(new PositionComponent(x, y));\r\n\u001b[?2004l\r"]
[357.787267, "o", "\u001b[?2004h> "]
[357.787459, "o", "                    e.add(new VelocityComponent(vx, vy));\r\n\u001b[?2004l\r"]
[357.787501, "o", "\u001b[?2004h> "]
[357.787621, "o", "                    engine.addEntity(e);\r\n\u001b[?2004l\r"]
[357.78765, "o", "\u001b[?2004h> "]
[357.787844, "o", "                    records.add(new EntityRecord(id, e));\r\n\u001b[?2004l\r"]
[357.787873, "o", "\u001b[?2004h> "]
[357.787964, "o", "                } else {\r\n\u001b[?2004l\r"]
[357.788007, "o", "\u001b[?2004h> "]
[357.788181, "o", "                    throw new IllegalArgumentException(\r\n\u001b[?2004l\r"]
[357.788212, "o", "\u001b[?2004h> "]
[357.788478, "o", "                            \"Unknown directive at line \" + lineNo + \": \" + head);\r\n\u001b[?2004l\r"]
[357.788519, "o", "\u001b[?2004h> "]
[357.788568, "o", "                }\r\n\u001b[?2004l\r"]
[357.788595, "o", "\u001b[?2004h> "]
[357.788657, "o", "            }\r\n\u001b[?2004l\r"]
[357.788685, "o", "\u001b[?2004h> "]
[357.788799, "o", "            if (!ticksSeen) {\r\n\u001b[?2004l\r"]
[357.788828, "o", "\u001b[?2004h> "]
[357.789117, "o", "                throw new IllegalArgumentException(\"Scenario is missing a TICKS line\");\r\n\u001b[?2004l\r"]
[357.789147, "o", "\u001b[?2004h> "]
[357.789205, "o", "            }\r\n\u001b[?2004l\r"]
[357.789233, "o", "\u001b[?2004h> "]
[357.78936, "o", "        } catch (IOException ioe) {\r\n\u001b[?2004l\r"]
[357.789389, "o", "\u001b[?2004h> "]
[357.789667, "o", "            throw new RuntimeException(\"Failed reading scenario file: \" + path, ioe);\r\n\u001b[?2004l\r"]
[357.789697, "o", "\u001b[?2004h> "]
[357.78977, "o", "        } finally {\r\n\u001b[?2004l\r"]
[357.789798, "o", "\u001b[?2004h> "]
[357.790026, "o", "            try { reader.close(); } catch (IOException ignored) { }\r\n\u001b[?2004l\r"]
[357.790069, "o", "\u001b[?2004h> "]
[357.790128, "o", "        }\r\n\u001b[?2004l\r\u001b[?2004h"]
[357.790156, "o", ">     }\r\n\u001b[?2004l\r"]
[357.790207, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[357.790237, "o", "\u001b[?2004h> "]
[357.790296, "o", "    @Override\r\n\u001b[?2004l\r"]
[357.790324, "o", "\u001b[?2004h> "]
[357.790429, "o", "    public void render() {\r\n\u001b[?2004l\r"]
[357.790458, "o", "\u001b[?2004h> "]
[357.790546, "o", "        if (finished) {\r\n\u001b[?2004l\r"]
[357.790575, "o", "\u001b[?2004h> "]
[357.790652, "o", "            return;\r\n\u001b[?2004l\r"]
[357.790681, "o", "\u001b[?2004h> "]
[357.790737, "o", "        }\r\n\u001b[?2004l\r\u001b[?2004h"]
[357.790765, "o", "> "]
[357.791006, "o", "        // Run one fixed step until we've reached the requested tick count.\r\n\u001b[?2004l\r\u001b[?2004h"]
[357.791044, "o", "> "]
[357.791194, "o", "        if (ticksDispatched < targetTicks) {\r\n\u001b[?2004l\r"]
[357.791224, "o", "\u001b[?2004h> "]
[357.791353, "o", "            engine.update(FIXED_DT);\r\n\u001b[?2004l\r"]
[357.791383, "o", "\u001b[?2004h> "]
[357.791493, "o", "            ticksDispatched++;\r\n\u001b[?2004l\r"]
[357.791521, "o", "\u001b[?2004h> "]
[357.791579, "o", "        }\r\n\u001b[?2004l\r\u001b[?2004h"]
[357.791607, "o", "> "]
[357.791846, "o", "        // Whether or not we just dispatched a step, when we've reached the\r\n\u001b[?2004l\r"]
[357.791875, "o", "\u001b[?2004h> "]
[357.792127, "o", "        // target tick count we emit the report and ask the headless app to\r\n\u001b[?2004l\r"]
[357.792156, "o", "\u001b[?2004h> "]
[357.79236, "o", "        // exit (this also handles the TICKS=0 special case).\r\n\u001b[?2004l\r"]
[357.792389, "o", "\u001b[?2004h> "]
[357.792553, "o", "        if (ticksDispatched >= targetTicks) {\r\n\u001b[?2004l\r"]
[357.792597, "o", "\u001b[?2004h> "]
[357.792678, "o", "            finished = true;\r\n\u001b[?2004l\r"]
[357.792707, "o", "\u001b[?2004h> "]
