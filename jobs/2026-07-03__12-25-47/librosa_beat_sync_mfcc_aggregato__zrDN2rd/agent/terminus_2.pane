[?2004l[?2004h> import json
[?2004l[?2004h> import numpy as np
[?2004l[?2004h> import librosa
[?2004l[?2004h> import librosa.beat
[?2004l[?2004h> import librosa.feature
[?2004l[?2004h> import librosa.util
[?2004l[?2004h> 
[?2004l[?2004h> INPUT_PATH = "/home/user/input.wav"
[?2004l[?2004h> MFCC_OUT = "/home/user/beat_mfcc.npz"
[?2004l[?2004h> BEATS_OUT = "/home/user/beats.json"
[?2004l[?2004h> 
[?2004l[?2004h> HOP_LENGTH = 512
[?2004l[?2004h> N_MFCC = 20
[?2004l[?2004h> 
[?2004l[?2004h> # Load audio
[?2004l[?2004h> y, sr = librosa.load(INPUT_PATH, sr=None, mono=True)
[?2004l[?2004h> 
[?2004l[?2004h> # Beat tracking with the same hop_length
[?2004l[?2004h> tempo, beat_frames = librosa.beat.beat_track(y=y, sr=sr, hop_length=HOP_LENGTH)
[?2004l[?2004h> # tempo is a 1-D ndarray; reduce to scalar
[?2004l[?2004h> tempo_scalar = float(np.asarray(tempo).reshape(-1)[0])
[?2004l[?2004h> 
[?2004l[?2004h> # Ensure beat_frames is a 1-D ndarray
[?2004l[?2004h> beat_frames = np.asarray(beat_frames).reshape(-1)
[?2004l[?2004h> 
[?2004l[?2004h> # Compute MFCCs with the same hop_length
[?2004l[?2004h> mfcc = librosa.feature.mfcc(y=y, sr=sr, hop_length=HOP_LENGTH, n_mfcc=N_MFCC)
[?2004l[?2004h> 
[?2004l[?2004h> # Aggregate MFCC frames into per-beat-interval medians
[?2004l[?2004h> mfcc_sync = librosa.util.sync(mfcc, beat_frames, aggregate=np.median)
[?2004l[?2004h> 
[?2004l[?2004h> # Convert beat frames to time (seconds)
[?2004l[?2004h> beat_times = librosa.frames_to_time(beat_frames, sr=sr, hop_length=HOP_LENGTH)
[?2004l[?2004h> beat_times = np.asarray(beat_times).reshape(-1).astype(float)
[?2004l[?2004h> # Ensure strictly increasing
[?2004l[?2004h> assert np.all(np.diff(beat_times) > 0), "beat times are not strictly increasing"
[?2004l[?2004h> duration = len(y) / float(sr)
[?2004l[?2004h> assert beat_times.min() >= 0.0 and beat_times.max() <= duration + 1e-6, \
[?2004l[?2004h>     f"beat times out of audio bounds: min={beat_times.min()} max={beat_times.max()} dur={duration}"
[?2004l[?2004h> 
[?2004l[?2004h> # Sanity check on mfcc_sync shape
[?2004l[?2004h> n_cols = mfcc_sync.shape[1]
[?2004l[?2004h> n_beats = len(beat_times)
[?2004l[?2004h> assert n_cols in (n_beats - 1, n_beats), \
[?2004l[?2004h>     f"Unexpected sync column count: {n_cols} vs beats {n_beats}"
[?2004l[?2004h> assert mfcc_sync.shape[0] == N_MFCC, f"Unexpected MFCC row count: {mfcc_sync.shape[0]}"
[?2004l[?2004h> 
[?2004l[?2004h> # Save synchronized MFCC matrix
[?2004l[?2004h> np.savez(MFCC_OUT, mfcc_sync=mfcc_sync)
[?2004l[?2004h> 
[?2004l[?2004h> # Save beat metadata
