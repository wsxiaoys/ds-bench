[103.036754, "o", "> "]
[103.036995, "o", "def retrieve_session(client: AlchemystAI, session_id: str, user_id: str, query: str):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[103.037301, "o", "    \"\"\"Retrieve context for the shared session. Retries with backoff for indexing latency.\"\"\"\r\n\u001b[?2004l\r\u001b[?2004h"]
[103.037354, "o", ">     last_err = None\r\n\u001b[?2004l\r"]
[103.037416, "o", "\u001b[?2004h> "]
[103.037567, "o", "    for attempt in range(8):\r\n\u001b[?2004l\r\u001b[?2004h>         try:\r\n\u001b[?2004l\r"]
[103.037624, "o", "\u001b[?2004h> "]
[103.037754, "o", "            response = client.v1.context.search(\r\n\u001b[?2004l\r\u001b[?2004h> "]
[103.03793, "o", "                minimum_similarity_threshold=0.0,\r\n\u001b[?2004l\r\u001b[?2004h"]
[103.037991, "o", "> "]
[103.038123, "o", "                similarity_threshold=1.0,\r\n\u001b[?2004l\r\u001b[?2004h> "]
[103.038209, "o", "                query=query,\r\n\u001b[?2004l\r\u001b[?2004h> "]
[103.038331, "o", "                user_id=user_id,\r\n\u001b[?2004l\r\u001b[?2004h"]
[103.03839, "o", "> "]
[103.038513, "o", "                metadata=\"true\",\r\n\u001b[?2004l\r\u001b[?2004h> "]
[103.038601, "o", "                mode=\"standard\",\r\n\u001b[?2004l\r\u001b[?2004h> "]
[103.038718, "o", "                scope=\"internal\",\r\n\u001b[?2004l\r\u001b[?2004h"]
[103.038777, "o", "> "]
[103.038923, "o", "                body_metadata={\"sessionId\": session_id},\r\n\u001b[?2004l\r\u001b[?2004h"]
[103.039004, "o", ">             )\r\n\u001b[?2004l\r"]
[103.039119, "o", "\u001b[?2004h>             return response\r\n\u001b[?2004l\r"]
[103.039177, "o", "\u001b[?2004h> "]
[103.039313, "o", "        except Exception as exc:  # noqa: BLE001\r\n\u001b[?2004l\r\u001b[?2004h"]
[103.039369, "o", "> "]
[103.039429, "o", "            last_err = exc\r\n\u001b[?2004l\r\u001b[?2004h> "]
[103.039578, "o", "            time.sleep(1.5 * (attempt + 1))\r\n\u001b[?2004l\r\u001b[?2004h> "]
[103.039861, "o", "    print(f\"ERROR: context.search failed after retries: {last_err}\", file=sys.stderr)\r\n\u001b[?2004l\r\u001b[?2004h"]
[103.039915, "o", ">     sys.exit(1)\r\n\u001b[?2004l\r"]
[103.040052, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[103.040137, "o", "def main() -> int:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[103.040394, "o", "    parser = argparse.ArgumentParser(description=\"Shared team memory CLI (Alice + Bob).\")\r\n\u001b[?2004l\r\u001b[?2004h"]
[103.04045, "o", "> "]
[103.04078, "o", "    parser.add_argument(\"--user-id\", required=True, help=\"Calling teammate user id (alice-<run-id> or bob-<run-id>)\")\r\n\u001b[?2004l\r\u001b[?2004h> "]
[103.041147, "o", "    parser.add_argument(\"--query\", required=True, help=\"Free-form natural-language search query\")\r\n\u001b[?2004l\r\u001b[?2004h"]
[103.041203, "o", "> "]
[103.041272, "o", "    args = parser.parse_args()\r\n\u001b[?2004l\r\u001b[?2004h"]
[103.041397, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h>     api_key = get_api_key()\r\n\u001b[?2004l\r"]
[103.04145, "o", "\u001b[?2004h> "]
[103.04156, "o", "    run_id = get_run_id()\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[103.041693, "o", "    session_id = f\"session-{run_id}\"\r\n\u001b[?2004l\r\u001b[?2004h"]
[103.041748, "o", "> "]
[103.041848, "o", "    alice_user_id = f\"alice-{run_id}\"\r\n\u001b[?2004l\r\u001b[?2004h"]
[103.041933, "o", "> "]
[103.042035, "o", "    bob_user_id = f\"bob-{run_id}\"\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[103.042237, "o", "    # Acceptable user ids are alice-<run-id> or bob-<run-id>\r\n\u001b[?2004l\r\u001b[?2004h"]
[103.042291, "o", "> "]
[103.042448, "o", "    if args.user_id not in {alice_user_id, bob_user_id}:\r\n\u001b[?2004l\r\u001b[?2004h"]
[103.042502, "o", ">         print(\r\n\u001b[?2004l\r"]
[103.042565, "o", "\u001b[?2004h> "]
[103.042797, "o", "            f\"ERROR: --user-id must be '{alice_user_id}' or '{bob_user_id}'\",\r\n\u001b[?2004l\r\u001b[?2004h> "]
[103.04291, "o", "            file=sys.stderr,\r\n\u001b[?2004l\r\u001b[?2004h> "]
[103.042973, "o", "        )\r\n\u001b[?2004l\r\u001b[?2004h> "]
[103.043055, "o", "        return 2\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[103.043161, "o", "\u001b[?2004h> "]
[103.043248, "o", "    client = AlchemystAI(api_key=api_key)\r\n\u001b[?2004l\r\u001b[?2004h> \r\n"]
[103.043332, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[103.043426, "o", "    # Seed Alice's memory (idempotent)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[103.043521, "o", "    alice_content = (\r\n\u001b[?2004l\r\u001b[?2004h> "]
[103.043836, "o", "        f\"Alice ({alice_user_id}) notes: Alice prefers Python for data processing pipelines. \"\r\n\u001b[?2004l\r\u001b[?2004h"]
[103.04389, "o", "> "]
[103.044154, "o", "        f\"She relies on pandas, Polars, and Airflow for ETL workloads in this shared session.\"\r\n\u001b[?2004l\r\u001b[?2004h> "]
[103.044208, "o", "    )\r\n\u001b[?2004l\r\u001b[?2004h> "]
[103.044424, "o", "    seed_memory(client, session_id, alice_user_id, alice_content)\r\n\u001b[?2004l\r\u001b[?2004h"]
[103.044476, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[103.044598, "o", "    # Seed Bob's memory (idempotent)\r\n\u001b[?2004l\r\u001b[?2004h"]
[103.04465, "o", "> "]
[103.044702, "o", "    bob_content = (\r\n\u001b[?2004l\r\u001b[?2004h> "]
[103.045059, "o", "        f\"Bob ({bob_user_id}) notes: Bob recommends PostgreSQL with TimescaleDB for time-series storage. \"\r\n\u001b[?2004l\r\u001b[?2004h> "]
[103.045377, "o", "        f\"He tunes hypertables, compression, and retention policies for observability metrics.\"\r\n\u001b[?2004l\r\u001b[?2004h"]
[103.045434, "o", ">     )\r\n\u001b[?2004l\r\u001b[?2004h> "]
[103.045638, "o", "    seed_memory(client, session_id, bob_user_id, bob_content)\r\n\u001b[?2004l\r\u001b[?2004h"]
[103.045694, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[103.045857, "o", "    # Give the indexer a moment before retrieval.\r\n\u001b[?2004l\r\u001b[?2004h"]
[103.045943, "o", ">     time.sleep(1.0)\r\n\u001b[?2004l\r\u001b[?2004h"]
[103.046009, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[103.046262, "o", "    response = retrieve_session(client, session_id, args.user_id, args.query)\r\n\u001b[?2004l\r\u001b[?2004h> \r\n"]
[103.046315, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[103.046432, "o", "    contexts = []\r\n\u001b[?2004l\r\u001b[?2004h> "]
[103.046489, "o", "    if response is not None:\r\n\u001b[?2004l\r\u001b[?2004h"]
[103.046552, "o", "> "]
[103.046711, "o", "        contexts = getattr(response, \"contexts\", None) or []\r\n\u001b[?2004l\r\u001b[?2004h> \r\n"]
[103.046766, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[103.046878, "o", "    print(f\"USER: {args.user_id}\")\r\n\u001b[?2004l\r\u001b[?2004h> "]
[103.047022, "o", "    print(f\"SESSION: {session_id}\")\r\n\u001b[?2004l\r\u001b[?2004h> "]
[103.047127, "o", "    print(\"RETRIEVED:\")\r\n\u001b[?2004l\r\u001b[?2004h> "]
[103.047218, "o", "    if not contexts:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[103.047365, "o", "        print(\"- (no contexts returned)\")\r\n\u001b[?2004l\r\u001b[?2004h> "]
[103.047423, "o", "    else:\r\n\u001b[?2004l\r\u001b[?2004h"]
[103.047478, "o", "> "]
[103.047594, "o", "        seen = set()\r\n\u001b[?2004l\r\u001b[?2004h> "]
[103.047667, "o", "        for ctx in contexts:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[103.04782, "o", "            content = getattr(ctx, \"content\", None)\r\n\u001b[?2004l\r\u001b[?2004h"]
[103.047868, "o", "> "]
[103.047965, "o", "            if content is None:\r\n\u001b[?2004l\r\u001b[?2004h"]
[103.048016, "o", "> "]
[103.048072, "o", "                continue\r\n\u001b[?2004l\r\u001b[?2004h> "]
[103.04821, "o", "            key = content.strip()\r\n\u001b[?2004l\r\u001b[?2004h> "]
[103.048314, "o", "            if key in seen:\r\n\u001b[?2004l\r"]
[103.048366, "o", "\u001b[?2004h> "]
[103.048417, "o", "                continue\r\n\u001b[?2004l\r\u001b[?2004h"]
[103.048472, "o", "> "]
[103.04853, "o", "            seen.add(key)\r\n\u001b[?2004l\r\u001b[?2004h"]
[103.048583, "o", "> "]
[103.048754, "o", "            # First line only, to keep each snippet compact.\r\n\u001b[?2004l\r\u001b[?2004h> "]
[103.048929, "o", "            snippet = key.splitlines()[0].strip()\r\n\u001b[?2004l\r\u001b[?2004h"]
[103.04905, "o", ">             print(f\"- {snippet}\")\r\n\u001b[?2004l\r"]
[103.049146, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[103.0492, "o", "    return 0\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[103.049288, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[103.049342, "o", "if __name__ == \"__main__\":\r\n\u001b[?2004l\r\u001b[?2004h"]
[103.049392, "o", "> "]
[103.049443, "o", "    sys.exit(main())\r\n\u001b[?2004l\r\u001b[?2004h"]
[103.049496, "o", "> PYEOF\r\n\u001b[?2004l\r"]
