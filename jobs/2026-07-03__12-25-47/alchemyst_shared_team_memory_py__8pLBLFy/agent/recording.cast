[86.459549, "o", "50:class AlchemystAI(SyncAPIClient):\r\n52:    api_key: str | None\r\n54:    def __init__(\r\n57:        api_key: str | None = None,\r\n58:        base_url: str | httpx.URL | None = None,\r\n79:        This REDACTEDmatically infers the `api_key` argument from the `ALCHEMYST_AI_API_KEY` environment variable if it is not provided.\r\n81:        if api_key is None:\r\n82:            api_key = os.environ.get(\"ALCHEMYST_AI_API_KEY\")\r\n83:        self.api_key = api_key\r\n85:        if base_url is None:\r\n86:            base_url = os.environ.get(\"ALCHEMYST_AI_BASE_URL\")\r\n87:        if base_url is None:\r\n88:            base_url = f\"https://platform-backend.getalchemystai.com\"\r\n92:            base_url=base_url,\r\n123:        api_key = self.api_key\r\n124:        if api_key is None:\r\n126:        return {\"Authorization\": f\"Bearer {api_key}\"}\r\n143:            '\"Could not resolve authentication method. Expected the api_key to be set. Or for the `Authorization` headers to be explicitly omitted\"'\r\n149:        api_key: str | None = None,\r\n150:        base_url: str | httpx.URL | None = None,\r\n183:            api_key=api_key or self.api_key,\r\n"]
