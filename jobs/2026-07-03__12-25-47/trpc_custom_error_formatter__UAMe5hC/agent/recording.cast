[8.219502, "i", "cat package.json\n"]
[8.219772, "o", "cat package.json\r\n\u001b[?2004l\r"]
[8.221259, "o", "{\r\n  \"name\": \"app\",\r\n  \"version\": \"1.0.0\",\r\n  \"description\": \"\",\r\n  \"main\": \"index.js\",\r\n  \"scripts\": {\r\n    \"test\": \"echo \\\"Error: no test specified\\\" && exit 1\",\r\n    \"start\": \"ts-node server.ts\"\r\n  },\r\n  \"keywords\": [],\r\n  \"author\": \"\",\r\n  \"license\": \"ISC\",\r\n  \"type\": \"commonjs\",\r\n  \"dependencies\": {\r\n    \"@trpc/server\": \"^11.13.0\",\r\n    \"express\": \"^5.2.1\",\r\n    \"zod\": \"^4.4.3\"\r\n  },\r\n  \"devDependencies\": {\r\n    \"@types/express\": \"^5.0.6\",\r\n    \"@types/node\": \"^26.1.0\",\r\n    \"ts-node\": \"^10.9.2\",\r\n    \"typescript\": \"^6.0.3\"\r\n  }\r\n}\r\n"]
[8.221523, "o", "\u001b[?2004hroot@596054bd-04af-4880-b1be-663ba08e2604:/home/user/app# "]
[18.808825, "i", "cat > server.ts << 'EOF'\nimport * as trpcExpress from '@trpc/server/adapters/express';\nimport express from 'express';\nimport { initTRPC } from '@trpc/server';\nimport { z, ZodError } from 'zod';\n\nexport const t = initTRPC.create({\n  errorFormatter({ shape, error }) {\n    return {\n      ...shape,\n      data: {\n        ...shape.data,\n        zodError:\n          error.code === 'BAD_REQUEST' && error.cause instanceof ZodError\n            ? error.cause.flatten()\n            : null,\n      },\n    };\n  },\n});\n\nconst appRouter = t.router({\n  addPost: t.procedure\n    .input(z.object({ title: z.string().min(5) }))\n    .mutation(({ input }) => {\n      return { id: 1, title: input.title };\n    }),\n});\n\nconst app = express();\n\napp.use(\n  express.json(),\n  '/trpc',\n  trpcExpress.createExpressMiddleware({\n    router: appRouter,\n    createContext: () => ({}),\n  }),\n);\n\napp.listen(3000, () => {\n  console.log('Server listening on port 3000');\n});\nEOF\n"]
