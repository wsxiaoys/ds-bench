[?2004l#!/usr/bin/env python3
import os
import sys
from daytona import Daytona

RUN_ID_PATH = "/logs/artifacts/run-id"
LOG_PATH = "/home/user/myproject/output.log"


def main():
    with open(RUN_ID_PATH, "r") as f:
        run_id = f.read().strip()

    sandbox_name = f"exec-py-{run_id}"
    log_lines = []

    daytona = Daytona()
    sandbox = None
    try:
        sandbox = daytona.create({"name": sandbox_name})

        uname_result = sandbox.process.exec("uname -a")
        log_lines.append("UNAME: " + uname_result.result)

        pwd_result = sandbox.process.exec("pwd")
        log_lines.append("PWD: " + pwd_result.result)

        echo_result = sandbox.process.exec(f"echo {run_id}")
        log_lines.append("ECHO: " + echo_result.result)
    finally:
        with open(LOG_PATH, "w") as f:
            f.write("\n".join(log_lines) + ("\n" if log_lines else ""))
        if sandbox is not None:
            try:
                daytona.delete(sandbox)
            except Exception as e:
                print(f"Failed to delete sandbox: {e}", file=sys.stderr)


if __name__ == "__main__":
    main()
