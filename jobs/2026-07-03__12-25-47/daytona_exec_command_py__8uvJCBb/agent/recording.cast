[82.80826, "o", "# Copyright Daytona Platforms Inc.\r\n# SPDX-License-Identifier: Apache-2.0\r\n\r\nfrom __future__ import annotations\r\n\r\nimport warnings\r\nfrom enum import Enum\r\nfrom typing import Annotated, Literal\r\n\r\nfrom pydantic import BaseModel, Field, model_validator\r\nfrom typing_extensions import override\r\n\r\nfrom .image import Image\r\nfrom .sandbox import Resources\r\nfrom .volume import VolumeMount\r\n\r\nCODE_TOOLBOX_LANGUAGE_LABEL = \"code-toolbox-language\"\r\n\r\n\r\nclass CodeLanguage(str, Enum):\r\n    \"\"\"Programming languages supported by Daytona\r\n\r\n    **Enum Members**:\r\n        - `PYTHON` (\"python\")\r\n        - `TYPESCRIPT` (\"typescript\")\r\n        - `JAVASCRIPT` (\"javascript\")\r\n    \"\"\"\r\n\r\n    PYTHON = \"python\"\r\n    TYPESCRIPT = \"typescript\"\r\nclass CreateSandboxBaseParams(BaseModel):\r\n    \"\"\"Base parameters for creating a new Sandbox.\r\n\r\n    Attributes:\r\n        name (str | None): Name of the Sandbox.\r\n        language (CodeLanguage | CodeLanguageLiteral | None): Programming language for the Sandbox.\r\n            Defaults to \"python\".\r\n        os_user (str | None): OS user for the Sandbox.\r\n        env_vars (dict[str, str] | None): Environment variables to set in the Sandbox.\r\n        labels (dict[str, str] | None): Custom labels for the Sandbox.\r\n        public (bool | None): Whether the Sandbox should be public.\r\n        timeout (float | None): Timeout in seconds for Sandbox to be created and started.\r\n        REDACTED_stop_interval (int | None): Interval in minutes after which Sandbox will\r\n            REDACTEDmatically stop if no Sandbox event occurs during that time. Default is 15 minutes.\r\n            0 means no REDACTED-stop.\r\n        REDACTED_archive_interval (int | None): Interval in minutes after which a continuously stopped Sandbox will\r\n            REDACTEDmatically archive. Default is 7 days.\r\n            0 means the maximum interval will be used.\r\n        REDACTED_delete_interval (int | None): Interval in minutes after which a continuously stopped Sandbox will\r\n            REDACTEDmatically be deleted. By default, REDACTED-delete is disabled.\r\n            Negative value means disabled, 0 means delete immediately upon stopping.\r\n        volumes (list[VolumeMount] | None): List of volumes mounts to attach to the Sandbox.\r\n        secrets (dict[str, str] | None): Map of environment variable name to the name of an existing\r\n            organization Secret to mount into the Sandbox. The env var is set to the Secret's opaque\r\n            placeholder, not the plaintext; the real value is substituted transparently on outbound\r\n            requests to the Secret's allowed hosts. Every referenced Secret name must already exist\r\n            in the organization.\r\n        network_block_all (bool | None): Whether to block all network access for the Sandbox.\r\n        network_allow_list (str | None): Comma-separated list of allowed CIDR network addresses for the Sandbox.\r\n        domain_allow_list (str | None): Comma-separated list of allowed domains for the Sandbox.\r\n        ephemeral (bool | None): Whether the Sandbox should be ephemeral.\r\n            If True, REDACTED_delete_interval will be set to 0.\r\n        linked_sandbox (str | None): ID or name of an existing Sandbox to link the new Sandbox to. The new\r\n            Sandbox will be scheduled on the same runner as the linked Sandbox so a local network can be\r\n            established between them. Linked Sandboxes must be\r\n            ephemeral (REDACTED_delete_interval=0) and cannot themselves be linked to another Sandbox.\r\n    \"\"\"\r\n\r\n    name: str | None = None\r\n    language: CodeLanguage | CodeLanguageLiteral | None = None\r\n    os_user: str | None = None\r\n    env_vars: dict[str, str] | None = None\r\n    labels: dict[str, str] | None = None\r\n    public: bool | None = None\r\n    REDACTED_stop_interval: int | None = None\r\n    REDACTED_archive_interval: int | None = None\r\n    REDACTED_delete_interval: int | None = None\r\n    volumes: list[VolumeMount] | None = None\r\n    secrets: dict[str, str] | None = None\r\n    network_block_all: bool | None = None\r\n    network_allow_list: str | None = None\r\n    domain_allow_list: str | None = None\r\n    ephemeral: bool | None = None\r\n    linked_sandbox: str | None = None\r\n\r\n    @model_validator(m"]
[82.808336, "o", "ode=\"before\")\r\n    @classmethod\r\n    def _handle_ephemeral_REDACTED_delete_conflict(cls, values: dict[str, object]) -> dict[str, object]:\r\n        if \"ephemeral\" in values and values.get(\"ephemeral\"):\r\n            if \"REDACTED_delete_interval\" in values and values.get(\"REDACTED_delete_interval\"):\r\n                warnings.warn(\r\n                    \"\"\"'ephemeral' and 'REDACTED_delete_interval' cannot be used together.\r\n                        If ephemeral is True, REDACTED_delete_interval will be ignored and set to 0.\"\"\",\r\n                    UserWarning,\r\n                    stacklevel=3,\r\n                )\r\n            values[\"REDACTED_delete_interval\"] = 0\r\n        return values\r\n\r\n\r\n"]
[82.808493, "o", "\u001b[?2004hroot@d31295ca-0f94-4df7-9087-8346e68666af:/home/user/myproject# "]
[88.082137, "i", "sed -n '380,420p' /usr/local/lib/python3.12/dist-packages/daytona/_sync/daytona.py\n"]
[88.082538, "o", "sed -n '380,420p' /usr/local/lib/python3.12/dist-packages/daytona/_sync/daytona.py\r\n\u001b[?2004l\r"]
[88.083999, "o", "        params: CreateSandboxFromSnapshotParams | CreateSandboxFromImageParams | None = None,\r\n        *,\r\n        timeout: float = 60,\r\n        on_snapshot_create_logs: Callable[[str], None] | None = None,\r\n    ) -> Sandbox:\r\n        # If no params provided, create default params for Python\r\n        if not params:\r\n            params = CreateSandboxFromSnapshotParams(language=self.default_language)\r\n        elif not params.language:\r\n            params.language = self.default_language\r\n\r\n        return self._create(params, timeout=timeout, on_snapshot_create_logs=on_snapshot_create_logs)\r\n\r\n    def _create(\r\n"]
[88.084049, "o", "        self,\r\n        params: CreateSandboxFromSnapshotParams | CreateSandboxFromImageParams,\r\n        *,\r\n        timeout: float = 60,\r\n        on_snapshot_create_logs: Callable[[str], None] | None = None,\r\n    ) -> Sandbox:\r\n        validated_language = self._validate_language_label(str(params.language) if params.language else None)\r\n        params.labels = params.labels or {}\r\n        params.labels[CODE_TOOLBOX_LANGUAGE_LABEL] = validated_language.value\r\n\r\n        if timeout and timeout < 0:\r\n            raise DaytonaValidationError(\"Timeout must be a non-negative number\")\r\n\r\n        if params.REDACTED_stop_interval is not None and params.REDACTED_stop_interval < 0:\r\n            raise DaytonaValidationError(\"REDACTED_stop_interval must be a non-negative integer\")\r\n\r\n        if params.REDACTED_archive_interval is not None and params.REDACTED_archive_interval < 0:\r\n            raise DaytonaValidationError(\"REDACTED_archive_interval must be a non-negative integer\")\r\n\r\n        target = self._target\r\n\r\n        volumes = []\r\n        if params.volumes:\r\n"]
[88.08409, "o", "            volumes = [\r\n                SandboxVolume(volume_id=volume.volume_id, mount_path=volume.mount_path, subpath=volume.subpath)\r\n                for volume in params.volumes\r\n            ]\r\n"]
[88.084307, "o", "\u001b[?2004hroot@d31295ca-0f94-4df7-9087-8346e68666af:/home/user/myproject# "]
[88.371615, "i", "sed -n '187,220p' /usr/local/lib/python3.12/dist-packages/daytona/common/daytona.py\n"]
[88.372018, "o", "sed -n '187,220p' /usr/local/lib/python3.12/dist-packages/daytona/common/daytona.py\r\n\u001b[?2004l\r"]
[88.373178, "o", "class CreateSandboxFromImageParams(CreateSandboxBaseParams):\r\n    \"\"\"Parameters for creating a new Sandbox from an image.\r\n\r\n    Attributes:\r\n        image (str | Image): Custom Docker image to use for the Sandbox. If an Image object is provided,\r\n            the image will be dynamically built.\r\n        resources (Resources | None): Resource configuration for the Sandbox. If not provided, sandbox will\r\n            have default resources.\r\n    \"\"\"\r\n\r\n"]
[88.373221, "o", "    image: str | Image\r\n    resources: Resources | None = None\r\n\r\n\r\nclass CreateSandboxFromSnapshotParams(CreateSandboxBaseParams):\r\n    \"\"\"Parameters for creating a new Sandbox from a snapshot.\r\n\r\n    Attributes:\r\n        snapshot (str | None): Name of the snapshot to use for the Sandbox.\r\n    \"\"\"\r\n\r\n    snapshot: str | None = None\r\n"]
[88.373419, "o", "\u001b[?2004hroot@d31295ca-0f94-4df7-9087-8346e68666af:/home/user/myproject# "]
[99.111512, "i", "cat > /home/user/myproject/run.py << 'PYEOF'\n#!/usr/bin/env python3\nimport sys\nfrom daytona import Daytona\nfrom daytona.common.daytona import CreateSandboxFromSnapshotParams\n\nRUN_ID_PATH = \"/logs/artifacts/run-id\"\nLOG_PATH = \"/home/user/myproject/output.log\"\n\n\ndef main():\n    with open(RUN_ID_PATH, \"r\") as f:\n        run_id = f.read().strip()\n\n    sandbox_name = f\"exec-py-{run_id}\"\n    log_lines = []\n\n    daytona = Daytona()\n    sandbox = None\n    try:\n        sandbox = daytona.create(CreateSandboxFromSnapshotParams(name=sandbox_name))\n\n        uname_result = sandbox.process.exec(\"uname -a\")\n        log_lines.append(\"UNAME: \" + uname_result.result)\n\n        pwd_result = sandbox.process.exec(\"pwd\")\n        log_lines.append(\"PWD: \" + pwd_result.result)\n\n        echo_result = sandbox.process.exec(f\"echo {run_id}\")\n        log_lines.append(\"ECHO: \" + echo_result.result)\n    finally:\n        with open(LOG_PATH, \"w\") as f:\n            f.write(\"\\n\".join(log_lines) + (\"\\n\" if log_lines else \"\"))\n        if sandbox is not None:\n            try:\n                daytona.delete(sandbox)\n            except Exception as e:\n                print(f\"Failed to delete sandbox: {e}\", file=sys.stderr)\n\n\nif __name__ == \"__main__\":\n    main()\nPYEOF\n"]
