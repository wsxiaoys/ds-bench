[34.358044, "o", "#!/usr/bin/env python3\r\nimport os\r\nimport sys\r\nfrom daytona import Daytona\r\n\r\nRUN_ID_PATH = \"/logs/artifacts/run-id\"\r\nLOG_PATH = \"/home/user/myproject/output.log\"\r\n\r\n\r\ndef main():\r\n    with open(RUN_ID_PATH, \"r\") as f:\r\n        run_id = f.read().strip()\r\n\r\n    sandbox_name = f\"exec-py-{run_id}\"\r\n    log_lines = []\r\n\r\n    daytona = Daytona()\r\n    sandbox = None\r\n    try:\r\n        sandbox = daytona.create({\"name\": sandbox_name})\r\n\r\n        uname_result = sandbox.process.exec(\"uname -a\")\r\n        log_lines.append(\"UNAME: \" + uname_result.result)\r\n\r\n        pwd_result = sandbox.process.exec(\"pwd\")\r\n        log_lines.append(\"PWD: \" + pwd_result.result)\r\n\r\n        echo_result = sandbox.process.exec(f\"echo {run_id}\")\r\n        log_lines.append(\"ECHO: \" + echo_result.result)\r\n    finally:\r\n        with open(LOG_PATH, \"w\") as f:\r\n            f.write(\"\\n\".join(log_lines) + (\"\\n\" if log_lines else \"\"))\r\n        if sandbox is not None:\r\n            try:\r\n                daytona.delete(sandbox)\r\n            except Exception as e:\r\n                print(f\"Failed to delete sandbox: {e}\", file=sys.stderr)\r\n\r\n\r\nif __name__ == \"__main__\":\r\n    main()\r\n"]
