[133.42438, "o", "import json\r\n\u001b[?2004l\r"]
[133.424508, "o", "\u001b[?2004h> "]
[133.426762, "o", "from datetime import datetime, timedelta, timezone\r\n\u001b[?2004l\r\u001b[?2004h> from pathlib import Path\r\n\u001b[?2004l\r\u001b[?2004h> from typing import Tuple\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> from bytewax.connectors.files import CSVSource, FileSink\r\n\u001b[?2004l\r\u001b[?2004h> "]
[133.42705, "o", "from bytewax.dataflow import Dataflow\r\n\u001b[?2004l\r"]
[133.427179, "o", "\u001b[?2004h> "]
[133.427501, "o", "import bytewax.operators as op\r\n\u001b[?2004l\r"]
[133.427601, "o", "\u001b[?2004h> "]
[133.428594, "o", "from bytewax.operators.windowing import EventClock, TumblingWindower, fold_window\r\n\u001b[?2004l\r"]
[133.428695, "o", "\u001b[?2004h> "]
[133.429228, "o", "from bytewax.run import cli_main\r\n\u001b[?2004l\r"]
[133.429739, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[133.430421, "o", "# Window alignment origin - the start of the epoch minute in UTC.\r\n\u001b[?2004l\r"]
[133.430537, "o", "\u001b[?2004h> "]
[133.431397, "o", "ALIGN_TO = datetime(1970, 1, 1, 0, 0, 0, tzinfo=timezone.utc)\r\n\u001b[?2004l\r"]
[133.431494, "o", "\u001b[?2004h> "]
[133.432003, "o", "WINDOW_LENGTH = timedelta(minutes=1)\r\n\u001b[?2004l\r"]
[133.43208, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[133.432153, "o", "\u001b[?2004h"]
[133.432219, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h"]
[133.432582, "o", "> "]
[133.434228, "o", "def parse_iso8601(ts: str) -> datetime:\r\n\u001b[?2004l\r\u001b[?2004h>     \"\"\"Parse an ISO 8601 timestamp string to a timezone-aware datetime.\"\"\"\r\n\u001b[?2004l\r\u001b[?2004h> "]
[133.434914, "o", "    if ts.endswith(\"Z\"):\r\n\u001b[?2004l\r\u001b[?2004h>         ts = ts[:-1] + \"+00:00\"\r\n\u001b[?2004l\r\u001b[?2004h> "]
[133.436414, "o", "    dt = datetime.fromisoformat(ts)\r\n\u001b[?2004l\r\u001b[?2004h>     if dt.tzinfo is None:\r\n\u001b[?2004l\r\u001b[?2004h>         dt = dt.replace(tzinfo=timezone.utc)\r\n\u001b[?2004l\r\u001b[?2004h>     return dt\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[133.436867, "o", "def window_id_to_start(window_id: int) -> datetime:\r\n\u001b[?2004l\r"]
[133.436916, "o", "\u001b[?2004h"]
[133.437038, "o", "> "]
[133.4375, "o", "    \"\"\"Compute the start time of a window from its id.\"\"\"\r\n\u001b[?2004l\r"]
[133.437548, "o", "\u001b[?2004h"]
[133.437592, "o", "> "]
[133.43804, "o", "    return ALIGN_TO + WINDOW_LENGTH * window_id\r\n\u001b[?2004l\r"]
[133.438149, "o", "\u001b[?2004h"]
[133.438268, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h"]
[133.438431, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[133.438966, "o", "def build_flow(input_path: Path, output_path: Path) -> Dataflow:\r\n\u001b[?2004l\r"]
[133.439042, "o", "\u001b[?2004h> "]
[133.439642, "o", "    \"\"\"Build the Bytewax dataflow for OHLCV aggregation.\"\"\"\r\n\u001b[?2004l\r"]
[133.439765, "o", "\u001b[?2004h"]
[133.43987, "o", "> "]
[133.440097, "o", "    flow = Dataflow(\"ohlcv_1min\")\r\n\u001b[?2004l\r"]
[133.440207, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[133.440294, "o", "\u001b[?2004h> "]
[133.440524, "o", "    # Read CSV file\r\n\u001b[?2004l\r"]
[133.440622, "o", "\u001b[?2004h> "]
[133.441044, "o", "    csv_source = CSVSource(input_path)\r\n\u001b[?2004l\r"]
[133.441174, "o", "\u001b[?2004h"]
[133.441285, "o", "> "]
[133.441637, "o", "    inp = op.input(\"csv_in\", flow, csv_source)\r\n\u001b[?2004l\r"]
[133.441743, "o", "\u001b[?2004h"]
[133.4418, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h"]
[133.44195, "o", "> "]
[133.442525, "o", "    # Parse each row into (symbol, price, volume, timestamp_dt)\r\n\u001b[?2004l\r"]
[133.442625, "o", "\u001b[?2004h> "]
[133.443068, "o", "    parsed = op.map(\"parse\", inp, lambda row: {\r\n\u001b[?2004l\r"]
[133.443118, "o", "\u001b[?2004h"]
[133.443254, "o", "> "]
[133.443505, "o", "        \"symbol\": row[\"symbol\"],\r\n\u001b[?2004l\r"]
[133.443556, "o", "\u001b[?2004h"]
[133.443657, "o", "> "]
[133.443979, "o", "        \"price\": float(row[\"price\"]),\r\n\u001b[?2004l\r"]
[133.444034, "o", "\u001b[?2004h"]
[133.444136, "o", "> "]
[133.444478, "o", "        \"volume\": float(row[\"volume\"]),\r\n\u001b[?2004l\r"]
[133.444528, "o", "\u001b[?2004h"]
[133.444677, "o", "> "]
[133.445128, "o", "        \"timestamp\": parse_iso8601(row[\"timestamp\"]),\r\n"]
[133.445185, "o", "\u001b[?2004l\r\u001b[?2004h"]
[133.445344, "o", ">     })\r\n\u001b[?2004l\r"]
[133.445481, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[133.44553, "o", "\u001b[?2004h> "]
[133.44587, "o", "    # Key the stream by symbol\r\n\u001b[?2004l\r"]
[133.445929, "o", "\u001b[?2004h> "]
[133.446671, "o", "    keyed = op.key_on(\"key_symbol\", parsed, lambda x: x[\"symbol\"])\r\n\u001b[?2004l\r"]
[133.446727, "o", "\u001b[?2004h> "]
[133.446975, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[133.447499, "o", "    # Define the event-time clock using the trade timestamp\r\n\u001b[?2004l\r"]
[133.447675, "o", "\u001b[?2004h> "]
[133.447841, "o", "    clock = EventClock(\r\n\u001b[?2004l\r"]
[133.447952, "o", "\u001b[?2004h> "]
[133.448411, "o", "        ts_getter=lambda x: x[\"timestamp\"],\r\n\u001b[?2004l\r"]
[133.448462, "o", "\u001b[?2004h"]
[133.448505, "o", "> "]
[133.449075, "o", "        wait_for_system_duration=timedelta(seconds=0),\r\n\u001b[?2004l\r"]
[133.449124, "o", "\u001b[?2004h"]
[133.449167, "o", "> "]
[133.449405, "o", "    )\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[133.449463, "o", "> "]
[133.450188, "o", "    # Define a 1-minute tumbling window aligned to the minute boundary\r\n\u001b[?2004l\r"]
[133.450227, "o", "\u001b[?2004h"]
[133.450262, "o", "> "]
[133.450607, "o", "    windower = TumblingWindower(\r\n\u001b[?2004l\r"]
[133.450705, "o", "\u001b[?2004h> "]
[133.450954, "o", "        length=WINDOW_LENGTH,\r\n\u001b[?2004l\r"]
[133.451028, "o", "\u001b[?2004h> "]
[133.451291, "o", "        align_to=ALIGN_TO,\r\n\u001b[?2004l\r"]
[133.451381, "o", "\u001b[?2004h> "]
[133.451461, "o", "    )\r\n\u001b[?2004l\r"]
[133.451532, "o", "\u001b[?2004h> "]
[133.451581, "o", "\r\n\u001b[?2004l\r\u001b[?2004h"]
[133.45163, "o", "> "]
[133.451893, "o", "    # OHLCV accumulator builder.\r\n\u001b[?2004l\r"]
[133.451942, "o", "\u001b[?2004h"]
[133.451995, "o", "> "]
[133.452127, "o", "    def builder():\r\n\u001b[?2004l\r"]
[133.452175, "o", "\u001b[?2004h> "]
[133.452348, "o", "        return {\r\n\u001b[?2004l\r"]
[133.452432, "o", "\u001b[?2004h> "]
[133.452632, "o", "            \"open\": None,\r\n\u001b[?2004l\r"]
[133.452704, "o", "\u001b[?2004h> "]
[133.452928, "o", "            \"high\": None,\r\n\u001b[?2004l\r"]
[133.452984, "o", "\u001b[?2004h> "]
[133.453286, "o", "            \"low\": None,\r\n\u001b[?2004l\r\u001b[?2004h"]
[133.453461, "o", "> "]
[133.4536, "o", "            \"close\": None,\r\n\u001b[?2004l\r"]
[133.453701, "o", "\u001b[?2004h> "]
[133.453928, "o", "            \"volume\": 0.0,\r\n\u001b[?2004l\r"]
[133.453992, "o", "\u001b[?2004h> "]
[133.454104, "o", "        }\r\n\u001b[?2004l\r"]
[133.454168, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[133.454236, "o", "\u001b[?2004h"]
[133.454318, "o", "> "]
[133.454679, "o", "    # Update OHLCV state with a new trade.\r\n\u001b[?2004l\r"]
[133.454811, "o", "\u001b[?2004h> "]
[133.455028, "o", "    def folder(acc, trade):\r\n\u001b[?2004l\r"]
[133.455131, "o", "\u001b[?2004h> "]
[133.455416, "o", "        price = trade[\"price\"]\r\n\u001b[?2004l\r"]
[133.456424, "o", "\u001b[?2004h>         if acc[\"open\"] is None:\r\n\u001b[?2004l\r\u001b[?2004h>             acc[\"open\"] = price\r\n\u001b[?2004l\r\u001b[?2004h> "]
[133.456533, "o", "            acc[\"high\"] = price\r\n\u001b[?2004l\r"]
[133.456594, "o", "\u001b[?2004h> "]
[133.456906, "o", "            acc[\"low\"] = price\r\n\u001b[?2004l\r"]
[133.457017, "o", "\u001b[?2004h"]
[133.457111, "o", ">         else:\r\n"]
[133.457167, "o", "\u001b[?2004l\r\u001b[?2004h"]
[133.45728, "o", "> "]
[133.457553, "o", "            if price > acc[\"high\"]:\r\n\u001b[?2004l\r"]
[133.457644, "o", "\u001b[?2004h> "]
[133.457942, "o", "                acc[\"high\"] = price\r\n\u001b[?2004l\r"]
[133.458103, "o", "\u001b[?2004h> "]
[133.458363, "o", "            if price < acc[\"low\"]:\r\n\u001b[?2004l\r"]
[133.458487, "o", "\u001b[?2004h> "]
[133.458791, "o", "                acc[\"low\"] = price\r\n\u001b[?2004l\r"]
[133.458899, "o", "\u001b[?2004h> "]
[133.459147, "o", "        acc[\"close\"] = price\r\n\u001b[?2004l\r"]
[133.459248, "o", "\u001b[?2004h> "]
[133.460049, "o", "        acc[\"volume\"] += trade[\"volume\"]\r\n\u001b[?2004l\r\u001b[?2004h>         return acc\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[133.460797, "o", "    # Merge two partial accumulators (e.g., from different input sources).\r\n\u001b[?2004l\r"]
[133.460911, "o", "\u001b[?2004h> "]
[133.461022, "o", "    def merger(a, b):\r\n\u001b[?2004l\r"]
[133.461095, "o", "\u001b[?2004h> "]
[133.461286, "o", "        if a[\"open\"] is None:\r\n\u001b[?2004l\r"]
[133.461366, "o", "\u001b[?2004h> "]
[133.46152, "o", "            return b\r\n\u001b[?2004l\r"]
[133.461563, "o", "\u001b[?2004h"]
[133.461605, "o", "> "]
[133.461793, "o", "        if b[\"open\"] is None:\r\n\u001b[?2004l\r"]
[133.46184, "o", "\u001b[?2004h> "]
[133.46202, "o", "            return a\r\n\u001b[?2004l\r\u001b[?2004h"]
[133.462106, "o", "> "]
[133.462191, "o", "        return {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[133.462384, "o", "            \"open\": a[\"open\"],\r\n\u001b[?2004l\r"]
[133.462459, "o", "\u001b[?2004h> "]
[133.462655, "o", "            \"high\": max(a[\"high\"], b[\"high\"]),\r\n\u001b[?2004l\r\u001b[?2004h> "]
[133.462825, "o", "            \"low\": min(a[\"low\"], b[\"low\"]),\r\n\u001b[?2004l\r\u001b[?2004h"]
[133.462898, "o", "> "]
[133.462971, "o", "            \"close\": b[\"close\"],\r\n\u001b[?2004l\r\u001b[?2004h> "]
[133.463156, "o", "            \"volume\": a[\"volume\"] + b[\"volume\"],\r\n\u001b[?2004l\r\u001b[?2004h> "]
[133.463227, "o", "        }\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[133.463298, "o", "\u001b[?2004h> "]
[133.497174, "o", "    windowed = fold_window(\r\n\u001b[?2004l\r"]
[133.497322, "o", "\u001b[?2004h> "]
[133.497421, "o", "        \"ohlcv_fold\",\r\n\u001b[?2004l\r"]
[133.497536, "o", "\u001b[?2004h> "]
[133.497645, "o", "        keyed,\r\n\u001b[?2004l\r\u001b[?2004h"]
[133.497759, "o", "> "]
[133.497875, "o", "        clock,\r\n\u001b[?2004l\r\u001b[?2004h"]
[133.497978, "o", "> "]
[133.498093, "o", "        windower,\r\n\u001b[?2004l\r\u001b[?2004h"]
[133.498199, "o", "> "]
[133.498342, "o", "        builder=builder,\r\n\u001b[?2004l\r"]
[133.498459, "o", "\u001b[?2004h> "]
[133.498595, "o", "        folder=folder,\r\n\u001b[?2004l\r"]
[133.498703, "o", "\u001b[?2004h> "]
[133.498855, "o", "        merger=merger,\r\n\u001b[?2004l\r"]
[133.498966, "o", "\u001b[?2004h> "]
[133.499071, "o", "    )\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[133.499177, "o", "\u001b[?2004h> "]
[133.499743, "o", "    # `windowed.down` emits items shaped as: (symbol, (window_id, acc))\r\n\u001b[?2004l\r"]
[133.499848, "o", "\u001b[?2004h> "]
[133.500286, "o", "    def format_output(item: Tuple[str, Tuple[int, dict]]):\r\n\u001b[?2004l\r"]
[133.500395, "o", "\u001b[?2004h> "]
[133.500702, "o", "        symbol, (window_id, acc) = item\r\n\u001b[?2004l\r"]
[133.500819, "o", "\u001b[?2004h> "]
[133.501207, "o", "        window_start = window_id_to_start(window_id)\r\n\u001b[?2004l\r"]
[133.501287, "o", "\u001b[?2004h> "]
[133.501425, "o", "        record = {\r\n\u001b[?2004l\r"]
[133.501501, "o", "\u001b[?2004h> "]
[133.502102, "o", "            \"window_start\": window_start.strftime(\"%Y-%m-%dT%H:%M:%SZ\"),\r\n\u001b[?2004l\r"]
[133.502151, "o", "\u001b[?2004h"]
[133.502256, "o", "> "]
[133.502432, "o", "            \"symbol\": symbol,\r\n\u001b[?2004l\r"]
[133.502479, "o", "\u001b[?2004h"]
[133.502527, "o", "> "]
[133.502772, "o", "            \"open\": acc[\"open\"],\r\n\u001b[?2004l\r"]
[133.502848, "o", "\u001b[?2004h> "]
[133.503112, "o", "            \"high\": acc[\"high\"],\r\n\u001b[?2004l\r"]
[133.503178, "o", "\u001b[?2004h> "]
[133.503442, "o", "            \"low\": acc[\"low\"],\r\n\u001b[?2004l\r"]
[133.503518, "o", "\u001b[?2004h"]
[133.503592, "o", "> "]
[133.503825, "o", "            \"close\": acc[\"close\"],\r\n\u001b[?2004l\r"]
[133.503892, "o", "\u001b[?2004h> "]
[133.504217, "o", "            \"volume\": acc[\"volume\"],\r\n\u001b[?2004l\r"]
[133.504289, "o", "\u001b[?2004h> "]
[133.504378, "o", "        }\r\n\u001b[?2004l\r"]
[133.50445, "o", "\u001b[?2004h> "]
[133.504725, "o", "        return json.dumps(record)\r\n\u001b[?2004l\r"]
[133.504797, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[133.504857, "o", "\u001b[?2004h"]
[133.504923, "o", "> "]
[133.505396, "o", "    formatted = op.map(\"format\", windowed.down, format_output)\r\n\u001b[?2004l\r"]
[133.505444, "o", "\u001b[?2004h"]
[133.505545, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[133.50569, "o", "    # Write to a JSONL file\r\n\u001b[?2004l\r"]
[133.505756, "o", "\u001b[?2004h> "]
[133.505951, "o", "    out_sink = FileSink(output_path)\r\n\u001b[?2004l\r"]
[133.506023, "o", "\u001b[?2004h> "]
[133.506272, "o", "    op.output(\"jsonl_out\", formatted, out_sink)\r\n\u001b[?2004l\r"]
[133.506352, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[133.506401, "o", "\u001b[?2004h> "]
[133.506484, "o", "    return flow\r\n\u001b[?2004l\r"]
[133.506547, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[133.50661, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[133.506672, "o", "> "]
[133.506734, "o", "def main():\r\n\u001b[?2004l\r\u001b[?2004h"]
[133.506804, "o", "> "]
[133.507087, "o", "    parser = argparse.ArgumentParser(\r\n\u001b[?2004l\r\u001b[?2004h> "]
[133.507468, "o", "        description=\"Tumbling Window OHLCV Aggregation using Bytewax\"\r\n\u001b[?2004l\r\u001b[?2004h"]
[133.507556, "o", ">     )\r\n\u001b[?2004l\r\u001b[?2004h"]
[133.507639, "o", "> "]
[133.507734, "o", "    parser.add_argument(\r\n\u001b[?2004l\r"]
[133.507814, "o", "\u001b[?2004h> "]
[133.507894, "o", "        \"--input\",\r\n\u001b[?2004l\r"]
[133.507981, "o", "\u001b[?2004h> "]
[133.508079, "o", "        required=True,\r\n\u001b[?2004l\r"]
[133.50816, "o", "\u001b[?2004h> "]
[133.508241, "o", "        type=Path,\r\n\u001b[?2004l\r"]
[133.508331, "o", "\u001b[?2004h> "]
[133.508761, "o", "        help=\"Path to input CSV file with columns: timestamp,symbol,price,volume\",\r\n\u001b[?2004l\r"]
[133.508845, "o", "\u001b[?2004h>     )\r\n\u001b[?2004l\r"]
[133.508927, "o", "\u001b[?2004h> "]
[133.509045, "o", "    parser.add_argument(\r\n\u001b[?2004l\r"]
[133.509126, "o", "\u001b[?2004h> "]
[133.509218, "o", "        \"--output\",\r\n\u001b[?2004l\r"]
[133.509297, "o", "\u001b[?2004h> "]
[133.509408, "o", "        required=True,\r\n\u001b[?2004l\r\u001b[?2004h"]
[133.509489, "o", "> "]
[133.509564, "o", "        type=Path,\r\n\u001b[?2004l\r"]
[133.509644, "o", "\u001b[?2004h> "]
[133.509854, "o", "        help=\"Path to output JSONL file\",\r\n\u001b[?2004l\r"]
