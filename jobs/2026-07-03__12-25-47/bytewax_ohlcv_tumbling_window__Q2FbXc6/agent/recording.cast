[102.607831, "o", "\u001b[?2004h> "]
[102.608266, "o", "            \"volume\": a[\"volume\"] + b[\"volume\"],\r\n\u001b[?2004l\r"]
[102.608362, "o", "\u001b[?2004h> "]
