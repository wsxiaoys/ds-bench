[156.665256, "o", "\r\nclass StatelessSinkPartition(ABC, Generic[X]):\r\n    \"\"\"Output partition that is stateless.\"\"\"\r\n\r\n    @abstractmethod\r\n    def write_batch(self, items: List[X]) -> None:\r\n        \"\"\"Write a batch of output items.\r\n\r\n        Called multiple times whenever new items are seen at this\r\n        point in the dataflow.\r\n\r\n        :arg items: Items in the dataflow. Non-deterministically\r\n            batched.\r\n\r\n        \"\"\"\r\n        ...\r\n"]
[156.665352, "o", "\r\n    def close(self) -> None:\r\n        \"\"\"Cleanup this partition when the dataflow completes.\r\n\r\n        This is not guaranteed to be called. It will only be called\r\n        when the dataflow finishes on finite input. It will not be\r\n        called during an abrupt or abort shutdown.\r\n\r\n        \"\"\"\r\n        return\r\n\r\n\r\nclass DynamicSink(Sink[X]):\r\n    \"\"\"An output sink where all workers write items concurrently.\r\n\r\n    Does not support storing any resume state. Thus these kind of\r\n    outputs only naively can support at-least-once processing.\r\n\r\n    \"\"\"\r\n\r\n    @abstractmethod\r\n    def build(\r\n        self, step_id: str, worker_index: int, worker_count: int\r\n    ) -> StatelessSinkPartition[X]:\r\n        \"\"\"Build an output partition for a worker.\r\n\r\n        Will be called once on each worker.\r\n\r\n        :arg step_id: The step_id of the output operator.\r\n\r\n        :arg worker_index: Index of this worker.\r\n\r\n        :arg worker_count: Total number of workers.\r\n\r\n        :returns: The built partition.\r\n\r\n        \"\"\"\r\n        ...\r\n"]
[156.665621, "o", "\u001b[?2004hroot@97c5c4c0-869e-45e9-beba-01256e290bbb:~# "]
[177.52249, "i", "cat > run.py << 'EOF'\n#!/usr/bin/env python3\n\"\"\"Tumbling Window OHLCV Aggregation using Bytewax.\"\"\"\n\nimport argparse\nimport json\nfrom datetime import datetime, timedelta, timezone\nfrom pathlib import Path\nfrom typing import List, Tuple\n\nfrom bytewax.connectors.files import CSVSource\nfrom bytewax.dataflow import Dataflow\nimport bytewax.operators as op\nfrom bytewax.outputs import DynamicSink, StatelessSinkPartition\nfrom bytewax.operators.windowing import EventClock, TumblingWindower, fold_window\nfrom bytewax.run import cli_main\nfrom typing_extensions import override\n\n\n# Window alignment origin - the start of the epoch minute in UTC.\nALIGN_TO = datetime(1970, 1, 1, 0, 0, 0, tzinfo=timezone.utc)\nWINDOW_LENGTH = timedelta(minutes=1)\n\n\nclass _JsonlPartition(StatelessSinkPartition[str]):\n    def __init__(self, path: Path):\n        # Truncate the output file on start so we don't accumulate prior runs.\n        self._f = open(path, \"wt\")\n\n    @override\n    def write_batch(self, items: List[str]) -> None:\n        for item in items:\n            self._f.write(item)\n            self._f.write(\"\\n\")\n        self._f.flush()\n\n    @override\n    def close(self) -> None:\n        self._f.close()\n\n\nclass JsonlSink(DynamicSink[str]):\n    \"\"\"A simple JSON Lines file sink.\"\"\"\n\n    def __init__(self, path: Path):\n        self._path = path\n\n    @override\n    def build(\n        self, step_id: str, worker_index: int, worker_count: int\n    ) -> _JsonlPartition:\n        return _JsonlPartition(self._path)\n\n\ndef parse_iso8601(ts: str) -> datetime:\n    \"\"\"Parse an ISO 8601 timestamp string to a timezone-aware datetime.\"\"\"\n    if ts.endswith(\"Z\"):\n        ts = ts[:-1] + \"+00:00\"\n    dt = datetime.fromisoformat(ts)\n    if dt.tzinfo is None:\n        dt = dt.replace(tzinfo=timezone.utc)\n    return dt\n\n\ndef window_id_to_start(window_id: int) -> datetime:\n    \"\"\"Compute the start time of a window from its id.\"\"\"\n    return ALIGN_TO + WINDOW_LENGTH * window_id\n\n\ndef build_flow(input_path: Path, output_path: Path) -> Dataflow:\n    \"\"\"Build the Bytewax dataflow for OHLCV aggregation.\"\"\"\n    flow = Dataflow(\"ohlcv_1min\")\n\n    # Read CSV file\n    csv_source = CSVSource(input_path)\n    inp = op.input(\"csv_in\", flow, csv_source)\n\n    # Parse each row into a trade record with parsed types.\n    parsed = op.map(\"parse\", inp, lambda row: {\n        \"symbol\": row[\"symbol\"],\n        \"price\": float(row[\"price\"]),\n        \"volume\": float(row[\"volume\"]),\n        \"timestamp\": parse_iso8601(row[\"timestamp\"]),\n    })\n\n    # Key the stream by symbol so windowing is per-symbol.\n    keyed = op.key_on(\"key_symbol\", parsed, lambda x: x[\"symbol\"])\n\n    # Event-time clock driven by the trade timestamp.\n    clock = EventClock(\n        ts_getter=lambda x: x[\"timestamp\"],\n        wait_for_system_duration=timedelta(seconds=0),\n    )\n\n    # 1-minute tumbling window aligned to minute boundaries (epoch).\n    windower = TumblingWindower(\n        length=WINDOW_LENGTH,\n        align_to=ALIGN_TO,\n    )\n\n    # OHLCV accumulator builder.\n    def builder():\n        return {\n            \"open\": None,\n            \"high\": None,\n            \"low\": None,\n            \"close\": None,\n            \"volume\": 0.0,\n        }\n\n    # Update OHLCV state with a new trade.\n    def folder(acc, trade):\n        price = trade[\"price\"]\n        if acc[\"open\"] is None:\n            acc[\"open\"] = price\n            acc[\"high\"] = price\n            acc[\"low\"] = price\n        else:\n            if price > acc[\"high\"]:\n                acc[\"high\"] = price\n            if price < acc[\"low\"]:\n                acc[\"low\"] = price\n        acc[\"close\"] = price\n        acc[\"volume\"] += trade[\"volume\"]\n        return acc\n\n    # Merge two partial accumulators (e.g. from parallel input sources).\n    def merger(a, b):\n        if a[\"open\"] is None:\n            return b\n        if b[\"open\"] is None:\n            return a\n        return {\n            \"open\": a[\"open\"],\n            \"high\": max(a[\"high\"], b[\"high\"]),\n            \"low\": min(a[\"low\"], b[\"low\"]),\n            \"close\": b[\"close\"],\n            \"volume\": a[\"volume\"] + b[\"volume\"],\n        }\n\n"]
[177.522644, "i", "    windowed = fold_window(\n        \"ohlcv_fold\",\n        keyed,\n        clock,\n        windower,\n        builder=builder,\n        folder=folder,\n        merger=merger,\n    )\n\n    # `windowed.down` emits items shaped as: (symbol, (window_id, acc))\n    def format_output(item: Tuple[str, Tuple[int, dict]]) -> str:\n        symbol, (window_id, acc) = item\n        window_start = window_id_to_start(window_id)\n        record = {\n            \"window_start\": window_start.strftime(\"%Y-%m-%dT%H:%M:%SZ\"),\n            \"symbol\": symbol,\n            \"open\": acc[\"open\"],\n            \"high\": acc[\"high\"],\n            \"low\": acc[\"low\"],\n            \"close\": acc[\"close\"],\n            \"volume\": acc[\"volume\"],\n        }\n        return json.dumps(record)\n\n    formatted = op.map(\"format\", windowed.down, format_output)\n\n    # Write to a JSONL file using a custom DynamicSink.\n    out_sink = JsonlSink(output_path)\n    op.output(\"jsonl_out\", formatted, out_sink)\n\n    return flow\n\n\ndef main():\n    parser = argparse.ArgumentParser(\n        description=\"Tumbling Window OHLCV Aggregation using Bytewax\"\n    )\n    parser.add_argument(\n        \"--input\",\n        required=True,\n        type=Path,\n        help=\"Path to input CSV file with columns: timestamp,symbol,price,volume\",\n    )\n    parser.add_argument(\n        \"--output\",\n        required=True,\n        type=Path,\n        help=\"Path to output JSONL file\",\n    )\n    args = parser.parse_args()\n\n    flow = build_flow(args.input, args.output)\n    cli_main(flow)\n\n\nif __name__ == \"__main__\":\n    main()\nEOF\n"]
