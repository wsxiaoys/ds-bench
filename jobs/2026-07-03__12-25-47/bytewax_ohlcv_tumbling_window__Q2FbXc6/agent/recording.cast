[102.606178, "o", "\u001b[?2004h> "]
[102.606486, "o", "            \"open\": a[\"open\"],\r\n\u001b[?2004l\r"]
[102.606569, "o", "\u001b[?2004h> "]
[102.606954, "o", "            \"high\": max(a[\"high\"], b[\"high\"]),\r\n\u001b[?2004l\r"]
[102.607006, "o", "\u001b[?2004h> "]
