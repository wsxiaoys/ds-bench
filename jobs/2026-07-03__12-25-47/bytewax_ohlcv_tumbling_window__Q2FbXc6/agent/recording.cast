[48.794445, "o", "\u001b[32m\u001b[K896\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[01;31m\u001b[Kclass TumblingWindower\u001b[m\u001b[K(Windower[_SlidingWindowerState]):\r\n"]
[48.794538, "o", "\u001b[32m\u001b[K1388\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[01;31m\u001b[Kdef collect_window\u001b[m\u001b[K(\r\n\u001b[32m\u001b[K1397\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[01;31m\u001b[Kdef collect_window\u001b[m\u001b[K(\r\n\u001b[32m\u001b[K1407\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[01;31m\u001b[Kdef collect_window\u001b[m\u001b[K(\r\n\u001b[32m\u001b[K1417\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[01;31m\u001b[Kdef collect_window\u001b[m\u001b[K(\r\n\u001b[32m\u001b[K1427\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[01;31m\u001b[Kdef collect_window\u001b[m\u001b[K(\r\n\u001b[32m\u001b[K1437\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[01;31m\u001b[Kdef collect_window\u001b[m\u001b[K(\r\n\u001b[32m\u001b[K1718\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[01;31m\u001b[Kdef fold_window\u001b[m\u001b[K(\r\n"]
[48.79484, "o", "\u001b[?2004hroot@97c5c4c0-869e-45e9-beba-01256e290bbb:~# "]
[49.63053, "i", "cat /usr/local/lib/python3.12/dist-packages/bytewax/connectors/files.py | head -100\n"]
