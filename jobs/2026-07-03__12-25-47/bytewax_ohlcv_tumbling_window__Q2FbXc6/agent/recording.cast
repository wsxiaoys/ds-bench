[177.539544, "o", "        self._f.close()\r\n\u001b[?2004l\r"]
[177.539647, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[177.539757, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[177.539852, "o", "\u001b[?2004h> "]
[177.540246, "o", "class JsonlSink(DynamicSink[str]):\r\n\u001b[?2004l\r"]
[177.540373, "o", "\u001b[?2004h> "]
[177.540808, "o", "    \"\"\"A simple JSON Lines file sink.\"\"\"\r\n\u001b[?2004l\r"]
[177.540916, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[177.541016, "o", "\u001b[?2004h> "]
[177.541403, "o", "    def __init__(self, path: Path):\r\n\u001b[?2004l\r"]
[177.541505, "o", "\u001b[?2004h> "]
[177.54178, "o", "        self._path = path\r\n\u001b[?2004l\r"]
[177.541935, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[177.542043, "o", "> "]
[177.542158, "o", "    @override\r\n\u001b[?2004l\r"]
[177.542253, "o", "\u001b[?2004h> "]
[177.542443, "o", "    def build(\r\n\u001b[?2004l\r"]
[177.542537, "o", "\u001b[?2004h> "]
[177.543186, "o", "        self, step_id: str, worker_index: int, worker_count: int\r\n\u001b[?2004l\r"]
[177.54328, "o", "\u001b[?2004h> "]
[177.543575, "o", "    ) -> _JsonlPartition:\r\n\u001b[?2004l\r"]
[177.543672, "o", "\u001b[?2004h> "]
[177.544111, "o", "        return _JsonlPartition(self._path)\r\n\u001b[?2004l\r"]
[177.544207, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[177.544316, "o", "\u001b[?2004h> \r\n"]
[177.54441, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[177.544839, "o", "def parse_iso8601(ts: str) -> datetime:\r\n\u001b[?2004l\r"]
[177.544933, "o", "\u001b[?2004h> "]
[177.545602, "o", "    \"\"\"Parse an ISO 8601 timestamp string to a timezone-aware datetime.\"\"\"\r\n\u001b[?2004l\r"]
[177.545698, "o", "\u001b[?2004h> "]
[177.54593, "o", "    if ts.endswith(\"Z\"):\r\n\u001b[?2004l\r"]
[177.546021, "o", "\u001b[?2004h> "]
[177.546329, "o", "        ts = ts[:-1] + \"+00:00\"\r\n\u001b[?2004l\r"]
[177.546424, "o", "\u001b[?2004h> "]
[177.546744, "o", "    dt = datetime.fromisoformat(ts)\r\n\u001b[?2004l\r"]
[177.546835, "o", "\u001b[?2004h> "]
[177.547088, "o", "    if dt.tzinfo is None:\r\n\u001b[?2004l\r"]
[177.547184, "o", "\u001b[?2004h> "]
[177.547588, "o", "        dt = dt.replace(tzinfo=timezone.utc)\r\n\u001b[?2004l\r"]
[177.547681, "o", "\u001b[?2004h> "]
[177.547833, "o", "    return dt\r\n\u001b[?2004l\r"]
[177.547926, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[177.548018, "o", "\u001b[?2004h> \r\n"]
[177.548111, "o", "\u001b[?2004l\r\u001b[?2004h"]
[177.5482, "o", "> "]
[177.548626, "o", "def window_id_to_start(window_id: int) -> datetime:\r\n\u001b[?2004l\r"]
[177.548721, "o", "\u001b[?2004h> "]
[177.549222, "o", "    \"\"\"Compute the start time of a window from its id.\"\"\"\r\n\u001b[?2004l\r"]
[177.549347, "o", "\u001b[?2004h> "]
[177.54975, "o", "    return ALIGN_TO + WINDOW_LENGTH * window_id\r\n\u001b[?2004l\r"]
[177.549843, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[177.54993, "o", "\u001b[?2004h"]
[177.550023, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h"]
[177.550111, "o", "> "]
[177.55071, "o", "def build_flow(input_path: Path, output_path: Path) -> Dataflow:\r\n\u001b[?2004l\r"]
[177.55079, "o", "\u001b[?2004h> "]
[177.551351, "o", "    \"\"\"Build the Bytewax dataflow for OHLCV aggregation.\"\"\"\r\n\u001b[?2004l\r"]
[177.551501, "o", "\u001b[?2004h> "]
[177.551787, "o", "    flow = Dataflow(\"ohlcv_1min\")\r\n\u001b[?2004l\r"]
[177.551892, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[177.551958, "o", "\u001b[?2004h> "]
[177.552199, "o", "    # Read CSV file\r\n\u001b[?2004l\r"]
[177.552314, "o", "\u001b[?2004h> "]
[177.552653, "o", "    csv_source = CSVSource(input_path)\r\n\u001b[?2004l\r"]
[177.552752, "o", "\u001b[?2004h> "]
[177.553157, "o", "    inp = op.input(\"csv_in\", flow, csv_source)\r\n\u001b[?2004l\r"]
[177.55326, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[177.553397, "o", "\u001b[?2004h> "]
[177.553901, "o", "    # Parse each row into a trade record with parsed types.\r\n\u001b[?2004l\r"]
[177.553975, "o", "\u001b[?2004h> "]
[177.554465, "o", "    parsed = op.map(\"parse\", inp, lambda row: {\r\n\u001b[?2004l\r"]
[177.55458, "o", "\u001b[?2004h> "]
[177.554802, "o", "        \"symbol\": row[\"symbol\"],\r\n\u001b[?2004l\r"]
[177.554885, "o", "\u001b[?2004h> "]
[177.555339, "o", "        \"price\": float(row[\"price\"]),\r\n\u001b[?2004l\r\u001b[?2004h> "]
[177.555629, "o", "        \"volume\": float(row[\"volume\"]),\r\n\u001b[?2004l\r"]
[177.555715, "o", "\u001b[?2004h> "]
[177.556145, "o", "        \"timestamp\": parse_iso8601(row[\"timestamp\"]),\r\n\u001b[?2004l\r"]
[177.556231, "o", "\u001b[?2004h> "]
[177.556322, "o", "    })\r\n\u001b[?2004l\r\u001b[?2004h"]
[177.556426, "o", "> \r\n\u001b[?2004l\r"]
[177.556524, "o", "\u001b[?2004h> "]
[177.556949, "o", "    # Key the stream by symbol so windowing is per-symbol.\r\n\u001b[?2004l\r"]
[177.557036, "o", "\u001b[?2004h> "]
[177.557715, "o", "    keyed = op.key_on(\"key_symbol\", parsed, lambda x: x[\"symbol\"])\r\n\u001b[?2004l\r"]
[177.557803, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[177.557889, "o", "\u001b[?2004h> "]
[177.558334, "o", "    # Event-time clock driven by the trade timestamp.\r\n\u001b[?2004l\r"]
[177.558423, "o", "\u001b[?2004h> "]
[177.558671, "o", "    clock = EventClock(\r\n\u001b[?2004l\r\u001b[?2004h> "]
[177.55904, "o", "        ts_getter=lambda x: x[\"timestamp\"],\r\n\u001b[?2004l\r"]
[177.559118, "o", "\u001b[?2004h> "]
[177.55943, "o", "        wait_for_system_duration=timedelta(seconds=0),\r\n\u001b[?2004l\r\u001b[?2004h"]
[177.559525, "o", ">     )\r\n\u001b[?2004l\r"]
[177.559643, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[177.560045, "o", "    # 1-minute tumbling window aligned to minute boundaries (epoch).\r\n\u001b[?2004l\r"]
[177.560143, "o", "\u001b[?2004h> "]
[177.56032, "o", "    windower = TumblingWindower(\r\n\u001b[?2004l\r"]
[177.560417, "o", "\u001b[?2004h> "]
[177.560565, "o", "        length=WINDOW_LENGTH,\r\n\u001b[?2004l\r"]
[177.560647, "o", "\u001b[?2004h> "]
[177.560797, "o", "        align_to=ALIGN_TO,\r\n\u001b[?2004l\r"]
[177.560875, "o", "\u001b[?2004h>     )\r\n\u001b[?2004l\r"]
[177.560959, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[177.561033, "o", "\u001b[?2004h> "]
[177.561281, "o", "    # OHLCV accumulator builder.\r\n\u001b[?2004l\r\u001b[?2004h> "]
[177.561402, "o", "    def builder():\r\n\u001b[?2004l\r"]
[177.561533, "o", "\u001b[?2004h> "]
[177.561657, "o", "        return {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[177.561824, "o", "            \"open\": None,\r\n\u001b[?2004l\r"]
[177.561928, "o", "\u001b[?2004h> "]
[177.562056, "o", "            \"high\": None,\r\n\u001b[?2004l\r\u001b[?2004h"]
[177.562158, "o", "> "]
[177.562278, "o", "            \"low\": None,\r\n\u001b[?2004l\r\u001b[?2004h"]
[177.562477, "o", "> "]
[177.562742, "o", "            \"close\": None,\r\n\u001b[?2004l\r\u001b[?2004h> "]
[177.562861, "o", "            \"volume\": 0.0,\r\n\u001b[?2004l\r\u001b[?2004h>         }\r\n\u001b[?2004l\r"]
[177.562965, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[177.563238, "o", "    # Update OHLCV state with a new trade.\r\n\u001b[?2004l\r\u001b[?2004h"]
[177.56337, "o", "> "]
[177.59728, "o", "    def folder(acc, trade):\r\n\u001b[?2004l\r\u001b[?2004h"]
[177.597479, "o", "> "]
[177.597668, "o", "        price = trade[\"price\"]\r\n\u001b[?2004l\r"]
[177.597733, "o", "\u001b[?2004h> "]
[177.598109, "o", "        if acc[\"open\"] is None:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[177.598426, "o", "            acc[\"open\"] = price\r\n\u001b[?2004l\r"]
[177.598491, "o", "\u001b[?2004h> "]
[177.598814, "o", "            acc[\"high\"] = price\r\n\u001b[?2004l\r"]
[177.598874, "o", "\u001b[?2004h> "]
[177.599176, "o", "            acc[\"low\"] = price\r\n\u001b[?2004l\r"]
[177.599236, "o", "\u001b[?2004h> "]
[177.599431, "o", "        else:\r\n\u001b[?2004l\r"]
[177.599491, "o", "\u001b[?2004h> "]
[177.599825, "o", "            if price > acc[\"high\"]:\r\n\u001b[?2004l\r"]
[177.599884, "o", "\u001b[?2004h> "]
[177.600225, "o", "                acc[\"high\"] = price\r\n\u001b[?2004l\r"]
[177.600359, "o", "\u001b[?2004h> "]
[177.600651, "o", "            if price < acc[\"low\"]:\r\n\u001b[?2004l\r"]
[177.600721, "o", "\u001b[?2004h> "]
[177.601063, "o", "                acc[\"low\"] = price\r\n\u001b[?2004l\r"]
[177.601125, "o", "\u001b[?2004h> "]
[177.601426, "o", "        acc[\"close\"] = price\r\n\u001b[?2004l\r"]
[177.601482, "o", "\u001b[?2004h> "]
[177.60187, "o", "        acc[\"volume\"] += trade[\"volume\"]\r\n\u001b[?2004l\r"]
[177.601924, "o", "\u001b[?2004h> "]
[177.602136, "o", "        return acc\r\n\u001b[?2004l\r"]
[177.602189, "o", "\u001b[?2004h> "]
[177.602316, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[177.602949, "o", "    # Merge two partial accumulators (e.g. from parallel input sources).\r\n\u001b[?2004l\r"]
[177.603008, "o", "\u001b[?2004h> "]
[177.603336, "o", "    def merger(a, b):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[177.603589, "o", "        if a[\"open\"] is None:\r\n\u001b[?2004l\r"]
[177.603646, "o", "\u001b[?2004h> "]
[177.603874, "o", "            return b\r\n\u001b[?2004l\r"]
[177.603932, "o", "\u001b[?2004h> "]
[177.604227, "o", "        if b[\"open\"] is None:\r\n\u001b[?2004l\r"]
[177.604282, "o", "\u001b[?2004h> "]
[177.604531, "o", "            return a\r\n\u001b[?2004l\r"]
[177.604631, "o", "\u001b[?2004h> "]
[177.604763, "o", "        return {\r\n\u001b[?2004l\r"]
[177.604834, "o", "\u001b[?2004h> "]
[177.605176, "o", "            \"open\": a[\"open\"],\r\n\u001b[?2004l\r\u001b[?2004h> "]
[177.605582, "o", "            \"high\": max(a[\"high\"], b[\"high\"]),\r\n\u001b[?2004l\r"]
[177.605667, "o", "\u001b[?2004h> "]
[177.606012, "o", "            \"low\": min(a[\"low\"], b[\"low\"]),\r\n\u001b[?2004l\r"]
[177.606105, "o", "\u001b[?2004h> "]
[177.606435, "o", "            \"close\": b[\"close\"],\r\n\u001b[?2004l\r"]
[177.606524, "o", "\u001b[?2004h> "]
[177.60699, "o", "            \"volume\": a[\"volume\"] + b[\"volume\"],\r\n\u001b[?2004l\r"]
[177.607101, "o", "\u001b[?2004h> "]
[177.607194, "o", "        }\r\n\u001b[?2004l\r"]
[177.607269, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[177.607508, "o", "\u001b[?2004h> "]
[177.607731, "o", "    windowed = fold_window(\r\n\u001b[?2004l\r"]
[177.607842, "o", "\u001b[?2004h> "]
[177.60807, "o", "        \"ohlcv_fold\",\r\n\u001b[?2004l\r"]
[177.608194, "o", "\u001b[?2004h> "]
[177.608293, "o", "        keyed,\r\n\u001b[?2004l\r"]
[177.608562, "o", "\u001b[?2004h>         clock,\r\n\u001b[?2004l\r"]
[177.608665, "o", "\u001b[?2004h> "]
[177.608807, "o", "        windower,\r\n\u001b[?2004l\r"]
[177.608889, "o", "\u001b[?2004h> "]
[177.609131, "o", "        builder=builder,\r\n\u001b[?2004l\r"]
[177.609213, "o", "\u001b[?2004h> "]
[177.609461, "o", "        folder=folder,\r\n\u001b[?2004l\r"]
[177.609545, "o", "\u001b[?2004h> "]
[177.60976, "o", "        merger=merger,\r\n\u001b[?2004l\r"]
[177.609842, "o", "\u001b[?2004h> "]
[177.609934, "o", "    )\r\n\u001b[?2004l\r"]
[177.61002, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[177.610108, "o", "\u001b[?2004h> "]
[177.610837, "o", "    # `windowed.down` emits items shaped as: (symbol, (window_id, acc))\r\n\u001b[?2004l\r"]
[177.610925, "o", "\u001b[?2004h> "]
[177.611535, "o", "    def format_output(item: Tuple[str, Tuple[int, dict]]) -> str:\r\n\u001b[?2004l\r"]
[177.61162, "o", "\u001b[?2004h> "]
[177.612019, "o", "        symbol, (window_id, acc) = item\r\n\u001b[?2004l\r"]
[177.612089, "o", "\u001b[?2004h> "]
[177.612685, "o", "        window_start = window_id_to_start(window_id)\r\n\u001b[?2004l\r"]
[177.612759, "o", "\u001b[?2004h> "]
[177.612996, "o", "        record = {\r\n\u001b[?2004l\r"]
[177.613065, "o", "\u001b[?2004h> "]
[177.613839, "o", "            \"window_start\": window_start.strftime(\"%Y-%m-%dT%H:%M:%SZ\"),\r\n\u001b[?2004l\r"]
[177.613907, "o", "\u001b[?2004h> "]
[177.614261, "o", "            \"symbol\": symbol,\r\n\u001b[?2004l\r"]
[177.614342, "o", "\u001b[?2004h> "]
[177.614734, "o", "            \"open\": acc[\"open\"],\r\n\u001b[?2004l\r"]
[177.614797, "o", "\u001b[?2004h> "]
[177.615166, "o", "            \"high\": acc[\"high\"],\r\n\u001b[?2004l\r"]
[177.615234, "o", "\u001b[?2004h> "]
[177.615605, "o", "            \"low\": acc[\"low\"],\r\n\u001b[?2004l\r"]
[177.615672, "o", "\u001b[?2004h> "]
[177.61607, "o", "            \"close\": acc[\"close\"],\r\n\u001b[?2004l\r"]
[177.616133, "o", "\u001b[?2004h> "]
[177.616559, "o", "            \"volume\": acc[\"volume\"],\r\n\u001b[?2004l\r"]
[177.616623, "o", "\u001b[?2004h> "]
[177.616785, "o", "        }\r\n\u001b[?2004l\r"]
[177.616848, "o", "\u001b[?2004h> "]
[177.617484, "o", "        return json.dumps(record)\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[177.618118, "o", "    formatted = op.map(\"format\", windowed.down, format_output)\r\n\u001b[?2004l\r"]
[177.6182, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[177.618279, "o", "\u001b[?2004h"]
[177.618491, "o", "> "]
[177.618926, "o", "    # Write to a JSONL file using a custom DynamicSink.\r\n\u001b[?2004l\r"]
[177.619, "o", "\u001b[?2004h> "]
[177.619446, "o", "    out_sink = JsonlSink(output_path)\r\n\u001b[?2004l\r"]
[177.619524, "o", "\u001b[?2004h> "]
[177.620214, "o", "    op.output(\"jsonl_out\", formatted, out_sink)\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[177.620409, "o", "    return flow\r\n\u001b[?2004l\r"]
[177.620489, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[177.620633, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[177.620701, "o", "\u001b[?2004h> "]
[177.620879, "o", "def main():\r\n\u001b[?2004l\r"]
[177.620947, "o", "\u001b[?2004h> "]
[177.621395, "o", "    parser = argparse.ArgumentParser(\r\n\u001b[?2004l\r"]
[177.621465, "o", "\u001b[?2004h> "]
[177.622187, "o", "        description=\"Tumbling Window OHLCV Aggregation using Bytewax\"\r\n\u001b[?2004l\r"]
[177.622254, "o", "\u001b[?2004h> "]
[177.622408, "o", "    )\r\n\u001b[?2004l\r"]
[177.622481, "o", "\u001b[?2004h> "]
[177.622897, "o", "    parser.add_argument(\r\n\u001b[?2004l\r"]
[177.62297, "o", "\u001b[?2004h> "]
[177.623109, "o", "        \"--input\",\r\n\u001b[?2004l\r\u001b[?2004h"]
[177.623173, "o", "> "]
[177.623434, "o", "        required=True,\r\n\u001b[?2004l\r"]
[177.6235, "o", "\u001b[?2004h> "]
[177.623702, "o", "        type=Path,\r\n\u001b[?2004l\r"]
[177.623762, "o", "\u001b[?2004h> "]
[177.624512, "o", "        help=\"Path to input CSV file with columns: timestamp,symbol,price,volume\",\r\n\u001b[?2004l\r"]
[177.624572, "o", "\u001b[?2004h> "]
[177.624711, "o", "    )\r\n\u001b[?2004l\r\u001b[?2004h"]
[177.624774, "o", "> "]
[177.625018, "o", "    parser.add_argument(\r\n\u001b[?2004l\r"]
[177.625083, "o", "\u001b[?2004h> "]
[177.625296, "o", "        \"--output\",\r\n\u001b[?2004l\r"]
[177.625431, "o", "\u001b[?2004h> "]
[177.625747, "o", "        required=True,\r\n\u001b[?2004l\r\u001b[?2004h> "]
[177.625888, "o", "        type=Path,\r\n\u001b[?2004l\r"]
[177.625951, "o", "\u001b[?2004h> "]
[177.626357, "o", "        help=\"Path to output JSONL file\",\r\n\u001b[?2004l\r"]
[177.626422, "o", "\u001b[?2004h> "]
