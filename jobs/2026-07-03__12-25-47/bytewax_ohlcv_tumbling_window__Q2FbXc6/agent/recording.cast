[115.231007, "o", "grep -n 'WindowMetadata\\|class WindowMetadata\\|window_start\\|open_time' /usr/local/lib/python3.12/dist-packages/bytewax/operators/windowing.py | head -30\r\n\u001b[?2004l\r"]
[115.233041, "o", "429:class WindowMetadata:\r\n438:    open_time: datetime\r\n523:    def close_for(self, watermark: datetime) -> Iterable[Tuple[int, WindowMetadata]]:\r\n600:    opened: Dict[int, WindowMetadata] = field(default_factory=dict)\r\n620:    def _metadata_for(self, window_id: int) -> WindowMetadata:\r\n621:        open_time = self.align_to + self.offset * window_id\r\n622:        close_time = open_time + self.length\r\n623:        return WindowMetadata(open_time, close_time)\r\n645:    def close_for(self, watermark: datetime) -> Iterable[Tuple[int, WindowMetadata]]:\r\n678:    sessions: Dict[int, WindowMetadata] = field(default_factory=dict)\r\n683:def _open_sort(id_meta: Tuple[int, WindowMetadata]) -> datetime:\r\n685:    return meta.open_time\r\n689:    sessions: Dict[int, WindowMetadata],\r\n701:        if this_meta.open_time - last_meta.close_time <= gap:\r\n734:            assert meta.open_time <= meta.close_time\r\n735:            until_open = meta.open_time - timestamp\r\n746:                meta.open_time = timestamp\r\n760:        self.state.sessions[window_id] = WindowMetadata(timestamp, timestamp)\r\n775:    def close_for(self, watermark: datetime) -> Iterable[Tuple[int, WindowMetadata]]:\r\n1042:_Meta: TypeAlias = Tuple[int, Literal[\"M\"], WindowMetadata]\r\n1212:    meta: KeyedStream[Tuple[int, WindowMetadata]]\r\n1217:    {py:obj}`~bytewax.operators.windowing.WindowMetadata` will have\r\n1219:    {py:obj}`~bytewax.operators.windowing.WindowMetadata.merged_ids`.\r\n1245:) -> Optional[Tuple[int, WindowMetadata]]:\r\n1248:        meta = cast(WindowMetadata, obj)\r\n"]
[115.233135, "o", "1333:    metas: KeyedStream[Tuple[int, WindowMetadata]] = op.filter_map_value(\r\n"]
[115.23327, "o", "\u001b[?2004h"]
[115.233376, "o", "root@97c5c4c0-869e-45e9-beba-01256e290bbb:~# "]
[133.421585, "i", "cat > run.py << 'EOF'\n#!/usr/bin/env python3\n\"\"\"Tumbling Window OHLCV Aggregation using Bytewax.\"\"\"\n\nimport argparse\nimport json\nfrom datetime import datetime, timedelta, timezone\nfrom pathlib import Path\nfrom typing import Tuple\n\nfrom bytewax.connectors.files import CSVSource, FileSink\nfrom bytewax.dataflow import Dataflow\nimport bytewax.operators as op\nfrom bytewax.operators.windowing import EventClock, TumblingWindower, fold_window\nfrom bytewax.run import cli_main\n\n\n# Window alignment origin - the start of the epoch minute in UTC.\nALIGN_TO = datetime(1970, 1, 1, 0, 0, 0, tzinfo=timezone.utc)\nWINDOW_LENGTH = timedelta(minutes=1)\n\n\ndef parse_iso8601(ts: str) -> datetime:\n    \"\"\"Parse an ISO 8601 timestamp string to a timezone-aware datetime.\"\"\"\n    if ts.endswith(\"Z\"):\n        ts = ts[:-1] + \"+00:00\"\n    dt = datetime.fromisoformat(ts)\n    if dt.tzinfo is None:\n        dt = dt.replace(tzinfo=timezone.utc)\n    return dt\n\n\ndef window_id_to_start(window_id: int) -> datetime:\n    \"\"\"Compute the start time of a window from its id.\"\"\"\n    return ALIGN_TO + WINDOW_LENGTH * window_id\n\n\ndef build_flow(input_path: Path, output_path: Path) -> Dataflow:\n    \"\"\"Build the Bytewax dataflow for OHLCV aggregation.\"\"\"\n    flow = Dataflow(\"ohlcv_1min\")\n\n    # Read CSV file\n    csv_source = CSVSource(input_path)\n    inp = op.input(\"csv_in\", flow, csv_source)\n\n    # Parse each row into (symbol, price, volume, timestamp_dt)\n    parsed = op.map(\"parse\", inp, lambda row: {\n        \"symbol\": row[\"symbol\"],\n        \"price\": float(row[\"price\"]),\n        \"volume\": float(row[\"volume\"]),\n        \"timestamp\": parse_iso8601(row[\"timestamp\"]),\n    })\n\n    # Key the stream by symbol\n    keyed = op.key_on(\"key_symbol\", parsed, lambda x: x[\"symbol\"])\n\n    # Define the event-time clock using the trade timestamp\n    clock = EventClock(\n        ts_getter=lambda x: x[\"timestamp\"],\n        wait_for_system_duration=timedelta(seconds=0),\n    )\n\n    # Define a 1-minute tumbling window aligned to the minute boundary\n    windower = TumblingWindower(\n        length=WINDOW_LENGTH,\n        align_to=ALIGN_TO,\n    )\n\n    # OHLCV accumulator builder.\n    def builder():\n        return {\n            \"open\": None,\n            \"high\": None,\n            \"low\": None,\n            \"close\": None,\n            \"volume\": 0.0,\n        }\n\n    # Update OHLCV state with a new trade.\n    def folder(acc, trade):\n        price = trade[\"price\"]\n        if acc[\"open\"] is None:\n            acc[\"open\"] = price\n            acc[\"high\"] = price\n            acc[\"low\"] = price\n        else:\n            if price > acc[\"high\"]:\n                acc[\"high\"] = price\n            if price < acc[\"low\"]:\n                acc[\"low\"] = price\n        acc[\"close\"] = price\n        acc[\"volume\"] += trade[\"volume\"]\n        return acc\n\n    # Merge two partial accumulators (e.g., from different input sources).\n    def merger(a, b):\n        if a[\"open\"] is None:\n            return b\n        if b[\"open\"] is None:\n            return a\n        return {\n            \"open\": a[\"open\"],\n            \"high\": max(a[\"high\"], b[\"high\"]),\n            \"low\": min(a[\"low\"], b[\"low\"]),\n            \"close\": b[\"close\"],\n            \"volume\": a[\"volume\"] + b[\"volume\"],\n        }\n\n    windowed = fold_window(\n        \"ohlcv_fold\",\n        keyed,\n        clock,\n        windower,\n        builder=builder,\n        folder=folder,\n        merger=merger,\n    )\n\n    # `windowed.down` emits items shaped as: (symbol, (window_id, acc))\n    def format_output(item: Tuple[str, Tuple[int, dict]]):\n        symbol, (window_id, acc) = item\n        window_start = window_id_to_start(window_id)\n        record = {\n            \"window_start\": window_start.strftime(\"%Y-%m-%dT%H:%M:%SZ\"),\n            \"symbol\": symbol,\n            \"open\": acc[\"open\"],\n            \"high\": acc[\"high\"],\n            \"low\": acc[\"low\"],\n            \"close\": acc[\"close\"],\n            \"volume\": acc[\"volume\"],\n        }\n        return json.dumps(record)\n\n    formatted = op.map(\"format\", windowed.down, format_output)\n\n    # Write to a JSONL file\n    out_sink = FileSink(output_path)\n    op.o"]
[133.421798, "i", "utput(\"jsonl_out\", formatted, out_sink)\n\n    return flow\n\n\ndef main():\n    parser = argparse.ArgumentParser(\n        description=\"Tumbling Window OHLCV Aggregation using Bytewax\"\n    )\n    parser.add_argument(\n        \"--input\",\n        required=True,\n        type=Path,\n        help=\"Path to input CSV file with columns: timestamp,symbol,price,volume\",\n    )\n    parser.add_argument(\n        \"--output\",\n        required=True,\n        type=Path,\n        help=\"Path to output JSONL file\",\n    )\n    args = parser.parse_args()\n\n    flow = build_flow(args.input, args.output)\n    cli_main(flow)\n\n\nif __name__ == \"__main__\":\n    main()\nEOF\n"]
[133.422259, "o", "cat > run.py << 'EOF'\r\n\u001b[?2004l\r"]
