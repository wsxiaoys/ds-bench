[38.990417, "i", "cat > pb_migrations/1700000000_init.js << 'MIGRATION_EOF'\n/// <reference path=\"../pb_data/types.d.ts\" />\n\nmigrate((db) => {\n  const dao = new Dao(db);\n\n  // Create organizations collection\n  const organizations = new Collection({\n    name: \"organizations\",\n    type: \"base\",\n    schema: [\n      {\n        name: \"name\",\n        type: \"text\",\n        required: true,\n      },\n    ],\n  });\n  dao.saveCollection(organizations);\n\n  // Create organization_members collection\n  const organizationMembers = new Collection({\n    name: \"organization_members\",\n    type: \"base\",\n    schema: [\n      {\n        name: \"user\",\n        type: \"relation\",\n        required: true,\n        options: {\n          collectionId: \"_pb_users_auth_\",\n          cascadeDelete: true,\n          maxSelect: 1,\n        },\n      },\n      {\n        name: \"organization\",\n        type: \"relation\",\n        required: true,\n        options: {\n          collectionId: organizations.id,\n          cascadeDelete: true,\n          maxSelect: 1,\n        },\n      },\n      {\n        name: \"role\",\n        type: \"select\",\n        required: true,\n        options: {\n          maxSelect: 1,\n          values: [\"owner\", \"editor\", \"viewer\"],\n        },\n      },\n    ],\n  });\n  dao.saveCollection(organizationMembers);\n\n  // Create documents collection\n  const documents = new Collection({\n    name: \"documents\",\n    type: \"base\",\n    schema: [\n      {\n        name: \"title\",\n        type: \"text\",\n        required: true,\n      },\n      {\n        name: \"content\",\n        type: \"text\",\n      },\n      {\n        name: \"organization\",\n        type: \"relation\",\n        required: true,\n        options: {\n          collectionId: organizations.id,\n          cascadeDelete: true,\n          maxSelect: 1,\n        },\n      },\n    ],\n    listRule: '@request.auth.id != \"\" && @collection.organization_members.organization.id ?= @request.auth.id && @collection.organization_members.organization.id ?= organization.id',\n    viewRule: '@request.auth.id != \"\" && @collection.organization_members.organization.id ?= @request.auth.id && @collection.organization_members.organization.id ?= organization.id',\n    createRule: '@request.auth.id != \"\" && (@collection.organization_members.organization.id ?= @request.auth.id && (@collection.organization_members.role = \"owner\" || @collection.organization_members.role = \"editor\")) && @collection.organization_members.organization.id ?= @request.body.organization',\n    updateRule: '@request.auth.id != \"\" && @collection.organization_members.organization.id ?= @request.auth.id && @collection.organization_members.organization.id ?= organization.id && (@collection.organization_members.role = \"owner\" || @collection.organization_members.role = \"editor\")',\n    deleteRule: '@request.auth.id != \"\" && @collection.organization_members.organization.id ?= @request.auth.id && @collection.organization_members.organization.id ?= organization.id && @collection.organization_members.role = \"owner\"',\n  });\n  dao.saveCollection(documents);\n}, (db) => {\n  const dao = new Dao(db);\n  try { dao.deleteCollection(dao.findCollectionByNameOrId(\"documents\")); } catch (_) {}\n  try { dao.deleteCollection(dao.findCollectionByNameOrId(\"organization_members\")); } catch (_) {}\n  try { dao.deleteCollection(dao.findCollectionByNameOrId(\"organizations\")); } catch (_) {}\n});\nMIGRATION_EOF\n"]
