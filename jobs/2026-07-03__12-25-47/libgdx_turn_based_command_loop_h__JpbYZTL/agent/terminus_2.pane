[?2004l[?2004h>                 items.remove(i);
[?2004l[?2004h>                 return;
[?2004l[?2004h>             }
[?2004l[?2004h>         }
[?2004l[?2004h>         // No item here: no-op.
[?2004l[?2004h>     }
[?2004l[?2004h> 
