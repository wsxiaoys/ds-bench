[?2004l[?2004h>         currentCommand = commands.get(index++);
[?2004l[?2004h>         activeKeys.clear();
[?2004l[?2004h>         justPressedKeys.clear();
[?2004l[?2004h>         int key = keyFor(currentCommand);
[?2004l[?2004h>         if (key != -1) {
