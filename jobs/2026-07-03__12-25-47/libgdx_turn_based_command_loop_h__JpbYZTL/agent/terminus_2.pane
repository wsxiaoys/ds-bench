[?2004l[?2004h>                 finish();
[?2004l[?2004h>                 return;
[?2004l[?2004h>             }
[?2004l[?2004h>         }
[?2004l[?2004h> 
[?2004l[?2004h>         if (!scriptedInput.hasCommand()) {
[?2004l[?2004h>             finish();
[?2004l[?2004h>             return;
[?2004l[?2004h>         }
