[?2004l[?2004h>         StringBuilder sb = new StringBuilder(32);
[?2004l[?2004h>         sb.append("FINAL pos=").append(playerX).append(',').append(playerY).append(" inv=");
[?2004l[?2004h>         for (int i = 0; i < inventory.size(); i++) {
[?2004l[?2004h>             if (i > 0) sb.append(',');
[?2004l[?2004h>             sb.append(inventory.get(i));
[?2004l[?2004h>         }
[?2004l[?2004h>         sb.append(" turns=").append(turn).append('\n');
[?2004l[?2004h>         appendToTranscript(sb.toString());
[?2004l[?2004h>         // Allow the next render tick to actually exit the headless loop cleanly.
[?2004l[?2004h>         Gdx.app.exit();
