[?2004l[?2004h>     /** Loads the map file using libGDX FileHandle parsing. */
[?2004l[?2004h>     private void loadMap(FileHandle handle) {
[?2004l[?2004h>         String content = handle.readString("UTF-8");
[?2004l[?2004h>         List<String> tokens = new ArrayList<String>();
[?2004l[?2004h>         for (String line : content.split("\n")) {
[?2004l[?2004h>             // Strip comments; ignore blank lines; keep tokens inside useful lines.
[?2004l[?2004h>             int hashIdx = line.indexOf('#');
[?2004l[?2004h>             if (hashIdx >= 0) line = line.substring(0, hashIdx);
[?2004l[?2004h>             line = line.trim();
[?2004l[?2004h>             if (line.isEmpty()) continue;
[?2004l[?2004h>             for (String tok : line.split("\\s+")) {
[?2004l[?2004h>                 if (!tok.isEmpty()) tokens.add(tok);
[?2004l[?2004h>             }
[?2004l[?2004h>         }
[?2004l[?2004h>         if (tokens.size() < 4) {
[?2004l[?2004h>             throw new IllegalArgumentException("Map file too small: " + tokens.size() + " tokens");
[?2004l[?2004h>         }
[?2004l[?2004h>         int idx = 0;
[?2004l[?2004h>         width = parseInt(tokens.get(idx++));
[?2004l[?2004h>         height = parseInt(tokens.get(idx++));
[?2004l[?2004h>         playerX = parseInt(tokens.get(idx++));
[?2004l[?2004h>         playerY = parseInt(tokens.get(idx++));
[?2004l[?2004h>         int itemCount = parseInt(tokens.get(idx++));
