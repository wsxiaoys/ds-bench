[?2004l[?2004h> public class ScriptedMockInput extends MockInput {
[?2004l[?2004h> 
[?2004l[?2004h>     /** Per-tick active keys (cleared at next tick). */
[?2004l[?2004h>     private final List<Integer> activeKeys = new ArrayList<Integer>();
[?2004l[?2004h> 
[?2004l[?2004h>     /** Flags consumed once (per "just pressed" semantics). */
[?2004l[?2004h>     private final List<Integer> justPressedKeys = new ArrayList<Integer>();
[?2004l[?2004h> 
[?2004l[?2004h>     private final List<String> commands;
[?2004l[?2004h>     private int index = 0;
[?2004l[?2004h>     private boolean tickRequested = false;
[?2004l[?2004h>     private String currentCommand;
[?2004l[?2004h> 
[?2004l[?2004h>     public ScriptedMockInput(List<String> commands) {
[?2004l[?2004h>         this.commands = new ArrayList<String>(commands);
[?2004l[?2004h>     }
[?2004l[?2004h> 
[?2004l[?2004h>     /** Returns the current raw command for this tick (may be null if the queue is empty). */
[?2004l[?2004h>     public String getCurrentCommand() {
[?2004l[?2004h>         return currentCommand;
[?2004l[?2004h>     }
[?2004l[?2004h> 
[?2004l[?2004h>     /** True if the current tick has a queued command. */
