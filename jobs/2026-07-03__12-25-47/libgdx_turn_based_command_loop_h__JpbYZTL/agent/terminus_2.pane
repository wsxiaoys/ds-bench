[?2004l[?2004h>             // Rejected: stay in place.
[?2004l[?2004h>             return;
[?2004l[?2004h>         }
[?2004l[?2004h>         playerX = nx;
[?2004l[?2004h>         playerY = ny;
[?2004l[?2004h>     }
[?2004l[?2004h> 
[?2004l[?2004h>     /** Pick the earliest-defined item at the current cell; remove from world; add to inventory. */
