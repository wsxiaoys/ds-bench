[?2004l[?2004h>         if (Gdx.input.isKeyJustPressed(Input.Keys.LEFT)) {
[?2004l[?2004h>             tryMove(-1, 0);
[?2004l[?2004h>             return;
[?2004l[?2004h>         }
[?2004l[?2004h>         if (Gdx.input.isKeyJustPressed(Input.Keys.SPACE)) {
