[?2004l[?2004h>     }
[?2004l[?2004h> 
[?2004l[?2004h>     /** Mutate world state based on the raw command and current input key state. */
[?2004l[?2004h>     private void applyCommand(String raw) {
[?2004l[?2004h>         // First handle the known movement and action keys via MockInput.
[?2004l[?2004h>         if (Gdx.input.isKeyJustPressed(Input.Keys.UP)) {
[?2004l[?2004h>             tryMove(0, 1);
[?2004l[?2004h>             return;
[?2004l[?2004h>         }
[?2004l[?2004h>         if (Gdx.input.isKeyJustPressed(Input.Keys.DOWN)) {
[?2004l[?2004h>             tryMove(0, -1);
[?2004l[?2004h>             return;
[?2004l[?2004h>         }
[?2004l[?2004h>         if (Gdx.input.isKeyJustPressed(Input.Keys.RIGHT)) {
