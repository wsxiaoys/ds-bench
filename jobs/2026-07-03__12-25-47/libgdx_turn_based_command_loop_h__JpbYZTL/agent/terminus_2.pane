[?2004l[?2004h> 
[?2004l[?2004h>     public static void main(String[] args) {
[?2004l[?2004h>         String mapPath = null;
[?2004l[?2004h>         String commandsPath = null;
[?2004l[?2004h>         String transcriptPath = null;
[?2004l[?2004h>         for (String a : args) {
[?2004l[?2004h>             if (a == null) continue;
[?2004l[?2004h>             if (a.startsWith("--map=")) mapPath = a.substring("--map=".length());
[?2004l[?2004h>             else if (a.startsWith("--commands=")) commandsPath = a.substring("--commands=".length());
[?2004l[?2004h>             else if (a.startsWith("--transcript=")) transcriptPath = a.substring("--transcript=".length());
[?2004l[?2004h>         }
[?2004l[?2004h>         if (mapPath == null || commandsPath == null || transcriptPath == null) {
[?2004l[?2004h>             System.err.println("Usage: HeadlessLauncher --map=<path> --commands=<path> --transcript=<path>");
[?2004l[?2004h>             System.exit(2);
[?2004l[?2004h>             return;
[?2004l[?2004h>         }
[?2004l[?2004h> 
[?2004l[?2004h>         // Read commands file via standard IO (parsing is independent of libGDX).
[?2004l[?2004h>         List<String> commands = readCommands(commandsPath);
[?2004l[?2004h> 
[?2004l[?2004h>         // The transcript and map will be read through Gdx.files once Gdx.files exists.
[?2004l[?2004h>         // We construct the listener first; Gdx.files is alive after HeadlessApplication ctor.
[?2004l[?2004h>         CountDownLatch mainLoopDone = new CountDownLatch(1);
[?2004l[?2004h> 
[?2004l[?2004h>         HeadlessApplication app;
[?2004l[?2004h>         {
[?2004l[?2004h>             HeadlessApplicationConfiguration cfg = new HeadlessApplicationConfiguration();
[?2004l[?2004h>             // Run as fast as possible.
[?2004l[?2004h>             cfg.updatesPerSecond = 0;
[?2004l[?2004h>             cfg.renderInterval = 0f;
[?2004l[?2004h>             cfg.idleFPS = 0;
[?2004l[?2004h>             ScriptedMockInput scripted = new ScriptedMockInput(commands);
[?2004l[?2004h>             FileHandle mapHandle = Gdx.files.absolute(new File(mapPath).getAbsolutePath());
[?2004l[?2004h>             FileHandle transcriptHandle = Gdx.files.absolute(new File(transcriptPath).getAbsolutePath());
[?2004l[?2004h>             TurnBasedGame game = new TurnBasedGame(mapHandle, transcriptHandle, scripted);
