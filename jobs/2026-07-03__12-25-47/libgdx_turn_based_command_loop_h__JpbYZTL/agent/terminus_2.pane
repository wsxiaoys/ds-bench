    @Override
    public void render() {
        // Drive the scripted input on every tick.
        scriptedInput.tick();

        if (firstTick) {
            firstTick = false;
            // Wait until the first real command before writing any turn lines.
            if (!scriptedInput.hasCommand()) {
                // No commands at all: write FINAL and exit.
                finish();
                return;
            }
        }

        if (!scriptedInput.hasCommand()) {
            finish();
            return;
        }

        String raw = scriptedInput.getCurrentCommand();
        turn++;
        applyCommand(raw);
        writeTurnLine(raw);

        if (shouldExit || raw.equals("QUIT")) {
            finish();
            return;
        }
        // Loop ends when command file is exhausted: scriptedInput.hasCommand() is false next tick.
    }

    /** Mutate world state based on the raw command and current input key state. */
    private void applyCommand(String raw) {
        // First handle the known movement and action keys via MockInput.
        if (Gdx.input.isKeyJustPressed(Input.Keys.UP)) {
            tryMove(0, 1);
            return;
        }
