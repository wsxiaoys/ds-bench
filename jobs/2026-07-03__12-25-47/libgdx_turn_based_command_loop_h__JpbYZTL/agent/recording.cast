[492.610995, "o", "import com.badlogic.gdx.ApplicationListener;\r\n\u001b[?2004l\r"]
[492.611019, "o", "\u001b[?2004h> "]
[492.611111, "o", "import com.badlogic.gdx.Gdx;\r\n\u001b[?2004l\r\u001b[?2004h"]
[492.611133, "o", "> "]
[492.611226, "o", "import com.badlogic.gdx.Input;\r\n\u001b[?2004l\r"]
[492.61125, "o", "\u001b[?2004h> "]
[492.611379, "o", "import com.badlogic.gdx.files.FileHandle;\r\n\u001b[?2004l\r"]
[492.611402, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[492.611448, "o", "\u001b[?2004h> "]
[492.61151, "o", "import java.util.ArrayList;\r\n\u001b[?2004l\r"]
[492.611532, "o", "\u001b[?2004h> "]
[492.611598, "o", "import java.util.List;\r\n\u001b[?2004l\r"]
[492.61162, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[492.611667, "o", "\u001b[?2004h> /**\r\n\u001b[?2004l\r\u001b[?2004h> "]
[492.611935, "o", " * Turn-based dungeon crawler core. Drives one turn per render tick, consuming a single\r\n\u001b[?2004l\r"]
[492.611957, "o", "\u001b[?2004h> "]
[492.612248, "o", " * command from the scripted input, mutating the world, and appending a line to the transcript.\r\n\u001b[?2004l\r"]
[492.612275, "o", "\u001b[?2004h>  */\r\n\u001b[?2004l\r"]
[492.612324, "o", "\u001b[?2004h> "]
[492.612473, "o", "public class TurnBasedGame implements ApplicationListener {\r\n\u001b[?2004l\r"]
[492.612497, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[492.612544, "o", "\u001b[?2004h> "]
[492.612636, "o", "    private final FileHandle mapHandle;\r\n\u001b[?2004l\r"]
[492.612658, "o", "\u001b[?2004h> "]
[492.612798, "o", "    private final FileHandle transcriptHandle;\r\n\u001b[?2004l\r"]
[492.612821, "o", "\u001b[?2004h> "]
[492.612968, "o", "    private final ScriptedMockInput scriptedInput;\r\n\u001b[?2004l\r"]
[492.612996, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[492.613048, "o", "\u001b[?2004h> "]
[492.613085, "o", "    // World state\r\n\u001b[?2004l\r\u001b[?2004h"]
[492.613121, "o", "> "]
[492.613167, "o", "    private int width;\r\n\u001b[?2004l\r"]
[492.613187, "o", "\u001b[?2004h> "]
[492.61326, "o", "    private int height;\r\n\u001b[?2004l\r"]
[492.613282, "o", "\u001b[?2004h> "]
[492.613351, "o", "    private int playerX;\r\n\u001b[?2004l\r"]
[492.613372, "o", "\u001b[?2004h> "]
[492.61345, "o", "    private int playerY;\r\n\u001b[?2004l\r"]
[492.613477, "o", "\u001b[?2004h> "]
[492.613654, "o", "    private final List<Item> items = new ArrayList<Item>();\r\n\u001b[?2004l\r"]
[492.613677, "o", "\u001b[?2004h> "]
[492.613877, "o", "    private final List<String> inventory = new ArrayList<String>();\r\n\u001b[?2004l\r"]
[492.6139, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[492.613923, "o", "\u001b[?2004h> "]
[492.613982, "o", "    // Loop state\r\n\u001b[?2004l\r\u001b[?2004h"]
[492.614025, "o", "> "]
[492.61408, "o", "    private int turn = 0;\r\n\u001b[?2004l\r"]
[492.614104, "o", "\u001b[?2004h> "]
[492.614219, "o", "    private boolean shouldExit = false;\r\n\u001b[?2004l\r"]
[492.614241, "o", "\u001b[?2004h> "]
[492.614351, "o", "    private boolean finished = false;\r\n\u001b[?2004l\r"]
[492.614371, "o", "\u001b[?2004h> "]
[492.614486, "o", "    private boolean firstTick = true;\r\n\u001b[?2004l\r\u001b[?2004h"]
[492.614506, "o", "> \r\n\u001b[?2004l\r"]
[492.614559, "o", "\u001b[?2004h> "]
[492.614787, "o", "    /** All transcript content is accumulated here and flushed in {@link #dispose()}. */\r\n\u001b[?2004l\r"]
[492.614808, "o", "\u001b[?2004h> "]
[492.61502, "o", "    private final StringBuilder transcriptBuf = new StringBuilder();\r\n\u001b[?2004l\r"]
[492.615042, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[492.615087, "o", "\u001b[?2004h> "]
[492.6152, "o", "    public TurnBasedGame(FileHandle mapHandle,\r\n\u001b[?2004l\r"]
[492.615221, "o", "\u001b[?2004h> "]
[492.615383, "o", "                         FileHandle transcriptHandle,\r\n\u001b[?2004l\r\u001b[?2004h"]
[492.615424, "o", "> "]
[492.615579, "o", "                         ScriptedMockInput scriptedInput) {\r\n\u001b[?2004l\r"]
[492.6156, "o", "\u001b[?2004h> "]
[492.615709, "o", "        this.mapHandle = mapHandle;\r\n\u001b[?2004l\r"]
[492.615729, "o", "\u001b[?2004h> "]
[492.61588, "o", "        this.transcriptHandle = transcriptHandle;\r\n\u001b[?2004l\r"]
[492.615902, "o", "\u001b[?2004h> "]
[492.616037, "o", "        this.scriptedInput = scriptedInput;\r\n\u001b[?2004l\r"]
[492.61606, "o", "\u001b[?2004h> "]
[492.616108, "o", "    }\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[492.616129, "o", "> "]
[492.616166, "o", "    @Override\r\n\u001b[?2004l\r"]
[492.616198, "o", "\u001b[?2004h> "]
[492.616267, "o", "    public void create() {\r\n\u001b[?2004l\r"]
[492.616289, "o", "\u001b[?2004h> "]
[492.616375, "o", "        loadMap(mapHandle);\r\n\u001b[?2004l\r"]
[492.616397, "o", "\u001b[?2004h> "]
[492.616439, "o", "    }\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[492.616461, "o", "\u001b[?2004h> "]
[492.616599, "o", "    private void loadMap(FileHandle handle) {\r\n\u001b[?2004l\r"]
[492.61662, "o", "\u001b[?2004h> "]
[492.616775, "o", "        String content = handle.readString(\"UTF-8\");\r\n\u001b[?2004l\r"]
[492.616797, "o", "\u001b[?2004h> "]
[492.61696, "o", "        List<String> tokens = new ArrayList<String>();\r\n\u001b[?2004l\r"]
[492.61698, "o", "\u001b[?2004h> "]
[492.617144, "o", "        for (String line : content.split(\"\\n\")) {\r\n\u001b[?2004l\r"]
[492.617164, "o", "\u001b[?2004h> "]
[492.617297, "o", "            int hashIdx = line.indexOf('#');\r\n\u001b[?2004l\r"]
[492.617318, "o", "\u001b[?2004h> "]
[492.617506, "o", "            if (hashIdx >= 0) line = line.substring(0, hashIdx);\r\n\u001b[?2004l\r"]
[492.617529, "o", "\u001b[?2004h> "]
[492.617624, "o", "            line = line.trim();\r\n\u001b[?2004l\r"]
[492.617644, "o", "\u001b[?2004h> "]
[492.61777, "o", "            if (line.isEmpty()) continue;\r\n\u001b[?2004l\r"]
[492.61779, "o", "\u001b[?2004h> "]
[492.617969, "o", "            for (String tok : line.split(\"\\\\s+\")) {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[492.618157, "o", "                if (!tok.isEmpty()) tokens.add(tok);\r\n\u001b[?2004l\r\u001b[?2004h"]
[492.618189, "o", "> "]
[492.618256, "o", "            }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[492.6183, "o", "        }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[492.618428, "o", "        if (tokens.size() < 5) {\r\n\u001b[?2004l\r\u001b[?2004h"]
[492.618458, "o", "> "]
[492.618813, "o", "            throw new IllegalArgumentException(\"Map file too small: \" + tokens.size() + \" tokens\");\r\n\u001b[?2004l\r"]
[492.618841, "o", "\u001b[?2004h> "]
[492.618919, "o", "        }\r\n\u001b[?2004l\r"]
[492.618979, "o", "\u001b[?2004h> "]
[492.619025, "o", "        int idx = 0;\r\n\u001b[?2004l\r\u001b[?2004h> "]
[492.619171, "o", "        width = parseInt(tokens.get(idx++));\r\n\u001b[?2004l\r"]
[492.619197, "o", "\u001b[?2004h> "]
[492.619366, "o", "        height = parseInt(tokens.get(idx++));\r\n\u001b[?2004l\r"]
[492.619404, "o", "\u001b[?2004h> "]
[492.619561, "o", "        playerX = parseInt(tokens.get(idx++));\r\n\u001b[?2004l\r"]
[492.619585, "o", "\u001b[?2004h> "]
[492.619757, "o", "        playerY = parseInt(tokens.get(idx++));\r\n\u001b[?2004l\r"]
[492.619782, "o", "\u001b[?2004h> "]
[492.619974, "o", "        int itemCount = parseInt(tokens.get(idx++));\r\n\u001b[?2004l\r"]
[492.62001, "o", "\u001b[?2004h> "]
[492.620087, "o", "        items.clear();\r\n\u001b[?2004l\r"]
[492.620111, "o", "\u001b[?2004h> "]
[492.620275, "o", "        for (int i = 0; i < itemCount; i++) {\r\n\u001b[?2004l\r"]
[492.620299, "o", "\u001b[?2004h> "]
[492.620474, "o", "            if (idx + 2 >= tokens.size()) break;\r\n\u001b[?2004l\r"]
[492.620497, "o", "\u001b[?2004h> "]
[492.620682, "o", "            int ix = parseInt(tokens.get(idx++));\r\n\u001b[?2004l\r"]
[492.620705, "o", "\u001b[?2004h> "]
[492.620883, "o", "            int iy = parseInt(tokens.get(idx++));\r\n\u001b[?2004l\r"]
[492.620907, "o", "\u001b[?2004h> "]
[492.621094, "o", "            String name = tokens.get(idx++);"]
[492.621201, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[492.621366, "o", "            items.add(new Item(ix, iy, name));\r\n\u001b[?2004l\r"]
[492.621412, "o", "\u001b[?2004h> "]
[492.621437, "o", "        }\r\n\u001b[?2004l\rg\u001b[?2004h"]
[492.621504, "o", ">     }\r\n\u001b[?2004l\r"]
[492.623049, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h>     private static int parseInt(String s) {\r\n\u001b[?2004l\r\u001b[?2004h>         try { return Integer.parseInt(s); }\r\n\u001b[?2004l\r\u001b[?2004h>         catch (NumberFormatException nfe) {\r\n\u001b[?2004l\r\u001b[?2004h>             throw new IllegalArgumentException(\"Not an integer: '\" + s + \"'\", nfe);\r\n\u001b[?2004l\r\u001b[?2004h>         }\r\n\u001b[?2004l\r\u001b[?2004h>     }\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h>     @Override\r\n\u001b[?2004l\r\u001b[?2004h>     public void render() {\r\n\u001b[?2004l\r\u001b[?2004h>         if (finished) return; // don't keep looping after the FINAL line was already written.\r\n\u001b[?2004l\r\u001b[?2004h>         // Drive the scripted input on every tick.\r\n\u001b[?2004l\r\u001b[?2004h>         scriptedInput.tick();\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[492.62312, "o", "        if (firstTick) {\r\n\u001b[?2004l\r\u001b[?2004h"]
[492.624417, "o", ">             firstTick = false;\r\n\u001b[?2004l\r\u001b[?2004h>             if (!scriptedInput.hasCommand()) {\r\n\u001b[?2004l\r\u001b[?2004h>                 finish();\r\n\u001b[?2004l\r\u001b[?2004h>                 return;\r\n\u001b[?2004l\r\u001b[?2004h>             }\r\n\u001b[?2004l\r\u001b[?2004h>         }\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h>         if (!scriptedInput.hasCommand()) {\r\n\u001b[?2004l\r\u001b[?2004h>             finish();\r\n\u001b[?2004l\r\u001b[?2004h>             return;\r\n\u001b[?2004l\r\u001b[?2004h>         }\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h>         String raw = scriptedInput.getCurrentCommand();\r\n\u001b[?2004l\r\u001b[?2004h> "]
[492.624492, "o", "        turn++;\r\n\u001b[?2004l\r\u001b[?2004h"]
[492.624579, "o", "> "]
[492.624646, "o", "        applyCommand(raw);\r\n\u001b[?2004l\r\u001b[?2004h> "]
[492.624701, "o", "        writeTurnLine(raw);\r\n\u001b[?2004l\r"]
[492.62473, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[492.624801, "o", "> "]
[492.62492, "o", "        if (shouldExit || raw.equals(\"QUIT\")) {\r\n\u001b[?2004l\r\u001b[?2004h"]
[492.624964, "o", "> "]
[492.625023, "o", "            finish();\r\n\u001b[?2004l\r\u001b[?2004h"]
[492.625052, "o", "> "]
[492.625107, "o", "            return;\r\n\u001b[?2004l\r"]
[492.625143, "o", "\u001b[?2004h> "]
[492.6252, "o", "        }\r\n\u001b[?2004l\r"]
[492.625229, "o", "\u001b[?2004h> "]
[492.625328, "o", "    }\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[492.625593, "o", "    /** Mutate world state based on the current input key state for the active command. */\r\n\u001b[?2004l\r\u001b[?2004h"]
[492.625615, "o", "> "]
[492.625749, "o", "    private void applyCommand(String raw) {\r\n\u001b[?2004l\r"]
[492.625776, "o", "\u001b[?2004h> "]
[492.625969, "o", "        if (Gdx.input.isKeyJustPressed(Input.Keys.UP)) {\r\n\u001b[?2004l\r"]
[492.62601, "o", "\u001b[?2004h> "]
[492.626093, "o", "            tryMove(0, 1);\r\n\u001b[?2004l\r"]
[492.626121, "o", "\u001b[?2004h> "]
[492.626195, "o", "            return;\r\n\u001b[?2004l\r\u001b[?2004h"]
[492.626238, "o", ">         }\r\n"]
[492.626264, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[492.626475, "o", "        if (Gdx.input.isKeyJustPressed(Input.Keys.DOWN)) {\r\n\u001b[?2004l\r"]
[492.626548, "o", "\u001b[?2004h> "]
[492.626615, "o", "            tryMove(0, -1);\r\n\u001b[?2004l\r\u001b[?2004h> "]
[492.626716, "o", "            return;\r\n\u001b[?2004l\r\u001b[?2004h> "]
[492.626759, "o", "        }\r\n\u001b[?2004l\r"]
[492.626844, "o", "\u001b[?2004h> "]
[492.626982, "o", "        if (Gdx.input.isKeyJustPressed(Input.Keys.RIGHT)) {\r\n\u001b[?2004l\r\u001b[?2004h"]
[492.62706, "o", "> "]
[492.627139, "o", "            tryMove(1, 0);\r\n\u001b[?2004l\r\u001b[?2004h> "]
[492.627212, "o", "            return;\r\n\u001b[?2004l\r\u001b[?2004h"]
[492.627259, "o", "> "]
[492.627318, "o", "        }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[492.627491, "o", "        if (Gdx.input.isKeyJustPressed(Input.Keys.LEFT)) {\r\n\u001b[?2004l\r\u001b[?2004h"]
[492.627539, "o", "> "]
[492.6276, "o", "            tryMove(-1, 0);\r\n\u001b[?2004l\r"]
[492.62763, "o", "\u001b[?2004h> "]
[492.627704, "o", "            return;\r\n\u001b[?2004l\r\u001b[?2004h"]
[492.62775, "o", ">         }\r\n"]
[492.627778, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[492.628006, "o", "        if (Gdx.input.isKeyJustPressed(Input.Keys.SPACE)) {\r\n\u001b[?2004l\r\u001b[?2004h"]
[492.62804, "o", "> "]
[492.628101, "o", "            pickUp();\r\n\u001b[?2004l\r\u001b[?2004h> "]
[492.628153, "o", "            return;\r\n\u001b[?2004l\r"]
[492.628178, "o", "\u001b[?2004h> "]
[492.628205, "o", "        }\r\n\u001b[?2004l\r\u001b[?2004h"]
[492.628232, "o", "> "]
[492.628379, "o", "        if (Gdx.input.isKeyJustPressed(Input.Keys.ESCAPE)) {\r\n\u001b[?2004l\r\u001b[?2004h"]
[492.62842, "o", "> "]
[492.628472, "o", "            shouldExit = true;\r\n\u001b[?2004l\r\u001b[?2004h"]
[492.628512, "o", "> "]
[492.628558, "o", "            return;\r\n\u001b[?2004l\r\u001b[?2004h> "]
[492.628601, "o", "        }\r\n\u001b[?2004l\r\u001b[?2004h"]
[492.628628, "o", "> "]
[492.62874, "o", "        // Unknown command: no state change.\r\n\u001b[?2004l\r\u001b[?2004h"]
[492.628782, "o", ">     }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[492.628826, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[492.628927, "o", "    private void tryMove(int dx, int dy) {\r\n\u001b[?2004l\r"]
[492.628952, "o", "\u001b[?2004h> "]
[492.629038, "o", "        int nx = playerX + dx;\r\n\u001b[?2004l\r\u001b[?2004h"]
[492.629084, "o", "> "]
[492.629139, "o", "        int ny = playerY + dy;\r\n\u001b[?2004l\r"]
[492.62918, "o", "\u001b[?2004h> "]
[492.629326, "o", "        if (nx < 0 || nx >= width || ny < 0 || ny >= height) {\r\n\u001b[?2004l\r"]
[492.629366, "o", "\u001b[?2004h> "]
[492.629471, "o", "            return; // rejected: stay in place.\r\n\u001b[?2004l\r\u001b[?2004h"]
[492.629512, "o", ">         }\r\n\u001b[?2004l\r"]
[492.629551, "o", "\u001b[?2004h> "]
[492.629595, "o", "        playerX = nx;\r\n\u001b[?2004l\r\u001b[?2004h"]
[492.629636, "o", "> "]
[492.629676, "o", "        playerY = ny;\r\n\u001b[?2004l\r\u001b[?2004h"]
[492.629714, "o", ">     }\r\n\u001b[?2004l\r\u001b[?2004h"]
[492.629751, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[492.629822, "o", "    private void pickUp() {\r\n\u001b[?2004l\r"]
[492.629846, "o", "\u001b[?2004h> "]
[492.629968, "o", "        for (int i = 0; i < items.size(); i++) {\r\n\u001b[?2004l\r\u001b[?2004h"]
[492.630018, "o", "> "]
[492.630078, "o", "            Item it = items.get(i);\r\n\u001b[?2004l\r"]
[492.630114, "o", "\u001b[?2004h> "]
[492.630237, "o", "            if (it.x == playerX && it.y == playerY) {\r\n\u001b[?2004l\r\u001b[?2004h"]
[492.63027, "o", "> "]
[492.630353, "o", "                inventory.add(it.name);\r\n\u001b[?2004l\r\u001b[?2004h"]
[492.630399, "o", "> "]
[492.630451, "o", "                items.remove(i);\r\n\u001b[?2004l\r\u001b[?2004h"]
[492.630488, "o", "> "]
[492.630529, "o", "                return;\r\n\u001b[?2004l\r"]
[492.630553, "o", "\u001b[?2004h> "]
[492.630608, "o", "            }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[492.630636, "o", "        }\r\n\u001b[?2004l\r\u001b[?2004h"]
[492.630657, "o", ">     }\r\n\u001b[?2004l\r"]
[492.630687, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[492.630711, "o", "\u001b[?2004h> "]
