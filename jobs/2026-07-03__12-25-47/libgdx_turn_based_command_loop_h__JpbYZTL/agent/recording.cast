[133.630873, "o", "\u001b[?2004h> "]
[133.630944, "o", "        tickRequested = true;\r\n\u001b[?2004l\r\u001b[?2004h"]
[133.631017, "o", "> "]
[133.631077, "o", "        if (index >= commands.size()) {\r\n\u001b[?2004l\r\u001b[?2004h"]
[133.631131, "o", "> "]
