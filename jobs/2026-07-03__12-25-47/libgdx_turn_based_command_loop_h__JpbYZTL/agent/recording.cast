[152.054656, "o", "> "]
[152.054906, "o", "        // Write the transcript in one shot to avoid partial writes being visible.\r\n\u001b[?2004l\r\u001b[?2004h"]
[152.054949, "o", "> "]
[152.055196, "o", "        transcriptHandle.writeString(transcriptBuf.toString(), false, \"UTF-8\");\r\n\u001b[?2004l\r\u001b[?2004h"]
[152.055239, "o", ">     }\r\n\u001b[?2004l\r\u001b[?2004h"]
[152.055284, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
