[133.625209, "i", "cat > /home/user/turn-based-game/core/src/main/java/game/ScriptedMockInput.java << 'EOF'\npackage game;\n\nimport com.badlogic.gdx.Input;\nimport com.badlogic.gdx.backends.headless.mock.input.MockInput;\n\nimport java.util.ArrayList;\nimport java.util.List;\n\n/**\n * ScriptedMockInput exposes a queue of commands to the ApplicationListener one per tick.\n * Each call to {@link #tick()} advances the queue and registers the appropriate\n * keycode(s) with the headless MockInput so that the listener can read them via\n * {@link #isKeyJustPressed(int)} / {@link #isKeyPressed(int)}.\n */\npublic class ScriptedMockInput extends MockInput {\n\n    /** Per-tick active keys (cleared at next tick). */\n    private final List<Integer> activeKeys = new ArrayList<Integer>();\n\n    /** Flags consumed once (per \"just pressed\" semantics). */\n    private final List<Integer> justPressedKeys = new ArrayList<Integer>();\n\n    private final List<String> commands;\n    private int index = 0;\n    private boolean tickRequested = false;\n    private String currentCommand;\n\n    public ScriptedMockInput(List<String> commands) {\n        this.commands = new ArrayList<String>(commands);\n    }\n\n    /** Returns the current raw command for this tick (may be null if the queue is empty). */\n    public String getCurrentCommand() {\n        return currentCommand;\n    }\n\n    /** True if the current tick has a queued command. */\n    public boolean hasCommand() {\n        return currentCommand != null;\n    }\n\n    /**\n     * Advance the queue by one tick. The next command is now exposed via\n     * {@link #getCurrentCommand()} and the corresponding keycodes via\n     * {@link #isKeyPressed(int)} / {@link #isKeyJustPressed(int)}.\n     */\n    public void tick() {\n        tickRequested = true;\n        if (index >= commands.size()) {\n            currentCommand = null;\n            activeKeys.clear();\n            justPressedKeys.clear();\n            return;\n        }\n        currentCommand = commands.get(index++);\n        activeKeys.clear();\n        justPressedKeys.clear();\n        int key = keyFor(currentCommand);\n        if (key != -1) {\n            activeKeys.add(key);\n            justPressedKeys.add(key);\n        }\n    }\n\n    /** Whether {@link #tick()} has been called at least once since construction. */\n    public boolean wasTickRequested() {\n        return tickRequested;\n    }\n\n    private static int keyFor(String cmd) {\n        if (cmd == null) return -1;\n        if (cmd.equals(\"N\")) return Input.Keys.UP;\n        if (cmd.equals(\"S\")) return Input.Keys.DOWN;\n        if (cmd.equals(\"E\")) return Input.Keys.RIGHT;\n        if (cmd.equals(\"W\")) return Input.Keys.LEFT;\n        if (cmd.equals(\"PICK\")) return Input.Keys.SPACE;\n        if (cmd.equals(\"QUIT\")) return Input.Keys.ESCAPE;\n        return -1;\n    }\n\n    @Override\n    public boolean isKeyPressed(int key) {\n        for (int i = 0; i < activeKeys.size(); i++) {\n            if (activeKeys.get(i) == key) return true;\n        }\n        return false;\n    }\n\n    @Override\n    public boolean isKeyJustPressed(int key) {\n        for (int i = 0; i < justPressedKeys.size(); i++) {\n            if (justPressedKeys.get(i) == key) return true;\n        }\n        return false;\n    }\n}\nEOF\n"]
