[151.979831, "o", "    /** Loads the map file using libGDX FileHandle parsing. */\r\n\u001b[?2004l\r"]
[151.979902, "o", "\u001b[?2004h> "]
[151.980169, "o", "    private void loadMap(FileHandle handle) {\r\n\u001b[?2004l\r"]
[151.980249, "o", "\u001b[?2004h> "]
[151.980545, "o", "        String content = handle.readString(\"UTF-8\");\r\n\u001b[?2004l\r"]
[151.980625, "o", "\u001b[?2004h> "]
[151.980928, "o", "        List<String> tokens = new ArrayList<String>();\r\n\u001b[?2004l\r"]
[151.981013, "o", "\u001b[?2004h> "]
[151.981289, "o", "        for (String line : content.split(\"\\n\")) {\r\n\u001b[?2004l\r"]
[151.981369, "o", "\u001b[?2004h> "]
[151.981843, "o", "            // Strip comments; ignore blank lines; keep tokens inside useful lines.\r\n\u001b[?2004l\r"]
[151.981925, "o", "\u001b[?2004h> "]
[151.982199, "o", "            int hashIdx = line.indexOf('#');\r\n\u001b[?2004l\r"]
[151.982269, "o", "\u001b[?2004h> "]
[151.98264, "o", "            if (hashIdx >= 0) line = line.substring(0, hashIdx);\r\n\u001b[?2004l\r"]
[151.982723, "o", "\u001b[?2004h> "]
[151.982893, "o", "            line = line.trim();\r\n\u001b[?2004l\r"]
[151.982965, "o", "\u001b[?2004h> "]
[151.983209, "o", "            if (line.isEmpty()) continue;\r\n\u001b[?2004l\r"]
[151.983282, "o", "\u001b[?2004h> "]
[151.983572, "o", "            for (String tok : line.split(\"\\\\s+\")) {\r\n\u001b[?2004l\r"]
[151.983652, "o", "\u001b[?2004h> "]
[151.983942, "o", "                if (!tok.isEmpty()) tokens.add(tok);\r\n\u001b[?2004l\r"]
[151.984027, "o", "\u001b[?2004h> "]
[151.984095, "o", "            }\r\n\u001b[?2004l\r"]
[151.984158, "o", "\u001b[?2004h> "]
[151.984226, "o", "        }\r\n\u001b[?2004l\r"]
[151.984301, "o", "\u001b[?2004h> "]
[151.984481, "o", "        if (tokens.size() < 4) {\r\n\u001b[?2004l\r"]
[151.984553, "o", "\u001b[?2004h> "]
[151.985125, "o", "            throw new IllegalArgumentException(\"Map file too small: \" + tokens.size() + \" tokens\");\r\n\u001b[?2004l\r"]
[151.985211, "o", "\u001b[?2004h> "]
[151.985275, "o", "        }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[151.985435, "o", "        int idx = 0;\r\n\u001b[?2004l\r"]
[151.985496, "o", "\u001b[?2004h> "]
[151.98582, "o", "        width = parseInt(tokens.get(idx++));\r\n\u001b[?2004l\r"]
[151.985888, "o", "\u001b[?2004h> "]
[151.98623, "o", "        height = parseInt(tokens.get(idx++));\r\n\u001b[?2004l\r"]
[151.9863, "o", "\u001b[?2004h> "]
[151.986641, "o", "        playerX = parseInt(tokens.get(idx++));\r\n\u001b[?2004l\r"]
[151.986706, "o", "\u001b[?2004h> "]
[151.987059, "o", "        playerY = parseInt(tokens.get(idx++));\r\n\u001b[?2004l\r"]
[151.987131, "o", "\u001b[?2004h> "]
[151.987512, "o", "        int itemCount = parseInt(tokens.get(idx++));\r\n\u001b[?2004l\r"]
[151.987587, "o", "\u001b[?2004h> "]
[151.987743, "o", "        items.clear();\r\n\u001b[?2004l\r"]
[151.987803, "o", "\u001b[?2004h> "]
[151.988169, "o", "        for (int i = 0; i < itemCount; i++) {\r\n\u001b[?2004l\r\u001b[?2004h"]
[151.988253, "o", "> "]
[151.988591, "o", "            if (idx + 2 >= tokens.size()) break;\r\n\u001b[?2004l\r\u001b[?2004h"]
[151.988669, "o", "> "]
[151.989011, "o", "            int ix = parseInt(tokens.get(idx++));\r\n\u001b[?2004l\r"]
[151.989074, "o", "\u001b[?2004h> "]
[151.989438, "o", "            int iy = parseInt(tokens.get(idx++));\r\n\u001b[?2004l\r"]
[151.989507, "o", "\u001b[?2004h> "]
[151.989837, "o", "            String name = tokens.get(idx++);\r\n\u001b[?2004l\r"]
[151.989903, "o", "\u001b[?2004h> "]
[151.990282, "o", "            items.add(new Item(ix, iy, name));\r\n\u001b[?2004l\r\u001b[?2004h"]
[151.990377, "o", "> "]
[151.990467, "o", "        }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[151.990533, "o", "    }\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[151.990596, "o", "\u001b[?2004h> "]
[151.990937, "o", "    private static int parseInt(String s) {\r\n\u001b[?2004l\r"]
[151.991098, "o", "\u001b[?2004h> "]
[151.991331, "o", "        try { return Integer.parseInt(s); }\r\n\u001b[?2004l\r"]
[151.991392, "o", "\u001b[?2004h> "]
[151.991721, "o", "        catch (NumberFormatException nfe) {\r\n\u001b[?2004l\r"]
[151.991763, "o", "\u001b[?2004h> "]
[151.99235, "o", "            throw new IllegalArgumentException(\"Not an integer: '\" + s + \"'\", nfe);\r\n\u001b[?2004l\r"]
[151.992421, "o", "\u001b[?2004h> "]
[151.992474, "o", "        }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[151.992619, "o", "    }\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[151.992706, "o", "    @Override\r\n\u001b[?2004l\r"]
[151.992752, "o", "\u001b[?2004h> "]
[151.992919, "o", "    public void render() {\r\n\u001b[?2004l\r"]
[151.992963, "o", "\u001b[?2004h> "]
[151.993269, "o", "        // Drive the scripted input on every tick.\r\n\u001b[?2004l\r"]
[151.993352, "o", "\u001b[?2004h> "]
[151.993503, "o", "        scriptedInput.tick();\r\n\u001b[?2004l\r"]
[151.993571, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[151.993734, "o", "        if (firstTick) {\r\n\u001b[?2004l\r"]
[151.993797, "o", "\u001b[?2004h> "]
[151.993966, "o", "            firstTick = false;\r\n\u001b[?2004l\r"]
[151.994048, "o", "\u001b[?2004h> "]
[151.994483, "o", "            // Wait until the first real command before writing any turn lines.\r\n\u001b[?2004l\r"]
[151.994567, "o", "\u001b[?2004h> "]
[151.994797, "o", "            if (!scriptedInput.hasCommand()) {\r\n\u001b[?2004l\r"]
[151.99487, "o", "\u001b[?2004h> "]
[151.995219, "o", "                // No commands at all: write FINAL and exit.\r\n\u001b[?2004l\r"]
[151.995294, "o", "\u001b[?2004h> "]
[151.995414, "o", "                finish();\r\n\u001b[?2004l\r"]
[151.995492, "o", "\u001b[?2004h> "]
[151.995614, "o", "                return;\r\n\u001b[?2004l\r\u001b[?2004h"]
[151.995697, "o", "> "]
[151.995781, "o", "            }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[151.995862, "o", "        }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[151.995941, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[151.996192, "o", "        if (!scriptedInput.hasCommand()) {\r\n\u001b[?2004l\r\u001b[?2004h"]
[151.996272, "o", "> "]
[151.996368, "o", "            finish();\r\n\u001b[?2004l\r\u001b[?2004h"]
[151.996446, "o", "> "]
[151.996526, "o", "            return;\r\n\u001b[?2004l\r"]
[151.996607, "o", "\u001b[?2004h> "]
[151.99669, "o", "        }\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[151.996764, "o", "> "]
[151.997108, "o", "        String raw = scriptedInput.getCurrentCommand();\r\n\u001b[?2004l\r"]
[151.997151, "o", "\u001b[?2004h> "]
[151.997273, "o", "        turn++;\r\n\u001b[?2004l\r"]
[151.997335, "o", "\u001b[?2004h> "]
[151.997515, "o", "        applyCommand(raw);\r\n\u001b[?2004l\r"]
[151.997574, "o", "\u001b[?2004h> "]
[151.997775, "o", "        writeTurnLine(raw);\r\n\u001b[?2004l\r"]
[151.99784, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[151.9979, "o", "\u001b[?2004h> "]
[151.998344, "o", "        if (shouldExit || raw.equals(\"QUIT\")) {\r\n\u001b[?2004l\r"]
[151.998387, "o", "\u001b[?2004h> "]
[151.998607, "o", "            finish();\r\n\u001b[?2004l\r"]
[151.998667, "o", "\u001b[?2004h> "]
[151.998794, "o", "            return;\r\n\u001b[?2004l\r"]
[151.998854, "o", "\u001b[?2004h> "]
[151.998924, "o", "        }\r\n\u001b[?2004l\r"]
[151.999141, "o", "\u001b[?2004h> "]
[151.9996, "o", "        // Loop ends when command file is exhausted: scriptedInput.hasCommand() is false next tick.\r\n\u001b[?2004l\r"]
[151.999643, "o", "\u001b[?2004h> "]
[151.999731, "o", "    }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[151.999795, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[152.000338, "o", "    /** Mutate world state based on the raw command and current input key state. */\r\n\u001b[?2004l\r"]
[152.000383, "o", "\u001b[?2004h> "]
[152.000656, "o", "    private void applyCommand(String raw) {\r\n\u001b[?2004l\r"]
[152.000698, "o", "\u001b[?2004h> "]
[152.001175, "o", "        // First handle the known movement and action keys via MockInput.\r\n\u001b[?2004l\r"]
[152.001244, "o", "\u001b[?2004h> "]
[152.001582, "o", "        if (Gdx.input.isKeyJustPressed(Input.Keys.UP)) {\r\n\u001b[?2004l\r"]
[152.001624, "o", "\u001b[?2004h> "]
[152.001812, "o", "            tryMove(0, 1);\r\n\u001b[?2004l\r"]
[152.001878, "o", "\u001b[?2004h> "]
[152.002007, "o", "            return;\r\n\u001b[?2004l\r"]
[152.002072, "o", "\u001b[?2004h> "]
[152.002139, "o", "        }\r\n\u001b[?2004l\r"]
[152.002213, "o", "\u001b[?2004h> "]
[152.002561, "o", "        if (Gdx.input.isKeyJustPressed(Input.Keys.DOWN)) {\r\n\u001b[?2004l\r"]
[152.002624, "o", "\u001b[?2004h> "]
[152.002788, "o", "            tryMove(0, -1);\r\n\u001b[?2004l\r"]
[152.002853, "o", "\u001b[?2004h> "]
[152.002979, "o", "            return;\r\n\u001b[?2004l\r"]
[152.003051, "o", "\u001b[?2004h> "]
[152.003117, "o", "        }\r\n\u001b[?2004l\r"]
[152.003178, "o", "\u001b[?2004h> "]
[152.003542, "o", "        if (Gdx.input.isKeyJustPressed(Input.Keys.RIGHT)) {\r\n\u001b[?2004l\r"]
[152.003584, "o", "\u001b[?2004h> "]
[152.003772, "o", "            tryMove(1, 0);\r\n\u001b[?2004l\r"]
[152.003833, "o", "\u001b[?2004h> "]
[152.003959, "o", "            return;\r\n\u001b[?2004l\r"]
[152.004034, "o", "\u001b[?2004h> "]
[152.004097, "o", "        }\r\n\u001b[?2004l\r"]
[152.004157, "o", "\u001b[?2004h> "]
[152.00452, "o", "        if (Gdx.input.isKeyJustPressed(Input.Keys.LEFT)) {\r\n\u001b[?2004l\r"]
[152.004589, "o", "\u001b[?2004h> "]
[152.004754, "o", "            tryMove(-1, 0);\r\n\u001b[?2004l\r"]
[152.004798, "o", "\u001b[?2004h> "]
[152.004945, "o", "            return;\r\n\u001b[?2004l\r"]
[152.00502, "o", "\u001b[?2004h> "]
[152.005083, "o", "        }\r\n\u001b[?2004l\r"]
[152.005142, "o", "\u001b[?2004h> "]
[152.005507, "o", "        if (Gdx.input.isKeyJustPressed(Input.Keys.SPACE)) {\r\n\u001b[?2004l\r"]
[152.005549, "o", "\u001b[?2004h> "]
[152.005708, "o", "            pickUp();\r\n\u001b[?2004l\r"]
[152.005778, "o", "\u001b[?2004h> "]
[152.005897, "o", "            return;\r\n\u001b[?2004l\r"]
[152.005958, "o", "\u001b[?2004h> "]
[152.006034, "o", "        }\r\n\u001b[?2004l\r"]
[152.006096, "o", "\u001b[?2004h> "]
[152.006465, "o", "        if (Gdx.input.isKeyJustPressed(Input.Keys.ESCAPE)) {\r\n\u001b[?2004l\r"]
[152.006524, "o", "\u001b[?2004h> "]
[152.006725, "o", "            shouldExit = true;\r\n\u001b[?2004l\r"]
[152.006805, "o", "\u001b[?2004h> "]
[152.006915, "o", "            return;\r\n\u001b[?2004l\r"]
[152.007136, "o", "\u001b[?2004h> "]
[152.007231, "o", "        }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[152.007359, "o", "        // Unknown command: no state change.\r\n\u001b[?2004l\r"]
[152.00744, "o", "\u001b[?2004h>     }\r\n"]
[152.007519, "o", "\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[152.007601, "o", "\u001b[?2004h> "]
[152.007844, "o", "    private void tryMove(int dx, int dy) {\r\n\u001b[?2004l\r"]
[152.007923, "o", "\u001b[?2004h> "]
[152.008108, "o", "        int nx = playerX + dx;\r\n\u001b[?2004l\r"]
[152.044651, "o", "\u001b[?2004h>         int ny = playerY + dy;\r\n\u001b[?2004l\r\u001b[?2004h>         if (nx < 0 || nx >= width || ny < 0 || ny >= height) {\r\n\u001b[?2004l\r\u001b[?2004h>             // Rejected: stay in place.\r\n\u001b[?2004l\r\u001b[?2004h>             return;\r\n\u001b[?2004l\r\u001b[?2004h>         }\r\n\u001b[?2004l\r\u001b[?2004h>         playerX = nx;\r\n\u001b[?2004l\r\u001b[?2004h>         playerY = ny;\r\n\u001b[?2004l\r\u001b[?2004h>     }\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h>     /** Pick the earliest-defined item at the current cell; remove from world; add to inventory. */\r\n\u001b[?2004l\r\u001b[?2004h>     private void pickUp() {\r\n\u001b[?2004l\r\u001b[?2004h>         for (int i = 0; i < items.size(); i++) {\r\n\u001b[?2004l\r\u001b[?2004h>             Item it = items.get(i);\r\n\u001b[?2004l\r\u001b[?2004h> "]
[152.047268, "o", "            if (it.x == playerX && it.y == playerY) {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[152.047503, "o", "                inventory.add(it.name);\r\n\u001b[?2004l\r\u001b[?2004h> "]
[152.047566, "o", "                items.remove(i);\r\n\u001b[?2004l\r\u001b[?2004h> "]
[152.047683, "o", "                return;\r\n\u001b[?2004l\r\u001b[?2004h"]
[152.048386, "o", ">             }\r\n\u001b[?2004l\r\u001b[?2004h>         }\r\n\u001b[?2004l\r\u001b[?2004h>         // No item here: no-op.\r\n\u001b[?2004l\r\u001b[?2004h>     }\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h>     /** Append a turn line to the transcript using FileHandle.appendString. */\r\n\u001b[?2004l\r\u001b[?2004h> "]
[152.048475, "o", "    private void writeTurnLine(String raw) {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[152.048638, "o", "        StringBuilder sb = new StringBuilder(32);\r\n\u001b[?2004l\r\u001b[?2004h> "]
[152.048796, "o", "        sb.append(\"turn=\").append(turn)\r\n\u001b[?2004l\r\u001b[?2004h"]
[152.048844, "o", "> "]
[152.048954, "o", "          .append(\" cmd=\").append(raw)\r\n\u001b[?2004l\r\u001b[?2004h"]
[152.049049, "o", "> "]
[152.049223, "o", "          .append(\" pos=\").append(playerX).append(',').append(playerY)\r\n\u001b[?2004l\r\u001b[?2004h"]
[152.049266, "o", "> "]
[152.049349, "o", "          .append(\" inv=\");\r\n\u001b[?2004l\r\u001b[?2004h"]
[152.049393, "o", "> "]
[152.049552, "o", "        for (int i = 0; i < inventory.size(); i++) {\r\n\u001b[?2004l\r\u001b[?2004h"]
[152.049594, "o", "> "]
[152.049709, "o", "            if (i > 0) sb.append(',');\r\n\u001b[?2004l\r\u001b[?2004h"]
[152.049753, "o", "> "]
[152.049875, "o", "            sb.append(inventory.get(i));\r\n\u001b[?2004l\r\u001b[?2004h"]
[152.049917, "o", ">         }\r\n\u001b[?2004l\r"]
[152.050002, "o", "\u001b[?2004h> "]
[152.050077, "o", "        sb.append('\\n');\r\n\u001b[?2004l\r\u001b[?2004h"]
[152.050122, "o", "> "]
[152.050233, "o", "        appendToTranscript(sb.toString());\r\n\u001b[?2004l\r\u001b[?2004h"]
[152.050278, "o", ">     }\r\n\u001b[?2004l\r\u001b[?2004h"]
[152.050359, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[152.050561, "o", "    /** Append the FINAL line and call {@link Gdx#app#exit()}. */\r\n\u001b[?2004l\r\u001b[?2004h"]
[152.050604, "o", "> "]
[152.050687, "o", "    private void finish() {\r\n\u001b[?2004l\r\u001b[?2004h"]
[152.05073, "o", "> "]
[152.05088, "o", "        StringBuilder sb = new StringBuilder(32);\r\n\u001b[?2004l\r\u001b[?2004h"]
[152.050923, "o", "> "]
[152.051224, "o", "        sb.append(\"FINAL pos=\").append(playerX).append(',').append(playerY).append(\" inv=\");\r\n\u001b[?2004l\r"]
[152.051268, "o", "\u001b[?2004h> "]
[152.051434, "o", "        for (int i = 0; i < inventory.size(); i++) {\r\n\u001b[?2004l\r\u001b[?2004h"]
[152.051475, "o", "> "]
[152.051592, "o", "            if (i > 0) sb.append(',');\r\n\u001b[?2004l\r\u001b[?2004h"]
[152.051633, "o", "> "]
[152.051756, "o", "            sb.append(inventory.get(i));\r\n\u001b[?2004l\r\u001b[?2004h"]
[152.051798, "o", ">         }\r\n\u001b[?2004l\r"]
[152.051875, "o", "\u001b[?2004h> "]
[152.052041, "o", "        sb.append(\" turns=\").append(turn).append('\\n');\r\n\u001b[?2004l\r\u001b[?2004h> "]
[152.052201, "o", "        appendToTranscript(sb.toString());\r\n\u001b[?2004l\r\u001b[?2004h"]
[152.052242, "o", "> "]
[152.052493, "o", "        // Allow the next render tick to actually exit the headless loop cleanly.\r\n\u001b[?2004l\r\u001b[?2004h"]
[152.052535, "o", "> "]
[152.052611, "o", "        Gdx.app.exit();\r\n\u001b[?2004l\r\u001b[?2004h> "]
[152.052657, "o", "    }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[152.052732, "o", "\r\n\u001b[?2004l\r\u001b[?2004h>     /**\r\n\u001b[?2004l\r\u001b[?2004h"]
[152.052778, "o", "> "]
[152.053056, "o", "     * All transcript appends use libGDX FileHandle so the file is flushed via the\r\n\u001b[?2004l\r\u001b[?2004h> "]
[152.053367, "o", "     * Gdx.files subsystem. We accumulate into a single string and write atomically at the end.\r\n\u001b[?2004l\r\u001b[?2004h"]
[152.053406, "o", ">      */\r\n\u001b[?2004l\r"]
[152.053505, "o", "\u001b[?2004h> "]
[152.053672, "o", "    private final StringBuilder transcriptBuf = new StringBuilder();\r\n\u001b[?2004l\r\u001b[?2004h"]
[152.053714, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[152.053897, "o", "    private void appendToTranscript(String line) {\r\n\u001b[?2004l\r\u001b[?2004h"]
[152.053943, "o", "> "]
