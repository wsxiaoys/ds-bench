[133.631597, "o", "\u001b[?2004h> "]
[133.631644, "o", "        currentCommand = commands.get(index++);\r\n\u001b[?2004l\r"]
[133.631666, "o", "\u001b[?2004h> "]
[133.631738, "o", "        activeKeys.clear();\r\n\u001b[?2004l\r"]
[133.631791, "o", "\u001b[?2004h> "]
