[456.671191, "o", "        scriptedInput.tick();\r\n\r\n        if (firstTick) {\r\n            firstTick = false;\r\n            // Wait until the first real command before writing any turn lines.\r\n            if (!scriptedInput.hasCommand()) {\r\n                // No commands at all: write FINAL and exit.\r\n                finish();\r\n                return;\r\n            }\r\n        }\r\n\r\n        if (!scriptedInput.hasCommand()) {\r\n            finish();\r\n            return;\r\n        }\r\n\r\n        String raw = scriptedInput.getCurrentCommand();\r\n        turn++;\r\n        applyCommand(raw);\r\n        writeTurnLine(raw);\r\n\r\n        if (shouldExit || raw.equals(\"QUIT\")) {\r\n            finish();\r\n            return;\r\n        }\r\n        // Loop ends when command file is exhausted: scriptedInput.hasCommand() is false next tick.\r\n    }\r\n\r\n    /** Mutate world state based on the raw command and current input key state. */\r\n"]
[456.671242, "o", "    private void applyCommand(String raw) {\r\n        // First handle the known movement and action keys via MockInput.\r\n        if (Gdx.input.isKeyJustPressed(Input.Keys.UP)) {\r\n            tryMove(0, 1);\r\n            return;\r\n        }\r\n"]
