[133.634142, "o", "> "]
[133.63423, "o", "        return -1;\r\n\u001b[?2004l\r\u001b[?2004h>     }\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[133.634281, "o", "\u001b[?2004h> "]
[133.634301, "o", "    @Override\r\n\u001b[?2004l\r\u001b[?2004h> "]
[133.634418, "o", "    public boolean isKeyPressed(int key) {\r\n\u001b[?2004l\r"]
[133.634466, "o", "\u001b[?2004h> "]
[133.634567, "o", "        for (int i = 0; i < activeKeys.size(); i++) {\r\n\u001b[?2004l\r"]
[133.634591, "o", "\u001b[?2004h> "]
[133.634727, "o", "            if (activeKeys.get(i) == key) return true;\r\n\u001b[?2004l\r"]
[133.634751, "o", "\u001b[?2004h> "]
[133.634771, "o", "        }\r\n\u001b[?2004l\r"]
[133.634828, "o", "\u001b[?2004h> "]
