[133.631993, "o", "\u001b[?2004h> "]
[133.632103, "o", "        if (key != -1) {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[133.63216, "o", "            activeKeys.add(key);\r\n\u001b[?2004l\r"]
[133.632205, "o", "\u001b[?2004h> "]
[133.632275, "o", "            justPressedKeys.add(key);\r\n\u001b[?2004l\r"]
[133.632321, "o", "\u001b[?2004h> "]
[133.632375, "o", "        }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[133.632429, "o", "    }\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[133.632611, "o", "    /** Whether {@link #tick()} has been called at least once since construction. */\r\n\u001b[?2004l\r"]
[133.632632, "o", "\u001b[?2004h> "]
[133.632731, "o", "    public boolean wasTickRequested() {\r\n\u001b[?2004l\r"]
[133.632776, "o", "\u001b[?2004h> "]
[133.632828, "o", "        return tickRequested;\r\n\u001b[?2004l\r\u001b[?2004h"]
[133.632873, "o", "> "]
[133.632895, "o", "    }\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[133.632961, "o", "> "]
[133.633031, "o", "    private static int keyFor(String cmd) {\r\n\u001b[?2004l\r\u001b[?2004h"]
[133.633054, "o", "> "]
[133.633146, "o", "        if (cmd == null) return -1;\r\n\u001b[?2004l\r"]
[133.633193, "o", "\u001b[?2004h> "]
[133.63332, "o", "        if (cmd.equals(\"N\")) return Input.Keys.UP;\r\n\u001b[?2004l\r"]
[133.633366, "o", "\u001b[?2004h> "]
[133.633487, "o", "        if (cmd.equals(\"S\")) return Input.Keys.DOWN;\r\n\u001b[?2004l\r"]
[133.633532, "o", "\u001b[?2004h> "]
[133.633636, "o", "        if (cmd.equals(\"E\")) return Input.Keys.RIGHT;\r\n\u001b[?2004l\r"]
[133.633659, "o", "\u001b[?2004h> "]
[133.63379, "o", "        if (cmd.equals(\"W\")) return Input.Keys.LEFT;\r\n\u001b[?2004l\r\u001b[?2004h"]
[133.633814, "o", "> "]
