[133.630154, "o", "    /**\r\n\u001b[?2004l\r\u001b[?2004h> "]
[133.630321, "o", "     * Advance the queue by one tick. The next command is now exposed via\r\n\u001b[?2004l\r"]
[133.630369, "o", "\u001b[?2004h> "]
[133.630511, "o", "     * {@link #getCurrentCommand()} and the corresponding keycodes via\r\n\u001b[?2004l\r"]
[133.630556, "o", "\u001b[?2004h> "]
