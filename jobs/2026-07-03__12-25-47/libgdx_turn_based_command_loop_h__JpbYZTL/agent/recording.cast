[133.631237, "o", "> "]
[133.63129, "o", "            activeKeys.clear();\r\n\u001b[?2004l\r\u001b[?2004h"]
[133.631343, "o", "> "]
[133.631393, "o", "            justPressedKeys.clear();\r\n\u001b[?2004l\r\u001b[?2004h> "]
[133.631451, "o", "            return;\r\n\u001b[?2004l\r"]
[133.631474, "o", "\u001b[?2004h> "]
