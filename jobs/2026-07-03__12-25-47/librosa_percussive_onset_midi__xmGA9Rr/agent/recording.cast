[239.03564, "o", "    assert h['velocity'] > 0.0 and h['velocity'] <= 1.0, f\"Hit {i} velocity out of range: {h['velocity']}\"\r\n\u001b[?2004l\r\u001b[?2004h> "]
[239.035729, "o", "# Check ordering\r\n\u001b[?2004l\r\u001b[?2004h> "]
[239.035828, "o", "times = [h['time_seconds'] for h in d]\r\n\u001b[?2004l\r\u001b[?2004h> "]
