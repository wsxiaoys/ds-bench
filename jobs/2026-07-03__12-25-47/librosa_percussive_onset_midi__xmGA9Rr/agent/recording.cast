[163.940431, "i", "python3 << 'EOF'\nimport librosa\nimport numpy as np\ny, sr = librosa.load('/home/user/input.wav', sr=None)\ny_perc, _ = librosa.effects.hpss(y)\nhop_length = 512\noe = librosa.onset.onset_strength(y=y_perc, sr=sr, hop_length=hop_length)\n\n# Get onset times\nov = librosa.onset.onset_detect(onset_envelope=oe, sr=sr, hop_length=hop_length, units='frames')\not = librosa.frames_to_time(ov, sr=sr, hop_length=hop_length)\nprint(\"First 30 onset times:\")\nfor t in ot[:30]:\n    print(f\"  {t:.4f}\")\n\n# Compute intervals\nintervals = np.diff(ot)\nprint(f\"\\nMin interval: {intervals.min():.4f}, Max: {intervals.max():.4f}, Mean: {intervals.mean():.4f}\")\nprint(f\"Median interval: {np.median(intervals):.4f}\")\n\n# Autocorrelation of onset envelope\nfrom scipy.signal import find_peaks\nac = librosa.feature.tempogram(onset_envelope=oe, sr=sr, hop_length=hop_length)\nmean_ac = ac.mean(axis=1)\nbpm_axis = librosa.tempo_frequencies(mean_ac.shape[0], sr=sr, hop_length=hop_length)\n# Find peaks in REDACTEDcorrelation\npeaks, _ = find_peaks(mean_ac, height=0)\nif len(peaks) > 0:\n    # Get top peaks\n    sorted_idx = np.argsort(mean_ac[peaks])[::-1][:10]\n    top_peaks = peaks[sorted_idx]\n    print(\"\\nTop REDACTEDcorrelation peaks (BPM, AC value):\")\n    for p in top_peaks:\n        print(f\"  BPM={bpm_axis[p]:.2f}, AC={mean_ac[p]:.3f}\")\nEOF\n"]
