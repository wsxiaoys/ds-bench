[123.727834, "i", "python3 << 'EOF'\nimport librosa\nimport numpy as np\ny, sr = librosa.load('/home/user/input.wav', sr=None)\ny_perc, _ = librosa.effects.hpss(y)\n# Try with default\ntempo1, _ = librosa.beat.beat_track(y=y_perc, sr=sr)\ntempo2, _ = librosa.beat.beat_track(y=y_perc, sr=sr, start_bpm=120.0)\ntempo3, _ = librosa.beat.beat_track(y=y_perc, sr=sr, start_bpm=120.0, tightness=200)\nprint(f\"Default: {float(np.asarray(tempo1).item())}\")\nprint(f\"start_bpm=120: {float(np.asarray(tempo2).item())}\")\nprint(f\"start_bpm=120, tight: {float(np.asarray(tempo3).item())}\")\n# Try with aggregate=np.mean\ntempo4, _ = librosa.beat.beat_track(y=y_perc, sr=sr, aggregate=np.mean)\nprint(f\"aggregate=mean: {float(np.asarray(tempo4).item())}\")\n# Use librosa.feature.tempo directly\ntempo5 = librosa.feature.tempo(y=y_perc, sr=sr)\nprint(f\"feature.tempo: {tempo5}\")\nEOF\n"]
