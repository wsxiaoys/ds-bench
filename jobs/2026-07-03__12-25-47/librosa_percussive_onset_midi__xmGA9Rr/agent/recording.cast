[239.032519, "i", "python3 << 'EOF'\nimport json\nd = json.load(open('/home/user/hits.json'))\n# Verify structure\nassert isinstance(d, list), f\"Expected list, got {type(d)}\"\nfor i, h in enumerate(d):\n    assert set(h.keys()) == {'time_seconds', 'grid_index', 'velocity', 'raw_time_seconds'}, f\"Hit {i} keys: {h.keys()}\"\n    assert isinstance(h['time_seconds'], (int, float))\n    assert isinstance(h['grid_index'], int)\n    assert isinstance(h['velocity'], (int, float))\n    assert isinstance(h['raw_time_seconds'], (int, float))\n    assert h['velocity'] > 0.0 and h['velocity'] <= 1.0, f\"Hit {i} velocity out of range: {h['velocity']}\"\n# Check ordering\ntimes = [h['time_seconds'] for h in d]\nassert times == sorted(times), \"Hits not chronologically ordered\"\nprint(f\"All {len(d)} hits verified successfully!\")\nprint(f\"First hit: {d[0]}\")\nprint(f\"Last hit: {d[-1]}\")\nprint(f\"Time range: [{times[0]:.4f}, {times[-1]:.4f}]\")\nprint(f\"Velocity range: [{min(h['velocity'] for h in d):.6f}, {max(h['velocity'] for h in d):.6f}]\")\n# Check grid spacing consistency\nimport numpy as np\ny, sr = __import__('librosa').load('/home/user/input.wav', sr=None)\nduration = float(__import__('librosa').get_duration(y=y, sr=sr))\nprint(f\"Duration: {duration}s\")\nprint(f\"Max time: {times[-1]} <= {duration}\")\nassert times[-1] <= duration + 0.01\nEOF\n"]
