[197.322868, "i", "python3 << 'EOF'\nimport json\nfrom collections import Counter\nd = json.load(open('/home/user/hits.json'))\ngrid_indices = [h['grid_index'] for h in d]\nprint(f\"Total hits: {len(d)}\")\nprint(f\"Unique grid indices: {len(set(grid_indices))}\")\nc = Counter(grid_indices)\nprint(f\"Grid indices with multiple hits: {sum(1 for v in c.values() if v > 1)}\")\nprint(f\"Max hits per grid: {max(c.values())}\")\n# Show distribution\nprint(\"\\nFirst 10 grid positions and their hits:\")\nfor gi in sorted(set(grid_indices))[:10]:\n    hits_at = [h for h in d if h['grid_index'] == gi]\n    print(f\"  grid {gi}: {len(hits_at)} hits, velocities={[round(h['velocity'],3) for h in hits_at]}\")\nEOF\n"]
