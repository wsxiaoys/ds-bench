[141.281437, "i", "python3 << 'EOF'\nimport librosa\nimport numpy as np\ny, sr = librosa.load('/home/user/input.wav', sr=None)\ny_perc, _ = librosa.effects.hpss(y)\nhop_length = 512\n\n# Use librosa.feature.tempo directly\ntempo_arr = librosa.feature.tempo(y=y_perc, sr=sr, hop_length=hop_length)\nprint(f\"feature.tempo array: {tempo_arr}\")\nprint(f\"feature.tempo[0]: {tempo_arr[0]}\")\n\n# onset envelope\noe = librosa.onset.onset_strength(y=y_perc, sr=sr, hop_length=hop_length)\nprint(f\"Onset env shape: {oe.shape}, max: {oe.max():.3f}\")\n\n# Onset detect with default params\nonset_frames = librosa.onset.onset_detect(onset_envelope=oe, sr=sr, hop_length=hop_length, units='frames')\nprint(f\"Default onset_detect (with envelope): {len(onset_frames)} onsets\")\n\n# Onset detect without envelope\nov2 = librosa.onset.onset_detect(y=y_perc, sr=sr, hop_length=hop_length, units='frames')\nprint(f\"Default onset_detect (no envelope): {len(ov2)} onsets\")\n\n# Test with stricter peak picking\nimport librosa.util\nov3 = librosa.onset.onset_detect(onset_envelope=oe, sr=sr, hop_length=hop_length, \n                                  units='frames', pre_avg=20, post_avg=20, \n                                  pre_max=20, post_max=20, delta=0.1, wait=10)\nprint(f\"Strict onset_detect: {len(ov3)} onsets\")\n\n# Check REDACTEDcorrelation peak\nfrom librosa.feature import tempo as tempo_feature\nimport librosa.feature.rhythm\nac = librosa.feature.rhythm.tempogram(onset_envelope=oe, sr=sr, hop_length=hop_length)\nprint(f\"Tempogram shape: {ac.shape}\")\nEOF\n"]
