[239.034788, "o", "    assert set(h.keys()) == {'time_seconds', 'grid_index', 'velocity', 'raw_time_seconds'}, f\"Hit {i} keys: {h.keys()}\"\r\n\u001b[?2004l\r\u001b[?2004h> "]
