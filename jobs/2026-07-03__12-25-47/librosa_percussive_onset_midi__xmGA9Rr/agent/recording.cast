[163.948673, "o", "\u001b[?2004h> "]
[163.948938, "o", "# Find peaks in REDACTEDcorrelation\r\n\u001b[?2004l\r\u001b[?2004h"]
[163.948988, "o", "> "]
[163.949249, "o", "peaks, _ = find_peaks(mean_ac, height=0)\r\n\u001b[?2004l\r"]
[163.94929, "o", "\u001b[?2004h> "]
[163.949439, "o", "if len(peaks) > 0:\r\n\u001b[?2004l\r"]
[163.94949, "o", "\u001b[?2004h> "]
[163.949642, "o", "    # Get top peaks\r\n\u001b[?2004l\r"]
[163.949724, "o", "\u001b[?2004h> "]
[163.950075, "o", "    sorted_idx = np.argsort(mean_ac[peaks])[::-1][:10]\r\n\u001b[?2004l\r"]
[163.950121, "o", "\u001b[?2004h> "]
[163.950358, "o", "    top_peaks = peaks[sorted_idx]\r\n\u001b[?2004l\r"]
[163.950403, "o", "\u001b[?2004h> "]
[163.950819, "o", "    print(\"\\nTop REDACTEDcorrelation peaks (BPM, AC value):\")\r\n\u001b[?2004l\r"]
[163.950866, "o", "\u001b[?2004h> "]
[163.95104, "o", "    for p in top_peaks:\r\n\u001b[?2004l\r"]
[163.951086, "o", "\u001b[?2004h> "]
[163.951547, "o", "        print(f\"  BPM={bpm_axis[p]:.2f}, AC={mean_ac[p]:.3f}\")\r\n\u001b[?2004l\r"]
[163.951597, "o", "\u001b[?2004h> "]
[163.95164, "o", "EOF\r\n\u001b[?2004l\r"]
