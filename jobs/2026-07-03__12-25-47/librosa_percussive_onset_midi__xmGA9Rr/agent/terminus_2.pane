[?2004hroot@86c29de0-9290-4fb5-b93b-da9d39674a42:~# cat > /home/user/quantize.py << 'PYEOF'
[?2004l[?2004h> #!/usr/bin/env python3
[?2004l[?2004h> import json
[?2004l[?2004h> import numpy as np
[?2004l[?2004h> import librosa
[?2004l[?2004h> 
[?2004l[?2004h> INPUT_PATH = '/home/user/input.wav'
[?2004l[?2004h> OUTPUT_PATH = '/home/user/hits.json'
[?2004l[?2004h> HOP_LENGTH = 512
[?2004l[?2004h> 
[?2004l[?2004h> # 1. Load
[?2004l[?2004h> y, sr = librosa.load(INPUT_PATH, sr=None)
[?2004l[?2004h> duration = float(librosa.get_duration(y=y, sr=sr))
[?2004l[?2004h> print(f"Sample rate: {sr}, Duration: {duration:.4f}s, Samples: {len(y)}")
[?2004l[?2004h> 
[?2004l[?2004h> # 2. HPSS to isolate percussive
[?2004l[?2004h> y_perc, _ = librosa.effects.hpss(y)
[?2004l[?2004h> 
[?2004l[?2004h> # 3. Onset strength envelope on percussive (same hop_length throughout)
[?2004l[?2004h> onset_env = librosa.onset.onset_strength(y=y_perc, sr=sr, hop_length=HOP_LENGTH)
[?2004l[?2004h> print(f"Onset envelope length: {len(onset_env)}")
[?2004l[?2004h> 
[?2004l[?2004h> # 4. Detect onsets (frame indices) using peak picking on the envelope
[?2004l[?2004h> onset_frames = librosa.onset.onset_detect(
[?2004l[?2004h>     onset_envelope=onset_env,
[?2004l[?2004h>     sr=sr,
[?2004l[?2004h>     hop_length=HOP_LENGTH,
[?2004l[?2004h>     units='frames',
[?2004l[?2004h>     backtrack=False,
[?2004l[?2004h> )
[?2004l[?2004h> print(f"Number of detected onsets: {len(onset_frames)}")
[?2004l[?2004h> 
[?2004l[?2004h> # 5. Beat tracking on percussive to recover global tempo
[?2004l[?2004h> tempo, _ = librosa.beat.beat_track(
[?2004l[?2004h>     y=y_perc,
[?2004l[?2004h>     sr=sr,
[?2004l[?2004h>     hop_length=HOP_LENGTH,
[?2004l[?2004h>     units='frames',
[?2004l[?2004h> )
[?2004l[?2004h> tempo = float(np.asarray(tempo).item())
[?2004l[?2004h> print(f"Estimated tempo: {tempo:.4f} BPM")
[?2004l[?2004h> 
[?2004l[?2004h> # 6. 16th-note grid starting at time 0
[?2004l[?2004h> step = 60.0 / tempo / 4.0
[?2004l[?2004h> max_idx = int(np.floor(duration / step))
[?2004l[?2004h> print(f"16th-note step: {step:.6f}s, grid indices 0..{max_idx}")
[?2004l[?2004h> 
[?2004l[?2004h> # 7. Convert onset frames to raw times
[?2004l[?2004h> raw_times = librosa.frames_to_time(onset_frames, sr=sr, hop_length=HOP_LENGTH)
[?2004l[?2004h> 
[?2004l[?2004h> # 8. Snap each onset to nearest grid position within [0, duration]
[?2004l[?2004h> hits = []
[?2004l[?2004h> for frame, raw_t in zip(onset_frames, raw_times):
[?2004l[?2004h>     idx = int(round(float(raw_t) / step))
[?2004l[?2004h>     if idx < 0:
[?2004l[?2004h>         idx = 0
[?2004l[?2004h>     if idx > max_idx:
[?2004l[?2004h>         idx = max_idx
[?2004l[?2004h>     snapped_t = float(idx * step)
[?2004l[?2004h>     f = int(frame)
[?2004l[?2004h>     if 0 <= f < len(onset_env):
[?2004l[?2004h>         amp = float(onset_env[f])
[?2004l[?2004h>     elif f >= len(onset_env) and len(onset_env) > 0:
[?2004l[?2004h>         amp = float(onset_env[-1])
[?2004l[?2004h>     else:
[?2004l[?2004h>         amp = 0.0
[?2004l[?2004h>     hits.append({
[?2004l[?2004h>         'time_seconds': snapped_t,
[?2004l[?2004h>         'grid_index': idx,
[?2004l[?2004h>         'velocity': amp,
[?2004l[?2004h>         'raw_time_seconds': float(raw_t),
[?2004l[?2004h>     })
[?2004l[?2004h> 
[?2004l[?2004h> # 9. Normalize velocities to (0, 1] - max == 1, min strictly > 0
[?2004l[?2004h> amps = np.array([h['velocity'] for h in hits], dtype=np.float64)
[?2004l[?2004h> if len(amps) > 0:
[?2004l[?2004h>     max_amp = float(amps.max())
[?2004l[?2004h>     if max_amp > 0:
[?2004l[?2004h>         amps = amps / max_amp
[?2004l[?2004h>     # Defensive: ensure strictly positive (percussive onsets should be > 0)
[?2004l[?2004h>     zero_mask = amps <= 0
[?2004l[?2004h>     if zero_mask.any():
[?2004l[?2004h>         nonzero = amps[~zero_mask]
[?2004l[?2004h>         fallback = float(nonzero.min()) * 0.5 if nonzero.size > 0 else 1e-6
[?2004l[?2004h>         amps = np.where(zero_mask, fallback, amps)
[?2004l[?2004h> 
[?2004l[?2004h> for h, a in zip(hits, amps):
[?2004l[?2004h>     h['velocity'] = float(a)
[?2004l[?2004h> 
[?2004l[?2004h> # 10. Order chronologically by snapped time (stable)
[?2004l[?2004h> hits.sort(key=lambda h: (h['time_seconds'], h['raw_time_seconds']))
[?2004l[?2004h> 
[?2004l[?2004h> # 11. Write JSON array
[?2004l[?2004h> with open(OUTPUT_PATH, 'w') as f:
[?2004l[?2004h>     json.dump(hits, f, indent=2)
[?2004l[?2004h> 
[?2004l[?2004h> print(f"Wrote {len(hits)} hits to {OUTPUT_PATH}")
[?2004l[?2004h> if hits:
[?2004l[?2004h>     vmin = min(h['velocity'] for h in hits)
[?2004l[?2004h>     vmax = max(h['velocity'] for h in hits)
[?2004l[?2004h>     print(f"Velocity range: [{vmin:.6f}, {vmax:.6f}]")
[?2004l[?2004h>     print(f"Time range: [{hits[0]['time_seconds']:.4f}, {hits[-1]['time_seconds']:.4f}]")
[?2004l[?2004h> PYEOF
