[169.624506, "o", "echo '=== Coin.gd ===' && cat /home/user/coin_collector/scenes/Coin.gd\r\n\u001b[?2004l\r"]
[169.624594, "o", "=== Coin.gd ===\r\n"]
[169.625904, "o", "extends Area2D\r\n\r\nsignal collected\r\n\r\nfunc _on_body_entered(body: Node) -> void:\r\n\tif body.name == \"Player\":\r\n\t\tInventory.add_coin()\r\n\t\tcollected.emit()\r\n\t\tqueue_free()\r\n"]
[169.626234, "o", "\u001b[?2004h"]
[169.626303, "o", "root@f37fbc62-ec98-45ca-be19-b28b5d05ba22:/home/user/coin_collector# "]
[169.988455, "i", "echo '=== HUD.gd ===' && cat /home/user/coin_collector/scenes/HUD.gd\n"]
[169.988924, "o", "echo '=== HUD.gd ===' && cat /home/user/coin_collector/scenes/HUD.gd\r\n\u001b[?2004l\r"]
[169.98898, "o", "=== HUD.gd ===\r\n"]
[169.989941, "o", "extends CanvasLayer\r\n\r\n@onready var label: Label = $Label\r\n\r\nfunc _ready() -> void:\r\n\tlabel.text = \"Coins: %d\" % Inventory.get_count()\r\n\tInventory.coin_changed.connect(_on_coin_changed)\r\n\r\nfunc _on_coin_changed(new_count: int) -> void:\r\n\tlabel.text = \"Coins: %d\" % new_count\r\n"]
[169.990186, "o", "\u001b[?2004h"]
