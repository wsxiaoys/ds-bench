[168.859777, "o", "=== Inventory.gd ===\r\n"]
[168.861056, "o", "extends Node\r\n\r\nsignal coin_changed(new_count: int)\r\n\r\nconst SAVE_PATH := \"user://save.json\"\r\n\r\nvar _count: int = 0\r\n\r\nfunc _ready() -> void:\r\n\tself.load()\r\n\r\nfunc _notification(what: int) -> void:\r\n\tif what == NOTIFICATION_WM_CLOSE_REQUEST or what == NOTIFICATION_EXIT_TREE:\r\n\t\tself.save()\r\n\r\nfunc add_coin() -> void:\r\n\t_count += 1\r\n\tcoin_changed.emit(_count)\r\n\r\nfunc get_count() -> int:\r\n\treturn _count\r\n\r\nfunc save() -> void:\r\n\tvar data := {\r\n\t\t\"count\": _count,"]
[168.861152, "o", "\r\n\t}\r\n\tvar file := FileAccess.open(SAVE_PATH, FileAccess.WRITE)\r\n\tif file == null:\r\n\t\treturn\r\n\tfile.store_string(JSON.stringify(data))\r\n\tfile.close()\r\n\r\nfunc load() -> void:\r\n\tif not FileAccess.file_exists(SAVE_PATH):\r\n\t\treturn\r\n\tvar file := FileAccess.open(SAVE_PATH, FileAccess.READ)\r\n\tif file == null:\r\n\t\treturn\r\n\tvar text := file.get_as_text()\r\n\tfile.close()\r\n\tvar parsed: Variant = JSON.parse_string(text)\r\n\tif typeof(parsed) != TYPE_DICTIONARY:\r\n\t\treturn\r\n"]
[168.861217, "o", "\tvar dict := parsed as Dictionary\r\n\tif dict.has(\"count\"):\r\n\t\t_count = int(dict[\"count\"])\r\n\t\tcoin_changed.emit(_count)\r\n"]
[168.861461, "o", "\u001b[?2004hroot@f37fbc62-ec98-45ca-be19-b28b5d05ba22:/home/user/coin_collector# "]
[169.237541, "i", "echo '=== Player.gd ===' && cat /home/user/coin_collector/scenes/Player.gd\n"]
[169.238031, "o", "echo '=== Player.gd ===' && cat /home/user/coin_collector/scenes/Player.gd\r\n\u001b[?2004l\r"]
[169.238093, "o", "=== Player.gd ===\r\n"]
[169.239573, "o", "extends CharacterBody2D\r\n\r\nconst SPEED := 200.0\r\n\r\nfunc _physics_process(_delta: float) -> void:\r\n\tvar x_axis := Input.get_axis(\"ui_left\", \"ui_right\")\r\n\tvar y_axis := Input.get_axis(\"ui_up\", \"ui_down\")\r\n\tvelocity.x = x_axis * SPEED\r\n\tvelocity.y = y_axis * SPEED\r\n\t"]
[169.239607, "o", "move_and_slide()\r\n"]
[169.239979, "o", "\u001b[?2004h"]
[169.240009, "o", "root@f37fbc62-ec98-45ca-be19-b28b5d05ba22:/home/user/coin_collector# "]
