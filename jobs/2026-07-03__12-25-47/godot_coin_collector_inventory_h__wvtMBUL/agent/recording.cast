[174.025562, "o", "; Godot 4 project file.\r\n\r\nconfig_version=5\r\n\r\n[application]\r\n\r\nconfig/name=\"coin_collector\"\r\nrun/main_scene=\"res://scenes/Main.tscn\"\r\nconfig/features=PackedStringArray(\"4.3\")\r\n\r\n[REDACTEDload]\r\n\r\nInventory=\"*res://REDACTEDloads/Inventory.gd\"\r\n"]
[174.025805, "o", "=== Player.tscn ===\r\n"]
[174.026539, "o", "[gd_scene load_steps=2 format=3 uid=\"uid://player001\"]\r\n\r\n[ext_resource type=\"Script\" path=\"res://scenes/Player.gd\" id=\"1_player\"]\r\n\r\n[node name=\"Player\" type=\"CharacterBody2D\"]\r\nscript = ExtResource(\"1_player\")\r\n\r\n[node name=\"CollisionShape2D\" type=\"CollisionShape2D\" parent=\".\"]\r\n\r\n[node name=\"Sprite2D\" type=\"Sprite2D\" parent=\".\"]\r\n"]
[174.026684, "o", "=== Coin.tscn ===\r\n"]
[174.027847, "o", "[gd_scene load_steps=2 format=3 uid=\"uid://coin0001\"]\r\n\r\n[ext_resource type=\"Script\" path=\"res://scenes/Coin.gd\" id=\"1_coin\"]\r\n\r\n[node name=\"Coin\" type=\"Area2D\"]\r\nscript = ExtResource(\"1_coin\")\r\n\r\n[node name=\"CollisionShape2D\" type=\"CollisionShape2D\" parent=\".\"]\r\n\r\n[connection signal=\"body_entered\" from=\".\" to=\".\" method=\"_on_body_entered\"]\r\n"]
[174.028177, "o", "\u001b[?2004h"]
