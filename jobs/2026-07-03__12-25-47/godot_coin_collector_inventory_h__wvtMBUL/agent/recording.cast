[174.41236, "o", "echo '=== HUD.tscn ===' && cat /home/user/coin_collector/scenes/HUD.tscn && echo '=== Main.tscn ===' && cat /home/user/coin_collector/scenes/Main.tscn\r\n\u001b[?2004l\r"]
[174.412448, "o", "=== HUD.tscn ===\r\n"]
[174.414075, "o", "[gd_scene load_steps=2 format=3 uid=\"uid://hud0001\"]\r\n\r\n[ext_resource type=\"Script\" path=\"res://scenes/HUD.gd\" id=\"1_hud\"]\r\n\r\n[node name=\"HUD\" type=\"CanvasLayer\"]\r\nscript = ExtResource(\"1_hud\")\r\n\r\n[node name=\"Label\" type=\"Label\" parent=\".\"]\r\noffset_left = 10.0\r\noffset_top = 10.0\r\noffset_right = 200.0\r\noffset_bottom = 50.0\r\ntext = \"Coins: 0\"\r\n"]
[174.414308, "o", "=== Main.tscn ===\r\n"]
[174.415482, "o", "[gd_scene load_steps=4 format=3 uid=\"uid://main0001\"]\r\n\r\n[ext_resource type=\"PackedScene\" path=\"res://scenes/Player.tscn\" id=\"1_player\"]\r\n[ext_resource type=\"PackedScene\" path=\"res://scenes/HUD.tscn\" id=\"2_hud\"]\r\n[ext_resource type=\"PackedScene\" path=\"res://scenes/Coin.tscn\" id=\"3_coin\"]\r\n\r\n[node name=\"Main\" type=\"Node2D\"]\r\n\r\n[node name=\"Player\" parent=\".\" instance=ExtResource(\"1_player\")]\r\n\r\n[node name=\"Coin\" parent=\".\" instance=ExtResource(\"3_coin\")]\r\nposition = Vector2(100, 0)\r\n\r\n[node name=\"HUD\" parent=\".\" instance=ExtResource(\"2_hud\")]\r\n"]
