[100.876594, "i", "cat > /tmp/fix_inventory.py << 'PYEOF'\nimport os\n\ninventory_gd = '''extends Node\n\nsignal coin_changed(new_count: int)\n\nconst SAVE_PATH := \"user://save.json\"\n\nvar _count: int = 0\n\nfunc _ready() -> void:\n\\tload_data()\n\nfunc _notification(what: int) -> void:\n\\tif what == NOTIFICATION_WM_CLOSE_REQUEST or what == NOTIFICATION_EXIT_TREE:\n\\t\\tsave_data()\n\nfunc add_coin() -> void:\n\\t_count += 1\n\\tcoin_changed.emit(_count)\n\nfunc get_count() -> int:\n\\treturn _count\n\nfunc save_data() -> void:\n\\tvar data := {\n\\t\\t\"count\": _count,\n\\t}\n\\tvar file := FileAccess.open(SAVE_PATH, FileAccess.WRITE)\n\\tif file == null:\n\\t\\treturn\n\\tfile.store_string(JSON.stringify(data))\n\\tfile.close()\n\nfunc load_data() -> void:\n\\tif not FileAccess.file_exists(SAVE_PATH):\n\\t\\treturn\n\\tvar file := FileAccess.open(SAVE_PATH, FileAccess.READ)\n\\tif file == null:\n\\t\\treturn\n\\tvar text := file.get_as_text()\n\\tfile.close()\n\\tvar parsed: Variant = JSON.parse_string(text)\n\\tif typeof(parsed) != TYPE_DICTIONARY:\n\\t\\treturn\n\\tvar dict := parsed as Dictionary\n\\tif dict.has(\"count\"):\n\\t\\t_count = int(dict[\"count\"])\n\\t\\tcoin_changed.emit(_count)\n'''\n\nwith open('/home/user/coin_collector/REDACTEDloads/Inventory.gd', 'w') as f:\n    f.write(inventory_gd)\nprint('Fixed Inventory.gd')\nPYEOF\n"]
[100.877048, "o", "cat > /tmp/fix_inventory.py << 'PYEOF'\r\n"]
