root@a4937eb6-7d36-4af2-ba48-a91e2db30390:/home/user/myproject# cat > /home/user/myproject/test_scene.gd << 'EOF'
extends SceneTree

func _initialize() -> void:
    print("Loading scene...")
    var scene = load("res://main.tscn")
    if scene == null:
        print("ERROR: failed to load scene")
        quit(1)
        return
    var inst = scene.instantiate()
    root.add_child(inst)
    
    # Wait one frame for things to settle
    await process_frame
    
    print("Scene tree structure:")
    _print_tree(inst, 0)
    
    # Check that the required nodes exist
    var sv: SubViewport = inst.get_node_or_null("World/SourceViewport")
    if sv == null:
        print("ERROR: SourceViewport not found")
        quit(1)
        return
    print("SourceViewport size: ", sv.size)
    print("SourceViewport transparent_bg: ", sv.transparent_bg)
    print("SourceViewport render_target_update_mode: ", sv.render_target_update_mode)
    
    var cam: Camera3D = inst.get_node_or_null("World/SourceViewport/SourceCamera")
    if cam == null:
        print("ERROR: SourceCamera not found")
        quit(1)
        return
    print("SourceCamera current: ", cam.current)
    
    var monitor: TextureRect = inst.get_node_or_null("HUD/MonitorScreen")
    if monitor == null:
        print("ERROR: MonitorScreen not found")
        quit(1)
        return
    print("MonitorScreen texture: ", monitor.texture)
    
    # Test set_camera_pose
    if inst.has_method("set_camera_pose"):
        inst.set_camera_pose(Vector3(3, 0, 5), Basis.IDENTITY)
        print("Camera position after set_camera_pose: ", cam.global_position)
        print("Camera basis after set_camera_pose: ", cam.global_transform.basis)
    else:
        print("ERROR: set_camera_pose method not found")
        quit(1)
        return
    
    print("All checks passed!")
    quit(0)

func _print_tree(node: Node, depth: int) -> void:
    var indent = "".repeat(depth * 2)
    print(indent, node.name, " (", node.get_class(), ")")
    for child in node.get_children():
        _print_tree(child, depth + 1)
EOF
