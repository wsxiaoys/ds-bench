# so the next rendered frame uses this pose.$
func set_camera_pose(pos: Vector3, basis: Basis) -> void:$
^Ivar cam: Camera3D = $World/SourceViewport/SourceCamera$
^Iif cam == null:$
^I^Ireturn$
^Ivar t := Transform3D(basis, pos)$
^Icam.global_transform = t$
