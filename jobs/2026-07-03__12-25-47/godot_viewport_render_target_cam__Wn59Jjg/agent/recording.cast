SceneRoot\" type=\"Node3D\" parent=\"World/SourceViewport\"]\n\n[node name=\"RedCube\" type=\"MeshInstance3D\" parent=\"World/SourceViewport/SceneRoot\"]\ntransform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 3, 0, 0)\nmesh = SubResource(\"BoxMesh_red\")\nsurface_material_override/0 = SubResource(\"Mat_red\")\n\n[node name=\"GreenCube\" type=\"MeshInstance3D\" parent=\"World/SourceViewport/SceneRoot\"]\ntransform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, -3, 0, 0)\nmesh = SubResource(\"BoxMesh_green\")\nsurface_material_override/0 = SubResource(\"Mat_green\")\n\n[node name=\"BlueCube\" type=\"MeshInstance3D\" parent=\"World/SourceViewport/SceneRoot\"]\ntransform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 0, 0, -3)\nmesh = SubResource(\"BoxMesh_blue\")\nsurface_material_override/0 = SubResource(\"Mat_blue\")\n\n[node name=\"HUD\" type=\"CanvasLayer\" parent=\".\"]\n\n[node name=\"MonitorScreen\" type=\"TextureRect\" parent=\"HUD\"]\noffset_right = 256.0\noffset_bottom = 256.0\ntexture = SubResource(\"ViewportTex\")\n'''\nwith open('/home/user/myproject/main.tscn', 'w') as f:\n    f.write(tscn)\nprint('done')\nPYEOF\n"]
