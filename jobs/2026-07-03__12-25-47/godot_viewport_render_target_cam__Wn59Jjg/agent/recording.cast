[118.024801, "i", "cat > /home/user/myproject/test_scene.gd << 'EOF'\nextends SceneTree\n\nfunc _initialize() -> void:\n    print(\"Loading scene...\")\n    var scene = load(\"res://main.tscn\")\n    if scene == null:\n        print(\"ERROR: failed to load scene\")\n        quit(1)\n        return\n    var inst = scene.instantiate()\n    root.add_child(inst)\n    \n    # Wait one frame for things to settle\n    await process_frame\n    \n    print(\"Scene tree structure:\")\n    _print_tree(inst, 0)\n    \n    # Check that the required nodes exist\n    var sv: SubViewport = inst.get_node_or_null(\"World/SourceViewport\")\n    if sv == null:\n        print(\"ERROR: SourceViewport not found\")\n        quit(1)\n        return\n    print(\"SourceViewport size: \", sv.size)\n    print(\"SourceViewport transparent_bg: \", sv.transparent_bg)\n    print(\"SourceViewport render_target_update_mode: \", sv.render_target_update_mode)\n    \n    var cam: Camera3D = inst.get_node_or_null(\"World/SourceViewport/SourceCamera\")\n    if cam == null:\n        print(\"ERROR: SourceCamera not found\")\n        quit(1)\n        return\n    print(\"SourceCamera current: \", cam.current)\n    \n    var monitor: TextureRect = inst.get_node_or_null(\"HUD/MonitorScreen\")\n    if monitor == null:\n        print(\"ERROR: MonitorScreen not found\")\n        quit(1)\n        return\n    print(\"MonitorScreen texture: \", monitor.texture)\n    \n    # Test set_camera_pose\n    if inst.has_method(\"set_camera_pose\"):\n        inst.set_camera_pose(Vector3(3, 0, 5), Basis.IDENTITY)\n        print(\"Camera position after set_camera_pose: \", cam.global_position)\n        print(\"Camera basis after set_camera_pose: \", cam.global_transform.basis)\n    else:\n        print(\"ERROR: set_camera_pose method not found\")\n        quit(1)\n        return\n    \n    print(\"All checks passed!\")\n    quit(0)\n\nfunc _print_tree(node: Node, depth: int) -> void:\n    var indent = \"\".repeat(depth * 2)\n    print(indent, node.name, \" (\", node.get_class(), \")\")\n    for child in node.get_children():\n        _print_tree(child, depth + 1)\nEOF\n"]
[118.025853, "o", "cat > /home/user/myproject/test_scene.gd << 'EOF'\r\nextends SceneTree\r\n\r\nfunc _initialize() -> void:\r\n    print(\"Loading scene...\")\r\n    var scene = load(\"res://main.tscn\")\r\n    if scene == null:\r\n        print(\"ERROR: failed to load scene\")\r\n        quit(1)\r\n        return\r\n    var inst = scene.instantiate()\r\n    root.add_child(inst)\r\n    \r\n    # Wait one frame for things to settle\r\n    await process_frame\r\n    \r\n    print(\"Scene tree structure:\")\r\n    _print_tree(inst, 0)\r\n    \r\n    # Check that the required nodes exist\r\n    var sv: SubViewport = inst.get_node_or_null(\"World/SourceViewport\")\r\n    if sv == null:\r\n        print(\"ERROR: SourceViewport not found\")\r\n        quit(1)\r\n        return\r\n    print(\"SourceViewport size: \", sv.size)\r\n    print(\"SourceViewport transparent_bg: \", sv.transparent_bg)\r\n    print(\"SourceViewport render_target_update_mode: \", sv.render_target_update_mode)\r\n    \r\n    var cam: Camera3D = inst.get_node_or_null(\"World/SourceViewport/SourceCamera\")\r\n    if cam == null:\r\n        print(\"ERROR: SourceCamera not found\")\r\n        quit(1)\r\n        return\r\n    print(\"SourceCamera current: \", cam.current)\r\n    \r\n    var monitor: TextureRect = inst.get_node_or_null(\"HUD/MonitorScreen\")\r\n    if monitor == null:\r\n        print(\"ERROR: MonitorScreen not found\")\r\n        quit(1)\r\n        return\r\n    print(\"MonitorScreen texture: \", monitor.texture)\r\n    \r\n    # Test set_camera_pose\r\n    if inst.has_method(\"set_camera_pose\"):\r\n        inst.set_camera_pose(Vector3(3, 0, 5), Basis.IDENTITY)\r\n        print(\"Camera position after set_camera_pose: \", cam.global_position)\r\n        print(\"Camera basis after set_camera_pose: \", cam.global_transform.basis)\r\n    else:\r\n        print(\"ERROR: set_camera_pose method not found\")\r\n        quit(1)\r\n        return\r\n    \r\n    print(\"All checks passed!\")\r\n    quit(0)\r\n\r\nfunc _print_tree(node: Node, depth: int) -> void:\r\n    var indent = \"\".repeat(depth * 2)\r\n    print(indent, node.name, \" (\", node.get_class(), \")\")\r\n    for child in node.get_children():\r\n        _print_tree(child, depth + 1)\r\nEOF\r\n"]
