[21.830337, "i", "encore --help\n"]
[21.830753, "o", "encore --help\r\n\u001b[?2004l\r"]
[21.860329, "o", "encore is the fastest way of developing backend applications\r\n\r\nUsage:\r\n  encore [command]\r\n\r\nAvailable Commands:\r\n  app                             Commands to create and link Encore apps\r\n  auth                            Commands to authenticate with Encore\r\n  build                           build provides ways to build your application for deployment\r\n  check                           Runs a list of HTTP requests against a fresh app instance\r\n"]
[21.860444, "o", "  config                          Get or set a configuration value\r\n  daemon                          Starts the encore daemon\r\n  db                              Database management commands\r\n  exec                            Runs executable scripts against the local Encore app\r\n  gen                             Code generation commands\r\n  help                            Help about any command\r\n  kubernetes                      Kubernetes management commands\r\n  llm-rules                       Commands to create LLM rules for apps\r\n  logs                            Streams logs from your application\r\n  mcp                             MCP (Message Context Provider) commands\r\n  namespace                       Manage infrastructure namespaces\r\n  rand                            Utilities for generating cryptographically secure random data\r\n  run                             Runs your application\r\n  secret                          Secret management commands\r\n  telemetry                       Reports the current telemetry status\r\n  test                            Tests your application\r\n  version                         Reports the current version of the encore application\r\n\r\nFlags:\r\n  -h, --help            help for encore\r\n      --trace string    file to write execution trace data to\r\n  -v, --verbose count   verbose output\r\n\r\nUse \"encore [command] --help\" for more information about a command.\r\n"]
[21.86645, "o", "\u001b[?2004hroot@59d270bf-1fef-4a6e-807a-d9bb1f80a0a5:/home/user/myproject# "]
[28.991234, "i", "encore app --help\n"]
[28.9914, "o", "encore app --help\r\n\u001b[?2004l\r"]
[29.021045, "o", "Commands to create and link Encore apps\r\n\r\nUsage:\r\n  encore app [command]\r\n\r\nAvailable Commands:\r\n  clone       Clone an existing Encore app from Encore Cloud to your computer\r\n  create      Create a new Encore app\r\n  init        Register an existing local repo as a new app on Encore Cloud\r\n  link        Link an existing local repo to an existing Encore Cloud app\r\n"]
[29.021098, "o", "\r\nFlags:\r\n  -h, --help   help for app\r\n\r\nGlobal Flags:\r\n      --trace string    file to write execution trace data to\r\n  -v, --verbose count   verbose output\r\n\r\nUse \"encore app [command] --help\" for more information about a command.\r\n"]
[29.025998, "o", "\u001b[?2004hroot@59d270bf-1fef-4a6e-807a-d9bb1f80a0a5:/home/user/myproject# "]
[30.130675, "i", "encore app init --help\n"]
[30.130935, "o", "encore app init --help\r\n\u001b[?2004l\r"]
[30.159371, "o", "Register an existing local repo as a new app on Encore Cloud\r\n\r\nUsage:\r\n  encore app init [name]\r\n\r\nFlags:\r\n  -h, --help          help for init\r\n  -l, --lang string   Programming language to use for the app. One of (\"go\" or \"ts\").\r\n\r\nGlobal Flags:\r\n      --trace string    file to write execution trace data to\r\n  -v, --verbose count   verbose output\r\n"]
[30.164831, "o", "\u001b[?2004hroot@59d270bf-1fef-4a6e-807a-d9bb1f80a0a5:/home/user/myproject# "]
[35.247373, "i", "encore app create --help\n"]
[35.247573, "o", "encore app create --help\r\n\u001b[?2004l\r"]
[35.275312, "o", "Create a new Encore app\r\n\r\nUsage:\r\n  encore app create [name]\r\n\r\nFlags:\r\n      --example string     URL to example code to use.\r\n  -h, --help               help for create\r\n  -l, --lang string        Programming language to use for the app. One of (\"go\" or \"ts\").\r\n  -r, --llm-rules string   Initialize the app with llm rules for a specific tool. One of (\"cursor\", \"claudecode\", \"vscode\", \"agentsmd\", or \"zed\").\r\n      --platform           whether to create the app with the Encore Platform (default true)\r\n\r\nGlobal Flags:\r\n      --trace string    file to write execution trace data to\r\n  -v, --verbose count   verbose output\r\n"]
