import (
"context"
"fmt"

"encore.dev"
)

type User struct {
ID   string `json:"id"`
Name string `json:"name"`
}

//encore:api public path=/user/:id method=GET
func GetUser(ctx context.Context, id string) (*User, error) {
return &User{
ID:   id,
Name: fmt.Sprintf("User %s", id),
}, nil
}

var _ = encore.NewStaticServer // keep import
