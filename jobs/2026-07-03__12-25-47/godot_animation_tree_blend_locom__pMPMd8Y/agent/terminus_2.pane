^Ism.add_transition("Locomotion", "Attack", t1)$
^I$
^Ivar t2 = AnimationNodeStateMachineTransition.new()$
^It2.switch_mode = AnimationNodeStateMachineTransition.SWITCH_MODE_AT_END$
^It2.advance_mode = AnimationNodeStateMachineTransition.ADVANCE_MODE_DISABLED$
^Ism.add_transition("Attack", "Locomotion", t2)$
^I$
^Ianim_tree.tree_root = sm$
^Iroot.add_child(anim_tree)$
^Ianim_tree.owner = root$
^I$
^I# PlayerAnimController$
^Ivar controller = Node.new()$
^Icontroller.name = "PlayerAnimController"$
^Icontroller.set_script(load("res://scripts/PlayerAnimController.gd"))$
^Iroot.add_child(controller)$
^Icontroller.owner = root$
^I$
