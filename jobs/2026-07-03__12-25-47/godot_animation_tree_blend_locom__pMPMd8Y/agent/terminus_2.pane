^Ivar anim_player = AnimationPlayer.new()$
^Ianim_player.name = "AnimationPlayer"$
^I$
^Ivar lib = AnimationLibrary.new()$
^I$
^Ivar anims = ["idle", "walk_north", "walk_south", "walk_east", "walk_west", "attack"]$
^Ifor anim_name in anims:$
^I^Ivar anim = Animation.new()$
^I^Ianim.length = 0.5$
^I^Ivar track_idx = anim.add_track(Animation.TYPE_VALUE)$
^I^Ianim.track_set_path(track_idx, ".:position")$
^I^Ianim.track_insert_key(track_idx, 0.0, Vector2.ZERO)$
^I^Ilib.add_animation(anim_name, anim)$
^I$
^Ianim_player.add_animation_library("", lib)$
^Iroot.add_child(anim_player)$
^Ianim_player.owner = root$
^I$
^I# AnimationTree$
^Ivar anim_tree = AnimationTree.new()$
^Ianim_tree.name = "AnimationTree"$
^Ianim_tree.anim_player = NodePath("../AnimationPlayer")$
^I$
^Ivar sm = AnimationNodeStateMachine.new()$
^I$
^I# Locomotion state$
^Ivar blend = AnimationNodeBlendSpace2D.new()$
^Iblend.min_space = Vector2(-1, -1)$
^Iblend.max_space = Vector2(1, 1)$
^Iblend.blend_mode = AnimationNodeBlendSpace2D.BLEND_MODE_INTERPOLATED$
^I$
^Ivar points = {$
^I^I"idle": Vector2(0, 0),$
^I^I"walk_north": Vector2(0, -1),$
^I^I"walk_south": Vector2(0, 1),$
^I^I"walk_east": Vector2(1, 0),$
^I^I"walk_west": Vector2(-1, 0)$
^I}$
^Ifor name in points:$
^I^Ivar node_anim = AnimationNodeAnimation.new()$
^I^Inode_anim.animation = name$
^I^Iblend.add_blend_point(node_anim, points[name])$
^I$
^Ism.add_node("Locomotion", blend, Vector2(200, 100))$
^I$
^I# Attack state$
^Ivar attack = AnimationNodeAnimation.new()$
^Iattack.animation = "attack"$
^Ism.add_node("Attack", attack, Vector2(500, 100))$
^I$
^I# Transitions$
^Ivar t_start = AnimationNodeStateMachineTransition.new()$
^It_start.switch_mode = AnimationNodeStateMachineTransition.SWITCH_MODE_IMMEDIATE$
^It_start.advance_mode = AnimationNodeStateMachineTransition.ADVANCE_MODE_AUTO$
^Ism.add_transition("Start", "Locomotion", t_start)$
^I$
^Ivar t1 = AnimationNodeStateMachineTransition.new()$
^It1.switch_mode = AnimationNodeStateMachineTransition.SWITCH_MODE_IMMEDIATE$
^It1.advance_mode = AnimationNodeStateMachineTransition.ADVANCE_MODE_AUTO$
