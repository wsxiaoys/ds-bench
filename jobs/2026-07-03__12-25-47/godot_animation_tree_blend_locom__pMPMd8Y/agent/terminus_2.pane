python3 << 'PYEOF'
content = '''extends SceneTree

func _init() -> void:
\tvar root = Node2D.new()
\troot.name = "Player"
\t
\t# AnimationPlayer
\tvar anim_player = AnimationPlayer.new()
\tanim_player.name = "AnimationPlayer"
\t
\tvar lib = AnimationLibrary.new()
\t
\tvar anims = ["idle", "walk_north", "walk_south", "walk_east", "walk_west", "attack"]
\tfor anim_name in anims:
\t\tvar anim = Animation.new()
\t\tanim.length = 0.5
\t\tvar track_idx = anim.add_track(Animation.TYPE_VALUE)
\t\tanim.track_set_path(track_idx, ".:position")
\t\tanim.track_insert_key(track_idx, 0.0, Vector2.ZERO)
\t\tlib.add_animation(anim_name, anim)
\t
\tanim_player.add_animation_library("", lib)
\troot.add_child(anim_player)
\tanim_player.owner = root
\t
\t# AnimationTree
\tvar anim_tree = AnimationTree.new()
\tanim_tree.name = "AnimationTree"
\tanim_tree.anim_player = NodePath("../AnimationPlayer")
\t
\tvar sm = AnimationNodeStateMachine.new()
\t
\t# Locomotion state
\tvar blend = AnimationNodeBlendSpace2D.new()
\tblend.min_space = Vector2(-1, -1)
\tblend.max_space = Vector2(1, 1)
\tblend.blend_mode = AnimationNodeBlendSpace2D.BLEND_MODE_INTERPOLATED
\t
\tvar points = {
\t\t"idle": Vector2(0, 0),
\t\t"walk_north": Vector2(0, -1),
\t\t"walk_south": Vector2(0, 1),
\t\t"walk_east": Vector2(1, 0),
\t\t"walk_west": Vector2(-1, 0)
\t}
\tfor name in points:
\t\tvar node_anim = AnimationNodeAnimation.new()
\t\tnode_anim.animation = name
\t\tblend.add_blend_point(node_anim, points[name])
\t
\tsm.add_node("Locomotion", blend, Vector2(200, 100))
\t
\t# Attack state
\tvar attack = AnimationNodeAnimation.new()
\tattack.animation = "attack"
\tsm.add_node("Attack", attack, Vector2(500, 100))
\t
\t# Transitions
\tvar t_start = AnimationNodeStateMachineTransition.new()
\tt_start.switch_mode = AnimationNodeStateMachineTransition.SWITCH_MODE_IMMEDIATE
\tt_start.advance_mode = AnimationNodeStateMachineTransition.ADVANCE_MODE_AUTO
\tsm.add_transition("Start", "Locomotion", t_start)
\t
\tvar t1 = AnimationNodeStateMachineTransition.new()
\tt1.switch_mode = AnimationNodeStateMachineTransition.SWITCH_MODE_IMMEDIATE
\tt1.advance_mode = AnimationNodeStateMachineTransition.ADVANCE_MODE_AUTO
\tt1.advance_condition = "condition_attack"
\tsm.add_transition("Locomotion", "Attack", t1)
\t
\tvar t2 = AnimationNodeStateMachineTransition.new()
\tt2.switch_mode = AnimationNodeStateMachineTransition.SWITCH_MODE_AT_END
\tt2.advance_mode = AnimationNodeStateMachineTransition.ADVANCE_MODE_ENABLED
\tsm.add_transition("Attack", "Locomotion", t2)
\t
\tanim_tree.tree_root = sm
\troot.add_child(anim_tree)
\tanim_tree.owner = root
\t
\t# PlayerAnimController
\tvar controller = Node.new()
\tcontroller.name = "PlayerAnimController"
\tcontroller.set_script(load("res://scripts/PlayerAnimController.gd"))
\troot.add_child(controller)
\tcontroller.owner = root
\t
\t# Save scene
\tvar packed = PackedScene.new()
\tpacked.pack(root)
\tvar err = ResourceSaver.save(packed, "res://scenes/Player.tscn")
\tprint("Save result: ", err)
\tquit()
'''
with open("/tmp/godot_builder/builder.gd", "w") as f:
    f.write(content)
print("Written")
