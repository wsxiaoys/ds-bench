[218.668855, "i", "python3 << 'PYEOF'\ncontent = '''extends SceneTree\n\nfunc _initialize() -> void:\n\\tvar scene = load(\"res://scenes/Player.tscn\")\n\\tvar player = scene.instantiate()\n\\troot.add_child(player)\n\\tawait process_frame\n\\tvar at = player.get_node(\"AnimationTree\")\n\\tat.active = true\n\\tvar ctrl = player.get_node(\"PlayerAnimController\")\n\\t\n\\t# Wait for start transition\n\\tawait create_timer(0.1).timeout\n\\tprint(\"Initial state: \", ctrl.current_state())\n\\t\n\\t# Test set_move_input\n\\tctrl.set_move_input(Vector2(1, 0))\n\\tprint(\"Blend position: \", at.get(\"parameters/Locomotion/blend_position\"))\n\\tassert(at.get(\"parameters/Locomotion/blend_position\") == Vector2(1, 0))\n\\t\n\\t# Test trigger_attack\n\\tctrl.trigger_attack()\n\\tprint(\"Condition attack: \", at.get(\"parameters/conditions/condition_attack\"))\n\\tawait create_timer(0.1).timeout\n\\tprint(\"State after attack: \", ctrl.current_state())\n\\tassert(ctrl.current_state() == \"Attack\")\n\\t\n\\t# Wait for attack to end and transition back\n\\tawait create_timer(1.0).timeout\n\\tprint(\"State after attack finishes: \", ctrl.current_state())\n\\tassert(ctrl.current_state() == \"Locomotion\")\n\\t\n\\tprint(\"All tests passed!\")\n\\tquit()\n'''\nwith open(\"/tmp/godot_builder/test_full.gd\", \"w\") as f:\n    f.write(content)\nprint(\"Written\")\nPYEOF\n"]
