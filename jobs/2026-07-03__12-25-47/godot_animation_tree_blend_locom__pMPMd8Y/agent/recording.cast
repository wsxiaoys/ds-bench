[355.770106, "o", "extends SceneTree$\r\n$\r\nfunc _init() -> void:$\r\n^Ivar root = Node2D.new()$\r\n^Iroot.name = \"Player\"$\r\n^I$\r\n^I# AnimationPlayer$\r\n^Ivar anim_player = AnimationPlayer.new()$\r\n^Ianim_player.name = \"AnimationPlayer\"$\r\n^I$\r\n^Ivar lib = AnimationLibrary.new()$\r\n^I$\r\n^Ivar anims = [\"idle\", \"walk_north\", \"walk_south\", \"walk_east\", \"walk_west\", \"attack\"]$\r\n^Ifor anim_name in anims:$\r\n^I^Ivar anim = Animation.new()$\r\n^I^Ianim.length = 0.5$\r\n"]
[355.770177, "o", "^I^Ivar track_idx = anim.add_track(Animation.TYPE_VALUE)$\r\n^I^Ianim.track_set_path(track_idx, \".:position\")$\r\n^I^Ianim.track_insert_key(track_idx, 0.0, Vector2.ZERO)$\r\n^I^Ilib.add_animation(anim_name, anim)$\r\n^I$\r\n^Ianim_player.add_animation_library(\"\", lib)$\r\n^Iroot.add_child(anim_player)$\r\n^Ianim_player.owner = root$\r\n^I$\r\n^I# AnimationTree$\r\n^Ivar anim_tree = AnimationTree.new()$\r\n^Ianim_tree.name = \"AnimationTree\"$\r\n^Ianim_tree.anim_player = NodePath(\"../AnimationPlayer\")$\r\n^I$\r\n^Ivar sm = AnimationNodeStateMachine.new()$\r\n^I$\r\n^I# Locomotion state$\r\n^Ivar blend = AnimationNodeBlendSpace2D.new()$\r\n^Iblend.min_space = Vector2(-1, -1)$\r\n^Iblend.max_space = Vector2(1, 1)$\r\n^Iblend.blend_mode = AnimationNodeBlendSpace2D.BLEND_MODE_INTERPOLATED$\r\n^I$\r\n^Ivar points = {$\r\n^I^I\"idle\": Vector2(0, 0),$\r\n^I^I\"walk_north\": Vector2(0, -1),$\r\n^I^I\"walk_south\": Vector2(0, 1),$\r\n^I^I\"walk_east\": Vector2(1, 0),$\r\n^I^I\"walk_west\": Vector2(-1, 0)$\r\n^I}$\r\n^Ifor name in points:$\r\n^I^Ivar node_anim = AnimationNodeAnimation.new()$\r\n^I^Inode_anim.animation = name$\r\n^I^Iblend.add_blend_point(node_anim, points[name])$\r\n^I$\r\n^Ism.add_node(\"Locomotion\", blend, Vector2(200, 100))$\r\n^I$\r\n^I# Attack state$\r\n^Ivar attack = AnimationNodeAnimation.new()$\r\n^Iattack.animation = \"attack\"$\r\n^Ism.add_node(\"Attack\", attack, Vector2(500, 100))$\r\n^I$"]
[355.770228, "o", "\r\n^I# Transitions$\r\n^Ivar t_start = AnimationNodeStateMachineTransition.new()$\r\n^It_start.switch_mode = AnimationNodeStateMachineTransition.SWITCH_MODE_IMMEDIATE$\r\n^It_start.advance_mode = AnimationNodeStateMachineTransition.ADVANCE_MODE_AUTO$\r\n^Ism.add_transition(\"Start\", \"Locomotion\", t_start)$\r\n^I$\r\n^Ivar t1 = AnimationNodeStateMachineTransition.new()$\r\n^It1.switch_mode = AnimationNodeStateMachineTransition.SWITCH_MODE_IMMEDIATE$\r\n^It1.advance_mode = AnimationNodeStateMachineTransition.ADVANCE_MODE_AUTO$\r\n^It1.advance_condition = \"condition_attack\"$\r\n^Ism.add_transition(\"Locomotion\", \"Attack\", t1)$\r\n^I$\r\n^Ivar t2 = AnimationNodeStateMachineTransition.new()$\r\n^It2.switch_mode = AnimationNodeStateMachineTransition.SWITCH_MODE_AT_END$\r\n^It2.advance_mode = AnimationNodeStateMachineTransition.ADVANCE_MODE_DISABLED$\r\n^Ism.add_transition(\"Attack\", \"Locomotion\", t2)$\r\n^I$\r\n^Ianim_tree.tree_root = sm$\r\n^Iroot.add_child(anim_tree)$\r\n^Ianim_tree.owner = root$\r\n^I$\r\n^I# PlayerAnimController$\r\n^Ivar controller = Node.new()$\r\n^Icontroller.name = \"PlayerAnimController\"$\r\n^Icontroller.set_script(load(\"res://scripts/PlayerAnimController.gd\"))$\r\n^Iroot.add_child(controller)$\r\n^Icontroller.owner = root$\r\n^I$\r\n"]
