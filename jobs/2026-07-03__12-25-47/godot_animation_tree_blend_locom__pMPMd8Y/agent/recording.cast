[351.913349, "o", "\r\n[sub_resource type=\"\u001b[01;31m\u001b[KAnimationNodeStateMachineTransition\u001b[m\u001b[K\" id=\"\u001b[01;31m\u001b[KAnimationNodeStateMachineTransition\u001b[m\u001b[K_vwdj7\"]\r\nswitch_mode = 2\r\nadvance_mode = 0\r\n\r\n\u001b[36m\u001b[K--\u001b[m\u001b[K\r\ntransitions = [\"Start\", \"Locomotion\", SubResource(\"\u001b[01;31m\u001b[KAnimationNodeStateMachineTransition\u001b[m\u001b[K_h8m5c\"), \"Locomotion\", \"Attack\", SubResource(\"\u001b[01;31m\u001b[KAnimationNodeStateMachineTransition\u001b[m\u001b[K_e0oaf\"), \"Attack\", \"Locomotion\", SubResource(\"\u001b[01;31m\u001b[KAnimationNodeStateMachineTransition\u001b[m\u001b[K_vwdj7\")]\r\n\r\n[node name=\"Player\" type=\"Node2D\"]\r\n\r\n"]
