[49.954542, "i", "python3 << 'PYEOF'\ncontent = '''extends SceneTree\n\nfunc _init() -> void:\n\\tvar root = Node2D.new()\n\\troot.name = \"Player\"\n\\t\n\\t# AnimationPlayer\n\\tvar anim_player = AnimationPlayer.new()\n\\tanim_player.name = \"AnimationPlayer\"\n\\t\n\\tvar lib = AnimationLibrary.new()\n\\t\n\\tvar anims = [\"idle\", \"walk_north\", \"walk_south\", \"walk_east\", \"walk_west\", \"attack\"]\n\\tfor anim_name in anims:\n\\t\\tvar anim = Animation.new()\n\\t\\tanim.length = 0.5\n\\t\\tvar track_idx = anim.add_track(Animation.TYPE_VALUE)\n\\t\\tanim.track_set_path(track_idx, \".:position\")\n\\t\\tanim.track_insert_key(track_idx, 0.0, Vector2.ZERO)\n\\t\\tlib.add_animation(anim_name, anim)\n\\t\n\\tanim_player.add_animation_library(\"\", lib)\n\\troot.add_child(anim_player)\n\\tanim_player.owner = root\n\\t\n\\t# AnimationTree\n\\tvar anim_tree = AnimationTree.new()\n\\tanim_tree.name = \"AnimationTree\"\n\\tanim_tree.anim_player = NodePath(\"../AnimationPlayer\")\n\\t\n\\tvar sm = AnimationNodeStateMachine.new()\n\\t\n\\t# Locomotion state\n\\tvar blend = AnimationNodeBlendSpace2D.new()\n\\tblend.min_space = Vector2(-1, -1)\n\\tblend.max_space = Vector2(1, 1)\n\\tblend.blend_mode = AnimationNodeBlendSpace2D.BLEND_MODE_INTERPOLATED\n\\t\n\\tvar points = {\n\\t\\t\"idle\": Vector2(0, 0),\n\\t\\t\"walk_north\": Vector2(0, -1),\n\\t\\t\"walk_south\": Vector2(0, 1),\n\\t\\t\"walk_east\": Vector2(1, 0),\n\\t\\t\"walk_west\": Vector2(-1, 0)\n\\t}\n\\tfor name in points:\n\\t\\tvar node_anim = AnimationNodeAnimation.new()\n\\t\\tnode_anim.animation = name\n\\t\\tblend.add_blend_point(node_anim, points[name])\n\\t\n\\tsm.add_node(\"Locomotion\", blend, Vector2(200, 100))\n\\t\n\\t# Attack state\n\\tvar attack = AnimationNodeAnimation.new()\n\\tattack.animation = \"attack\"\n\\tsm.add_node(\"Attack\", attack, Vector2(500, 100))\n\\t\n\\t# Transitions\n\\tvar t1 = AnimationNodeStateMachineTransition.new()\n\\tt1.switch_mode = AnimationNodeStateMachineTransition.SWITCH_MODE_IMMEDIATE\n\\tt1.advance_mode = AnimationNodeStateMachineTransition.ADVANCE_MODE_AUTO\n\\tt1.advance_condition = \"condition_attack\"\n\\tsm.add_transition(\"Locomotion\", \"Attack\", t1)\n\\t\n\\tvar t2 = AnimationNodeStateMachineTransition.new()\n\\tt2.switch_mode = AnimationNodeStateMachineTransition.SWITCH_MODE_AT_END\n\\tt2.advance_mode = AnimationNodeStateMachineTransition.ADVANCE_MODE_DISABLED\n\\tsm.add_transition(\"Attack\", \"Locomotion\", t2)\n\\t\n\\tanim_tree.tree_root = sm\n\\troot.add_child(anim_tree)\n\\tanim_tree.owner = root\n\\t\n\\t# PlayerAnimController\n\\tvar controller = Node.new()\n\\tcontroller.name = \"PlayerAnimController\"\n\\tcontroller.set_script(load(\"res://scripts/PlayerAnimController.gd\"))\n\\troot.add_child(controller)\n\\tcontroller.owner = root\n\\t\n\\t# Save scene\n\\tvar packed = PackedScene.new()\n\\tpacked.pack(root)\n\\tvar err = ResourceSaver.save(packed, \"res://scenes/Player.tscn\")\n\\tprint(\"Save result: \", err)\n\\tquit()\n'''\nwith open(\"/tmp/godot_builder/builder.gd\", \"w\") as f:\n    f.write(content)\nprint(\"Written\")\nPYEOF\n"]
