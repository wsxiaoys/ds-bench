[75.879457, "i", "python3 << 'PYEOF'\ncontent = '''extends SceneTree\n\nfunc _init() -> void:\n\\tvar scene = load(\"res://scenes/Player.tscn\")\n\\tif scene == null:\n\\t\\tprint(\"Failed to load scene\")\n\\t\\tquit()\n\\t\\treturn\n\\tvar player = scene.instantiate()\n\\tprint(\"Player type: \", player.get_class())\n\\tprint(\"Children: \", player.get_children())\n\\tvar ap = player.get_node(\"AnimationPlayer\")\n\\tprint(\"AnimationPlayer: \", ap)\n\\tprint(\"Animations: \", ap.get_animation_list())\n\\tvar at = player.get_node(\"AnimationTree\")\n\\tprint(\"AnimationTree: \", at)\n\\tprint(\"tree_root: \", at.tree_root)\n\\tprint(\"anim_player: \", at.anim_player)\n\\tvar ctrl = player.get_node(\"PlayerAnimController\")\n\\tprint(\"Controller: \", ctrl)\n\\tprint(\"Has set_move_input: \", ctrl.has_method(\"set_move_input\"))\n\\tprint(\"Has trigger_attack: \", ctrl.has_method(\"trigger_attack\"))\n\\tprint(\"Has current_state: \", ctrl.has_method(\"current_state\"))\n\\troot.add_child(player)\n\\tat.active = true\n\\tprint(\"Active state: \", at.get(\"parameters/playback\").get_current_node())\n\\tctrl.set_move_input(Vector2(1, 0))\n\\tprint(\"Blend position: \", at.get(\"parameters/Locomotion/blend_position\"))\n\\tctrl.trigger_attack()\n\\tprint(\"Condition attack: \", at.get(\"parameters/conditions/condition_attack\"))\n\\tprint(\"Done\")\n\\tquit()\n'''\nwith open(\"/tmp/godot_builder/test_scene.gd\", \"w\") as f:\n    f.write(content)\nprint(\"Written\")\nPYEOF\n"]
