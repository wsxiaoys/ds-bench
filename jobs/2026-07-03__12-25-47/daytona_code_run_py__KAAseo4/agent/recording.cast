[36.229913, "o", "\u001b[01;31m\u001b[KDAYTONA\u001b[m\u001b[K_SANDBOX_SNAPSHOT=\u001b[01;31m\u001b[Kdaytona\u001b[m\u001b[K-7999d67cf31c21fa1690c1e9d040dcdb501de5d60ad8b9aab9574bb09185fa45:\u001b[01;31m\u001b[Kdaytona\u001b[m\u001b[K\r\n\u001b[01;31m\u001b[KDAYTONA\u001b[m\u001b[K_REGION_ID=us\r\n\u001b[01;31m\u001b[KDAYTONA\u001b[m\u001b[K_API_KEY=dtn_1aceb8b564d0fb41d5b277f7924b22f0c55808e7f1615a410602ee8c0a594f91\r\n\u001b[01;31m\u001b[KDAYTONA\u001b[m\u001b[K_SANDBOX_USER=\u001b[01;31m\u001b[Kdaytona\u001b[m\u001b[K\r\n\u001b[01;31m\u001b[KDAYTONA\u001b[m\u001b[K_USER_HOME_AS_WORKDIR=true\r\n\u001b[01;31m\u001b[KDAYTONA\u001b[m\u001b[K_ORGANIZATION_ID=044ccaa4-9811-47ae-bf99-e7309a627556\r\n\u001b[01;31m\u001b[KDAYTONA\u001b[m\u001b[K_OTEL_ENDPOINT=https://otel-collector.app.\u001b[01;31m\u001b[Kdaytona\u001b[m\u001b[K.io\r\n"]
