[518.176594, "o", "{\r\n  \"$schema\": \"node_modules/wrangler/config-schema.json\",\r\n  \"name\": \"rwsdk-r2-api\",\r\n  \"main\": \"src/worker.tsx\",\r\n  \"compatibility_date\": \"2025-01-01\",\r\n  \"compatibility_flags\": [\"nodejs_compat\"],\r\n  \"r2_buckets\": [\r\n    {\r\n      \"binding\": \"BUCKET\",\r\n      \"bucket_name\": \"uploads\"\r\n    }\r\n  ]\r\n}\r\n"]
