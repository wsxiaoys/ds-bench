[257.746345, "o", "  if (dot <= 0 || dot === filename.length - 1) return \"\";\r\n\u001b[?2004l\r"]
[257.746398, "o", "\u001b[?2004h> "]
[257.746663, "o", "  return filename.slice(dot + 1);\r\n\u001b[?2004l\r"]
[257.746717, "o", "\u001b[?2004h> }\r\n\u001b[?2004l\r"]
