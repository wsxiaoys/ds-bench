[257.749768, "o", "export default defineApp([\r\n\u001b[?2004l\r"]
[257.749819, "o", "\u001b[?2004h> "]
[257.750119, "o", "  // POST /api/files - upload a file\r\n\u001b[?2004l\r"]
[257.750171, "o", "\u001b[?2004h> "]
[257.750364, "o", "  route(\"/api/files\", {\r\n\u001b[?2004l\r"]
[257.750415, "o", "\u001b[?2004h> "]
[257.750698, "o", "    post: async ({ request }) => {\r\n\u001b[?2004l\r"]
[257.750789, "o", "\u001b[?2004h> "]
[257.75097, "o", "      let form: FormData;\r\n\u001b[?2004l\r"]
[257.751021, "o", "\u001b[?2004h> "]
[257.751143, "o", "      try {\r\n\u001b[?2004l\r"]
[257.751199, "o", "\u001b[?2004h> "]
[257.751507, "o", "        form = await request.formData();\r\n\u001b[?2004l\r"]
[257.751558, "o", "\u001b[?2004h> "]
[257.751701, "o", "      } catch {\r\n\u001b[?2004l\r"]
[257.751758, "o", "\u001b[?2004h> "]
[257.752244, "o", "        return jsonResponse({ error: \"Invalid form data\" }, 400);\r\n\u001b[?2004l\r"]
[257.752295, "o", "\u001b[?2004h> "]
[257.752425, "o", "      }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[257.752692, "o", "      const file = form.get(\"file\");\r\n\u001b[?2004l\r"]
[257.752745, "o", "\u001b[?2004h> "]
[257.753111, "o", "      if (!file || typeof file === \"string\") {\r\n\u001b[?2004l\r"]
[257.753164, "o", "\u001b[?2004h> "]
[257.75364, "o", "        return jsonResponse({ error: \"Missing 'file' field\" }, 400);\r\n\u001b[?2004l\r"]
[257.753692, "o", "\u001b[?2004h> "]
[257.753776, "o", "      }\r\n\u001b[?2004l\r"]
[257.753891, "o", "\u001b[?2004h> "]
[257.754049, "o", "      // file is a File\r\n\u001b[?2004l\r"]
[257.754102, "o", "\u001b[?2004h> "]
[257.754408, "o", "      const filename = file.name || \"\";\r\n\u001b[?2004l\r"]
[257.754461, "o", "\u001b[?2004h> "]
[257.754811, "o", "      const ext = getExtension(filename);\r\n\u001b[?2004l\r\u001b[?2004h"]
[257.75493, "o", "> "]
[257.755245, "o", "      const arrayBuffer = await file.arrayBuffer();\r\n\u001b[?2004l\r\u001b[?2004h"]
[257.755318, "o", "> "]
[257.755636, "o", "      const bytes = new Uint8Array(arrayBuffer);\r\n\u001b[?2004l\r"]
[257.755695, "o", "\u001b[?2004h> "]
[257.756027, "o", "      const sha256 = await sha256Hex(bytes);\r\n\u001b[?2004l\r"]
[257.756162, "o", "\u001b[?2004h> "]
[257.756569, "o", "      const key = ext ? `uploads/${sha256}.${ext}` : `uploads/${sha256}`;\r\n\u001b[?2004l\r"]
[257.756623, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[257.756749, "o", "\u001b[?2004h> "]
[257.757138, "o", "      const contentType = file.type || \"application/octet-stream\";\r\n\u001b[?2004l\r"]
[257.75719, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[257.757297, "o", "\u001b[?2004h> "]
[257.75752, "o", "      await getBucket().put(key, bytes, {\r\n\u001b[?2004l\r"]
[257.757569, "o", "\u001b[?2004h> "]
[257.757738, "o", "        httpMetadata: {\r\n\u001b[?2004l\r"]
[257.757787, "o", "\u001b[?2004h> "]
[257.758004, "o", "          contentType,\r\n\u001b[?2004l\r"]
[257.758058, "o", "\u001b[?2004h> "]
[257.758165, "o", "        },\r\n\u001b[?2004l\r\u001b[?2004h> "]
[257.758333, "o", "        customMetadata: {\r\n\u001b[?2004l\r"]
[257.758386, "o", "\u001b[?2004h> "]
[257.758631, "o", "          originalFilename: filename,\r\n\u001b[?2004l\r"]
[257.758685, "o", "\u001b[?2004h> "]
[257.758811, "o", "          sha256,\r\n\u001b[?2004l\r"]
[257.758869, "o", "\u001b[?2004h> "]
[257.759006, "o", "        },\r\n\u001b[?2004l\r\u001b[?2004h> "]
[257.759094, "o", "      });\r\n\u001b[?2004l\r\u001b[?2004h"]
[257.759143, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h"]
[257.759246, "o", "> "]
[257.759374, "o", "      return jsonResponse(\r\n\u001b[?2004l\r"]
[257.759427, "o", "\u001b[?2004h> "]
[257.759545, "o", "        {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[257.759679, "o", "          key,\r\n\u001b[?2004l\r\u001b[?2004h"]
[257.759796, "o", "> "]
[257.759938, "o", "          size: bytes.byteLength,\r\n\u001b[?2004l\r"]
[257.760004, "o", "\u001b[?2004h> "]
[257.760155, "o", "          contentType,\r\n\u001b[?2004l\r"]
[257.760205, "o", "\u001b[?2004h> "]
[257.760326, "o", "          sha256,\r\n\u001b[?2004l\r"]
[257.760375, "o", "\u001b[?2004h> "]
[257.760475, "o", "        },\r\n\u001b[?2004l\r\u001b[?2004h"]
[257.760524, "o", "> "]
[257.760618, "o", "        201,\r\n\u001b[?2004l\r\u001b[?2004h"]
[257.760668, "o", "> "]
[257.760773, "o", "      );\r\n\u001b[?2004l\r\u001b[?2004h> "]
[257.760822, "o", "    },\r\n\u001b[?2004l\r"]
[257.760924, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[257.761206, "o", "    // GET /api/files - list all files\r\n\u001b[?2004l\r"]
[257.761259, "o", "\u001b[?2004h> "]
[257.761417, "o", "    get: async () => {\r\n\u001b[?2004l\r"]
[257.76147, "o", "\u001b[?2004h> "]
[257.761664, "o", "      const objects: Array<{\r\n\u001b[?2004l\r"]
[257.761719, "o", "\u001b[?2004h> "]
[257.761861, "o", "        key: string;\r\n\u001b[?2004l\r"]
[257.761912, "o", "\u001b[?2004h> "]
[257.76208, "o", "        size: number;\r\n\u001b[?2004l\r"]
[257.762135, "o", "\u001b[?2004h> "]
[257.7623, "o", "        uploaded: string;\r\n\u001b[?2004l\r"]
[257.762352, "o", "\u001b[?2004h> "]
[257.762476, "o", "      }> = [];\r\n\u001b[?2004l\r"]
[257.762528, "o", "\u001b[?2004h> "]
[257.762873, "o", "      let cursor: string | undefined = undefined;\r\n\u001b[?2004l\r"]
[257.762925, "o", "\u001b[?2004h> "]
[257.763364, "o", "      // R2 list requires the prefix to end with `/` if provided\r\n\u001b[?2004l\r"]
[257.763416, "o", "\u001b[?2004h> "]
[257.763563, "o", "      while (true) {\r\n\u001b[?2004l\r"]
[257.763616, "o", "\u001b[?2004h> "]
[257.763925, "o", "        const result = await getBucket().list({\r\n\u001b[?2004l\r"]
[257.763987, "o", "\u001b[?2004h> "]
[257.764203, "o", "          prefix: \"uploads/\",\r\n\u001b[?2004l\r"]
[257.764255, "o", "\u001b[?2004h> "]
[257.764377, "o", "          cursor,\r\n\u001b[?2004l\r"]
[257.76443, "o", "\u001b[?2004h> "]
[257.764532, "o", "        });\r\n\u001b[?2004l\r\u001b[?2004h"]
[257.764585, "o", "> "]
[257.764856, "o", "        for (const obj of result.objects) {\r\n\u001b[?2004l\r"]
[257.76491, "o", "\u001b[?2004h> "]
[257.765094, "o", "          objects.push({\r\n\u001b[?2004l\r"]
[257.765148, "o", "\u001b[?2004h> "]
[257.765314, "o", "            key: obj.key,\r\n\u001b[?2004l\r"]
[257.765366, "o", "\u001b[?2004h> "]
[257.765557, "o", "            size: obj.size,\r\n\u001b[?2004l\r"]
[257.76561, "o", "\u001b[?2004h> "]
[257.76594, "o", "            uploaded: obj.uploaded.toISOString(),\r\n\u001b[?2004l\r"]
[257.766, "o", "\u001b[?2004h> "]
[257.766112, "o", "          });\r\n\u001b[?2004l\r"]
[257.766164, "o", "\u001b[?2004h> "]
[257.766263, "o", "        }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[257.766645, "o", "        if (!result.truncated || !result.cursor) break;\r\n\u001b[?2004l\r"]
[257.766694, "o", "\u001b[?2004h> "]
[257.766911, "o", "        cursor = result.cursor;\r\n\u001b[?2004l\r"]
[257.766973, "o", "\u001b[?2004h> "]
[257.767035, "o", "      }\r\n\u001b[?2004l\r"]
[257.767086, "o", "\u001b[?2004h> "]
[257.767413, "o", "      return jsonResponse({ objects });\r\n\u001b[?2004l\r"]
[257.767467, "o", "\u001b[?2004h> "]
[257.767585, "o", "    },\r\n\u001b[?2004l\r\u001b[?2004h> "]
[257.767674, "o", "  }),\r\n\u001b[?2004l\r"]
[257.767725, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[257.767849, "o", "\u001b[?2004h> "]
[257.768125, "o", "  // GET /api/files/:key - retrieve a file\r\n\u001b[?2004l\r"]
[257.768177, "o", "\u001b[?2004h> "]
[257.76841, "o", "  route(\"/api/files/:key\", {\r\n\u001b[?2004l\r"]
[257.768463, "o", "\u001b[?2004h> "]
[257.768717, "o", "    get: async ({ params }) => {\r\n\u001b[?2004l\r"]
[257.76877, "o", "\u001b[?2004h> "]
[257.769209, "o", "      const key = decodeURIComponent(params.key as string);\r\n\u001b[?2004l\r"]
[257.769264, "o", "\u001b[?2004h> "]
[257.769601, "o", "      const obj = await getBucket().get(key);\r\n\u001b[?2004l\r"]
[257.769654, "o", "\u001b[?2004h> "]
[257.769816, "o", "      if (!obj) {\r\n\u001b[?2004l\r"]
[257.769869, "o", "\u001b[?2004h> "]
[257.77029, "o", "        return jsonResponse({ error: \"Not found\" }, 404);\r\n\u001b[?2004l\r"]
[257.770344, "o", "\u001b[?2004h> "]
[257.770467, "o", "      }\r\n\u001b[?2004l\r\u001b[?2004h"]
[257.770519, "o", "> "]
[257.770811, "o", "      const body = await obj.arrayBuffer();\r\n\u001b[?2004l\r"]
[257.770863, "o", "\u001b[?2004h> "]
[257.771158, "o", "      const headers = new Headers();\r\n\u001b[?2004l\r"]
[257.771209, "o", "\u001b[?2004h> "]
[257.77142, "o", "      const contentType =\r\n\u001b[?2004l\r"]
[257.771473, "o", "\u001b[?2004h> "]
[257.772013, "o", "        obj.httpMetadata?.contentType || \"application/octet-stream\";\r\n\u001b[?2004l\r"]
[257.772067, "o", "\u001b[?2004h> "]
[257.772385, "o", "      headers.set(\"content-type\", contentType);\r\n\u001b[?2004l\r"]
[257.772437, "o", "\u001b[?2004h> "]
[257.772835, "o", "      headers.set(\"content-length\", String(obj.size));\r\n\u001b[?2004l\r"]
[257.772887, "o", "\u001b[?2004h> "]
[257.773327, "o", "      return new Response(body, { status: 200, headers });\r\n\u001b[?2004l\r"]
[257.773381, "o", "\u001b[?2004h> "]
[257.773496, "o", "    },\r\n\u001b[?2004l\r\u001b[?2004h> "]
[257.77355, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[257.773907, "o", "    // DELETE /api/files/:key - delete a file\r\n\u001b[?2004l\r"]
[257.773966, "o", "\u001b[?2004h> "]
[257.774253, "o", "    delete: async ({ params }) => {\r\n\u001b[?2004l\r"]
[257.774307, "o", "\u001b[?2004h> "]
[257.774737, "o", "      const key = decodeURIComponent(params.key as string);\r\n\u001b[?2004l\r"]
[257.774789, "o", "\u001b[?2004h> "]
[257.775232, "o", "      // Check existence first to return 404 if not present\r\n\u001b[?2004l\r"]
[257.775284, "o", "\u001b[?2004h> "]
[257.775627, "o", "      const obj = await getBucket().get(key);\r\n\u001b[?2004l\r"]
[257.77568, "o", "\u001b[?2004h> "]
[257.775838, "o", "      if (!obj) {\r\n\u001b[?2004l\r"]
[257.775891, "o", "\u001b[?2004h> "]
[257.776327, "o", "        return jsonResponse({ error: \"Not found\" }, 404);\r\n\u001b[?2004l\r"]
[257.776382, "o", "\u001b[?2004h> "]
[257.776503, "o", "      }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[257.776797, "o", "      await getBucket().delete(key);\r\n\u001b[?2004l\r"]
[257.776857, "o", "\u001b[?2004h> "]
[257.777234, "o", "      return new Response(null, { status: 204 });\r\n\u001b[?2004l\r"]
[257.777291, "o", "\u001b[?2004h> "]
[257.777409, "o", "    },\r\n\u001b[?2004l\r\u001b[?2004h> "]
[257.777465, "o", "  }),\r\n\u001b[?2004l\r"]
[257.77758, "o", "\u001b[?2004h> ]);\r\n\u001b[?2004l\r"]
