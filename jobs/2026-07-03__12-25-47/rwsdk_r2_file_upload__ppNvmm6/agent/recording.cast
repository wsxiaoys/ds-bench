[257.746883, "o", "\u001b[?2004h> "]
[257.747332, "o", "function jsonResponse(data: unknown, status = 200): Response {\r\n\u001b[?2004l\r"]
[257.747385, "o", "\u001b[?2004h> "]
[257.747734, "o", "  return new Response(JSON.stringify(data), {\r\n\u001b[?2004l\r"]
[257.747788, "o", "\u001b[?2004h> "]
[257.747897, "o", "    status,\r\n\u001b[?2004l\r"]
