[60.587049, "o", "cat hello/hello.go\r\n\u001b[?2004l\r"]
[60.58801, "o", "package hello\r\n\r\nimport (\r\n\"context\"\r\n)\r\n\r\n// World responds with a greeting.\r\n//encore:api public path=/hello/:name method=GET\r\nfunc World(ctx context.Context, name string) (*WorldResponse, error) {\r\nmsg := \"Hello, \" + name + \"!\"\r\nreturn &WorldResponse{Message: msg}, nil\r\n}\r\n\r\ntype WorldResponse struct {\r\nMessage string `json:\"message\"`\r\n}\r\n"]
[60.588187, "o", "\u001b[?2004hroot@22b4e9b4-c13b-4427-be61-b2145d2c87c0:/home/user/helloworld-zrl8wvcn46# "]
