[449.604258, "o", "grep -n 'api_transformer\\|api_transform' /home/user/myproject/.venv/lib/python3.12/site-packages/reflex/app.py | head -20\r\n\u001b[?2004l\r"]
[449.611558, "o", "348:        api_transformer: One or more transforms applied to the backend ASGI app before it runs — mount a FastAPI/Starlette app or wrap it in ASGI middleware. See the [API Transformer docs](https://reflex.dev/docs/api-routes/overview/) for examples.\r\n"]
[449.611832, "o", "439:    api_transformer: (\r\n740:        if self.api_transformer is not None:\r\n741:            api_transformers: Sequence[Starlette | Callable[[ASGIApp], ASGIApp]] = (\r\n742:                [self.api_transformer]\r\n743:                if not isinstance(self.api_transformer, Sequence)\r\n744:                else self.api_transformer\r\n747:            for api_transformer in api_transformers:\r\n748:                if isinstance(api_transformer, Starlette):\r\n750:                    App._add_cors(api_transformer)\r\n751:                    api_transformer.mount(\"\", asgi_app)\r\n752:                    asgi_app = api_transformer\r\n755:                    asgi_app = api_transformer(asgi_app)\r\n"]
[449.612076, "o", "\u001b[?2004hroot@5f3a9581-5439-489d-a5dd-98df5dbc3f88:/home/user/myproject# "]
[453.610504, "i", "sed -n '730,770p' /home/user/myproject/.venv/lib/python3.12/site-packages/reflex/app.py\n"]
