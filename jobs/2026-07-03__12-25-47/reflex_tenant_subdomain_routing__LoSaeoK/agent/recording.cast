[17.447084, "o", "\u001b[1m\u001b[31merror:\u001b[0m unexpected argument '\u001b[33m--template\u001b[0m' found\r\n\r\n  \u001b[32mtip:\u001b[0m to pass '\u001b[33m--template\u001b[0m' as a value, use '\u001b[32m-- --template\u001b[0m'\r\n\r\n\u001b[1m\u001b[32mUsage:\u001b[0m \u001b[1m\u001b[36muv init\u001b[0m \u001b[36m[OPTIONS]\u001b[0m \u001b[36m[PATH]\u001b[0m\r\n\r\nFor more information, try '\u001b[1m\u001b[36m--help\u001b[0m'.\r\n"]
