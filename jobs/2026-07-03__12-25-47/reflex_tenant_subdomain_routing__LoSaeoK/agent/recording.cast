[171.557962, "o", "Usage: reflex init [OPTIONS]\r\n\r\n  Initialize a new Reflex app in the current directory.\r\n\r\nOptions:\r\n  --loglevel, --log-level [debug|default|info|warning|error|critical]\r\n                                  The log level to use.\r\n  --name APP_NAME                 The name of the app to initialize.\r\n  --template TEXT                 The template to initialize the app with.\r\n  --ai                            Use AI to create the initial template.\r\n                                  Cannot be used with existing app or\r\n                                  `--template` option.\r\n  --agents / --no-agents          Write an AGENTS.md to guide AI coding agents\r\n                                  working in the app (enabled by default).\r\n  --help                          Show this message and exit.\r\n"]
