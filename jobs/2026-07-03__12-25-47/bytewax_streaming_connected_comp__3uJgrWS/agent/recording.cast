[88.671608, "o", "\u001b[32m\u001b[K118\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K    \u001b[01;31m\u001b[Kdef \u001b[m\u001b[Klist_parts(self) -> List[str]:\r\n\u001b[32m\u001b[K128\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K    \u001b[01;31m\u001b[Kdef \u001b[m\u001b[Kbuild_part(\r\n\u001b[32m\u001b[K136\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[01;31m\u001b[Kclass \u001b[m\u001b[KFileSource(FixedPartitionedSource[str, int]):\r\n\u001b[32m\u001b[K151\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K    \u001b[01;31m\u001b[Kdef \u001b[m\u001b[K__init__(\r\n\u001b[32m\u001b[K185\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K    \u001b[01;31m\u001b[Kdef \u001b[m\u001b[Klist_parts(self) -> List[str]:\r\n\u001b[32m\u001b[K192\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K    \u001b[01;31m\u001b[Kdef \u001b[m\u001b[Kbuild_part(\r\n\u001b[32m\u001b[K202\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[01;31m\u001b[Kclass \u001b[m\u001b[K_CSVPartition(StatefulSourcePartition[Dict[str, str], int]):\r\n\u001b[32m\u001b[K203\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K    \u001b[01;31m\u001b[Kdef \u001b[m\u001b[K__init__(\r\n\u001b[32m\u001b[K219\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K    \u001b[01;31m\u001b[Kdef \u001b[m\u001b[Knext_batch(self) -> List[Dict[str, str]]:\r\n\u001b[32m\u001b[K223\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K    \u001b[01;31m\u001b[Kdef \u001b[m\u001b[Ksnapshot(self) -> int:\r\n"]
