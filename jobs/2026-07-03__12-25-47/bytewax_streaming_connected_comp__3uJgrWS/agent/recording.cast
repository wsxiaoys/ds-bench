[75.182954, "o", "    _create_arg_parser,\r\n    _EnvDefault,\r\n)\r\nfrom typing_extensions import override\r\n\r\n__all__ = [\r\n    \"TestingSink\",\r\n    \"TestingSource\",\r\n    \"TimeTestingGetter\",\r\n    \"ffwd_iter\",\r\n    \"poll_next_batch\",\r\n    \"run_main\",\r\n    \"cluster_main\",\r\n]\r\n\r\n\r\n@dataclass\r\nclass TimeTestingGetter:\r\n    \"\"\"Wrapper to provide a modifyable system clock for unit tests.\"\"\"\r\n"]
