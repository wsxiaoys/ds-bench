[117.085407, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[117.085678, "o", "def parse_edge(line: str) -> Dict[str, str]:\r\n\u001b[?2004l\r"]
[117.085754, "o", "\u001b[?2004h> "]
[117.086175, "o", "    \"\"\"Parse a single JSONL line into an ``{\"u\": ..., \"v\": ...}`` dict.\"\"\"\r\n\u001b[?2004l\r"]
[117.086246, "o", "\u001b[?2004h> "]
[117.08639, "o", "    obj = json.loads(line)\r\n\u001b[?2004l\r"]
[117.086462, "o", "\u001b[?2004h> "]
[117.086715, "o", "    return {\"u\": obj[\"u\"], \"v\": obj[\"v\"]}\r\n\u001b[?2004l\r"]
[117.086788, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[117.086864, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[117.086979, "o", "def process_edge(\r\n\u001b[?2004l\r"]
[117.087054, "o", "\u001b[?2004h> "]
[117.08735, "o", "    state: Optional[UnionFind], edge: Dict[str, str]\r\n\u001b[?2004l\r"]
[117.087423, "o", "\u001b[?2004h> "]
[117.087644, "o", ") -> Tuple[UnionFind, Dict[str, Any]]:\r\n\u001b[?2004l\r"]
[117.087718, "o", "\u001b[?2004h> "]
[117.08809, "o", "    \"\"\"Update Union-Find with a single edge and produce an event.\r\n\u001b[?2004l\r"]
[117.088164, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[117.088233, "o", "> "]
[117.088662, "o", "    Returns ``(updated_state, emitted_event)``. ``emitted_event`` is a dict\r\n\u001b[?2004l\r"]
[117.088732, "o", "\u001b[?2004h> "]
[117.08893, "o", "    ready to be serialized as JSON.\r\n\u001b[?2004l\r"]
[117.088999, "o", "\u001b[?2004h> "]
[117.089075, "o", "    \"\"\"\r\n\u001b[?2004l\r\u001b[?2004h> "]
[117.089219, "o", "    if state is None:\r\n\u001b[?2004l\r"]
[117.089288, "o", "\u001b[?2004h> "]
[117.089451, "o", "        state = UnionFind()\r\n\u001b[?2004l\r"]
[117.089524, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[117.089621, "o", "> "]
[117.089763, "o", "    u, v = edge[\"u\"], edge[\"v\"]\r\n\u001b[?2004l\r"]
[117.089838, "o", "\u001b[?2004h> "]
[117.090037, "o", "    merged, size = state.union(u, v)\r\n\u001b[?2004l\r"]
[117.090105, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[117.09018, "o", "> "]
[117.090254, "o", "    if merged:\r\n\u001b[?2004l\r\u001b[?2004h"]
[117.090324, "o", "> "]
[117.090407, "o", "        event = {\r\n\u001b[?2004l\r"]
[117.090481, "o", "\u001b[?2004h> "]
[117.090628, "o", "            \"u\": u,\r\n\u001b[?2004l\r"]
[117.090706, "o", "\u001b[?2004h> "]
[117.090781, "o", "            \"v\": v,\r\n\u001b[?2004l\r\u001b[?2004h"]
[117.090852, "o", "> "]
[117.090998, "o", "            \"status\": \"merged\",\r\n\u001b[?2004l\r"]
[117.09107, "o", "\u001b[?2004h> "]
[117.091308, "o", "            \"new_component_size\": size,\r\n\u001b[?2004l\r"]
[117.091395, "o", "\u001b[?2004h> "]
[117.091465, "o", "        }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[117.091543, "o", "    else:\r\n\u001b[?2004l\r\u001b[?2004h"]
[117.091643, "o", "> "]
[117.091744, "o", "        event = {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[117.091887, "o", "            \"u\": u,\r\n\u001b[?2004l\r"]
[117.091963, "o", "\u001b[?2004h> "]
[117.092071, "o", "            \"v\": v,\r\n\u001b[?2004l\r\u001b[?2004h"]
[117.092131, "o", "> "]
[117.092377, "o", "            \"status\": \"already_connected\",\r\n\u001b[?2004l\r"]
[117.092475, "o", "\u001b[?2004h> "]
[117.092654, "o", "            \"component_size\": size,\r\n\u001b[?2004l\r"]
[117.092703, "o", "\u001b[?2004h> "]
[117.092797, "o", "        }\r\n\u001b[?2004l\r\u001b[?2004h"]
[117.092914, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[117.093028, "o", "    return state, event\r\n\u001b[?2004l\r"]
[117.093095, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[117.093157, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[117.093222, "o", "> "]
[117.093493, "o", "def to_json_line(event: Dict[str, Any]) -> str:\r\n\u001b[?2004l\r"]
[117.093554, "o", "\u001b[?2004h> "]
[117.093944, "o", "    \"\"\"Serialize an event dict to a single-line JSON string.\"\"\"\r\n\u001b[?2004l\r"]
[117.094004, "o", "\u001b[?2004h> "]
[117.094437, "o", "    return json.dumps(event, separators=(\",\", \":\"), sort_keys=False)\r\n\u001b[?2004l\r"]
[117.094501, "o", "\u001b[?2004h> "]
[117.094562, "o", "\r\n\u001b[?2004l\r\u001b[?2004h"]
[117.094726, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[117.095117, "o", "# ---------------------------------------------------------------------------\r\n\u001b[?2004l\r"]
[117.095196, "o", "\u001b[?2004h> "]
[117.095328, "o", "# Dataflow construction\r\n\u001b[?2004l\r"]
[117.095381, "o", "\u001b[?2004h> "]
[117.095871, "o", "# ---------------------------------------------------------------------------\r\n\u001b[?2004l\r"]
[117.095924, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[117.096036, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[117.096231, "o", "def build_output_path() -> Path:\r\n\u001b[?2004l\r"]
[117.09628, "o", "\u001b[?2004h> "]
[117.096714, "o", "    \"\"\"Build the output file path using the current run id.\"\"\"\r\n\u001b[?2004l\r"]
[117.096782, "o", "\u001b[?2004h> "]
[117.097051, "o", "    run_id = RUN_ID_PATH.read_text().strip()\r\n\u001b[?2004l\r"]
[117.097113, "o", "\u001b[?2004h> "]
[117.097455, "o", "    return GRAPH_DIR / f\"output_events_{run_id}.jsonl\"\r\n\u001b[?2004l\r"]
[117.097515, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[117.09763, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[117.097899, "o", "def build_dataflow() -> Tuple[Dataflow, Path]:\r\n\u001b[?2004l\r"]
[117.097954, "o", "\u001b[?2004h> "]
[117.098261, "o", "    \"\"\"Build the connected-components dataflow.\"\"\"\r\n\u001b[?2004l\r"]
[117.098311, "o", "\u001b[?2004h> "]
[117.098663, "o", "    flow = Dataflow(\"connected_components\")\r\n\u001b[?2004l\r"]
[117.09876, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[117.098873, "o", "    # 1. Read raw JSONL lines.\r\n\u001b[?2004l\r"]
[117.098922, "o", "\u001b[?2004h> "]
[117.099296, "o", "    raw = op.input(\"edges_in\", flow, FileSource(INPUT_PATH))\r\n\u001b[?2004l\r"]
[117.099346, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[117.099447, "o", "\u001b[?2004h> "]
[117.099685, "o", "    # 2. Parse each line into an {u, v} dict.\r\n\u001b[?2004l\r"]
[117.099731, "o", "\u001b[?2004h> "]
[117.100007, "o", "    edges = op.map(\"parse\", raw, parse_edge)\r\n\u001b[?2004l\r"]
[117.100052, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[117.10016, "o", "\u001b[?2004h> "]
[117.100544, "o", "    # 3. Route every edge to the same keyed partition so that all state\r\n\u001b[?2004l\r"]
[117.100605, "o", "\u001b[?2004h> "]
[117.100909, "o", "    #    modifications happen on a single instance.\r\n\u001b[?2004l\r"]
[117.100952, "o", "\u001b[?2004h> "]
[117.108033, "o", "    keyed = op.key_on(\"single_partition\", edges, lambda _e: PARTITION_KEY)\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h>     # 4. Maintain Union-Find per partition and emit a status event.\r\n\u001b[?2004l\r\u001b[?2004h>     stateful = op.stateful_map(\"union_find\", keyed, process_edge)\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h>     # 5. Drop the key (the underlying FileSink is a FixedPartitionedSink\r\n\u001b[?2004l\r\u001b[?2004h>     #    that expects (key, value) tuples but our output file is single\r\n\u001b[?2004l\r\u001b[?2004h>     #    partitioned so we can just write the values).\r\n\u001b[?2004l\r\u001b[?2004h>     values = op.map_value(\"drop_key\", stateful, to_json_line)\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h>     # 6. Write JSON lines to the output file.\r\n\u001b[?2004l\r\u001b[?2004h> "]
[117.108153, "o", "    output_path = build_output_path()\r\n\u001b[?2004l\r\u001b[?2004h"]
[117.108259, "o", "> "]
[117.108563, "o", "    op.output(\"events_out\", values, FileSink(output_path))\r\n\u001b[?2004l\r\u001b[?2004h"]
[117.108677, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[117.108859, "o", "    return flow, output_path\r\n\u001b[?2004l\r\u001b[?2004h"]
[117.108938, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[117.109044, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[117.109462, "o", "# When executed via `python -m bytewax.run pipeline:get_flow` the CLI\r\n\u001b[?2004l\r"]
[117.109536, "o", "\u001b[?2004h> "]
[117.109978, "o", "# will import this module and look for a dataflow object exposed by the\r\n\u001b[?2004l\r\u001b[?2004h"]
[117.110047, "o", "> "]
[117.110467, "o", "# name below. We also support being imported as a library so the dataflow\r\n\u001b[?2004l\r\u001b[?2004h"]
[117.110546, "o", "> "]
[117.110752, "o", "# can be inspected programmatically.\r\n\u001b[?2004l\r\u001b[?2004h"]
[117.110846, "o", "> "]
[117.111036, "o", "flow, _OUTPUT_PATH = build_dataflow()\r\n\u001b[?2004l\r\u001b[?2004h"]
[117.1111, "o", "> "]
[117.111266, "o", "get_flow = lambda: flow\r\n\u001b[?2004l\r\u001b[?2004h"]
[117.111332, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h"]
[117.111496, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[117.111684, "o", "if __name__ == \"__main__\":\r\n\u001b[?2004l\r"]
[117.11175, "o", "\u001b[?2004h> "]
[117.112221, "o", "    # Allow direct invocation for quick debugging; the CLI is preferred\r\n\u001b[?2004l\r\u001b[?2004h"]
[117.112292, "o", "> "]
[117.112701, "o", "    # for production because it supports recovery and multi-process\r\n\u001b[?2004l\r"]
[117.112785, "o", "\u001b[?2004h> "]
[117.11288, "o", "    # scaling.\r\n\u001b[?2004l\r"]
[117.113089, "o", "\u001b[?2004h> "]
[117.113191, "o", "    from bytewax.testing import run_main\r\n\u001b[?2004l\r"]
[117.113286, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[117.113361, "o", "\u001b[?2004h> "]
[117.113634, "o", "    flow_local, _ = build_dataflow()\r\n\u001b[?2004l\r"]
[117.113714, "o", "\u001b[?2004h> "]
[117.113855, "o", "    run_main(flow_local)\r\n\u001b[?2004l\r"]
[117.113928, "o", "\u001b[?2004h> "]
[117.114048, "o", "EOF\r\n\u001b[?2004l\r"]
[117.127886, "o", "\u001b[?2004hroot@a7a4e5d6-ccfd-45a5-8e77-16f79289d68a:~# "]
[117.44394, "i", "ls -la /home/user/graph_pipeline/\n"]
[117.444333, "o", "ls -la /home/user/graph_pipeline/\r\n\u001b[?2004l\r"]
[117.446705, "o", "total 12\r\n"]
[117.446749, "o", "drwxr-xr-x 1 root root   33 Jul  3 13:12 \u001b[0m\u001b[01;34m.\u001b[0m\r\ndrwxr-xr-x 1 root root   36 Jul  3 13:10 \u001b[01;34m..\u001b[0m\r\n-rw-r--r-- 1 root root  105 Jul  3 13:10 input_edges.jsonl\r\n-rw-r--r-- 1 root root 6326 Jul  3 13:12 pipeline.py\r\n"]
[117.447061, "o", "\u001b[?2004h"]
[117.447118, "o", "root@a7a4e5d6-ccfd-45a5-8e77-16f79289d68a:~# "]
[122.416357, "i", "sed -n '450,510p' /usr/local/lib/python3.12/dist-packages/bytewax/operators/__init__.py\n"]
[122.417067, "o", "sed -n '450,510p' /usr/local/lib/python3.12/dist-packages/bytewax/operators/__init__.py\r\n\u001b[?2004l\r"]
[122.418924, "o", "def output(step_id: str, up: Stream[X], sink: Sink[X]) -> None:\r\n    \"\"\"Write items out of a dataflow.\r\n\r\n    ```{testcode}\r\n    from bytewax.dataflow import Dataflow\r\n    import bytewax.operators as op\r\n"]
[122.418953, "o", "    from bytewax.testing import TestingSource\r\n    from bytewax.connectors.stdio import StdOutSink\r\n\r\n    flow = Dataflow(\"output_eg\")\r\n    nums = op.input(\"nums\", flow, TestingSource([1, 2, 3]))\r\n\r\n    # This will print the items to stdout.\r\n    # You can replace this with any other sink.\r\n    op.output(\"sink\", nums, StdOutSink())\r\n    ```\r\n\r\n"]
[122.418975, "o", "    ```{testcode}\r\n    :hide:\r\n\r\n    from bytewax.testing import run_main\r\n\r\n    run_main(flow)\r\n    ```\r\n\r\n"]
[122.419089, "o", "    ```{testoutput}\r\n    1\r\n    2\r\n    3\r\n    ```\r\n\r\n    See {py:obj}`bytewax.outputs` for more information on how output\r\n    works. See {py:obj}`bytewax.connectors` for a buffet of our\r\n    built-in connector types.\r\n\r\n    :arg step_id: Unique ID.\r\n\r\n    :arg up: Stream of items to write. See your specific\r\n        {py:obj}`~bytewax.outputs.Sink` documentation for the required\r\n        type of those items.\r\n\r\n    :arg sink: Write items to.\r\n\r\n    \"\"\"\r\n    return None\r\n\r\n\r\n@operator(_core=True)\r\ndef redistribute(step_id: str, up: Stream[X]) -> Stream[X]:\r\n    \"\"\"Redistributes data across workers in a Bytewax dataflow.\r\n\r\n    The `{py:obj}~bytewax.operators.redistribute` operator is\r\n"]
[122.419136, "o", "    useful for redistributing work to\r\n    achieve better parallelization in a distributed dataflow.\r\n    It moves each incoming item to a random worker to balance the workload,\r\n    especially in cases where a prior step concentrates data on only a\r\n    few workers, leading to poor utilization of CPU resources across the cluster.\r\n\r\n    Bytewax will exchange an item between workers before stateful steps\r\n    to ensure correctness, but stateless operators like\r\n    `{py:obj}~bytewax.operators.filter` are run\r\n"]
[122.419785, "o", "\u001b[?2004h"]
[122.419866, "o", "root@a7a4e5d6-ccfd-45a5-8e77-16f79289d68a:~# "]
[125.875123, "i", "sed -n '450,470p' /usr/local/lib/python3.12/dist-packages/bytewax/operators/__init__.py\n"]
[125.875609, "o", "sed -n '450,470p' /usr/local/lib/python3.12/dist-packages/bytewax/operators/__init__.py\r\n\u001b[?2004l\r"]
[125.877474, "o", "def output(step_id: str, up: Stream[X], sink: Sink[X]) -> None:\r\n    \"\"\"Write items out of a dataflow.\r\n\r\n    ```{testcode}\r\n    from bytewax.dataflow import Dataflow\r\n    import bytewax.operators as op\r\n    from bytewax.testing import TestingSource\r\n    from bytewax.connectors.stdio import StdOutSink\r\n\r\n    flow = Dataflow(\"output_eg\")\r\n    nums = op.input(\"nums\", flow, TestingSource([1, 2, 3]))\r\n\r\n    # This will print the items to stdout.\r\n    # You can replace this with any other sink.\r\n    op.output(\"sink\", nums, StdOutSink())\r\n"]
[125.877528, "o", "    ```\r\n\r\n    ```{testcode}\r\n    :hide:\r\n\r\n    from bytewax.testing import run_main\r\n"]
[125.878042, "o", "\u001b[?2004hroot@a7a4e5d6-ccfd-45a5-8e77-16f79289d68a:~# "]
[130.677097, "i", "cd /home/user/graph_pipeline && python3 pipeline.py 2>&1 | head -50\n"]
[130.677635, "o", "cd /home/user/graph_pipeline && python3 pipeline.py 2>&1 | head -50\r\n\u001b[?2004l\r"]
[130.799028, "o", "\u001b[?2004hroot@a7a4e5d6-ccfd-45a5-8e77-16f79289d68a:/home/user/graph_pipeline# "]
[143.76743, "i", "ls -la /home/user/graph_pipeline/\n"]
[143.767773, "o", "ls -la /home/user/graph_pipeline/\r\n\u001b[?2004l\r"]
[143.76918, "o", "total 16\r\n"]
[143.769219, "o", "drwxr-xr-x 1 root root   75 Jul  3 13:13 \u001b[0m\u001b[01;34m.\u001b[0m\r\ndrwxr-xr-x 1 root root   36 Jul  3 13:10 \u001b[01;34m..\u001b[0m\r\n-rw-r--r-- 1 root root  105 Jul  3 13:10 input_edges.jsonl\r\n-rw-r--r-- 1 root root  302 Jul  3 13:13 output_events_zr7scukw36.jsonl\r\n-rw-r--r-- 1 root root 6326 Jul  3 13:12 pipeline.py\r\n"]
[143.769486, "o", "\u001b[?2004h"]
[143.769517, "o", "root@a7a4e5d6-ccfd-45a5-8e77-16f79289d68a:/home/user/graph_pipeline# "]
[144.090343, "i", "cat /home/user/graph_pipeline/output_events_zr7scukw36.jsonl\n"]
[144.090785, "o", "cat /home/user/graph_pipeline/output_events_zr7scukw36.jsonl\r\n\u001b[?2004l\r"]
[144.091624, "o", "{\"u\":\"A\",\"v\":\"B\",\"status\":\"merged\",\"new_component_size\":2}\r\n{\"u\":\"B\",\"v\":\"C\",\"status\":\"merged\",\"new_component_size\":3}\r\n{\"u\":\"A\",\"v\":\"C\",\"status\":\"already_connected\",\"component_size\":3}\r\n{\"u\":\"D\",\"v\":\"E\",\"status\":\"merged\",\"new_component_size\":2}\r\n{\"u\":\"C\",\"v\":\"E\",\"status\":\"merged\",\"new_component_size\":5}\r\n"]
[144.091793, "o", "\u001b[?2004hroot@a7a4e5d6-ccfd-45a5-8e77-16f79289d68a:/home/user/graph_pipeline# "]
[149.603846, "i", "rm /home/user/graph_pipeline/output_events_zr7scukw36.jsonl\n"]
[149.604621, "o", "rm /home/user/graph_pipeline/output_events_zr7scukw36.jsonl\r\n\u001b[?2004l\r"]
[149.606605, "o", "\u001b[?2004hroot@a7a4e5d6-ccfd-45a5-8e77-16f79289d68a:/home/user/graph_pipeline# "]
[149.926113, "i", "mkdir -p /tmp/recovery_db && python3 -m bytewax.recovery /tmp/recovery_db 1\n"]
[149.926922, "o", "mkdir -p /tmp/recovery_db && python3 -m bytewax.recovery /tmp/recovery_db 1\r\n\u001b[?2004l\r"]
[149.964301, "o", "\u001b[?2004hroot@a7a4e5d6-ccfd-45a5-8e77-16f79289d68a:/home/user/graph_pipeline# "]
[151.923226, "i", "ls /tmp/recovery_db\n"]
[151.923671, "o", "ls /tmp/recovery_db\r\n\u001b[?2004l\r"]
[151.925527, "o", "part-0.sqlite3\r\n"]
[151.925877, "o", "\u001b[?2004hroot@a7a4e5d6-ccfd-45a5-8e77-16f79289d68a:/home/user/graph_pipeline# "]
