[88.671722, "o", "\u001b[32m\u001b[K308\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K    \u001b[01;31m\u001b[Kdef \u001b[m\u001b[Klist_parts(self) -> List[str]:\r\n\u001b[32m\u001b[K312\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K    \u001b[01;31m\u001b[Kdef \u001b[m\u001b[Kbuild_part(self, step_id: str, for_part: str, resume_state: Optional[Any]):\r\n\u001b[32m\u001b[K325\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[01;31m\u001b[Kclass \u001b[m\u001b[K_FileSinkPartition(StatefulSinkPartition[str, int]):\r\n\u001b[32m\u001b[K326\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K    \u001b[01;31m\u001b[Kdef \u001b[m\u001b[K__init__(self, path: Path, resume_state: Optional[int], end: str):\r\n\u001b[32m\u001b[K334\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K    \u001b[01;31m\u001b[Kdef \u001b[m\u001b[Kwrite_batch(self, values: List[str]) -> None:\r\n\u001b[32m\u001b[K342\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K    \u001b[01;31m\u001b[Kdef \u001b[m\u001b[Ksnapshot(self) -> int:\r\n\u001b[32m\u001b[K346\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K    \u001b[01;31m\u001b[Kdef \u001b[m\u001b[Kclose(self) -> None:\r\n\u001b[32m\u001b[K350\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[01;31m\u001b[Kclass \u001b[m\u001b[KDirSink(FixedPartitionedSink[str, int]):\r\n\u001b[32m\u001b[K368\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K    \u001b[01;31m\u001b[Kdef \u001b[m\u001b[K__init__(\r\n"]
[88.671783, "o", "\u001b[32m\u001b[K404\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K    \u001b[01;31m\u001b[Kdef \u001b[m\u001b[Klist_parts(self) -> List[str]:\r\n\u001b[32m\u001b[K408\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K    \u001b[01;31m\u001b[Kdef \u001b[m\u001b[Kpart_fn(self, item_key: str) -> int:\r\n\u001b[32m\u001b[K412\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K    \u001b[01;31m\u001b[Kdef \u001b[m\u001b[Kbuild_part(\r\n\u001b[32m\u001b[K419\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[01;31m\u001b[Kclass \u001b[m\u001b[KFileSink(FixedPartitionedSink[str, int]):\r\n\u001b[32m\u001b[K436\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K    \u001b[01;31m\u001b[Kdef \u001b[m\u001b[K__init__(self, path: Path, end: str = \"\\n\"):\r\n\u001b[32m\u001b[K449\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K    \u001b[01;31m\u001b[Kdef \u001b[m\u001b[Klist_parts(self) -> List[str]:\r\n\u001b[32m\u001b[K453\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K    \u001b[01;31m\u001b[Kdef \u001b[m\u001b[Kpart_fn(self, item_key: str) -> int:\r\n\u001b[32m\u001b[K457\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K    \u001b[01;31m\u001b[Kdef \u001b[m\u001b[Kbuild_part(\r\n"]
[88.672067, "o", "\u001b[?2004hroot@a7a4e5d6-ccfd-45a5-8e77-16f79289d68a:~# "]
