[?2004l=== schema.ts ===
import { defineSchema, defineTable } from "convex/server";
import { v } from "convex/values";

export default defineSchema({
  products: defineTable({
    runId: v.string(),
    name: v.string(),
    category: v.string(),
    price: v.number(),
    inStock: v.boolean(),
  })
    .index("by_runId_and_category", ["runId", "category"])
    .index("by_runId_category_price", ["runId", "category", "price"]),
});
[?2004hroot@d35da407-7921-4367-a953-202e38411a0b:/home/user/myproject# echo "=== products.ts ===" && cat /home/user/myproject/convex/products.ts
[?2004l=== products.ts ===
import { mutation, query } from "./_generated/server";
import { v } from "convex/values";

export const seed = mutation({
  args: {
    runId: v.string(),
  },
  handler: async (ctx, args) => {
    await ctx.db.insert("products", {
      runId: args.runId,
      name: "Laptop",
      category: "Electronics",
      price: 500,
      inStock: true,
    });
    await ctx.db.insert("products", {
      runId: args.runId,
      name: "Smart TV",
      category: "Electronics",
      price: 1500,
      inStock: true,
    });
    await ctx.db.insert("products", {
      runId: args.runId,
      name: "Headphones",
      category: "Electronics",
      price: 200,
      inStock: false,
    });
    await ctx.db.insert("products", {
      runId: args.runId,
      name: "Desk Chair",
      category: "Furniture",
      price: 250,
      inStock: true,
    });
    await ctx.db.insert("products", {
      runId: args.runId,
      name: "Coffee Table",
      category: "Furniture",
      price: 400,
      inStock: true,
    });
  },
});

export const getByCategory = query({
  args: {
    runId: v.string(),
    category: v.string(),
  },
  handler: async (ctx, args) => {
    return await ctx.db
      .query("products")
      .withIndex("by_runId_and_category", (q) =>
        q.eq("runId", args.runId).eq("category", args.category),
      )
      .collect();
  },
});

export const getCheapByCategory = query({
  args: {
    runId: v.string(),
    category: v.string(),
    maxPrice: v.number(),
  },
  handler: async (ctx, args) => {
    return await ctx.db
      .query("products")
      .withIndex("by_runId_category_price", (q) =>
        q
          .eq("runId", args.runId)
          .eq("category", args.category)
          .lte("price", args.maxPrice),
      )
      .collect();
  },
});
