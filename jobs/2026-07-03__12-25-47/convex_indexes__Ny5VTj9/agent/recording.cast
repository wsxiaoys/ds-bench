[39.291696, "i", "cat > convex/products.ts << 'EOF'\nimport { mutation, query } from \"./_generated/server\";\nimport { v } from \"convex/values\";\n\nexport const seed = mutation({\n  args: {\n    runId: v.string(),\n  },\n  handler: async (ctx, args) => {\n    await ctx.db.insert(\"products\", {\n      runId: args.runId,\n      name: \"Laptop\",\n      category: \"Electronics\",\n      price: 500,\n      inStock: true,\n    });\n    await ctx.db.insert(\"products\", {\n      runId: args.runId,\n      name: \"Smart TV\",\n      category: \"Electronics\",\n      price: 1500,\n      inStock: true,\n    });\n    await ctx.db.insert(\"products\", {\n      runId: args.runId,\n      name: \"Headphones\",\n      category: \"Electronics\",\n      price: 200,\n      inStock: false,\n    });\n    await ctx.db.insert(\"products\", {\n      runId: args.runId,\n      name: \"Desk Chair\",\n      category: \"Furniture\",\n      price: 250,\n      inStock: true,\n    });\n    await ctx.db.insert(\"products\", {\n      runId: args.runId,\n      name: \"Coffee Table\",\n      category: \"Furniture\",\n      price: 400,\n      inStock: true,\n    });\n  },\n});\n\nexport const getByCategory = query({\n  args: {\n    runId: v.string(),\n    category: v.string(),\n  },\n  handler: async (ctx, args) => {\n    return await ctx.db\n      .query(\"products\")\n      .withIndex(\"by_runId_and_category\", (q) =>\n        q.eq(\"runId\", args.runId).eq(\"category\", args.category),\n      )\n      .collect();\n  },\n});\n\nexport const getCheapByCategory = query({\n  args: {\n    runId: v.string(),\n    category: v.string(),\n    maxPrice: v.number(),\n  },\n  handler: async (ctx, args) => {\n    return await ctx.db\n      .query(\"products\")\n      .withIndex(\"by_runId_category_price\", (q) =>\n        q\n          .eq(\"runId\", args.runId)\n          .eq(\"category\", args.category)\n          .lte(\"price\", args.maxPrice),\n      )\n      .collect();\n  },\n});\nEOF\n"]
