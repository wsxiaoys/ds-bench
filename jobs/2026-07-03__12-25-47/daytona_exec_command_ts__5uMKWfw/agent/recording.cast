[88.212734, "o", "{\r\n  \"name\": \"@daytona/sdk\",\r\n  \"version\": \"0.193.0\",\r\n  \"description\": \"Daytona TypeScript SDK for sandbox management and code execution\",\r\n  \"exports\": {\r\n    \".\": {\r\n      \"import\": {\r\n        \"types\": \"./esm/index.d.ts\",\r\n        \"default\": \"./esm/index.js\"\r\n      },\r\n      \"require\": {\r\n        \"types\": \"./cjs/index.d.ts\",\r\n        \"default\": \"./cjs/index.js\"\r\n      }\r\n    },\r\n    \"./package.json\": \"./package.json\"\r\n  },\r\n  \"main\": \"./cjs/index.js\",\r\n  \"module\": \"./esm/index.js\",\r\n  \"types\": \"./cjs/index.d.ts\",\r\n  \"browser\": {\r\n    \"module\": false,\r\n    \"fs\": false,\r\n    \"stream\": false,\r\n    \"crypto\": false,\r\n    \"buffer\": false,\r\n    \"tar\": false,\r\n    \"fast-glob\": false,\r\n    \"expand-tilde\": false,\r\n    \"@iarna/toml\": false,\r\n    \"form-data\": false,\r\n    \"busboy\": false,\r\n    \"@aws-sdk/client-s3\": false,\r\n    \"@aws-sdk/lib-storage\": false,\r\n    \"@opentelemetry/sdk-node\": false,\r\n    \"@opentelemetry/instrumentation-http\": false,\r\n    \"@opentelemetry/sdk-trace-base\": false,\r\n    \"@opentelemetry/exporter-trace-otlp-http\": false,\r\n    \"@opentelemetry/otlp-exporter-base\": false,\r\n    \"@opentelemetry/semantic-conventions\": false,\r\n    \"@opentelemetry/resources\": false\r\n  },\r\n  \"files\": [\r\n"]
