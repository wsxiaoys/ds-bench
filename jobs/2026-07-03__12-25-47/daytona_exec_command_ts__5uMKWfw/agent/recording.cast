[42.143317, "o", "\u001b[1G\u001b[0K\r\nadded 187 packages, and audited 188 packages in 18s\r\n"]
[42.143513, "o", "⠇\u001b[1G\u001b[0K\r\n⠇\u001b[1G\u001b[0K18 packages are looking for funding\r\n⠇\u001b[1G\u001b[0K  run `npm fund` for details\r\n⠇"]
[42.183878, "o", "\u001b[1G\u001b[0K\r\n\u001b[31m\u001b[1m27\u001b[22m\u001b[39m vulnerabilities (25 \u001b[33m\u001b[1mmoderate\u001b[22m\u001b[39m, 2 \u001b[31m\u001b[1mhigh\u001b[22m\u001b[39m)\r\n\r\nTo address issues that do not require attention, run:\r\n  npm audit fix\r\n\r\nSome issues need review, and may require choosing\r\na different dependency.\r\n\r\nRun `npm audit` for details.\r\n⠏"]
[42.184581, "o", "\u001b[1G\u001b[0K\u001b[1mnpm\u001b[22m \u001b[33mwarn\u001b[39m \u001b[94mallow-scripts\u001b[39m 2 packages have install scripts not yet covered by allowScripts:\r\n\u001b[1mnpm\u001b[22m \u001b[33mwarn\u001b[39m \u001b[94mallow-scripts\u001b[39m   protobufjs@8.0.1 (postinstall: node scripts/postinstall)\r\n\u001b[1mnpm\u001b[22m \u001b[33mwarn\u001b[39m \u001b[94mallow-scripts\u001b[39m   protobufjs@7.6.4 (postinstall: node scripts/postinstall)\r\n\u001b[1mnpm\u001b[22m \u001b[33mwarn\u001b[39m \u001b[94mallow-scripts\u001b[39m\r\n\u001b[1mnpm\u001b[22m \u001b[33mwarn\u001b[39m \u001b[94mallow-scripts\u001b[39m Run `npm approve-scripts --allow-scripts-pending` to review, or `npm approve-scripts <pkg>` to allow.\r\n⠏"]
