[56.992839, "i", "cat > convex/schema.ts << 'EOF'\nimport { defineSchema, defineTable } from \"convex/server\";\nimport { v } from \"convex/values\";\n\nexport default defineSchema({\n  messages: defineTable({\n    body: v.string(),\n    author: v.string(),\n    runId: v.string(),\n  }).searchIndex(\"search_body\", {\n    searchField: \"body\",\n    filterFields: [\"runId\"],\n  }),\n});\nEOF\n"]
