[68.598209, "i", "cat convex/schema.ts\n"]
[68.598404, "o", "cat convex/schema.ts\r\n\u001b[?2004l\r"]
[68.599396, "o", "import { defineSchema, defineTable } from \"convex/server\";\r\nimport { v } from \"convex/values\";\r\n\r\nexport default defineSchema({\r\n  messages: defineTable({\r\n    body: v.string(),\r\n    author: v.string(),\r\n    runId: v.string(),\r\n  }).searchIndex(\"search_body\", {\r\n    searchField: \"body\",\r\n    filterFields: [\"runId\"],\r\n  }),\r\n});\r\n"]
[68.599594, "o", "\u001b[?2004hroot@7cfe4f15-f3a0-4c42-899e-b020d014dff8:/home/user/convex-search# "]
[68.933987, "i", "cat convex/messages.ts\n"]
[68.934224, "o", "cat convex/messages.ts\r\n\u001b[?2004l\r"]
[68.93515, "o", "import { mutation, query } from \"./_generated/server\";\r\nimport { v } from \"convex/values\";\r\nimport { paginationOptsValidator } from \"convex/server\";\r\n\r\nexport const insert = mutation({\r\n  args: {\r\n    body: v.string(),\r\n    author: v.string(),\r\n    runId: v.string(),\r\n  },\r\n  handler: async (ctx, args) => {\r\n    await ctx.db.insert(\"messages\", {\r\n      body: args.body,\r\n      author: args.author,\r\n      runId: args.runId,\r\n    });\r\n  },\r\n});\r\n\r\nexport const search = query({\r\n  args: {\r\n    query: v.string(),\r\n    runId: v.string(),\r\n    paginationOpts: paginationOptsValidator,\r\n  },\r\n  handler: async (ctx, args) => {\r\n    return await ctx.db\r\n      .query(\"messages\")\r\n      .withSearchIndex(\"search_body\", (q) =>\r\n        q.search(\"body\", args.query).eq(\"runId\", args.runId)\r\n      )\r\n      .paginate(args.paginationOpts);\r\n  },\r\n});\r\n"]
[68.935318, "o", "\u001b[?2004hroot@7cfe4f15-f3a0-4c42-899e-b020d014dff8:/home/user/convex-search# "]
[69.253687, "i", "cat test.js\n"]
[69.25389, "o", "cat test.js\r\n\u001b[?2004l\r"]
[69.255098, "o", "const { ConvexHttpClient } = require(\"convex/browser\");\r\n\r\nfunction parseArgs() {\r\n  const args = process.argv.slice(2);\r\n  const opts = {};\r\n  for (let i = 0; i < args.length; i++) {\r\n    if (args[i] === \"--run-id\") {\r\n      opts.runId = args[i + 1];\r\n      i++;\r\n    }\r\n  }\r\n  if (!opts.runId) {\r\n    console.error(\"Usage: node test.js --run-id <run-id>\");\r\n    process.exit(1);\r\n  }\r\n  return opts;\r\n}\r\n\r\nasync function sleep(ms) {\r\n  return new Promise((resolve) => setTimeout(resolve, ms));\r\n}\r\n\r\nasync function main() {\r\n  const { runId } = parseArgs();\r\n  const convexUrl = process.env.CONVEX_URL;\r\n  if (!convexUrl) {\r\n    console.error(\"CONVEX_URL environment variable is not set\");\r\n    process.exit(1);\r\n  }\r\n  const client = new ConvexHttpClient(convexUrl);\r\n\r\n  // Insert 3 messages\r\n  const messages = [\r\n    { body: \"Hello world\", author: \"Alice\" },\r\n    { body: \"Hello Convex\", author: \"Bob\" },\r\n    { body: \"Hello search\", author: \"Charlie\" },\r\n  ];\r\n\r\n  for (const msg of messages) {\r\n    await client.mutation(\"messages:insert\", {\r\n      body: msg.body,\r\n      author: msg.author,\r\n      runId,\r\n    });\r\n  }\r\n\r\n"]
[69.255125, "o", "  // Poll until search results are found\r\n  let result;\r\n  const maxAttempts = 60;\r\n  for (let attempt = 0; attempt < maxAttempts; attempt++) {\r\n    try {\r\n      result = await client.query(\"messages:search\", {\r\n        query: \"Hello\",\r\n        runId,\r\n        paginationOpts: { numItems: 2, cursor: null },\r\n      });\r\n      if (result && Array.isArray(result.page) && result.page.length > 0) {\r\n        break;\r\n      }\r\n    } catch (e) {\r\n      // swallow and retry\r\n    }\r\n    await sleep(1000);\r\n  }\r\n\r\n  if (!result || !Array.isArray(result.page)) {\r\n    console.error(\"Search did not return results\");\r\n    process.exit(1);\r\n  }\r\n\r\n  console.log(JSON.stringify(result.page));\r\n}\r\n\r\nmain().catch((err) => {\r\n  console.error(err);\r\n  process.exit(1);\r\n});\r\n"]
