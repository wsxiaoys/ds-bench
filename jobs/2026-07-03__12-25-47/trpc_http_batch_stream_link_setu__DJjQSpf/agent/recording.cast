[13.523949, "o", "import { fetchRequestHandler } from '@trpc/server/adapters/fetch';\r\nimport { appRouter } from '@/server/trpc/router';\r\nconst handler = (req: Request) =>\r\n  fetchRequestHandler({\r\n    endpoint: '/api/trpc',\r\n    req,\r\n    router: appRouter,\r\n    createContext: () => ({}),\r\n  });\r\nexport { handler as GET, handler as POST };\r\n"]
