[13.873294, "o", "import Provider from '@/trpc/Provider';\r\nimport './globals.css';\r\nexport default function RootLayout({ children }: { children: React.ReactNode }) {\r\n  return (\r\n    <html lang=\"en\">\r\n      <body>\r\n        <Provider>{children}</Provider>\r\n      </body>\r\n    </html>\r\n  );\r\n}\r\n"]
