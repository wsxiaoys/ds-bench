[232.610421, "o", "\u001b[3m                                       Work Pools                                       \u001b[0m\r\n┏━━━━━━━━━━━━━━━━━┳━━━━━━━━━┳━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━┳━━━━━━━━━━━━━━━━━━━┓\r\n┃\u001b[1m \u001b[0m\u001b[1mName           \u001b[0m\u001b[1m \u001b[0m┃\u001b[1m \u001b[0m\u001b[1mType   \u001b[0m\u001b[1m \u001b[0m┃\u001b[1m \u001b[0m\u001b[1m                                  ID\u001b[0m\u001b[1m \u001b[0m┃\u001b[1m \u001b[0m\u001b[1mConcurrency Limit\u001b[0m\u001b[1m \u001b[0m┃\r\n┡━━━━━━━━━━━━━━━━━╇━━━━━━━━━╇━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━╇━━━━━━━━━━━━━━━━━━━┩\r\n│\u001b[32m \u001b[0m\u001b[32mlocal-work-pool\u001b[0m\u001b[32m \u001b[0m│\u001b[35m \u001b[0m\u001b[35mprocess\u001b[0m\u001b[35m \u001b[0m│\u001b[36m \u001b[0m\u001b[36m843951e4-e9da-46b4-a680-e7c04f857cb6\u001b[0m\u001b[36m \u001b[0m│\u001b[34m \u001b[0m\u001b[34mNone\u001b[0m\u001b[34m             \u001b[0m\u001b[34m \u001b[0m│\r\n└─────────────────┴─────────┴──────────────────────────────────────┴───────────────────┘\r\n\u001b[31m                               (**) denotes a paused pool                               \u001b[0m\r\n"]
