[166.984001, "o", "\u001b[32m╭──────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────╮\u001b[0m\r\n\u001b[32m│\u001b[0m\u001b[32m \u001b[0m\u001b[32mDeployment 'my-flow/pipeline-deployment' successfully created with id '1934a06a-cd78-4b5d-9be0-7824f0f22806'.\u001b[0m\u001b[32m                                               \u001b[0m\u001b[32m \u001b[0m\u001b[32m│\u001b[0m\r\n\u001b[32m╰──────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────╯\u001b[0m\r\n"]
[166.995852, "o", "\r\nTo execute flow runs from these deployments, start a worker in a separate terminal that pulls work from the 'local-work-pool' work pool:\r\n"]
[166.996418, "o", "\r\n\u001b[34m        $ prefect worker start --pool 'local-work-pool'\u001b[0m\r\n"]
[166.996659, "o", "\r\nTo schedule a run for this deployment, use the following command:\r\n"]
[166.996935, "o", "\r\n\u001b[34m        $ prefect deployment run 'my-flow/pipeline-deployment'\u001b[0m\r\n\r\n"]
