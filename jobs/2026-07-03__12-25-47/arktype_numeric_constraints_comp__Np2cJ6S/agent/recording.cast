[105.156392, "i", "cat > test.ts << 'EOF'\nimport { type } from \"arktype\";\n// Try various forms\ntry { const T1 = type(\"1 <= (number.integer) <= 99\"); console.log(\"1:\", T1(5)); } catch (e: any) { console.log(\"err1:\", e.message); }\ntry { const T2 = type(\"1 <= number <= 99\"); console.log(\"2:\", T2(5.5)); } catch (e: any) { console.log(\"err2:\", e.message); }\ntry { const T3 = type(\"number % 5\"); console.log(\"3:\", T3(5)); } catch (e: any) { console.log(\"err3:\", e.message); }\ntry { const T4 = type(\"number %5\"); console.log(\"4:\", T4(5)); } catch (e: any) { console.log(\"err4:\", e.message); }\nEOF\nnpx tsx test.ts\n"]
