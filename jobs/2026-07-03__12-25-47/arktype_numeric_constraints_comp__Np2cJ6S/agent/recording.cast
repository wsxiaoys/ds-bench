[134.386365, "i", "cat > test.ts << 'EOF'\nimport { type } from \"arktype\";\nconst T = type(\"1 <= (number.integer) <= 99 & (number % 5)\");\nfor (const n of [-1, 0, 1, 5, 10, 15, 25, 50, 75, 95, 99, 100]) {\n    const r = T(n);\n    if (r instanceof type.errors) {\n        console.log(`${n}: ERROR -`, r.summary);\n    } else {\n        console.log(`${n}: PASS -`, r);\n    }\n}\nEOF\nnpx tsx test.ts\n"]
