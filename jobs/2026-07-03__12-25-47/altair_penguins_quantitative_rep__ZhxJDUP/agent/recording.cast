[130.250041, "i", "python3 << 'EOF'\nimport json\n\n# Load current datasets\nwith open('/usr/local/lib/python3.12/dist-packages/vega_datasets/datasets.json') as f:\n    data = json.load(f)\n\n# Add penguins entry\ndata['penguins'] = {\n    'filename': 'penguins.json',\n    'format': 'json'\n}\n\n# Save back\nwith open('/usr/local/lib/python3.12/dist-packages/vega_datasets/datasets.json', 'w') as f:\n    json.dump(data, f, indent=2)\n\nprint('Added penguins entry')\nEOF\n"]
