[130.25091, "o", "\u001b[?2004h> "]
[130.251485, "o", "with open('/usr/local/lib/python3.12/dist-packages/vega_datasets/datasets.json') as f:\r\n\u001b[?2004l\r"]
[130.251534, "o", "\u001b[?2004h> "]
[130.251723, "o", "    data = json.load(f)\r\n\u001b[?2004l\r"]
[130.251772, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[130.251868, "o", "\u001b[?2004h> "]
[130.251971, "o", "# Add penguins entry\r\n\u001b[?2004l\r"]
[130.252039, "o", "\u001b[?2004h> "]
[130.252173, "o", "data['penguins'] = {\r\n\u001b[?2004l\r"]
[130.252242, "o", "\u001b[?2004h> "]
[130.252448, "o", "    'filename': 'penguins.json',\r\n\u001b[?2004l\r"]
[130.252517, "o", "\u001b[?2004h> "]
[130.252667, "o", "    'format': 'json'\r\n\u001b[?2004l\r\u001b[?2004h"]
[130.252715, "o", "> }\r\n\u001b[?2004l\r"]
[130.252764, "o", "\u001b[?2004h> "]
[130.25288, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[130.252914, "o", "# Save back\r\n\u001b[?2004l\r"]
[130.252981, "o", "\u001b[?2004h> "]
[130.253557, "o", "with open('/usr/local/lib/python3.12/dist-packages/vega_datasets/datasets.json', 'w') as f:\r\n\u001b[?2004l\r"]
[130.253612, "o", "\u001b[?2004h"]
[130.253659, "o", "> "]
[130.253887, "o", "    json.dump(data, f, indent=2)\r\n\u001b[?2004l\r"]
