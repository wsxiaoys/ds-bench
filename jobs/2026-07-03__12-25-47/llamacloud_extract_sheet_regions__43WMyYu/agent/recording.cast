[32.647182, "i", "cat > /home/user/project/solve.py << 'PYEOF'\nimport os\nfrom pathlib import Path\nfrom llama_cloud import LlamaCloud\nimport urllib.request\n\nDATA_DIR = Path(\"/home/user/project\")\nXLSX_PATH = DATA_DIR / \"data\" / \"sales.xlsx\"\nOUTPUT_DIR = DATA_DIR / \"output\"\nLOG_PATH = OUTPUT_DIR / \"sheets.log\"\n\nOUTPUT_DIR.mkdir(parents=True, exist_ok=True)\n\nclient = LlamaCloud()\n\nwith open(XLSX_PATH, \"rb\") as f:\n    upload = client.files.create(file=f, purpose=\"parse\")\nfile_id = upload.id\nprint(f\"Uploaded file: {file_id}\")\n\njob = client.beta.sheets.parse(\n    file_id=file_id,\n    config={\"generate_additional_metadata\": True},\n)\nprint(f\"Job id: {job.id} status: {job.status}\")\nprint(f\"Regions: {job.regions}\")\nprint(f\"Worksheet metadata: {getattr(job, 'worksheet_metadata', None)}\")\n\n# Build a map of region_id -> (sheet_name, location) from worksheet metadata\nregion_info = {}\nwm = getattr(job, \"worksheet_metadata\", None)\nif wm:\n    for ws in wm:\n        for r in (getattr(ws, \"regions\", None) or []):\n            region_info[r.region_id] = (\n                getattr(ws, \"title\", \"\") or getattr(ws, \"name\", \"\"),\n                getattr(r, \"location\", \"\") or getattr(r, \"range\", \"\"),\n            )\n\nlog_lines = []\nlog_lines.append(f\"Job ID: {job.id}\")\nlog_lines.append(f\"Job Status: {job.status}\")\nlog_lines.append(f\"Region Count: {len(job.regions)}\")\n\nfor region in job.regions:\n    sheet_name, location = region_info.get(region.region_id, (\"\", \"\"))\n    # fallback: try attributes on region itself\n    if not location:\n        location = getattr(region, \"location\", \"\") or getattr(region, \"range\", \"\")\n    if not sheet_name:\n        sheet_name = getattr(region, \"sheet_name\", \"\") or getattr(region, \"worksheet_title\", \"\")\n\n    parquet_path = OUTPUT_DIR / f\"region_{region.region_id}.parquet\"\n\n    table = client.beta.sheets.get_result_table(\n        region_type=region.region_type,\n        spreadsheet_job_id=job.id,\n        region_id=region.region_id,\n    )\n    url = table.url\n    with urllib.request.urlopen(url) as resp, open(parquet_path, \"wb\") as out:\n        out.write(resp.read())\n\n    log_lines.append(\n        f\"Region: {region.region_id} sheet={sheet_name} location={location}\"\n    )\n    log_lines.append(f\"Parquet: {parquet_path}\")\n\nLOG_PATH.write_text(\"\\n\".join(log_lines) + \"\\n\")\nprint(f\"Wrote log to {LOG_PATH}\")\nprint(\"\\n\".join(log_lines))\nPYEOF\n"]
