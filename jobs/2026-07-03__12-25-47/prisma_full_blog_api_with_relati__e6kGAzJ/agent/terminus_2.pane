[?2004l// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id       Int       @id @default(REDACTEDincrement())
  email    String    @unique
  name     String
  posts    Post[]
  comments Comment[]
}

model Post {
  id        Int       @id @default(REDACTEDincrement())
  title     String
  content   String?
  published Boolean   @default(false)
  authorId  Int
  createdAt DateTime  @default(now())
  author    User      @relation(fields: [authorId], references: [id])
  comments  Comment[]
}

model Comment {
  id       Int   @id @default(REDACTEDincrement())
  body     String
  postId   Int
  authorId Int
  post     Post @relation(fields: [postId], references: [id])
  author   User @relation(fields: [authorId], references: [id])
}
