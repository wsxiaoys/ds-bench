[170.034663, "o", "\u001b[1G\u001b[0K\u001b[1mnpm\u001b[22m \u001b[33mwarn\u001b[39m \u001b[94mallow-scripts\u001b[39m 3 packages have install scripts not yet covered by allowScripts:\r\n\u001b[1mnpm\u001b[22m \u001b[33mwarn\u001b[39m \u001b[94mallow-scripts\u001b[39m   @prisma/engines@7.8.0 (install: (install scripts present))\r\n\u001b[1mnpm\u001b[22m \u001b[33mwarn\u001b[39m \u001b[94mallow-scripts\u001b[39m   prisma@7.8.0 (install: (install scripts present))\r\n\u001b[1mnpm\u001b[22m \u001b[33mwarn\u001b[39m \u001b[94mallow-scripts\u001b[39m   better-sqlite3@12.11.1 (install: prebuild-install || node-gyp rebuild --release)\r\n\u001b[1mnpm\u001b[22m \u001b[33mwarn\u001b[39m \u001b[94mallow-scripts\u001b[39m\r\n\u001b[1mnpm\u001b[22m \u001b[33mwarn\u001b[39m \u001b[94mallow-scripts\u001b[39m Run `npm approve-scripts --allow-scripts-pending` to review, or `npm approve-scripts <pkg>` to allow.\r\n⠙"]
