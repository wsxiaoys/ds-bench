[130.145114, "i", "cat > src/app/pages/todos/actions.ts << 'EOF'\n\"use server\";\n\nimport { serverAction } from \"rwsdk/worker\";\n\nexport type Todo = {\n  id: string;\n  title: string;\n};\n\nconst todos: Todo[] = [];\n\nexport function getTodos(): Todo[] {\n  return todos;\n}\n\nexport function resetTodos(): void {\n  todos.length = 0;\n}\n\nexport function removeTodo(id: string): void {\n  const idx = todos.findIndex((t) => t.id === id);\n  if (idx >= 0) {\n    todos.splice(idx, 1);\n  }\n}\n\nexport const addTodo = serverAction(async (formData: FormData) => {\n  const title = String(formData.get(\"title\") || \"\").trim();\n  if (!title) {\n    return;\n  }\n  const newTodo: Todo = {\n    id: crypto.randomUUID(),\n    title,\n  };\n  todos.push(newTodo);\n  return;\n});\n\nexport const deleteTodo = serverAction(async (id: string) => {\n  removeTodo(id);\n  return;\n});\n\nexport const deleteTodoForm = serverAction(async (formData: FormData) => {\n  const id = String(formData.get(\"id\") || \"\");\n  if (id) {\n    removeTodo(id);\n  }\n  return;\n});\nEOF\n"]
