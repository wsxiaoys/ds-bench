[61.196412, "o", "^Iif _loading:$\r\n^I^I_mutex.unlock()$\r\n^I^Ireturn false$\r\n^I_loading = true$\r\n^I_cancel_requested = false$\r\n^I_progress_value = 0.0$\r\n^I_completed = false$\r\n^I_failed = false$\r\n^I_failure_reason = \"\"$\r\n^I_last_resource = null$\r\n^I_current_path = path$\r\n^I_mutex.unlock()$\r\n$\r\n^I# Check existence quickly first$\r\n^Iif not ResourceLoader.exists(path):$\r\n^I^I_mutex.lock()$\r\n^I^I_loading = false$\r\n^I^I_current_path = \"\"$\r\n^I^I_failed = true$\r\n^I^I_failure_reason = \"Resource does not exist: \" + path$\r\n"]
