[549.82457, "i", "python3 << 'PYEOF'\nTAB = chr(9)\ncontent = 'extends Control\\n\\n'\ncontent += '@onready var progress_bar: ProgressBar = $ProgressBar\\n'\ncontent += '@onready var label: Label = $Label\\n\\n'\ncontent += 'func _ready() -> void:\\n'\ncontent += TAB + 'var sl = get_node(\"/root/SceneLoader\")\\n'\ncontent += TAB + 'if sl == null:\\n'\ncontent += TAB + TAB + 'return\\n'\ncontent += TAB + 'if sl.has_signal(\"progress_updated\"):\\n'\ncontent += TAB + TAB + 'sl.progress_updated.connect(_on_progress_updated)\\n'\ncontent += TAB + 'if sl.has_signal(\"load_completed\"):\\n'\ncontent += TAB + TAB + 'sl.load_completed.connect(_on_load_completed)\\n'\ncontent += TAB + 'if sl.has_signal(\"load_failed\"):\\n'\ncontent += TAB + TAB + 'sl.load_failed.connect(_on_load_failed)\\n\\n'\ncontent += 'func _on_progress_updated(fraction: float) -> void:\\n'\ncontent += TAB + 'if progress_bar:\\n'\ncontent += TAB + TAB + 'progress_bar.value = fraction\\n\\n'\ncontent += 'func _on_load_completed(scene) -> void:\\n'\ncontent += TAB + 'if label:\\n'\ncontent += TAB + TAB + 'label.text = \"Load completed\"\\n\\n'\ncontent += 'func _on_load_failed(reason: String) -> void:\\n'\ncontent += TAB + 'if label:\\n'\ncontent += TAB + TAB + 'label.text = \"Load failed: \" + reason\\n'\nwith open('scenes/LoadingScreen.gd', 'w') as f:\n    f.write(content)\nprint('Updated LoadingScreen.gd')\nPYEOF\ncat scenes/LoadingScreen.gd\n"]
