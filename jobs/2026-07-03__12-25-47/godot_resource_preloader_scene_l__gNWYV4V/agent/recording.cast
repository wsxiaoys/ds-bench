[581.212104, "o", "\r\nfunc cancel() -> void:\r\n\t_mutex.lock()\r\n\tif not _loading:\r\n\t\t_mutex.unlock()\r\n\t\treturn\r\n\t_cancel_requested = true\r\n"]
[581.212206, "o", "\t_mutex.unlock()\r\n\tif _current_thread != null and _current_thread.is_started():\r\n\t\t_current_thread.wait_to_finish()\r\n\t_current_thread = null\r\n\t_mutex.lock()\r\n\t_loading = false\r\n\t_cancel_requested = false\r\n\t_current_path = \"\"\r\n\t_progress_value = 0.0\r\n\t_completed = false\r\n\t_failed = false\r\n\t_mutex.unlock()\r\n\r\nfunc is_loading() -> bool:\r\n\t_mutex.lock()\r\n\tvar v := _loading\r\n\t_mutex.unlock()\r\n\treturn v\r\n\r\n\r\nfunc _exit_tree() -> void:\r\n\t_cleanup_thread()\r\n\r\nfunc _cleanup_thread() -> void:\r\n"]
[581.212294, "o", "\t_mutex.lock()\r\n\t_cancel_requested = true\r\n\t_mutex.unlock()\r\n\tif _current_thread != null and _current_thread.is_started():\r\n\t\t_current_thread.wait_to_finish()\r\n\t_current_thread = null\r\n\r\nfunc _load_worker(path: String) -> void:\r\n\tvar last_emit := -1.0\r\n"]
