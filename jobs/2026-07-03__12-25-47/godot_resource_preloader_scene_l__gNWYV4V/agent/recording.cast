[258.063507, "i", "cat > /tmp/gen_full_tests3.py << 'PYEOF'\nTAB = chr(9)\nL = []\ndef w(s=\"\"):\n    L.append(s)\n\nw(\"func _test_nonexistent_path() -> void:\")\nw(TAB + \"_reset_signal_counters()\")\nw(TAB + \"var sl = root.get_node(\\\"SceneLoader\\\")\")\nw(TAB + \"if sl.load_failed.is_connected(_on_failed):\")\nw(TAB + TAB + \"sl.load_failed.disconnect(_on_failed)\")\nw(TAB + \"if sl.load_completed.is_connected(_on_completed):\")\nw(TAB + TAB + \"sl.load_completed.disconnect(_on_completed)\")\nw(TAB + \"sl.load_failed.connect(_on_failed)\")\nw(TAB + \"sl.load_completed.connect(_on_completed)\")\nw(\"\")\nw(TAB + \"var r = sl.start_load(\\\"res://does/not/exist.tscn\\\")\")\nw(TAB + \"if r == true:\")\nw(TAB + TAB + \"_ok(\\\"start_load returned true for nonexistent path\\\")\")\nw(TAB + \"else:\")\nw(TAB + TAB + \"_fail(\\\"start_load did not return true for nonexistent path\\\")\")\nw(\"\")\nw(TAB + \"var t = 0.0\")\nw(TAB + \"while _failed_count == 0 and t < 1.0:\")\nw(TAB + TAB + \"await create_timer(0.05).timeout\")\nw(TAB + TAB + \"t += 0.05\")\nw(\"\")\nw(TAB + \"if _failed_count >= 1:\")\nw(TAB + TAB + \"_ok(\\\"load_failed fired within 1 second\\\")\")\nw(TAB + \"else:\")\nw(TAB + TAB + \"_fail(\\\"load_failed did not fire within 1 second\\\")\")\nw(\"\")\nw(TAB + \"if _completed_count == 0:\")\nw(TAB + TAB + \"_ok(\\\"load_completed did not fire for nonexistent path\\\")\")\nw(TAB + \"else:\")\nw(TAB + TAB + \"_fail(\\\"load_completed fired for nonexistent path\\\")\")\nw(\"\")\nw(TAB + \"if not sl.is_loading():\")\nw(TAB + TAB + \"_ok(\\\"is_loading() returns false after failed load\\\")\")\nw(TAB + \"else:\")\nw(TAB + TAB + \"_fail(\\\"is_loading() returned true after failed load\\\")\")\nw(\"\")\nw(\"func _test_cancel_then_restart() -> void:\")\nw(TAB + \"_reset_signal_counters()\")\nw(TAB + \"var sl = root.get_node(\\\"SceneLoader\\\")\")\nw(TAB + \"if sl.load_completed.is_connected(_on_completed):\")\nw(TAB + TAB + \"sl.load_completed.disconnect