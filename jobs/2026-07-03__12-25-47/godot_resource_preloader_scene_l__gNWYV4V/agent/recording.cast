[126.150712, "o", "[gd_scene load_steps=2 format=3]\r\n\r\n[ext_resource type=\"Script\" path=\"res://scenes/LoadingScreen.gd\" id=\"1\"]\r\n\r\n[node name=\"LoadingScreen\" type=\"Control\"]\r\nanchor_right = 1.0\r\nanchor_bottom = 1.0\r\nscript = ExtResource(\"1\")\r\n\r\n[node name=\"ProgressBar\" type=\"ProgressBar\" parent=\".\"]\r\nanchor_left = 0.5\r\nanchor_top = 0.5\r\nanchor_right = 0.5\r\nanchor_bottom = 0.5\r\noffset_left = -200.0\r\noffset_top = -10.0\r\noffset_right = 200.0\r\noffset_bottom = 10.0\r\nmax_value = 1.0\r\nstep = 0.001\r\nvalue = 0.0\r\n\r\n[node name=\"Label\" type=\"Label\" parent=\".\"]\r\nanchor_left = 0.5\r\nanchor_top = 0.4\r\nanchor_right = 0.5\r\nanchor_bottom = 0.4\r\noffset_left = -200.0\r\noffset_right = 200.0\r\ntext = \"Loading...\"\r\nhorizontal_alignment = 1\r\n"]
