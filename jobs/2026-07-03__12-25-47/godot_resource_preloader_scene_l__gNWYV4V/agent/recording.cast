[38.873793, "o", "extends Node$\r\nclass_name SceneLoader$\r\n$\r\nsignal progress_updated(fraction)$\r\nsignal load_completed(scene)$\r\nsignal load_failed(reason)$\r\n$\r\nvar _loading: bool = false$\r\nvar _current_path: String = \"\"$\r\nvar _current_thread: Thread = null$\r\nvar _mutex: Mutex = Mutex.new()$\r\nvar _cancel_requested: bool = false$\r\nvar _last_resource: Resource = null$\r\nvar _progress_value: float = 0.0$\r\nvar _completed: bool = false$\r\nvar _failed: bool = false$\r\nvar _failure_reason: String = \"\"$\r\n$\r\nfunc start_load(path: String) -> bool:$\r\n_mutex.lock()$\r\nif _loading:$\r\n_mutex.unlock()$\r\nreturn false$\r\n_loading = true$\r\n_cancel_requested = false$\r\n_progress_value = 0.0$\r\n_completed = false$\r\n_failed = false$\r\n_failure_reason = \"\"$\r\n_last_resource = null$\r\n"]
[38.874032, "o", "\u001b[?2004hroot@2e0a24a3-8e9e-458a-b247-d71c89a5615d:/home/user/myproject# "]
[57.259154, "i", "python3 << 'PYEOF'\ncontent = '''extends Node\nclass_name SceneLoader\n\nsignal progress_updated(fraction)\nsignal load_completed(scene)\nsignal load_failed(reason)\n\nvar _loading: bool = false\nvar _current_path: String = \"\"\nvar _current_thread: Thread = null\nvar _mutex: Mutex = Mutex.new()\nvar _cancel_requested: bool = false\nvar _last_resource: Resource = null\nvar _progress_value: float = 0.0\nvar _completed: bool = false\nvar _failed: bool = false\nvar _failure_reason: String = \"\"\n\nfunc start_load(path: String) -> bool:\n\\t_mutex.lock()\n\\tif _loading:\n\\t\\t_mutex.unlock()\n\\t\\treturn false\n\\t_loading = true\n\\t_cancel_requested = false\n\\t_progress_value = 0.0\n\\t_completed = false\n\\t_failed = false\n\\t_failure_reason = \"\"\n\\t_last_resource = null\n\\t_current_path = path\n\\t_mutex.unlock()\n\n\\t# Check existence quickly first\n\\tif not ResourceLoader.exists(path):\n\\t\\t_mutex.lock()\n\\t\\t_loading = false\n\\t\\t_current_path = \"\"\n\\t\\t_failed = true\n\\t\\t_failure_reason = \"Resource does not exist: \" + path\n\\t\\t_mutex.unlock()\n\\t\\tcall_deferred(\"emit_signal\", \"load_failed\", _failure_reason)\n\\t\\treturn true\n\n\\t# Kick off async load using ResourceLoader.load_threaded_request\n\\tvar err := ResourceLoader.load_threaded_request(path)\n\\tif err != OK:\n\\t\\t_mutex.lock()\n\\t\\t_loading = false\n\\t\\t_current_path = \"\"\n\\t\\t_failed = true\n\\t\\t_failure_reason = \"load_threaded_request failed with error %d\" % err\n\\t\\t_mutex.unlock()\n\\t\\tcall_deferred(\"emit_signal\", \"load_failed\", _failure_reason)\n\\t\\treturn true\n\n\\t# Start a background thread to poll progress\n\\t_current_thread = Thread.new()\n\\t_current_thread.start(_load_worker.bind(path))\n\\treturn true\n\nfunc cancel() -> void:\n\\t_mutex.lock()\n\\tif not _loading:\n\\t\\t_mutex.unlock()\n\\t\\treturn\n\\t_cancel_requested = true\n\\t_mutex.unlock()\n\\tif _current_thread != null and _current_thread.is_started():\n\\t\\t_current_thread.wait_to_finish()\n\\t_current_thread = null\n\\t_mutex.lock()\n\\t_loading = false\n\\t_cancel_requested = false\n\\t_current_path = \"\"\n\\t_progress_value = 0.0\n\\t_completed = false\n\\t_failed = false\n\\t_mutex.unlock()\n\nfunc is_loading() -> bool:\n\\t_mutex.lock()\n\\tvar v := _loading\n\\t_mutex.unlock()\n\\treturn v\n\nfunc _load_worker(path: String) -> void:\n\\tvar last_emit := -1.0\n\\twhile true:\n\\t\\t_mutex.lock()\n\\t\\tif _cancel_requested:\n\\t\\t\\t_mutex.unlock()\n\\t\\t\\treturn\n\\t\\t_mutex.unlock()\n\n\\t\\tvar progress := []\n\\t\\tvar status := ResourceLoader.load_threaded_get_status(path, progress)\n\\t\\tvar frac: float = 0.0\n\\t\\tif progress.size() > 0:\n\\t\\t\\tfrac = float(progress[0])\n\\t\\tif frac < 0.0:\n\\t\\t\\tfrac = 0.0\n\\t\\tif frac > 1.0:\n\\t\\t\\tfrac = 1.0\n\\t\\t_mutex.lock()\n\\t\\t_progress_value = frac\n\\t\\t_mutex.unlock()\n\\t\\tif abs(frac - last_emit) > 0.0001 or status == ResourceLoader.THREAD_LOAD_LOADED:\n\\t\\t\\tlast_emit = frac\n\\t\\t\\tcall_deferred(\"emit_signal\", \"progress_updated\", frac)\n\n\\t\\tmatch status:\n\\t\\t\\tResourceLoader.THREAD_LOAD_IN_PROGRESS:\n\\t\\t\\t\\tOS.delay_msec(16)\n\\t\\t\\tResourceLoader.THREAD_LOAD_LOADED:\n\\t\\t\\t\\tvar res := ResourceLoader.load_threaded_get(path)\n\\t\\t\\t\\t_mutex.lock()\n\\t\\t\\t\\tif _cancel_requested:\n\\t\\t\\t\\t\\t_mutex.unlock()\n\\t\\t\\t\\t\\treturn\n\\t\\t\\t\\t_last_resource = res\n\\t\\t\\t\\t_loading = false\n\\t\\t\\t\\t_current_path = \"\"\n\\t\\t\\t\\t_completed = true\n\\t\\t\\t\\t_mutex.unlock()\n\\t\\t\\t\\tcall_deferred(\"emit_signal\", \"load_completed\", res)\n\\t\\t\\t\\treturn\n\\t\\t\\tResourceLoader.THREAD_LOAD_FAILED:\n\\t\\t\\t\\t_mutex.lock()\n\\t\\t\\t\\t_loading = false\n\\t\\t\\t\\t_current_path = \"\"\n\\t\\t\\t\\t_failed = true\n\\t\\t\\t\\t_failure_reason = \"Threaded load failed for: \" + path\n\\t\\t\\t\\t_mutex.unlock()\n\\t\\t\\t\\tcall_deferred(\"emit_signal\", \"load_failed\", _failure_reason)\n\\t\\t\\t\\treturn\n\\t\\t\\t_:\n\\t\\t\\t\\tOS.delay_msec(16)\n'''\n\nwith open('REDACTEDloads/SceneLoader.gd', 'w') as f:\n    f.write(content)\nprint(\"Written\")\nPYEOF\n"]
