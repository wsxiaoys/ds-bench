[164.583407, "o", "cat -A tests/run_tests.gd | head -30\r\n\u001b[?2004l\r"]
[164.585069, "o", "extends SceneTree$\r\n$\r\nvar _failures: int = 0$\r\nvar _completed_count: int = 0$\r\nvar _failed_count: int = 0$\r\nvar _progress_count: int = 0$\r\nvar _last_failed_reason: String = \"\"$\r\nvar _completed_scene = null$\r\nvar _scene_loader_instance = null$\r\n"]
[164.58512, "o", "$\r\nfunc _initialize() -> void:$\r\nprint(\"=== SceneLoader Test Harness ===\")$\r\nawait _run_tests()$\r\n$\r\nfunc _fail(msg: String) -> void:$\r\n_failures += 1$\r\nprint(\"FAIL: \" + msg)$\r\n$\r\nfunc _ok(msg: String) -> void:$\r\nprint(\"OK: \" + msg)$\r\n$\r\nfunc _run_tests() -> void:$\r\n# Test 1: SceneLoader REDACTEDload exists and is Node$\r\nawait _test_REDACTEDload_exists()$\r\n# Test 2: API surface - signals and methods$\r\nawait _test_api_surface()$\r\n"]
[164.585166, "o", "# Test 3: Loading huge level$\r\nawait _test_huge_level_load()$\r\n# Test 4: Loading non-existent path triggers load_failed$\r\nawait _test_nonexistent_path()$\r\n"]
[164.585526, "o", "\u001b[?2004hroot@2e0a24a3-8e9e-458a-b247-d71c89a5615d:/home/user/myproject# "]
