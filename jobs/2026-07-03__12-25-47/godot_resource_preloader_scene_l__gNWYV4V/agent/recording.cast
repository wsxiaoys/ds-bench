\")\nw(TAB + TAB + \"_fail(\\\"progress_updated did not fire\\\")\")\nw(\"\")\nw(TAB + \"if _completed_scene != null and _completed_scene is PackedScene:\")\nw(TAB + TAB + \"_ok(\\\"load_completed payload is PackedScene\\\")\")\nw(TAB + \"else:\")\nw(TAB + TAB + \"_fail(\\\"load_completed payload is not PackedScene\\\")\")\nw(TAB + TAB + \"return\")\nw(\"\")\nw(TAB + \"var inst = _completed_scene.instantiate()\")\nw(TAB + \"var count = _count_node2d(inst)\")\nw(TAB + \"if count >= 50:\")\nw(TAB + TAB + \"_ok(\\\"Instantiated tree has \\\" + str(count) + \\\" Node2D descendants (>=50)\\\")\")\nw(TAB + \"else:\")\nw(TAB + TAB + \"_fail(\\\"Instantiated tree has \\\" + str(count) + \\\" Node2D descendants (expected >=50)\\\")\")\nw(TAB + \"inst.queue_free()\")\nw(\"\")\n\nwith open('/tmp/part2.gd', 'w') as f:\n    f.write(\"\\n\".join(L) + \"\\n\")\nprint(\"Part 2 done, %d lines\" % len(L))\nPYEOF\npython3 /tmp/gen_full_tests2.py\n"]
