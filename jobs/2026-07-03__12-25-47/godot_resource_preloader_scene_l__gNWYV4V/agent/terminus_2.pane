func cancel() -> void:
	_mutex.lock()
	if not _loading:
		_mutex.unlock()
		return
	_cancel_requested = true
	_mutex.unlock()
	if _current_thread != null and _current_thread.is_started():
		_current_thread.wait_to_finish()
	_current_thread = null
	_mutex.lock()
	_loading = false
	_cancel_requested = false
	_current_path = ""
	_progress_value = 0.0
	_completed = false
	_failed = false
	_mutex.unlock()

func is_loading() -> bool:
	_mutex.lock()
	var v := _loading
	_mutex.unlock()
	return v


func _exit_tree() -> void:
	_cleanup_thread()

func _cleanup_thread() -> void:
	_mutex.lock()
	_cancel_requested = true
	_mutex.unlock()
	if _current_thread != null and _current_thread.is_started():
		_current_thread.wait_to_finish()
	_current_thread = null

func _load_worker(path: String) -> void:
	var last_emit := -1.0
