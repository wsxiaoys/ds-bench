[?2004l[?2004hroot@0a406e98-fa88-44bf-85ef-629ef3887d14:/home/user/myproject# cat query.js
[?2004lconst fs = require('fs');
const { Company, Department, Employee, Project, EmployeeProject, sequelize } = require('./models');

(async () => {
  try {
    // Sync all models (drop existing tables for a clean seed)
    await sequelize.sync({ force: true });

    // Seed sample data
    const techCorp = await Company.create({ name: 'TechCorp' });
    const otherCo = await Company.create({ name: 'OtherCo' });

    const engineering = await Department.create({ name: 'Engineering', CompanyId: techCorp.id });
    const marketing = await Department.create({ name: 'Marketing', CompanyId: techCorp.id });
    const sales = await Department.create({ name: 'Sales', CompanyId: otherCo.id });

    const alice = await Employee.create({ name: 'Alice', DepartmentId: engineering.id });
    const bob = await Employee.create({ name: 'Bob', DepartmentId: engineering.id });
    const carol = await Employee.create({ name: 'Carol', DepartmentId: marketing.id });

    const projA = await Project.create({ name: 'Project Alpha', status: 'active' });
    const projB = await Project.create({ name: 'Project Beta', status: 'active' });
    const projC = await Project.create({ name: 'Project Gamma', status: 'inactive' });

    // Use unscoped Project to create assignments involving inactive project
    const ProjectUnscoped = Project.unscoped();
    await alice.addProject(projA, { through: { role: 'Lead' } });
    await alice.addProject(projC, { through: { role: 'Helper' } }); // inactive - should be filtered out by default scope
    await bob.addProject(projB, { through: { role: 'Developer' } });
    await carol.addProject(projA, { through: { role: 'Coordinator' } });

    // Query: Find TechCorp, eagerly loading divisions -> staff -> assignments
    const company = await Company.findOne({
      where: { name: 'TechCorp' },
      include: [{
        association: 'divisions',
        include: [{
          association: 'staff',
          include: [{
            association: 'assignments'
          }]
        }]
      }]
    });

    const result = company.toJSON();
    fs.writeFileSync('output.json', JSON.stringify(result, null, 2));
    console.log('Wrote output.json');
    console.log(JSON.stringify(result, null, 2));
  } catch (err) {
    console.error('Error:', err);
    process.exit(1);
  } finally {
    await sequelize.close();
  }
})();
