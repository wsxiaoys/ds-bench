[81.445502, "i", "cat > query.js << 'EOF'\nconst fs = require('fs');\nconst { Company, Department, Employee, Project, EmployeeProject, sequelize } = require('./models');\n\n(async () => {\n  try {\n    // Sync all models (drop existing tables for a clean seed)\n    await sequelize.sync({ force: true });\n\n    // Seed sample data\n    const techCorp = await Company.create({ name: 'TechCorp' });\n    const otherCo = await Company.create({ name: 'OtherCo' });\n\n    const engineering = await Department.create({ name: 'Engineering', CompanyId: techCorp.id });\n    const marketing = await Department.create({ name: 'Marketing', CompanyId: techCorp.id });\n    await Department.create({ name: 'Sales', CompanyId: otherCo.id });\n\n    const alice = await Employee.create({ name: 'Alice', DepartmentId: engineering.id });\n    const bob = await Employee.create({ name: 'Bob', DepartmentId: engineering.id });\n    const carol = await Employee.create({ name: 'Carol', DepartmentId: marketing.id });\n\n    // Use unscoped Project to create projects of any status\n    const ProjectUnscoped = Project.unscoped();\n    const projA = await ProjectUnscoped.create({ name: 'Project Alpha', status: 'active' });\n    const projB = await ProjectUnscoped.create({ name: 'Project Beta', status: 'active' });\n    const projC = await ProjectUnscoped.create({ name: 'Project Gamma', status: 'inactive' });\n\n    // Create junction records directly. Use the unscoped Project to bypass default scope\n    await EmployeeProject.create({ EmployeeId: alice.id, ProjectId: projA.id, role: 'Lead' });\n    await EmployeeProject.create({ EmployeeId: alice.id, ProjectId: projC.id, role: 'Helper' }); // inactive - filtered out by default scope\n    await EmployeeProject.create({ EmployeeId: bob.id, ProjectId: projB.id, role: 'Developer' });\n    await EmployeeProject.create({ EmployeeId: carol.id, ProjectId: projA.id, role: 'Coordinator' });\n\n    // Query: Find TechCorp, eagerly loading divisions -> staff -> assignments\n    const company = await Company.findOne({\n      where: { name: 'TechCorp' },\n      include: [{\n        association: 'divisions',\n        include: [{\n          association: 'staff',\n          include: [{\n            association: 'assignments'\n          }]\n        }]\n      }]\n    });\n\n    const result = company.toJSON();\n    fs.writeFileSync('output.json', JSON.stringify(result, null, 2));\n    console.log('Wrote output.json');\n    console.log(JSON.stringify(result, null, 2));\n  } catch (err) {\n    console.error('Error:', err);\n    process.exit(1);\n  } finally {\n    await sequelize.close();\n  }\n})();\nEOF\n"]
[81.446027, "o", "cat > query.js << 'EOF'\r\n\u001b[?2004l\r"]
[81.446168, "o", "\u001b[?2004h> const fs = require('fs');\r\n\u001b[?2004l\r"]
[81.446291, "o", "\u001b[?2004h> "]
[81.44669, "o", "const { Company, Department, Employee, Project, EmployeeProject, sequelize } = require('./models');\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[81.446841, "o", "\u001b[?2004h> (async () => {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[81.447002, "o", "  try {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[81.4472, "o", "    // Sync all models (drop existing tables for a clean seed)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[81.447427, "o", "    await sequelize.sync({ force: true });\r\n\u001b[?2004l\r\u001b[?2004h"]
[81.447501, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[81.447747, "o", "    // Seed sample data\r\n\u001b[?2004l\r\u001b[?2004h> "]
[81.447989, "o", "    const techCorp = await Company.create({ name: 'TechCorp' });\r\n\u001b[?2004l\r\u001b[?2004h> "]
[81.44824, "o", "    const otherCo = await Company.create({ name: 'OtherCo' });\r\n\u001b[?2004l\r\u001b[?2004h"]
[81.448348, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[81.448717, "o", "    const engineering = await Department.create({ name: 'Engineering', CompanyId: techCorp.id });\r\n\u001b[?2004l\r"]
[81.448773, "o", "\u001b[?2004h> "]
[81.449185, "o", "    const marketing = await Department.create({ name: 'Marketing', CompanyId: techCorp.id });\r\n\u001b[?2004l\r\u001b[?2004h"]
[81.449287, "o", "> "]
[81.449508, "o", "    await Department.create({ name: 'Sales', CompanyId: otherCo.id });\r\n\u001b[?2004l\r"]
[81.449561, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[81.449748, "o", "> "]
[81.450003, "o", "    const alice = await Employee.create({ name: 'Alice', DepartmentId: engineering.id });\r\n\u001b[?2004l\r\u001b[?2004h"]
[81.450086, "o", "> "]
[81.450394, "o", "    const bob = await Employee.create({ name: 'Bob', DepartmentId: engineering.id });\r\n\u001b[?2004l\r\u001b[?2004h"]
[81.450467, "o", "> "]
[81.450812, "o", "    const carol = await Employee.create({ name: 'Carol', DepartmentId: marketing.id });\r\n\u001b[?2004l\r\u001b[?2004h"]
[81.450889, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[81.451153, "o", "    // Use unscoped Project to create projects of any status\r\n\u001b[?2004l\r\u001b[?2004h"]
[81.451196, "o", "> "]
[81.451392, "o", "    const ProjectUnscoped = Project.unscoped();\r\n\u001b[?2004l\r"]
[81.451434, "o", "\u001b[?2004h> "]
[81.451825, "o", "    const projA = await ProjectUnscoped.create({ name: 'Project Alpha', status: 'active' });\r\n\u001b[?2004l\r"]
[81.451866, "o", "\u001b[?2004h> "]
[81.452263, "o", "    const projB = await ProjectUnscoped.create({ name: 'Project Beta', status: 'active' });\r\n\u001b[?2004l\r\u001b[?2004h"]
[81.452306, "o", "> "]
[81.452696, "o", "    const projC = await ProjectUnscoped.create({ name: 'Project Gamma', status: 'inactive' });\r\n\u001b[?2004l\r"]
[81.452737, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[81.452833, "o", "\u001b[?2004h> "]
[81.453174, "o", "    // Create junction records directly. Use the unscoped Project to bypass default scope\r\n\u001b[?2004l\r\u001b[?2004h"]
[81.453228, "o", "> "]
[81.453614, "o", "    await EmployeeProject.create({ EmployeeId: alice.id, ProjectId: projA.id, role: 'Lead' });\r\n\u001b[?2004l\r\u001b[?2004h"]
[81.453694, "o", "> "]
[81.454251, "o", "    await EmployeeProject.create({ EmployeeId: alice.id, ProjectId: projC.id, role: 'Helper' }); // inactive - filtered out by default scope\r\n\u001b[?2004l\r"]
[81.454306, "o", "\u001b[?2004h> "]
[81.454706, "o", "    await EmployeeProject.create({ EmployeeId: bob.id, ProjectId: projB.id, role: 'Developer' });\r\n\u001b[?2004l\r"]
[81.454788, "o", "\u001b[?2004h> "]
[81.455188, "o", "    await EmployeeProject.create({ EmployeeId: carol.id, ProjectId: projA.id, role: 'Coordinator' });\r\n\u001b[?2004l\r\u001b[?2004h"]
[81.455241, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[81.455602, "o", "    // Query: Find TechCorp, eagerly loading divisions -> staff -> assignments\r\n\u001b[?2004l\r\u001b[?2004h"]
[81.455696, "o", "> "]
[81.455825, "o", "    const company = await Company.findOne({\r\n\u001b[?2004l\r"]
[81.455875, "o", "\u001b[?2004h> "]
[81.456029, "o", "      where: { name: 'TechCorp' },\r\n\u001b[?2004l\r"]
[81.456081, "o", "\u001b[?2004h> "]
[81.456216, "o", "      include: [{\r\n\u001b[?2004l\r\u001b[?2004h> "]
[81.456334, "o", "        association: 'divisions',\r\n\u001b[?2004l\r\u001b[?2004h"]
[81.456432, "o", "> "]
[81.456486, "o", "        include: [{\r\n\u001b[?2004l\r\u001b[?2004h> "]
[81.456689, "o", "          association: 'staff',\r\n\u001b[?2004l\r\u001b[?2004h> "]
[81.456826, "o", "          include: [{\r\n\u001b[?2004l\r\u001b[?2004h> "]
[81.456979, "o", "            association: 'assignments'\r\n\u001b[?2004l\r"]
[81.457024, "o", "\u001b[?2004h> "]
[81.457126, "o", "          }]\r\n\u001b[?2004l\r\u001b[?2004h> "]
[81.457171, "o", "        }]\r\n\u001b[?2004l\r\u001b[?2004h"]
[81.457275, "o", ">       }]\r\n\u001b[?2004l\r\u001b[?2004h> "]
[81.45732, "o", "    });\r\n\u001b[?2004l\r\u001b[?2004h"]
[81.457399, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[81.457561, "o", "    const result = company.toJSON();\r\n\u001b[?2004l\r\u001b[?2004h"]
[81.457605, "o", "> "]
[81.457897, "o", "    fs.writeFileSync('output.json', JSON.stringify(result, null, 2));\r\n\u001b[?2004l\r\u001b[?2004h"]
[81.45795, "o", "> "]
[81.458101, "o", "    console.log('Wrote output.json');\r\n\u001b[?2004l\r"]
[81.458149, "o", "\u001b[?2004h> "]
[81.458355, "o", "    console.log(JSON.stringify(result, null, 2));\r\n\u001b[?2004l\r"]
[81.458398, "o", "\u001b[?2004h> "]
[81.458507, "o", "  } catch (err) {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[81.45866, "o", "    console.error('Error:', err);\r\n\u001b[?2004l\r"]
[81.458705, "o", "\u001b[?2004h> "]
[81.458795, "o", "    process.exit(1);\r\n\u001b[?2004l\r"]
[81.45884, "o", "\u001b[?2004h> "]
[81.458963, "o", "  } finally {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[81.459067, "o", "    await sequelize.close();\r\n\u001b[?2004l\r"]
[81.459114, "o", "\u001b[?2004h>   }\r\n\u001b[?2004l\r"]
[81.459215, "o", "\u001b[?2004h> })();\r\n\u001b[?2004l\r\u001b[?2004h"]
[81.459358, "o", "> EOF\r\n\u001b[?2004l\r"]
[81.460981, "o", "\u001b[?2004hroot@0a406e98-fa88-44bf-85ef-629ef3887d14:/home/user/myproject# "]
[81.989463, "i", "node query.js\n"]
[81.989627, "o", "node query.js\r\n\u001b[?2004l\r"]
