[82.195391, "o", "Executing (default): SELECT `Company`.*, `divisions`.`id` AS `divisions.id`, `divisions`.`name` AS `divisions.name`, `divisions`.`createdAt` AS `divisions.createdAt`, `divisions`.`updatedAt` AS `divisions.updatedAt`, `divisions`.`CompanyId` AS `divisions.CompanyId`, `divisions->staff`.`id` AS `divisions.staff.id`, `divisions->staff`.`name` AS `divisions.staff.name`, `divisions->staff`.`createdAt` AS `divisions.staff.createdAt`, `divisions->staff`.`updatedAt` AS `divisions.staff.updatedAt`, `divisions->staff`.`DepartmentId` AS `divisions.staff.DepartmentId`, `divisions->staff->assignments`.`id` AS `divisions.staff.assignments.id`, `divisions->staff->assignments`.`name` AS `divisions.staff.assignments.name`, `divisions->staff->assignments`.`status` AS `divisions.staff.assignments.status`, `divisions->staff->assignments`.`createdAt` AS `divisions.staff.assignments.createdAt`, `divisions->staff->assignments`.`updatedAt` AS `divisions.staff.assignments.updatedAt`, `divisions->staff->assignments->EmployeeProject`.`role` AS `divisions.staff.assignments.EmployeeProject.role`, `divisions->staff->assignments->EmployeeProject`.`createdAt` AS `divisions.staff.assignments.EmployeeProject.createdAt`, `divisions->staff->assignments->EmployeeProject`.`updatedAt` AS `divisions.staff.assignments.EmployeeProject.updatedAt`, `divisions->staff->assignments->EmployeeProject`.`EmployeeId` AS `divisions.staff.assignments.EmployeeProject.EmployeeId`, `divisions->staff->assignments->EmployeeProject`.`ProjectId` AS `divisions.staff.assignments.EmployeeProject.ProjectId` FROM (SELECT `Company`.`id`, `Company`.`name`, `Company`.`createdAt`, `Company`.`updatedAt` FROM `Companies` AS `Company` WHERE `Company`.`name` = 'TechCorp' LIMIT 1) AS `Company` LEFT OUTER JOIN `Departments` AS `divisions` ON `Company`.`id` = `divisions`.`CompanyId` LEFT OUTER JOIN ( `Employees` AS `divisions->staff` INNER JOIN ( `EmployeeProjects` AS `divisions->staff->assignments->EmployeeProject` INNER JOIN `Projects` AS `divisions->staff->assignments` ON `divisions->staff->assignments`.`id` = `divisions->staff->assignments->EmployeeProject`.`ProjectId`) ON `divisions->staff`.`id` = `divisions->staff->assignments->EmployeeProject`.`EmployeeId` AND `divisions->staff->assignments`.`status` = 'active' ) ON `divisions`.`id` = `divisions->staff`.`DepartmentId`;\r\n"]
