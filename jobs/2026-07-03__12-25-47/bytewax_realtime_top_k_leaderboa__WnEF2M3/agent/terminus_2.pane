[?2004l[?2004h>         if player_id in current:
[?2004l[?2004h>             if score > current[player_id]:
[?2004l[?2004h>                 heap = [(s, p) for (s, p) in heap if p != player_id]
[?2004l[?2004h>                 heapq.heapify(heap)
[?2004l[?2004h>             else:
[?2004l[?2004h>                 return (heap, _heap_to_sorted_list(heap))
[?2004l[?2004h>         if len(heap) < k:
