[?2004l[?2004h> 
[?2004l[?2004h> def build_dataflow(input_path: str, k: int) -> Dataflow:
[?2004l[?2004h>     flow = Dataflow("leaderboard")
[?2004l[?2004h> 
[?2004l[?2004h>     # 1. Read raw JSONL lines.
[?2004l[?2004h>     raw = op.input("in", flow, JSONLSource(input_path))
[?2004l[?2004h> 
[?2004l[?2004h>     # 2. Parse each line into (player_id, score) and key on player_id.
[?2004l[?2004h>     parsed = op.map("parse", raw, lambda line: json.loads(line))
[?2004l[?2004h>     keyed = op.key_on("by_player", parsed, lambda ev: ev["player_id"])
[?2004l[?2004h> 
[?2004l[?2004h>     # 3. Stateful map: keep the max score ever seen per player.
[?2004l[?2004h>     def max_score(state, ev):
[?2004l[?2004h>         score = ev["score"]
[?2004l[?2004h>         if state is None or score > state:
[?2004l[?2004h>             new_state = score
[?2004l[?2004h>         else:
[?2004l[?2004h>             new_state = state
[?2004l[?2004h>         return (new_state, (ev["player_id"], new_state))
[?2004l[?2004h> 
[?2004l[?2004h>     player_max = op.stateful_map("player_max", keyed, max_score)
[?2004l[?2004h> 
[?2004l[?2004h>     # 4. Re-key to a single global key so all updates land on one worker.
[?2004l[?2004h>     routed = op.key_on("to_global", player_max, lambda _x: "GLOBAL")
[?2004l[?2004h> 
[?2004l[?2004h>     # 5. Stateful map on the global key: maintain a min-heap of size K
[?2004l[?2004h>     # representing the top-K (player_id, score) pairs.
[?2004l[?2004h>     def topk_step(state, item):
