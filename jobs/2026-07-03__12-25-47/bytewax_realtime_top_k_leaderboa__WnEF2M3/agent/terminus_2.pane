[?2004l[?2004h> # ----------------------------- Dataflow ----------------------------- #
[?2004l[?2004h> 
[?2004l[?2004h> def _heap_to_sorted_list(heap):
[?2004l[?2004h>     # Return the heap sorted by score descending.
[?2004l[?2004h>     return sorted(((p, s) for s, p in heap), key=lambda x: x[1], reverse=True)
