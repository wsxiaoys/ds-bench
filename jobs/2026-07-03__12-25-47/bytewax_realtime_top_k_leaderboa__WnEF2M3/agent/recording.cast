[189.12922, "o", "> \r\n\u001b[?2004l\r"]
[189.129255, "o", "\u001b[?2004h> "]
[189.129715, "o", "# ----------------------------- Dataflow ----------------------------- #\r\n\u001b[?2004l\r"]
[189.129753, "o", "\u001b[?2004h"]
[189.129787, "o", "> \r\n\u001b[?2004l\r"]
[189.129821, "o", "\u001b[?2004h> "]
[189.130023, "o", "def _heap_to_sorted_list(heap):\r\n\u001b[?2004l\r"]
[189.130063, "o", "\u001b[?2004h"]
[189.130097, "o", "> "]
[189.130385, "o", "    # Return the heap sorted by score descending.\r\n\u001b[?2004l\r"]
[189.130422, "o", "\u001b[?2004h"]
[189.130471, "o", "> "]
[189.130924, "o", "    return sorted(((p, s) for s, p in heap), key=lambda x: x[1], reverse=True)\r\n\u001b[?2004l\r"]
[189.130961, "o", "\u001b[?2004h"]
[189.130993, "o", "> \r\n\u001b[?2004l\r"]
