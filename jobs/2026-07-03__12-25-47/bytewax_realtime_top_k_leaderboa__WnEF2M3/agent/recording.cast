 returning value=[('dave', ('dave', 250)), ('charlie', ('charlie', 75)), ('bob', ('bob', 80))]\r\ntopk_step: received item=('eve', ('eve', 90)), type=tuple\r\ntopk_step: returning value=[('eve', ('eve', 90)), ('dave', ('dave', 250)), ('charlie', ('charlie', 75))]\r\ntopk_step: received item=('frank', ('frank', 30)), type=tuple\r\ntopk_step: returning value=[('frank', ('frank', 30)), ('eve', ('eve', 90)), ('dave', ('dave', 250))]\r\n"]
