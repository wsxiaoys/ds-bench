[505.875552, "o", "\u001b[?2004h> "]
[505.875687, "o", "        self._path = path\r\n\u001b[?2004l\r"]
[505.875714, "o", "\u001b[?2004h> "]
[505.875895, "o", "        self._f = open(path, \"rt\")\r\n\u001b[?2004l\r"]
[505.87598, "o", "\u001b[?2004h> "]
[505.876059, "o", "        self._eof = False\r\n\u001b[?2004l\r"]
[505.876141, "o", "\u001b[?2004h> "]
[505.876267, "o", "        if resume_state is not None:\r\n\u001b[?2004l\r"]
[505.876329, "o", "\u001b[?2004h> "]
[505.876509, "o", "            self._f.seek(resume_state)\r\n\u001b[?2004l\r"]
[505.87659, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[505.876672, "o", "\u001b[?2004h> "]
[505.876714, "o", "    @override\r\n\u001b[?2004l\r\u001b[?2004h> "]
[505.876829, "o", "    def next_batch(self):\r\n\u001b[?2004l\r"]
[505.876911, "o", "\u001b[?2004h> "]
[505.876975, "o", "        batch = []\r\n\u001b[?2004l\r\u001b[?2004h"]
[505.877, "o", "> "]
[505.877102, "o", "        if self._eof:\r\n\u001b[?2004l\r"]
[505.877137, "o", "\u001b[?2004h> "]
[505.877304, "o", "            raise StopIteration()\r\n\u001b[?2004l\r"]
[505.877371, "o", "\u001b[?2004h> "]
[505.87749, "o", "        for line in self._f:\r\n\u001b[?2004l\r"]
[505.877574, "o", "\u001b[?2004h> "]
[505.877677, "o", "            line = line.strip()\r\n\u001b[?2004l\r"]
[505.877741, "o", "\u001b[?2004h> "]
[505.877838, "o", "            if not line:\r\n\u001b[?2004l\r"]
[505.877916, "o", "\u001b[?2004h> "]
[505.877999, "o", "                continue\r\n\u001b[?2004l\r"]
[505.87808, "o", "\u001b[?2004h> "]
[505.878181, "o", "            batch.append(line)\r\n\u001b[?2004l\r"]
[505.878206, "o", "\u001b[?2004h> "]
[505.878345, "o", "        self._eof = True\r\n\u001b[?2004l\r"]
[505.878413, "o", "\u001b[?2004h> "]
[505.878488, "o", "        return batch\r\n\u001b[?2004l\r"]
[505.878518, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[505.878611, "o", "\u001b[?2004h> "]
[505.878638, "o", "    @override\r\n\u001b[?2004l\r"]
[505.878736, "o", "\u001b[?2004h> "]
[505.878793, "o", "    def snapshot(self):\r\n\u001b[?2004l\r"]
[505.878815, "o", "\u001b[?2004h> "]
[505.878977, "o", "        return self._f.tell()\r\n\u001b[?2004l\r"]
[505.879004, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[505.879093, "o", "\u001b[?2004h> "]
[505.879119, "o", "    @override\r\n\u001b[?2004l\r"]
[505.879204, "o", "\u001b[?2004h> "]
[505.879261, "o", "    def close(self):\r\n\u001b[?2004l\r"]
[505.879322, "o", "\u001b[?2004h> "]
[505.879388, "o", "        try:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[505.879535, "o", "            self._f.close()\r\n\u001b[?2004l\r"]
[505.87956, "o", "\u001b[?2004h> "]
[505.879699, "o", "        except Exception:\r\n\u001b[?2004l\r"]
[505.879724, "o", "\u001b[?2004h> "]
[505.879821, "o", "            pass\r\n\u001b[?2004l\r"]
[505.879846, "o", "\u001b[?2004h> \r\n"]
[505.87993, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[505.879995, "o", "    @override\r\n\u001b[?2004l\r\u001b[?2004h> "]
[505.880136, "o", "    def next_awake(self):\r\n\u001b[?2004l\r"]
[505.880216, "o", "\u001b[?2004h> "]
[505.880273, "o", "        return None\r\n\u001b[?2004l\r"]
[505.880298, "o", "\u001b[?2004h> \r\n"]
[505.880382, "o", "\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[505.880604, "o", "class JSONLSource(FixedPartitionedSource):\r\n\u001b[?2004l\r"]
[505.880635, "o", "\u001b[?2004h> "]
[505.880884, "o", "    \"\"\"A source that reads a JSONL file line-by-line.\"\"\"\r\n\u001b[?2004l\r"]
[505.880912, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[505.880997, "o", "\u001b[?2004h> "]
[505.881116, "o", "    def __init__(self, path: str):\r\n\u001b[?2004l\r and len(item) == 2:\u001b[?2004h"]
[505.881154, "o", "> "]
[505.881258, "o", "        self._path = path\r\n\u001b[?2004l\r"]
[505.88132, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[505.881369, "o", "    @override\r\n\u001b[?2004l\r"]
[505.881413, "o", "\u001b[?2004h> "]
[505.881498, "o", "    def list_parts(self):\r\n\u001b[?2004l\r"]
[505.881547, "o", "\u001b[?2004h> "]
[505.881618, "o", "        return [\"single\"]\r\n\u001b[?2004l\r"]
[505.881661, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[505.881731, "o", "    @override\r\n\u001b[?2004l\r"]
[505.881788, "o", "\u001b[?2004h> "]
[505.881973, "o", "    def build_part(self, step_id, for_part, resume_state):\r\n\u001b[?2004l\r"]
[505.882008, "o", "\u001b[?2004h> "]
[505.882205, "o", "        return _JSONLPartition(self._path, resume_state)\r\n\u001b[?2004l\r"]
[505.88223, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[505.882277, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[505.8823, "o", "> "]
[505.882588, "o", "# ----------------------------- Output Sink ----------------------------- #\r\n\u001b[?2004l\r"]
[505.882611, "o", "\u001b[?2004h"]
[505.882654, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h"]
[505.882677, "o", "> "]
[505.882908, "o", "class _CollectSinkPartition(StatelessSinkPartition):\r\n\u001b[?2004l\r"]
[505.882938, "o", "\u001b[?2004h> "]
[505.883032, "o", "    def __init__(self):\r\n\u001b[?2004l\r"]
[505.883076, "o", "\u001b[?2004h> "]
[505.88317, "o", "        self._items: List = []\r\n\u001b[?2004l\r"]
[505.883194, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[505.883252, "o", "\u001b[?2004h> "]
[505.883293, "o", "    @override\r\n\u001b[?2004l\r\u001b[?2004h"]
[505.883336, "o", "> "]
[505.883425, "o", "    def write_batch(self, items):\r\n\u001b[?2004l\r\u001b[?2004h"]
[505.88347, "o", "> "]
[505.883547, "o", "        self._items.extend(items)\r\n\u001b[?2004l\r"]
[505.883581, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[505.883606, "o", "\u001b[?2004h> "]
[505.883652, "o", "    @override\r\n\u001b[?2004l\r"]
[505.883677, "o", "\u001b[?2004h> "]
[505.88374, "o", "    def close(self):\r\n\u001b[?2004l\r"]
[505.883765, "o", "\u001b[?2004h> "]
[505.8839, "o", "        FINAL_OUTPUT.extend(self._items)\r\n\u001b[?2004l\r"]
[505.883924, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[505.883949, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[505.883976, "o", "\u001b[?2004h> "]
[505.884081, "o", "class CollectSink(DynamicSink):\r\n\u001b[?2004l\r"]
[505.884105, "o", "\u001b[?2004h> "]
[505.884155, "o", "    @override\r\n\u001b[?2004l\r"]
[505.884179, "o", "\u001b[?2004h> "]
[505.884358, "o", "    def build(self, step_id, worker_index, worker_count):\r\n\u001b[?2004l\r"]
[505.884381, "o", "\u001b[?2004h> "]
[505.884513, "o", "        return _CollectSinkPartition()\r\n\u001b[?2004l\r\u001b[?2004h"]
[505.884535, "o", "> \r\n\u001b[?2004l\r"]
[505.88458, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[505.884602, "o", "> "]
[505.884819, "o", "# ----------------------------- Dataflow ----------------------------- #\r\n\u001b[?2004l\r"]
[505.884842, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[505.884867, "o", "\u001b[?2004h> "]
[505.884972, "o", "def _heap_to_sorted_list(heap):\r\n\u001b[?2004l\r"]
[505.884995, "o", "\u001b[?2004h> "]
[505.88523, "o", "    # Return the heap sorted by score descending: [(player_id, score), ...]\r\n\u001b[?2004l\r"]
[505.885255, "o", "\u001b[?2004h> "]
[505.885504, "o", "    return sorted(((p, s) for s, p in heap), key=lambda x: x[1], reverse=True)\r\n\u001b[?2004l\r\u001b[?2004h"]
[505.885527, "o", "> \r\n\u001b[?2004l\r"]
[505.885553, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[505.885578, "o", "\u001b[?2004h> "]
[505.885764, "o", "def build_dataflow(input_path: str, k: int) -> Dataflow:\r\n\u001b[?2004l\r"]
[505.885787, "o", "\u001b[?2004h> "]
[505.885898, "o", "    flow = Dataflow(\"leaderboard\")\r\n\u001b[?2004l\r"]
[505.885922, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[505.885944, "o", "\u001b[?2004h> "]
[505.886054, "o", "    # 1. Read raw JSONL lines.\r\n\u001b[?2004l\r"]
[505.886077, "o", "\u001b[?2004h> "]
[505.886252, "o", "    raw = op.input(\"in\", flow, JSONLSource(input_path))\r\n\u001b[?2004l\r"]
[505.886276, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[505.88632, "o", "\u001b[?2004h> "]
[505.886536, "o", "    # 2. Parse each line into (player_id, score) and key on player_id.\r\n\u001b[?2004l\r"]
[505.88656, "o", "\u001b[?2004h> "]
[505.886761, "o", "    parsed = op.map(\"parse\", raw, lambda line: json.loads(line))\r\n\u001b[?2004l\r"]
[505.886782, "o", "\u001b[?2004h> "]
[505.887022, "o", "    keyed = op.key_on(\"by_player\", parsed, lambda ev: ev[\"player_id\"])\r\n\u001b[?2004l\r"]
[505.887046, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[505.887068, "o", "\u001b[?2004h"]
[505.887093, "o", "> "]
[505.887279, "o", "    # 3. Stateful map: keep the max score ever seen per player.\r\n\u001b[?2004l\r"]
[505.887301, "o", "\u001b[?2004h> "]
[505.887518, "o", "    # The value W is just the score. The player_id is in the key.\r\n\u001b[?2004l\r"]
[505.88754, "o", "\u001b[?2004h> "]
[505.887644, "o", "    def max_score(state, ev):\r\n\u001b[?2004l\r"]
[505.887667, "o", "\u001b[?2004h> "]
[505.887768, "o", "        score = ev[\"score\"]\r\n\u001b[?2004l\r"]
[505.88779, "o", "\u001b[?2004h> "]
[505.887934, "o", "        if state is None or score > state:\r\n\u001b[?2004l\r"]
[505.887955, "o", "\u001b[?2004h> "]
[505.888061, "o", "            new_state = score\r\n\u001b[?2004l\r"]
[505.888082, "o", "\u001b[?2004h> "]
[505.888141, "o", "        else:\r\n\u001b[?2004l\r"]
[505.888162, "o", "\u001b[?2004h> "]
[505.888268, "o", "            new_state = state\r\n\u001b[?2004l\r"]
[505.88829, "o", "\u001b[?2004h> "]
[505.888421, "o", "        return (new_state, new_state)\r\n\u001b[?2004l\r"]
[505.88844, "o", "\u001b[?2004h> "]
[505.888465, "o", "\r\n\u001b[?2004l\r"]
[505.888486, "o", "\u001b[?2004h> "]
[505.888805, "o", "    player_max = op.stateful_map(\"player_max\", keyed, max_score)\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[505.888995, "o", "    # 4. Re-key to a single global key so all updates land on one worker.\r\n\u001b[?2004l\r\u001b[?2004h"]
[505.889048, "o", "> "]
[505.88925, "o", "    # After key_on on a KeyedStream, the item type is (key, value) pair.\r\n\u001b[?2004l\r\u001b[?2004h"]
[505.889298, "o", "> "]
[505.889543, "o", "    # The new stream has key='GLOBAL' and value=(old_key, old_value)=(player_id, score).\r\n\u001b[?2004l\r\u001b[?2004h"]
[505.889569, "o", "> "]
[505.88978, "o", "    routed = op.key_on(\"to_global\", player_max, lambda _kv: \"GLOBAL\")\r\n\u001b[?2004l\r"]
[505.889807, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[505.889885, "o", "\u001b[?2004h> "]
[505.890058, "o", "    # 5. Stateful map on the global key: maintain a min-heap of size K.\r\n\u001b[?2004l\r"]
[505.890083, "o", "\u001b[?2004h> "]
[505.890238, "o", "    # The value received is (player_id, score).\r\n\u001b[?2004l\r"]
[505.890263, "o", "\u001b[?2004h> "]
[505.89037, "o", "    def topk_step(state, item):\r\n\u001b[?2004l\r"]
[505.890395, "o", "\u001b[?2004h> "]
[505.890513, "o", "        player_id, score = item\r\n\u001b[?2004l\r"]
[505.890535, "o", "\u001b[?2004h> "]
[505.890625, "o", "        heap = state\r\n\u001b[?2004l\r\u001b[?2004h"]
[505.890651, "o", "> "]
[505.890722, "o", "        if heap is None:\r\n\u001b[?2004l\r"]
[505.890747, "o", "\u001b[?2004h> "]
[505.890818, "o", "            heap = []\r\n\u001b[?2004l\r"]
[505.890843, "o", "\u001b[?2004h> "]
[505.89099, "o", "        current = {pid: sc for sc, pid in heap}\r\n\u001b[?2004l\r"]
[505.891014, "o", "\u001b[?2004h> "]
[505.891123, "o", "        if player_id in current:\r\n\u001b[?2004l\r"]
[505.891147, "o", "\u001b[?2004h> "]
[505.891285, "o", "            if score > current[player_id]:\r\n\u001b[?2004l\r"]
[505.89131, "o", "\u001b[?2004h> "]
[505.891533, "o", "                heap = [(s, p) for (s, p) in heap if p != player_id]\r\n\u001b[?2004l\r"]
[505.891558, "o", "\u001b[?2004h> "]
[505.891675, "o", "                heapq.heapify(heap)\r\n\u001b[?2004l\r"]
[505.891701, "o", "\u001b[?2004h> "]
[505.891767, "o", "            else:\r\n\u001b[?2004l\r\u001b[?2004h"]
[505.89179, "o", "> "]
[505.891966, "o", "                return (heap, _heap_to_sorted_list(heap))\r\n\u001b[?2004l\r"]
[505.891991, "o", "\u001b[?2004h> "]
[505.892079, "o", "        if len(heap) < k:\r\n\u001b[?2004l\r"]
[505.892103, "o", "\u001b[?2004h> "]
[505.892273, "o", "            heapq.heappush(heap, (score, player_id))\r\n\u001b[?2004l\r"]
[505.892298, "o", "\u001b[?2004h> "]
[505.892364, "o", "        else:\r\n\u001b[?2004l\r\u001b[?2004h"]
[505.892389, "o", "> "]
[505.892497, "o", "            if score > heap[0][0]:\r\n\u001b[?2004l\r"]
[505.89252, "o", "\u001b[?2004h> "]
[505.892711, "o", "                heapq.heapreplace(heap, (score, player_id))\r\n\u001b[?2004l\r"]
[505.892736, "o", "\u001b[?2004h> "]
[505.892889, "o", "        return (heap, _heap_to_sorted_list(heap))\r\n\u001b[?2004l\r"]
[505.892913, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[505.892975, "o", "\u001b[?2004h> "]
[505.89314, "o", "    topk_stream = op.stateful_map(\"topk\", routed, topk_step)\r\n\u001b[?2004l\r"]
[505.893164, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[505.893228, "o", "\u001b[?2004h> "]
[505.893454, "o", "    # 6. Extract the value (sorted top-K list) and output to a collecting sink.\r\n\u001b[?2004l\r"]
[505.893478, "o", "\u001b[?2004h> "]
[505.893657, "o", "    # map_value transforms the value in a KeyedStream.\r\n\u001b[?2004l\r"]
[505.89368, "o", "\u001b[?2004h> "]
[505.893876, "o", "    values = op.map_value(\"extract\", topk_stream, lambda v: v)\r\n\u001b[?2004l\r"]
[505.893899, "o", "\u001b[?2004h> "]
[505.894045, "o", "    op.output(\"out\", values, CollectSink())\r\n\u001b[?2004l\r"]
[505.894068, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[505.894094, "o", "\u001b[?2004h> "]
[505.894169, "o", "    return flow\r\n\u001b[?2004l\r"]
[505.894212, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[505.894237, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h"]
[505.894296, "o", "> "]
[505.894502, "o", "# ----------------------------- Entry point ----------------------------- #\r\n\u001b[?2004l\r"]
[505.894525, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[505.894549, "o", "\u001b[?2004h> "]
[505.89461, "o", "def main():\r\n\u001b[?2004l\r"]
[505.894654, "o", "\u001b[?2004h> "]
[505.894884, "o", "    parser = argparse.ArgumentParser(description=\"Top-K Leaderboard with Bytewax\")\r\n\u001b[?2004l\r"]
[505.894907, "o", "\u001b[?2004h> "]
[505.895144, "o", "    parser.add_argument(\"--input\", required=True, help=\"Input JSONL file\")\r\n\u001b[?2004l\r"]
[505.895168, "o", "\u001b[?2004h> "]
[505.895408, "o", "    parser.add_argument(\"--output\", required=True, help=\"Output JSON file\")\r\n\u001b[?2004l\r"]
[505.895466, "o", "\u001b[?2004h> "]
[505.895673, "o", "    parser.add_argument(\"--k\", required=True, type=int, help=\"Top-K size\")\r\n\u001b[?2004l\r"]
[505.895717, "o", "\u001b[?2004h> "]
[505.895801, "o", "    args = parser.parse_args()\r\n\u001b[?2004l\r"]
[505.895842, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[505.895883, "o", "\u001b[?2004h> "]
[505.895949, "o", "    input_path = args.input\r\n\u001b[?2004l\r"]
[505.895973, "o", "\u001b[?2004h> "]
[505.896075, "o", "    output_path = args.output\r\n\u001b[?2004l\r"]
[505.8961, "o", "\u001b[?2004h> "]
[505.896158, "o", "    k = args.k\r\n\u001b[?2004l\r"]
[505.896182, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[505.896203, "o", "\u001b[?2004h> "]
[505.896348, "o", "    flow = build_dataflow(input_path, k)\r\n\u001b[?2004l\r"]
[505.896371, "o", "\u001b[?2004h> "]
[505.896438, "o", "    run_main(flow)\r\n\u001b[?2004l\r"]
[505.896483, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[505.896526, "o", "\u001b[?2004h> "]
[505.896573, "o", "    final_top_k = []\r\n\u001b[?2004l\r"]
[505.896614, "o", "\u001b[?2004h> "]
[505.896665, "o", "    if FINAL_OUTPUT:\r\n\u001b[?2004l\r"]
[505.896689, "o", "\u001b[?2004h> "]
[505.896922, "o", "        # Each item in FINAL_OUTPUT is (key, value) from the keyed stream.\r\n\u001b[?2004l\r"]
[505.896964, "o", "\u001b[?2004h> "]
[505.897148, "o", "        # value is the sorted list of (player_id, score) tuples.\r\n\u001b[?2004l\r"]
[505.89719, "o", "\u001b[?2004h> "]
[505.897302, "o", "        # Take the last non-empty list.\r\n\u001b[?2004l\r"]
[505.897343, "o", "\u001b[?2004h> "]
[505.897478, "o", "        for item in reversed(FINAL_OUTPUT):\r\n\u001b[?2004l\r\u001b[?2004h"]
[505.897502, "o", "> "]
[505.897678, "o", "            if isinstance(item, tuple) and len(item) == 2:\r\n\u001b[?2004l\r"]
[505.89772, "o", "\u001b[?2004h> "]
[505.897811, "o", "                _key, val = item\r\n\u001b[?2004l\r"]
[505.897852, "o", "\u001b[?2004h> "]
[505.897913, "o", "                if val:\r\n\u001b[?2004l\r"]
[505.897938, "o", "\u001b[?2004h> "]
[505.898062, "o", "                    final_top_k = val\r\n\u001b[?2004l\r"]
[505.898087, "o", "\u001b[?2004h> "]
[505.898172, "o", "                    break\r\n\u001b[?2004l\r"]
[505.898213, "o", "\u001b[?2004h> "]
[505.898354, "o", "            elif isinstance(item, list) and item:\r\n\u001b[?2004l\r"]
[505.898394, "o", "\u001b[?2004h> "]
[505.898504, "o", "                final_top_k = item\r\n\u001b[?2004l\r"]
[505.898528, "o", "\u001b[?2004h> "]
[505.8986, "o", "                break\r\n\u001b[?2004l\r"]
[505.898641, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[505.898684, "o", "> "]
[505.898886, "o", "    result = [{\"player_id\": pid, \"score\": sc} for (pid, sc) in final_top_k]\r\n\u001b[?2004l\r"]
[505.898926, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[505.898968, "o", "> "]
[505.899069, "o", "    with open(output_path, \"w\") as f:\r\n\u001b[?2004l\r"]
[505.899092, "o", "\u001b[?2004h> "]
[505.899202, "o", "        json.dump(result, f)\r\n\u001b[?2004l\r"]
[505.899243, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[505.899286, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[505.899311, "o", "> "]
[505.899383, "o", "if __name__ == \"__main__\":\r\n\u001b[?2004l\r"]
[505.899424, "o", "\u001b[?2004h> "]
[505.899495, "o", "    main()\r\n\u001b[?2004l\r\u001b[?2004h"]
[505.899523, "o", "> PYEOF\r\n\u001b[?2004l\r"]
