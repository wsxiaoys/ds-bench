[189.131089, "o", "\u001b[?2004h> "]
[189.131453, "o", "def build_dataflow(input_path: str, k: int) -> Dataflow:\r\n\u001b[?2004l\r"]
[189.131488, "o", "\u001b[?2004h"]
[189.13152, "o", "> "]
[189.131717, "o", "    flow = Dataflow(\"leaderboard\")\r\n\u001b[?2004l\r"]
[189.131757, "o", "\u001b[?2004h"]
[189.131791, "o", "> \r\n\u001b[?2004l\r"]
[189.131826, "o", "\u001b[?2004h"]
[189.13185, "o", "> "]
[189.13203, "o", "    # 1. Read raw JSONL lines.\r\n\u001b[?2004l\r"]
[189.132074, "o", "\u001b[?2004h"]
[189.132106, "o", "> "]
[189.132432, "o", "    raw = op.input(\"in\", flow, JSONLSource(input_path))\r\n\u001b[?2004l\r"]
[189.132474, "o", "\u001b[?2004h"]
[189.132508, "o", "> \r\n\u001b[?2004l\r"]
[189.13254, "o", "\u001b[?2004h"]
[189.132573, "o", "> "]
[189.132982, "o", "    # 2. Parse each line into (player_id, score) and key on player_id.\r\n\u001b[?2004l\r"]
[189.133018, "o", "\u001b[?2004h"]
[189.133051, "o", "> "]
[189.133428, "o", "    parsed = op.map(\"parse\", raw, lambda line: json.loads(line))\r\n\u001b[?2004l\r"]
[189.133471, "o", "\u001b[?2004h"]
[189.133503, "o", "> "]
[189.133921, "o", "    keyed = op.key_on(\"by_player\", parsed, lambda ev: ev[\"player_id\"])\r\n\u001b[?2004l\r"]
[189.133957, "o", "\u001b[?2004h"]
[189.133994, "o", "> \r\n\u001b[?2004l\r"]
[189.134028, "o", "\u001b[?2004h> "]
[189.134425, "o", "    # 3. Stateful map: keep the max score ever seen per player.\r\n\u001b[?2004l\r"]
[189.134466, "o", "\u001b[?2004h> "]
[189.134664, "o", "    def max_score(state, ev):\r\n\u001b[?2004l\r"]
[189.1347, "o", "\u001b[?2004h"]
[189.134734, "o", "> "]
[189.134892, "o", "        score = ev[\"score\"]\r\n\u001b[?2004l\r"]
[189.134933, "o", "\u001b[?2004h"]
[189.134967, "o", "> "]
[189.135211, "o", "        if state is None or score > state:\r\n\u001b[?2004l\r"]
[189.135246, "o", "\u001b[?2004h"]
[189.135278, "o", "> "]
[189.135452, "o", "            new_state = score\r\n\u001b[?2004l\r"]
[189.135491, "o", "\u001b[?2004h"]
[189.135524, "o", "> "]
[189.1356, "o", "        else:\r\n\u001b[?2004l\r"]
[189.135635, "o", "\u001b[?2004h"]
[189.135673, "o", "> "]
[189.135838, "o", "            new_state = state\r\n\u001b[?2004l\r"]
[189.135876, "o", "\u001b[?2004h"]
[189.135909, "o", "> "]
[189.136241, "o", "        return (new_state, (ev[\"player_id\"], new_state))\r\n\u001b[?2004l\r"]
[189.136265, "o", "\u001b[?2004h"]
[189.136321, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h"]
[189.136358, "o", "> "]
[189.136785, "o", "    player_max = op.stateful_map(\"player_max\", keyed, max_score)\r\n\u001b[?2004l\r"]
[189.136827, "o", "\u001b[?2004h"]
[189.136852, "o", "> \r\n\u001b[?2004l\r"]
[189.136878, "o", "\u001b[?2004h"]
[189.136901, "o", "> "]
[189.137348, "o", "    # 4. Re-key to a single global key so all updates land on one worker.\r\n\u001b[?2004l\r"]
[189.137376, "o", "\u001b[?2004h"]
[189.137441, "o", "> "]
[189.137842, "o", "    routed = op.key_on(\"to_global\", player_max, lambda _x: \"GLOBAL\")\r\n\u001b[?2004l\r"]
[189.137916, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[189.137969, "o", "\u001b[?2004h"]
[189.13799, "o", "> "]
[189.138395, "o", "    # 5. Stateful map on the global key: maintain a min-heap of size K\r\n\u001b[?2004l\r"]
[189.138498, "o", "\u001b[?2004h"]
[189.138583, "o", "> "]
[189.138817, "o", "    # representing the top-K (player_id, score) pairs.\r\n\u001b[?2004l\r"]
[189.138909, "o", "\u001b[?2004h> "]
[189.139061, "o", "    def topk_step(state, item):\r\n\u001b[?2004l\r"]
[189.139144, "o", "\u001b[?2004h> "]
[189.139314, "o", "        player_id, score = item\r\n\u001b[?2004l\r"]
[189.139406, "o", "\u001b[?2004h> "]
[189.139507, "o", "        heap = state\r\n\u001b[?2004l\r"]
[189.139591, "o", "\u001b[?2004h> "]
[189.139711, "o", "        if heap is None:\r\n\u001b[?2004l\r"]
[189.139793, "o", "\u001b[?2004h> "]
[189.139906, "o", "            heap = []\r\n\u001b[?2004l\r"]
[189.140004, "o", "\u001b[?2004h> "]
[189.140332, "o", "        current = {pid: sc for sc, pid in heap}\r\n\u001b[?2004l\r\u001b[?2004h"]
[189.140429, "o", "> "]
[189.140627, "o", "        if player_id in current:\r\n\u001b[?2004l\r"]
[189.140721, "o", "\u001b[?2004h> "]
[189.140938, "o", "            if score > current[player_id]:\r\n\u001b[?2004l\r"]
[189.141028, "o", "\u001b[?2004h> "]
[189.141407, "o", "                heap = [(s, p) for (s, p) in heap if p != player_id]\r\n\u001b[?2004l\r"]
[189.141471, "o", "\u001b[?2004h> "]
[189.141702, "o", "                heapq.heapify(heap)\r\n\u001b[?2004l\r"]
[189.141788, "o", "\u001b[?2004h> "]
[189.141869, "o", "            else:\r\n\u001b[?2004l\r"]
[189.141949, "o", "\u001b[?2004h> "]
[189.142268, "o", "                return (heap, _heap_to_sorted_list(heap))\r\n\u001b[?2004l\r"]
[189.142323, "o", "\u001b[?2004h> "]
[189.142502, "o", "        if len(heap) < k:\r\n\u001b[?2004l\r\u001b[?2004h"]
[189.14256, "o", "> "]
[189.142874, "o", "            heapq.heappush(heap, (score, player_id))\r\n\u001b[?2004l\r"]
[189.142973, "o", "\u001b[?2004h> "]
[189.143073, "o", "        else:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[189.143282, "o", "            if score > heap[0][0]:\r\n\u001b[?2004l\r"]
[189.143379, "o", "\u001b[?2004h> "]
[189.143709, "o", "                heapq.heapreplace(heap, (score, player_id))\r\n\u001b[?2004l\r"]
[189.143802, "o", "\u001b[?2004h> "]
[189.144063, "o", "        return (heap, _heap_to_sorted_list(heap))\r\n\u001b[?2004l\r"]
[189.144158, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[189.144566, "o", "    topk_stream = op.stateful_map(\"topk\", routed, topk_step)\r\n\u001b[?2004l\r"]
[189.144664, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[189.14516, "o", "    # 6. Extract the value (sorted top-K list) and output to a collecting sink.\r\n\u001b[?2004l\r"]
[189.145251, "o", "\u001b[?2004h> "]
[189.145624, "o", "    values = op.map_value(\"extract\", topk_stream, lambda v: v)\r\n\u001b[?2004l\r"]
[189.145708, "o", "\u001b[?2004h> "]
[189.145941, "o", "    op.output(\"out\", values, CollectSink())\r\n\u001b[?2004l\r"]
[189.146026, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[189.146113, "o", "> "]
[189.146198, "o", "    return flow\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[189.14628, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[189.146365, "o", "\u001b[?2004h> "]
[189.146811, "o", "# ----------------------------- Entry point ----------------------------- #\r\n\u001b[?2004l\r"]
[189.146894, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[189.146994, "o", "def main():\r\n\u001b[?2004l\r"]
[189.147079, "o", "\u001b[?2004h> "]
[189.147564, "o", "    parser = argparse.ArgumentParser(description=\"Top-K Leaderboard with Bytewax\")\r\n\u001b[?2004l\r"]
[189.147652, "o", "\u001b[?2004h> "]
[189.148062, "o", "    parser.add_argument(\"--input\", required=True, help=\"Input JSONL file\")\r\n\u001b[?2004l\r"]
[189.148144, "o", "\u001b[?2004h> "]
[189.148586, "o", "    parser.add_argument(\"--output\", required=True, help=\"Output JSON file\")\r\n\u001b[?2004l\r"]
[189.148673, "o", "\u001b[?2004h> "]
[189.14909, "o", "    parser.add_argument(\"--k\", required=True, type=int, help=\"Top-K size\")\r\n\u001b[?2004l\r"]
[189.149183, "o", "\u001b[?2004h> "]
[189.149341, "o", "    args = parser.parse_args()\r\n\u001b[?2004l\r"]
[189.149425, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[189.14953, "o", "> "]
[189.149643, "o", "    input_path = args.input\r\n\u001b[?2004l\r"]
[189.149745, "o", "\u001b[?2004h> "]
[189.149878, "o", "    output_path = args.output\r\n\u001b[?2004l\r"]
[189.149963, "o", "\u001b[?2004h> "]
[189.150049, "o", "    k = args.k\r\n\u001b[?2004l\r\u001b[?2004h"]
[189.150134, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[189.150404, "o", "    flow = build_dataflow(input_path, k)\r\n\u001b[?2004l\r"]
[189.150508, "o", "\u001b[?2004h> "]
[189.150592, "o", "    run_main(flow)\r\n\u001b[?2004l\r"]
[189.150676, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[189.150779, "o", "> "]
[189.150864, "o", "    final_top_k = []\r\n\u001b[?2004l\r\u001b[?2004h"]
[189.150949, "o", "> "]
[189.15104, "o", "    if FINAL_OUTPUT:\r\n\u001b[?2004l\r\u001b[?2004h"]
[189.151125, "o", "> "]
[189.151347, "o", "        for item in reversed(FINAL_OUTPUT):\r\n\u001b[?2004l\r"]
[189.151429, "o", "\u001b[?2004h> "]
[189.151543, "o", "            if item:\r\n\u001b[?2004l\r"]
[189.151638, "o", "\u001b[?2004h> "]
[189.151805, "o", "                final_top_k = item\r\n\u001b[?2004l\r"]
[189.151888, "o", "\u001b[?2004h> "]
[189.151999, "o", "                break\r\n\u001b[?2004l\r"]
[189.152085, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[189.152182, "o", "> "]
[189.152597, "o", "    result = [{\"player_id\": pid, \"score\": sc} for (pid, sc) in final_top_k]\r\n\u001b[?2004l\r"]
[189.152682, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[189.152767, "o", "> "]
[189.152957, "o", "    with open(output_path, \"w\") as f:\r\n\u001b[?2004l\r\u001b[?2004h"]
[189.15305, "o", "> "]
[189.153184, "o", "        json.dump(result, f)\r\n\u001b[?2004l\r"]
[189.153267, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[189.153362, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[189.153542, "o", "if __name__ == \"__main__\":\r\n\u001b[?2004l\r"]
[189.153629, "o", "\u001b[?2004h>     main()\r\n\u001b[?2004l\r"]
[189.153711, "o", "\u001b[?2004h> PYEOF\r\n\u001b[?2004l\r"]
