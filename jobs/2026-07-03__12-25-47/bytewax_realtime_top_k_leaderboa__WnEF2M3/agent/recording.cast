[230.967981, "i", "cat > /tmp/debug.py << 'EOF'\nimport json, heapq\nk=3\npms={}\nth=[]\nwith open('/tmp/test_input.jsonl') as f:\n    for line in f:\n        line = line.strip()\n        if not line:\n            continue\n        e = json.loads(line)\n        pid = e['player_id']\n        sc = e['score']\n        pms[pid] = max(pms.get(pid, 0), sc)\n        c = {p: s for s, p in th}\n        if pid in c and sc > c[pid]:\n            th = [(s, p) for s, p in th if p != pid]\n            heapq.heapify(th)\n        if len(th) < k:\n            heapq.heappush(th, (sc, pid))\n        elif sc > th[0][0]:\n            heapq.heapreplace(th, (sc, pid))\n\nprint('Final heap:', th)\nprint('Top-K sorted:', sorted(((p, s) for s, p in th), key=lambda x: x[1], reverse=True))\nEOF\npython3 /tmp/debug.py\n"]
