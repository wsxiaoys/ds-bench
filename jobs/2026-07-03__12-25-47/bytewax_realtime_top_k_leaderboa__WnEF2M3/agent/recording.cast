[91.714895, "o", "#!/usr/bin/env python3\r\n\u001b[?2004l\r"]
[91.714929, "o", "\u001b[?2004h> "]
[91.715187, "o", "\"\"\"Real-time Top-K Leaderboard using Bytewax.\"\"\"\r\n\u001b[?2004l\r"]
[91.71521, "o", "\u001b[?2004h"]
[91.715258, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h"]
[91.715281, "o", "> "]
[91.715355, "o", "import argparse\r\n\u001b[?2004l\r"]
[91.715378, "o", "\u001b[?2004h"]
[91.715402, "o", "> "]
[91.715471, "o", "import heapq\r\n\u001b[?2004l\r"]
[91.715507, "o", "\u001b[?2004h> "]
[91.715578, "o", "import json\r\n\u001b[?2004l\r"]
[91.715612, "o", "\u001b[?2004h> "]
[91.715676, "o", "import sys\r\n\u001b[?2004l\r"]
[91.715698, "o", "\u001b[?2004h"]
[91.715723, "o", "> "]
[91.715849, "o", "from pathlib import Path\r\n\u001b[?2004l\r"]
[91.715872, "o", "\u001b[?2004h"]
[91.715914, "o", "> "]
[91.716086, "o", "from typing import Dict, List, Optional, Tuple\r\n\u001b[?2004l\r"]
[91.716109, "o", "\u001b[?2004h> "]
[91.716151, "o", "\r\n\u001b[?2004l\r\u001b[?2004h"]
[91.716173, "o", "> "]
[91.716312, "o", "import bytewax.operators as op\r\n\u001b[?2004l\r"]
[91.716336, "o", "\u001b[?2004h> "]
[91.71653, "o", "from bytewax.dataflow import Dataflow\r\n\u001b[?2004l\r"]
[91.716565, "o", "\u001b[?2004h> "]
[91.716929, "o", "from bytewax.inputs import FixedPartitionedSource, StatefulSourcePartition\r\n\u001b[?2004l\r"]
[91.716952, "o", "\u001b[?2004h"]
[91.716974, "o", "> "]
[91.717275, "o", "from bytewax.outputs import DynamicSink, StatelessSinkPartition\r\n\u001b[?2004l\r"]
[91.717308, "o", "\u001b[?2004h> "]
[91.71751, "o", "from bytewax.testing import run_main\r\n\u001b[?2004l\r"]
[91.717532, "o", "\u001b[?2004h"]
[91.717575, "o", "> "]
[91.717747, "o", "from typing_extensions import override\r\n\u001b[?2004l\r"]
[91.717778, "o", "\u001b[?2004h"]
[91.717799, "o", "> \r\n\u001b[?2004l\r"]
[91.71783, "o", "\u001b[?2004h> "]
[91.717881, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[91.718099, "o", "# Global to capture the final Top-K output.\r\n\u001b[?2004l\r"]
[91.718133, "o", "\u001b[?2004h> "]
[91.718286, "o", "FINAL_OUTPUT: List[Dict] = []\r\n\u001b[?2004l\r"]
[91.718308, "o", "\u001b[?2004h"]
[91.71835, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h"]
[91.718373, "o", "> \r\n\u001b[?2004l\r"]
[91.718417, "o", "\u001b[?2004h> "]
[91.718794, "o", "# ----------------------------- Input Source ----------------------------- #\r\n\u001b[?2004l\r"]
[91.718825, "o", "\u001b[?2004h"]
[91.718848, "o", "> \r\n\u001b[?2004l\r"]
[91.71889, "o", "\u001b[?2004h> "]
[91.719117, "o", "class _JSONLPartition(StatefulSourcePartition):\r\n\u001b[?2004l\r"]
[91.719151, "o", "\u001b[?2004h> "]
[91.719408, "o", "    def __init__(self, path: str, resume_state):\r\n\u001b[?2004l\r"]
[91.719441, "o", "\u001b[?2004h"]
[91.719467, "o", "> "]
[91.719592, "o", "        self._path = path\r\n\u001b[?2004l\r"]
[91.719614, "o", "\u001b[?2004h"]
[91.719668, "o", "> "]
[91.71981, "o", "        self._f = open(path, \"rt\")\r\n\u001b[?2004l\r"]
[91.719831, "o", "\u001b[?2004h"]
[91.719875, "o", "> "]
[91.720038, "o", "        if resume_state is not None:\r\n\u001b[?2004l\r"]
[91.720101, "o", "\u001b[?2004h"]
[91.72014, "o", "> "]
[91.720274, "o", "            self._f.seek(resume_state)\r\n\u001b[?2004l\r"]
[91.720306, "o", "\u001b[?2004h> "]
[91.720452, "o", "        self._eof = False\r\n\u001b[?2004l\r"]
[91.720474, "o", "\u001b[?2004h"]
[91.720521, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h"]
[91.720542, "o", "> "]
[91.72061, "o", "    @override\r\n\u001b[?2004l\r"]
[91.720631, "o", "\u001b[?2004h"]
[91.720677, "o", "> "]
[91.720777, "o", "    def next_batch(self):\r\n\u001b[?2004l\r"]
[91.72081, "o", "\u001b[?2004h> "]
[91.720918, "o", "        batch = []\r\n\u001b[?2004l\r"]
[91.720941, "o", "\u001b[?2004h"]
[91.720983, "o", "> "]
[91.721352, "o", "        # Read the entire file in a single batch for simplicity; the dataflow\r\n\u001b[?2004l\r"]
[91.721384, "o", "\u001b[?2004h"]
[91.721407, "o", "> "]
[91.721517, "o", "        # is bounded.\r\n\u001b[?2004l\r"]
[91.721557, "o", "\u001b[?2004h"]
[91.72158, "o", "> "]
[91.7217, "o", "        for line in self._f:\r\n\u001b[?2004l\r"]
[91.721721, "o", "\u001b[?2004h"]
[91.721764, "o", "> "]
[91.721898, "o", "            line = line.strip()\r\n\u001b[?2004l\r"]
[91.721921, "o", "\u001b[?2004h"]
[91.721963, "o", "> "]
[91.722064, "o", "            if not line:\r\n\u001b[?2004l\r"]
[91.722086, "o", "\u001b[?2004h"]
[91.72213, "o", "> "]
[91.722226, "o", "                continue\r\n\u001b[?2004l\r"]
[91.722249, "o", "\u001b[?2004h"]
[91.72229, "o", "> "]
[91.722417, "o", "            batch.append(line)\r\n\u001b[?2004l\r"]
[91.722455, "o", "\u001b[?2004h> "]
[91.722592, "o", "        self._eof = True\r\n\u001b[?2004l\r"]
[91.722614, "o", "\u001b[?2004h"]
[91.722656, "o", "> "]
[91.722741, "o", "        return batch\r\n\u001b[?2004l\r"]
[91.722764, "o", "\u001b[?2004h"]
[91.722788, "o", "> \r\n\u001b[?2004l\r"]
[91.722813, "o", "\u001b[?2004h> "]
[91.722903, "o", "    @override\r\n\u001b[?2004l\r"]
[91.722925, "o", "\u001b[?2004h"]
[91.722967, "o", "> "]
[91.723059, "o", "    def snapshot(self):\r\n\u001b[?2004l\r"]
[91.723082, "o", "\u001b[?2004h"]
[91.723123, "o", "> "]
[91.72325, "o", "        return self._f.tell()\r\n\u001b[?2004l\r"]
[91.723272, "o", "\u001b[?2004h"]
[91.723314, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h"]
[91.723347, "o", "> "]
[91.723406, "o", "    @override\r\n\u001b[?2004l\r"]
[91.723427, "o", "\u001b[?2004h"]
[91.723482, "o", "> "]
[91.723565, "o", "    def close(self):\r\n\u001b[?2004l\r"]
[91.7236, "o", "\u001b[?2004h> "]
[91.723664, "o", "        try:\r\n\u001b[?2004l\r"]
[91.723686, "o", "\u001b[?2004h"]
[91.723728, "o", "> "]
[91.723846, "o", "            self._f.close()\r\n\u001b[?2004l\r"]
[91.723868, "o", "\u001b[?2004h"]
[91.723911, "o", "> "]
[91.724019, "o", "        except Exception:\r\n\u001b[?2004l\r"]
[91.724043, "o", "\u001b[?2004h"]
[91.724083, "o", "> "]
[91.724152, "o", "            pass\r\n\u001b[?2004l\r"]
[91.724174, "o", "\u001b[?2004h"]
[91.724216, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h"]
[91.724248, "o", "> "]
[91.724307, "o", "    @override\r\n\u001b[?2004l\r"]
[91.724328, "o", "\u001b[?2004h"]
[91.724371, "o", "> "]
[91.724495, "o", "    def next_awake(self):\r\n\u001b[?2004l\r"]
[91.724536, "o", "\u001b[?2004h> "]
[91.724631, "o", "        return None\r\n\u001b[?2004l\r"]
[91.724653, "o", "\u001b[?2004h"]
[91.724695, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h"]
[91.724719, "o", "> \r\n\u001b[?2004l\r"]
[91.724763, "o", "\u001b[?2004h> "]
[91.72498, "o", "class JSONLSource(FixedPartitionedSource):\r\n\u001b[?2004l\r"]
[91.725002, "o", "\u001b[?2004h"]
[91.725046, "o", "> "]
[91.725325, "o", "    \"\"\"A source that reads a JSONL file line-by-line.\"\"\"\r\n\u001b[?2004l\r"]
[91.725348, "o", "\u001b[?2004h"]
[91.725391, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h"]
[91.725453, "o", "> "]
[91.72562, "o", "    def __init__(self, path: str):\r\n\u001b[?2004l\r"]
[91.725649, "o", "\u001b[?2004h> "]
[91.725796, "o", "        self._path = path\r\n\u001b[?2004l\r"]
[91.725848, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[91.725889, "o", "> "]
[91.725956, "o", "    @override\r\n\u001b[?2004l\r"]
[91.726002, "o", "\u001b[?2004h> "]
[91.726125, "o", "    def list_parts(self):\r\n\u001b[?2004l\r"]
[91.726154, "o", "\u001b[?2004h> "]
[91.726291, "o", "        return [\"single\"]\r\n\u001b[?2004l\r"]
[91.726327, "o", "\u001b[?2004h> "]
[91.726351, "o", "\r\n\u001b[?2004l\r"]
[91.7264, "o", "\u001b[?2004h> "]
[91.72646, "o", "    @override\r\n\u001b[?2004l\r"]
[91.726495, "o", "\u001b[?2004h> "]
[91.726806, "o", "    def build_part(self, step_id, for_part, resume_state):\r\n\u001b[?2004l\r"]
[91.72683, "o", "\u001b[?2004h> "]
[91.727126, "o", "        return _JSONLPartition(self._path, resume_state)\r\n\u001b[?2004l\r"]
[91.727151, "o", "\u001b[?2004h"]
[91.727194, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h"]
[91.727217, "o", "> \r\n\u001b[?2004l\r"]
[91.727262, "o", "\u001b[?2004h> "]
[91.727638, "o", "# ----------------------------- Output Sink ----------------------------- #\r\n\u001b[?2004l\r"]
[91.727662, "o", "\u001b[?2004h"]
[91.727713, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[91.727992, "o", "class _CollectSinkPartition(StatelessSinkPartition):\r\n\u001b[?2004l\r"]
[91.728015, "o", "\u001b[?2004h> "]
[91.728154, "o", "    def __init__(self):\r\n\u001b[?2004l\r"]
[91.728176, "o", "\u001b[?2004h"]
[91.72822, "o", "> "]
[91.72835, "o", "        self._items: List = []\r\n\u001b[?2004l\r"]
[91.728378, "o", "\u001b[?2004h"]
[91.728419, "o", "> \r\n\u001b[?2004l\rt\u001b[?2004h"]
[91.72846, "o", "> "]
[91.728518, "o", "    @override\r\n\u001b[?2004l\r"]
[91.72855, "o", "\u001b[?2004h> "]
[91.72872, "o", "    def write_batch(self, items):\r\n\u001b[?2004l\r"]
[91.728753, "o", "\u001b[?2004h> "]
[91.728929, "o", "        self._items.extend(items)\r\n\u001b[?2004l\r"]
[91.728951, "o", "\u001b[?2004h"]
[91.728995, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h"]
[91.729016, "o", "> "]
[91.72911, "o", "    @override\r\n\u001b[?2004l\r"]
[91.729149, "o", "\u001b[?2004h> "]
[91.729236, "o", "    def close(self):\r\n\u001b[?2004l\r"]
[91.729259, "o", "\u001b[?2004h"]
[91.729308, "o", "> "]
[91.729547, "o", "        FINAL_OUTPUT.extend(self._items)\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[91.729577, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[91.729632, "o", "\u001b[?2004h> "]
[91.729787, "o", "class CollectSink(DynamicSink):\r\n\u001b[?2004l\r"]
[91.729827, "o", "\u001b[?2004h> "]
[91.729886, "o", "    @override\r\n\u001b[?2004l\r"]
[91.729921, "o", "\u001b[?2004h> "]
[91.730189, "o", "    def build(self, step_id, worker_index, worker_count):\r\n\u001b[?2004l\r"]
[91.730233, "o", "\u001b[?2004h> "]
[91.730396, "o", "        return _CollectSinkPartition()\r\n\u001b[?2004l\r"]
[91.730418, "o", "\u001b[?2004h> "]
[91.73044, "o", "\r\n\u001b[?2004l\r"]
[91.730518, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[91.73055, "o", "> "]
[91.730846, "o", "# ----------------------------- Dataflow ----------------------------- #\r\n\u001b[?2004l\r"]
[91.730888, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[91.730912, "o", "\u001b[?2004h> "]
[91.731165, "o", "def build_dataflow(input_path: str, k: int) -> Dataflow:\r\n\u001b[?2004l\r"]
[91.731188, "o", "\u001b[?2004h"]
[91.731238, "o", "> "]
[91.731359, "o", "    flow = Dataflow(\"leaderboard\")\r\n\u001b[?2004l\r"]
[91.731399, "o", "\u001b[?2004h> "]
[91.731421, "o", "\r\n\u001b[?2004l\r\u001b[?2004h"]
[91.731478, "o", "> "]
[91.731595, "o", "    # 1. Read raw JSONL lines.\r\n\u001b[?2004l\r"]
[91.73163, "o", "\u001b[?2004h"]
[91.731665, "o", "> "]
[91.731883, "o", "    raw = op.input(\"in\", flow, JSONLSource(input_path))\r\n\u001b[?2004l\r"]
[91.731919, "o", "\u001b[?2004h> "]
[91.731954, "o", "\r\n\u001b[?2004l\r\u001b[?2004h"]
[91.731976, "o", "> "]
[91.732276, "o", "    # 2. Parse each line into (player_id, score) and key on player_id.\r\n\u001b[?2004l\r"]
[91.732303, "o", "\u001b[?2004h"]
[91.732355, "o", "> "]
[91.732606, "o", "    parsed = op.map(\"parse\", raw, lambda line: json.loads(line))\r\n\u001b[?2004l\r"]
[91.73265, "o", "\u001b[?2004h> "]
[91.732959, "o", "    keyed = op.key_on(\"by_player\", parsed, lambda ev: ev[\"player_id\"])\r\n\u001b[?2004l\r"]
[91.732981, "o", "\u001b[?2004h"]
[91.733033, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h"]
[91.733057, "o", "> "]
[91.733318, "o", "    # 3. Stateful map: keep the max score ever seen per player.\r\n\u001b[?2004l\r"]
[91.73334, "o", "\u001b[?2004h"]
[91.733392, "o", "> "]
[91.733498, "o", "    def max_score(state, ev):\r\n\u001b[?2004l\r"]
[91.733521, "o", "\u001b[?2004h"]
[91.733579, "o", "> "]
[91.73366, "o", "        score = ev[\"score\"]\r\n\u001b[?2004l\r"]
[91.733692, "o", "\u001b[?2004h> "]
[91.733885, "o", "        if state is None or score > state:\r\n\u001b[?2004l\r"]
[91.733911, "o", "\u001b[?2004h"]
[91.733964, "o", "> "]
[91.734062, "o", "            new_state = score\r\n\u001b[?2004l\r"]
[91.734095, "o", "\u001b[?2004h> "]
[91.734166, "o", "        else:\r\n\u001b[?2004l\r"]
[91.734188, "o", "\u001b[?2004h"]
[91.734234, "o", "> "]
[91.734334, "o", "            new_state = state\r\n\u001b[?2004l\r"]
[91.734366, "o", "\u001b[?2004h> "]
[91.734628, "o", "        return (new_state, (ev[\"player_id\"], new_state))\r\n\u001b[?2004l\r"]
[91.734652, "o", "\u001b[?2004h"]
[91.734702, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h"]
[91.734734, "o", "> "]
[91.734977, "o", "    player_max = op.stateful_map(\"player_max\", keyed, max_score)\r\n\u001b[?2004l\r"]
[91.735012, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[91.735044, "o", "\u001b[?2004h> "]
[91.735346, "o", "    # 4. Re-key to a single global key so all updates land on one worker.\r\n\u001b[?2004l\r"]
[91.73537, "o", "\u001b[?2004h> "]
[91.73569, "o", "    routed = op.key_on(\"to_global\", player_max, lambda _x: \"GLOBAL\")\r\n\u001b[?2004l\r"]
[91.735715, "o", "\u001b[?2004h> "]
[91.73577, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[91.736071, "o", "    # 5. Stateful map on the global key: maintain a min-heap of size K\r\n\u001b[?2004l\r"]
[91.736106, "o", "\u001b[?2004h> "]
[91.736353, "o", "    # representing the top-K (player_id, score) pairs.\r\n\u001b[?2004l\r"]
[91.736374, "o", "\u001b[?2004h"]
[91.736426, "o", "> "]
[91.736732, "o", "    # The state is the min-heap (list). The min element (smallest score\r\n\u001b[?2004l\r"]
[91.736775, "o", "\u001b[?2004h> "]
[91.736907, "o", "    # in the heap) is at heap[0].\r\n\u001b[?2004l\r"]
[91.736953, "o", "\u001b[?2004h"]
[91.736979, "o", "> "]
[91.73711, "o", "    def topk_step(state, item):\r\n\u001b[?2004l\r"]
[91.737153, "o", "\u001b[?2004h"]
[91.737198, "o", "> "]
[91.737371, "o", "        # item is a tuple: (player_id, score)\r\n\u001b[?2004l\r"]
[91.737408, "o", "\u001b[?2004h> "]
[91.737557, "o", "        player_id, score = item\r\n\u001b[?2004l\r"]
[91.73758, "o", "\u001b[?2004h> "]
[91.73769, "o", "        heap = state\r\n\u001b[?2004l\r"]
[91.737714, "o", "\u001b[?2004h> "]
[91.737839, "o", "        if heap is None:\r\n\u001b[?2004l\r"]
[91.737862, "o", "\u001b[?2004h"]
[91.73792, "o", "> "]
[91.737971, "o", "            heap = []\r\n\u001b[?2004l\r"]
[91.737994, "o", "\u001b[?2004h"]
[91.738046, "o", "> "]
[91.738312, "o", "        # Build a lookup of player_id -> score currently in the heap.\r\n\u001b[?2004l\r"]
[91.738333, "o", "\u001b[?2004h"]
[91.738399, "o", "> "]
[91.738574, "o", "        current = {pid: sc for sc, pid in heap}\r\n\u001b[?2004l\r"]
[91.73861, "o", "\u001b[?2004h> "]
[91.73877, "o", "        if player_id in current:\r\n\u001b[?2004l\r"]
[91.738792, "o", "\u001b[?2004h"]
[91.738838, "o", "> "]
[91.739001, "o", "            if score > current[player_id]:\r\n\u001b[?2004l\r"]
