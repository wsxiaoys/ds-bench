[237.026045, "o", "FINAL_OUTPUT type: <class 'list'>\r\nFINAL_OUTPUT length: 11\r\nItem 0: type=tuple, value=('GLOBAL', [('alice', ('alice', 100))])\r\nItem 1: type=tuple, value=('GLOBAL', [('alice', ('alice', 150))])\r\nItem 2: type=tuple, value=('GLOBAL', [('alice', ('alice', 150))])\r\nItem 3: type=tuple, value=('GLOBAL', [('bob', ('bob', 50)), ('alice', ('alice', 150))])\r\nItem 4: type=tuple, value=('GLOBAL', [('bob', ('bob', 80)), ('alice', ('alice', 150))])\r\nItem 5: type=tuple, value=('GLOBAL', [('charlie', ('charlie', 75)), ('bob', ('bob', 80)), ('alice', ('alice', 150))])\r\nItem 6: type=tuple, value=('GLOBAL', [('charlie', ('charlie', 75)), ('bob', ('bob', 80)), ('alice', ('alice', 150))])\r\nItem 7: type=tuple, value=('GLOBAL', [('dave', ('dave', 200)), ('charlie', ('charlie', 75)), ('bob', ('bob', 80))])\r\nItem 8: type=tuple, value=('GLOBAL', [('dave', ('dave', 250)), ('charlie', ('charlie', 75)), ('bob', ('bob', 80))])\r\nItem 9: type=tuple, value=('GLOBAL', [('eve', ('eve', 90)), ('dave', ('dave', 250)), ('charlie', ('charlie', 75))])\r\nItem 10: type=tuple, value=('GLOBAL', [('frank', ('frank', 30)), ('eve', ('eve', 90)), ('dave', ('dave', 250))])\r\n"]
