@operator
def key_on(step_id: str, up: Stream[X], key: Callable[[X], str]) -> KeyedStream[X]:
    """Add a key for each item.

    This allows you to use all the keyed operators that require the
    upstream to be a {py:obj}`KeyedStream`.

    ```{testcode}
    from bytewax.dataflow import Dataflow
    import bytewax.operators as op
    from bytewax.testing import TestingSource
    from datetime import timedelta

    flow = Dataflow("collect_eg")
    source = [
        {"key": "a", "val": 1},
        {"key": "b", "val": 2}
    ]
    nums = op.input("nums", flow, TestingSource(source))

    keyed = op.key_on("key", nums, lambda x: x['key'])

    op.inspect("out", keyed)
    ```

    ```{testcode}
    :hide:
    from bytewax.testing import run_main
    run_main(flow)
    ```

    ```{testoutput}
    collect_eg.out: ('a', {'key': 'a', 'val': 1})
    collect_eg.out: ('b', {'key': 'b', 'val': 2})
    ```

    :arg step_id: Unique ID.

    :arg up: Stream.

    :arg key: Called on each item and should return the key for that
        item.

    :returns: A stream of 2-tuples of `(key, item)` AKA a keyed
        stream. The keys come from the return value of the `key`
        function; upstream items will REDACTEDmatically be attached as
        values.

    """

    def shim_mapper(x: X) -> Tuple[str, X]:
        k = key(x)
        if not isinstance(k, str):
            msg = (
                f"return value of `key` {f_repr(key)} "
                f"in step {step_id!r} must be a `str`; "
                f"got a {type(k)!r} instead"
            )
            raise TypeError(msg)
        return (k, x)

    return map("map", up, shim_mapper)


@operator
def key_rm(step_id: str, up: KeyedStream[X]) -> Stream[X]:
[?2004hroot@4ee094ad-84dd-40c1-99e6-773a4e8e5d51:~# cat run.py
[?2004limport json
from datetime import datetime, timedelta
from pathlib import Path
from typing import Any, Dict, Iterable, Tuple

from bytewax import operators as op
from bytewax.connectors.files import FileSink, FileSource
from bytewax.dataflow import Dataflow
from bytewax.operators import StatefulLogic
from bytewax.testing import run_main

WINDOW = timedelta(seconds=10)


def parse_ts(s) -> datetime:
    # Accept either an ISO 8601 string or a datetime object.
    if isinstance(s, datetime):
        return s
    if s.endswith("Z"):
        s = s[:-1] + "+00:00"
    return datetime.fromisoformat(s)


class DedupLogic(StatefulLogic[Dict[str, Any], Dict[str, Any], Dict[str, datetime]]):
    """Per-user_id event-id deduplication over a sliding 10s window."""

    RETAIN: bool = StatefulLogic.RETAIN

    def __init__(self, resume_state):
        # state maps event_id -> last emitted timestamp (datetime)
        self._state: Dict[str, datetime] = dict(resume_state) if resume_state else {}

    def on_item(
        self, value: Dict[str, Any]
    ) -> Tuple[Iterable[Dict[str, Any]], bool]:
        event_id = value["event_id"]
        ts = parse_ts(value["timestamp"])

        # Clean up: drop entries older than the window relative to the
        # current event's timestamp.
        stale = [
            eid for eid, last_ts in self._state.items()
            if ts - last_ts > WINDOW
        ]
        for eid in stale:
            del self._state[eid]

        # Deduplication: if the same event_id was seen within last 10s
        # (inclusive of exactly 10s), drop the new event.
        prev_ts = self._state.get(event_id)
        if prev_ts is not None and ts <= prev_ts + WINDOW:
            return (iter(()), StatefulLogic.RETAIN)

        # Otherwise emit, and (re)start the 10s window for this event_id.
        self._state[event_id] = ts
        return (iter((value,)), StatefulLogic.RETAIN)

    def snapshot(self) -> Dict[str, datetime]:
        # State must be effectively immutable on return.
        return dict(self._state)


def build_logic(resume_state):
    return DedupLogic(resume_state)


def build_flow(input_path: Path, output_path: Path) -> Dataflow:
    flow = Dataflow("stateful_dedup")

    # Read raw lines from the input file.
    lines = op.input("input", flow, FileSource(str(input_path)))

    # Parse JSON -> dict. Timestamps stay as strings until on_item parses
    # them.
    parsed = op.map("parse_json", lines, lambda line: json.loads(line))

    # Key the stream by user_id so state is maintained per user.
    keyed = op.key_on("key_user", parsed, lambda event: event["user_id"])

    # Apply stateful dedup. Produces a keyed stream (user_id, event).
    deduped = op.stateful("dedup", keyed, build_logic)

    # Restore timestamps to ISO 8601 strings and serialize to JSON.
    def _format(item):
        user_id, event = item
        out = dict(event)
        ts = out["timestamp"]
        if isinstance(ts, datetime):
            if ts.tzinfo is not None:
                ts = ts.astimezone(tz=ts.tzinfo).replace(microsecond=0)
                out["timestamp"] = ts.isoformat().replace("+00:00", "Z")
            else:
                out["timestamp"] = ts.isoformat()
        # Keep (key, value) shape because FileSink is a fixed-partitioned
        # sink and routes by key.
        return (user_id, json.dumps(out))

    out_lines = op.map("to_json", deduped, _format)

    # Write lines out.
    op.output("output", out_lines, FileSink(str(output_path)))

    return flow


if __name__ == "__main__":
    run_main(build_flow(Path("input.jsonl"), Path("output.jsonl")))
