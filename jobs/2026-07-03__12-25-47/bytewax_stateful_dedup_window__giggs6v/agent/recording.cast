[323.9924, "o", "\u001b[?2004h> "]
[323.992748, "o", "            dict(resume_state) if resume_state else {}\r\n\u001b[?2004l\r"]
[323.992808, "o", "\u001b[?2004h> "]
[323.992906, "o", "        )\r\n\u001b[?2004l\r\u001b[?2004h> "]
[323.992979, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[323.993106, "o", "    def on_item(\r\n\u001b[?2004l\r"]
[323.993167, "o", "\u001b[?2004h> "]
[323.99339, "o", "        self, value: Dict[str, Any]\r\n\u001b[?2004l\r"]
[323.993453, "o", "\u001b[?2004h> "]
[323.993752, "o", "    ) -> Tuple[Iterable[Dict[str, Any]], bool]:\r\n\u001b[?2004l\r"]
[323.993829, "o", "\u001b[?2004h> "]
[323.994062, "o", "        event_id = value[\"event_id\"]\r\n\u001b[?2004l\r"]
[323.994125, "o", "\u001b[?2004h> "]
[323.994393, "o", "        ts = _parse_ts(value[\"timestamp\"])\r\n\u001b[?2004l\r"]
[323.994453, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[323.994549, "o", "\u001b[?2004h> "]
[323.995016, "o", "        # 1) Drop entries outside the sliding window (strictly older than\r\n\u001b[?2004l\r"]
[323.995079, "o", "\u001b[?2004h> "]
[323.995417, "o", "        #    10s from the current event's timestamp).\r\n\u001b[?2004l\r"]
[323.995478, "o", "\u001b[?2004h> "]
[323.995605, "o", "        stale = [\r\n\u001b[?2004l\r"]
[323.995666, "o", "\u001b[?2004h> "]
[323.996039, "o", "            eid for eid, last_ts in self._state.items()\r\n\u001b[?2004l\r"]
[323.996101, "o", "\u001b[?2004h> "]
[323.996333, "o", "            if ts - last_ts > WINDOW\r\n\u001b[?2004l\r"]
[323.996395, "o", "\u001b[?2004h> "]
[323.996504, "o", "        ]\r\n\u001b[?2004l\r\u001b[?2004h> "]
[323.996693, "o", "        for eid in stale:\r\n\u001b[?2004l\r"]
[323.996752, "o", "\u001b[?2004h> "]
[323.996969, "o", "            del self._state[eid]\r\n\u001b[?2004l\r"]
[323.997033, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[323.997132, "o", "> "]
[323.997519, "o", "        # 2) Deduplication check against the freshly-cleared state.\r\n\u001b[?2004l\r"]
[323.99758, "o", "\u001b[?2004h> "]
[323.997871, "o", "        prev_ts = self._state.get(event_id)\r\n\u001b[?2004l\r"]
[323.997943, "o", "\u001b[?2004h> "]
[323.998323, "o", "        if prev_ts is not None and ts <= prev_ts + WINDOW:\r\n\u001b[?2004l\r"]
[323.998383, "o", "\u001b[?2004h> "]
[323.998841, "o", "            # Duplicate within the window (or exactly at the boundary).\r\n\u001b[?2004l\r"]
[323.998902, "o", "\u001b[?2004h> "]
[323.999246, "o", "            return (iter(()), StatefulLogic.RETAIN)\r\n\u001b[?2004l\r"]
[323.999309, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[323.999371, "o", "\u001b[?2004h> "]
[323.999841, "o", "        # 3) Emit and (re)start the 10-second window for this event_id.\r\n\u001b[?2004l\r"]
[323.999901, "o", "\u001b[?2004h> "]
[324.000146, "o", "        self._state[event_id] = ts\r\n\u001b[?2004l\r"]
[324.000208, "o", "\u001b[?2004h> "]
[324.000552, "o", "        return (iter((value,)), StatefulLogic.RETAIN)\r\n\u001b[?2004l\r"]
[324.000615, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[324.000672, "o", "\u001b[?2004h> "]
[324.000995, "o", "    def snapshot(self) -> Dict[str, datetime]:\r\n\u001b[?2004l\r"]
[324.001058, "o", "\u001b[?2004h> "]
[324.001395, "o", "        # Must return an effectively immutable copy.\r\n\u001b[?2004l\r"]
[324.001455, "o", "\u001b[?2004h> "]
[324.001668, "o", "        return dict(self._state)\r\n\u001b[?2004l\r"]
[324.001729, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[324.001787, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[324.001845, "o", "\u001b[?2004h> "]
[324.002092, "o", "def _build_logic(resume_state):\r\n\u001b[?2004l\r"]
[324.002154, "o", "\u001b[?2004h> "]
[324.00238, "o", "    return DedupLogic(resume_state)\r\n\u001b[?2004l\r"]
[324.00244, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[324.002498, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[324.002555, "o", "\u001b[?2004h> "]
[324.002974, "o", "class _OrderedJsonlSinkPartition(StatelessSinkPartition[Any]):\r\n\u001b[?2004l\r\u001b[?2004h"]
[324.003028, "o", "> "]
[324.00347, "o", "    \"\"\"Buffers items, then writes them sorted by an embedded sequence\r\n\u001b[?2004l\r"]
[324.003526, "o", "\u001b[?2004h> "]
[324.003958, "o", "    number so the resulting JSONL file preserves input ordering.\r\n\u001b[?2004l\r"]
[324.004016, "o", "\u001b[?2004h> "]
[324.004123, "o", "    \"\"\"\r\n\u001b[?2004l\r\u001b[?2004h> "]
[324.004186, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[324.004498, "o", "    def __init__(self, path: Path) -> None:\r\n\u001b[?2004l\r"]
[324.004558, "o", "\u001b[?2004h> "]
[324.004733, "o", "        self._path = path\r\n\u001b[?2004l\r"]
[324.004794, "o", "\u001b[?2004h> "]
[324.00508, "o", "        self._items: list = []\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[324.005145, "o", "\u001b[?2004h> "]
[324.005244, "o", "    @override\r\n\u001b[?2004l\r"]
[324.005302, "o", "\u001b[?2004h> "]
[324.005566, "o", "    def write_batch(self, items) -> None:\r\n\u001b[?2004l\r"]
[324.005626, "o", "\u001b[?2004h> "]
[324.005853, "o", "        self._items.extend(items)\r\n\u001b[?2004l\r"]
[324.005921, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[324.005979, "o", "\u001b[?2004h> "]
[324.006101, "o", "    @override\r\n\u001b[?2004l\r\u001b[?2004h"]
[324.006161, "o", "> "]
[324.006334, "o", "    def close(self) -> None:\r\n\u001b[?2004l\r"]
[324.006394, "o", "\u001b[?2004h> "]
[324.006737, "o", "        self._items.sort(key=lambda it: it[\"__seq\"])\r\n\u001b[?2004l\r"]
[324.006801, "o", "\u001b[?2004h> "]
[324.007074, "o", "        with self._path.open(\"wt\") as f:\r\n\u001b[?2004l\r"]
[324.007137, "o", "\u001b[?2004h> "]
[324.00738, "o", "            for item in self._items:\r\n\u001b[?2004l\r"]
[324.007439, "o", "\u001b[?2004h> "]
[324.007699, "o", "                item.pop(\"__seq\", None)\r\n\u001b[?2004l\r"]
[324.007758, "o", "\u001b[?2004h> "]
[324.008045, "o", "                f.write(json.dumps(item))\r\n\u001b[?2004l\r"]
[324.008105, "o", "\u001b[?2004h> "]
[324.008306, "o", "                f.write(\"\\n\")\r\n\u001b[?2004l\r"]
[324.008366, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[324.00847, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[324.008765, "o", "class OrderedJsonlSink(DynamicSink[Any]):\r\n\u001b[?2004l\r"]
[324.008825, "o", "\u001b[?2004h> "]
[324.009311, "o", "    \"\"\"Custom sink that writes a JSONL file while preserving the order\r\n\u001b[?2004l\r"]
[324.009374, "o", "\u001b[?2004h> "]
[324.009643, "o", "    of items received from upstream.\"\"\"\r\n\u001b[?2004l\r"]
[324.009706, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[324.009804, "o", "\u001b[?2004h> "]
[324.010021, "o", "    def __init__(self, path) -> None:\r\n\u001b[?2004l\r"]
[324.010084, "o", "\u001b[?2004h> "]
[324.010263, "o", "        self._path = path\r\n\u001b[?2004l\r"]
[324.010324, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[324.010426, "o", "\u001b[?2004h> "]
[324.010482, "o", "    @override\r\n\u001b[?2004l\r"]
[324.010658, "o", "\u001b[?2004h> "]
[324.010939, "o", "    def build(self, step_id, worker_index, worker_count):\r\n\u001b[?2004l\r"]
[324.011, "o", "\u001b[?2004h> "]
[324.011384, "o", "        return _OrderedJsonlSinkPartition(Path(self._path))\r\n\u001b[?2004l\r"]
[324.011447, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[324.011549, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[324.011608, "o", "> "]
[324.011928, "o", "def build_flow(input_path, output_path) -> Dataflow:\r\n\u001b[?2004l\r"]
[324.011992, "o", "\u001b[?2004h> "]
[324.012235, "o", "    flow = Dataflow(\"stateful_dedup\")\r\n\u001b[?2004l\r"]
[324.012296, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[324.012397, "o", "\u001b[?2004h> "]
[324.01265, "o", "    # 1) Read raw lines from the input file.\r\n\u001b[?2004l\r"]
[324.012709, "o", "\u001b[?2004h> "]
[324.013136, "o", "    lines = op.input(\"input\", flow, FileSource(str(input_path)))\r\n\u001b[?2004l\r"]
[324.013198, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[324.013304, "o", "\u001b[?2004h> "]
[324.013713, "o", "    # 2) Parse each JSON line into a dict, attaching a sequence number\r\n\u001b[?2004l\r"]
[324.013774, "o", "\u001b[?2004h> "]
[324.014244, "o", "    #    used later to recover input ordering after the keyed/stateful\r\n\u001b[?2004l\r"]
[324.014307, "o", "\u001b[?2004h> "]
[324.014674, "o", "    #    step (which may interleave keys across workers).\r\n\u001b[?2004l\r"]
[324.014734, "o", "\u001b[?2004h> "]
[324.014889, "o", "    counter = {\"i\": 0}\r\n\u001b[?2004l\r"]
[324.014959, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[324.015017, "o", "\u001b[?2004h> "]
[324.015225, "o", "    def _parse_with_seq(line):\r\n\u001b[?2004l\r"]
[324.015285, "o", "\u001b[?2004h> "]
[324.015494, "o", "        event = json.loads(line)\r\n\u001b[?2004l\r"]
[324.015553, "o", "\u001b[?2004h> "]
[324.015795, "o", "        event[\"__seq\"] = counter[\"i\"]\r\n\u001b[?2004l\r"]
[324.015855, "o", "\u001b[?2004h> "]
[324.016039, "o", "        counter[\"i\"] += 1\r\n\u001b[?2004l\r"]
[324.016102, "o", "\u001b[?2004h> "]
[324.016238, "o", "        return event\r\n\u001b[?2004l\r"]
[324.016297, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[324.016357, "o", "\u001b[?2004h> "]
[324.01662, "o", "    parsed = op.map(\"parse_json\", lines, _parse_with_seq)\r\n\u001b[?2004l\r\u001b[?2004h"]
[324.01668, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[324.01704, "o", "    # 3) Key by user_id so the per-key state is partitioned per user.\r\n\u001b[?2004l\r\u001b[?2004h"]
[324.017096, "o", "> "]
[324.017413, "o", "    keyed = op.key_on(\"key_user\", parsed, lambda event: event[\"user_id\"])\r\n\u001b[?2004l\r\u001b[?2004h"]
[324.017463, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h"]
[324.017513, "o", "> "]
[324.017761, "o", "    # 4) Apply stateful deduplication keyed on user_id.\r\n\u001b[?2004l\r"]
[324.017812, "o", "\u001b[?2004h> "]
[324.018054, "o", "    deduped = op.stateful(\"dedup\", keyed, _build_logic)\r\n\u001b[?2004l\r\u001b[?2004h"]
[324.018112, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[324.044852, "o", "    # 5) Drop the key produced by `stateful` and forward the event dict.\r\n\u001b[?2004l\r\u001b[?2004h>     unkeyed = op.key_rm(\"unkey\", deduped)\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h>     # 6) Write out as JSONL preserving input order.\r\n\u001b[?2004l\r\u001b[?2004h> "]
[324.045035, "o", "    op.output(\"output\", unkeyed, OrderedJsonlSink(output_path))\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[324.045141, "o", "    return flow\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[324.04524, "o", "\u001b[?2004h> "]
[324.045342, "o", "if __name__ == \"__main__\":\r\n\u001b[?2004l\r\u001b[?2004h"]
[324.045437, "o", "> "]
[324.045693, "o", "    run_main(build_flow(Path(\"input.jsonl\"), Path(\"output.jsonl\")))\r\n\u001b[?2004l\r\u001b[?2004h"]
[324.045788, "o", "> PYEOF\r\n\u001b[?2004l\r"]
[324.048153, "o", "\u001b[?2004h"]
[324.048194, "o", "root@4ee094ad-84dd-40c1-99e6-773a4e8e5d51:~# "]
[324.591339, "i", "rm -f output.jsonl && python3 run.py && cat output.jsonl\n"]
[324.591943, "o", "rm -f output.jsonl && python3 run.py && cat output.jsonl\r\n\u001b[?2004l\r"]
[324.703423, "o", "{\"user_id\": \"u1\", \"event_id\": \"e1\", \"timestamp\": \"2023-01-01T12:00:00.500000Z\"}\r\n{\"user_id\": \"u1\", \"event_id\": \"e1\", \"timestamp\": \"2023-01-01T12:00:10.500001Z\"}\r\n{\"user_id\": \"u1\", \"event_id\": \"e2\", \"timestamp\": \"2023-01-01T12:00:15.123456Z\"}\r\n"]
[324.703627, "o", "\u001b[?2004hroot@4ee094ad-84dd-40c1-99e6-773a4e8e5d51:~# "]
[337.29724, "i", "cat > input.jsonl << 'EOF'\n{\"user_id\": \"u1\", \"event_id\": \"e1\", \"timestamp\": \"2023-01-01T12:00:00Z\"}\n{\"user_id\": \"u1\", \"event_id\": \"e1\", \"timestamp\": \"2023-01-01T12:00:05Z\"}\n{\"user_id\": \"u1\", \"event_id\": \"e1\", \"timestamp\": \"2023-01-01T12:00:10Z\"}\n{\"user_id\": \"u1\", \"event_id\": \"e1\", \"timestamp\": \"2023-01-01T12:00:11Z\"}\n{\"user_id\": \"u1\", \"event_id\": \"e2\", \"timestamp\": \"2023-01-01T12:00:11Z\"}\n{\"user_id\": \"u2\", \"event_id\": \"e1\", \"timestamp\": \"2023-01-01T12:00:00Z\"}\n{\"user_id\": \"u1\", \"event_id\": \"e1\", \"timestamp\": \"2023-01-01T12:00:21Z\"}\n{\"user_id\": \"u1\", \"event_id\": \"e3\", \"timestamp\": \"2023-01-01T12:00:25Z\"}\n{\"user_id\": \"u1\", \"event_id\": \"e2\", \"timestamp\": \"2023-01-01T12:00:35Z\"}\n{\"user_id\": \"u1\", \"event_id\": \"e2\", \"timestamp\": \"2023-01-01T12:00:11Z\"}\n{\"user_id\": \"u1\", \"event_id\": \"e3\", \"timestamp\": \"2023-01-01T12:00:36Z\"}\nEOF\n"]
[337.297574, "o", "cat > input.jsonl << 'EOF'\r\n\u001b[?2004l\r"]
[337.297664, "o", "\u001b[?2004h"]
[337.29776, "o", "> "]
[337.29825, "o", "{\"user_id\": \"u1\", \"event_id\": \"e1\", \"timestamp\": \"2023-01-01T12:00:00Z\"}\r\n\u001b[?2004l\r"]
[337.298339, "o", "\u001b[?2004h"]
[337.298412, "o", "> "]
[337.298775, "o", "{\"user_id\": \"u1\", \"event_id\": \"e1\", \"timestamp\": \"2023-01-01T12:00:05Z\"}\r\n\u001b[?2004l\r"]
[337.298898, "o", "\u001b[?2004h"]
[337.299001, "o", "> "]
[337.299365, "o", "{\"user_id\": \"u1\", \"event_id\": \"e1\", \"timestamp\": \"2023-01-01T12:00:10Z\"}\r\n\u001b[?2004l\r"]
[337.29943, "o", "\u001b[?2004h> "]
[337.299895, "o", "{\"user_id\": \"u1\", \"event_id\": \"e1\", \"timestamp\": \"2023-01-01T12:00:11Z\"}\r\n\u001b[?2004l\r"]
[337.299964, "o", "\u001b[?2004h> "]
[337.300473, "o", "{\"user_id\": \"u1\", \"event_id\": \"e2\", \"timestamp\": \"2023-01-01T12:00:11Z\"}\r\n\u001b[?2004l\r"]
[337.300514, "o", "\u001b[?2004h"]
[337.300544, "o", "> "]
[337.301044, "o", "{\"user_id\": \"u2\", \"event_id\": \"e1\", \"timestamp\": \"2023-01-01T12:00:00Z\"}\r\n\u001b[?2004l\r"]
[337.301132, "o", "\u001b[?2004h> "]
[337.301563, "o", "{\"user_id\": \"u1\", \"event_id\": \"e1\", \"timestamp\": \"2023-01-01T12:00:21Z\"}\r\n\u001b[?2004l\r"]
[337.301625, "o", "\u001b[?2004h"]
[337.301694, "o", "> "]
[337.302116, "o", "{\"user_id\": \"u1\", \"event_id\": \"e3\", \"timestamp\": \"2023-01-01T12:00:25Z\"}\r\n\u001b[?2004l\r"]
[337.302148, "o", "\u001b[?2004h"]
[337.302252, "o", "> "]
[337.302642, "o", "{\"user_id\": \"u1\", \"event_id\": \"e2\", \"timestamp\": \"2023-01-01T12:00:35Z\"}\r\n\u001b[?2004l\r"]
[337.302719, "o", "\u001b[?2004h"]
[337.302761, "o", "> "]
[337.303201, "o", "{\"user_id\": \"u1\", \"event_id\": \"e2\", \"timestamp\": \"2023-01-01T12:00:11Z\"}\r\n\u001b[?2004l\r"]
[337.303293, "o", "\u001b[?2004h> "]
[337.303957, "o", "{\"user_id\": \"u1\", \"event_id\": \"e3\", \"timestamp\": \"2023-01-01T12:00:36Z\"}\r\n\u001b[?2004l\r"]
[337.304166, "o", "\u001b[?2004h> EOF\r\n\u001b[?2004l\r"]
[337.305755, "o", "\u001b[?2004hroot@4ee094ad-84dd-40c1-99e6-773a4e8e5d51:~# "]
[337.877457, "i", "rm -f output.jsonl && python3 run.py && cat output.jsonl\n"]
[337.878069, "o", "rm -f output.jsonl && python3 run.py && cat output.jsonl\r\n\u001b[?2004l\r"]
[337.988196, "o", "{\"user_id\": \"u1\", \"event_id\": \"e1\", \"timestamp\": \"2023-01-01T12:00:00Z\"}\r\n{\"user_id\": \"u1\", \"event_id\": \"e1\", \"timestamp\": \"2023-01-01T12:00:11Z\"}\r\n{\"user_id\": \"u1\", \"event_id\": \"e2\", \"timestamp\": \"2023-01-01T12:00:11Z\"}\r\n{\"user_id\": \"u2\", \"event_id\": \"e1\", \"timestamp\": \"2023-01-01T12:00:00Z\"}\r\n{\"user_id\": \"u1\", \"event_id\": \"e3\", \"timestamp\": \"2023-01-01T12:00:25Z\"}\r\n{\"user_id\": \"u1\", \"event_id\": \"e2\", \"timestamp\": \"2023-01-01T12:00:35Z\"}\r\n{\"user_id\": \"u1\", \"event_id\": \"e3\", \"timestamp\": \"2023-01-01T12:00:36Z\"}\r\n"]
