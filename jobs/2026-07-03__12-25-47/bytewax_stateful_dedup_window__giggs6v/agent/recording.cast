[191.012997, "i", "cat > run.py << 'PYEOF'\nimport json\nfrom datetime import datetime, timedelta\nfrom pathlib import Path\nfrom typing import Any, Dict, Iterable, Tuple\n\nfrom bytewax import operators as op\nfrom bytewax.connectors.files import FileSource\nfrom bytewax.dataflow import Dataflow\nfrom bytewax.operators import StatefulLogic\nfrom bytewax.outputs import StatelessSinkPartition, DynamicSink\nfrom bytewax.testing import run_main\nfrom typing_extensions import override\n\nWINDOW = timedelta(seconds=10)\n\n\ndef parse_ts(s) -> datetime:\n    \"\"\"Parse an ISO 8601 timestamp string into a tz-aware datetime.\"\"\"\n    if isinstance(s, datetime):\n        return s\n    if s.endswith(\"Z\"):\n        s = s[:-1] + \"+00:00\"\n    return datetime.fromisoformat(s)\n\n\ndef fmt_ts(ts: datetime) -> str:\n    \"\"\"Render a datetime back to an ISO 8601 string with trailing `Z`.\"\"\"\n    if ts.tzinfo is not None:\n        ts = ts.astimezone(tz=ts.tzinfo).replace(microsecond=0)\n        return ts.isoformat().replace(\"+00:00\", \"Z\")\n    return ts.isoformat()\n\n\nclass DedupLogic(StatefulLogic[Dict[str, Any], Dict[str, Any], Dict[str, datetime]]):\n    \"\"\"Per-user_id event-id deduplication over a sliding 10s window.\"\"\"\n\n    def __init__(self, resume_state):\n        # `state` maps `event_id` -> last emitted timestamp (datetime).\n        self._state: Dict[str, datetime] = dict(resume_state) if resume_state else {}\n\n    def on_item(\n        self, value: Dict[str, Any]\n    ) -> Tuple[Iterable[Dict[str, Any]], bool]:\n        event_id = value[\"event_id\"]\n        ts = parse_ts(value[\"timestamp\"])\n\n        # Clean up state: any event_id older than the window relative to\n        # the current event's timestamp is removed.\n        stale = [\n            eid for eid, last_ts in self._state.items()\n            if ts - last_ts > WINDOW\n        ]\n        for eid in stale:\n            del self._state[eid]\n\n        # Deduplication check: if the same event_id was seen within the\n        # last 10 seconds (inclusive of exactly 10s), drop.\n        prev_ts = self._state.get(event_id)\n        if prev_ts is not None and ts <= prev_ts + WINDOW:\n            return (iter(()), StatefulLogic.RETAIN)\n\n        # Otherwise emit and (re)start the 10-second window for this\n        # event_id.\n        self._state[event_id] = ts\n        return (iter((value,)), StatefulLogic.RETAIN)\n\n    def snapshot(self) -> Dict[str, datetime]:\n        # Must return an effectively immutable copy.\n        return dict(self._state)\n\n\ndef build_logic(resume_state):\n    return DedupLogic(resume_state)\n\n\nclass _JsonlSinkPartition(StatelessSinkPartition[str]):\n    def __init__(self, path: Path):\n        self._path = path\n        self._items: list = []\n\n    @override\n    def write_batch(self, items) -> None:\n        # Buffer everything; we'll sort then write on close.\n        self._items.extend(items)\n\n    @override\n    def close(self) -> None:\n        # Preserve input order using the embedded sequence number, then\n        # drop the sequence number field and dump to JSONL.\n        def _key(item):\n            return item[\"__seq\"]\n\n        self._items.sort(key=_key)\n        with self._path.open(\"wt\") as f:\n            for item in self._items:\n                item.pop(\"__seq\", None)\n                f.write(json.dumps(item))\n                f.write(\"\\n\")\n\n\nclass JsonlSink(DynamicSink[str]):\n    \"\"\"Custom Sink that buffers items, sorts them by a sequence number,\n    and writes them as JSON lines to a single file.\"\"\"\n\n    def __init__(self, path):\n        self._path = path\n\n    @override\n    def build(self, step_id, worker_index, worker_count):\n        return _JsonlSinkPartition(Path(self._path))\n\n\ndef build_flow(input_path, output_path) -> Dataflow:\n    flow = Dataflow(\"stateful_dedup\")\n\n    # 1) Read raw lines.\n    lines = op.input(\"input\", flow, FileSource(str(input_path)))\n\n    # 2) Parse JSON, attach a sequence number to preserve input order.\n    counter = {\"i\": 0}\n\n    def _parse_with_seq(line):\n        event = json.loads(line)\n        event[\"__seq\"] = counter[\"i\"]\n        counter[\"i\"] += 1\n        return event\n\n    parsed = op.map(\"parse_json"]
[191.013197, "i", "\", lines, _parse_with_seq)\n\n    # 3) Key by user_id so state is maintained per user.\n    keyed = op.key_on(\"key_user\", parsed, lambda e: e[\"user_id\"])\n\n    # 4) Apply stateful deduplication.\n    deduped = op.stateful(\"dedup\", keyed, build_logic)\n\n    # 5) Drop key and serialize. The deduped stream is keyed (user_id, event).\n    def _to_json(item):\n        user_id, event = item\n        out = dict(event)\n        ts = out[\"timestamp\"]\n        if isinstance(ts, datetime):\n            out[\"timestamp\"] = fmt_ts(ts)\n        return out\n\n    events = op.map(\"to_dict\", deduped, _to_json)\n\n    # 6) Write out (the custom sink handles sequencing + JSONL serialization).\n    op.output(\"output\", events, JsonlSink(output_path))\n\n    return flow\n\n\nif __name__ == \"__main__\":\n    run_main(build_flow(Path(\"input.jsonl\"), Path(\"output.jsonl\")))\nPYEOF\n"]
[191.013497, "o", "cat > run.py << 'PYEOF'\r\n\u001b[?2004l\r"]
[191.013563, "o", "\u001b[?2004h> import json\r\n\u001b[?2004l\r\u001b[?2004h"]
[191.013742, "o", "> "]
[191.013863, "o", "from datetime import datetime, timedelta\r\n\u001b[?2004l\r\u001b[?2004h"]
[191.013946, "o", "> "]
[191.014113, "o", "from pathlib import Path\r\n\u001b[?2004l\r\u001b[?2004h"]
[191.014216, "o", "> "]
[191.01444, "o", "from typing import Any, Dict, Iterable, Tuple\r\n\u001b[?2004l\r"]
[191.014497, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[191.014607, "o", "> "]
[191.014775, "o", "from bytewax import operators as op\r\n\u001b[?2004l\r\u001b[?2004h"]
[191.014831, "o", "> "]
[191.015152, "o", "from bytewax.connectors.files import FileSource\r\n\u001b[?2004l\r\u001b[?2004h"]
[191.015205, "o", "> "]
[191.01546, "o", "from bytewax.dataflow import Dataflow\r\n\u001b[?2004l\r\u001b[?2004h"]
[191.015514, "o", "> "]
[191.015803, "o", "from bytewax.operators import StatefulLogic\r\n\u001b[?2004l\r\u001b[?2004h"]
[191.01586, "o", "> "]
[191.016253, "o", "from bytewax.outputs import StatelessSinkPartition, DynamicSink\r\n\u001b[?2004l\r\u001b[?2004h"]
[191.01631, "o", "> "]
[191.01654, "o", "from bytewax.testing import run_main\r\n\u001b[?2004l\r"]
[191.016592, "o", "\u001b[?2004h> "]
[191.016823, "o", "from typing_extensions import override\r\n\u001b[?2004l\r\u001b[?2004h"]
[191.016922, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[191.017114, "o", "WINDOW = timedelta(seconds=10)\r\n\u001b[?2004l\r\u001b[?2004h"]
[191.017207, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[191.017303, "o", "\u001b[?2004h> "]
[191.017426, "o", "def parse_ts(s) -> datetime:\r\n\u001b[?2004l\r"]
[191.017479, "o", "\u001b[?2004h> "]
[191.017878, "o", "    \"\"\"Parse an ISO 8601 timestamp string into a tz-aware datetime.\"\"\"\r\n\u001b[?2004l\r\u001b[?2004h"]
[191.017945, "o", "> "]
[191.018177, "o", "    if isinstance(s, datetime):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[191.018291, "o", "        return s\r\n\u001b[?2004l\r\u001b[?2004h"]
[191.018388, "o", "> "]
[191.01848, "o", "    if s.endswith(\"Z\"):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[191.018675, "o", "        s = s[:-1] + \"+00:00\"\r\n\u001b[?2004l\r\u001b[?2004h"]
[191.018768, "o", "> "]
[191.018953, "o", "    return datetime.fromisoformat(s)\r\n\u001b[?2004l\r"]
[191.019013, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[191.019074, "o", "\u001b[?2004h> "]
[191.019279, "o", "def fmt_ts(ts: datetime) -> str:\r\n\u001b[?2004l\r\u001b[?2004h"]
[191.019341, "o", "> "]
[191.019747, "o", "    \"\"\"Render a datetime back to an ISO 8601 string with trailing `Z`.\"\"\"\r\n\u001b[?2004l\r\u001b[?2004h"]
[191.019826, "o", "> "]
[191.019962, "o", "    if ts.tzinfo is not None:\r\n\u001b[?2004l\r"]
[191.020042, "o", "\u001b[?2004h> "]
[191.020333, "o", "        ts = ts.astimezone(tz=ts.tzinfo).replace(microsecond=0)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[191.020601, "o", "        return ts.isoformat().replace(\"+00:00\", \"Z\")\r\n\u001b[?2004l\r\u001b[?2004h"]
[191.020683, "o", "> "]
[191.020754, "o", "    return ts.isoformat()\r\n\u001b[?2004l\r"]
[191.020832, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[191.020928, "o", "\u001b[?2004h> "]
[191.021296, "o", "class DedupLogic(StatefulLogic[Dict[str, Any], Dict[str, Any], Dict[str, datetime]]):\r\n\u001b[?2004l\r\u001b[?2004h"]
[191.021345, "o", "> "]
[191.021695, "o", "    \"\"\"Per-user_id event-id deduplication over a sliding 10s window.\"\"\"\r\n\u001b[?2004l\r\u001b[?2004h"]
[191.021773, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[191.02199, "o", "    def __init__(self, resume_state):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[191.022341, "o", "        # `state` maps `event_id` -> last emitted timestamp (datetime).\r\n\u001b[?2004l\r\u001b[?2004h"]
[191.022394, "o", "> "]
[191.02279, "o", "        self._state: Dict[str, datetime] = dict(resume_state) if resume_state else {}\r\n\u001b[?2004l\r"]
[191.022873, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[191.022973, "o", "    def on_item(\r\n\u001b[?2004l\r\u001b[?2004h"]
[191.023028, "o", "> "]
[191.023164, "o", "        self, value: Dict[str, Any]\r\n\u001b[?2004l\r\u001b[?2004h"]
[191.023216, "o", "> "]
[191.023471, "o", "    ) -> Tuple[Iterable[Dict[str, Any]], bool]:\r\n\u001b[?2004l\r\u001b[?2004h"]
[191.023556, "o", "> "]
[191.023682, "o", "        event_id = value[\"event_id\"]\r\n\u001b[?2004l\r"]
[191.023731, "o", "\u001b[?2004h> "]
[191.023966, "o", "        ts = parse_ts(value[\"timestamp\"])\r\n\u001b[?2004l\r\u001b[?2004h"]
[191.024044, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[191.024371, "o", "        # Clean up state: any event_id older than the window relative to\r\n\u001b[?2004l\r\u001b[?2004h"]
[191.024419, "o", "> "]
[191.024677, "o", "        # the current event's timestamp is removed.\r\n\u001b[?2004l\r\u001b[?2004h"]
[191.024754, "o", "> "]
[191.024835, "o", "        stale = [\r\n\u001b[?2004l\r\u001b[?2004h> "]
[191.025115, "o", "            eid for eid, last_ts in self._state.items()\r\n\u001b[?2004l\r"]
[191.025164, "o", "\u001b[?2004h> "]
[191.025362, "o", "            if ts - last_ts > WINDOW\r\n\u001b[?2004l\r\u001b[?2004h"]
[191.025447, "o", ">         ]\r\n\u001b[?2004l\r"]
[191.025533, "o", "\u001b[?2004h> "]
[191.025606, "o", "        for eid in stale:\r\n\u001b[?2004l\r"]
[191.025642, "o", "\u001b[?2004h> "]
[191.025817, "o", "            del self._state[eid]\r\n\u001b[?2004l\r"]
[191.025854, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[191.025894, "o", "\u001b[?2004h> "]
[191.026282, "o", "        # Deduplication check: if the same event_id was seen within the\r\n\u001b[?2004l\r"]
[191.026324, "o", "\u001b[?2004h> "]
[191.026636, "o", "        # last 10 seconds (inclusive of exactly 10s), drop.\r\n\u001b[?2004l\r"]
[191.026677, "o", "\u001b[?2004h> "]
[191.026901, "o", "        prev_ts = self._state.get(event_id)\r\n\u001b[?2004l\r"]
[191.026966, "o", "\u001b[?2004h> "]
[191.027266, "o", "        if prev_ts is not None and ts <= prev_ts + WINDOW:\r\n\u001b[?2004l\r\u001b[?2004h"]
[191.027307, "o", "> "]
[191.027555, "o", "            return (iter(()), StatefulLogic.RETAIN)\r\n\u001b[?2004l\r"]
[191.027597, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[191.027638, "o", "\u001b[?2004h> "]
[191.027995, "o", "        # Otherwise emit and (re)start the 10-second window for this\r\n\u001b[?2004l\r"]
[191.028034, "o", "\u001b[?2004h> "]
[191.028152, "o", "        # event_id.\r\n\u001b[?2004l\r"]
[191.028191, "o", "\u001b[?2004h> "]
[191.02837, "o", "        self._state[event_id] = ts\r\n\u001b[?2004l\r"]
[191.02841, "o", "\u001b[?2004h> "]
[191.028676, "o", "        return (iter((value,)), StatefulLogic.RETAIN)\r\n\u001b[?2004l\r"]
[191.028715, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[191.028789, "o", "\u001b[?2004h> "]
[191.029003, "o", "    def snapshot(self) -> Dict[str, datetime]:\r\n\u001b[?2004l\r"]
[191.029045, "o", "\u001b[?2004h> "]
[191.029306, "o", "        # Must return an effectively immutable copy.\r\n\u001b[?2004l\r"]
[191.029348, "o", "\u001b[?2004h> "]
[191.029512, "o", "        return dict(self._state)\r\n\u001b[?2004l\r"]
[191.02955, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[191.029592, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[191.029693, "o", "\u001b[?2004h> "]
[191.029821, "o", "def build_logic(resume_state):\r\n\u001b[?2004l\r"]
[191.029858, "o", "\u001b[?2004h> "]
[191.030068, "o", "    return DedupLogic(resume_state)\r\n\u001b[?2004l\r"]
[191.030166, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[191.030206, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[191.030288, "o", "> "]
[191.030513, "o", "class _JsonlSinkPartition(StatelessSinkPartition[str]):\r\n\u001b[?2004l\r"]
[191.030552, "o", "\u001b[?2004h> "]
[191.030722, "o", "    def __init__(self, path: Path):\r\n\u001b[?2004l\r"]
[191.030776, "o", "\u001b[?2004h> "]
[191.030881, "o", "        self._path = path\r\n\u001b[?2004l\r"]
[191.030949, "o", "\u001b[?2004h> "]
[191.031077, "o", "        self._items: list = []\r\n\u001b[?2004l\r"]
[191.031115, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[191.031194, "o", "\u001b[?2004h> "]
[191.031259, "o", "    @override\r\n\u001b[?2004l\r"]
[191.031298, "o", "\u001b[?2004h> "]
[191.031513, "o", "    def write_batch(self, items) -> None:\r\n\u001b[?2004l\r"]
[191.031553, "o", "\u001b[?2004h> "]
[191.031753, "o", "        # Buffer everything; we'll sort then write on close.\r\n\u001b[?2004l\r\u001b[?2004h> "]
[191.031867, "o", "        self._items.extend(items)\r\n\u001b[?2004l\r\u001b[?2004h"]
[191.031935, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[191.032005, "o", "    @override\r\n\u001b[?2004l\r\u001b[?2004h> "]
[191.032081, "o", "    def close(self) -> None:\r\n\u001b[?2004l\r\u001b[?2004h"]
[191.032133, "o", "> "]
[191.032296, "o", "        # Preserve input order using the embedded sequence number, then\r\n\u001b[?2004l\r\u001b[?2004h"]
[191.032347, "o", "> "]
[191.032482, "o", "        # drop the sequence number field and dump to JSONL.\r\n\u001b[?2004l\r"]
[191.032538, "o", "\u001b[?2004h> "]
[191.032591, "o", "        def _key(item):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[191.032695, "o", "            return item[\"__seq\"]\r\n\u001b[?2004l\r\u001b[?2004h"]
[191.032749, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[191.032849, "o", "        self._items.sort(key=_key)\r\n\u001b[?2004l\r\u001b[?2004h"]
[191.032902, "o", "> "]
[191.032992, "o", "        with self._path.open(\"wt\") as f:\r\n\u001b[?2004l\r\u001b[?2004h"]
[191.033045, "o", "> "]
[191.03312, "o", "            for item in self._items:\r\n\u001b[?2004l\r\u001b[?2004h"]
[191.033172, "o", "> "]
[191.033254, "o", "                item.pop(\"__seq\", None)\r\n\u001b[?2004l\r\u001b[?2004h"]
[191.033305, "o", "> "]
[191.033396, "o", "                f.write(json.dumps(item))\r\n\u001b[?2004l\r\u001b[?2004h"]
[191.033448, "o", "> "]
[191.033503, "o", "                f.write(\"\\n\")\r\n\u001b[?2004l\r\u001b[?2004h"]
[191.033553, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[191.033587, "o", "> "]
[191.033689, "o", "class JsonlSink(DynamicSink[str]):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[191.033897, "o", "    \"\"\"Custom Sink that buffers items, sorts them by a sequence number,\r\n\u001b[?2004l\r\u001b[?2004h"]
[191.033956, "o", "> "]
[191.034076, "o", "    and writes them as JSON lines to a single file.\"\"\"\r\n\u001b[?2004l\r"]
[191.034127, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[191.034214, "o", "    def __init__(self, path):\r\n\u001b[?2004l\r\u001b[?2004h"]
[191.034265, "o", "> "]
[191.034311, "o", "        self._path = path\r\n\u001b[?2004l\r"]
[191.03436, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[191.034405, "o", "    @override\r\n\u001b[?2004l\r\u001b[?2004h"]
[191.034455, "o", "> "]
[191.034587, "o", "    def build(self, step_id, worker_index, worker_count):\r\n\u001b[?2004l\r\u001b[?2004h"]
[191.034621, "o", "> "]
[191.034759, "o", "        return _JsonlSinkPartition(Path(self._path))\r\n\u001b[?2004l\r\u001b[?2004h"]
[191.034809, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[191.034858, "o", "> "]
[191.035011, "o", "def build_flow(input_path, output_path) -> Dataflow:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[191.035115, "o", "    flow = Dataflow(\"stateful_dedup\")\r\n\u001b[?2004l\r\u001b[?2004h"]
[191.035168, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[191.035238, "o", "    # 1) Read raw lines.\r\n\u001b[?2004l\r\u001b[?2004h"]
[191.035272, "o", "> "]
[191.035439, "o", "    lines = op.input(\"input\", flow, FileSource(str(input_path)))\r\n\u001b[?2004l\r\u001b[?2004h"]
[191.035488, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[191.03568, "o", "    # 2) Parse JSON, attach a sequence number to preserve input order.\r\n\u001b[?2004l\r\u001b[?2004h> "]
[191.03577, "o", "    counter = {\"i\": 0}\r\n\u001b[?2004l\r\u001b[?2004h"]
[191.035818, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[191.035902, "o", "    def _parse_with_seq(line):\r\n\u001b[?2004l\r\u001b[?2004h"]
[191.035947, "o", "> "]
[191.036033, "o", "        event = json.loads(line)\r\n\u001b[?2004l\r\u001b[?2004h"]
[191.036067, "o", "> "]
[191.036168, "o", "        event[\"__seq\"] = counter[\"i\"]\r\n\u001b[?2004l\r\u001b[?2004h"]
[191.036217, "o", "> "]
[191.036296, "o", "        counter[\"i\"] += 1\r\n\u001b[?2004l\r"]
[191.036365, "o", "\u001b[?2004h>         return event\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[191.036439, "o", "\u001b[?2004h> "]
[191.036559, "o", "    parsed = op.map(\"parse_json\", lines, _parse_with_seq)\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[191.036625, "o", "\u001b[?2004h> "]
[191.036744, "o", "    # 3) Key by user_id so state is maintained per user.\r\n\u001b[?2004l\r\u001b[?2004h> "]
[191.036959, "o", "    keyed = op.key_on(\"key_user\", parsed, lambda e: e[\"user_id\"])\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[191.037025, "o", "\u001b[?2004h> "]
[191.037102, "o", "    # 4) Apply stateful deduplication.\r\n\u001b[?2004l\r\u001b[?2004h> "]
[191.037262, "o", "    deduped = op.stateful(\"dedup\", keyed, build_logic)\r\n\u001b[?2004l\r\u001b[?2004h"]
[191.037328, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[191.037523, "o", "    # 5) Drop key and serialize. The deduped stream is keyed (user_id, event).\r\n\u001b[?2004l\r\u001b[?2004h> "]
[191.037609, "o", "    def _to_json(item):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[191.037703, "o", "        user_id, event = item\r\n\u001b[?2004l\r\u001b[?2004h"]
[191.037766, "o", "> "]
[191.037828, "o", "        out = dict(event)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[191.037904, "o", "        ts = out[\"timestamp\"]\r\n\u001b[?2004l\r\u001b[?2004h> "]
[191.038032, "o", "        if isinstance(ts, datetime):\r\n\u001b[?2004l\r\u001b[?2004h"]
[191.038067, "o", "> "]
[191.038167, "o", "            out[\"timestamp\"] = fmt_ts(ts)\r\n\u001b[?2004l\r"]
[191.038195, "o", "\u001b[?2004h> "]
[191.038248, "o", "        return out\r\n\u001b[?2004l\r"]
[191.038275, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[191.038301, "o", "\u001b[?2004h> "]
[191.038453, "o", "    events = op.map(\"to_dict\", deduped, _to_json)\r\n\u001b[?2004l\r\u001b[?2004h"]
[191.03848, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h"]
[191.038508, "o", "> "]
[191.038723, "o", "    # 6) Write out (the custom sink handles sequencing + JSONL serialization).\r\n\u001b[?2004l\r\u001b[?2004h"]
[191.038749, "o", "> "]
[191.038903, "o", "    op.output(\"output\", events, JsonlSink(output_path))\r\n\u001b[?2004l\r\u001b[?2004h"]
[191.038949, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[191.03901, "o", "    return flow\r\n\u001b[?2004l\r\u001b[?2004h"]
[191.039054, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h"]
[191.039094, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
