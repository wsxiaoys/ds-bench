[36.05516, "o", "/usr/local/lib/python3.12/dist-packages/bytewax/operators/__init__.py:796:def stateful_batch(\r\n/usr/local/lib/python3.12/dist-packages/bytewax/operators/__init__.py:918:class StatefulLogic(ABC, Generic[V, W, S]):\r\n/usr/local/lib/python3.12/dist-packages/bytewax/operators/__init__.py:944:    def on_item(self, value: V) -> Tuple[Iterable[W], bool]:\r\n/usr/local/lib/python3.12/dist-packages/bytewax/operators/__init__.py:1066:def stateful(\r\n/usr/local/lib/python3.12/dist-packages/bytewax/operators/__init__.py:1121:    def on_item(self, value: V) -> Tuple[Iterable[List[V]], bool]:\r\n/usr/local/lib/python3.12/dist-packages/bytewax/operators/__init__.py:1930:    def on_item(self, value: V) -> Tuple[Iterable[S], bool]:\r\n/usr/local/lib/python3.12/dist-packages/bytewax/operators/__init__.py:2165:    def on_item(self, value: Tuple[int, Any]) -> Tuple[Iterable[Tuple], bool]:\r\n/usr/local/lib/python3.12/dist-packages/bytewax/operators/__init__.py:2867:    def on_item(self, value: V) -> Tuple[Iterable[W], bool]:\r\n/usr/local/lib/python3.12/dist-packages/bytewax/operators/__init__.py:2894:def stateful_flat_map(\r\n/usr/local/lib/python3.12/dist-packages/bytewax/operators/__init__.py:2921:def stateful_map(\r\n/usr/local/lib/python3.12/dist-packages/bytewax/operators/windowing.py:106:    def on_item(self, value: V) -> Tuple[datetime, datetime]:\r\n/usr/local/lib/python3.12/dist-packages/bytewax/operators/windowing.py:203:    def on_item(self, value: Any) -> Tuple[datetime, datetime]:\r\n/usr/local/lib/python3.12/dist-packages/bytewax/operators/windowing.py:264:    def on_item(self, value: V) -> Tuple[datetime, datetime]:\r\n"]
