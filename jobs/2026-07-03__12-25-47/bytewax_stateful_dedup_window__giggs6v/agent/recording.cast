[404.014355, "o", "drwx------ 1 root root  114 Jul  3 12:55 \u001b[0m\u001b[01;34m.\u001b[0m\r\ndrwxr-xr-x 1 root root  123 Jul  3 12:55 \u001b[01;34m..\u001b[0m\r\n-rw-r--r-- 1 root root 3106 Apr 22  2024 .bashrc\r\ndrwxr-xr-x 3 root root   25 Jul  3 12:48 \u001b[01;34m.cache\u001b[0m\r\ndrwxr-xr-x 3 root root   31 Jul  3 12:48 \u001b[01;34m.config\u001b[0m\r\ndrwxr-xr-x 3 root root   30 Jul  3 12:48 \u001b[01;34m.daytona\u001b[0m\r\ndrwxr-xr-x 3 root root   25 Jul  3 12:48 \u001b[01;34m.pochi\u001b[0m\r\n-rw-r--r-- 1 root root  161 Apr 22  2024 .profile\r\n-rw-r--r-- 1 root root  584 Jul  3 12:55 input.jsonl\r\n-rw-r--r-- 1 root root  365 Jul  3 12:55 output.jsonl\r\n-rw-r--r-- 1 root root 5416 Jul  3 12:54 run.py\r\n"]
[404.014697, "o", "\u001b[?2004h"]
[404.01479, "o", "root@4ee094ad-84dd-40c1-99e6-773a4e8e5d51:~# "]
[404.454342, "i", "cat run.py\n"]
[404.454492, "o", "cat run.py\r\n\u001b[?2004l\r"]
[404.455396, "o", "\"\"\"Bytewax stateful deduplication over a sliding 10-second window.\r\n\r\nReads events from `input.jsonl`, groups by `user_id`, deduplicates per\r\n`(user_id, event_id)` pair using a 10-second time window (inclusive at\r\nexactly 10s), and writes the surviving events to `output.jsonl` in the\r\noriginal relative order.\r\n\"\"\"\r\n\r\nimport json\r\nfrom datetime import datetime, timedelta\r\nfrom pathlib import Path\r\nfrom typing import Any, Dict, Iterable, Tuple\r\n\r\nfrom bytewax import operators as op\r\nfrom bytewax.connectors.files import FileSource\r\nfrom bytewax.dataflow import Dataflow\r\nfrom bytewax.operators import StatefulLogic\r\nfrom bytewax.outputs import DynamicSink, StatelessSinkPartition\r\nfrom bytewax.testing import run_main\r\nfrom typing_extensions import override\r\n\r\nWINDOW = timedelta(seconds=10)\r\n\r\n\r\ndef _parse_ts(s: Any) -> datetime:\r\n    \"\"\"Parse an ISO 8601 timestamp string into a tz-aware `datetime`.\"\"\"\r\n    if isinstance(s, datetime):\r\n        return s\r\n    if s.endswith(\"Z\"):\r\n        s = s[:-1] + \"+00:00\"\r\n    return datetime.fromisoformat(s)\r\n\r\n\r\nclass DedupLogic(\r\n    StatefulLogic[Dict[str, Any], Dict[str, Any], Dict[str, datetime]]\r\n):\r\n    \"\"\"Per-user_id event-id deduplication with a sliding 10s window.\r\n\r\n    State is a mapping `event_id -> last_emitted_datetime` for the\r\n    current `user_id`. On every event:\r\n\r\n      1. Any `event_id` whose stored timestamp is older than 10 seconds\r\n         from the current event's timestamp is dropped from the state\r\n         so memory cannot grow without bound.\r\n      2. If the same `event_id` was emitted within the last 10 seconds\r\n         (inclusive of exactly 10s, i.e. `ts <= last + 10s`), the new\r\n         event is dropped.\r\n      3. Otherwise the event is emitted and the 10-second window is\r\n         restarted for that `event_id`.\r\n    \"\"\"\r\n\r\n    def __init__(self, resume_state):\r\n        # Map of event_id -> last emitted timestamp (datetime).\r\n        self._state: Dict[str, datetime] = (\r\n            dict(resume_state) if resume_state else {}\r\n        )\r\n\r\n    def on_item(\r\n        self, value: Dict[str, Any]\r\n    ) -> Tuple[Iterable[Dict[str, Any]], bool]:\r\n        event_id = value[\"event_id\"]\r\n        ts = _parse_ts(value[\"timestamp\"])\r\n\r\n        # 1) Drop entries outside the sliding window (strictly older than\r\n        #    10s from the current event's timestamp).\r\n        stale = [\r\n            eid for eid, last_ts in self._state.items()\r\n            if ts - last_ts > WINDOW\r\n        ]\r\n        for eid in stale:\r\n            del self._state[eid]\r\n\r\n        # 2) Deduplication check against the freshly-cleared state.\r\n        prev_ts = self._state.get(event_id)\r\n        if prev_ts is not None and ts <= prev_ts + WINDOW:\r\n            # Duplicate within the window (or exactly at the boundary).\r\n            return (iter(()), StatefulLogic.RETAIN)\r\n\r\n        # 3) Emit and (re)start the 10-second window for this event_id.\r\n        self._state[event_id] = ts\r\n        return (iter((value,)), StatefulLogic.RETAIN)\r\n\r\n    def snapshot(self) -> Dict[str, datetime]:\r\n        # Must return an effectively immutable copy.\r\n        return dict(self._state)\r\n\r\n\r\ndef _build_logic(resume_state):\r\n    return DedupLogic(resume_state)\r\n\r\n\r\nclass _OrderedJsonlSinkPartition(StatelessSinkPartition[Any]):\r\n    \"\"\"Buffers items, then writes them sorted by an embedded sequence\r\n    number so the resulting JSONL file preserves input ordering.\r\n    \"\"\"\r\n\r\n    def __init__(self, path: Path) -> None:\r\n        self._path = path\r\n        self._items: list = []\r\n\r\n    @override\r\n    def write_batch(self, items) -> None:\r\n        self._items.extend(items)\r\n\r\n    @override\r\n    def close(self) -> None:\r\n        self._items.sort(key=lambda it: it[\"__seq\"])\r\n        with self._path.open(\"wt\") as f:\r\n            for item in self._items:\r\n                item.pop(\"__seq\", None)\r\n                f.write(json.dumps(item))\r\n                f.write(\"\\n\")\r\n\r\n\r\nclass OrderedJsonlSink(DynamicSink[Any]):\r\n    \"\"\"Custom sink that writes a JSONL file while preserving the order\r\n    of items received from upstream.\"\"\"\r\n\r\n    def __init__(self, path) -> None:\r\n        self._path = path\r\n\r\n    @override\r\n    def build(self, step_id, worker_index, worker_count):\r\n        return _OrderedJsonlSinkPartition(Path(self._path))\r\n\r\n\r\ndef build_flow(input_path, output_path) -> Dataflow:\r\n    flow = Dataflow(\"stateful_dedup\")\r\n\r\n    # 1) Read raw lines from the input file.\r\n"]
[404.455467, "o", "    lines = op.input(\"input\", flow, FileSource(str(input_path)))\r\n\r\n    # 2) Parse each JSON line into a dict, attaching a sequence number\r\n    #    used later to recover input ordering after the keyed/stateful\r\n    #    step (which may interleave keys across workers).\r\n    counter = {\"i\": 0}\r\n\r\n    def _parse_with_seq(line):\r\n        event = json.loads(line)\r\n        event[\"__seq\"] = counter[\"i\"]\r\n        counter[\"i\"] += 1\r\n        return event\r\n\r\n    parsed = op.map(\"parse_json\", lines, _parse_with_seq)\r\n\r\n    # 3) Key by user_id so the per-key state is partitioned per user.\r\n    keyed = op.key_on(\"key_user\", parsed, lambda event: event[\"user_id\"])\r\n\r\n    # 4) Apply stateful deduplication keyed on user_id.\r\n    deduped = op.stateful(\"dedup\", keyed, _build_logic)\r\n\r\n    # 5) Drop the key produced by `stateful` and forward the event dict.\r\n    unkeyed = op.key_rm(\"unkey\", deduped)\r\n\r\n    # 6) Write out as JSONL preserving input order.\r\n    op.output(\"output\", unkeyed, OrderedJsonlSink(output_path))\r\n\r\n    return flow\r\n\r\n\r\nif __name__ == \"__main__\":\r\n    run_main(build_flow(Path(\"input.jsonl\"), Path(\"output.jsonl\")))\r\n"]
[404.45559, "o", "\u001b[?2004hroot@4ee094ad-84dd-40c1-99e6-773a4e8e5d51:~# "]
