[166.522738, "i", "cat > debug.py << 'PYEOF'\nimport json\nfrom datetime import datetime, timedelta\nfrom pathlib import Path\n\nfrom bytewax import operators as op\nfrom bytewax.connectors.files import FileSource\nfrom bytewax.dataflow import Dataflow\nfrom bytewax.testing import run_main\n\nif __name__ == \"__main__\":\n    flow = Dataflow(\"debug\")\n    lines = op.input(\"input\", flow, FileSource(\"input.jsonl\"))\n    parsed = op.map(\"parse_json\", lines, lambda l: json.loads(l))\n    keyed = op.key_on(\"key_user\", parsed, lambda e: e[\"user_id\"])\n    op.inspect_debug(\"keyed\", keyed)\n    run_main(flow)\nPYEOF\npython3 debug.py\n"]
