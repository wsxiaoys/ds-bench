[146.838138, "o", "\r\n    merged = _join_label_merge(\"add_names\", *sides)\r\n    return stateful(\"join\", merged, shim_builder)\r\n\r\n\r\n@operator\r\n"]
[146.838215, "o", "def key_on(step_id: str, up: Stream[X], key: Callable[[X], str]) -> KeyedStream[X]:\r\n    \"\"\"Add a key for each item.\r\n\r\n    This allows you to use all the keyed operators that require the\r\n    upstream to be a {py:obj}`KeyedStream`.\r\n\r\n    ```{testcode}\r\n    from bytewax.dataflow import Dataflow\r\n"]
[146.838306, "o", "    import bytewax.operators as op\r\n    from bytewax.testing import TestingSource\r\n    from datetime import timedelta\r\n\r\n    flow = Dataflow(\"collect_eg\")\r\n    source = [\r\n        {\"key\": \"a\", \"val\": 1},\r\n        {\"key\": \"b\", \"val\": 2}\r\n    ]\r\n    nums = op.input(\"nums\", flow, TestingSource(source))\r\n\r\n    keyed = op.key_on(\"key\", nums, lambda x: x['key'])\r\n\r\n    op.inspect(\"out\", keyed)\r\n    ```\r\n\r\n    ```{testcode}\r\n    :hide:\r\n    from bytewax.testing import run_main\r\n    run_main(flow)\r\n    ```\r\n\r\n    ```{testoutput}\r\n    collect_eg.out: ('a', {'key': 'a', 'val': 1})\r\n    collect_eg.out: ('b', {'key': 'b', 'val': 2})\r\n    ```\r\n\r\n    :arg step_id: Unique ID.\r\n\r\n    :arg up: Stream.\r\n"]
[146.838341, "o", "\r\n    :arg key: Called on each item and should return the key for that\r\n        item.\r\n\r\n    :returns: A stream of 2-tuples of `(key, item)` AKA a keyed\r\n        stream. The keys come from the return value of the `key`\r\n        function; upstream items will REDACTEDmatically be attached as\r\n        values.\r\n\r\n"]
[146.838436, "o", "    \"\"\"\r\n\r\n    def shim_mapper(x: X) -> Tuple[str, X]:\r\n        k = key(x)\r\n        if not isinstance(k, str):\r\n            msg = (\r\n                f\"return value of `key` {f_repr(key)} \"\r\n                f\"in step {step_id!r} must be a `str`; \"\r\n                f\"got a {type(k)!r} instead\"\r\n            )\r\n            raise TypeError(msg)\r\n        return (k, x)\r\n\r\n    return map(\"map\", up, shim_mapper)\r\n\r\n\r\n@operator\r\ndef key_rm(step_id: str, up: KeyedStream[X]) -> Stream[X]:\r\n"]
[146.838722, "o", "\u001b[?2004h"]
[146.838781, "o", "root@4ee094ad-84dd-40c1-99e6-773a4e8e5d51:~# "]
[156.822326, "i", "cat run.py\n"]
[156.822745, "o", "cat run.py\r\n\u001b[?2004l\r"]
[156.823843, "o", "import json\r\nfrom datetime import datetime, timedelta\r\nfrom pathlib import Path\r\nfrom typing import Any, Dict, Iterable, Tuple\r\n\r\nfrom bytewax import operators as op\r\nfrom bytewax.connectors.files import FileSink, FileSource\r\nfrom bytewax.dataflow import Dataflow\r\nfrom bytewax.operators import StatefulLogic\r\nfrom bytewax.testing import run_main\r\n\r\nWINDOW = timedelta(seconds=10)\r\n\r\n\r\ndef parse_ts(s) -> datetime:\r\n    # Accept either an ISO 8601 string or a datetime object.\r\n    if isinstance(s, datetime):\r\n        return s\r\n    if s.endswith(\"Z\"):\r\n        s = s[:-1] + \"+00:00\"\r\n    return datetime.fromisoformat(s)\r\n\r\n\r\nclass DedupLogic(StatefulLogic[Dict[str, Any], Dict[str, Any], Dict[str, datetime]]):\r\n    \"\"\"Per-user_id event-id deduplication over a sliding 10s window.\"\"\"\r\n\r\n    RETAIN: bool = StatefulLogic.RETAIN\r\n\r\n    def __init__(self, resume_state):\r\n        # state maps event_id -> last emitted timestamp (datetime)\r\n        self._state: Dict[str, datetime] = dict(resume_state) if resume_state else {}\r\n\r\n    def on_item(\r\n        self, value: Dict[str, Any]\r\n    ) -> Tuple[Iterable[Dict[str, Any]], bool]:\r\n        event_id = value[\"event_id\"]\r\n        ts = parse_ts(value[\"timestamp\"])\r\n\r\n        # Clean up: drop entries older than the window relative to the\r\n        # current event's timestamp.\r\n        stale = [\r\n            eid for eid, last_ts in self._state.items()\r\n            if ts - last_ts > WINDOW\r\n        ]\r\n        for eid in stale:\r\n            del self._state[eid]\r\n\r\n        # Deduplication: if the same event_id was seen within last 10s\r\n        # (inclusive of exactly 10s), drop the new event.\r\n        prev_ts = self._state.get(event_id)\r\n        if prev_ts is not None and ts <= prev_ts + WINDOW:\r\n            return (iter(()), StatefulLogic.RETAIN)\r\n\r\n        # Otherwise emit, and (re)start the 10s window for this event_id.\r\n        self._state[event_id] = ts\r\n        return (iter((value,)), StatefulLogic.RETAIN)\r\n\r\n    def snapshot(self) -> Dict[str, datetime]:\r\n        # State must be effectively immutable on return.\r\n        return dict(self._state)\r\n\r\n\r\ndef build_logic(resume_state):\r\n    return DedupLogic(resume_state)\r\n\r\n\r\ndef build_flow(input_path: Path, output_path: Path) -> Dataflow:\r\n    flow = Dataflow(\"stateful_dedup\")\r\n\r\n    # Read raw lines from the input file.\r\n    lines = op.input(\"input\", flow, FileSource(str(input_path)))\r\n\r\n    # Parse JSON -> dict. Timestamps stay as strings until on_item parses\r\n    # them.\r\n    parsed = op.map(\"parse_json\", lines, lambda line: json.loads(line))\r\n\r\n    # Key the stream by user_id so state is maintained per user.\r\n    keyed = op.key_on(\"key_user\", parsed, lambda event: event[\"user_id\"])\r\n\r\n    # Apply stateful dedup. Produces a keyed stream (user_id, event).\r\n    deduped = op.stateful(\"dedup\", keyed, build_logic)\r\n\r\n    # Restore timestamps to ISO 8601 strings and serialize to JSON.\r\n    def _format(item):\r\n        user_id, event = item\r\n        out = dict(event)\r\n        ts = out[\"timestamp\"]\r\n        if isinstance(ts, datetime):\r\n            if ts.tzinfo is not None:\r\n                ts = ts.astimezone(tz=ts.tzinfo).replace(microsecond=0)\r\n                out[\"timestamp\"] = ts.isoformat().replace(\"+00:00\", \"Z\")\r\n            else:\r\n                out[\"timestamp\"] = ts.isoformat()\r\n        # Keep (key, value) shape because FileSink is a fixed-partitioned\r\n        # sink and routes by key.\r\n        return (user_id, json.dumps(out))\r\n\r\n    out_lines = op.map(\"to_json\", deduped, _format)\r\n\r\n    # Write lines out.\r\n    op.output(\"output\", out_lines, FileSink(str(output_path)))\r\n\r\n    return flow\r\n\r\n\r\nif __name__ == \"__main__\":\r\n    run_main(build_flow(Path(\"input.jsonl\"), Path(\"output.jsonl\")))\r\n"]
