[432.809196, "i", "cat > test_alphanum.mjs << 'EOF'\nimport { type } from 'arktype';\n\ntry {\n  const t1 = type(\"string.alphanumeric\", \"@\", { maxLength: 50, minLength: 1 });\n  console.log('configured:', t1.expression);\n  console.log('test abc:', t1(\"abc\"));\n  try { t1(\"abc-123\"); } catch(e) { console.log('abc-123 error:', e.message); }\n  try { t1(\"\"); } catch(e) { console.log('empty error:', e.message); }\n  try { t1(\"x\".repeat(51)); } catch(e) { console.log('long error:', e.message); }\n} catch(e) { console.log('failed:', e.message); }\n\n// Or combine\ntry {\n  const t2 = type(\"1 <= string.alphanumeric <= 50\");\n  console.log('combined:', t2.expression);\n  try { t2(\"abc-123\"); } catch(e) { console.log('abc-123 error:', e.message); }\n} catch(e) { console.log('failed2:', e.message); }\n\nEOF\nnpx --no-install tsx test_alphanum.mjs\n"]
