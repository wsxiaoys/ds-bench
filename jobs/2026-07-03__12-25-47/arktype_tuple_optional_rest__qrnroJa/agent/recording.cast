[94.30811, "i", "cat > test_fn.mjs << 'EOF'\nimport { type } from 'arktype';\n\n// Test simpler tuple literal first  \nconst t1 = type([\"string\", \"number\", \"...\", \"string[]\"]);\nconsole.log('schema expression:', t1.expression);\nconsole.log('assert [\"a\", 1, \"b\", \"c\"]:', t1.assert([\"a\", 1, \"b\", \"c\"]));\nconsole.log('assert [\"a\", 1]:', t1.assert([\"a\", 1]));\n\nconst f = type.fn(t1)((name, ts, ...tags) => {\n  return { name, ts, tags };\n});\nconsole.log('---');\nconsole.log(JSON.stringify(f(\"abc\", 100, \"x\", \"y\")));\nconsole.log(JSON.stringify(f(\"abc\", 100)));\nEOF\nnpx --no-install tsx test_fn.mjs\n"]
