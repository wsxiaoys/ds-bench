[198.652011, "i", "cat > test_fn.mjs << 'EOF'\nimport { type } from 'arktype';\n\n// Test length-constrained strings\nconst name = type(\"1 <= string <= 50\");\nconsole.log('name expression:', name.expression);\n\nconst tag = type(\"1 <= string <= 30\");\nconsole.log('tag expression:', tag.expression);\n\n// Test optional\nconst opt = type([\"string\", \"?\"]);\nconsole.log('opt expression:', opt.expression);\n\n// Test integer\nconst int = type(\"integer >= 0\");\nconsole.log('int expression:', int.expression);\n\n// Test object\nconst obj = type({ kind: \"string\", data: \"unknown\" });\nconsole.log('obj expression:', obj.expression);\n\nEOF\nnpx --no-install tsx test_fn.mjs\n"]
