[190.474757, "i", "cat > test_fn.mjs << 'EOF'\nimport { type } from 'arktype';\n\n// Test that bad input throws TraversalError\nconst f = type.fn(\n  \"string\", \n  \"number >= 0\", \n  \"...\", \n  \"string[]\"\n)((name, ts, ...tags) => {\n  return { name, ts, tags };\n});\n\ntry {\n  f(123, 100, \"x\");\n} catch (e) {\n  console.log('Error type:', e.constructor.name);\n  console.log('Error message:', e.message);\n}\nEOF\nnpx --no-install tsx test_fn.mjs\n"]
