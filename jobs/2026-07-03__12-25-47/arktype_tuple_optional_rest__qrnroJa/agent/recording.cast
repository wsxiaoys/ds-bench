[279.714874, "i", "cat > test_fn.mjs << 'EOF'\nimport { type } from 'arktype';\n\n// Combine all\nconst f = type.fn(\n  \"1 <= string <= 50\",\n  \"number % 1 >= 0\",\n  [\"{ kind: string, data: unknown }\", \"?\"],\n  \"...\",\n  \"1 <= string <= 30\"\n)((name, ts, payload, ...tags) => {\n  return { name, ts, payload, tags };\n});\n\nconsole.log('params expression:', f.params.expression);\nconsole.log('---');\nconsole.log('test 1:', JSON.stringify(f(\"event1\", 100, { kind: \"user\", data: { id: 1 } }, \"a\", \"b\")));\nconsole.log('test 2:', JSON.stringify(f(\"event1\", 100, undefined, \"a\", \"b\")));\nconsole.log('test 3:', JSON.stringify(f(\"event1\", 100)));\n\n// Bad input\ntry {\n  f(123, 100);\n} catch (e) {\n  console.log('Error type:', e.constructor.name);\n  console.log('Error message:', e.message);\n}\n\ntry {\n  f(\"event1\", 5.5);\n} catch (e) {\n  console.log('Error2:', e.constructor.name, e.message);\n}\n\nEOF\nnpx --no-install tsx test_fn.mjs\n"]
