[219.854618, "o", "cat node_modules/arktype/out/keywords/number.d.ts | head -40\r\n\u001b[?2004l\r"]
[219.855962, "o", "import type { Module, Submodule } from \"../module.ts\";\r\n/**\r\n * As per the ECMA-262 specification:\r\n * A time value supports a slightly smaller range of -8,640,000,000,000,000 to 8,640,000,000,000,000 milliseconds.\r\n *\r\n * @see https://262.ecma-international.org/15.0/index.html#sec-time-values-and-time-range\r\n */\r\nexport declare const epoch: import(\"@ark/schema\").BaseRoot<import(\"@ark/schema\").InternalRootDeclaration>;\r\nexport declare const integer: import(\"@ark/schema\").BaseRoot<import(\"@ark/schema\").InternalRootDeclaration>;\r\nexport declare const number: number.module;\r\nexport declare namespace number {\r\n    type module = Module<submodule>;\r\n    type submodule = Submodule<$>;\r\n    type $ = {\r\n        root: number;\r\n"]
[219.855994, "o", "        epoch: number;\r\n        integer: number;\r\n        safe: number;\r\n        NaN: number;\r\n        Infinity: number;\r\n        NegativeInfinity: number;\r\n    };\r\n}\r\n"]
[219.856197, "o", "\u001b[?2004hroot@83fdef26-f5a1-4c44-abdc-b2bba8aff942:/home/user/myproject# "]
[224.742719, "i", "cat > test_int.mjs << 'EOF'\nimport { type, number } from 'arktype';\n\nconsole.log('integer expression:', number.integer.expression);\n\nconst t1 = type(number.integer);\nconsole.log('integer via schema:', t1.expression);\n\n// Use narrow syntax\nconst t2 = number.integer.atMost(Number.MAX_SAFE_INTEGER).atLeast(0);\nconsole.log('integer >= 0:', t2.expression);\n\n// Or with a string\ntry {\n  const t3 = type(\"number.integer\");\n  console.log('number.integer string:', t3.expression);\n} catch(e) { console.log('number.integer failed:', e.message); }\n\ntry {\n  const t4 = type(\"number\").narrow((v, ctx) => { \n    if (!Number.isInteger(v)) return ctx.mustBe(\"an integer\");\n    return true;\n  });\n  console.log('narrow integer:', t4.expression);\n} catch(e) { console.log('narrow failed:', e.message); }\n\nEOF\nnpx --no-install tsx test_int.mjs\n"]
