[415.142873, "i", "cat > test_alphanum.mjs << 'EOF'\nimport { type } from 'arktype';\n\n// Try alphanumeric\ntry {\n  const t1 = type(\"string.alphanumeric\");\n  console.log('alphanumeric:', t1.expression);\n  console.log('test abc:', t1(\"abc\"));\n  try { t1(\"abc-123\"); } catch(e) { console.log('abc-123 error:', e.message); }\n} catch(e) { console.log('alphanum failed:', e.message); }\n\n// Try regex\ntry {\n  const t2 = type(\"/^[a-zA-Z0-9]+$/\");\n  console.log('regex:', t2.expression);\n} catch(e) { console.log('regex failed:', e.message); }\n\n// Or with pattern\ntry {\n  const t3 = type(\"string\", \"@\", { pattern: \"^[a-zA-Z0-9]+$\" });\n  console.log('pattern:', t3.expression);\n} catch(e) { console.log('pattern failed:', e.message); }\n\nEOF\nnpx --no-install tsx test_alphanum.mjs\n"]
