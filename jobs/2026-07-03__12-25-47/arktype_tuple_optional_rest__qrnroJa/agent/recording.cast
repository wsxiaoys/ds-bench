[355.010108, "o", "/home/user/myproject/cli.ts:1\r\nimport { emit, TraversalError } from \"./src/emit.ts\";\r\n               ^\r\nSyntaxError: The requested module './src/emit.ts' does not provide an export named 'TraversalError'\r\n\u001b[90m    at #asyncInstantiate (node:internal/modules/esm/module_job:327:21)\u001b[39m\r\n\u001b[90m    at async ModuleJob.run (node:internal/modules/esm/module_job:431:5)\u001b[39m\r\n    at async node:internal/modules/esm/loader:643:26\r\n\u001b[90m    at async asyncRunEntryPointWithESMLoader (node:internal/modules/run_main:101:5)\u001b[39m\r\n\r\nNode.js v24.18.0\r\n"]
