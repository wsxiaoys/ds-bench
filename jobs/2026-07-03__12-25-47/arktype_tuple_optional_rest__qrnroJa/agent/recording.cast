[297.719728, "i", "cat > test_array.mjs << 'EOF'\nimport { type } from 'arktype';\n\n// Try various array syntaxes\ntry {\n  const t1 = type(\"string[]\");\n  console.log('string[]:', t1.expression);\n} catch(e) { console.log('string[] failed:', e.message); }\n\ntry {\n  const t2 = type(\"1 <= string <= 30[]\");\n  console.log('1 <= string <= 30[]:', t2.expression);\n} catch(e) { console.log('failed:', e.message); }\n\ntry {\n  const t3 = type([\"1 <= string <= 30\"]);\n  console.log('array of constraint:', t3.expression);\n} catch(e) { console.log('failed:', e.message); }\n\ntry {\n  const t4 = type(\"string <= 30 & >= 1\", \"[]\");\n  console.log('postfix []:', t4.expression);\n} catch(e) { console.log('failed:', e.message); }\n\ntry {\n  const t5 = type(\"0 < string <= 30\").array();\n  console.log('method .array():', t5.expression);\n} catch(e) { console.log('failed:', e.message); }\n\nEOF\nnpx --no-install tsx test_array.mjs\n"]
