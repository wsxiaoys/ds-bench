}, {
    name: "string.base64"
});
const preformattedCapitalize = regexStringNode(/^[A-Z].*$/, "capitalized");
export const capitalize = Scope.module({
    root: rootSchema({
        in: "string",
        morphs: (s) => s.charAt(0).toUpperCase() + s.slice(1),
