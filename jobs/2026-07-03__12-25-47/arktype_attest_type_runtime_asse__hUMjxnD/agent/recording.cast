[21.394837, "o", "{\r\n  \"name\": \"@arktype/attest\",\r\n  \"version\": \"0.56.0\",\r\n  \"license\": \"MIT\",\r\n  \"author\": {\r\n    \"name\": \"David Blass\",\r\n    \"email\": \"david@arktype.io\",\r\n    \"url\": \"https://arktype.io\"\r\n  },\r\n  \"repository\": {\r\n    \"type\": \"git\",\r\n    \"url\": \"https://github.com/arktypeio/arktype.git\",\r\n    \"directory\": \"ark/attest\"\r\n  },\r\n  \"type\": \"module\",\r\n  \"main\": \"./out/index.js\",\r\n  \"types\": \"./out/index.d.ts\",\r\n  \"exports\": {\r\n    \".\": {\r\n      \"ark-ts\": \"./index.ts\",\r\n      \"default\": \"./out/index.js\"\r\n    },\r\n    \"./internal/*.ts\": {\r\n      \"ark-ts\": \"./*.ts\",\r\n      \"default\": \"./out/*.js\"\r\n    },\r\n    \"./internal/*.js\": {\r\n      \"ark-ts\": \"./*.ts\",\r\n      \"default\": \"./out/*.js\"\r\n    }\r\n  },\r\n  \"files\": [\r\n    \"out\"\r\n  ],\r\n  \"bin\": {\r\n    \"attest\": \"out/cli/cli.js\"\r\n  },\r\n  \"dependencies\": {\r\n"]
[21.394868, "o", "    \"@prettier/sync\": \"0.6.1\",\r\n    \"@typescript/analyze-trace\": \"0.10.1\",\r\n    \"@typescript/vfs\": \"1.6.1\",\r\n    \"prettier\": \"3.6.2\",\r\n    \"arktype\": \"2.1.28\",\r\n    \"@ark/util\": \"0.56.0\",\r\n    \"@ark/fs\": \"0.56.0\"\r\n  },\r\n  \"devDependencies\": {\r\n    \"typescript\": \"5.9.3\"\r\n  },\r\n  \"peerDependencies\": {\r\n    \"typescript\": \"*\"\r\n  },\r\n  \"publishConfig\": {\r\n    \"access\": \"public\"\r\n  },\r\n  \"scripts\": {\r\n    \"build\": \"ts ../repo/build.ts\",\r\n    \"test\": \"ts ../repo/testPackage.ts\"\r\n  }\r\n}"]
