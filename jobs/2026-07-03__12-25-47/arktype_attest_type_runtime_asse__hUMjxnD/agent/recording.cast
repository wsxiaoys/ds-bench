[529.09066, "i", "cat > ./test_runtime3.mjs << 'EOF'\nimport { type, type as t } from \"arktype\"\n\n// Try type.\"string.numeric\" patterns\nconsole.log(\"type:\", typeof type)\nconsole.log(\"type('string.numeric'):\", type(\"string.numeric\").toString())\nconsole.log(\"type('string.numeric.parse'):\", type(\"string.numeric.parse\").toString())\n\n// Try scope access\nimport * as arktype from \"arktype\"\nconsole.log(\"arktype keys:\", Object.keys(arktype))\n\n// Try to get the root access\nconst StringNumeric = type(\"string.numeric\")\nconsole.log(\"Infer:\", StringNumeric.expression)\nconsole.log(\"Keys count:\", Object.keys(StringNumeric).length)\n\n// Check if there's a way to access submodule via keyword\nconst t2 = type(\"string\")\nconsole.log(\"type('string').expression:\", t2.expression)\nEOF\nnode ./test_runtime3.mjs\n"]
