[586.308703, "o", "2:import type { anyOrNever, array, Callable, ErrorMessage, inferred, JsonStructure, unset } from \"@ark/util\";\r\n3:import type { defaultFor, distill, inferIntersection, inferPipe, InferredMorph, Out, To } from \"../attributes.ts\";\r\n13:    [inferred]: t;\r\n23:     * 🥸 inference-only property that will be `undefined` at runtime\r\n27:     * you should use {@link infer} or {@link inferIn} on this object instead.\r\n37:     * 🥸 inference-only property that will be `undefined` at runtime\r\n41:     * type ParsedNumber = typeof parseNumber.infer // number\r\n43:    infer: this[\"inferOut\"];\r\n47:     * 🔗 alias of {@link infer}\r\n48:     * 🥸 inference-only property that will be `undefined` at runtime\r\n53:     * type ParsedNumber = typeof parseNumber.infer // number\r\n55:    inferOut: distill.Out<t>;\r\n59:     * ⚠️ If your Type contains morphs, they will be inferred as `unknown` unless\r\n62:     * 🥸 inference-only property that will be `undefined` at runtime\r\n67:     * type UnmorphedOut = typeof Unmorphed.inferIntrospectableOut // string\r\n70:     * // with a standard user-defined morph, TypeScript can infer a\r\n73:     * type MorphOut = typeof Morphed.inferIntrospectableOut  // unknown\r\n"]
[586.30873, "o", "77:     * type ValidatedMorphOut = typeof Validated.inferIntrospectableOut\r\n79:    inferIntrospectableOut: distill.introspectable.Out<t>;\r\n83:     * 🥸 inference-only property that will be `undefined` at runtime\r\n"]
