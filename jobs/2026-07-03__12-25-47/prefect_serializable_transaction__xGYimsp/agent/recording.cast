[110.460893, "o", "48:class IsolationLevel(AutoEnum):\r\n53:class CommitMode(AutoEnum):\r\n59:class TransactionState(AutoEnum):\r\n67:class BaseTransaction(ContextModel, abc.ABC):\r\n90:    def set(self, name: str, value: Any) -> None:\r\n109:    def get(self, name: str, default: Any = NotSet) -> Any:\r\n171:    def is_committed(self) -> bool:\r\n174:    def is_rolled_back(self) -> bool:\r\n177:    def is_staged(self) -> bool:\r\n180:    def is_pending(self) -> bool:\r\n183:    def is_active(self) -> bool:\r\n186:    def prepare_transaction(self) -> None:\r\n217:    def add_child(self, transaction: Self) -> None:\r\n220:    def get_parent(self) -> Self | None:\r\n231:    def stage(\r\n250:    def get_active(cls: Type[Self]) -> Optional[Self]:\r\n253:    def __eq__(self, other: Any) -> bool:\r\n259:class Transaction(BaseTransaction):\r\n264:    def __enter__(self) -> Self:\r\n270:    def __exit__(self, *exc_info: Any) -> None:\r\n299:    def begin(self) -> None:\r\n315:    def read(self) -> ResultRecord[Any] | None:\r\n320:    def reset(self) -> None:\r\n335:    def commit(self) -> bool:\r\n393:    def run_hook(self, hook: Callable[..., Any], hook_type: str) -> None:\r\n418:    def rollback(self) -> bool:\r\n452:class AsyncTransaction(BaseTransaction):\r\n457:    async def begin(self) -> None:\r\n473:    async def read(self) -> ResultRecord[Any] | None:\r\n478:    async def reset(self) -> None:\r\n495:    async def commit(self) -> bool:\r\n553:    async def run_hook(self, hook: Callable[..., Any], hook_type: str) -> None:\r\n578:    async def rollback(self) -> bool:\r\n611:    async def __aenter__(self) -> Self:\r\n617:    async def __aexit__(self, *exc_info: Any) -> None:\r\n646:    def __enter__(self) -> NoReturn:\r\n651:    def __exit__(self, *exc_info: Any) -> NoReturn:\r\n657:def get_transaction() -> BaseTransaction | None:\r\n662:def transaction(\r\n714:async def atransaction(\r\n"]
