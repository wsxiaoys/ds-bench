[56.327746, "o", "446:        lock_manager: The lock manager to use for locking result records. If not provided,\r\n464:    lock_manager: Optional[LockManager] = Field(default=None)\r\n579:            update[\"lock_manager\"] = current_txn.store.lock_manager\r\n590:            if task.cache_policy.lock_manager is not None:\r\n591:                update[\"lock_manager\"] = task.cache_policy.lock_manager\r\n633:            update[\"lock_manager\"] = current_txn.store.lock_manager\r\n644:            if task.cache_policy.lock_manager is not None:\r\n645:                update[\"lock_manager\"] = task.cache_policy.lock_manager\r\n818:        if self.lock_manager is not None and not self.is_lock_holder(key, holder):\r\n888:        if self.lock_manager is not None and not self.is_lock_holder(key, holder):\r\n1094:            self.lock_manager is not None\r\n1158:            self.lock_manager is not None\r\n1221:    def supports_isolation_level(self, level: \"IsolationLevel\") -> bool:\r\n1236:            return self.lock_manager is not None\r\n1256:        if self.lock_manager is None:\r\n1261:        return self.lock_manager.acquire_lock(key, holder, timeout)\r\n1279:        if self.lock_manager is None:\r\n1285:        return await self.lock_manager.aacquire_lock(key, holder, timeout)\r\n1298:        if self.lock_manager is None:\r\n1303:        return self.lock_manager.release_lock(key, holder)\r\n1309:        if self.lock_manager is None:\r\n1314:        return self.lock_manager.is_locked(key)\r\n"]
