[106.905093, "o", "ypes/v1/context_add_params.py\\n\"]\r\n[37.586159, \"o\", \"cat /usr/local/lib/python3.12/dist-packages/alchemyst_ai/types/v1/context_add_params.py\\r\\n\\u001b[?2004l\\r\"]\r\n[37.587042, \"o\", \"# File generated from our OpenAPI spec by Stainless. See CONTRIBUTING.md for details.\\r\\n\\r\\nfrom __future__ import annotations\\r\\n\\r\\nfrom typing import Dict, Union, Iterable\\r\\nfrom typing_extensions import Literal, Required, Annotated, TypeAlias, TypedDict\\r\\n\\r\\nfrom ..._types import SequenceNotStr\\r\\nfrom ..._utils import PropertyInfo\\r\\n\\r\\n__all__ = [\\\"ContextAddParams\\\", \\\"Document\\\", \\\"Metadata\\\"]\\r\\n\\r\\n\\r\\nclass ContextAddParams(TypedDict, total=False):\\r\\n    context_type: Required[Literal[\\\"resource\\\", \\\"conversation\\\", \\\"instruction\\\"]]\\r\\n    \\\"\\\"\\\"Type of context being added\\\"\\\"\\\"\\r\\n\\r\\n    documents: Required[Iterable[Document]]\\r\\n    \\\"\\\"\\\"Array of documents with content and additional metadata\\\"\\\"\\\"\\r\\n\\r\\n    scope: Required[Literal[\\\"internal\\\", \\\"external\\\"]]\\r\\n    \\\"\\\"\\\"Scope of the context\\\"\\\"\\\"\\r\\n\\r\\n    source: Required[str]\\r\\n    \\\"\\\"\\\"The source of the context data\\\"\\\"\\\"\\r\\n\\r\\n    metadata: Metadata\\r\\n    \\\"\\\"\\\"Additional metadata for the context\\\"\\\"\\\"\\r\\n\\r\\n\\r\\nclass DocumentTyped(TypedDict, total=False):\\r\\n    content: str\\r\\n    \\\"\\\"\\\"The content of the document\\\"\\\"\\\"\\r\\n\\r\\n\\r\\nDocument: TypeAlias = Union[DocumentTyped, Dict[str, str]]\\r\\n\\r\\n\\r\\nclass Metadata(TypedDict, total=False):\\r\\n    \\\"\\\"\\\"Additional metadata for the context\\\"\\\"\\\"\\r\\n\\r\\n    file_name: Annotated[str, PropertyInfo(alias=\\\"fileName\\\")]\\r\\n    \\\"\\\"\\\"Name of the file\\\"\\\"\\\"\\r\\n\\r\\n    file_size: Annotated[float, PropertyInfo(alias=\\\"fileSize\\\")]\\r\\n    \\\"\\\"\\\"Size of the file in bytes\\\"\\\"\\\"\\r\\n\\r\\n    file_type: Annotated[str, PropertyInfo(alias=\\\"fileType\\\")]\\r\\n    \\\"\\\"\\\"Type/MIME of the file\\\"\\\"\\\"\\r\\n\\r\\n    group_name: Annotated[SequenceNotStr[str], PropertyInfo(alias=\\\"groupName\\\")]\\r\\n    \\\"\\\"\\\"Array of Group Name to which the file belongs to\\\"\\\"\\\"\\r\\n\\r\\n    last_modified: Annotated[str, PropertyInfo(alias=\\\"lastModified\\\")]\\r\\n    \\\"\\\"\\\"Last modified timestamp\\\"\\\"\\\"\\r\\n\"]\r\n[37.58722, \"o\", \"\\u001b[?2004hroot@98cb5632-818f-4edb-a148-fe76810e14b2:~# \"]\r\n[40.185178, \"i\", \"cat /usr/local/lib/python3.12/dist-packages/alchemyst_ai/types/v1/context_search_response.py\\n\"]\r\n[40.185602, \"o\", \"cat /usr/local/lib/python3.12/dist-packages/alchemyst_ai/types/v1/context_search_response.py\\r\\n\\u001b[?2004l\\r\"]\r\n[40.186491, \"o\", \"# File generated from our OpenAPI spec by Stainless. See CONTRIBUTING.md for details.\\r\\n\\r\\nfrom typing import List, Optional\\r\\nfrom datetime import datetime\\r\\n\\r\\nfrom pydantic import Field as FieldInfo\\r\\n\\r\\nfrom ..._models import BaseModel\\r\\n\\r\\n__all__ = [\\\"ContextSearchResponse\\\", \\\"Context\\\"]\\r\\n\\r\\n\\r\\nclass Context(BaseModel):\\r\\n    content: Optional[str] = None\\r\\n\\r\\n    created_at: Optional[datetime] = FieldInfo(alias=\\\"createdAt\\\", default=None)\\r\\n\\r\\n    metadata: Optional[object] = None\\r\\n    \\\"\\\"\\\"Only included when query parameter metadata=true\\\"\\\"\\\"\\r\\n\\r\\n    score: Optional[float] = None\\r\\n\\r\\n    updated_at: Optional[datetime] = FieldInfo(alias=\\\"updatedAt\\\", default=None)\\r\\n\\r\\n\\r\\nclass ContextSearchResponse(BaseModel):\\r\\n    contexts: Optional[List[Context]] = None\\r\\n\"]\r\n[40.18667, \"o\", \"\\u001b[?2004hroot@98cb5632-818f-4edb-a148-fe76810e14b2:~# \"]\r\n[49.380725, \"i\", \"mkdir -p /home/user/myproject\\n\"]\r\n[49.380972, \"o\", \"mkdir -p /home/user/myproject\\r\\n\\u001b[?2004l\\r\"]\r\n[49.382306, \"o\", \"\\u001b[?2004hroot@98cb5632-818f-4edb-a148-fe76810e14b2:~# \"]\r\n[49.698197, \"i\", \"cat > /home/user/myproject/main.py << 'PYEOF'\\n#!/usr/bin/env python3\\n\\\"\\\"\\\"Basic Alchemyst AI RAG flow.\\n\\nAdds a 30-day refund policy document to the Alchemyst context engine and\\nthen searches for chunks relevant to a user-supplied question.\\n\\\"\\\"\\\"\\n\\nimport argparse\\nimport os\\nimport sys\\n\\nfrom alchemyst_ai import AlchemystAI\\n\\n\\nREFUND_POLICY_CONTENT = (\\n    \\\"Refund Policy. Customers may request a full refund within 30 days of \\\"\\n    \\\"purchase for any product or subscription, no questions asked. To be \\\"\\n  "]
[106.905341, "o", "  \\\"eligible for a refund, the customer must provide the original order \\\"\\n    \\\"number and proof of purchase. Refund requests submitted after the \\\"\\n    \\\"30-day window will not be honoured. Approved refunds are typically \\\"\\n    \\\"credited back to the original payment method within 5-7 business days.\\\"\\n)\\n\\n\\ndef parse_args() -> argparse.Namespace:\\n    parser = argparse.ArgumentParser(\\n        description=\\\"Run a basic Alchemyst AI RAG flow.\\\"\\n    )\\n    parser.add_argument(\\n        \\\"--question\\\",\\n        required=True,\\n        type=str,\\n        help=\\\"The user question to search the Alchemyst context engine for.\\\",\\n    )\\n    return parser.parse_args()\\n\\n\\ndef read_run_id() -> str:\\n    run_id_path = \\\"/logs/artifacts/run-id\\\"\\n    with open(run_id_path, \\\"r\\\", encoding=\\\"utf-8\\\") as fh:\\n        return fh.read().strip()\\n\\n\\ndef main() -> int:\\n    args = parse_args()\\n\\n    api_key = os.environ.get(\\\"ALCHEMYST_AI_API_KEY\\\")\\n    if not api_key:\\n        print(\\n            \\\"Error: ALCHEMYST_AI_API_KEY environment variable is not set.\\\",\\n            file=sys.stderr,\\n        )\\n        return 1\\n\\n    run_id = read_run_id()\\n\\n    client = AlchemystAI(api_key=api_key)\\n\\n    # 1) Add a single policy document to the context engine.\\n    add_response = client.v1.context.add(\\n        context_type=\\\"resource\\\",\\n        source=\\\"documentation\\\",\\n        scope=\\\"internal\\\",\\n        documents=[\\n            {\\n                \\\"content\\\": REFUND_POLICY_CONTENT,\\n                \\\"file_name\\\": f\\\"refunds-{run_id}.md\\\",\\n                \\\"file_type\\\": \\\"text/markdown\\\",\\n                \\\"last_modified\\\": \\\"2024-01-01T00:00:00Z\\\",\\n            }\\n        ],\\n        metadata={\\n            \\\"file_name\\\": f\\\"refunds-{run_id}.md\\\",\\n        },\\n    )\\n\\n    print(f\\\"[add] {add_response}\\\")\\n\\n    # 2) Search the context engine for the user question.\\n    search_response = client.v1.context.search(\\n        query=args.question,\\n        scope=\\\"internal\\\",\\n        similarity_threshold=0.6,\\n        minimum_similarity_threshold=0.1,\\n    )\\n\\n    contexts = getattr(search_response, \\\"contexts\\\", None) or []\\n    if not contexts:\\n        print(\\n            \\\"No relevant context chunks were returned for the question: \\\"\\n            f\\\"{args.question!r}\\\"\\n        )\\n        return 0\\n\\n    for idx, ctx in enumerate(contexts, start=1):\\n        content = getattr(ctx, \\\"content\\\", None)\\n        print(f\\\"--- chunk {idx} ---\\\")\\n        print(content if content is not None else ctx)\\n\\n    return 0\\n\\n\\nif __name__ == \\\"__main__\\\":\\n    sys.exit(main())\\nPYEOF\\n\"]\r\n[49.698608, \"o\", \"cat > /home/user/myproject/main.py << 'PYEOF'\\r\\n\\u001b[?2004l\\r\"]\r\n[49.69866, \"o\", \"\\u001b[?2004h> \"]\r\n[49.698699, \"o\", \"#!/usr/bin/env python3\\r\\n\\u001b[?2004l\\r\"]\r\n[49.69873, \"o\", \"\\u001b[?2004h> \"]\r\n[49.698814, \"o\", \"\\\"\\\"\\\"Basic Alchemyst AI RAG flow.\\r\\n\\u001b[?2004l\\r\"]\r\n[49.698845, \"o\", \"\\u001b[?2004h> \\r\\n\\u001b[?2004l\\r\\u001b[?2004h\"]\r\n[49.698865, \"o\", \"> \"]\r\n[49.699087, \"o\", \"Adds a 30-day refund policy document to the Alchemyst context engine and\\r\\n\\u001b[?2004l\\r\"]\r\n[49.699111, \"o\", \"\\u001b[?2004h> \"]\r\n[49.699298, \"o\", \"then searches for chunks relevant to a user-supplied question.\\r\\n\\u001b[?2004l\\r\"]\r\n[49.699323, \"o\", \"\\u001b[?2004h> \\\"\\\"\\\"\\r\\n\\u001b[?2004l\\r\"]\r\n[49.699376, \"o\", \"\\u001b[?2004h> \\r\\n\\u001b[?2004l\\r\\u001b[?2004h\"]\r\n[49.699399, \"o\", \"> \"]\r\n[49.69945, \"o\", \"import argparse\\r\\n\\u001b[?2004l\\r\\u001b[?2004h\"]\r\n[49.699479, \"o\", \"> \"]\r\n[49.699512, \"o\", \"import os\\r\\n\\u001b[?2004l\\r\"]\r\n[49.699572, \"o\", \"\\u001b[?2004h> import sys\\r\\n\\u001b[?2004l\\r\"]\r\n[49.699608, \"o\", \"\\u001b[?2004h> \\r\\n\\u001b[?2004l\\r\\u001b[?2004h\"]\r\n[49.699631, \"o\", \"> \"]\r\n[49.699733, \"o\", \"from alchemyst_ai import AlchemystAI\\r\\n\\u001b[?2004l\\r\"]\r\n\u001b[?2004hroot@98cb5632-818f-4edb-a148-fe76810e14b2:/home/user/myproject# "]
