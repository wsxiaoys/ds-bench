[244.139658, "o", "--- chunk 1 ---\r\nCustomers may request a full refund within 30 days of purchase.\r\n"]
[244.139686, "o", "--- chunk 2 ---\r\nApproved refunds are typically credited back within 5-7 business days.\r\n\r\nAll requests:\r\nPOST https://platform-backend.getalchemystai.com/api/v1/context/add\r\n{\"context_type\":\"resource\",\"documents\":[{\"content\":\"Refund policy content here\",\"file_name\":\"refunds-zrk929ciai.md\"}],\"scope\":\"internal\",\"source\":\"documentation\",\"metadata\":{\"fileName\":\"refunds-zrk929ciai.md\"}}\r\n\r\nPOST https://platform-backend.getalchemystai.com/api/v1/context/search\r\n"]
[244.139709, "o", "{\"minimum_similarity_threshold\":0.1,\"query\":\"How long for refund?\",\"similarity_threshold\":0.6,\"scope\":\"internal\"}\r\n\r\n"]
