[49.706431, "o", "\u001b[?2004h> "]
[49.706559, "o", "            \"file_name\": f\"refunds-{run_id}.md\",\r\n\u001b[?2004l\r"]
[49.706596, "o", "\u001b[?2004h> "]
[49.70663, "o", "        },\r\n\u001b[?2004l\r\u001b[?2004h> "]
[49.706665, "o", "    )\r\n\u001b[?2004l\r\u001b[?2004h> "]
[49.70669, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[49.706798, "o", "    print(f\"[add] {add_response}\")\r\n\u001b[?2004l\r"]
[49.706834, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[49.706995, "o", "    # 2) Search the context engine for the user question.\r\n\u001b[?2004l\r"]
[49.70703, "o", "\u001b[?2004h> "]
[49.707144, "o", "    search_response = client.v1.context.search(\r\n\u001b[?2004l\r"]
[49.707178, "o", "\u001b[?2004h> "]
[49.707247, "o", "        query=args.question,\r\n\u001b[?2004l\r"]
[49.707285, "o", "\u001b[?2004h> "]
[49.70735, "o", "        scope=\"internal\",\r\n\u001b[?2004l\r"]
[49.707377, "o", "\u001b[?2004h> "]
[49.707468, "o", "        similarity_threshold=0.6,\r\n\u001b[?2004l\r"]
[49.707493, "o", "\u001b[?2004h> "]
[49.707603, "o", "        minimum_similarity_threshold=0.1,\r\n\u001b[?2004l\r"]
[49.707638, "o", "\u001b[?2004h>     )\r\n\u001b[?2004l\r"]
[49.707672, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[49.707705, "o", "> "]
[49.707864, "o", "    contexts = getattr(search_response, \"contexts\", None) or []\r\n\u001b[?2004l\r"]
[49.70789, "o", "\u001b[?2004h> "]
[49.707958, "o", "    if not contexts:\r\n\u001b[?2004l\r"]
[49.707984, "o", "\u001b[?2004h> "]
[49.708033, "o", "        print(\r\n\u001b[?2004l\r"]
[49.70807, "o", "\u001b[?2004h> "]
[49.708253, "o", "            \"No relevant context chunks were returned for the question: \"\r\n\u001b[?2004l\r"]
[49.708278, "o", "\u001b[?2004h> "]
[49.708383, "o", "            f\"{args.question!r}\"\r\n\u001b[?2004l\r"]
[49.708409, "o", "\u001b[?2004h> "]
[49.708461, "o", "        )\r\n\u001b[?2004l\r\u001b[?2004h> "]
[49.708515, "o", "        return 0\r\n\u001b[?2004l\r"]
[49.708541, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[49.708587, "o", "\u001b[?2004h> "]
[49.708707, "o", "    for idx, ctx in enumerate(contexts, start=1):\r\n\u001b[?2004l\r"]
[49.708732, "o", "\u001b[?2004h> "]
[49.708867, "o", "        content = getattr(ctx, \"content\", None)\r\n\u001b[?2004l\r"]
[49.708893, "o", "\u001b[?2004h> "]
[49.709, "o", "        print(f\"--- chunk {idx} ---\")\r\n\u001b[?2004l\r"]
[49.709027, "o", "\u001b[?2004h> "]
[49.709184, "o", "        print(content if content is not None else ctx)\r\n\u001b[?2004l\r"]
[49.709209, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[49.709239, "o", "\u001b[?2004h> "]
[49.70928, "o", "    return 0\r\n\u001b[?2004l\r"]
[49.709316, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[49.709343, "o", "> \r\n\u001b[?2004l\r"]
