[243.959567, "i", "python3 << 'PYEOF'\nimport sys\nimport os\nimport httpx\n\nos.environ[\"ALCHEMYST_AI_API_KEY\"] = \"sk-test\"\n\ncaptured_requests = []\n\ndef custom_transport(request):\n    captured_requests.append({\n        \"method\": request.method,\n        \"url\": str(request.url),\n        \"content\": request.content.decode('utf-8') if request.content else None,\n    })\n    if \"/add\" in str(request.url):\n        return httpx.Response(200, json={\"status\": \"success\"})\n    else:\n        return httpx.Response(200, json={\n            \"contexts\": [\n                {\"content\": \"Customers may request a full refund within 30 days of purchase.\", \"score\": 0.95},\n                {\"content\": \"Approved refunds are typically credited back within 5-7 business days.\", \"score\": 0.85},\n            ]\n        })\n\nfrom alchemyst_ai import AlchemystAI\n\nclient = AlchemystAI(\n    api_key=\"sk-test\",\n    http_client=httpx.Client(transport=httpx.MockTransport(custom_transport))\n)\n\nwith open(\"/logs/artifacts/run-id\") as f:\n    run_id = f.read().strip()\n\nadd_response = client.v1.context.add(\n    context_type=\"resource\",\n    source=\"documentation\",\n    scope=\"internal\",\n    documents=[\n        {\n            \"content\": \"Refund policy content here\",\n            \"file_name\": f\"refunds-{run_id}.md\",\n        }\n    ],\n    metadata={\"file_name\": f\"refunds-{run_id}.md\"},\n)\nprint(\"Add response:\", add_response)\n\nsearch_response = client.v1.context.search(\n    query=\"How long for refund?\",\n    scope=\"internal\",\n    similarity_threshold=0.6,\n    minimum_similarity_threshold=0.1,\n)\n\nfor idx, ctx in enumerate(search_response.contexts or [], start=1):\n    print(f\"--- chunk {idx} ---\")\n    print(ctx.content)\n\nprint(\"\\nAll requests:\")\nfor req in captured_requests:\n    print(req[\"method\"], req[\"url\"])\n    print(req[\"content\"])\n    print()\nPYEOF\n"]
