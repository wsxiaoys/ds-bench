[201.47776, "o", "def maybe_transform(\r\n    data: object,\r\n    expected_type: object,\r\n) -> Any | None:\r\n    \"\"\"Wrapper over `transform()` that allows `None` to be passed.\r\n\r\n    See `transform()` for more details.\r\n    \"\"\"\r\n    if data is None:\r\n        return None\r\n    return transform(data, expected_type)\r\n\r\n"]
[201.477817, "o", "\r\n# Wrapper over _transform_recursive providing fake types\r\ndef transform(\r\n    data: _T,\r\n    expected_type: object,\r\n) -> _T:\r\n    \"\"\"Transform dictionaries based off of type information from the given type, for example:\r\n\r\n    ```py\r\n"]
[201.478039, "o", "\u001b[?2004hroot@98cb5632-818f-4edb-a148-fe76810e14b2:/home/user/myproject# "]
[201.786695, "i", "find /usr/local/lib/python3.12/dist-packages/alchemyst_ai -name \"_transform*\"\n"]
[201.78702, "o", "find /usr/local/lib/python3.12/dist-packages/alchemyst_ai -name \"_transform*\"\r\n"]
[201.787096, "o", "\u001b[?2004l\r"]
[201.788227, "o", "/usr/local/lib/python3.12/dist-packages/alchemyst_ai/_utils/_transform.py\r\n"]
[201.788261, "o", "/usr/local/lib/python3.12/dist-packages/alchemyst_ai/_utils/__pycache__/_transform.cpython-312.pyc\r\n"]
[201.788884, "o", "\u001b[?2004hroot@98cb5632-818f-4edb-a148-fe76810e14b2:/home/user/myproject# "]
[206.068639, "i", "grep -A 50 \"def transform\" /usr/local/lib/python3.12/dist-packages/alchemyst_ai/_utils/_transform.py | head -80\n"]
[206.069075, "o", "grep -A 50 \"def transform\" /usr/local/lib/python3.12/dist-packages/alchemyst_ai/_utils/_transform.py | head -80\r\n\u001b[?2004l\r"]
[206.070535, "o", "def transform(\r\n    data: _T,\r\n    expected_type: object,\r\n) -> _T:\r\n    \"\"\"Transform dictionaries based off of type information from the given type, for example:\r\n\r\n    ```py\r\n    class Params(TypedDict, total=False):\r\n        card_id: Required[Annotated[str, PropertyInfo(alias=\"cardID\")]]\r\n\r\n\r\n    transformed = transform({\"card_id\": \"<my card ID>\"}, Params)\r\n    # {'cardID': '<my card ID>'}\r\n    ```\r\n\r\n    Any keys / data that does not have type information given will be included as is.\r\n\r\n    It should be noted that the transformations that this function does are not represented in the type system.\r\n    \"\"\"\r\n    transformed = _transform_recursive(data, annotation=cast(type, expected_type))\r\n    return cast(_T, transformed)\r\n\r\n\r\n@lru_cache(maxsize=8096)\r\ndef _get_annotated_type(type_: type) -> type | None:\r\n    \"\"\"If the given type is an `Annotated` type then it is returned, if not `None` is returned.\r\n\r\n    This also unwraps the type when applicable, e.g. `Required[Annotated[T, ...]]`\r\n    \"\"\"\r\n    if is_required_type(type_):\r\n        "]
[206.070567, "o", "# Unwrap `Required[Annotated[T, ...]]` to `Annotated[T, ...]`\r\n        type_ = get_args(type_)[0]\r\n\r\n    if is_annotated_type(type_):\r\n        return type_\r\n\r\n    return None\r\n\r\n\r\ndef _maybe_transform_key(key: str, type_: type) -> str:\r\n    \"\"\"Transform the given `data` based on the annotations provided in `type_`.\r\n\r\n    Note: this function only looks at `Annotated` types that contain `PropertyInfo` metadata.\r\n    \"\"\"\r\n    annotated_type = _get_annotated_type(type_)\r\n    if annotated_type is None:\r\n        # no `Annotated` definition for this type, no transformation needed\r\n"]
[206.070636, "o", "        return key\r\n\r\n    # ignore the first argument as it is the actual type\r\n    annotations = get_args(annotated_type)[1:]\r\n"]
[206.070823, "o", "\u001b[?2004h"]
[206.070852, "o", "root@98cb5632-818f-4edb-a148-fe76810e14b2:/home/user/myproject# "]
[213.563306, "i", "python3 << 'PYEOF'\nfrom alchemyst_ai import AlchemystAI\nimport httpx\n\n# Capture the request\nimport json\n\ncaptured_requests = []\n\ndef custom_transport(request):\n    captured_requests.append({\n        \"method\": request.method,\n        \"url\": str(request.url),\n        \"headers\": dict(request.headers),\n        \"content\": request.content.decode('utf-8') if request.content else None,\n    })\n    # Return a 402 error like the real API\n    return httpx.Response(402, json={\"status\": \"error\", \"message\": \"test\"})\n\nclient = AlchemystAI(\n    api_key=\"sk-test\",\n    http_client=httpx.Client(transport=httpx.MockTransport(custom_transport))\n)\n\ntry:\n    client.v1.context.add(\n        context_type=\"resource\",\n        source=\"documentation\",\n        scope=\"internal\",\n        documents=[\n            {\n                \"content\": \"test content\",\n                \"file_name\": \"refunds-test.md\",\n            }\n        ],\n        metadata={\"file_name\": \"refunds-test.md\"},\n    )\nexcept Exception as e:\n    pass\n\nfor req in captured_requests:\n    print(req[\"method\"], req[\"url\"])\n    print(req[\"content\"])\nPYEOF\n"]
