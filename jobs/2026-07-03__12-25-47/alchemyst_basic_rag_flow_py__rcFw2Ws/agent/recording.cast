[233.555597, "i", "python3 << 'PYEOF'\nimport sys\nsys.argv = [\"main.py\", \"--question\", \"How long for refund?\"]\n\nfrom unittest.mock import patch\nimport httpx\n\ncaptured_requests = []\n\ndef custom_transport(request):\n    captured_requests.append({\n        \"method\": request.method,\n        \"url\": str(request.url),\n        \"content\": request.content.decode('utf-8') if request.content else None,\n    })\n    if \"/add\" in str(request.url):\n        return httpx.Response(200, json={\"status\": \"success\"})\n    else:\n        return httpx.Response(200, json={\n            \"contexts\": [\n                {\"content\": \"Customers may request a full refund within 30 days of purchase.\", \"score\": 0.95},\n                {\"content\": \"Approved refunds are typically credited back within 5-7 business days.\", \"score\": 0.85},\n            ]\n        })\n\nimport os\nos.environ[\"ALCHEMYST_AI_API_KEY\"] = \"sk-test\"\n\nfrom alchemyst_ai import AlchemystAI\n\nwith patch.object(AlchemystAI, '__init__', lambda self, **kwargs: None):\n    with patch.object(AlchemystAI, '_client', None):\n        pass\n\n# Actually, let's just monkey-patch httpx\nimport alchemyst_ai._base_client\noriginal_init = httpx.Client.__init__\n\ndef patched_init(self, *args, **kwargs):\n    kwargs['transport'] = httpx.MockTransport(custom_transport)\n    original_init(self, *args, **kwargs)\n\nhttpx.Client.__init__ = patched_init\n\n# Now run main\nimport importlib.util\nspec = importlib.util.spec_from_file_location(\"main\", \"/home/user/myproject/main.py\")\nmain = importlib.util.module_from_spec(spec)\nspec.loader.exec_module(main)\n\nmain.main()\nPYEOF\n"]
