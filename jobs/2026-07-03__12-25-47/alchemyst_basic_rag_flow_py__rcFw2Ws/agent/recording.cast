[222.932417, "i", "python3 << 'PYEOF'\nfrom alchemyst_ai import AlchemystAI\nimport httpx\n\ncaptured_requests = []\n\ndef custom_transport(request):\n    captured_requests.append({\n        \"method\": request.method,\n        \"url\": str(request.url),\n        \"headers\": dict(request.headers),\n        \"content\": request.content.decode('utf-8') if request.content else None,\n    })\n    return httpx.Response(200, json={\"contexts\": [{\"content\": \"refund policy content\", \"score\": 0.9}]})\n\nclient = AlchemystAI(\n    api_key=\"sk-test\",\n    http_client=httpx.Client(transport=httpx.MockTransport(custom_transport))\n)\n\nresult = client.v1.context.search(\n    query=\"refund policy\",\n    scope=\"internal\",\n    similarity_threshold=0.6,\n    minimum_similarity_threshold=0.1,\n)\n\nfor req in captured_requests:\n    print(req[\"method\"], req[\"url\"])\n    print(req[\"content\"])\n\nprint(\"\\nResult:\", result)\nfor ctx in result.contexts:\n    print(\"Chunk content:\", ctx.content)\nPYEOF\n"]
[222.932632, "o", "python3 << 'PYEOF'\r\n\u001b[?2004l\r"]
[222.93268, "o", "\u001b[?2004h> "]
