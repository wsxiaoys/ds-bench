[?2004hroot@77f06d53-e0cf-4d1d-b413-341f2462c43d:~# cat > /home/user/altair_stocks_candlestick/build_chart.py << 'PYEOF'
[?2004l[?2004h> import altair as alt
[?2004l[?2004h> import pandas as pd
[?2004l[?2004h> 
[?2004l[?2004h> # Read the OHLCV dataset
[?2004l[?2004h> df = pd.read_csv('/home/user/altair_stocks_candlestick/ohlcv.csv')
[?2004l[?2004h> df['date'] = pd.to_datetime(df['date'])
[?2004l[?2004h> 
[?2004l[?2004h> # Define an interval brush selection constrained to the x (date) encoding
[?2004l[?2004h> brush = alt.selection_interval(encodings=['x'])
[?2004l[?2004h> 
[?2004l[?2004h> # Base chart for candlestick view (shared across the layered marks)
[?2004l[?2004h> base = alt.Chart(df).encode(x=alt.X('date:T', title='Date'))
[?2004l[?2004h> 
[?2004l[?2004h> # Wick: rule from low to high
[?2004l[?2004h> wick = base.mark_rule(color='#555555').encode(
[?2004l[?2004h>     y=alt.Y('low:Q', title='Price', scale=alt.Scale(zero=False)),
[?2004l[?2004h>     y2='high:Q',
[?2004l[?2004h> )
[?2004l[?2004h> 
[?2004l[?2004h> # Body: bar from open to close with conditional coloring
[?2004l[?2004h> body = base.mark_bar().encode(
[?2004l[?2004h>     y=alt.Y('open:Q'),
[?2004l[?2004h>     y2='close:Q',
[?2004l[?2004h>     color=alt.condition(
[?2004l[?2004h>         'datum.close >= datum.open',
[?2004l[?2004h>         alt.value('#26a69a'),  # green for up days
[?2004l[?2004h>         alt.value('#ef5350'),  # red for down days
[?2004l[?2004h>     ),
[?2004l[?2004h> )
[?2004l[?2004h> 
[?2004l[?2004h> # Combine wick and body into candlestick view
[?2004l[?2004h> candlestick = alt.LayerChart(layers=[wick, body]).encode(
[?2004l[?2004h>     x=alt.X('date:T', title='Date'),
[?2004l[?2004h> ).properties(
[?2004l[?2004h>     width=800,
[?2004l[?2004h>     height=400,
[?2004l[?2004h>     title='Candlestick Chart',
[?2004l[?2004h> )
[?2004l[?2004h> 
[?2004l[?2004h> # Bind candlestick's x-scale domain to the brush selection
[?2004l[?2004h> candlestick = candlestick.transform_filter(brush) if False else candlestick
[?2004l[?2004h> 
[?2004l[?2004h> # We need to make the candlestick respect the brush via x scale domain binding.
[?2004l[?2004h> # Approach: build candlestick via a layered chart object and override its x encoding
[?2004l[?2004h> # to use the brush selection as the scale domain.
[?2004l[?2004h> 
[?2004l[?2004h> # Volume bar chart with brush parameter attached
[?2004l[?2004h> volume = alt.Chart(df).mark_bar(color='#4c78a8').encode(
[?2004l[?2004h>     x=alt.X('date:T', title='Date'),
[?2004l[?2004h>     y=alt.Y('volume:Q', title='Volume'),
[?2004l[?2004h> ).add_params(brush).properties(
[?2004l[?2004h>     width=800,
[?2004l[?2004h>     height=150,
[?2004l[?2004h>     title='Volume',
[?2004l[?2004h> )
[?2004l[?2004h> 
[?2004l[?2004h> # Create candlestick with x domain bound to brush
[?2004l[?2004h> candlestick = alt.Chart(df).encode(
[?2004l[?2004h>     x=alt.X('date:T', title='Date', scale=alt.Scale(domain=brush)),
[?2004l[?2004h> ).mark_rule(color='#555555').encode(
[?2004l[?2004h>     y=alt.Y('low:Q', title='Price', scale=alt.Scale(zero=False)),
[?2004l[?2004h>     y2='high:Q',
[?2004l[?2004h> ).properties(
[?2004l[?2004h>     width=800,
[?2004l[?2004h>     height=400,
[?2004l[?2004h>     title='Candlestick Chart',
[?2004l[?2004h> )
[?2004l[?2004h> 
[?2004l[?2004h> # Recreate properly with layered chart
[?2004l[?2004h> base_c = alt.Chart(df).encode(x=alt.X('date:T', title='Date'))
[?2004l[?2004h> wick = base_c.mark_rule(color='#555555').encode(
[?2004l[?2004h>     y=alt.Y('low:Q', title='Price', scale=alt.Scale(zero=False)),
[?2004l[?2004h>     y2='high:Q',
[?2004l[?2004h> )
[?2004l[?2004h> body = base_c.mark_bar().encode(
[?2004l[?2004h>     y='open:Q',
[?2004l[?2004h>     y2='close:Q',
[?2004l[?2004h>     color=alt.condition(
[?2004l[?2004h>         'datum.close >= datum.open',
[?2004l[?2004h>         alt.value('#26a69a'),
[?2004l[?2004h>         alt.value('#ef5350'),
[?2004l[?2004h>     ),
[?2004l[?2004h> )
[?2004l[?2004h> candlestick = (wick + body).encode(
[?2004l[?2004h>     x=alt.X('date:T', title='Date', scale=alt.Scale(domain=brush)),
[?2004l[?2004h> ).properties(width=800, height=400, title='Candlestick Chart')
[?2004l[?2004h> 
[?2004l[?2004h> # Compose vertically
[?2004l[?2004h> chart = alt.vconcat(candlestick, volume).resolve_scale(x='shared')
[?2004l[?2004h> 
[?2004l[?2004h> # Save chart artifacts
[?2004l[?2004h> chart.save('/home/user/altair_stocks_candlestick/chart.html')
[?2004l[?2004h> chart.save('/home/user/altair_stocks_candlestick/chart.json')
[?2004l[?2004h> 
[?2004l[?2004h> print('Chart saved successfully.')
[?2004l[?2004h> PYEOF
