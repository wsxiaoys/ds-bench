[139.518026, "i", "python3 -c \"\nfrom e2b import Sandbox\nimport json\nwith open('/home/user/e2b_task_info.json') as f:\n    info = json.load(f)\nsandbox = Sandbox.connect(info['sandbox_id'])\nprint('=== scan_network.sh ===')\nprint(sandbox.files.read('/home/user/scan_network.sh'))\nprint('=== scan_results.txt ===')\nprint(sandbox.files.read('/home/user/scan_results.txt'))\nsandbox.kill()\n\"\n"]
