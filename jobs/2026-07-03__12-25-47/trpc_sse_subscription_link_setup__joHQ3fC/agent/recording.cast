[45.928196, "o", "import { initTRPC } from '@trpc/server';\r\nimport { createHTTPServer } from '@trpc/server/adapters/standalone';\r\nimport { z } from 'zod';\r\n\r\nconst t = initTRPC.create();\r\nconst publicProcedure = t.procedure;\r\nconst router = t.router;\r\n\r\nconst appRouter = router({\r\n  countdown: publicProcedure\r\n    .input(z.number())\r\n    .subscription(async function* ({ input }: { input: number }) {\r\n      for (let i = input; i >= 0; i--) {\r\n        yield i;\r\n        await new Promise((resolve) => setTimeout(resolve, 100));\r\n      }\r\n    }),\r\n});\r\n\r\nexport type AppRouter = typeof appRouter;\r\n\r\nconst server = createHTTPServer({\r\n  router: appRouter,\r\n});\r\n\r\nserver.listen(3000);\r\n\r\nconsole.log('tRPC server listening on http://localhost:3000');\r\n"]
[45.92848, "o", "\u001b[?2004hroot@46593a21-41da-4646-a1f4-797eae0aba3b:/home/user/project# "]
[52.746824, "i", "cat > client.ts << 'EOF'\nimport { createTRPCClient } from '@trpc/client';\nimport { httpSubscriptionLink } from '@trpc/client';\nimport fs from 'fs';\nimport type { AppRouter } from './server';\n\nconst client = createTRPCClient<AppRouter>({\n  links: [\n    httpSubscriptionLink({\n      url: 'http://localhost:3000',\n    }),\n  ],\n});\n\nasync function main() {\n  const results: number[] = [];\n  const subscription = client.countdown.subscribe(3, {\n    onData: (value: number) => {\n      results.push(value);\n    },\n    onComplete: () => {\n      fs.writeFileSync('/home/user/project/output.json', JSON.stringify(results));\n      console.log('Wrote output:', results);\n    },\n    onError: (err: unknown) => {\n      console.error('Subscription error:', err);\n    },\n  });\n\n  // Wait for the subscription to complete\n  await new Promise<void>((resolve) => {\n    subscription.unsubscribe();\n    // Give some time for the data to be flushed\n    setTimeout(resolve, 2000);\n  });\n}\n\nmain().catch((err) => {\n  console.error(err);\n  process.exit(1);\n});\nEOF\n"]
[52.747129, "o", "cat > client.ts << 'EOF'\r\n\u001b[?2004l\r"]
[52.747189, "o", "\u001b[?2004h> "]
