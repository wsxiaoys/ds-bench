[297.116764, "o", "import { useQuery } from '@tanstack/react-query'\r\nimport './App.css'\r\n\r\ntype Product = {\r\n  id: number\r\n  name: string\r\n  price: number\r\n}\r\n\r\nconst fetchProducts = (): Promise<Product[]> => {\r\n  return new Promise((resolve) => {\r\n    setTimeout(() => {\r\n      resolve([\r\n        { id: 1, name: 'Laptop', price: 999 },\r\n        { id: 2, name: 'Phone', price: 599 },\r\n      ])\r\n    }, 500)\r\n  })\r\n}\r\n\r\nfunction App() {\r\n  const { data, isLoading } = useQuery<Product[]>({\r\n    queryKey: ['products'],\r\n    queryFn: fetchProducts,\r\n  })\r\n\r\n  if (isLoading) {\r\n    return <div>Loading...</div>\r\n  }\r\n\r\n  return (\r\n    <ul>\r\n      {data?.map((product) => (\r\n        <li key={product.id}>\r\n          {product.name} - ${product.price}\r\n        </li>\r\n      ))}\r\n    </ul>\r\n  )\r\n}\r\n\r\nexport default App\r\n"]
