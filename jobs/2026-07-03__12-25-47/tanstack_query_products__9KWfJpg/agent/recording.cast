[425.195374, "i", "echo \"=== vite.config.ts ===\" && cat vite.config.ts\n"]
[425.195878, "o", "echo \"=== vite.config.ts ===\" && cat vite.config.ts\r\n\u001b[?2004l\r"]
[425.195962, "o", "=== vite.config.ts ===\r\n"]
[425.197728, "o", "import { defineConfig } from 'vite'\r\nimport react from '@vitejs/plugin-react'\r\n\r\n// https://vite.dev/config/\r\nexport default defineConfig({\r\n  plugins: [react()],\r\n  server: {\r\n    port: 4782,\r\n  },\r\n})\r\n"]
[425.198097, "o", "\u001b[?2004h"]
[425.198141, "o", "root@99ed14d1-377e-4fa4-9529-fc77cef2e426:/home/user/tanstack-query-products# "]
[425.599491, "i", "echo \"=== src/main.tsx ===\" && cat src/main.tsx\n"]
[425.600075, "o", "echo \"=== src/main.tsx ===\" && cat src/main.tsx\r\n\u001b[?2004l\r"]
[425.600179, "o", "=== src/main.tsx ===\r\n"]
[425.6019, "o", "import { StrictMode } from 'react'\r\nimport { createRoot } from 'react-dom/client'\r\nimport { QueryClient, QueryClientProvider } from '@tanstack/react-query'\r\nimport './index.css'\r\nimport App from './App.tsx'\r\n\r\nconst queryClient = new QueryClient()\r\n\r\ncreateRoot(document.getElementById('root')!).render(\r\n  <StrictMode>\r\n    <QueryClientProvider client={queryClient}>\r\n      <App />\r\n    </QueryClientProvider>\r\n  </StrictMode>,\r\n)\r\n"]
[425.602283, "o", "\u001b[?2004h"]
[425.602334, "o", "root@99ed14d1-377e-4fa4-9529-fc77cef2e426:/home/user/tanstack-query-products# "]
[425.979183, "i", "echo \"=== src/App.tsx ===\" && cat src/App.tsx\n"]
[425.979669, "o", "echo \"=== src/App.tsx ===\" && cat src/App.tsx\r\n\u001b[?2004l\r"]
[425.979768, "o", "=== src/App.tsx ===\r\n"]
[425.981252, "o", "import { useQuery } from '@tanstack/react-query'\r\nimport './App.css'\r\n\r\ntype Product = {\r\n  id: number\r\n  name: string\r\n  price: number\r\n}\r\n\r\nconst fetchProducts = (): Promise<Product[]> => {\r\n  return new Promise((resolve) => {\r\n    setTimeout(() => {\r\n      resolve([\r\n        { id: 1, name: 'Laptop', price: 999 },\r\n        { id: 2, name: 'Phone', price: 599 },\r\n      ])\r\n    }, 500)\r\n  })\r\n}\r\n\r\nfunction App() {\r\n  const { data, isLoading } = useQuery<Product[]>({\r\n    queryKey: ['products'],\r\n    queryFn: fetchProducts,\r\n  })\r\n\r\n  if (isLoading) {\r\n    return <div>Loading...</div>\r\n  }\r\n\r\n  return (\r\n    <ul>\r\n      {data?.map((product) => (\r\n        <li key={product.id}>\r\n          {product.name} - ${product.price}\r\n        </li>\r\n      ))}\r\n    </ul>\r\n  )\r\n}\r\n\r\nexport default App\r\n"]
[425.981648, "o", "\u001b[?2004hroot@99ed14d1-377e-4fa4-9529-fc77cef2e426:/home/user/tanstack-query-products# "]
