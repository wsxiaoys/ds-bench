[424.825254, "o", "=== package.json ===\r\n"]
[424.826903, "o", "{\r\n  \"name\": \"tanstack-query-products\",\r\n  \"private\": true,\r\n  \"version\": \"0.0.0\",\r\n  \"type\": \"module\",\r\n  \"scripts\": {\r\n    \"dev\": \"vite\",\r\n    \"build\": \"tsc -b && vite build\",\r\n    \"lint\": \"oxlint\",\r\n    \"preview\": \"vite preview\"\r\n  },\r\n  \"dependencies\": {\r\n    \"@tanstack/react-query\": \"^5.101.2\",\r\n    \"react\": \"^19.2.7\",\r\n    \"react-dom\": \"^19.2.7\"\r\n  },\r\n  \"devDependencies\": {\r\n    \"@types/node\": \"^24.13.2\",\r\n    \"@types/react\": \"^19.2.17\",\r\n    \"@types/react-dom\": \"^19.2.3\",\r\n"]
[424.826952, "o", "    \"@vitejs/plugin-react\": \"^6.0.3\",\r\n    \"oxlint\": \"^1.71.0\",\r\n    \"typescript\": \"~6.0.2\",\r\n    \"vite\": \"^8.1.1\"\r\n  }\r\n}\r\n"]
[424.827317, "o", "\u001b[?2004h"]
