[12.333599, "o", "import { createCallerFactory, appRouter } from './trpc';\r\n\r\n// TODO: Create a caller using createCallerFactory\r\nexport const caller = null as any;\r\n"]
[12.333958, "o", "\u001b[?2004hroot@93af38c5-00af-455c-aa99-f24c03439e0f:/home/user/app# "]
