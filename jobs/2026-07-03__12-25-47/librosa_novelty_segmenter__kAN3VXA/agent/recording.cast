[166.900451, "o", "times = librosa.frames_to_time(np.arange(T), sr=sr, hop_length=hop)\r\n\u001b[?2004l\r"]
[166.900506, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[166.900558, "o", "\u001b[?2004h> "]
