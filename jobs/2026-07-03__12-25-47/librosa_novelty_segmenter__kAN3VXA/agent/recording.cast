[166.901649, "o", "> "]
[166.901907, "o", "p_sorted = sorted(peaks, key=lambda p: -abs_nv[p])[:8]\r\n\u001b[?2004l\r"]
[166.901957, "o", "\u001b[?2004h> "]
[166.902129, "o", "for p in sorted(p_sorted):\r\n\u001b[?2004l\r"]
