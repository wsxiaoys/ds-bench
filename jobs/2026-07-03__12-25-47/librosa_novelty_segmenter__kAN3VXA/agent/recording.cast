[166.899241, "o", "\u001b[?2004h"]
[166.89933, "o", "> "]
[166.899444, "o", "    nov[t] = np.sum(patch * kernel)\r\n\u001b[?2004l\r"]
[166.899499, "o", "\u001b[?2004h> "]
[166.899562, "o", "\r\n\u001b[?2004l\r"]
[166.899586, "o", "\u001b[?2004h> "]
[166.899685, "o", "nov -= np.mean(nov)\r\n\u001b[?2004l\r"]
[166.899738, "o", "\u001b[?2004h> "]
[166.899978, "o", "nv = nov / (np.max(np.abs(nov)) + 1e-12)\r\n\u001b[?2004l\r"]
