[?2004l[?2004h>     if len(near) > 0:
[?2004l[?2004h>         # pick the one with max value of nv
[?2004l[?2004h>         idx = near[np.argmax(nv[peaks[near]])]
[?2004l[?2004h>         chosen.append(int(peaks[idx]))
[?2004l[?2004h>     else:
[?2004l[?2004h>         chosen.append(target)
