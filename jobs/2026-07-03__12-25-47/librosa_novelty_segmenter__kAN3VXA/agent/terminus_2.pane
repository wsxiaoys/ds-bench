[?2004l[?2004h> skip = max(5, int(0.05 * T))
[?2004l[?2004h> peaks, props = find_peaks(nv, distance=max(10, N//2), prominence=0.05)
[?2004l[?2004h> peaks = peaks[(peaks >= skip) & (peaks <= T - skip)]
[?2004l[?2004h> print('peaks frames', peaks)
[?2004l[?2004h> times = librosa.frames_to_time(peaks, sr=sr, hop_length=hop)
[?2004l[?2004h> print('peaks times', times)
[?2004l[?2004h> 
[?2004l[?2004h> # sort by prominence and keep top relevant
[?2004l[?2004h> if len(peaks) == 0:
[?2004l[?2004h>     # fallback: argmax nearest 5s and 10s
[?2004l[?2004h>     candidates = [f5, f10]
[?2004l[?2004h>     peaks = np.array(candidates)
[?2004l[?2004h>     times = librosa.frames_to_time(peaks, sr=sr, hop_length=hop)
[?2004l[?2004h> 
