[?2004l[?2004h> kernel[:H, H:] = -1.0
[?2004l[?2004h> kernel[H:, :H] = -1.0
[?2004l[?2004h> g = gaussian_filter(kernel, sigma=N/8)
[?2004l[?2004h> kernel = np.where(kernel > 0, np.abs(g), -np.abs(g))
[?2004l[?2004h> kernel /= np.max(np.abs(kernel))
[?2004l[?2004h> 
[?2004l[?2004h> T = S.shape[0]
[?2004l[?2004h> nov = np.zeros(T)
[?2004l[?2004h> S_padded = np.pad(S, N, mode='constant', constant_values=0)
[?2004l[?2004h> for t in range(T):
[?2004l[?2004h>     patch = S_padded[t:t+N, t:t+N]
[?2004l[?2004h>     nov[t] = np.sum(patch * kernel)
[?2004l[?2004h> 
[?2004l[?2004h> nov -= np.mean(nov)
[?2004l[?2004h> nv = nov / (np.max(np.abs(nov)) + 1e-12)
[?2004l[?2004h> print('nov', nv.shape, 'max', nv.max(), 'min', nv.min())
