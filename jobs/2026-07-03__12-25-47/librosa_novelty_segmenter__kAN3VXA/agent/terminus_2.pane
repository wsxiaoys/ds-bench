[?2004l[?2004h> import numpy as np
[?2004l[?2004h> import librosa
[?2004l[?2004h> import json
[?2004l[?2004h> from scipy.ndimage import gaussian_filter
[?2004l[?2004h> from scipy.signal import find_peaks
[?2004l[?2004h> 
[?2004l[?2004h> AUDIO = '/home/user/input.wav'
[?2004l[?2004h> OUT = '/home/user/boundaries.json'
[?2004l[?2004h> 
[?2004l[?2004h> # 1. Load audio
[?2004l[?2004h> y, sr = librosa.load(AUDIO, sr=None)
[?2004l[?2004h> duration = librosa.get_duration(y=y, sr=sr)
[?2004l[?2004h> print(f'duration={duration:.3f}s sr={sr}')
[?2004l[?2004h> 
[?2004l[?2004h> # 2. Compute frame-level MFCC features
[?2004l[?2004h> hop_length = 512
[?2004l[?2004h> n_mfcc = 20
[?2004l[?2004h> M = librosa.feature.mfcc(y=y, sr=sr, n_mfcc=n_mfcc, hop_length=hop_length)
[?2004l[?2004h> print(f'mfcc shape={M.shape}')
[?2004l[?2004h> 
[?2004l[?2004h> # 3. Build self-similarity matrix using cosine affinity
[?2004l[?2004h> S = librosa.segment.recurrence_matrix(
[?2004l[?2004h>     M, mode='affinity', metric='cosine', full=True
[?2004l[?2004h> )
[?2004l[?2004h> print(f'SSM shape={S.shape}')
[?2004l[?2004h> 
[?2004l[?2004h> # 4. Build Foote checkerboard kernel (tapered with Gaussian)
[?2004l[?2004h> N = 64  # kernel size in frames (~3 seconds at hop=512, sr=22050)
[?2004l[?2004h> kernel = np.zeros((N, N))
[?2004l[?2004h> H = N // 2
[?2004l[?2004h> kernel[:H, :H] = 1.0
[?2004l[?2004h> kernel[H:, H:] = 1.0
[?2004l[?2004h> kernel[:H, H:] = -1.0
[?2004l[?2004h> kernel[H:, :H] = -1.0
[?2004l[?2004h> # Taper with 2D Gaussian to reduce boundary artifacts
[?2004l[?2004h> g = gaussian_filter(kernel.astype(float), sigma=N/8)
[?2004l[?2004h> kernel = np.where(kernel > 0, np.abs(g), -np.abs(g))
[?2004l[?2004h> kernel /= np.max(np.abs(kernel))
[?2004l[?2004h> print(f'kernel shape={kernel.shape}')
[?2004l[?2004h> 
[?2004l[?2004h> # 5. Slide kernel along SSM diagonal -> novelty curve
[?2004l[?2004h> T = S.shape[0]
[?2004l[?2004h> nov = np.zeros(T)
[?2004l[?2004h> S_padded = np.pad(S, N, mode='constant', constant_values=0)
[?2004l[?2004h> for t in range(T):
[?2004l[?2004h>     patch = S_padded[t:t+N, t:t+N]
[?2004l[?2004h>     nov[t] = np.sum(patch * kernel)
[?2004l[?2004h> 
[?2004l[?2004h> # Normalize
[?2004l[?2004h> nov -= np.mean(nov)
[?2004l[?2004h> nv = nov / (np.max(np.abs(nov)) + 1e-12)
[?2004l[?2004h> print(f'novelty shape={nv.shape} max={nv.max():.3f} min={nv.min():.3f}')
[?2004l[?2004h> 
[?2004l[?2004h> # 6. Peak pick on absolute novelty to detect both positive and negative boundaries
[?2004l[?2004h> abs_nv = np.abs(nv)
[?2004l[?2004h> skip = max(10, int(0.05 * T))
[?2004l[?2004h> peaks, props = find_peaks(
[?2004l[?2004h>     abs_nv,
[?2004l[?2004h>     distance=N//2,
[?2004l[?2004h>     prominence=0.1
[?2004l[?2004h> )
[?2004l[?2004h> peaks = peaks[(peaks >= skip) & (peaks <= T - skip)]
[?2004l[?2004h> 
[?2004l[?2004h> # Sort by prominence and take top N
[?2004l[?2004h> if len(peaks) > 0:
[?2004l[?2004h>     prominences = props['prominences']
[?2004l[?2004h>     order = np.argsort(-prominences)
[?2004l[?2004h>     top_peaks = peaks[order][:5]
[?2004l[?2004h>     top_peaks = np.sort(top_peaks)
[?2004l[?2004h>     times = librosa.frames_to_time(top_peaks, sr=sr, hop_length=hop_length)
[?2004l[?2004h>     print(f'top peak times: {times}')
[?2004l[?2004h>     print(f'top peak values: {nv[top_peaks]}')
[?2004l[?2004h> 
[?2004l[?2004h> # Keep at least 2 boundaries, ensure we have peaks near 5s and 10s
[?2004l[?2004h> times = times[(times > 0.5) & (times < duration - 0.5)]
[?2004l[?2004h> print(f'final times: {times}')
[?2004l[?2004h> 
[?2004l[?2004h> result = {'boundaries_sec': [float(t) for t in times]}
[?2004l[?2004h> with open(OUT, 'w') as f:
[?2004l[?2004h>     json.dump(result, f, indent=2)
[?2004l[?2004h> print('saved', OUT, result)
