[8.224681, "o", "cat client/trpc.ts\r\n\u001b[?2004l\r"]
[8.225583, "o", "import { createTRPCClient, httpBatchLink } from '@trpc/client';\r\nimport type { AppRouter } from '../server/router';\r\nimport superjson from 'superjson';\r\n\r\nexport const trpc = createTRPCClient<AppRouter>({\r\n  // In v10, transformer was here. In v11, it must be moved to the links array.\r\n  // The task is to fix this configuration.\r\n  transformer: superjson,\r\n  links: [\r\n    httpBatchLink({\r\n      url: 'http://localhost:3000',\r\n    }),\r\n  ],\r\n});\r\n"]
[8.225742, "o", "\u001b[?2004hroot@ad73c926-4222-49b0-a839-2e11a0aee08b:/home/user/project# "]
[8.592473, "i", "cat server/router.ts\n"]
[8.592728, "o", "cat server/router.ts\r\n\u001b[?2004l\r"]
[8.593824, "o", "import { initTRPC } from '@trpc/server';\r\nimport superjson from 'superjson';\r\n\r\nconst t = initTRPC.create({\r\n  transformer: superjson,\r\n});\r\n\r\nexport const appRouter = t.router({\r\n  getServerTime: t.procedure.query(() => {\r\n    return new Date('2026-04-28T10:00:00.000Z');\r\n  }),\r\n});\r\n\r\nexport type AppRouter = typeof appRouter;\r\n"]
