[41.397063, "o", "cat client/index.ts\r\n\u001b[?2004l\r"]
[41.397964, "o", "import { trpc } from './trpc';\r\n\r\nasync function main() {\r\n  try {\r\n    const time = await trpc.getServerTime.query();\r\n    if (!(time instanceof Date)) {\r\n      console.error('Expected time to be a Date object, but got:', typeof time, time);\r\n      process.exit(1);\r\n    }\r\n    console.log('Successfully fetched Date object:', time.toISOString());\r\n    process.exit(0);\r\n  } catch (err) {\r\n    console.error('Failed to fetch:', err);\r\n    process.exit(1);\r\n  }\r\n}\r\n\r\nmain();\r\n"]
[41.398136, "o", "\u001b[?2004hroot@ad73c926-4222-49b0-a839-2e11a0aee08b:/home/user/project# "]
