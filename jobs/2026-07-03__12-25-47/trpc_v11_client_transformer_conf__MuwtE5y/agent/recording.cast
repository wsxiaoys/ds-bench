[41.801952, "o", "import { createHTTPServer } from '@trpc/server/adapters/standalone';\r\nimport { appRouter } from './router';\r\n\r\nconst server = createHTTPServer({\r\n  router: appRouter,\r\n});\r\n\r\nserver.listen(3000);\r\nconsole.log('Server listening on port 3000');\r\n"]
