[268.726051, "i", "python3 -c \"t=chr(9); s='extends SceneTree\\n\\nfunc _init():\\n'+t+'var tree = load(\\\"res://resources/dialogs/intro.tres\\\") as DialogTree\\n'+t+'assert(tree != null)\\n'+t+'assert(tree.nodes.size() >= 5)\\n'+t+'var m=false\\n'+t+'var c=false\\n'+t+'for n in tree.nodes:\\n'+t+t+'if n.choices.size() >= 2: m=true\\n'+t+t+'for ch in n.choices:\\n'+t+t+t+'if ch.condition_flag != StringName(\\\"\\\"): c=true\\n'+t+'assert(m)\\n'+t+'assert(c)\\n'+t+'print(\\\"TREE OK\\\", tree.nodes.size())\\n'+t+'var p=DialogPlayer.new()\\n'+t+'root.add_child(p)\\n'+t+'p.tree=tree\\n'+t+'p.line_shown.connect(func(s,t2,ch): print(\\\"LINE\\\",s,t2))\\n'+t+'p.dialog_finished.connect(func(): print(\\\"FIN\\\"))\\n'+t+'p.start()\\n'+t+'p.set_flag(&knows_secret)\\n'+t+'p.advance(0)\\n'+t+'p.advance(0)\\n'+t+'p.advance(0)\\n'+t+'p.advance(0)\\n'+t+'quit(0)\\n'; open('scripts/test_dialog.gd','w').write(s)\"\n"]
