[103.92363, "i", "python3 << 'PYEOF'\nlines = [\n    '@tool',\n    'extends SceneTree',\n    '',\n    'func _init():',\n    '\\tvar t: DialogTree = DialogTree.new()',\n    '\\tvar c1: DialogChoice = DialogChoice.new()',\n    '\\tc1.label = \"Say hello\"',\n    '\\tc1.next_id = &\"greet\"',\n    '\\tvar c2: DialogChoice = DialogChoice.new()',\n    '\\tc2.label = \"Stay silent\"',\n    '\\tc2.next_id = &\"silent\"',\n    '\\tvar n_intro: DialogNode = DialogNode.new()',\n    '\\tn_intro.id = &\"start\"',\n    '\\tn_intro.speaker = \"Narrator\"',\n    '\\tn_intro.text = \"A traveler approaches the gate.\"',\n    '\\tn_intro.choices = [c1, c2]',\n    '\\tvar n_greet: DialogNode = DialogNode.new()',\n    '\\tn_greet.id = &\"greet\"',\n    '\\tn_greet.speaker = \"Guard\"',\n    '\\tn_greet.text = \"Well met, friend! Enter.\"',\n    '\\tn_greet.next_id = &\"inside\"',\n    '\\tvar n_silent: DialogNode = DialogNode.new()',\n    '\\tn_silent.id = &\"silent\"',\n    '\\tn_silent.speaker = \"Guard\"',\n    '\\tn_silent.text = \"...you say nothing.\"',\n    '\\tn_silent.next_id = &\"inside\"',\n    '\\tvar n_inside: DialogNode = DialogNode.new()',\n    '\\tn_inside.id = &\"inside\"',\n    '\\tn_inside.speaker = \"Narrator\"',\n    '\\tn_inside.text = \"You step into the hall.\"',\n    '\\tvar c_secret: DialogChoice = DialogChoice.new()',\n    '\\tc_secret.label = \"Search the secret room\"',\n    '\\tc_secret.next_id = &\"secret\"',\n    '\\tc_secret.condition_flag = &\"knows_secret\"',\n    '\\tvar c_leave: DialogChoice = DialogChoice.new()',\n    '\\tc_leave.label = \"Walk away\"',\n    '\\tc_leave.next_id = &\"end\"',\n    '\\tn_inside.choices = [c_secret, c_leave]',\n    '\\tvar n_secret: DialogNode = DialogNode.new()',\n    '\\tn_secret.id = &\"secret\"',\n    '\\tn_secret.speaker = \"Narrator\"',\n    '\\tn_secret.text = \"You find a hidden chest.\"',\n    '\\tn_secret.next_id = &\"end\"',\n    '\\tvar n_end: DialogNode = DialogNode.new()',\n    '\\tn_end.id = &\"end\"',\n    '\\tn_end.speaker = \"Narrator\"',\n    '\\tn_end.text = \"Farewell.\"',\n    '\\tt.start_id = &\"start\"',\n    '\\tt.nodes = [n_intro, n_greet, n_silent, n_inside, n_secret, n_end]',\n    '\\tvar err: int = ResourceSaver.save(t, \"res://resources/dialogs/intro.tres\")',\n    '\\tprint(\"save result: \", err)',\n    '\\tquit(err if err != OK else 0)',\n]\nwith open('/tmp/make_intro.gd', 'w') as f:\n    f.write('\\n'.join(lines) + '\\n')\nprint('wrote /tmp/make_intro.gd')\nPYEOF\n"]
