[50.918098, "o", "for c in node.choices:\r\n\u001b[?2004l\r\u001b[?2004h"]
[50.918127, "o", ">               "]
[50.918234, "o", "var flag: StringName = c.condition_flag\r\n\u001b[?2004l\r"]
[50.918262, "o", "\u001b[?2004h>               "]
[50.918342, "o", "if flag == StringName(\"\"):\r\n\u001b[?2004l\r"]
[50.918371, "o", "\u001b[?2004h>               "]
[50.918435, "o", "        visible.append(c)\r\n\u001b[?2004l\r"]
[50.918486, "o", "\u001b[?2004h>       "]
[50.918539, "o", "        "]
[50.918595, "o", "elif has_flag(flag):\r\n\u001b[?2004l\r\u001b[?2004h>               "]
[50.918651, "o", "        "]
[50.918707, "o", "visible.append(c)\r\n\u001b[?2004l\r\u001b[?2004h>       "]
[50.918765, "o", "return visible\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[50.918829, "o", "\u001b[?2004h> "]
[50.918885, "o", "func _show_current() -> void:\r\n\u001b[?2004l\r"]
[50.918918, "o", "\u001b[?2004h>       "]
