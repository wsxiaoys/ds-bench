[43.568392, "o", "extends Node$\r\nclass_name DialogPlayer$\r\n$\r\n\\nsignal line_shown(speaker: String, text: String, choices_labels: Array)$\r\nsignal dialog_finished$\r\n$\r\n\\nxtortvar tree: DialogTree$\r\n$\r\nvar _flags: Dictionary = {}$\r\nvar _current_id: StringName = &\"\"$\r\n"]
[43.568418, "o", "var _active: bool = false$\r\n$\r\n\\nfunc start() -> void:$\r\n^IX_active = true$\r\n_current_id = tree.start_id$\r\n^I_show_current()$\r\n$\r\n\\nfunc advance(choice_index: int = -1) -> void:$\r\n^Iif not _active:$\r\n^I^Ireturn$\r\n^Ivar node: DialogNode = tree.get_node(_current_id)$\r\n^Iif node == null:$\r\n^I^Ireturn$\r\n^Ivar visible_choices: Array = _get_visible_choices(node)$\r\n^Iif visible_choices.size() > 0:$\r\n^I^Iif choice_index < 0 or choice_index >= visible_choices.size():$\r\n^I^I^Ireturn$\r\n"]
[43.568439, "o", "^I^I_urrent_id = visible_choices[choice_index].next_id$\r\n^Ielse:$\r\n^I^I_urrent_id = node.next_id$\r\n"]
