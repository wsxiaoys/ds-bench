[122.961946, "i", "cat > main.go << 'EOF'\npackage main\n\nimport (\n\t\"errors\"\n\t\"log\"\n\n\t\"github.com/pocketbase/pocketbase\"\n\t\"github.com/pocketbase/pocketbase/core\"\n\t\"github.com/pocketbase/pocketbase/plugins/migratecmd\"\n\n\t_ \"myproject/migrations\"\n)\n\nfunc main() {\n\tapp := pocketbase.New()\n\n\tmigratecmd.MustRegister(app, app.RootCmd, migratecmd.Config{\n\t\tAutomigrate: false,\n\t})\n\n\tapp.OnRecordCreateRequest(\"withdrawals\").BindFunc(func(e *core.RecordRequestEvent) error {\n\t\twalletId := e.Record.GetString(\"wallet\")\n\t\tamount := e.Record.GetFloat(\"amount\")\n\n\t\tif walletId == \"\" || amount <= 0 {\n\t\t\treturn e.BadRequestError(\"Invalid withdrawal payload\", nil)\n\t\t}\n\n\t\t// We need to look up the wallet to verify it exists and has enough balance.\n\t\t// We do this in a transaction so the debit and the withdrawal persist atomically.\n\t\treturn app.RunInTransaction(func(txApp core.App) error {\n\t\t\twallet, err := txApp.FindRecordById(\"wallets\", walletId)\n\t\t\tif err != nil {\n\t\t\t\treturn e.BadRequestError(\"Wallet not found\", nil)\n\t\t\t}\n\n\t\t\tbalance := wallet.GetFloat(\"balance\")\n\t\t\tif balance < amount {\n\t\t\t\treturn e.BadRequestError(\"Insufficient funds\", nil)\n\t\t\t}\n\n\t\t\twallet.Set(\"balance\", balance-amount)\n\t\t\tif err := txApp.Save(wallet); err != nil {\n\t\t\t\treturn err\n\t\t\t}\n\n\t\t\t// Repoint e.App at the transactional app so the default save chain\n\t\t\t// (triggered by e.Next()) runs inside the same transaction.\n\t\t\te.App = txApp\n\n\t\t\treturn e.Next()\n\t\t})\n\t})\n\n\tif err := app.Start(); err != nil {\n\t\tlog.Fatal(err)\n\t}\n}\n\nvar _ = errors.New\nEOF\n"]
