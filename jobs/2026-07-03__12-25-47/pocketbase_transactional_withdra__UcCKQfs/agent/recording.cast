[47.800247, "o", "/root/go/pkg/mod/github.com/pocketbase/pocketbase@v0.31.0/core/app.go:1004:\t// OnRecordCreate is a Record proxy model hook of [OnModelCreate].\r\n/root/go/pkg/mod/github.com/pocketbase/pocketbase@v0.31.0/core/app.go:1009:\tOnRecordCreate(tags ...string) *hook.TaggedHook[*RecordEvent]\r\n/root/go/pkg/mod/github.com/pocketbase/pocketbase@v0.31.0/core/app.go:1461:\t// OnRecordCreateRequest hook is triggered on each API Record create request.\r\n/root/go/pkg/mod/github.com/pocketbase/pocketbase@v0.31.0/core/app.go:1469:\tOnRecordCreateRequest(tags ...string) *hook.TaggedHook[*RecordRequestEvent]\r\n/root/go/pkg/mod/github.com/pocketbase/pocketbase@v0.31.0/core/base.go:890:func (app *BaseApp) OnRecordCreate(tags ...string) *hook.TaggedHook[*RecordEvent] {\r\n/root/go/pkg/mod/github.com/pocketbase/pocketbase@v0.31.0/core/base.go:1126:func (app *BaseApp) OnRecordCreateRequest(tags ...string) *hook.TaggedHook[*RecordRequestEvent] {\r\n/root/go/pkg/mod/github.com/pocketbase/pocketbase@v0.31.0/core/record_model.go:78:\t\t\t\terr := me.App.OnRecordCreate().Trigger(re, func(re *RecordEvent) error {\r\n/root/go/pkg/mod/github.com/pocketbase/pocketbase@v0.31.0/core/record_model.go:307:\tapp.OnRecordCreate().Bind(&hook.Handler[*RecordEvent]{\r\n/root/go/pkg/mod/github.com/pocketbase/pocketbase@v0.31.0/core/record_model_test.go:1883:\tapp.OnRecordCreate().Bind(recordEventHandler)\r\n"]
