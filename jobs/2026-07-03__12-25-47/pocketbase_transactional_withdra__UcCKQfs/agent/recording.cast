[240.51816, "o", "\u001b[0m\u001b[m├─ REST API:  \u001b[36mhttp://0.0.0.0:8090/api/\u001b[0m\r\n\u001b[0m\u001b[m"]
[240.518367, "o", "└─ Dashboard: \u001b[36mhttp://0.0.0.0:8090/_/\u001b[0m\r\n\u001b[0m"]
[240.581666, "o", "\u001b[35m\r\n(!) Launch the URL below in the browser if it hasn't been open already to create your first superuser account:\r\n"]
