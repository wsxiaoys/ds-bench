[115.989498, "o", "grep -n 'BadRequestError\\|ForbiddenError\\|NotFoundError' /root/go/pkg/mod/github.com/pocketbase/pocketbase@v0.31.0/tools/router/event.go | head -10\r\n\u001b[?2004l\r"]
[115.999797, "o", "21:var ErrUnsupportedContentType = NewBadRequestError(\"Unsupported Content-Type\", nil)\r\n23:var ErrFileNotFound = NewNotFoundError(\"File not found\", nil)\r\n298:func (e *Event) BadRequestError(message string, errData any) *ApiError {\r\n299:\treturn NewBadRequestError(message, errData)\r\n302:func (e *Event) NotFoundError(message string, errData any) *ApiError {\r\n303:\treturn NewNotFoundError(message, errData)\r\n306:func (e *Event) ForbiddenError(message string, errData any) *ApiError {\r\n307:\treturn NewForbiddenError(message, errData)\r\n"]
