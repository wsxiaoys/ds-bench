[183.499165, "o", "// custom response from within the wrapped transaction block.\r\nfunc execAfterSuccessTx(checkTx bool, app core.App, fn func() error) error {\r\n\tif txInfo := app.TxInfo(); txInfo != nil && checkTx {\r\n\t\ttxInfo.OnComplete(func(txErr error) error {\r\n"]
[183.499278, "o", "\t\t\tif txErr == nil {\r\n\t\t\t\treturn fn()\r\n\t\t\t}\r\n\t\t\treturn nil\r\n\t\t})\r\n\t\treturn nil\r\n\t}\r\n"]
[183.499361, "o", "\r\n\treturn fn()\r\n}\r\n\r\n// -------------------------------------------------------------------\r\n\r\nconst maxAuthOrigins = 5\r\n\r\nfunc authAlert(e *core.RequestEvent, authRecord *core.Record) error {\r\n"]
[183.499529, "o", "\t// generating fingerprint\r\n\t// ---\r\n\tuserAgent := e.Request.UserAgent()\r\n\tif len(userAgent) > 300 {\r\n\t\tuserAgent = userAgent[:300]\r\n\t}\r\n\tfingerprint := security.MD5(e.RealIP() + userAgent)\r\n\t// ---\r\n\r\n\torigins, err := e.App.FindAllAuthOriginsByRecord(authRecord)\r\n\tif err != nil {\r\n\t\treturn err\r\n\t}\r\n\r\n\tisFirstLogin := len(origins) == 0\r\n\r\n\tvar currentOrigin *core.AuthOrigin\r\n\tfor _, origin := range origins {\r\n\t\tif origin.Fingerprint() == fingerprint {\r\n\t\t\tcurrentOrigin = origin\r\n\t\t\tbreak\r\n\t\t}\r\n\t}\r\n\tif currentOrigin == nil {\r\n\t\tcurrentOrigin = core.NewAuthOrigin(e.App)\r\n\t\tcurrentOrigin.SetCollectionRef(authRecord.Collection().Id)\r\n\t\tcurrentOrigin.SetRecordRef(authRecord.Id)\r\n\t\tcurrentOrigin.SetFingerprint(fingerprint)\r\n\t}\r\n\r\n\t// send email alert for the new origin auth (skip first login)\r\n"]
[183.499997, "o", "\t//\r\n\t// Note: The \"fake\" timeout is a temp solution to avoid blocking\r\n"]
[183.500032, "o", "\t//       for too long when the SMTP server is not accessible, due\r\n\t//       to the lack of context cancellation support in the underlying\r\n"]
[183.50032, "o", "\u001b[?2004hroot@55045151-16e7-43aa-99ff-9ea571f30b2b:/home/user/myproject# "]
[193.91496, "i", "cat > main.go << 'MAINEOF'\npackage main\n\nimport (\n\t\"log\"\n\n\t\"github.com/pocketbase/pocketbase\"\n\t\"github.com/pocketbase/pocketbase/core\"\n\t\"github.com/pocketbase/pocketbase/plugins/migratecmd\"\n\n\t_ \"myproject/migrations\"\n)\n\nfunc main() {\n\tapp := pocketbase.New()\n\n\tmigratecmd.MustRegister(app, app.RootCmd, migratecmd.Config{\n\t\tAutomigrate: false,\n\t})\n\n\tapp.OnRecordCreateRequest(\"withdrawals\").BindFunc(func(e *core.RecordRequestEvent) error {\n\t\twalletId := e.Record.GetString(\"wallet\")\n\t\tamount := e.Record.GetFloat(\"amount\")\n\n\t\tif walletId == \"\" || amount <= 0 {\n\t\t\treturn e.BadRequestError(\"Invalid withdrawal payload\", nil)\n\t\t}\n\n\t\treturn app.RunInTransaction(func(txApp core.App) error {\n\t\t\twallet, err := txApp.FindRecordById(\"wallets\", walletId)\n\t\t\tif err != nil {\n\t\t\t\treturn e.BadRequestError(\"Wallet not found\", nil)\n\t\t\t}\n\n\t\t\tbalance := wallet.GetFloat(\"balance\")\n\t\t\tif balance < amount {\n\t\t\t\treturn e.BadRequestError(\"Insufficient funds\", nil)\n\t\t\t}\n\n\t\t\twallet.Set(\"balance\", balance-amount)\n\t\t\tif err := txApp.Save(wallet); err != nil {\n\t\t\t\treturn err\n\t\t\t}\n\n\t\t\t// Repoint e.App at the transactional app so the default save chain\n\t\t\t// (triggered by e.Next()) runs inside the same transaction.\n\t\t\te.App = txApp\n\n\t\t\treturn e.Next()\n\t\t})\n\t})\n\n\tif err := app.Start(); err != nil {\n\t\tlog.Fatal(err)\n\t}\n}\nMAINEOF\n"]
[193.915848, "o", "cat > main.go << 'MAINEOF'"]
