[117.917387, "i", "cd /home/user/myproject && python3 -c \"\nfrom apideck_unify import Apideck\nimport os\nclient = Apideck(api_key=os.environ['APIDECK_API_KEY'], app_id=os.environ['APIDECK_APP_ID'], consumer_id=os.environ['APIDECK_CONSUMER_ID'])\nres = client.issue_tracking.collection_tickets.list(collection_id=os.environ['APIDECK_ISSUE_TRACKING_COLLECTION_ID'], service_id='github', limit=2)\nprint('Type:', type(res).__name__)\nprint('Attrs:', [a for a in dir(res) if not a.startswith('_')])\nget_resp = res.get_tickets_response\nprint('Type of get_tickets_response:', type(get_resp).__name__)\nprint('data length:', len(get_resp.data or []))\nprint('first ticket id:', get_resp.data[0].id if get_resp.data else None)\nprint('first ticket subject:', get_resp.data[0].subject if get_resp.data else None)\nprint('meta:', get_resp.meta)\nprint('meta.cursors:', get_resp.meta.cursors if get_resp.meta else None)\nprint('has next:', hasattr(res, 'next') and res.next is not None)\n\"\n"]
