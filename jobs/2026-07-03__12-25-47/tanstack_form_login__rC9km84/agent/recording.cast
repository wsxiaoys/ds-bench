[456.194979, "o", "{\r\n  \"name\": \"login-form-project\",\r\n  \"private\": true,\r\n  \"version\": \"0.0.0\",\r\n  \"type\": \"module\",\r\n  \"scripts\": {\r\n    \"dev\": \"vite\",\r\n    \"build\": \"tsc && vite build\",\r\n    \"preview\": \"vite preview\"\r\n  },\r\n  \"dependencies\": {\r\n    \"@tanstack/react-form\": \"^1.0.0\",\r\n    \"react\": \"^18.3.1\",\r\n    \"react-dom\": \"^18.3.1\",\r\n    \"zod\": \"^3.23.8\"\r\n  },\r\n  \"devDependencies\": {\r\n    \"@types/react\": \"^18.3.3\",\r\n    \"@types/react-dom\": \"^18.3.0\",\r\n    \"@vitejs/plugin-react\": \"^4.3.1\",\r\n    \"typescript\": \"^5.5.3\",\r\n    \"vite\": \"^5.4.0\"\r\n  }\r\n}\r\n"]
