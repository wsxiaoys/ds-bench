[123.970187, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[123.970289, "o", "> "]
[123.970346, "o", "# 1) Upload 7 files\r\n\u001b[?2004l\r"]
[123.970459, "o", "\u001b[?2004h> "]
[123.970508, "o", "for i in range(1, 8):\r\n\u001b[?2004l\r"]
[123.97061, "o", "\u001b[?2004h> "]
[123.97072, "o", "    name = f'{PREFIX}{i}.txt'\r\n\u001b[?2004l\r"]
[123.970763, "o", "\u001b[?2004h> "]
[123.971041, "o", "    url = f'{UPLOAD_BASE}/file-storage/files'\r\n\u001b[?2004l\r"]
[123.971088, "o", "\u001b[?2004h> "]
[123.971187, "o", "    meta = {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[123.971323, "o", "        'name': name,\r\n\u001b[?2004l\r"]
[123.971363, "o", "\u001b[?2004h> "]
[123.971581, "o", "        'parent_folder_id': 'root',\r\n\u001b[?2004l\r"]
[123.971623, "o", "\u001b[?2004h> "]
[123.97171, "o", "    }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[123.97186, "o", "    headers = dict(HEADERS)\r\n\u001b[?2004l\r"]
[123.971908, "o", "\u001b[?2004h> "]
[123.972212, "o", "    headers['x-apideck-metadata'] = json.dumps(meta)\r\n\u001b[?2004l\r"]
[123.972255, "o", "\u001b[?2004h> "]
[123.972449, "o", "    log(f'Uploading {name}...')\r\n\u001b[?2004l\r"]
[123.972496, "o", "\u001b[?2004h> "]
[123.972629, "o", "    r = requests.post(\r\n\u001b[?2004l\r"]
[123.972679, "o", "\u001b[?2004h> "]
[123.972767, "o", "        url,\r\n\u001b[?2004l\r\u001b[?2004h"]
[123.972816, "o", "> "]
[123.972945, "o", "        headers=headers,\r\n\u001b[?2004l\r"]
[123.972994, "o", "\u001b[?2004h> "]
[123.973448, "o", "        files={'file': (name, f'file {i} content for {RUN_ID}\\n', 'text/plain')},\r\n\u001b[?2004l\r"]
[123.973497, "o", "\u001b[?2004h> "]
[123.973601, "o", "        timeout=60,\r\n\u001b[?2004l\r"]
[123.973653, "o", "\u001b[?2004h> "]
[123.973744, "o", "    )\r\n\u001b[?2004l\r\u001b[?2004h> "]
[123.974059, "o", "    log(f'  status={r.status_code} body={r.text[:300]}')\r\n\u001b[?2004l\r"]
[123.974111, "o", "\u001b[?2004h> "]
[123.974268, "o", "    if r.status_code >= 400:\r\n\u001b[?2004l\r"]
[123.974318, "o", "\u001b[?2004h> "]
[123.974566, "o", "        sys.exit(f'Upload of {name} failed')\r\n\u001b[?2004l\r"]
[123.974616, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[123.974663, "o", "\u001b[?2004h> "]
[123.974791, "o", "# 2) Cursor pagination\r\n\u001b[?2004l\r"]
[123.974844, "o", "\u001b[?2004h> "]
[123.974931, "o", "ids = []\r\n\u001b[?2004l\r\u001b[?2004h> "]
[123.975069, "o", "seen = set()\r\n\u001b[?2004l\r\u001b[?2004h> "]
[123.975156, "o", "cursor = None\r\n\u001b[?2004l\r\u001b[?2004h"]
[123.975206, "o", "> "]
[123.975322, "o", "page = 0\r\n\u001b[?2004l\r\u001b[?2004h> "]
[123.975372, "o", "while True:\r\n\u001b[?2004l\r\u001b[?2004h"]
[123.97542, "o", "> "]
[123.975567, "o", "    page += 1\r\n\u001b[?2004l\r\u001b[?2004h> "]
[123.975682, "o", "    params = {'limit': 3}\r\n\u001b[?2004l\r"]
[123.975731, "o", "\u001b[?2004h> "]
[123.975846, "o", "    if cursor:\r\n\u001b[?2004l\r\u001b[?2004h"]
[123.975926, "o", "> "]
[123.976069, "o", "        params['cursor'] = cursor\r\n\u001b[?2004l\r"]
[123.976119, "o", "\u001b[?2004h> "]
[123.976364, "o", "    url = f'{UNIFY_BASE}/file-storage/files'\r\n\u001b[?2004l\r"]
[123.976415, "o", "\u001b[?2004h> "]
[123.976676, "o", "    log(f'Listing page {page} cursor={cursor}')\r\n\u001b[?2004l\r"]
[123.976728, "o", "\u001b[?2004h> "]
[123.976956, "o", "    r = requests.get(url, headers=HEADERS, params=params, timeout=60)\r\n\u001b[?2004l\r\u001b[?2004h"]
[123.977007, "o", "> "]
[123.977119, "o", "    log(f'  status={r.status_code}')\r\n\u001b[?2004l\r\u001b[?2004h> "]
[123.977212, "o", "    if r.status_code >= 400:\r\n\u001b[?2004l\r\u001b[?2004h"]
[123.977265, "o", "> "]
[123.977378, "o", "        log(f'  body={r.text[:500]}')\r\n\u001b[?2004l\r\u001b[?2004h> "]
[123.97749, "o", "        sys.exit('List failed')\r\n\u001b[?2004l\r\u001b[?2004h"]
[123.977584, "o", "> "]
[123.977629, "o", "    data = r.json()\r\n\u001b[?2004l\r\u001b[?2004h> "]
[123.977706, "o", "    files = data.get('data', [])\r\n\u001b[?2004l\r\u001b[?2004h"]
[123.977821, "o", ">     for f in files:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[123.977941, "o", "        name = f.get('name') or ''\r\n\u001b[?2004l\r\u001b[?2004h"]
[123.977995, "o", "> "]
[123.978114, "o", "        fid = f.get('id')\r\n\u001b[?2004l\r\u001b[?2004h> "]
[123.978282, "o", "        if name.startswith(PREFIX) and fid and fid not in seen:\r\n\u001b[?2004l\r\u001b[?2004h"]
[123.978333, "o", "> "]
[123.978451, "o", "            seen.add(fid)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[123.978535, "o", "            ids.append(fid)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[123.978662, "o", "    meta = data.get('meta', {}) or {}\r\n\u001b[?2004l\r\u001b[?2004h"]
[123.978711, "o", "> "]
[123.978835, "o", "    cursors = meta.get('cursors', {}) or {}\r\n\u001b[?2004l\r\u001b[?2004h"]
[123.978887, "o", "> "]
[123.978998, "o", "    cursor = cursors.get('next') or ''\r\n\u001b[?2004l\r\u001b[?2004h"]
[123.979049, "o", "> "]
[123.97926, "o", "    log(f'  found {len(files)} files on page, next cursor={cursor!r}')\r\n\u001b[?2004l\r\u001b[?2004h"]
[123.979311, "o", "> "]
[123.979438, "o", "    if not cursor:\r\n\u001b[?2004l\r\u001b[?2004h>         break\r\n\u001b[?2004l\r\u001b[?2004h> "]
[123.979488, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[123.979606, "o", "summary = {\r\n\u001b[?2004l\r\u001b[?2004h>     'count': len(ids),\r\n\u001b[?2004l\r"]
[123.979656, "o", "\u001b[?2004h> "]
[123.979704, "o", "    'ids': ids,\r\n\u001b[?2004l\r\u001b[?2004h> }\r\n\u001b[?2004l\r"]
[123.979851, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> with open(OUTPUT_LOG, 'w') as f:\r\n\u001b[?2004l\r"]
[123.979912, "o", "\u001b[?2004h> "]
[123.98003, "o", "    f.write(json.dumps(summary))\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[123.980124, "o", "log(f'Wrote summary: {summary}')\r\n\u001b[?2004l\r\u001b[?2004h"]
[123.980175, "o", "> PYEOF\r\n\u001b[?2004l\r"]
[123.981474, "o", "\u001b[?2004hroot@6f42bb31-f73d-4608-b019-085500e288e0:/home/user/apideck_task# "]
[124.498861, "i", "cat /home/user/apideck_task/solution.py | head -20\n"]
[124.49951, "o", "cat /home/user/apideck_task/solution.py | head -20\r\n\u001b[?2004l\r"]
[124.501769, "o", "#!/usr/bin/env python3\r\nimport os\r\nimport json\r\nimport requests\r\nimport sys\r\n\r\nAPP_ID = os.environ['APIDECK_APP_ID']\r\n"]
[124.501799, "o", "API_KEY = os.environ['APIDECK_API_KEY']\r\nCONSUMER_ID = os.environ['APIDECK_CONSUMER_ID']\r\nDRIVE_NAME = os.environ['APIDECK_FILE_STORAGE_DRIVE_NAME']\r\nSERVICE_ID = 'onedrive'\r\n\r\nwith open('/logs/artifacts/run-id', 'r') as f:\r\n    RUN_ID = f.read().strip()\r\n\r\n"]
[124.501885, "o", "PREFIX = f'AGG-{RUN_ID}-'\r\nUPLOAD_BASE = 'https://upload.apideck.com'\r\nUNIFY_BASE = 'https://unify.apideck.com'\r\n\r\nOUTPUT_LOG = '/home/user/apideck_task/output.log'\r\n"]
[124.502245, "o", "\u001b[?2004h"]
[124.502279, "o", "root@6f42bb31-f73d-4608-b019-085500e288e0:/home/user/apideck_task# "]
[128.234272, "i", "cd /home/user/apideck_task && python3 solution.py 2>&1 | tail -60\n"]
[128.234595, "o", "cd /home/user/apideck_task && python3 solution.py 2>&1 | tail -60\r\n\u001b[?2004l\r"]
