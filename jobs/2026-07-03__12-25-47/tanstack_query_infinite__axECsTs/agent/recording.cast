[142.237372, "o", "\r\n> myproject@0.0.0 dev\r\n> vite\r\n\r\n\r\n  VITE v8.1.3  ready in 180 ms\r\n\r\n  ➜  Local:   http://localhost:5123/\r\n  ➜  Network: http://172.20.0.3:5123/\r\n  ➜  press h + enter to show help\r\n"]
