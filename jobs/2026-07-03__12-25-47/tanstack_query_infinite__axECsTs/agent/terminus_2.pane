[?2004l[?2004h> // Simulated latency for the mock API
[?2004l[?2004h> const delay = (ms: number) => new Promise((resolve) => setTimeout(resolve, ms))
[?2004l[?2004h> 
[?2004l[?2004h> // Total number of items in our feed
[?2004l[?2004h> const TOTAL_ITEMS = 25
[?2004l[?2004h> const PAGE_SIZE = 5
[?2004l[?2004h> 
[?2004l[?2004h> export async function fetchFeedPage(cursor: number = 0): Promise<FeedPage> {
[?2004l[?2004h>   await delay(300)
[?2004l[?2004h> 
[?2004l[?2004h>   const start = cursor
[?2004l[?2004h>   const end = Math.min(start + PAGE_SIZE, TOTAL_ITEMS)
[?2004l[?2004h>   const items: FeedItem[] = []
[?2004l[?2004h> 
[?2004l[?2004h>   for (let i = start; i < end; i++) {
[?2004l[?2004h>     items.push({
[?2004l[?2004h>       id: i + 1,
[?2004l[?2004h>       title: `Post #${i + 1}`,
[?2004l[?2004h>       body: `This is the body of post number ${i + 1}. It's an interesting piece of content.`,
[?2004l[?2004h>     })
[?2004l[?2004h>   }
[?2004l[?2004h> 
[?2004l[?2004h>   const nextCursor = end < TOTAL_ITEMS ? end : null
[?2004l[?2004h> 
[?2004l[?2004h>   return {
[?2004l[?2004h>     items,
[?2004l[?2004h>     nextCursor,
[?2004l[?2004h>   }
[?2004l[?2004h> }
