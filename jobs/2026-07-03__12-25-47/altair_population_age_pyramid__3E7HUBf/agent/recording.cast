[51.530668, "o", "cat /home/user/myproject/pyramid_spec.json\r\n\u001b[?2004l\r"]
[51.531596, "o", "{\r\n  \"config\": {\r\n    \"view\": {\r\n      \"continuousWidth\": 300,\r\n      \"continuousHeight\": 300\r\n    }\r\n  },\r\n  \"data\": {\r\n    \"url\": \"https://cdn.jsdelivr.net/npm/vega-datasets@v3.2.1/data/population.json\"\r\n  },\r\n  \"mark\": {\r\n    \"type\": \"bar\"\r\n  },\r\n  \"encoding\": {\r\n    \"color\": {\r\n      \"field\": \"sex\",\r\n      \"legend\": {\r\n        \"labelExpr\": \"datum.value === 1 ? 'Male' : 'Female'\"\r\n      },\r\n      \"scale\": {\r\n        \"domain\": [\r\n          1,\r\n          2\r\n        ],\r\n        \"range\": [\r\n          \"#4682B4\",\r\n          \"#FA8072\"\r\n        ]\r\n      },\r\n      \"title\": \"Sex\",\r\n      \"type\": \"nominal\"\r\n    },\r\n    \"x\": {\r\n      \"axis\": {\r\n        \"format\": \"s\",\r\n        \"labelExpr\": \"abs(datum.value)\"\r\n      },\r\n      \"field\": \"signed\",\r\n      \"stack\": null,\r\n      \"title\": \"Population\",\r\n      \"type\": \"quantitative\"\r\n    },\r\n    \"y\": {\r\n      \"field\": \"age\",\r\n      \"sort\": \"-y\",\r\n      \"title\": \"Age\",\r\n      \"type\": \"ordinal\"\r\n    }\r\n  },\r\n  \"height\": 320,\r\n  \"params\": [\r\n    {\r\n      \"name\": \"year\",\r\n      \"bind\": {\r\n        \"input\": \"select\",\r\n        \"options\": [\r\n          1850,\r\n          1860,"]
[51.53165, "o", "\r\n          1870,\r\n          1880,\r\n          1890,\r\n          1900,\r\n          1910,\r\n          1920,\r\n          1930,\r\n          1940,\r\n          1950,\r\n          1960,\r\n          1970,\r\n          1980,\r\n          1990,\r\n          2000\r\n        ],\r\n        \"name\": \"Census year \"\r\n      },\r\n      \"value\": 1980\r\n    }\r\n  ],\r\n  \"title\": \"US Population Age Pyramid\",\r\n  \"transform\": [\r\n    {\r\n      \"filter\": \"datum.year === year\"\r\n    },\r\n    {\r\n      \"calculate\": \"datum.sex === 1 ? -datum.people : datum.people\",\r\n      \"as\": \"signed\"\r\n    }\r\n  ],\r\n  \"width\": 420,\r\n  \"$schema\": \"https://vega.github.io/schema/vega-lite/v6.4.1.json\"\r\n}"]
[51.531797, "o", "\u001b[?2004hroot@66b3cca0-49f8-4730-8603-1db714a00a67:/home/user/myproject# "]
