{
  "config": {
    "view": {
      "continuousWidth": 300,
      "continuousHeight": 300
    }
  },
  "data": {
    "url": "https://cdn.jsdelivr.net/npm/vega-datasets@v3.2.1/data/population.json"
  },
  "mark": {
    "type": "bar"
  },
  "encoding": {
    "color": {
      "field": "sex",
      "legend": {
        "labelExpr": "datum.value === 1 ? 'Male' : 'Female'"
      },
      "scale": {
        "domain": [
          1,
          2
        ],
        "range": [
          "#4682B4",
          "#FA8072"
        ]
      },
      "title": "Sex",
      "type": "nominal"
    },
    "x": {
      "axis": {
        "format": "s",
        "labelExpr": "abs(datum.value)"
      },
      "field": "signed",
      "stack": null,
      "title": "Population",
      "type": "quantitative"
    },
    "y": {
      "field": "age",
      "sort": "-y",
      "title": "Age",
      "type": "ordinal"
    }
  },
  "height": 320,
  "params": [
    {
      "name": "year",
      "bind": {
        "input": "select",
        "options": [
          1850,
          1860,
          1870,
          1880,
          1890,
          1900,
          1910,
          1920,
          1930,
          1940,
          1950,
          1960,
          1970,
          1980,
          1990,
          2000
        ],
        "name": "Census year "
      },
      "value": 1980
    }
  ],
  "title": "US Population Age Pyramid",
  "transform": [
    {
      "filter": "datum.year === year"
    },
    {
      "calculate": "datum.sex === 1 ? -datum.people : datum.people",
      "as": "signed"
    }
  ],
  "width": 420,
  "$schema": "https://vega.github.io/schema/vega-lite/v6.4.1.json"
}