[?2004l[?2004h>     const raw = await readStdin();
[?2004l[?2004h>     const parsed = JSON.parse(raw) as { params?: unknown };
[?2004l[?2004h>     const params = parsed?.params;
[?2004l[?2004h>     const result = await fetchWithTimeout(params as Parameters<typeof fetchWithTimeout>[0]);
[?2004l[?2004h>     console.log('OK ' + JSON.stringify(result));
[?2004l[?2004h>   } catch (err) {
[?2004l[?2004h>     const msg = err instanceof Error ? err.message : String(err);
[?2004l[?2004h>     console.log('ERR ' + (msg || 'validation failed'));
[?2004l[?2004h>   }
[?2004l[?2004h> }
