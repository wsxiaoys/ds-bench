[?2004l[?2004h>   const chunks: Buffer[] = [];
[?2004l[?2004h>   for await (const chunk of process.stdin) {
[?2004l[?2004h>     chunks.push(typeof chunk === 'string' ? Buffer.from(chunk) : chunk);
[?2004l[?2004h>   }
[?2004l[?2004h>   return Buffer.concat(chunks).toString('utf8');
[?2004l[?2004h> }
