[124.803197, "i", "cat > /home/user/myproject/test_ark4.mjs << 'EOF'\nimport { type } from 'arktype';\n\n// Try a morph that awaits and validates\nconst innerSchema = type({ status: '100 <= number <= 599', body: 'string' });\n\nconst promiseSchema = type('Promise').pipe(async (p) => {\n  const v = await p;\n  const validated = innerSchema(v);\n  if (validated instanceof Error) throw validated;\n  return validated;\n});\n\nconsole.log('promiseSchema:', promiseSchema.expression);\n\n// Now test with type.fn\nconst paramsType = type({ url: 'string.url', timeoutMs: '0 < number <= 10000', retries: '0 <= number <= 5' });\n\nconst fetchWithTimeout = type.fn(\n  paramsType,\n  ':',\n  promiseSchema,\n)(async (params) => {\n  await new Promise(r => setTimeout(r, 10));\n  return { status: 200, body: 'ok' };\n});\n\ntry {\n  const result = await fetchWithTimeout({ url: 'https://example.com', timeoutMs: 100, retries: 3 });\n  console.log('success:', result);\n} catch (e) {\n  console.log('error:', e.message);\n}\nEOF\ncd /home/user/myproject && node test_ark4.mjs\n"]
