[169.259618, "i", "cat > /home/user/myproject/test_ark7.mjs << 'EOF'\nimport { type } from 'arktype';\n\nconst paramsType = type({ url: 'string.url', timeoutMs: '0 < number <= 10000', retries: '0 <= number <= 5' });\nconst innerSchema = type({ status: '100 <= number <= 599', body: 'string' });\n\n// Approach: morph takes Promise, validates resolved value internally, returns the Promise\nconst promiseSchema = type('Promise').pipe((p) => {\n  // Need to validate the resolved value\n  // We can't await here in a sync pipe, but we can attach a then handler\n  return p.then((v) => {\n    const validated = innerSchema(v);\n    if (validated instanceof Error) throw validated;\n    return validated;\n  });\n});\n\nconsole.log('expression:', promiseSchema.expression);\n\nconst fetchWithTimeout = type.fn(\n  paramsType,\n  ':',\n  promiseSchema,\n)(async (params) => {\n  await new Promise(r => setTimeout(r, 10));\n  return { status: 200, body: 'ok' };\n});\n\ntry {\n  const result = await fetchWithTimeout({ url: 'https://example.com', timeoutMs: 100, retries: 3 });\n  console.log('success:', result);\n} catch (e) {\n  console.log('error:', e.message);\n}\n\n// test invalid\ntry {\n  const result = await fetchWithTimeout({ url: 'not a url', timeoutMs: 100, retries: 3 });\n  console.log('unexpected success:', result);\n} catch (e) {\n  console.log('expected error:', e.message);\n}\nEOF\ncd /home/user/myproject && node test_ark7.mjs\n"]
