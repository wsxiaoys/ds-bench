[43.60791, "i", "cat > build.gradle << 'EOF'\nplugins {\n    id 'application'\n    id 'java'\n}\n\ngroup = 'com.example'\nversion = '1.0.0'\n\nrepositories {\n    mavenCentral()\n}\n\njava {\n    toolchain {\n        languageVersion = JavaLanguageVersion.of(17)\n    }\n}\n\ndependencies {\n    implementation 'com.badlogicgames.gdx:gdx:1.14.2'\n    implementation 'com.badlogicgames.gdx:gdx-platform:1.14.2:natives-desktop'\n    implementation 'com.badlogicgames.gdx:gdx-backend-headless:1.14.2'\n}\n\napplication {\n    mainClass = 'com.example.stagesim.Main'\n    applicationDefaultJvmArgs = ['-Djava.awt.headless=true']\n}\n\ntasks.named('jar') {\n    manifest {\n        attributes 'Main-Class': 'com.example.stagesim.Main'\n    }\n}\nEOF\n"]
