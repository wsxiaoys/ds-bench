[580.371351, "o", "\u001b[?2004h> "]
[580.371971, "o", "            // Field name may differ across versions; fall back to a timed wait.\r\n\u001b[?2004l\r"]
[580.372023, "o", "\u001b[?2004h> "]
[580.372541, "o", "            long deadline = System.currentTimeMillis() + 60_000L;\r\n\u001b[?2004l\r"]
[580.372593, "o", "\u001b[?2004h> "]
[580.373068, "o", "            while (System.currentTimeMillis() < deadline) {\r\n\u001b[?2004l\r"]
[580.37312, "o", "\u001b[?2004h> "]
