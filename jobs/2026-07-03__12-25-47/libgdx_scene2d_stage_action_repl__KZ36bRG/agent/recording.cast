[580.415771, "o", "\u001b[?2004h>             }\r\n\u001b[?2004l\r\u001b[?2004h>             for (Actor a : actors.values()) {\r\n\u001b[?2004l\r\u001b[?2004h>                 a.act(dt);\r\n\u001b[?2004l\r\u001b[?2004h>             }\r\n\u001b[?2004l\r\u001b[?2004h>             ticksRemaining--;\r\n\u001b[?2004l\r\u001b[?2004h>             if (ticksRemaining <= 0) {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[580.415858, "o", "                Gdx.app.exit();\r\n\u001b[?2004l\r"]
[580.41593, "o", "\u001b[?2004h> "]
[580.415986, "o", "            }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[580.41603, "o", "        }\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[580.416064, "o", "> "]
[580.41612, "o", "        @Override\r\n\u001b[?2004l\r\u001b[?2004h"]
[580.416148, "o", "> "]
[580.416225, "o", "        public void dispose() {\r\n\u001b[?2004l\r"]
[580.416249, "o", "\u001b[?2004h> "]
[580.416487, "o", "            // Write the output file from dispose() so it is guaranteed to run\r\n\u001b[?2004l\r"]
[580.416649, "o", "\u001b[?2004h>             // before the JVM exits.\r\n\u001b[?2004l\r\u001b[?2004h> "]
[580.416788, "o", "            try (BufferedWriter bw = new BufferedWriter(\r\n\u001b[?2004l\r\u001b[?2004h"]
[580.416815, "o", "> "]
[580.417018, "o", "                    new PrintWriter(new FileWriter(outputPath, false)))) {\r\n\u001b[?2004l\r"]
[580.417041, "o", "\u001b[?2004h> "]
[580.417265, "o", "                for (Map.Entry<String, Actor> e : actors.entrySet()) {\r\n\u001b[?2004l\r\u001b[?2004h"]
[580.417291, "o", "> "]
[580.417408, "o", "                    Actor a = e.getValue();\r\n\u001b[?2004l\r"]
[580.417431, "o", "\u001b[?2004h> "]
[580.417551, "o", "                    float x = a.getX();\r\n\u001b[?2004l\r\u001b[?2004h"]
[580.417577, "o", "> "]
[580.417687, "o", "                    float y = a.getY();\r\n\u001b[?2004l\r\u001b[?2004h"]
[580.417709, "o", "> "]
[580.417973, "o", "                    String line = e.getKey() + \"=\" + String.format(Locale.ROOT, \"%.6f,%.6f\", x, y);\r\n\u001b[?2004l\r\u001b[?2004h"]
[580.418035, "o", "> "]
[580.418139, "o", "                    bw.write(line);\r\n\u001b[?2004l\r\u001b[?2004h> "]
[580.418227, "o", "                    bw.write(\"\\n\");\r\n\u001b[?2004l\r"]
[580.418255, "o", "\u001b[?2004h> "]
[580.418326, "o", "                }\r\n\u001b[?2004l\r\u001b[?2004h"]
[580.418359, "o", "> "]
[580.418451, "o", "                bw.flush();\r\n\u001b[?2004l\r\u001b[?2004h> "]
[580.418571, "o", "            } catch (IOException ex) {\r\n\u001b[?2004l\r"]
[580.419179, "o", "\u001b[?2004h>                 throw new RuntimeException(\"failed to write output\", ex);\r\n\u001b[?2004l\r\u001b[?2004h>             }\r\n\u001b[?2004l\r\u001b[?2004h>             wroteOutput = true;\r\n\u001b[?2004l\r\u001b[?2004h>         }\r\n\u001b[?2004l\r\u001b[?2004h>     }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[580.419209, "o", "}\r\n\u001b[?2004l\r"]
[580.419245, "o", "\u001b[?2004h> "]
