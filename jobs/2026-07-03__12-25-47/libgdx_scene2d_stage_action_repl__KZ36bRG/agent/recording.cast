[580.376492, "o", "\u001b[?2004h> "]
[580.377016, "o", "                    // can't tell, just sleep until deadline\r\n\u001b[?2004l\r"]
[580.377095, "o", "\u001b[?2004h> "]
[580.377265, "o", "                }\r\n\u001b[?2004l\r"]
[580.377343, "o", "\u001b[?2004h> "]
[580.378111, "o", "                if (!((SimulationListener) app.getApplicationListener()).outputWritten()) {\r\n\u001b[?2004l\r\u001b[?2004h"]
[580.378199, "o", "> "]
