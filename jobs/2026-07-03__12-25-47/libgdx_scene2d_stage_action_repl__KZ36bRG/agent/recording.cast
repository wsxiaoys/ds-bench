[580.367386, "o", "        // after which it invokes pause()+dispose() on the listener. To\r\n\u001b[?2004l\r"]
[580.367457, "o", "\u001b[?2004h> "]
[580.367993, "o", "        // guarantee the output file is flushed before the JVM exits, we\r\n\u001b[?2004l\r"]
[580.368067, "o", "\u001b[?2004h> "]
[580.368576, "o", "        // join() the main loop thread (dispose() writes the file).\r\n\u001b[?2004l\r"]
[580.368641, "o", "\u001b[?2004h> "]
[580.368745, "o", "        try {\r\n\u001b[?2004l\r"]
[580.368799, "o", "\u001b[?2004h> "]
