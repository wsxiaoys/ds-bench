[6.244083, "o", "cat /home/user/project/server.ts\r\n\u001b[?2004l\r"]
[6.245673, "o", "import { initTRPC, TRPCError } from '@trpc/server';\r\nimport { createHTTPServer } from '@trpc/server/adapters/standalone';\r\n\r\n// 1. Implement createContext\r\nexport function createContext({ req, res }: any) {\r\n  // TODO: parse authorization header and return user object or null\r\n  return { user: null };\r\n}\r\n\r\ntype Context = Awaited<ReturnType<typeof createContext>>;\r\n\r\nconst t = initTRPC.context<Context>().create();\r\n\r\n// 2. Create isAuthed middleware\r\nconst isAuthed = t.middleware(({ next, ctx }) => {\r\n  // TODO: check ctx.user, throw TRPCError if not found\r\n  return next({\r\n    ctx: {\r\n      user: ctx.user,\r\n    },\r\n  });\r\n});\r\n\r\n// 3. Create protectedProcedure\r\nconst protectedProcedure = t.procedure; // TODO: use isAuthed middleware\r\n\r\n// 4. Create router\r\nexport const appRouter = t.router({\r\n  // TODO: implement secretData query using protectedProcedure\r\n});\r\n\r\nexport type AppRouter = typeof appRouter;\r\n\r\n// Start server\r\ncreateHTTPServer({\r\n  router: appRouter,\r\n  createContext,\r\n}).listen(3000);\r\n\r\nconsole.log('Server listening on http://localhost:3000');\r\n"]
[6.246036, "o", "\u001b[?2004hroot@d04578c8-7a7d-45ac-9bb7-f818baf056fa:~# "]
[6.586091, "i", "cat /home/user/project/package.json\n"]
[6.586615, "o", "cat /home/user/project/package.json\r\n\u001b[?2004l\r"]
[6.588446, "o", "{\r\n  \"name\": \"trpc-auth-middleware\",\r\n  \"version\": \"1.0.0\",\r\n  \"scripts\": {\r\n    \"start\": \"tsx server.ts\"\r\n  },\r\n  \"dependencies\": {\r\n    \"@trpc/server\": \"next\",\r\n    \"zod\": \"^3.22.4\"\r\n  },\r\n  \"devDependencies\": {\r\n    \"tsx\": \"^4.7.1\",\r\n    \"typescript\": \"^5.3.3\",\r\n    \"@types/node\": \"^20.11.24\"\r\n  }\r\n}\r\n"]
[6.588813, "o", "\u001b[?2004hroot@d04578c8-7a7d-45ac-9bb7-f818baf056fa:~# "]
[14.46534, "i", "cat > /home/user/project/server.ts << 'EOF'\nimport { initTRPC, TRPCError } from '@trpc/server';\nimport { createHTTPServer } from '@trpc/server/adapters/standalone';\n\n// 1. Implement createContext\nexport function createContext({ req, res }: any) {\n  const authHeader = req.headers.authorization;\n  if (authHeader === 'Bearer mysecrettoken') {\n    return { user: { id: 1, name: 'Admin' } };\n  }\n  return { user: null };\n}\n\ntype Context = Awaited<ReturnType<typeof createContext>>;\n\nconst t = initTRPC.context<Context>().create();\n\n// 2. Create isAuthed middleware\nconst isAuthed = t.middleware(({ next, ctx }) => {\n  if (!ctx.user) {\n    throw new TRPCError({ code: 'UNAUTHORIZED' });\n  }\n  return next({\n    ctx: {\n      user: ctx.user,\n    },\n  });\n});\n\n// 3. Create protectedProcedure\nconst protectedProcedure = t.procedure.use(isAuthed);\n\n// 4. Create router\nexport const appRouter = t.router({\n  secretData: protectedProcedure.query(() => {\n    return { secret: 'super secret' };\n  }),\n});\n\nexport type AppRouter = typeof appRouter;\n\n// Start server\ncreateHTTPServer({\n  router: appRouter,\n  createContext,\n}).listen(3000);\n\nconsole.log('Server listening on http://localhost:3000');\nEOF\n"]
