[215.018359, "o", "{\r\n  \"name\": \"@alchemystai/aisdk\",\r\n  \"description\": \"The Vercel AI SDK Integration for Alchemyst AI.\",\r\n  \"version\": \"0.0.5\",\r\n  \"module\": \"index.ts\",\r\n  \"type\": \"module\",\r\n  \"repository\": {\r\n    \"url\": \"https://github.com/alchemyst-ai/aisdk.git\"\r\n  },\r\n  \"keywords\": [\r\n    \"genai\",\r\n    \"context engineering\",\r\n    \"rag\",\r\n    \"context\",\r\n    \"vercel\",\r\n    \"ai-sdk\",\r\n    \"aisdk\"\r\n  ],\r\n  \"devDependencies\": {\r\n    \"@types/bun\": \"latest\",\r\n    \"ai\": \"^6.0.79\"\r\n  },\r\n  \"peerDependencies\": {\r\n    \"ai\": \"^5.0.0 || ^6.0.0\",\r\n    \"typescript\": \"^5\"\r\n  },\r\n  \"dependencies\": {\r\n    \"@ai-sdk/google\": \"^3.0.8\",\r\n    \"@ai-sdk/openai\": \"^3.0.26\",\r\n    \"@alchemystai/sdk\": \"^0.11.1\",\r\n    \"@types/jest\": \"^30.0.0\",\r\n    \"biome\": \"^0.3.3\",\r\n    \"dotenv\": \"^17.2.3\",\r\n    \"jest\": \"^30.2.0\",\r\n    \"latest\": \"^0.2.0\",\r\n    \"zod\": \"^3.23.8\"\r\n  }\r\n}"]
