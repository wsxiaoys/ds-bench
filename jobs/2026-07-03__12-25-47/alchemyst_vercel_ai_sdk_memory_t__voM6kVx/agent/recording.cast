[178.724371, "o", "\u001b[0K\u001b[1mnpm\u001b[22m \u001b[33mwarn\u001b[39m While resolving: vercel-ai-memory@1.0.0\r\n\u001b[1mnpm\u001b[22m \u001b[33mwarn\u001b[39m Found: typescript@5.9.3\u001b[2m\u001b[22m\r\n\u001b[1mnpm\u001b[22m \u001b[33mwarn\u001b[39m \u001b[2mnode_modules/typescript\u001b[22m\r\n\u001b[1mnpm\u001b[22m \u001b[33mwarn\u001b[39m   \u001b[95mpeer\u001b[39m typescript@\"^5\" from @alchemystai/aisdk@0.0.5\u001b[2m\u001b[22m\r\n\u001b[1mnpm\u001b[22m \u001b[33mwarn\u001b[39m   \u001b[2mnode_modules/@alchemystai/aisdk\u001b[22m\r\n\u001b[1mnpm\u001b[22m \u001b[33mwarn\u001b[39m     @alchemystai/aisdk@\"0.0.5\" from the root project\r\n\u001b[1mnpm\u001b[22m \u001b[33mwarn\u001b[39m   1 more (the root project)\r\n\u001b[1mnpm\u001b[22m \u001b[33mwarn\u001b[39m\r\n\u001b[1mnpm\u001b[22m \u001b[33mwarn\u001b[39m Could not resolve dependency:\r\n\u001b[1mnpm\u001b[22m \u001b[33mwarn\u001b[39m \u001b[95mpeer\u001b[39m typescript@\"^5\" from @alchemystai/aisdk@0.0.5\u001b[2m\u001b[22m\r\n\u001b[1mnpm\u001b[22m \u001b[33mwarn\u001b[39m \u001b[2mnode_modules/@alchemystai/aisdk\u001b[22m\r\n\u001b[1mnpm\u001b[22m \u001b[33mwarn\u001b[39m   @alchemystai/aisdk@\"0.0.5\" from the root project\r\n⠸"]
