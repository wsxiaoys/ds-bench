[460.718582, "i", "cd /home/user/vercel-ai-memory && cat > package.json <<'EOF'\n{\n  \"name\": \"vercel-ai-memory\",\n  \"version\": \"1.0.0\",\n  \"description\": \"Cross-Session Memory CLI using Vercel AI SDK with Alchemyst middleware\",\n  \"type\": \"module\",\n  \"main\": \"dist/main.js\",\n  \"scripts\": {\n    \"build\": \"esbuild src/main.ts --bundle --platform=node --target=node22 --format=esm --outfile=dist/main.js --external:ai --external:@ai-sdk/openai --external:@alchemystai/sdk --external:zod --banner:js='//# sourceURL=vercel-ai-memory/dist/main.js'\"\n  },\n  \"keywords\": [],\n  \"author\": \"\",\n  \"license\": \"ISC\",\n  \"dependencies\": {\n    \"@ai-sdk/openai\": \"^4.0.7\",\n    \"@alchemystai/aisdk\": \"0.0.5\",\n    \"ai\": \"^6.0.0\"\n  },\n  \"devDependencies\": {\n    \"@types/node\": \"^22.0.0\",\n    \"esbuild\": \"^0.28.1\",\n    \"typescript\": \"^5.6.0\"\n  }\n}\nEOF\n"]
