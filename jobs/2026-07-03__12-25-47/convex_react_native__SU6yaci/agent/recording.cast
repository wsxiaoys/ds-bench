[150.545136, "o", "\u001b[1G\u001b[0K\r\n10 \u001b[33m\u001b[1mmoderate\u001b[22m\u001b[39m severity vulnerabilities\r\n\r\nTo address issues that do not require attention, run:\r\n  npm audit fix\r\n\r\nTo address all issues (including breaking changes), run:\r\n  npm audit fix --force\r\n\r\nRun `npm audit` for details.\r\n⠴"]
[150.545783, "o", "\u001b[1G\u001b[0K\u001b[1mnpm\u001b[22m \u001b[33mwarn\u001b[39m \u001b[94mallow-scripts\u001b[39m 1 package has install scripts not yet covered by allowScripts:\r\n\u001b[1mnpm\u001b[22m \u001b[33mwarn\u001b[39m \u001b[94mallow-scripts\u001b[39m   esbuild@0.27.0 (postinstall: node install.js)\r\n\u001b[1mnpm\u001b[22m \u001b[33mwarn\u001b[39m \u001b[94mallow-scripts\u001b[39m\r\n\u001b[1mnpm\u001b[22m \u001b[33mwarn\u001b[39m \u001b[94mallow-scripts\u001b[39m Run `npm approve-scripts --allow-scripts-pending` to review, or `npm approve-scripts <pkg>` to allow.\r\n⠴"]
