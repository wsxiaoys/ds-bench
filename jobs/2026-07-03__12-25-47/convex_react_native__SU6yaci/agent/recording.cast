[120.725883, "o", "⠧\u001b[1G\u001b[0K\r\n⠧\u001b[1G\u001b[0K42 packages are looking for funding\r\n⠧\u001b[1G\u001b[0K  run `npm fund` for details\r\n"]
[120.725964, "o", "⠧"]
[120.754718, "o", "\u001b[1G\u001b[0K\r\n10 \u001b[33m\u001b[1mmoderate\u001b[22m\u001b[39m severity vulnerabilities\r\n\r\nTo address issues that do not require attention, run:\r\n  npm audit fix\r\n\r\nTo address all issues (including breaking changes), run:\r\n  npm audit fix --force\r\n\r\nRun `npm audit` for details.\r\n⠧"]
[120.755819, "o", "\u001b[1G\u001b[0K"]
[120.835699, "o", "\r\n"]
[120.835869, "o", "\u001b[1m✅ Your project is ready!\u001b[22m\r\n\r\n"]
[120.835929, "o", "To run your project, navigate to the directory and run one of the following npm commands.\r\n\r\n- \u001b[1mcd my-app\u001b[22m\r\n"]
[120.836102, "o", "- \u001b[1mnpm run android\u001b[22m\r\n- \u001b[1mnpm run ios\u001b[22m # you need to use macOS to build the iOS project - use the Expo app if you need to do iOS development without a Mac\r\n- \u001b[1mnpm run web\u001b[22m\r\n"]
[121.125881, "o", "\u001b[?25h"]
