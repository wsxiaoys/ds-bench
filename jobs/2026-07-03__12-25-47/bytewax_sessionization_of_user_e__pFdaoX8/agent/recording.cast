[159.978542, "o", "    # Parse JSON lines into dicts and add the parsed datetime for the clock.\r\n\u001b[?2004l\r\u001b[?2004h"]
[159.97859, "o", "> "]
[159.978733, "o", "    events = op.map(\"parse\", raw, lambda line: json.loads(line))\r\n\u001b[?2004l\r\u001b[?2004h"]
[159.978775, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[159.978988, "o", "    # Group events by user_id, attaching a parsed timestamp to each event.\r\n\u001b[?2004l\r\u001b[?2004h"]
[159.979038, "o", "> "]
[159.979169, "o", "    keyed = op.key_on(\"by_user\", events, lambda e: e[\"user_id\"])\r\n\u001b[?2004l\r"]
[159.979216, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[159.97943, "o", "    # EventTime clock: extract datetime from each event's timestamp field.\r\n\u001b[?2004l\r\u001b[?2004h"]
[159.979478, "o", "> "]
[159.979738, "o", "    clock = EventClock(lambda e: parse_timestamp(e[\"timestamp\"]), wait_for_system_duration=timedelta(seconds=1))\r\n\u001b[?2004l\r\u001b[?2004h"]
[159.979774, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[159.979925, "o", "    # Session window with 30 minute inactivity gap.\r\n\u001b[?2004l\r\u001b[?2004h"]
[159.979975, "o", "> "]
[159.980089, "o", "    windower = SessionWindower(gap=timedelta(minutes=30))\r\n\u001b[?2004l\r\u001b[?2004h"]
[159.980134, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[159.980241, "o", "    # Collect events in each session.\r\n\u001b[?2004l\r\u001b[?2004h> "]
[159.980427, "o", "    windows = collect_window(\"session\", keyed, clock, windower)\r\n\u001b[?2004l\r\u001b[?2004h"]
[159.980471, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[159.980628, "o", "    # Map each collected window into a session summary dict.\r\n\u001b[?2004l\r\u001b[?2004h"]
[159.98067, "o", "> "]
[159.980898, "o", "    # `windows.down` is a KeyedStream[Tuple[int, List[event]]] keyed by (user_id, window_id).\r\n\u001b[?2004l\r\u001b[?2004h"]
[159.980945, "o", "> "]
[159.981111, "o", "    summaries = op.map_value(\"summarize\", windows.down, lambda events: {\r\n\u001b[?2004l\r\u001b[?2004h"]
[159.98116, "o", "> "]
[159.981599, "o", "        \"session_start\": format_timestamp(parse_timestamp(min(e[\"timestamp\"] for e in events)[\"timestamp\"]) if False else min(parse_timestamp(e[\"timestamp\"]) for e in events)),\r\n\u001b[?2004l\r\u001b[?2004h"]
[159.981635, "o", "> "]
[159.98186, "o", "        \"session_end\": format_timestamp(max(parse_timestamp(e[\"timestamp\"]) for e in events)),\r\n\u001b[?2004l\r\u001b[?2004h"]
[159.981902, "o", "> "]
[159.981971, "o", "        \"event_count\": len(events),\r\n\u001b[?2004l\r\u001b[?2004h"]
[159.982008, "o", ">     })\r\n\u001b[?2004l\r"]
[159.982049, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[159.982304, "o", "    # The down stream is keyed by (user_id, window_id). We need to flatten back to user_id.\r\n\u001b[?2004l\r\u001b[?2004h"]
[159.982348, "o", "> "]
[159.982499, "o", "    # summaries is KeyedStream[(user_id, window_id), summary_dict]\r\n\u001b[?2004l\r\u001b[?2004h"]
[159.98254, "o", "> "]
[159.982703, "o", "    flat = op.map(\"flatten\", summaries, lambda kv: (kv[0][0], kv[1]))\r\n\u001b[?2004l\r\u001b[?2004h"]
[159.982751, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[159.982853, "o", "    # Output the summary for each session.\r\n\u001b[?2004l\r\u001b[?2004h"]
[159.982887, "o", "> "]
[159.983008, "o", "    out = op.map(\"format_output\", flat, lambda kv: {\r\n\u001b[?2004l\r"]
[159.98303, "o", "\u001b[?2004h> "]
[159.983118, "o", "        \"user_id\": kv[0],\r\n\u001b[?2004l\r\u001b[?2004h"]
[159.983159, "o", "> "]
[159.983269, "o", "        \"session_start\": kv[1][\"session_start\"],\r\n\u001b[?2004l\r\u001b[?2004h"]
[159.983299, "o", "> "]
[159.983409, "o", "        \"session_end\": kv[1][\"session_end\"],\r\n\u001b[?2004l\r\u001b[?2004h"]
[159.98345, "o", "> "]
[159.983544, "o", "        \"event_count\": kv[1][\"event_count\"],\r\n\u001b[?2004l\r\u001b[?2004h"]
[159.983585, "o", ">     })\r\n\u001b[?2004l\r"]
[159.983625, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[159.983776, "o", "    op.output(\"out\", out, JSONLSink(OUTPUT_PATH))\r\n\u001b[?2004l\r\u001b[?2004h"]
[159.983818, "o", "> "]
[159.983858, "o", "    return flow\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[159.983897, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[159.983984, "o", "if __name__ == \"__main__\":\r\n\u001b[?2004l\r\u001b[?2004h"]
[159.984027, "o", "> "]
[159.984074, "o", "    flow = build_flow()\r\n\u001b[?2004l\r\u001b[?2004h"]
[159.984119, "o", "> "]
[159.984157, "o", "    run_main(flow)\r\n\u001b[?2004l\r"]
[159.984179, "o", "\u001b[?2004h> EOF\r\n"]
