[98.413123, "o", "\u001b[32m\u001b[K161\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[01;31m\u001b[Kclass StatelessSink\u001b[m\u001b[KPartition(ABC, Generic[X]):\r\n\u001b[32m\u001b[K188\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[01;31m\u001b[Kclass DynamicSink(Sink\u001b[m\u001b[K[X]):\r\n"]
