[302.974805, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[302.974844, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[302.97494, "o", "def build_flow() -> Dataflow:\r\n\u001b[?2004l\r"]
[302.974977, "o", "\u001b[?2004h> "]
[302.975094, "o", "    flow = Dataflow(\"debug_sessionization\")\r\n\u001b[?2004l\r"]
[302.975132, "o", "\u001b[?2004h> "]
[302.975286, "o", "    raw = op.input(\"in\", flow, JSONLSource(INPUT_PATH))\r\n\u001b[?2004l\r"]
[302.975327, "o", "\u001b[?2004h> "]
[302.975491, "o", "    events = op.map(\"parse\", raw, lambda line: json.loads(line))\r\n\u001b[?2004l\r"]
[302.975529, "o", "\u001b[?2004h> "]
[302.975699, "o", "    keyed = op.key_on(\"by_user\", events, lambda e: e[\"user_id\"])\r\n\u001b[?2004l\r"]
[302.975738, "o", "\u001b[?2004h> "]
[302.975803, "o", "    clock = EventClock(\r\n\u001b[?2004l\r"]
[302.975841, "o", "\u001b[?2004h> "]
[302.975976, "o", "        lambda e: parse_timestamp(e[\"timestamp\"]),\r\n\u001b[?2004l\r"]
[302.976016, "o", "\u001b[?2004h> "]
[302.976156, "o", "        wait_for_system_duration=timedelta(seconds=1),\r\n\u001b[?2004l\r"]
[302.976202, "o", "\u001b[?2004h>     )\r\n"]
[302.976245, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[302.976401, "o", "    windower = SessionWindower(gap=timedelta(minutes=30))\r\n\u001b[?2004l\r"]
[302.976428, "o", "\u001b[?2004h> "]
[302.976603, "o", "    windows = collect_window(\"session\", keyed, clock, windower)\r\n\u001b[?2004l\r"]
[302.976647, "o", "\u001b[?2004h> "]
[302.976757, "o", "    op.inspect(\"windows_down\", windows.down)\r\n\u001b[?2004l\r"]
[302.976784, "o", "\u001b[?2004h> "]
[302.976864, "o", "    # Now check map_value\r\n\u001b[?2004l\r"]
[302.97689, "o", "\u001b[?2004h> "]
[302.977079, "o", "    summaries = op.map_value(\"summarize\", windows.down, lambda x: x)\r\n\u001b[?2004l\r"]
[302.977105, "o", "\u001b[?2004h> "]
[302.977221, "o", "    op.inspect(\"summaries\", summaries)\r\n\u001b[?2004l\r"]
[302.977248, "o", "\u001b[?2004h> "]
[302.977439, "o", "    flat = op.map(\"flatten\", summaries, lambda kv: (kv[0][0], kv[1]))\r\n\u001b[?2004l\r"]
[302.977464, "o", "\u001b[?2004h> "]
[302.977551, "o", "    op.inspect(\"flat\", flat)\r\n\u001b[?2004l\r"]
[302.977595, "o", "\u001b[?2004h> "]
[302.977634, "o", "    return flow\r\n\u001b[?2004l\r"]
[302.977675, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[302.977713, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[302.977808, "o", "if __name__ == \"__main__\":\r\n\u001b[?2004l\r"]
[302.977846, "o", "\u001b[?2004h> "]
[302.977914, "o", "    flow = build_flow()\r\n\u001b[?2004l\r"]
[302.977941, "o", "\u001b[?2004h> "]
[302.978005, "o", "    run_main(flow)\r\n\u001b[?2004l\r"]
[302.978046, "o", "\u001b[?2004h> PYEOF\r\n\u001b[?2004l\r"]
[302.979259, "o", "\u001b[?2004hroot@72683a99-967c-4608-912c-41c294cdde1a:/home/user/bytewax-sessionization# "]
[302.979367, "o", "python debug2.py 2>&1 | head -30\r\n\u001b[?2004l\r"]
