[197.729893, "o", "from bytewax._bytewax import run_main\r\n\u001b[?2004l\r"]
[197.729916, "o", "\u001b[?2004h> "]
[197.730041, "o", "from typing_extensions import override\r\n\u001b[?2004l\r"]
[197.730064, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[197.730088, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[197.730143, "o", "\u001b[?2004h> "]
[197.730408, "o", "INPUT_PATH = os.path.join(os.path.dirname(os.path.abspath(__file__)), \"user_events.jsonl\")\r\n\u001b[?2004l\r"]
[197.730432, "o", "\u001b[?2004h> "]
[197.73071, "o", "OUTPUT_PATH = os.path.join(os.path.dirname(os.path.abspath(__file__)), \"sessions.jsonl\")\r\n\u001b[?2004l\r"]
[197.730734, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[197.730787, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[197.730919, "o", "def parse_timestamp(ts: str) -> datetime:\r\n\u001b[?2004l\r"]
[197.730942, "o", "\u001b[?2004h> "]
[197.731182, "o", "    \"\"\"Parse an ISO 8601 timestamp string into an aware datetime in UTC.\"\"\"\r\n\u001b[?2004l\r"]
[197.73123, "o", "\u001b[?2004h> "]
[197.731297, "o", "    if ts.endswith(\"Z\"):\r\n\u001b[?2004l\r"]
[197.731321, "o", "\u001b[?2004h> "]
[197.73142, "o", "        ts = ts[:-1] + \"+00:00\"\r\n\u001b[?2004l\r"]
[197.731443, "o", "\u001b[?2004h> "]
[197.731562, "o", "    dt = datetime.fromisoformat(ts)\r\n\u001b[?2004l\r"]
[197.731586, "o", "\u001b[?2004h> "]
[197.731669, "o", "    if dt.tzinfo is None:\r\n\u001b[?2004l\r"]
[197.731693, "o", "\u001b[?2004h> "]
[197.731829, "o", "        dt = dt.replace(tzinfo=timezone.utc)\r\n\u001b[?2004l\r"]
[197.731853, "o", "\u001b[?2004h> "]
[197.731892, "o", "    return dt\r\n\u001b[?2004l\r\u001b[?2004h"]
[197.731938, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[197.731962, "o", "\u001b[?2004h> "]
[197.732075, "o", "def format_timestamp(dt: datetime) -> str:\r\n\u001b[?2004l\r"]
[197.7321, "o", "\u001b[?2004h> "]
[197.732297, "o", "    \"\"\"Format a datetime back into an ISO 8601 string with 'Z' suffix.\"\"\"\r\n\u001b[?2004l\r"]
[197.732321, "o", "\u001b[?2004h> "]
[197.732428, "o", "    dt_utc = dt.astimezone(timezone.utc)\r\n\u001b[?2004l\r"]
[197.732453, "o", "\u001b[?2004h> "]
[197.732523, "o", "    s = dt_utc.isoformat()\r\n\u001b[?2004l\r\u001b[?2004h"]
[197.732547, "o", "> "]
[197.732621, "o", "    if s.endswith(\"+00:00\"):\r\n\u001b[?2004l\r"]
[197.732645, "o", "\u001b[?2004h> "]
[197.732709, "o", "        s = s[:-6] + \"Z\"\r\n\u001b[?2004l\r"]
[197.732732, "o", "\u001b[?2004h> "]
[197.732783, "o", "    return s\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[197.732806, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[197.732832, "o", "\u001b[?2004h> "]
[197.73297, "o", "def summarize_session(events: List[dict]) -> dict:\r\n\u001b[?2004l\r"]
[197.732993, "o", "\u001b[?2004h> "]
[197.733143, "o", "    \"\"\"Compute summary metrics for a session of events.\"\"\"\r\n\u001b[?2004l\r"]
[197.733166, "o", "\u001b[?2004h> "]
[197.733335, "o", "    times = [parse_timestamp(e[\"timestamp\"]) for e in events]\r\n\u001b[?2004l\r\u001b[?2004h"]
[197.733356, "o", "> "]
[197.7334, "o", "    return {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[197.733552, "o", "        \"session_start\": format_timestamp(min(times)),\r\n\u001b[?2004l\r"]
[197.733576, "o", "\u001b[?2004h> "]
[197.733714, "o", "        \"session_end\": format_timestamp(max(times)),\r\n\u001b[?2004l\r"]
[197.733736, "o", "\u001b[?2004h> "]
[197.733829, "o", "        \"event_count\": len(events),\r\n\u001b[?2004l\r"]
[197.733851, "o", "\u001b[?2004h> "]
[197.733895, "o", "    }\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[197.733916, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h"]
[197.733959, "o", "> "]
[197.734076, "o", "class JSONLSource(FixedPartitionedSource[str, int]):\r\n\u001b[?2004l\r"]
[197.734097, "o", "\u001b[?2004h> "]
[197.734272, "o", "    \"\"\"Read items from a JSON lines file, one item per line.\"\"\"\r\n\u001b[?2004l\r\u001b[?2004h"]
[197.734293, "o", "> \r\n\u001b[?2004l\r"]
[197.734338, "o", "\u001b[?2004h> "]
[197.734408, "o", "    def __init__(self, path: str):\r\n\u001b[?2004l\r"]
[197.73443, "o", "\u001b[?2004h> "]
[197.734501, "o", "        self._path = path\r\n\u001b[?2004l\r"]
[197.734522, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[197.734564, "o", "\u001b[?2004h> "]
[197.734587, "o", "    @override\r\n\u001b[?2004l\r\u001b[?2004h"]
[197.734633, "o", "> "]
[197.734712, "o", "    def list_parts(self) -> List[str]:\r\n\u001b[?2004l\r"]
[197.734732, "o", "\u001b[?2004h> "]
[197.734824, "o", "        return [\"singleton\"]\r\n\u001b[?2004l\r\u001b[?2004h"]
[197.734846, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h"]
[197.734889, "o", ">     @override\r\n"]
[197.73491, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[197.734979, "o", "    def build_part(\r\n\u001b[?2004l\r"]
[197.735, "o", "\u001b[?2004h> "]
[197.735183, "o", "        self, step_id: str, for_part: str, resume_state: Optional[int]\r\n\u001b[?2004l\r"]
[197.735214, "o", "\u001b[?2004h> "]
[197.735286, "o", "    ) -> \"JSONLPartition\":\r\n\u001b[?2004l\r\u001b[?2004h"]
[197.735308, "o", "> "]
[197.735453, "o", "        return JSONLPartition(self._path, resume_state)\r\n\u001b[?2004l\r"]
[197.735474, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[197.735517, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[197.735671, "o", "class JSONLPartition(StatefulSourcePartition[str, int]):\r\n\u001b[?2004l\r"]
[197.735693, "o", "\u001b[?2004h> "]
[197.735858, "o", "    def __init__(self, path: str, resume_state: Optional[int]):\r\n\u001b[?2004l\r"]
[197.73588, "o", "\u001b[?2004h> "]
[197.73595, "o", "        self._path = path\r\n\u001b[?2004l\r"]
[197.735972, "o", "\u001b[?2004h> "]
[197.736169, "o", "        self._resume_state = resume_state if resume_state is not None else 0\r\n\u001b[?2004l\r"]
[197.73619, "o", "\u001b[?2004h> "]
[197.736269, "o", "        self._done = False\r\n\u001b[?2004l\r"]
[197.736291, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[197.736339, "o", "\u001b[?2004h> "]
[197.736361, "o", "    @override\r\n\u001b[?2004l\r\u001b[?2004h"]
[197.736413, "o", "> "]
[197.736502, "o", "    def next_batch(self) -> List[str]:\r\n\u001b[?2004l\r"]
[197.736524, "o", "\u001b[?2004h> "]
[197.736606, "o", "        if self._done:\r\n\u001b[?2004l\r"]
[197.736627, "o", "\u001b[?2004h> "]
[197.736732, "o", "            raise StopIteration()\r\n\u001b[?2004l\r"]
[197.736753, "o", "\u001b[?2004h> "]
[197.736866, "o", "        with open(self._path, \"r\") as f:\r\n\u001b[?2004l\r"]
[197.736887, "o", "\u001b[?2004h> "]
[197.736985, "o", "            lines = f.readlines()\r\n\u001b[?2004l\r"]
[197.737006, "o", "\u001b[?2004h> "]
[197.737207, "o", "        batch = [line.rstrip(\"\\n\") for line in lines[self._resume_state:]]\r\n\u001b[?2004l\r"]
[197.737229, "o", "\u001b[?2004h> "]
[197.737299, "o", "        self._done = True\r\n\u001b[?2004l\r"]
[197.737321, "o", "\u001b[?2004h> "]
[197.737425, "o", "        self._resume_state = len(lines)\r\n\u001b[?2004l\r"]
[197.737447, "o", "\u001b[?2004h> "]
[197.737503, "o", "        return batch\r\n\u001b[?2004l\r"]
[197.737524, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[197.737574, "o", "\u001b[?2004h>     @override\r\n"]
[197.737596, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[197.737692, "o", "    def snapshot(self) -> int:\r\n\u001b[?2004l\r"]
[197.737713, "o", "\u001b[?2004h> "]
[197.737803, "o", "        return self._resume_state\r\n\u001b[?2004l\r"]
[197.737825, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[197.73787, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[197.737966, "o", "class JSONLSink(DynamicSink[dict]):\r\n\u001b[?2004l\r"]
[197.737989, "o", "\u001b[?2004h> "]
[197.738166, "o", "    \"\"\"Write each output dict as a JSON line to the output file.\"\"\"\r\n\u001b[?2004l\r"]
[197.738187, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[197.738243, "o", "\u001b[?2004h> "]
[197.73831, "o", "    def __init__(self, path: str):\r\n\u001b[?2004l\r"]
[197.738331, "o", "\u001b[?2004h> "]
[197.738413, "o", "        self._path = path\r\n\u001b[?2004l\r"]
[197.738434, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[197.738455, "o", "\u001b[?2004h> "]
[197.738513, "o", "    @override\r\n\u001b[?2004l\r"]
[197.738534, "o", "\u001b[?2004h> "]
[197.738578, "o", "    def build(\r\n\u001b[?2004l\r\u001b[?2004h"]
[197.738609, "o", "> "]
[197.73878, "o", "        self, step_id: str, worker_index: int, worker_count: int\r\n\u001b[?2004l\r"]
[197.738811, "o", "\u001b[?2004h> "]
[197.738907, "o", "    ) -> \"JSONLSinkPartition\":\r\n\u001b[?2004l\r"]
[197.738927, "o", "\u001b[?2004h> "]
[197.739079, "o", "        return JSONLSinkPartition(self._path)\r\n\u001b[?2004l\r"]
[197.7391, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[197.739139, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[197.73916, "o", "\u001b[?2004h> "]
[197.739317, "o", "class JSONLSinkPartition(StatelessSinkPartition[dict]):\r\n\u001b[?2004l\r\u001b[?2004h"]
[197.739338, "o", "> "]
[197.739429, "o", "    def __init__(self, path: str):\r\n\u001b[?2004l\r"]
[197.73945, "o", "\u001b[?2004h> "]
[197.739543, "o", "        self._fh = open(path, \"w\")\r\n\u001b[?2004l\r"]
[197.739564, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[197.739604, "o", "\u001b[?2004h> "]
[197.739626, "o", "    @override\r\n\u001b[?2004l\r"]
[197.739665, "o", "\u001b[?2004h> "]
[197.73979, "o", "    def write_batch(self, items: List[dict]) -> None:\r\n\u001b[?2004l\r"]
[197.739811, "o", "\u001b[?2004h> "]
[197.739883, "o", "        for item in items:\r\n\u001b[?2004l\r"]
[197.739904, "o", "\u001b[?2004h> "]
[197.740021, "o", "            self._fh.write(json.dumps(item))\r\n\u001b[?2004l\r"]
[197.740042, "o", "\u001b[?2004h> "]
[197.74013, "o", "            self._fh.write(\"\\n\")\r\n\u001b[?2004l\r"]
[197.740161, "o", "\u001b[?2004h> "]
[197.740219, "o", "        self._fh.flush()\r\n\u001b[?2004l\r"]
[197.740241, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[197.740281, "o", "\u001b[?2004h> "]
[197.740302, "o", "    @override\r\n\u001b[?2004l\r"]
[197.740343, "o", "\u001b[?2004h> "]
[197.740406, "o", "    def close(self) -> None:\r\n\u001b[?2004l\r"]
[197.740427, "o", "\u001b[?2004h> "]
[197.740495, "o", "        self._fh.close()\r\n\u001b[?2004l\r"]
[197.740516, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[197.740556, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[197.740645, "o", "def build_flow() -> Dataflow:\r\n\u001b[?2004l\r"]
[197.740665, "o", "\u001b[?2004h> "]
[197.740768, "o", "    flow = Dataflow(\"sessionization\")\r\n\u001b[?2004l\r"]
[197.740789, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[197.74081, "o", "\u001b[?2004h> "]
[197.740937, "o", "    # Read raw JSON lines from the input file.\r\n\u001b[?2004l\r"]
[197.740958, "o", "\u001b[?2004h> "]
[197.741103, "o", "    raw = op.input(\"in\", flow, JSONLSource(INPUT_PATH))\r\n\u001b[?2004l\r"]
[197.741123, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[197.74116, "o", "\u001b[?2004h> "]
[197.741266, "o", "    # Parse JSON lines into event dicts.\r\n\u001b[?2004l\r"]
[197.741287, "o", "\u001b[?2004h> "]
[197.741458, "o", "    events = op.map(\"parse\", raw, lambda line: json.loads(line))\r\n\u001b[?2004l\r"]
[197.741479, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[197.741518, "o", "\u001b[?2004h> "]
[197.741589, "o", "    # Group events by user_id.\r\n\u001b[?2004l\r"]
[197.741609, "o", "\u001b[?2004h> "]
[197.741779, "o", "    keyed = op.key_on(\"by_user\", events, lambda e: e[\"user_id\"])\r\n\u001b[?2004l\r"]
[197.7418, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[197.741822, "o", "\u001b[?2004h> "]
[197.742021, "o", "    # Event time clock: extract datetime from each event's timestamp field.\r\n\u001b[?2004l\r"]
[197.742042, "o", "\u001b[?2004h> "]
[197.742108, "o", "    clock = EventClock(\r\n\u001b[?2004l\r"]
[197.742129, "o", "\u001b[?2004h> "]
[197.742269, "o", "        lambda e: parse_timestamp(e[\"timestamp\"]),\r\n\u001b[?2004l\r"]
[197.74229, "o", "\u001b[?2004h> "]
[197.742433, "o", "        wait_for_system_duration=timedelta(seconds=1),\r\n\u001b[?2004l\r"]
[197.742455, "o", "\u001b[?2004h> "]
[197.742476, "o", "    )\r\n\u001b[?2004l\r\u001b[?2004h"]
[197.742522, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[197.742654, "o", "    # Session window with 30-minute inactivity gap.\r\n\u001b[?2004l\r"]
[197.742675, "o", "\u001b[?2004h> "]
[197.742828, "o", "    windower = SessionWindower(gap=timedelta(minutes=30))\r\n\u001b[?2004l\r"]
[197.742848, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[197.742891, "o", "\u001b[?2004h> "]
[197.742974, "o", "    # Collect events in each session.\r\n\u001b[?2004l\r"]
[197.743005, "o", "\u001b[?2004h> "]
[197.74316, "o", "    windows = collect_window(\"session\", keyed, clock, windower)\r\n\u001b[?2004l\r"]
[197.743181, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[197.743219, "o", "\u001b[?2004h> "]
[197.743455, "o", "    # `windows.down` is a KeyedStream[Tuple[int, List[event]]] keyed by (user_id, window_id).\r\n\u001b[?2004l\r"]
[197.743476, "o", "\u001b[?2004h> "]
[197.743633, "o", "    # Map each collected window into a session summary dict.\r\n\u001b[?2004l\r"]
[197.743656, "o", "\u001b[?2004h> "]
[197.743846, "o", "    summaries = op.map_value(\"summarize\", windows.down, summarize_session)\r\n\u001b[?2004l\r"]
[197.743868, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[197.743907, "o", "\u001b[?2004h> "]
[197.7441, "o", "    # Flatten the keyed stream so the key is just user_id and value is summary.\r\n\u001b[?2004l\r"]
[197.744131, "o", "\u001b[?2004h> "]
[197.74431, "o", "    flat = op.map(\"flatten\", summaries, lambda kv: (kv[0][0], kv[1]))\r\n\u001b[?2004l\r"]
[197.744331, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[197.744373, "o", "\u001b[?2004h> "]
[197.744481, "o", "    # Build the final output record per session.\r\n\u001b[?2004l\r"]
[197.744503, "o", "\u001b[?2004h> "]
[197.744643, "o", "    out = op.map(\"format_output\", flat, lambda kv: {\r\n\u001b[?2004l\r"]
[197.744664, "o", "\u001b[?2004h> "]
[197.744734, "o", "        \"user_id\": kv[0],\r\n\u001b[?2004l\r"]
[197.744756, "o", "\u001b[?2004h> "]
[197.744887, "o", "        \"session_start\": kv[1][\"session_start\"],\r\n\u001b[?2004l\r"]
[197.744909, "o", "\u001b[?2004h> "]
[197.745025, "o", "        \"session_end\": kv[1][\"session_end\"],\r\n\u001b[?2004l\r"]
[197.745047, "o", "\u001b[?2004h> "]
[197.745168, "o", "        \"event_count\": kv[1][\"event_count\"],\r\n\u001b[?2004l\r"]
[197.745189, "o", "\u001b[?2004h> "]
[197.74525, "o", "    })\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[197.745274, "o", "\u001b[?2004h> "]
[197.74541, "o", "    op.output(\"out\", out, JSONLSink(OUTPUT_PATH))\r\n\u001b[?2004l\r"]
[197.745432, "o", "\u001b[?2004h> "]
[197.745477, "o", "    return flow\r\n\u001b[?2004l\r"]
[197.745499, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[197.745541, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[197.745625, "o", "if __name__ == \"__main__\":\r\n\u001b[?2004l\r"]
[197.745657, "o", "\u001b[?2004h> "]
[197.745714, "o", "    flow = build_flow()\r\n\u001b[?2004l\r"]
[197.745735, "o", "\u001b[?2004h> "]
[197.74579, "o", "    run_main(flow)\r\n\u001b[?2004l\r"]
[197.745812, "o", "\u001b[?2004h> "]
