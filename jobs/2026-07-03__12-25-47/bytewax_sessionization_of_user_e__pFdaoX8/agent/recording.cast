[53.182836, "o", "\u001b[32m\u001b[K1997\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[01;31m\u001b[Kdef\u001b[m\u001b[K join_window(\r\n\u001b[32m\u001b[K2013\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[01;31m\u001b[Kdef\u001b[m\u001b[K join_window(\r\n\u001b[32m\u001b[K2032\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[01;31m\u001b[Kdef\u001b[m\u001b[K join_window(\r\n\u001b[32m\u001b[K2044\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[01;31m\u001b[Kdef\u001b[m\u001b[K join_window(\r\n\u001b[32m\u001b[K2056\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[01;31m\u001b[Kdef\u001b[m\u001b[K join_window(\r\n\u001b[32m\u001b[K2146\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[01;31m\u001b[Kdef\u001b[m\u001b[K max_window(\r\n\u001b[32m\u001b[K2155\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[01;31m\u001b[Kdef\u001b[m\u001b[K max_window(\r\n\u001b[32m\u001b[K2165\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[01;31m\u001b[Kdef\u001b[m\u001b[K max_window(\r\n\u001b[32m\u001b[K2193\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[01;31m\u001b[Kdef\u001b[m\u001b[K min_window(\r\n\u001b[32m\u001b[K2202\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[01;31m\u001b[Kdef\u001b[m\u001b[K min_window(\r\n\u001b[32m\u001b[K2212\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[01;31m\u001b[Kdef\u001b[m\u001b[K min_window(\r\n\u001b[32m\u001b[K2240\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[01;31m\u001b[Kdef\u001b[m\u001b[K reduce_window(\r\n"]
