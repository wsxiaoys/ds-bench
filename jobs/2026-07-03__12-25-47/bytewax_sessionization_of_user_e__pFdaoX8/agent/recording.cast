[271.137385, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[271.137406, "o", "> "]
[271.137456, "o", "    @override\r\n\u001b[?2004l\r\u001b[?2004h> "]
[271.137602, "o", "    def write_batch(self, items: List[dict]) -> None:\r\n\u001b[?2004l\r"]
[271.137625, "o", "\u001b[?2004h> "]
[271.137696, "o", "        for item in items:\r\n\u001b[?2004l\r"]
[271.137729, "o", "\u001b[?2004h> "]
[271.137838, "o", "            self._fh.write(json.dumps(item))\r\n\u001b[?2004l\r"]
[271.137871, "o", "\u001b[?2004h> "]
[271.137944, "o", "            self._fh.write(\"\\n\")\r\n\u001b[?2004l\r"]
[271.137976, "o", "\u001b[?2004h> "]
[271.138029, "o", "        self._fh.flush()\r\n\u001b[?2004l\r"]
[271.138054, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[271.138074, "o", "\u001b[?2004h> "]
[271.138125, "o", "    @override\r\n\u001b[?2004l\r\u001b[?2004h"]
[271.138157, "o", "> "]
[271.138219, "o", "    def close(self) -> None:\r\n\u001b[?2004l\r\u001b[?2004h"]
[271.138241, "o", "> "]
[271.138307, "o", "        self._fh.close()\r\n\u001b[?2004l\r"]
[271.138331, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[271.138353, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[271.1384, "o", "\u001b[?2004h> "]
[271.138453, "o", "def build_flow() -> Dataflow:\r\n\u001b[?2004l\r"]
[271.138476, "o", "\u001b[?2004h> "]
[271.138577, "o", "    flow = Dataflow(\"sessionization\")\r\n\u001b[?2004l\r"]
[271.138602, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[271.138623, "o", "> "]
[271.138745, "o", "    # Read raw JSON lines from the input file.\r\n\u001b[?2004l\r"]
[271.138778, "o", "\u001b[?2004h> "]
[271.13891, "o", "    raw = op.input(\"in\", flow, JSONLSource(INPUT_PATH))\r\n\u001b[?2004l\r"]
[271.138935, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[271.138957, "o", "\u001b[?2004h> "]
[271.139064, "o", "    # Parse JSON lines into event dicts.\r\n\u001b[?2004l\r"]
[271.139095, "o", "\u001b[?2004h> "]
[271.139291, "o", "    events = op.map(\"parse\", raw, lambda line: json.loads(line))\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[271.139338, "o", "\u001b[?2004h> "]
[271.139414, "o", "    # Group events by user_id.\r\n\u001b[?2004l\r"]
[271.139454, "o", "\u001b[?2004h> "]
[271.139623, "o", "    keyed = op.key_on(\"by_user\", events, lambda e: e[\"user_id\"])\r\n\u001b[?2004l\r"]
[271.139663, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[271.139688, "o", "> "]
[271.13989, "o", "    # Event time clock: extract datetime from each event's timestamp field.\r\n\u001b[?2004l\r"]
[271.139929, "o", "\u001b[?2004h> "]
[271.139992, "o", "    clock = EventClock(\r\n\u001b[?2004l\r"]
[271.140019, "o", "\u001b[?2004h> "]
[271.140167, "o", "        lambda e: parse_timestamp(e[\"timestamp\"]),\r\n\u001b[?2004l\r"]
[271.140216, "o", "\u001b[?2004h> "]
[271.140357, "o", "        wait_for_system_duration=timedelta(seconds=1),\r\n\u001b[?2004l\r"]
[271.140383, "o", "\u001b[?2004h> "]
[271.140408, "o", "    )\r\n\u001b[?2004l\r"]
[271.140432, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[271.140457, "o", "\u001b[?2004h> "]
[271.140606, "o", "    # Session window with 30-minute inactivity gap.\r\n\u001b[?2004l\r"]
[271.140646, "o", "\u001b[?2004h> "]
[271.140795, "o", "    windower = SessionWindower(gap=timedelta(minutes=30))\r\n\u001b[?2004l\r"]
[271.140834, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[271.140872, "o", "> "]
[271.140968, "o", "    # Collect events in each session.\r\n\u001b[?2004l\r"]
[271.141006, "o", "\u001b[?2004h> "]
[271.141169, "o", "    windows = collect_window(\"session\", keyed, clock, windower)\r\n\u001b[?2004l\r"]
[271.141226, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[271.141265, "o", "\u001b[?2004h> "]
[271.141448, "o", "    # `windows.down` is a KeyedStream[(user_id, (window_id, List[event]))].\r\n\u001b[?2004l\r"]
[271.141486, "o", "\u001b[?2004h> "]
[271.141589, "o", "    # Compute session summary metrics.\r\n\u001b[?2004l\r"]
[271.141627, "o", "\u001b[?2004h> "]
[271.14182, "o", "    summaries = op.map_value(\"summarize\", windows.down, summarize_session)\r\n\u001b[?2004l\r"]
[271.141858, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[271.141895, "o", "> "]
[271.14205, "o", "    # Re-key by just the user_id, dropping the window_id.\r\n\u001b[?2004l\r"]
[271.142086, "o", "\u001b[?2004h> "]
[271.142251, "o", "    flat = op.map(\"flatten\", summaries, lambda kv: (kv[0][0], kv[1]))\r\n\u001b[?2004l\r"]
[271.142275, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[271.142296, "o", "\u001b[?2004h> "]
[271.142424, "o", "    # Build the final output record per session.\r\n\u001b[?2004l\r"]
[271.142445, "o", "\u001b[?2004h> "]
[271.142586, "o", "    out = op.map(\"format_output\", flat, lambda kv: {\r\n\u001b[?2004l\r"]
[271.142617, "o", "\u001b[?2004h> "]
[271.142673, "o", "        \"user_id\": kv[0],\r\n\u001b[?2004l\r"]
[271.142694, "o", "\u001b[?2004h> "]
[271.142822, "o", "        \"session_start\": kv[1][\"session_start\"],\r\n\u001b[?2004l\r"]
[271.142844, "o", "\u001b[?2004h> "]
[271.142957, "o", "        \"session_end\": kv[1][\"session_end\"],\r\n\u001b[?2004l\r"]
[271.142978, "o", "\u001b[?2004h> "]
[271.143099, "o", "        \"event_count\": kv[1][\"event_count\"],\r\n\u001b[?2004l\r"]
[271.143121, "o", "\u001b[?2004h> "]
[271.143161, "o", "    })\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[271.143182, "o", "\u001b[?2004h> "]
[271.143326, "o", "    op.output(\"out\", out, JSONLSink(OUTPUT_PATH))\r\n\u001b[?2004l\r"]
[271.143347, "o", "\u001b[?2004h> "]
[271.143392, "o", "    return flow\r\n\u001b[?2004l\r"]
[271.143414, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[271.143476, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[271.143533, "o", "if __name__ == \"__main__\":\r\n\u001b[?2004l\r"]
[271.143555, "o", "\u001b[?2004h> "]
[271.143621, "o", "    flow = build_flow()\r\n\u001b[?2004l\r"]
[271.143642, "o", "\u001b[?2004h> "]
[271.143695, "o", "    run_main(flow)\r\n\u001b[?2004l\r"]
[271.143717, "o", "\u001b[?2004h> "]
[271.143738, "o", "PYEOF\r\n\u001b[?2004l\r"]
[271.145165, "o", "\u001b[?2004hroot@72683a99-967c-4608-912c-41c294cdde1a:/home/user/bytewax-sessionization# "]
[271.145269, "o", "python run.py 2>&1 | head -50\r\n\u001b[?2004l\r"]
[271.262969, "o", "\u001b[?2004hroot@72683a99-967c-4608-912c-41c294cdde1a:/home/user/bytewax-sessionization# "]
[289.232566, "i", "cat sessions.jsonl\n"]
[289.232778, "o", "cat sessions.jsonl\r\n\u001b[?2004l\r"]
[289.233785, "o", "{\"user_id\": \"u\", \"session_start\": \"2023-10-01T10:00:00Z\", \"session_end\": \"2023-10-01T10:15:00Z\", \"event_count\": 2}\r\n{\"user_id\": \"u\", \"session_start\": \"2023-10-01T11:00:00Z\", \"session_end\": \"2023-10-01T11:00:00Z\", \"event_count\": 1}\r\n{\"user_id\": \"u\", \"session_start\": \"2023-10-01T10:05:00Z\", \"session_end\": \"2023-10-01T10:30:00Z\", \"event_count\": 3}\r\n"]
[289.233968, "o", "\u001b[?2004hroot@72683a99-967c-4608-912c-41c294cdde1a:/home/user/bytewax-sessionization# "]
[302.96738, "i", "cat > debug2.py << 'PYEOF'\n\"\"\"Debug sessionize user events.\"\"\"\n\nimport json\nimport os\nfrom datetime import datetime, timedelta, timezone\nfrom typing import List, Optional, Tuple\n\nfrom bytewax.dataflow import Dataflow\nimport bytewax.operators as op\nfrom bytewax.operators.windowing import EventClock, SessionWindower, collect_window\nfrom bytewax.inputs import FixedPartitionedSource, StatefulSourcePartition\nfrom bytewax._bytewax import run_main\nfrom typing_extensions import override\n\n\nINPUT_PATH = os.path.join(os.path.dirname(os.path.abspath(__file__)), \"user_events.jsonl\")\n\n\ndef parse_timestamp(ts: str) -> datetime:\n    if ts.endswith(\"Z\"):\n        ts = ts[:-1] + \"+00:00\"\n    dt = datetime.fromisoformat(ts)\n    if dt.tzinfo is None:\n        dt = dt.replace(tzinfo=timezone.utc)\n    return dt\n\n\nclass JSONLSource(FixedPartitionedSource[str, int]):\n    def __init__(self, path: str):\n        self._path = path\n\n    @override\n    def list_parts(self) -> List[str]:\n        return [\"singleton\"]\n\n    @override\n    def build_part(\n        self, step_id: str, for_part: str, resume_state: Optional[int]\n    ) -> \"JSONLPartition\":\n        return JSONLPartition(self._path, resume_state)\n\n\nclass JSONLPartition(StatefulSourcePartition[str, int]):\n    def __init__(self, path: str, resume_state: Optional[int]):\n        self._path = path\n        self._resume_state = resume_state if resume_state is not None else 0\n        self._done = False\n\n    @override\n    def next_batch(self) -> List[str]:\n        if self._done:\n            raise StopIteration()\n        with open(self._path, \"r\") as f:\n            lines = f.readlines()\n        batch = [line.rstrip(\"\\n\") for line in lines[self._resume_state:]]\n        self._done = True\n        self._resume_state = len(lines)\n        return batch\n\n    @override\n    def snapshot(self) -> int:\n        return self._resume_state\n\n\ndef build_flow() -> Dataflow:\n    flow = Dataflow(\"debug_sessionization\")\n    raw = op.input(\"in\", flow, JSONLSource(INPUT_PATH))\n    events = op.map(\"parse\", raw, lambda line: json.loads(line))\n    keyed = op.key_on(\"by_user\", events, lambda e: e[\"user_id\"])\n    clock = EventClock(\n        lambda e: parse_timestamp(e[\"timestamp\"]),\n        wait_for_system_duration=timedelta(seconds=1),\n    )\n    windower = SessionWindower(gap=timedelta(minutes=30))\n    windows = collect_window(\"session\", keyed, clock, windower)\n    op.inspect(\"windows_down\", windows.down)\n    # Now check map_value\n    summaries = op.map_value(\"summarize\", windows.down, lambda x: x)\n    op.inspect(\"summaries\", summaries)\n    flat = op.map(\"flatten\", summaries, lambda kv: (kv[0][0], kv[1]))\n    op.inspect(\"flat\", flat)\n    return flow\n\n\nif __name__ == \"__main__\":\n    flow = build_flow()\n    run_main(flow)\nPYEOF\npython debug2.py 2>&1 | head -30\n"]
