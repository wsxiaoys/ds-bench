[364.39928, "o", "from bytewax._bytewax import run_main\r\n\u001b[?2004l\r"]
[364.399307, "o", "\u001b[?2004h> "]
[364.399432, "o", "from typing_extensions import override\r\n\u001b[?2004l\r\u001b[?2004h"]
[364.399461, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h"]
[364.399513, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[364.399882, "o", "INPUT_PATH = os.path.join(os.path.dirname(os.path.abspath(__file__)), \"user_events.jsonl\")\r\n\u001b[?2004l\r"]
[364.399909, "o", "\u001b[?2004h> "]
[364.400189, "o", "OUTPUT_PATH = os.path.join(os.path.dirname(os.path.abspath(__file__)), \"sessions.jsonl\")\r\n\u001b[?2004l\r\u001b[?2004h"]
[364.400224, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h"]
[364.40028, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[364.400406, "o", "def parse_timestamp(ts: str) -> datetime:\r\n\u001b[?2004l\r"]
[364.400436, "o", "\u001b[?2004h> "]
[364.40074, "o", "    \"\"\"Parse an ISO 8601 timestamp string into an aware datetime in UTC.\"\"\"\r\n\u001b[?2004l\r"]
[364.400769, "o", "\u001b[?2004h> "]
[364.400846, "o", "    if ts.endswith(\"Z\"):\r\n\u001b[?2004l\r"]
[364.400874, "o", "\u001b[?2004h> "]
[364.401004, "o", "        ts = ts[:-1] + \"+00:00\"\r\n\u001b[?2004l\r"]
[364.401032, "o", "\u001b[?2004h> "]
[364.401179, "o", "    dt = datetime.fromisoformat(ts)\r\n\u001b[?2004l\r"]
[364.401213, "o", "\u001b[?2004h> "]
[364.401318, "o", "    if dt.tzinfo is None:\r\n\u001b[?2004l\r"]
[364.401347, "o", "\u001b[?2004h> "]
[364.401528, "o", "        dt = dt.replace(tzinfo=timezone.utc)\r\n\u001b[?2004l\r\u001b[?2004h"]
[364.401556, "o", "> "]
[364.401615, "o", "    return dt\r\n\u001b[?2004l\r\u001b[?2004h> \r\n"]
[364.401644, "o", "\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[364.401696, "o", "\u001b[?2004h> "]
[364.401812, "o", "def format_timestamp(dt: datetime) -> str:\r\n\u001b[?2004l\r"]
[364.401838, "o", "\u001b[?2004h> "]
[364.402029, "o", "    \"\"\"Format a datetime back into an ISO 8601 string with 'Z' suffix.\"\"\"\r\n\u001b[?2004l\r\u001b[?2004h"]
[364.402055, "o", "> "]
[364.402159, "o", "    dt_utc = dt.astimezone(timezone.utc)\r\n\u001b[?2004l\r\u001b[?2004h"]
[364.402185, "o", "> "]
[364.402267, "o", "    s = dt_utc.isoformat()\r\n\u001b[?2004l\r\u001b[?2004h"]
[364.402295, "o", "> "]
[364.402368, "o", "    if s.endswith(\"+00:00\"):\r\n\u001b[?2004l\r\u001b[?2004h"]
[364.402395, "o", "> "]
[364.402458, "o", "        s = s[:-6] + \"Z\"\r\n\u001b[?2004l\r\u001b[?2004h"]
[364.402485, "o", "> "]
[364.402535, "o", "    return s\r\n\u001b[?2004l\r\u001b[?2004h> \r\n"]
[364.402562, "o", "\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[364.402616, "o", "\u001b[?2004h> "]
[364.402791, "o", "def summarize_session(window_id_and_events: Tuple[int, List[dict]]) -> dict:\r\n\u001b[?2004l\r"]
[364.402819, "o", "\u001b[?2004h> "]
[364.40296, "o", "    \"\"\"Compute summary metrics for a session of events.\r\n\u001b[?2004l\r"]
[364.402988, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[364.403039, "o", "> "]
[364.403205, "o", "    ``collect_window`` emits each window as ``(window_id, List[event])``.\r\n\u001b[?2004l\r\u001b[?2004h"]
[364.403232, "o", "> "]
[364.403284, "o", "    \"\"\"\r\n\u001b[?2004l\r\u001b[?2004h> "]
[364.403403, "o", "    _window_id, events = window_id_and_events\r\n\u001b[?2004l\r\u001b[?2004h"]
[364.403431, "o", "> "]
[364.403662, "o", "    times = [parse_timestamp(e[\"timestamp\"]) for e in events]\r\n\u001b[?2004l\r\u001b[?2004h> "]
[364.403734, "o", "    return {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[364.403812, "o", "        \"session_start\": format_timestamp(min(times)),\r\n\u001b[?2004l\r"]
[364.403843, "o", "\u001b[?2004h> "]
[364.403974, "o", "        \"session_end\": format_timestamp(max(times)),\r\n\u001b[?2004l\r\u001b[?2004h"]
[364.404004, "o", "> "]
[364.404094, "o", "        \"event_count\": len(events),\r\n\u001b[?2004l\r\u001b[?2004h"]
[364.404121, "o", ">     }\r\n\u001b[?2004l\r"]
[364.404174, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[364.404205, "o", "\u001b[?2004h> "]
[364.40435, "o", "class JSONLSource(FixedPartitionedSource[str, int]):\r\n\u001b[?2004l\r\u001b[?2004h"]
[364.404379, "o", "> "]
[364.404541, "o", "    \"\"\"Read items from a JSON lines file, one item per line.\"\"\"\r\n\u001b[?2004l\r"]
[364.404587, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[364.40468, "o", "    def __init__(self, path: str):\r\n\u001b[?2004l\r\u001b[?2004h"]
[364.404709, "o", "> "]
[364.404774, "o", "        self._path = path\r\n\u001b[?2004l\r\u001b[?2004h"]
[364.404803, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h"]
[364.404829, "o", "> "]
[364.404892, "o", "    @override\r\n\u001b[?2004l\r\u001b[?2004h> "]
[364.404984, "o", "    def list_parts(self) -> List[str]:\r\n\u001b[?2004l\r"]
[364.405013, "o", "\u001b[?2004h> "]
[364.405086, "o", "        return [\"singleton\"]\r\n\u001b[?2004l\r\u001b[?2004h"]
[364.405115, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h"]
[364.405168, "o", ">     @override\r\n\u001b[?2004l\r"]
[364.405201, "o", "\u001b[?2004h> "]
[364.405255, "o", "    def build_part(\r\n\u001b[?2004l\r\u001b[?2004h"]
[364.405283, "o", "> "]
[364.405464, "o", "        self, step_id: str, for_part: str, resume_state: Optional[int]\r\n\u001b[?2004l\r\u001b[?2004h"]
[364.405492, "o", "> "]
[364.405557, "o", "    ) -> \"JSONLPartition\":\r\n\u001b[?2004l\r\u001b[?2004h"]
[364.405586, "o", "> "]
[364.405729, "o", "        return JSONLPartition(self._path, resume_state)\r\n\u001b[?2004l\r\u001b[?2004h"]
[364.405757, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h"]
[364.405809, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[364.405953, "o", "class JSONLPartition(StatefulSourcePartition[str, int]):\r\n\u001b[?2004l\r"]
[364.40598, "o", "\u001b[?2004h> "]
[364.406151, "o", "    def __init__(self, path: str, resume_state: Optional[int]):\r\n\u001b[?2004l\r\u001b[?2004h"]
[364.406179, "o", "> "]
[364.406252, "o", "        self._path = path\r\n\u001b[?2004l\r\u001b[?2004h"]
[364.406278, "o", "> "]
[364.406477, "o", "        self._resume_state = resume_state if resume_state is not None else 0\r\n\u001b[?2004l\r\u001b[?2004h"]
[364.406504, "o", "> "]
[364.406568, "o", "        self._done = False\r\n\u001b[?2004l\r\u001b[?2004h"]
[364.406595, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h"]
[364.406646, "o", ">     @override\r\n"]
[364.406672, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[364.406787, "o", "    def next_batch(self) -> List[str]:\r\n\u001b[?2004l\r\u001b[?2004h"]
[364.406815, "o", "> "]
[364.406871, "o", "        if self._done:\r\n\u001b[?2004l\r\u001b[?2004h"]
[364.406899, "o", "> "]
[364.406987, "o", "            raise StopIteration()\r\n\u001b[?2004l\r\u001b[?2004h"]
[364.407013, "o", "> "]
[364.407116, "o", "        with open(self._path, \"r\") as f:\r\n\u001b[?2004l\r\u001b[?2004h"]
[364.407142, "o", "> "]
[364.407236, "o", "            lines = f.readlines()\r\n\u001b[?2004l\r\u001b[?2004h"]
[364.407264, "o", "> "]
[364.407452, "o", "        batch = [line.rstrip(\"\\n\") for line in lines[self._resume_state:]]\r\n\u001b[?2004l\r\u001b[?2004h"]
[364.407524, "o", "> "]
[364.407557, "o", "        self._done = True\r\n\u001b[?2004l\r\u001b[?2004h> "]
[364.407674, "o", "        self._resume_state = len(lines)\r\n\u001b[?2004l\r\u001b[?2004h"]
[364.407703, "o", "> "]
[364.407777, "o", "        return batch\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[364.407806, "o", "\u001b[?2004h> "]
[364.407857, "o", "    @override\r\n\u001b[?2004l\r\u001b[?2004h> "]
[364.407955, "o", "    def snapshot(self) -> int:\r\n\u001b[?2004l\r\u001b[?2004h"]
[364.407982, "o", "> "]
[364.408068, "o", "        return self._resume_state\r\n\u001b[?2004l\r\u001b[?2004h"]
[364.408094, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h"]
[364.408145, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[364.408244, "o", "class JSONLSink(DynamicSink[dict]):\r\n\u001b[?2004l\r\u001b[?2004h"]
[364.408272, "o", "> "]
[364.408443, "o", "    \"\"\"Write each output dict as a JSON line to the output file.\"\"\"\r\n\u001b[?2004l\r"]
[364.408471, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[364.408524, "o", "> "]
[364.408598, "o", "    def __init__(self, path: str):\r\n\u001b[?2004l\r"]
[364.408627, "o", "\u001b[?2004h> "]
[364.408717, "o", "        self._path = path\r\n\u001b[?2004l\r"]
[364.408746, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[364.408807, "o", ">     @override\r\n\u001b[?2004l\r"]
[364.408836, "o", "\u001b[?2004h> "]
[364.408975, "o", "    def build(\r\n\u001b[?2004l\r\u001b[?2004h> "]
[364.409106, "o", "        self, step_id: str, worker_index: int, worker_count: int\r\n\u001b[?2004l\r\u001b[?2004h"]
[364.409165, "o", "> "]
[364.409217, "o", "    ) -> \"JSONLSinkPartition\":\r\n\u001b[?2004l\r"]
[364.409244, "o", "\u001b[?2004h> "]
[364.40938, "o", "        return JSONLSinkPartition(self._path)\r\n\u001b[?2004l\r\u001b[?2004h"]
[364.409408, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h"]
[364.409469, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[364.409615, "o", "class JSONLSinkPartition(StatelessSinkPartition[dict]):\r\n\u001b[?2004l\r\u001b[?2004h"]
[364.409645, "o", "> "]
[364.409746, "o", "    def __init__(self, path: str):\r\n\u001b[?2004l\r"]
[364.409775, "o", "\u001b[?2004h> "]
[364.409879, "o", "        self._fh = open(path, \"w\")\r\n\u001b[?2004l\r\u001b[?2004h"]
[364.409907, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h"]
[364.409969, "o", ">     @override\r\n"]
[364.409999, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[364.410157, "o", "    def write_batch(self, items: List[dict]) -> None:\r\n\u001b[?2004l\r\u001b[?2004h"]
[364.410184, "o", "> "]
[364.410272, "o", "        for item in items:\r\n\u001b[?2004l\r\u001b[?2004h"]
[364.4103, "o", "> "]
[364.410428, "o", "            self._fh.write(json.dumps(item))\r\n\u001b[?2004l\r\u001b[?2004h"]
[364.410499, "o", "> "]
[364.410543, "o", "            self._fh.write(\"\\n\")\r\n\u001b[?2004l\r"]
[364.410614, "o", "\u001b[?2004h> "]
[364.410644, "o", "        self._fh.flush()\r\n\u001b[?2004l\r"]
[364.410703, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[364.41075, "o", "    @override\r\n\u001b[?2004l\r"]
[364.410817, "o", "\u001b[?2004h> "]
[364.410871, "o", "    def close(self) -> None:\r\n\u001b[?2004l\r"]
[364.410899, "o", "\u001b[?2004h> "]
[364.410975, "o", "        self._fh.close()\r\n\u001b[?2004l\r\u001b[?2004h"]
[364.411003, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h"]
[364.411063, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[364.411146, "o", "def build_flow() -> Dataflow:\r\n\u001b[?2004l\r"]
[364.411175, "o", "\u001b[?2004h> "]
[364.411292, "o", "    flow = Dataflow(\"sessionization\")\r\n\u001b[?2004l\r\u001b[?2004h"]
[364.411319, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h"]
[364.411379, "o", "> "]
[364.411481, "o", "    # Read raw JSON lines from the input file.\r\n\u001b[?2004l\r"]
[364.411507, "o", "\u001b[?2004h> "]
[364.411668, "o", "    raw = op.input(\"in\", flow, JSONLSource(INPUT_PATH))\r\n\u001b[?2004l\r"]
[364.411696, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[364.411759, "o", "> "]
[364.411845, "o", "    # Parse JSON lines into event dicts.\r\n\u001b[?2004l\r"]
[364.411873, "o", "\u001b[?2004h> "]
[364.41205, "o", "    events = op.map(\"parse\", raw, lambda line: json.loads(line))\r\n\u001b[?2004l\r\u001b[?2004h"]
[364.41208, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h"]
[364.412139, "o", "> "]
[364.412199, "o", "    # Group events by user_id.\r\n\u001b[?2004l\r"]
[364.412226, "o", "\u001b[?2004h> "]
[364.412413, "o", "    keyed = op.key_on(\"by_user\", events, lambda e: e[\"user_id\"])\r\n\u001b[?2004l\r\u001b[?2004h"]
[364.41244, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h"]
[364.412501, "o", "> "]
[364.412674, "o", "    # Event time clock: extract datetime from each event's timestamp field.\r\n\u001b[?2004l\r"]
[364.412702, "o", "\u001b[?2004h> "]
[364.412777, "o", "    clock = EventClock(\r\n\u001b[?2004l\r\u001b[?2004h"]
[364.412806, "o", "> "]
[364.412947, "o", "        lambda e: parse_timestamp(e[\"timestamp\"]),\r\n\u001b[?2004l\r\u001b[?2004h"]
[364.412976, "o", "> "]
[364.413128, "o", "        wait_for_system_duration=timedelta(seconds=1),\r\n\u001b[?2004l\r\u001b[?2004h"]
[364.413157, "o", ">     )\r\n"]
[364.413237, "o", "\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[364.413373, "o", "    # Session window with 30-minute inactivity gap.\r\n\u001b[?2004l\r"]
[364.4134, "o", "\u001b[?2004h> "]
[364.413561, "o", "    windower = SessionWindower(gap=timedelta(minutes=30))\r\n\u001b[?2004l\r\u001b[?2004h"]
[364.413587, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h"]
[364.413647, "o", "> "]
[364.413728, "o", "    # Collect events in each session.\r\n\u001b[?2004l\r\u001b[?2004h"]
[364.413758, "o", "> "]
[364.41393, "o", "    windows = collect_window(\"session\", keyed, clock, windower)\r\n\u001b[?2004l\r\u001b[?2004h"]
[364.41396, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h"]
[364.414017, "o", "> "]
[364.414228, "o", "    # `windows.down` is KeyedStream keyed by user_id; value is (window_id, List[event]).\r\n\u001b[?2004l\r"]
[364.414281, "o", "\u001b[?2004h> "]
[364.41444, "o", "    # Compute session summary metrics from the collected events.\r\n\u001b[?2004l\r\u001b[?2004h"]
[364.414468, "o", "> "]
[364.414668, "o", "    summaries = op.map_value(\"summarize\", windows.down, summarize_session)\r\n\u001b[?2004l\r\u001b[?2004h"]
[364.414695, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h"]
[364.414755, "o", "> "]
[364.414898, "o", "    # Map each (user_id, summary) into the final output record.\r\n\u001b[?2004l\r"]
[364.414926, "o", "\u001b[?2004h> "]
[364.415087, "o", "    out = op.map(\"format_output\", summaries, lambda kv: {\r\n\u001b[?2004l\r\u001b[?2004h"]
[364.415116, "o", "> "]
[364.415196, "o", "        \"user_id\": kv[0],\r\n\u001b[?2004l\r\u001b[?2004h"]
[364.415253, "o", "> "]
[364.415367, "o", "        \"session_start\": kv[1][\"session_start\"],\r\n\u001b[?2004l\r\u001b[?2004h"]
[364.415396, "o", "> "]
[364.41552, "o", "        \"session_end\": kv[1][\"session_end\"],\r\n\u001b[?2004l\r\u001b[?2004h"]
[364.415549, "o", "> "]
[364.415675, "o", "        \"event_count\": kv[1][\"event_count\"],\r\n\u001b[?2004l\r\u001b[?2004h"]
[364.415702, "o", "> "]
[364.415763, "o", "    })\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[364.415909, "o", "    op.output(\"out\", out, JSONLSink(OUTPUT_PATH))\r\n\u001b[?2004l\r"]
[364.415937, "o", "\u001b[?2004h> "]
[364.416001, "o", "    return flow\r\n\u001b[?2004l\r\u001b[?2004h> "]
[364.416028, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[364.416089, "o", "\u001b[?2004h> "]
[364.41617, "o", "if __name__ == \"__main__\":\r\n\u001b[?2004l\r\u001b[?2004h> "]
[364.416259, "o", "    flow = build_flow()\r\n\u001b[?2004l\r\u001b[?2004h"]
[364.416287, "o", "> "]
[364.416347, "o", "    run_main(flow)\r\n\u001b[?2004l\r"]
[364.416374, "o", "\u001b[?2004h> "]
[364.416436, "o", "PYEOF\r\n\u001b[?2004l\r"]
[364.417736, "o", "\u001b[?2004hroot@72683a99-967c-4608-912c-41c294cdde1a:/home/user/bytewax-sessionization# "]
[364.417803, "o", "python run.py 2>&1\r\n\u001b[?2004l\r"]
