[?2004l[?2004h> """Sessionize user events using Bytewax."""
[?2004l[?2004h> 
[?2004l[?2004h> import json
[?2004l[?2004h> import os
[?2004l[?2004h> from datetime import datetime, timedelta, timezone
[?2004l[?2004h> from typing import List, Optional, Tuple
[?2004l[?2004h> 
[?2004l[?2004h> from bytewax.dataflow import Dataflow
[?2004l[?2004h> import bytewax.operators as op
[?2004l[?2004h> from bytewax.operators.windowing import EventClock, SessionWindower, collect_window
[?2004l[?2004h> from bytewax.inputs import FixedPartitionedSource, StatefulSourcePartition
[?2004l[?2004h> from bytewax.outputs import DynamicSink, StatelessSinkPartition
[?2004l[?2004h> from bytewax._bytewax import run_main
[?2004l[?2004h> from typing_extensions import override
[?2004l[?2004h> 
[?2004l[?2004h> 
[?2004l[?2004h> INPUT_PATH = os.path.join(os.path.dirname(os.path.abspath(__file__)), "user_events.jsonl")
[?2004l[?2004h> OUTPUT_PATH = os.path.join(os.path.dirname(os.path.abspath(__file__)), "sessions.jsonl")
[?2004l[?2004h> 
[?2004l[?2004h> 
[?2004l[?2004h> def parse_timestamp(ts: str) -> datetime:
[?2004l[?2004h>     """Parse an ISO 8601 timestamp string into an aware datetime in UTC."""
[?2004l[?2004h>     if ts.endswith("Z"):
[?2004l[?2004h>         ts = ts[:-1] + "+00:00"
[?2004l[?2004h>     dt = datetime.fromisoformat(ts)
[?2004l[?2004h>     if dt.tzinfo is None:
[?2004l[?2004h>         dt = dt.replace(tzinfo=timezone.utc)
[?2004l[?2004h>     return dt
[?2004l[?2004h> 
[?2004l[?2004h> 
[?2004l[?2004h> def format_timestamp(dt: datetime) -> str:
[?2004l[?2004h>     """Format a datetime back into an ISO 8601 string with 'Z' suffix."""
[?2004l[?2004h>     dt_utc = dt.astimezone(timezone.utc)
[?2004l[?2004h>     s = dt_utc.isoformat()
[?2004l[?2004h>     if s.endswith("+00:00"):
[?2004l[?2004h>         s = s[:-6] + "Z"
[?2004l[?2004h>     return s
[?2004l[?2004h> 
[?2004l[?2004h> 
[?2004l[?2004h> def summarize_session(window_id_and_events: Tuple[int, List[dict]]) -> dict:
[?2004l[?2004h>     """Compute summary metrics for a session of events.
[?2004l[?2004h> 
[?2004l[?2004h>     The mapper receives ``(window_id, List[event])`` because
[?2004l[?2004h>     :py:meth:`collect_window` emits the value as a tuple of
[?2004l[?2004h>     ``(window_id, collected_list)``.
[?2004l[?2004h>     """
[?2004l[?2004h>     _window_id, events = window_id_and_events
[?2004l[?2004h>     times = [parse_timestamp(e["timestamp"]) for e in events]
[?2004l[?2004h>     return {
[?2004l[?2004h>         "session_start": format_timestamp(min(times)),
[?2004l[?2004h>         "session_end": format_timestamp(max(times)),
[?2004l[?2004h>         "event_count": len(events),
[?2004l[?2004h>     }
[?2004l[?2004h> 
[?2004l[?2004h> 
[?2004l[?2004h> class JSONLSource(FixedPartitionedSource[str, int]):
[?2004l[?2004h>     """Read items from a JSON lines file, one item per line."""
[?2004l[?2004h> 
[?2004l[?2004h>     def __init__(self, path: str):
[?2004l[?2004h>         self._path = path
[?2004l[?2004h> 
[?2004l[?2004h>     @override
[?2004l[?2004h>     def list_parts(self) -> List[str]:
[?2004l[?2004h>         return ["singleton"]
[?2004l[?2004h> 
[?2004l[?2004h>     @override
[?2004l[?2004h>     def build_part(
[?2004l[?2004h>         self, step_id: str, for_part: str, resume_state: Optional[int]
[?2004l[?2004h>     ) -> "JSONLPartition":
[?2004l[?2004h>         return JSONLPartition(self._path, resume_state)
[?2004l[?2004h> 
[?2004l[?2004h> 
[?2004l[?2004h> class JSONLPartition(StatefulSourcePartition[str, int]):
[?2004l[?2004h>     def __init__(self, path: str, resume_state: Optional[int]):
[?2004l[?2004h>         self._path = path
[?2004l[?2004h>         self._resume_state = resume_state if resume_state is not None else 0
[?2004l[?2004h>         self._done = False
[?2004l[?2004h> 
[?2004l[?2004h>     @override
[?2004l[?2004h>     def next_batch(self) -> List[str]:
[?2004l[?2004h>         if self._done:
[?2004l[?2004h>             raise StopIteration()
[?2004l[?2004h>         with open(self._path, "r") as f:
[?2004l[?2004h>             lines = f.readlines()
[?2004l[?2004h>         batch = [line.rstrip("\n") for line in lines[self._resume_state:]]
[?2004l[?2004h>         self._done = True
[?2004l[?2004h>         self._resume_state = len(lines)
[?2004l[?2004h>         return batch
[?2004l[?2004h> 
[?2004l[?2004h>     @override
[?2004l[?2004h>     def snapshot(self) -> int:
[?2004l[?2004h>         return self._resume_state
[?2004l[?2004h> 
[?2004l[?2004h> 
[?2004l[?2004h> class JSONLSink(DynamicSink[dict]):
[?2004l[?2004h>     """Write each output dict as a JSON line to the output file."""
[?2004l[?2004h> 
[?2004l[?2004h>     def __init__(self, path: str):
[?2004l[?2004h>         self._path = path
[?2004l[?2004h> 
[?2004l[?2004h>     @override
[?2004l[?2004h>     def build(
[?2004l[?2004h>         self, step_id: str, worker_index: int, worker_count: int
[?2004l[?2004h>     ) -> "JSONLSinkPartition":
[?2004l[?2004h>         return JSONLSinkPartition(self._path)
[?2004l[?2004h> 
[?2004l[?2004h> 
[?2004l[?2004h> class JSONLSinkPartition(StatelessSinkPartition[dict]):
[?2004l[?2004h>     def __init__(self, path: str):
[?2004l[?2004h>         self._fh = open(path, "w")
[?2004l[?2004h> 
[?2004l[?2004h>     @override
[?2004l[?2004h>     def write_batch(self, items: List[dict]) -> None:
[?2004l[?2004h>         for item in items:
[?2004l[?2004h>             self._fh.write(json.dumps(item))
[?2004l[?2004h>             self._fh.write("\n")
[?2004l[?2004h>         self._fh.flush()
[?2004l[?2004h> 
[?2004l[?2004h>     @override
[?2004l[?2004h>     def close(self) -> None:
[?2004l[?2004h>         self._fh.close()
[?2004l[?2004h> 
[?2004l[?2004h> 
[?2004l[?2004h> def build_flow() -> Dataflow:
[?2004l[?2004h>     flow = Dataflow("sessionization")
[?2004l[?2004h> 
[?2004l[?2004h>     # Read raw JSON lines from the input file.
[?2004l[?2004h>     raw = op.input("in", flow, JSONLSource(INPUT_PATH))
[?2004l[?2004h> 
[?2004l[?2004h>     # Parse JSON lines into event dicts.
[?2004l[?2004h>     events = op.map("parse", raw, lambda line: json.loads(line))
[?2004l[?2004h> 
[?2004l[?2004h>     # Group events by user_id.
[?2004l[?2004h>     keyed = op.key_on("by_user", events, lambda e: e["user_id"])
[?2004l[?2004h> 
[?2004l[?2004h>     # Event time clock: extract datetime from each event's timestamp field.
[?2004l[?2004h>     clock = EventClock(
[?2004l[?2004h>         lambda e: parse_timestamp(e["timestamp"]),
[?2004l[?2004h>         wait_for_system_duration=timedelta(seconds=1),
[?2004l[?2004h>     )
[?2004l[?2004h> 
[?2004l[?2004h>     # Session window with 30-minute inactivity gap.
[?2004l[?2004h>     windower = SessionWindower(gap=timedelta(minutes=30))
[?2004l[?2004h> 
[?2004l[?2004h>     # Collect events in each session.
[?2004l[?2004h>     windows = collect_window("session", keyed, clock, windower)
[?2004l[?2004h> 
[?2004l[?2004h>     # `windows.down` is a KeyedStream[(user_id, (window_id, List[event]))].
[?2004l[?2004h>     # Compute session summary metrics.
[?2004l[?2004h>     summaries = op.map_value("summarize", windows.down, summarize_session)
[?2004l[?2004h> 
[?2004l[?2004h>     # Re-key by just the user_id, dropping the window_id.
[?2004l[?2004h>     flat = op.map("flatten", summaries, lambda kv: (kv[0][0], kv[1]))
[?2004l[?2004h> 
[?2004l[?2004h>     # Build the final output record per session.
[?2004l[?2004h>     out = op.map("format_output", flat, lambda kv: {
[?2004l[?2004h>         "user_id": kv[0],
[?2004l[?2004h>         "session_start": kv[1]["session_start"],
[?2004l[?2004h>         "session_end": kv[1]["session_end"],
[?2004l[?2004h>         "event_count": kv[1]["event_count"],
[?2004l[?2004h>     })
[?2004l[?2004h> 
[?2004l[?2004h>     op.output("out", out, JSONLSink(OUTPUT_PATH))
[?2004l[?2004h>     return flow
[?2004l[?2004h> 
[?2004l[?2004h> 
[?2004l[?2004h> if __name__ == "__main__":
[?2004l[?2004h>     flow = build_flow()
[?2004l[?2004h>     run_main(flow)
[?2004l[?2004h> PYEOF
