[62.229706, "o", "tigris buckets list --help 2>&1\r\n\u001b[?2004l\r"]
[62.395774, "o", "Usage: tigris buckets list|l [options] [command]\r\n\r\nList all buckets in the current organization\r\n\r\nOptions:\r\n  --format <value>            Output format (default: \"table\")\r\n  --forks-of [value]          Only list buckets that are forks of the named source bucket\r\n  --deleted                   Only list soft-deleted buckets\r\n  --limit [value]             Maximum number of items to return per page\r\n  --pt, --page-token [value]  Pagination token from a previous request to fetch the next page\r\n  --json                      Output as JSON\r\n  -y, --yes                   Skip confirmation prompts\r\n  -h, --help                  display help for command\r\n\r\nCommands:\r\n  help                        Show help for this command\r\n"]
[62.401679, "o", "\u001b[?2004hroot@885b10cb-812f-4e17-8c79-0758b4a52819:~# "]
[70.68822, "i", "cd /home/user/inv\n"]
[70.688548, "o", "cd /home/user/inv\r\n\u001b[?2004l\r"]
[70.68873, "o", "\u001b[?2004hroot@885b10cb-812f-4e17-8c79-0758b4a52819:/home/user/inv# "]
[71.087624, "i", "cat > /home/user/inv/index.js << 'EOF'\nimport { execFileSync } from \"node:child_process\";\nimport { readFileSync, writeFileSync } from \"node:fs\";\n\nfunction tigrisJSON(args) {\n  const stdout = execFileSync(\"tigris\", args, { encoding: \"utf8\" });\n  return JSON.parse(stdout);\n}\n\nconst runId = readFileSync(\"/logs/artifacts/run-id\", \"utf8\").trim();\nconst PREFIX = `harbor-inv-${runId}-`.toLowerCase().replace(/[^a-z0-9.-]/g, \"-\");\n\nconst bucketsPayload = tigrisJSON([\"buckets\", \"list\", \"--format\", \"json\"]);\nconst allBuckets = Array.isArray(bucketsPayload)\n  ? bucketsPayload\n  : (bucketsPayload.items ?? bucketsPayload.buckets ?? []);\nconst targetNames = allBuckets\n  .map((b) => b.name)\n  .filter((name) => typeof name === \"string\" && name.startsWith(PREFIX))\n  .sort();\n\nconst inventory = {};\nlet total = 0;\nfor (const name of targetNames) {\n  const snapsPayload = tigrisJSON([\"snapshots\", \"list\", name, \"--format\", \"json\"]);\n  const snaps = snapsPayload.snapshots ?? [];\n  const versions = snaps.map((s) => s.version).filter(Boolean).sort();\n  inventory[name] = versions;\n  total += versions.length;\n}\n\nwriteFileSync(\"/home/user/inv/inventory.json\", JSON.stringify(inventory, null, 2) + \"\\n\");\nconsole.log(`${targetNames.length} buckets, ${total} snapshots`);\nEOF\n"]
[71.088269, "o", "cat > /home/user/inv/index.js << 'EOF'\r\n\u001b[?2004l\r"]
