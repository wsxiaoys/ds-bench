[182.274132, "o", "\u001b[1G\u001b[0K\r\n\u001b[31m\u001b[1m2\u001b[22m\u001b[39m vulnerabilities (1 \u001b[33m\u001b[1mmoderate\u001b[22m\u001b[39m, 1 \u001b[31m\u001b[1mhigh\u001b[22m\u001b[39m)\r\n\r\nTo address all issues (including breaking changes), run:\r\n  npm audit fix --force\r\n\r\nRun `npm audit` for details.\r\n⠴"]
[182.275058, "o", "\u001b[1G\u001b[0K\u001b[1mnpm\u001b[22m \u001b[33mwarn\u001b[39m \u001b[94mallow-scripts\u001b[39m 1 package has install scripts not yet covered by allowScripts:\r\n\u001b[1mnpm\u001b[22m \u001b[33mwarn\u001b[39m \u001b[94mallow-scripts\u001b[39m   esbuild@0.21.5 (install: (install scripts present))\r\n\u001b[1mnpm\u001b[22m \u001b[33mwarn\u001b[39m \u001b[94mallow-scripts\u001b[39m\r\n\u001b[1mnpm\u001b[22m \u001b[33mwarn\u001b[39m \u001b[94mallow-scripts\u001b[39m Run `npm approve-scripts --allow-scripts-pending` to review, or `npm approve-scripts <pkg>` to allow.\r\n"]
