[436.245011, "o", "import { useMemo } from 'react'\r\nimport { useQuery } from '@tanstack/react-query'\r\nimport { useNavigate, useSearch } from '@tanstack/react-router'\r\nimport { fetchProducts, Product } from './products'\r\n\r\ninterface CartItem {\r\n  productId: number\r\n  quantity: number\r\n}\r\n\r\ntype CartDetail = {\r\n  product: Product\r\n  productId: number\r\n  quantity: number\r\n  subtotal: number\r\n}\r\n\r\nfunction parseCart(cart: string | undefined): CartItem[] {\r\n  if (!cart) return []\r\n  return cart\r\n    .split(',')\r\n    .map((part) => part.trim())\r\n    .filter(Boolean)\r\n    .map((part): CartItem | null => {\r\n      const [idStr, qtyStr] = part.split(':')\r\n      const productId = Number(idStr)\r\n      const quantity = Number(qtyStr) || 0\r\n      if (!Number.isFinite(productId) || quantity <= 0) return null\r\n      return { productId, quantity }\r\n    })\r\n    .filter((x): x is CartItem => x !== null)\r\n"]
[436.245073, "o", "}\r\n\r\nfunction serializeCart(items: CartItem[]): string {\r\n  return items.map((i) => `${i.productId}:${i.quantity}`).join(',')\r\n}\r\n\r\nexport default function App() {\r\n  const navigate = useNavigate({ from: '/' })\r\n  const search = useSearch({ from: '/' })\r\n\r\n  const { data: products, isLoading, error } = useQuery<Product[]>({\r\n    queryKey: ['products'],\r\n    queryFn: fetchProducts,\r\n  })\r\n\r\n"]
[436.245338, "o", "  // Read cart from URL search params\r\n  const cartString = search.cart\r\n  const cartItems = useMemo(() => parseCart(cartString), [cartString])\r\n\r\n"]
