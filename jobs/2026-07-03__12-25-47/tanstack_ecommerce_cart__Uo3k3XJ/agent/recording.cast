[110.738799, "o", "\u001b[1G\u001b[0K\r\nadded 98 packages, and audited 99 packages in 18s\r\n"]
[110.738912, "o", "⠸\u001b[1G\u001b[0K\r\n⠸"]
[110.738979, "o", "\u001b[1G\u001b[0K24 packages are looking for funding\r\n⠸"]
