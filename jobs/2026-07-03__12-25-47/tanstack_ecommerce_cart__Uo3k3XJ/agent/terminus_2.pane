[?2004l[?2004h> import { useMemo } from 'react'
[?2004l[?2004h> import { useQuery } from '@tanstack/react-query'
[?2004l[?2004h> import { useNavigate } from '@tanstack/react-router'
[?2004l[?2004h> import { fetchProducts, Product } from './products'
[?2004l[?2004h> 
[?2004l[?2004h> interface CartItem {
[?2004l[?2004h>   productId: number
[?2004l[?2004h>   quantity: number
[?2004l[?2004h> }
[?2004l[?2004h> 
[?2004l[?2004h> function parseCart(cart: string | undefined): CartItem[] {
