[?2004limport { useMemo } from 'react'
import { useQuery } from '@tanstack/react-query'
import { useNavigate, useSearch } from '@tanstack/react-router'
import { fetchProducts, Product } from './products'

interface CartItem {
  productId: number
  quantity: number
}

type CartDetail = {
  product: Product
  productId: number
  quantity: number
  subtotal: number
}

function parseCart(cart: string | undefined): CartItem[] {
  if (!cart) return []
  return cart
    .split(',')
    .map((part) => part.trim())
    .filter(Boolean)
    .map((part): CartItem | null => {
      const [idStr, qtyStr] = part.split(':')
      const productId = Number(idStr)
      const quantity = Number(qtyStr) || 0
      if (!Number.isFinite(productId) || quantity <= 0) return null
      return { productId, quantity }
    })
    .filter((x): x is CartItem => x !== null)
}

function serializeCart(items: CartItem[]): string {
  return items.map((i) => `${i.productId}:${i.quantity}`).join(',')
}

export default function App() {
  const navigate = useNavigate({ from: '/' })
  const search = useSearch({ from: '/' })

  const { data: products, isLoading, error } = useQuery<Product[]>({
    queryKey: ['products'],
    queryFn: fetchProducts,
  })

  // Read cart from URL search params
  const cartString = search.cart
  const cartItems = useMemo(() => parseCart(cartString), [cartString])

