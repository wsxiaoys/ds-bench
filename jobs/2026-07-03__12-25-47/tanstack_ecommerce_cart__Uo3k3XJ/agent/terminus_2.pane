[?2004l[?2004h>         ...prev,
[?2004l[?2004h>         cart: serialized || undefined,
[?2004l[?2004h>       }),
[?2004l[?2004h>     })
[?2004l[?2004h>   }
[?2004l[?2004h> 
[?2004l[?2004h>   const addToCart = (productId: number) => {
[?2004l[?2004h>     const existing = cartItems.find((i) => i.productId === productId)
[?2004l[?2004h>     let next: CartItem[]
[?2004l[?2004h>     if (existing) {
[?2004l[?2004h>       next = cartItems.map((i) =>
[?2004l[?2004h>         i.productId === productId ? { ...i, quantity: i.quantity + 1 } : i,
[?2004l[?2004h>       )
[?2004l[?2004h>     } else {
[?2004l[?2004h>       next = [...cartItems, { productId, quantity: 1 }]
[?2004l[?2004h>     }
[?2004l[?2004h>     updateCart(next)
[?2004l[?2004h>   }
[?2004l[?2004h> 
