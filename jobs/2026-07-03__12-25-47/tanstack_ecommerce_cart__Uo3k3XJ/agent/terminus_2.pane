[?2004l[?2004h>   return cart
[?2004l[?2004h>     .split(',')
[?2004l[?2004h>     .map((part) => part.trim())
[?2004l[?2004h>     .filter(Boolean)
[?2004l[?2004h>     .map((part) => {
[?2004l[?2004h>       const [idStr, qtyStr] = part.split(':')
[?2004l[?2004h>       const productId = Number(idStr)
[?2004l[?2004h>       const quantity = Number(qtyStr) || 0
[?2004l[?2004h>       if (!Number.isFinite(productId) || quantity <= 0) return null
[?2004l[?2004h>       return { productId, quantity }
[?2004l[?2004h>     })
