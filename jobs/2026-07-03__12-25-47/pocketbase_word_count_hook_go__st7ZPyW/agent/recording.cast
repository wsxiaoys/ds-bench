[124.664846, "o", "package main\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[124.66488, "o", "\u001b[?2004h> "]
[124.664904, "o", "import (\r\n\u001b[?2004l\r"]
[124.664961, "o", "\u001b[?2004h> "]
[124.664999, "o", "\u0007"]
[124.665036, "o", "\"log\"\r\n\u001b[?2004l\r\u001b[?2004h> "]
[124.665078, "o", "\u0007"]
[124.665115, "o", "\"math\"\r\n\u001b[?2004l\r\u001b[?2004h"]
[124.665152, "o", "> \u0007"]
[124.665194, "o", "\"strings\"\r\n\u001b[?2004l\r"]
[124.66522, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[124.665246, "o", "\u001b[?2004h> "]
[124.665273, "o", "\u0007"]
[124.665397, "o", "\"github.com/pocketbase/pocketbase\"\r\n\u001b[?2004l\r\u001b[?2004h"]
[124.66544, "o", "> \u0007"]
[124.665557, "o", "\"github.com/pocketbase/pocketbase/core\"\r\n\u001b[?2004l\r"]
[124.66558, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[124.665626, "o", "\u001b[?2004h> "]
[124.665647, "o", "\u0007"]
[124.665716, "o", "_ \"pbapp/migrations\"\r\n\u001b[?2004l\r"]
[124.665739, "o", "\u001b[?2004h> )\r\n\u001b[?2004l\r"]
[124.665763, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[124.665784, "o", "\u001b[?2004h> "]
[124.665959, "o", "func computeContentFields(content string) (int, int) {\r\n\u001b[?2004l\r"]
[124.665981, "o", "\u001b[?2004h> "]
[124.666038, "o", "\u0007"]
[124.666116, "o", "words := strings.Fields(content)\r\n\u001b[?2004l\r"]
[124.666138, "o", "\u001b[?2004h> "]
[124.666173, "o", "\u0007"]
[124.666262, "o", "wordCount := len(words)\r\n\u001b[?2004l\r\u001b[?2004h"]
[124.666306, "o", "> \u0007"]
[124.666356, "o", "readingTime := 0\r\n\u001b[?2004l\r"]
[124.666378, "o", "\u001b[?2004h> "]
[124.666428, "o", "\u0007"]
[124.666473, "o", "if wordCount > 0 {\r\n\u001b[?2004l\r"]
[124.666497, "o", "\u001b[?2004h> "]
[124.666553, "o", "\u0007"]
[124.666575, "o", "\r\n"]
[124.666599, "o", "go.mod      go.sum      main.go     migrations/ \r\n> "]
[124.66676, "o", "readingTime = int(math.Ceil(float64(wordCount) / 200.0))\r\n\u001b[?2004l\r"]
[124.666782, "o", "\u001b[?2004h> "]
[124.66683, "o", "\u0007}\r\n\u001b[?2004l\r"]
[124.666852, "o", "\u001b[?2004h> "]
[124.666899, "o", "\u0007"]
[124.666978, "o", "return wordCount, readingTime\r\n\u001b[?2004l\r"]
[124.666999, "o", "\u001b[?2004h> }\r\n"]
[124.667043, "o", "\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[124.667067, "o", "\u001b[?2004h> "]
[124.667216, "o", "func articlesHook(e *core.RecordRequestEvent) error {\r\n\u001b[?2004l\r"]
[124.667237, "o", "\u001b[?2004h> "]
[124.667272, "o", "\u0007"]
[124.667392, "o", "content := e.Record.GetString(\"content\")\r\n\u001b[?2004l\r"]
[124.667414, "o", "\u001b[?2004h> "]
[124.667459, "o", "\u0007"]
[124.667616, "o", "wordCount, readingTime := computeContentFields(content)\r\n\u001b[?2004l\r"]
[124.66764, "o", "\u001b[?2004h> "]
[124.667696, "o", "\u0007"]
[124.667783, "o", "e.Record.Set(\"word_count\", wordCount)\r\n\u001b[?2004l\r"]
[124.667805, "o", "\u001b[?2004h> "]
[124.667858, "o", "\u0007"]
[124.667982, "o", "e.Record.Set(\"reading_time_minutes\", readingTime)\r\n\u001b[?2004l\r"]
[124.668003, "o", "\u001b[?2004h> "]
[124.668048, "o", "\u0007"]
[124.668094, "o", "return e.Next()\r\n\u001b[?2004l\r"]
[124.668116, "o", "\u001b[?2004h> }\r\n"]
[124.668165, "o", "\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[124.668186, "o", "> "]
[124.668231, "o", "func main() {\r\n\u001b[?2004l\r"]
[124.668253, "o", "\u001b[?2004h> "]
[124.668298, "o", "\u0007"]
[124.668361, "o", "app := pocketbase.New()\r\n\u001b[?2004l\r"]
[124.668382, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[124.668436, "o", "\u001b[?2004h> "]
[124.668459, "o", "\u0007"]
[124.668699, "o", "app.OnRecordCreateRequest(\"articles\").BindFunc(func(e *core.RecordRequestEvent) error {\r\n\u001b[?2004l\r"]
[124.668724, "o", "\u001b[?2004h> "]
[124.668783, "o", "\u0007\r\n"]
[124.668805, "o", "go.mod      go.sum      main.go     migrations/ \r\n> "]
[124.668883, "o", "return articlesHook(e)\r\n\u001b[?2004l\r"]
[124.668929, "o", "\u001b[?2004h> \u0007})\r\n"]
[124.668971, "o", "\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[124.668996, "o", "\u001b[?2004h> "]
[124.66902, "o", "\u0007"]
[124.669271, "o", "app.OnRecordUpdateRequest(\"articles\").BindFunc(func(e *core.RecordRequestEvent) error {\r\n\u001b[?2004l\r"]
[124.669296, "o", "\u001b[?2004h> "]
[124.66935, "o", "\u0007\r\n"]
[124.66941, "o", "go.mod      go.sum      main.go     migrations/ \r\n> "]
[124.669485, "o", "return articlesHook(e)\r\n\u001b[?2004l\r"]
[124.669509, "o", "\u001b[?2004h> "]
[124.669715, "o", "\u0007})\r\n\u001b[?2004l\r"]
[124.669738, "o", "\u001b[?2004h> "]
[124.669764, "o", "\r\n\u001b[?2004l\r\u001b[?2004h"]
[124.669829, "o", "> \u0007"]
[124.669923, "o", "if err := app.Start(); err != nil {\r\n\u001b[?2004l\r"]
[124.669946, "o", "\u001b[?2004h> "]
[124.669983, "o", "\u0007"]
[124.670035, "o", "\r\ngo.mod      go.sum      main.go     migrations/ \r\n> "]
[124.670082, "o", "log.Fatal(err)\r\n\u001b[?2004l\r"]
[124.670104, "o", "\u001b[?2004h> "]
[124.670128, "o", "\u0007"]
[124.67019, "o", "}\r\n\u001b[?2004l\r\u001b[?2004h> }\r\n\u001b[?2004l\r"]
