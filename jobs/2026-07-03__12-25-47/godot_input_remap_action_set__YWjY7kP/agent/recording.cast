[57.178496, "i", "python3 -c \"\nimport sys\nTAB = chr(9)\ncontent = 'extends Node\\n\\nsignal action_rebound(action: StringName, event: InputEvent)\\n\\nvar _defaults: Dictionary = {}\\n\\nfunc _ready() -> void:\\n' + TAB + '_capture_defaults()\\n\\nfunc _capture_defaults() -> void:\\n' + TAB + '_defaults.clear()\\n' + TAB + 'for action in InputMap.get_actions():\\n' + TAB*2 + '_defaults[action] = InputMap.action_get_events(action).duplicate()\\n\\nfunc rebind_action(action: StringName, new_event: InputEvent) -> void:\\n' + TAB + 'if not InputMap.has_action(action):\\n' + TAB*2 + 'return\\n' + TAB + 'var events: Array = InputMap.action_get_events(action)\\n' + TAB + 'for ev in events:\\n' + TAB*2 + 'if ev is InputEventKey or ev is InputEventJoypadButton:\\n' + TAB*3 + 'InputMap.action_erase_event(action, ev)\\n' + TAB + 'InputMap.action_add_event(action, new_event)\\n' + TAB + 'emit_signal(\\\"action_rebound\\\", action, new_event)\\n\\nfunc get_action_event(action: StringName) -> InputEvent:\\n' + TAB + 'if not InputMap.has_action(action):\\n' + TAB*2 + 'return null\\n' + TAB + 'var events: Array = InputMap.action_get_events(action)\\n' + TAB + 'if events.is_empty():\\n' + TAB*2 + 'return null\\n' + TAB + 'return events[0]\\n\\nfunc save_to_file(path: String = \\\"user://input_map.cfg\\\") -> void:\\n' + TAB + 'var cfg := ConfigFile.new()\\n' + TAB + 'for action in InputMap.get_actions():\\n' + TAB*2 + 'var events: Array = InputMap.action_get_events(action)\\n' + TAB*2 + 'var serialized: Array = []\\n' + TAB*2 + 'for ev in events:\\n' + TAB*3 + 'if ev is InputEventKey:\\n' + TAB*4 + 'serialized.append({\\n' + TAB*5 + '\\\"type\\\": \\\"key\\\",\\n' + TAB*5 + '\\\"keycode\\\": ev.keycode,\\n' + TAB*5 + '\\\"physical_keycode\\\": ev.physical_keycode,\\n' + TAB*4 + '})\\n' + TAB*3 + 'elif ev is InputEventJoypadButton:\\n' + TAB*4 + 'serialized.append({\\n' + TAB*5 + '\\\"type\\\": \\\"joypad_button\\\",\\n' + TAB*5 + '\\\"button_index\\\": ev.button_index,\\n' + TAB*4 + '})\\n' + TAB*2 + 'cfg.set_value(action, \\\"events\\\", serialized)\\n' + TAB + 'cfg.save(path)\\n\\nfunc load_from_file(path: String = \\\"user://input_map.cfg\\\") -> bool:\\n' + TAB + 'if not FileAccess.file_exists(path):\\n' + TAB*2 + 'return false\\n' + TAB + 'var cfg := ConfigFile.new()\\n' + TAB + 'var err := cfg.load(path)\\n' + TAB + 'if err != OK:\\n' + TAB*2 + 'return false\\n' + TAB + 'for action in InputMap.get_actions():\\n' + TAB*2 + 'if not cfg.has_section(action):\\n' + TAB*3 + 'continue\\n' + TAB*2 + 'var serialized: Array = cfg.get_value(action, \\\"events\\\", [])\\n' + TAB*2 + 'var existing: Array = InputMap.action_get_events(action)\\n' + TAB*2 + 'for ev in existing:\\n' + TAB*3 + 'if ev is InputEventKey or ev is InputEventJoypadButton:\\n' + TAB*4 + 'InputMap.action_erase_event(action, ev)\\n' + TAB*2 + 'for entry in serialized:\\n' + TAB*3 + 'var ev: InputEvent = null\\n' + TAB*3 + 'var type_str: String = entry.get(\\\"type\\\", \\\"\\\")\\n' + TAB*3 + 'if type_str == \\\"key\\\":\\n' + TAB*4 + 'var key_event := InputEventKey.new()\\n' + TAB*4 + 'key_event.keycode = int(entry.get(\\\"keycode\\\", 0))\\n' + TAB*4 + 'key_event.physical_keycode = int(entry.get(\\\"physical_keycode\\\", 0))\\n' + TAB*4 + 'ev = key_event\\n' + TAB*3 + 'elif type_str == \\\"joypad_button\\\":\\n' + TAB*4 + 'var joy_event := InputEventJoypadButton.new()\\n' + TAB*4 + 'joy_event.button_index = int(entry.get(\\\"button_index\\\", 0))\\n' + TAB*4 + 'ev = joy_event\\n' + TAB*3 + 'if ev != null:\\n' + TAB*4 + 'InputMap.action_add_event(action, ev)\\n' + TAB + 'return true\\n\\nfunc reset_to_defaults() -> void:\\n' + TAB + 'for action in InputMap.get_actions():\\n' + TAB*2 + 'if not _defaults.has(action):\\n' + TAB*3 + 'continue\\n' + TAB*2 + 'var existing: Array = InputMap.action_get_events(action)\\n' + TAB*2 + 'for ev in existing:\\n' + TAB*3 + 'if ev is InputEventKey or ev is InputEventJoypadButton:\\n' + TAB*4 + 'InputMap.action_erase_event(action, ev)\\n' + TAB*2 + 'for ev in _defaults[action]:\\n' + TAB*3 + 'InputMap.action_add_event(action, ev)\\n'\nwith open('/home/user/input_remap/REDACTEDloads/InputRemapper.gd', 'w') as f:\n    f.write(content)\nprint('Written')\n\"\n"]
