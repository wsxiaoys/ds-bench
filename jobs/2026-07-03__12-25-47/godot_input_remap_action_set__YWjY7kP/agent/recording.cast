[57.653957, "o", "extends Node$\r\n$\r\nsignal action_rebound(action: StringName, event: InputEvent)$\r\n$\r\nvar _defaults: Dictionary = {}$\r\n$\r\nfunc _ready() -> void:$\r\n^I_capture_defaults()$\r\n$\r\nfunc _capture_defaults() -> void:$\r\n^I_defaults.clear()$\r\n^Ifor action in InputMap.get_actions():$\r\n^I^I_defaults[action] = InputMap.action_get_events(action).duplicate()$\r\n$\r\nfunc rebind_action(action: StringName, new_event: InputEvent) -> void:$\r\n^Iif not InputMap.has_action(action):$\r\n^I^Ireturn$\r\n^Ivar events: Array = InputMap.action_get_events(action)$\r\n^Ifor ev in events:$\r\n^I^Iif ev is InputEventKey or ev is InputEventJoypadButton:$\r\n"]
