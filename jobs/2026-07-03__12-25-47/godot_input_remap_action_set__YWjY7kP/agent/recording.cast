[44.669698, "o", "\r\n./        ../       .bashrc   .cache/   .config/  .daytona/ .pochi/   .profile  \r\n> .continue\r\n\u001b[?2004l\r\u001b[?2004h> \u0007.\u0007var existing: Array = InputMap.action_get_events(action)\r\n\u001b[?2004l\r\u001b[?2004h> \u0007.\u0007for ev in existing:\r\n\u001b[?2004l\r\u001b[?2004h> \u0007.\u0007\r\n./        ../       .bashrc   .cache/   .config/  .daytona/ .pochi/   .profile  \r\n> .if ev is InputEventKey or ev is InputEventJoypadButton:\r\n\u001b[?2004l\r\u001b[?2004h> \u0007.\u0007\r\n./        ../       .bashrc   .cache/   .config/  .daytona/ .pochi/   .profile  \r\n> .\r\n./        ../       .bashrc   .cache/   .config/  .daytona/ .pochi/   .profile  \r\n> .InputMap.action_erase_event(action, ev)\r\n\u001b[?2004l\r\u001b[?2004h> \u0007.\u0007for ev in _defaults[action]:\r\n\u001b[?2004l\r\u001b[?2004h> \u0007.\u0007\r\n./        ../       .bashrc   .cache/   .config/  .daytona/ .pochi/   .profile  \r\n> .InputMap.action_add_event(action, ev)\r\n\u001b[?2004l\r\u001b[?2004h> '''\r\n\u001b[?2004l\r\u001b[?2004h> "]
