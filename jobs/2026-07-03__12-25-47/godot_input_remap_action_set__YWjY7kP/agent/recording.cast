[64.659807, "o", "extends Button$\r\n$\r\n@export var action_name: StringName$\r\n$\r\nvar _listening: bool = false$\r\n$\r\nfunc _ready() -> void:$\r\n^I_refresh_text()$\r\n^Ipressed.connect(_on_pressed)$\r\n$\r\nfunc _on_pressed() -> void:$\r\n^I_listening = true$\r\n^Itext = \"...\"$\r\n^Irelease_focus()$\r\n$\r\nfunc _refresh_text() -> void:$\r\n^Ivar ev: InputEvent = InputRemapper.get_action_event(action_name)$\r\n^Iif ev == null:$\r\n^I^Itext = \"<empty>\"$\r\n^Ielse:$\r\n^I^Itext = ev.as_text()$\r\n$\r\nfunc _unhandled_input(event: InputEvent) -> void:$\r\n^Iif not _listening:$\r\n^I^Ireturn$\r\n^Iif event is InputEventKey or event is InputEventJoypadButton:$\r\n^I^Ivar captured: InputEvent = event$\r\n^I^I_listening = false$\r\n^I^IInputRemapper.rebind_action(action_name, captured)$\r\n^I^I_refresh_text()$\r\n^I^Iaccept_event()$\r\n^Ielif event is InputEventMouseButton and event.pressed:$\r\n^I^I# Allow clicking elsewhere to cancel$\r\n^I^Ipass$\r\n"]
