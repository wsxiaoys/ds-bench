[64.17573, "i", "python3 << 'PYEOF'\nimport os\nTAB = chr(9)\ncontent = 'extends Button\\n\\n@export var action_name: StringName\\n\\nvar _listening: bool = false\\n\\nfunc _ready() -> void:\\n' + TAB + '_refresh_text()\\n' + TAB + 'pressed.connect(_on_pressed)\\n\\nfunc _on_pressed() -> void:\\n' + TAB + '_listening = true\\n' + TAB + 'text = \\\"...\\\"\\n' + TAB + 'release_focus()\\n\\nfunc _refresh_text() -> void:\\n' + TAB + 'var ev: InputEvent = InputRemapper.get_action_event(action_name)\\n' + TAB + 'if ev == null:\\n' + TAB*2 + 'text = \\\"<empty>\\\"\\n' + TAB + 'else:\\n' + TAB*2 + 'text = ev.as_text()\\n\\nfunc _unhandled_input(event: InputEvent) -> void:\\n' + TAB + 'if not _listening:\\n' + TAB*2 + 'return\\n' + TAB + 'if event is InputEventKey or event is InputEventJoypadButton:\\n' + TAB*2 + 'var captured: InputEvent = event\\n' + TAB*2 + '_listening = false\\n' + TAB*2 + 'InputRemapper.rebind_action(action_name, captured)\\n' + TAB*2 + '_refresh_text()\\n' + TAB*2 + 'accept_event()\\n' + TAB + 'elif event is InputEventMouseButton and event.pressed:\\n' + TAB*2 + '# Allow clicking elsewhere to cancel\\n' + TAB*2 + 'pass\\n'\nwith open('/home/user/input_remap/scenes/RemapButton.gd', 'w') as f:\n    f.write(content)\nprint('Written RemapButton.gd')\nPYEOF\n"]
