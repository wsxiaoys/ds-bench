[71.928972, "i", "python3 << 'PYEOF'\nimport os\ntscn = '''[gd_scene load_steps=2 format=3 uid=\"uid://b1234567890ab\"]\n\n[ext_resource type=\"Script\" path=\"res://scenes/RemapButton.gd\" id=\"1_remap\"]\n\n[node name=\"RemapButton\" type=\"Button\"]\ncustom_minimum_size = Vector2(200, 40)\ntext = \"<unbound>\"\nscript = ExtResource(\"1_remap\")\naction_name = &\"\"\n'''\nwith open('/home/user/input_remap/scenes/RemapButton.tscn', 'w') as f:\n    f.write(tscn)\nprint('Written RemapButton.tscn')\nPYEOF\n"]
