[?2004lextends Button$
$
@export var action_name: StringName$
$
var _listening: bool = false$
$
func _ready() -> void:$
^I_refresh_text()$
^Ipressed.connect(_on_pressed)$
$
func _on_pressed() -> void:$
^I_listening = true$
^Itext = "..."$
^Irelease_focus()$
$
func _refresh_text() -> void:$
^Ivar ev: InputEvent = InputRemapper.get_action_event(action_name)$
^Iif ev == null:$
^I^Itext = "<empty>"$
^Ielse:$
^I^Itext = ev.as_text()$
$
func _unhandled_input(event: InputEvent) -> void:$
^Iif not _listening:$
^I^Ireturn$
^Iif event is InputEventKey or event is InputEventJoypadButton:$
^I^Ivar captured: InputEvent = event$
^I^I_listening = false$
^I^IInputRemapper.rebind_action(action_name, captured)$
^I^I_refresh_text()$
^I^Iaccept_event()$
^Ielif event is InputEventMouseButton and event.pressed:$
^I^I# Allow clicking elsewhere to cancel$
^I^Ipass$
