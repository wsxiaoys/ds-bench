[134.971496, "o", "<!DOCTYPE html>\r\n<html>\r\n<head>\r\n  <meta charset=\"UTF-8\">\r\n  <style>\r\n    #vis.vega-embed {\r\n      width: 100%;\r\n      display: flex;\r\n    }\r\n\r\n    #vis.vega-embed details,\r\n    #vis.vega-embed details summary {\r\n      position: relative;\r\n    }\r\n  </style>\r\n  <script type=\"text/javascript\" src=\"https://cdn.jsdelivr.net/npm/vega@6\"></script>\r\n  <script type=\"text/javascript\" src=\"https://cdn.jsdelivr.net/npm/vega-lite@6.4.1\"></script>\r\n  <script type=\"text/javascript\" src=\"https://cdn.jsdelivr.net/npm/vega-embed@7\"></script>\r\n</head>\r\n<body>\r\n  <div id=\"vis\"></div>\r\n  <script>\r\n    (function(vegaEmbed) {\r\n      var spec = {\"config\": {\"view\": {\"continuousWidth\": 300, \"continuousHeight\": 300}}, \"data\": {\"url\": \"https://cdn.jsdelivr.net/npm/vega-datasets@v3.2.1/data/barley.json\"}, \"facet\": {\"field\": \"year\", \"title\": \"Year\", \"type\": \"ordinal\"}, \"spec\": {\"layer\": [{\"mark\": {\"type\": \"bar\"}, \"encoding\": {\"color\": {\"field\": \"variety\", \"scale\": {\"scheme\": \"tableau10\"}, \"title\": \"Variety\", \"type\": \"nominal\"}, \"tooltip\": [{\"field\": \"site\", \"type\": \"nominal\"}, {\"field\": \"variety\", \"type\": \"nominal\"}, {\"aggregate\": \"mean\", \"field\": \"yield\", \"type\": \"quantitative\"}], \"x\": {\"field\": \"site\", \"sort\": {\"field\": \"mean(yield)\", \"op\": \"mean\", \"order\": \"descending\"}, \"title\": \"Site\", \"type\": \"nominal\"}, \"xOffset\": {\"field\": \"variety\", \"title\": \"Variety\", \"type\": \"nominal\"}, \"y\": {\"aggregate\": \"mean\", \"field\": \"yield\", \"title\": \"Mean Yield\", \"type\": \"quantitative\"}}}, {\"mark\": {\"type\": \"tick\", \"color\": \"black\", \"size\": 40, \"thickness\": 3}, \"encoding\": {\"x\": {\"field\": \"site\", \"sort\": {\"field\": \"mean(yield)\", \"op\": \"mean\", \"order\": \"descending\"}, \"title\": \"Site\", \"type\": \"nominal\"}, \"y\": {\"field\": \"mean_yield\", \"title\": \"Mean Yield\", \"type\": \"quantitative\"}}, \"transform\": [{\"aggregate\": [{\"op\": \"mean\", \"field\": \"yield\", \"as\": \"mean_yield\"}], \"groupby\": [\"site\", \"year\"]}]}], \"height\": 200, \"width\": 240}, \"columns\": 2, \"title\": {\"text\": \"Barley Yield by Variety and Site\", \"subtitle\": \"Grouped bars: mean yield per (site, variety); black ticks: per-site mean across varieties.\"}, \"$schema\": \"https://vega.github.io/schema/vega-lite/v6.4.1.json\"};\r\n      var embedOpt = {\"mode\": \"vega-lite\"};\r\n\r\n      function showError(el, error){\r\n          el.innerHTML = ('<div style=\"color:red;\">'\r\n                          + '<p>JavaScript Error: ' + error.message + '</p>'\r\n                          + \"<p>This usually means there's a typo in your chart specification. \"\r\n                          + \"See the javascript console for the full traceback.</p>\"\r\n                          + '</div>');\r\n          throw error;\r\n      }\r\n      const el = document.getElementById('vis');\r\n      vegaEmbed(\"#vis\", spec, embedOpt)\r\n        .catch(error => showError(el, error));\r\n    })(vegaEmbed);\r\n\r\n  </script>\r\n</body>\r\n</html>"]
[134.971683, "o", "\u001b[?2004hroot@6288ead0-b8e5-4bf0-8113-5504bd801301:/home/user/altair_task# "]
[144.463273, "i", "python3 << 'EOF'\nimport json, re\nhtml = open('/home/user/altair_task/output/chart.html').read()\nm = re.search(r'var spec = (.*?);\\s+var embedOpt', html, re.S)\nassert m, \"spec not found\"\nspec = json.loads(m.group(1))\nprint(\"Keys:\", list(spec.keys()))\nprint(\"Data:\", spec.get(\"data\"))\nprint(\"Facet:\", spec.get(\"facet\"))\nlayers = spec[\"spec\"][\"layer\"]\nprint(\"Number of layers:\", len(layers))\nfor i, l in enumerate(layers):\n    print(f\"Layer {i}: mark={l['mark'].get('type')}, transform={'transform' in l}\")\nprint(\"Title:\", spec.get(\"title\"))\n# Verify bar marks\nbar_layer = layers[0]\nassert bar_layer['mark']['type'] == 'bar'\nassert bar_layer['encoding']['xOffset']['field'] == 'variety'\nassert bar_layer['encoding']['color']['field'] == 'variety'\nassert bar_layer['encoding']['color']['scale']['scheme'] == 'tableau10'\nassert bar_layer['encoding']['x']['sort'] == {'field': 'mean(yield)', 'op': 'mean', 'order': 'descending'}\nassert bar_layer['encoding']['y'] == {'aggregate': 'mean', 'field': 'yield', 'title': 'Mean Yield', 'type': 'quantitative'}\nprint(\"Bar layer OK\")\n# Verify tick layer\ntick_layer = layers[1]\nassert tick_layer['mark']['type'] == 'tick'\nassert tick_layer['transform'][0]['aggregate'] == [{'op': 'mean', 'field': 'yield', 'as': 'mean_yield'}]\nassert tick_layer['transform'][0]['groupby'] == ['site', 'year']\nprint(\"Tick layer OK\")\n# Verify title\nassert 'text' in spec['title']\nassert 'subtitle' in spec['title']\nprint(\"Title OK\")\n# Verify facet\nassert spec['facet']['field'] == 'year'\nprint(\"All checks passed!\")\nEOF\n"]
[144.463454, "o", "python3 << 'EOF'\r\n\u001b[?2004l\r"]
