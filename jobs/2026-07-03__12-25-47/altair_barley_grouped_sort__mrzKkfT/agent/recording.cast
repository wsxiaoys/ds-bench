[144.48427, "o", "Keys: ['config', 'data', 'facet', 'spec', 'columns', 'title', '$schema']\r\nData: {'url': 'https://cdn.jsdelivr.net/npm/vega-datasets@v3.2.1/data/barley.json'}\r\nFacet: {'field': 'year', 'title': 'Year', 'type': 'ordinal'}\r\nNumber of layers: 2\r\nLayer 0: mark=bar, transform=False\r\nLayer 1: mark=tick, transform=True\r\nTitle: {'text': 'Barley Yield by Variety and Site', 'subtitle': 'Grouped bars: mean yield per (site, variety); black ticks: per-site mean across varieties.'}\r\nBar layer OK\r\nTick layer OK\r\nTitle OK\r\n"]
[144.48438, "o", "All checks passed!\r\n"]
