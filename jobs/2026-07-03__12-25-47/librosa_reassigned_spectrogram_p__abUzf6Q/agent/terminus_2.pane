[?2004l[?2004h> print('n_frames:', freqs.shape[-1])
[?2004l[?2004h> print('first times:', times[0, :5] if times.ndim == 2 else times[:5])
[?2004l[?2004h> print('last time:', times[0, -1] if times.ndim == 2 else times[-1])
[?2004l[?2004h> 
