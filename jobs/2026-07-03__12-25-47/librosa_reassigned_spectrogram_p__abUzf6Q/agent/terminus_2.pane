[?2004l[?2004h>     # Also require freq > 0 and <= sr/2
[?2004l[?2004h>     valid_mask = finite_mask & (f_col > 0.0) & (f_col <= sr / 2.0)
[?2004l[?2004h>     
[?2004l[?2004h>     valid_idx = np.where(valid_mask)[0]
[?2004l[?2004h>     
[?2004l[?2004h>     if len(valid_idx) == 0:
