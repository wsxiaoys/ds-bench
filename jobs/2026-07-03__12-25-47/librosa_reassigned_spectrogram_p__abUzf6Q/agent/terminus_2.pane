[?2004l[?2004h>     m_col = mags_db[:, t_idx] if mags_db.ndim == 2 else mags_db[..., t_idx]
[?2004l[?2004h>     
[?2004l[?2004h>     # Mask out NaN/inf in frequencies (and corresponding magnitudes)
