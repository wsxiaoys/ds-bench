[?2004l[?2004h>     y = np.mean(y, axis=1)
[?2004l[?2004h> duration = len(y) / sr
[?2004l[?2004h> 
[?2004l[?2004h> # STFT parameters
[?2004l[?2004h> n_fft = 2048
[?2004l[?2004h> hop_length = 512
[?2004l[?2004h> 
[?2004l[?2004h> # Compute reassigned spectrogram
[?2004l[?2004h> # Returns (freqs, times, mags)
[?2004l[?2004h> freqs, times, mags = librosa.reassigned_spectrogram(
[?2004l[?2004h>     y, sr=sr, n_fft=n_fft, hop_length=hop_length, center=True
[?2004l[?2004h> )
[?2004l[?2004h> 
