[?2004l[?2004h> 
[?2004l[?2004h> # Convert magnitudes to dB
[?2004l[?2004h> mags_db = librosa.amplitude_to_db(mags, ref=np.max)
[?2004l[?2004h> 
[?2004l[?2004h> # For each frame, get top-5 peaks
[?2004l[?2004h> frames_out = []
[?2004l[?2004h> for t_idx in range(n_frames):
