[85.724037, "i", "python3 -c \"\nimport json\nimport numpy as np\nwith open('/home/user/peaks.json') as f:\n    data = json.load(f)\nprint('meta:', data['meta'])\nprint('len(frames):', len(data['frames']))\nassert data['meta']['n_frames'] == len(data['frames'])\nassert data['meta']['sr'] == 22050\nassert data['meta']['n_fft'] == 2048\nassert data['meta']['hop_length'] == 512\nprev_time = -1\nfor i, fr in enumerate(data['frames']):\n    assert len(fr['peaks']) == 5, f'frame {i} has {len(fr[\\\"peaks\\\"])} peaks'\n    assert np.isfinite(fr['time']), f'frame {i} time not finite'\n    assert fr['time'] >= prev_time - 1e-9, f'frame {i} time {fr[\\\"time\\\"]} < prev {prev_time}'\n    assert fr['time'] <= 5.01, f'frame {i} time {fr[\\\"time\\\"]} > 5.01'\n    prev_time = fr['time']\n    prev_mag = float('inf')\n    for p in fr['peaks']:\n        assert np.isfinite(p['freq_hz']), f'frame {i} freq not finite'\n        assert 0.0 < p['freq_hz'] <= 11025.0, f'frame {i} freq out of range: {p[\\\"freq_hz\\\"]}'\n        assert np.isfinite(p['magnitude_db']), f'frame {i} mag not finite'\n        assert p['magnitude_db'] <= prev_mag + 1e-9, f'frame {i} not sorted: {p[\\\"magnitude_db\\\"]} > {prev_mag}'\n        prev_mag = p['magnitude_db']\nlast_time = data['frames'][-1]['time']\nprint('last time:', last_time)\nassert abs(last_time - 5.0) <= 0.1, f'last time {last_time} not within 0.1 of 5.0'\nprint('ALL CHECKS PASSED')\n\"\n"]
[85.724273, "o", "python3 -c \"\r\n\u001b[?2004l\r"]
[85.72432, "o", "\u001b[?2004h> "]
[85.724359, "o", "import json\r\n\u001b[?2004l\r"]
[85.724381, "o", "\u001b[?2004h> "]
[85.724437, "o", "import numpy as np\r\n\u001b[?2004l\r"]
[85.724458, "o", "\u001b[?2004h> "]
[85.724565, "o", "with open('/home/user/peaks.json') as f:\r\n\u001b[?2004l\r"]
[85.724587, "o", "\u001b[?2004h> "]
[85.724671, "o", "    data = json.load(f)\r\n\u001b[?2004l\r\u001b[?2004h"]
[85.724693, "o", "> "]
[85.724767, "o", "print('meta:', data['meta'])\r\n\u001b[?2004l\r"]
[85.724788, "o", "\u001b[?2004h> "]
[85.724903, "o", "print('len(frames):', len(data['frames']))\r\n\u001b[?2004l\r\u001b[?2004h"]
[85.724924, "o", "> "]
[85.725069, "o", "assert data['meta']['n_frames'] == len(data['frames'])\r\n\u001b[?2004l\r"]
[85.725089, "o", "\u001b[?2004h> "]
[85.725187, "o", "assert data['meta']['sr'] == 22050\r\n\u001b[?2004l\r\u001b[?2004h"]
[85.725209, "o", "> "]
[85.725308, "o", "assert data['meta']['n_fft'] == 2048\r\n\u001b[?2004l\r\u001b[?2004h"]
[85.72533, "o", "> "]
[85.725436, "o", "assert data['meta']['hop_length'] == 512\r\n\u001b[?2004l\r"]
[85.725457, "o", "\u001b[?2004h> "]
[85.725502, "o", "prev_time = -1\r\n\u001b[?2004l\r"]
[85.725523, "o", "\u001b[?2004h> "]
[85.725637, "o", "for i, fr in enumerate(data['frames']):\r\n\u001b[?2004l\r"]
[85.725658, "o", "\u001b[?2004h> "]
[85.725871, "o", "    assert len(fr['peaks']) == 5, f'frame {i} has {len(fr[\\\"peaks\\\"])} peaks'\r\n\u001b[?2004l\r"]
[85.725894, "o", "\u001b[?2004h> "]
[85.726063, "o", "    assert np.isfinite(fr['time']), f'frame {i} time not finite'\r\n\u001b[?2004l\r"]
[85.726084, "o", "\u001b[?2004h> "]
[85.726331, "o", "    assert fr['time'] >= prev_time - 1e-9, f'frame {i} time {fr[\\\"time\\\"]} < prev {prev_time}'\r\n\u001b[?2004l\r"]
[85.726352, "o", "\u001b[?2004h> "]
[85.726536, "o", "    assert fr['time'] <= 5.01, f'frame {i} time {fr[\\\"time\\\"]} > 5.01'\r\n\u001b[?2004l\r"]
[85.726557, "o", "\u001b[?2004h> "]
[85.726635, "o", "    prev_time = fr['time']\r\n\u001b[?2004l\r"]
[85.726655, "o", "\u001b[?2004h> "]
[85.726735, "o", "    prev_mag = float('inf')\r\n\u001b[?2004l\r"]
[85.726755, "o", "\u001b[?2004h> "]
[85.726838, "o", "    for p in fr['peaks']:\r\n\u001b[?2004l\r"]
[85.726859, "o", "\u001b[?2004h> "]
[85.727046, "o", "        assert np.isfinite(p['freq_hz']), f'frame {i} freq not finite'\r\n\u001b[?2004l\r"]
[85.727067, "o", "\u001b[?2004h> "]
[85.727315, "o", "        assert 0.0 < p['freq_hz'] <= 11025.0, f'frame {i} freq out of range: {p[\\\"freq_hz\\\"]}'\r\n\u001b[?2004l\r"]
[85.727336, "o", "\u001b[?2004h> "]
[85.727533, "o", "        assert np.isfinite(p['magnitude_db']), f'frame {i} mag not finite'\r\n\u001b[?2004l\r"]
[85.727553, "o", "\u001b[?2004h> "]
[85.727853, "o", "        assert p['magnitude_db'] <= prev_mag + 1e-9, f'frame {i} not sorted: {p[\\\"magnitude_db\\\"]} > {prev_mag}'\r\n\u001b[?2004l\r"]
[85.727874, "o", "\u001b[?2004h> "]
[85.727974, "o", "        prev_mag = p['magnitude_db']\r\n\u001b[?2004l\r"]
[85.727994, "o", "\u001b[?2004h> "]
[85.728101, "o", "last_time = data['frames'][-1]['time']\r\n\u001b[?2004l\r"]
[85.728122, "o", "\u001b[?2004h> "]
[85.728207, "o", "print('last time:', last_time)\r\n\u001b[?2004l\r"]
[85.728237, "o", "\u001b[?2004h> "]
[85.728451, "o", "assert abs(last_time - 5.0) <= 0.1, f'last time {last_time} not within 0.1 of 5.0'\r\n\u001b[?2004l\r"]
[85.728472, "o", "\u001b[?2004h> "]
[85.728548, "o", "print('ALL CHECKS PASSED')\r\n\u001b[?2004l\r"]
[85.728569, "o", "\u001b[?2004h> \"\r\n\u001b[?2004l\r"]
