[43.658761, "o", "\u001b[?2004h> "]
[43.658871, "o", "    # Also require freq > 0 and <= sr/2\r\n\u001b[?2004l\r\u001b[?2004h"]
[43.658895, "o", "> "]
[43.659093, "o", "    valid_mask = finite_mask & (f_col > 0.0) & (f_col <= sr / 2.0)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[43.659125, "o", "    \r\n\u001b[?2004l\r\u001b[?2004h> "]
[43.659248, "o", "    valid_idx = np.where(valid_mask)[0]\r\n\u001b[?2004l\r\u001b[?2004h"]
[43.659275, "o", ">     \r\n\u001b[?2004l\r"]
[43.659339, "o", "\u001b[?2004h> "]
[43.659383, "o", "    if len(valid_idx) == 0:\r\n\u001b[?2004l\r\u001b[?2004h"]
[43.659408, "o", "> "]
[43.659583, "o", "        # Shouldn't happen for typical input, but handle gracefully\r\n\u001b[?2004l\r"]
[43.659643, "o", "\u001b[?2004h> "]
[43.659688, "o", "        peaks = []\r\n\u001b[?2004l\r\u001b[?2004h> "]
[43.659764, "o", "        for _ in range(5):\r\n\u001b[?2004l\r"]
[43.659788, "o", "\u001b[?2004h> "]
[43.65999, "o", "            peaks.append({'freq_hz': float(sr / 2.0), 'magnitude_db': -np.inf})\r\n\u001b[?2004l\r"]
[43.660013, "o", "\u001b[?2004h> "]
[43.660271, "o", "        # But magnitude_db must be finite. Use a large negative number? Actually -inf isn't finite.\r\n\u001b[?2004l\r"]
[43.6603, "o", "\u001b[?2004h> "]
[43.660435, "o", "        # Let's pick 5 dummy finite peaks instead\r\n\u001b[?2004l\r"]
[43.660497, "o", "\u001b[?2004h> "]
[43.66069, "o", "        peaks = [{'freq_hz': float(sr/2.0), 'magnitude_db': -1e10} for _ in range(5)]\r\n\u001b[?2004l\r"]
[43.660762, "o", "\u001b[?2004h> "]
[43.660805, "o", "    else:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[43.660863, "o", "        valid_mags = m_col[valid_idx]\r\n\u001b[?2004l\r"]
[43.660886, "o", "\u001b[?2004h> "]
[43.661017, "o", "        # Sort by magnitude descending, take top 5\r\n\u001b[?2004l\r"]
[43.661042, "o", "\u001b[?2004h> "]
[43.661233, "o", "        # Use argpartition for efficiency, then argsort on the partition\r\n\u001b[?2004l\r\u001b[?2004h"]
[43.661256, "o", "> "]
[43.661344, "o", "        k = min(5, len(valid_idx))\r\n\u001b[?2004l\r"]
[43.661366, "o", "\u001b[?2004h> "]
[43.661425, "o", "        if k < 5:\r\n\u001b[?2004l\r\u001b[?2004h"]
[43.661448, "o", "> "]
[43.66161, "o", "            # Pad with copies of the smallest available peak\r\n\u001b[?2004l\r"]
[43.661633, "o", "\u001b[?2004h> "]
[43.661779, "o", "            top_k_local = np.argsort(-valid_mags)[:k]\r\n\u001b[?2004l\r\u001b[?2004h"]
[43.661801, "o", "> "]
[43.661918, "o", "            top_k_idx = valid_idx[top_k_local]\r\n\u001b[?2004l\r"]
[43.66194, "o", "\u001b[?2004h> "]
[43.662037, "o", "            while len(top_k_idx) < 5:\r\n\u001b[?2004l\r"]
[43.662059, "o", "\u001b[?2004h> "]
[43.662249, "o", "                top_k_idx = np.concatenate([top_k_idx, [top_k_idx[-1]]])\r\n\u001b[?2004l\r"]
[43.662271, "o", "\u001b[?2004h> "]
[43.662323, "o", "        else:\r\n\u001b[?2004l\r\u001b[?2004h"]
[43.662363, "o", "> "]
[43.662438, "o", "            # Get top 5 by magnitude\r\n\u001b[?2004l\r"]
[43.662459, "o", "\u001b[?2004h> "]
[43.662634, "o", "            top_k_local = np.argpartition(-valid_mags, 4)[:5]\r\n\u001b[?2004l\r\u001b[?2004h"]
[43.662656, "o", "> "]
[43.662854, "o", "            top_k_local = top_k_local[np.argsort(-valid_mags[top_k_local])]\r\n\u001b[?2004l\r\u001b[?2004h"]
[43.662877, "o", "> "]
[43.662994, "o", "            top_k_idx = valid_idx[top_k_local]\r\n\u001b[?2004l\r"]
[43.663034, "o", "\u001b[?2004h> "]
[43.663057, "o", "        \r\n\u001b[?2004l\r\u001b[?2004h> "]
[43.663193, "o", "        peaks = []\r\n\u001b[?2004l\r"]
[43.663215, "o", "\u001b[?2004h> "]
[43.663301, "o", "        for idx in top_k_idx:\r\n\u001b[?2004l\r"]
[43.663344, "o", "\u001b[?2004h> "]
[43.663449, "o", "            f_val = float(f_col[idx])\r\n\u001b[?2004l\r\u001b[?2004h"]
[43.663473, "o", "> "]
[43.66356, "o", "            m_val = float(m_col[idx])\r\n\u001b[?2004l\r"]
[43.663581, "o", "\u001b[?2004h> "]
[43.663699, "o", "            # Final safety: ensure finite\r\n\u001b[?2004l\r"]
[43.663749, "o", "\u001b[?2004h> "]
[43.663829, "o", "            if not np.isfinite(f_val):\r\n\u001b[?2004l\r"]
[43.66385, "o", "\u001b[?2004h> "]
[43.66396, "o", "                f_val = float(sr / 2.0)\r\n\u001b[?2004l\r"]
[43.663982, "o", "\u001b[?2004h> "]
[43.664089, "o", "            if not np.isfinite(m_val):\r\n\u001b[?2004l\r"]
[43.664113, "o", "\u001b[?2004h> "]
[43.664193, "o", "                m_val = -1e10\r\n\u001b[?2004l\r"]
[43.664215, "o", "\u001b[?2004h> "]
[43.664391, "o", "            peaks.append({'freq_hz': f_val, 'magnitude_db': m_val})\r\n\u001b[?2004l\r"]
[43.664416, "o", "\u001b[?2004h> "]
[43.664462, "o", "    \r\n\u001b[?2004l\r\u001b[?2004h> "]
[43.664537, "o", "    # Get time for this frame\r\n\u001b[?2004l\r"]
[43.66456, "o", "\u001b[?2004h> "]
[43.664799, "o", "    time_val = float(times[0, t_idx]) if times.ndim == 2 else float(times[t_idx])\r\n\u001b[?2004l\r"]
[43.664825, "o", "\u001b[?2004h> "]
[43.664927, "o", "    if not np.isfinite(time_val):\r\n\u001b[?2004l\r\u001b[?2004h"]
[43.664952, "o", "> "]
[43.66508, "o", "        time_val = float(t_idx * hop_length / sr)\r\n\u001b[?2004l\r"]
[43.665104, "o", "\u001b[?2004h> "]
[43.665132, "o", "    \r\n\u001b[?2004l\r\u001b[?2004h"]
[43.665165, "o", "> "]
[43.665236, "o", "    frames_out.append({\r\n\u001b[?2004l\r\u001b[?2004h> "]
[43.665309, "o", "        'time': time_val,\r\n\u001b[?2004l\r"]
[43.665346, "o", "\u001b[?2004h> "]
[43.665396, "o", "        'peaks': peaks\r\n\u001b[?2004l\r"]
[43.66542, "o", "\u001b[?2004h> "]
[43.665444, "o", "    })\r\n\u001b[?2004l\r"]
[43.66547, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[43.665497, "o", "\u001b[?2004h> "]
[43.66559, "o", "output = {\r\n\u001b[?2004l\r\u001b[?2004h>     'meta': {\r\n\u001b[?2004l\r"]
[43.665639, "o", "\u001b[?2004h> "]
[43.665732, "o", "        'n_frames': n_frames,\r\n\u001b[?2004l\r"]
[43.665753, "o", "\u001b[?2004h> "]
[43.665819, "o", "        'sr': int(sr),\r\n\u001b[?2004l\r"]
[43.665839, "o", "\u001b[?2004h> "]
[43.665908, "o", "        'n_fft': n_fft,\r\n\u001b[?2004l\r"]
[43.665929, "o", "\u001b[?2004h> "]
[43.66602, "o", "        'hop_length': hop_length\r\n\u001b[?2004l\r"]
[43.666054, "o", "\u001b[?2004h>     },\r\n"]
[43.666077, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[43.666155, "o", "    'frames': frames_out\r\n\u001b[?2004l\r"]
[43.666177, "o", "\u001b[?2004h> }\r\n"]
[43.666216, "o", "\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[43.666239, "o", "\u001b[?2004h> "]
[43.666328, "o", "with open(OUTPUT_PATH, 'w') as f:\r\n\u001b[?2004l\r"]
[43.666351, "o", "\u001b[?2004h> "]
[43.666419, "o", "    json.dump(output, f)\r\n\u001b[?2004l\r"]
[43.666441, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[43.666466, "o", "\u001b[?2004h> "]
[43.666544, "o", "print('Wrote', OUTPUT_PATH)\r\n\u001b[?2004l\r"]
[43.666566, "o", "\u001b[?2004h> "]
[43.666675, "o", "print('First frame:', frames_out[0])\r\n\u001b[?2004l\r"]
[43.666696, "o", "\u001b[?2004h> "]
[43.6668, "o", "print('Last frame:', frames_out[-1])\r\n\u001b[?2004l\r"]
[43.666821, "o", "\u001b[?2004h> "]
[43.666845, "o", "EOF\r\n\u001b[?2004l\r"]
