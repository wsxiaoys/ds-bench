[7.289055, "o", "cat /home/user/project/server.ts\r\n\u001b[?2004l\r"]
[7.290092, "o", "import { initTRPC } from '@trpc/server';\r\nimport { createHTTPServer } from '@trpc/server/adapters/standalone';\r\n\r\nconst t = initTRPC.create();\r\nconst publicProcedure = t.procedure;\r\nconst router = t.router;\r\n\r\nexport const appRouter = router({\r\n  // Implement the countdown procedure here\r\n});\r\n\r\nexport type AppRouter = typeof appRouter;\r\n\r\nconst server = createHTTPServer({\r\n  router: appRouter,\r\n});\r\n\r\nserver.listen(3000);\r\n"]
[7.290275, "o", "\u001b[?2004hroot@01bc5aba-dc00-4d55-bbc0-9a88acedf6d9:~# "]
[12.582082, "i", "cat /home/user/project/client.ts\n"]
[12.582356, "o", "cat /home/user/project/client.ts\r\n\u001b[?2004l\r"]
[12.587413, "o", "import { createTRPCClient, httpLink, splitLink, httpSubscriptionLink } from '@trpc/client';\r\nimport { EventSource } from 'eventsource';\r\nimport type { AppRouter } from './server.ts';\r\n\r\nglobalThis.EventSource = EventSource as any;\r\n\r\nconst client = createTRPCClient<AppRouter>({\r\n  links: [\r\n    splitLink({\r\n      condition: (op) => op.type === 'subscription',\r\n      true: httpSubscriptionLink({\r\n        url: 'http://localhost:3000',\r\n      }),\r\n      false: httpLink({\r\n        url: 'http://localhost:3000',\r\n      }),\r\n    }),\r\n  ],\r\n});\r\n\r\nasync function main() {\r\n  const sub = await client.countdown.subscribe(undefined, {\r\n    onData(data) {\r\n      console.log(data);\r\n    },\r\n    onError(err) {\r\n      console.error('error', err);\r\n      process.exit(1);\r\n    },\r\n    onComplete() {\r\n      process.exit(0);\r\n    }\r\n  });\r\n}\r\n\r\nmain();\r\n\u001b[?2004hroot@01bc5aba-dc00-4d55-bbc0-9a88acedf6d9:~# "]
[13.550909, "i", "cat /home/user/project/package.json\n"]
[13.551215, "o", "cat /home/user/project/package.json\r\n\u001b[?2004l\r"]
[13.552508, "o", "{\r\n  \"name\": \"trpc-v11-test\",\r\n  \"version\": \"1.0.0\",\r\n  \"type\": \"module\",\r\n  \"scripts\": {\r\n    \"start\": \"node --experimental-strip-types server.ts\",\r\n    \"client\": \"node --experimental-strip-types client.ts\",\r\n    \"test\": \"node --experimental-strip-types server.ts > server.log 2>&1 & sleep 2 && node --experimental-strip-types client.ts > output.log 2>&1 ; cat output.log\"\r\n  },\r\n  \"dependencies\": {\r\n    \"@trpc/server\": \"next\",\r\n    \"@trpc/client\": \"next\",\r\n    \"eventsource\": \"^2.0.2\",\r\n    \"zod\": \"^3.22.4\"\r\n  }\r\n}\r\n"]
[13.552737, "o", "\u001b[?2004hroot@01bc5aba-dc00-4d55-bbc0-9a88acedf6d9:~# "]
[20.379277, "i", "cat > /home/user/project/server.ts << 'EOF'\nimport { initTRPC } from '@trpc/server';\nimport { createHTTPServer } from '@trpc/server/adapters/standalone';\n\nconst t = initTRPC.create();\nconst publicProcedure = t.procedure;\nconst router = t.router;\n\nexport const appRouter = router({\n  countdown: publicProcedure.subscription(async function* () {\n    for (const n of [3, 2, 1]) {\n      await new Promise((r) => setTimeout(r, 100));\n      yield n;\n    }\n  }),\n});\n\nexport type AppRouter = typeof appRouter;\n\nconst server = createHTTPServer({\n  router: appRouter,\n});\n\nserver.listen(3000);\nEOF\n"]
