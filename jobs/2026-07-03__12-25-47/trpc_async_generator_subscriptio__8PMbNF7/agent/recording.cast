[84.058149, "o", "{\r\n  \"name\": \"trpc-subscription-project\",\r\n  \"version\": \"1.0.0\",\r\n  \"type\": \"module\",\r\n  \"scripts\": {\r\n    \"server\": \"tsx server.ts\",\r\n    \"client\": \"tsx client.ts\"\r\n  },\r\n  \"dependencies\": {\r\n    \"@tanstack/react-query\": \"^5.101.2\",\r\n    \"@trpc/client\": \"^11.18.0\",\r\n    \"@trpc/react-query\": \"^11.18.0\",\r\n    \"@trpc/server\": \"^11.18.0\",\r\n    \"tsx\": \"^4.23.0\",\r\n    \"zod\": \"^4.4.3\"\r\n  }\r\n}\r\n"]
[84.059439, "o", "\u001b[0m\u001b[01;34mclient\u001b[0m  \u001b[01;34mreact-query\u001b[0m  \u001b[01;34mserver\u001b[0m\r\n"]
[84.059573, "o", "\u001b[?2004hroot@cd169aa3-a6b5-49c5-bbb6-7615ea762e3d:/home/user/project# "]
[88.394919, "i", "cat > server.ts << 'EOF'\nimport { initTRPC } from '@trpc/server';\nimport { createHTTPServer } from '@trpc/server/adapters/standalone';\nimport { z } from 'zod';\n\nconst t = initTRPC.create();\n\nconst appRouter = t.router({\n  countdown: t.procedure.input(z.number()).subscription(async function* (opts) {\n    const { input } = opts;\n    for (let i = input; i >= 0; i--) {\n      await new Promise((resolve) => setTimeout(resolve, 100));\n      yield i;\n    }\n  }),\n});\n\nexport type AppRouter = typeof appRouter;\n\nconst server = createHTTPServer({\n  router: appRouter,\n});\n\nserver.listen(3000);\nconsole.log('Server listening on port 3000');\nEOF\n"]
