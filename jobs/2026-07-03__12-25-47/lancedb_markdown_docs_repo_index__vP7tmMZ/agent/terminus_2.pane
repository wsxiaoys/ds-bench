[?2004l[?2004h> def parse_markdown(path):
[?2004l[?2004h>     """Return (doc_title, [(section_title, content), ...])."""
[?2004l[?2004h>     text = path.read_text(encoding="utf-8")
[?2004l[?2004h>     lines = text.splitlines()
