[?2004l"""Markdown Docs Repo Indexer with LanceDB.

Walks /app/docs/, splits each Markdown file into per-section chunks,
embeds them with OpenAI's text-embedding-3-small model, and persists the
results into a LanceDB table under /home/user/myproject/lancedb/.

Exposes `search(query, k)` for natural-language queries.
"""
from __future__ import annotations

import json
import os
import re
import time
import urllib.request
from pathlib import Path
from typing import Iterable

import lancedb
import pyarrow as pa


# ---------------------------------------------------------------------------
# Configuration
# ---------------------------------------------------------------------------
DOCS_ROOT = Path("/app/docs")
LANCEDB_DIR = Path("/home/user/myproject/lancedb")
RUN_ID_FILE = Path("/logs/artifacts/run-id")
EMBEDDING_MODEL = "text-embedding-3-small"


def _table_name() -> str:
    """Return a per-run-id table name so concurrent runs don't collide."""
    if RUN_ID_FILE.exists():
        run_id = RUN_ID_FILE.read_text().strip()
    else:
        run_id = os.environ.get("RUN_ID", "default")
    return f"docs_sections_{run_id}"


# ---------------------------------------------------------------------------
# OpenAI embeddings helper
# ---------------------------------------------------------------------------
def _embed_batch(texts, type_="document", max_retries=8):
    """Call the embeddings endpoint and return a list of vectors."""
    api_key = os.environ["OPENAI_API_KEY"]
    base_url = os.environ.get("OPENAI_BASE_URL", "REDACTED")
    url = f"{base_url.rstrip('/')}/embeddings"

    payload = {"model": EMBEDDING_MODEL, "texts": texts, "type": type_}
