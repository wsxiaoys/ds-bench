[45.770881, "i", "python3 << 'EOF'\nimport os, json\nimport urllib.request\n\napi_key = os.environ['OPENAI_API_KEY']\nbase_url = os.environ.get('OPENAI_BASE_URL', '')\nurl = f\"{base_url.rstrip('/')}/embeddings\"\ndata = json.dumps({\"model\": \"text-embedding-3-small\", \"texts\": [\"test\"]}).encode()\nreq = urllib.request.Request(url, data=data, headers={\n    'Content-Type': 'application/json',\n    'Authorization': f'Bearer {api_key}'\n})\ntry:\n    with urllib.request.urlopen(req, timeout=30) as resp:\n        body = resp.read().decode()\n        print('Status:', resp.status)\n        parsed = json.loads(body)\n        print('Top keys:', list(parsed.keys()))\n        if 'data' in parsed:\n            print('Has data, first item len:', len(parsed['data'][0].get('embedding', [])) if parsed.get('data') else 'none')\n        if 'vectors' in parsed:\n            print('Has vectors, type:', type(parsed.get('vectors')))\n            if parsed.get('vectors'):\n                print('First vector len:', len(parsed['vectors'][0]) if parsed['vectors'] else 'empty')\n        print('Body:', body[:500])\nexcept urllib.error.HTTPError as e:\n    body = e.read().decode()\n    print('Error Status:', e.code)\n    print('Error Body:', body[:3000])\nexcept Exception as e:\n    print('Exception:', type(e).__name__, e)\nEOF\n"]
