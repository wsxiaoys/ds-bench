[386.884581, "i", "python3 << 'PYEOF'\nimport base64\n\ncontent = '''\"\"\"Markdown Docs Repo Indexer with LanceDB.\n\nWalks /app/docs/, splits each Markdown file into per-section chunks,\nembeds them with OpenAI\\'s text-embedding-3-small model, and persists the\nresults into a LanceDB table under /home/user/myproject/lancedb/.\n\nExposes `search(query, k)` for natural-language queries.\n\"\"\"\nfrom __future__ import annotations\n\nimport json\nimport os\nimport re\nimport time\nimport urllib.request\nfrom pathlib import Path\nfrom typing import Iterable\n\nimport lancedb\nimport pyarrow as pa\n\n\n# ---------------------------------------------------------------------------\n# Configuration\n# ---------------------------------------------------------------------------\nDOCS_ROOT = Path(\"/app/docs\")\nLANCEDB_DIR = Path(\"/home/user/myproject/lancedb\")\nRUN_ID_FILE = Path(\"/logs/artifacts/run-id\")\nEMBEDDING_MODEL = \"text-embedding-3-small\"\n\n\ndef _table_name() -> str:\n    \"\"\"Return a per-run-id table name so concurrent runs don\\'t collide.\"\"\"\n    if RUN_ID_FILE.exists():\n        run_id = RUN_ID_FILE.read_text().strip()\n    else:\n        run_id = os.environ.get(\"RUN_ID\", \"default\")\n    return f\"docs_sections_{run_id}\"\n\n\n# ---------------------------------------------------------------------------\n# OpenAI embeddings helper\n# ---------------------------------------------------------------------------\ndef _embed_batch(texts, type_=\"document\", max_retries=8):\n    \"\"\"Call the embeddings endpoint and return a list of vectors.\"\"\"\n    api_key = os.environ[\"OPENAI_API_KEY\"]\n    base_url = os.environ.get(\"OPENAI_BASE_URL\", \"REDACTED\")\n    url = f\"{base_url.rstrip(\\'/\\')}/embeddings\"\n\n    payload = {\"model\": EMBEDDING_MODEL, \"texts\": texts, \"type\": type_}\n    data = json.dumps(payload).encode()\n\n    last_err = None\n    for attempt in range(max_retries):\n        req = urllib.request.Request(\n            url,\n            data=data,\n            headers={\n                \"Content-Type\": \"application/json\",\n                \"Authorization\": f\"Bearer {api_key}\",\n            },\n        )\n        try:\n            with urllib.request.urlopen(req, timeout=60) as resp:\n                body = json.loads(resp.read().decode())\n            vectors = body.get(\"vectors\")\n            if vectors is None:\n                err = body.get(\"base_resp\", {}).get(\"status_msg\", \"unknown error\")\n                if \"rate limit\" in err.lower():\n                    wait = min(60, 5 * (attempt + 1))\n                    time.sleep(wait)\n                    continue\n                raise RuntimeError(f\"Embeddings API returned no vectors: {body}\")\n            return vectors\n        except urllib.error.HTTPError as e:\n            body = e.read().decode() if e.fp else \"\"\n            if e.code in (429, 500, 502, 503, 504):\n                time.sleep(min(60, 5 * (attempt + 1)))\n                continue\n            raise RuntimeError(f\"Embeddings API HTTP {e.code}: {body}\") from e\n        except Exception as e:\n            last_err = e\n            time.sleep(min(30, 2 * (attempt + 1)))\n            continue\n    raise RuntimeError(f\"Embeddings API failed after {max_retries} retries: {last_err}\")\n\n\ndef embed_texts(texts, type_=\"document\"):\n    \"\"\"Embed a list of texts, batching to keep payloads manageable.\"\"\"\n    all_vectors = []\n    batch_size = 16\n    for i in range(0, len(texts), batch_size):\n        batch = texts[i:i + batch_size]\n        vecs = _embed_batch(batch, type_=type_)\n        if len(vecs) != len(batch):\n            raise RuntimeError(\n                f\"Embeddings count mismatch: got {len(vecs)} for {len(batch)} inputs\"\n            )\n        all_vectors.extend(vecs)\n    return all_vectors\n\n\n# ---------------------------------------------------------------------------\n# Markdown parsing\n# ---------------------------------------------------------------------------\n_HEADER_RE = re.compile(r\"^(#{1,6})\\s+(.*?)\\s*$\")\n\n\ndef parse_markdown(path):\n    \"\"\"Return (doc_title, [(section_title, content), ...]).\"\"\"\n    text = path.read_text(encoding=\"utf-8\")\n    lines = text.splitlines()\n\n    doc_title = \"\"\n    sect"]
[386.884733, "i", "ions = []\n    current_title = None\n    current_body = []\n\n    def flush():\n        if current_title is not None:\n            content = \"\\n\".join(current_body).strip(\"\\n\")\n            sections.append((current_title, content))\n\n    for line in lines:\n        m = _HEADER_RE.match(line)\n        if m:\n            level = len(m.group(1))\n            title = m.group(2).strip()\n            if level == 1 and not doc_title:\n                doc_title = title\n                continue\n            if level == 2:\n                flush()\n                current_title = title\n                current_body = []\n                continue\n        if current_title is not None:\n            current_body.append(line)\n\n    flush()\n    return doc_title, sections\n\n\ndef discover_markdown_files(root):\n    return sorted(p for p in root.rglob(\"*.md\") if p.is_file())\n\n\n# ---------------------------------------------------------------------------\n# LanceDB helpers\n# ---------------------------------------------------------------------------\ndef _connect():\n    LANCEDB_DIR.mkdir(parents=True, exist_ok=True)\n    return lancedb.connect(str(LANCEDB_DIR))\n\n\ndef _open_or_create_table(db, rows):\n    name = _table_name()\n    schema = pa.schema(\n        [\n            pa.field(\"repo_path\", pa.string()),\n            pa.field(\"doc_title\", pa.string()),\n            pa.field(\"section_title\", pa.string()),\n            pa.field(\"content\", pa.string()),\n            pa.field(\"embedding\", pa.list_(pa.float32())),\n        ]\n    )\n    if name in db.table_names():\n        table = db.open_table(name)\n        try:\n            table.delete(\"TRUE\")\n        except Exception:\n            pass\n        if rows:\n            table.add(rows)\n        return table\n    return db.create_table(name, data=rows, schema=schema, mode=\"create\")\n\n\n# ---------------------------------------------------------------------------\n# Public API\n# ---------------------------------------------------------------------------\ndef build_index():\n    \"\"\"Walk the docs repo and (re)build the LanceDB table.\"\"\"\n    files = list(discover_markdown_files(DOCS_ROOT))\n    if not files:\n        raise RuntimeError(f\"No .md files found under {DOCS_ROOT}\")\n\n    texts_to_embed = []\n    metas = []  # list of (rel_path, doc_title, section_title, content)\n\n    for path in files:\n        rel = path.relative_to(DOCS_ROOT).as_posix()\n        doc_title, sections = parse_markdown(path)\n        if not sections:\n            continue\n        for section_title, content in sections:\n            embed_text = f\"{section_title}\\n{content}\".strip()\n            texts_to_embed.append(embed_text)\n            metas.append((rel, doc_title, section_title, content))\n\n    print(f\"Embedding {len(texts_to_embed)} sections from {len(files)} files\")\n    vectors = embed_texts(texts_to_embed, type_=\"document\")\n    print(f\"Got {len(vectors)} vectors of dimension {len(vectors[0])}\")\n\n    rows = []\n    for meta, vector in zip(metas, vectors):\n        rel, doc_title, section_title, content = meta\n        rows.append({\n            \"repo_path\": rel,\n            \"doc_title\": doc_title,\n            \"section_title\": section_title,\n            \"content\": content,\n            \"embedding\": [float(x) for x in vector],\n        })\n\n    db = _connect()\n    table = _open_or_create_table(db, rows)\n    print(f\"Wrote {len(rows)} rows into LanceDB table at {LANCEDB_DIR}\")\n    return len(rows)\n\n\ndef search(query, k=5):\n    \"\"\"Return the top-k most relevant sections for `query`.\"\"\"\n    if not query or not query.strip():\n        return []\n    db = _connect()\n    name = _table_name()\n    if name not in db.table_names():\n        raise RuntimeError(f\"Table {name!r} does not exist; run build_index() first\")\n    table = db.open_table(name)\n\n    query_vec = embed_texts([query], type_=\"query\")[0]\n    results = (\n        table.search([float(x) for x in query_vec])\n        .metric(\"cosine\")\n        .limit(k)\n        .to_list()\n    )\n\n    out = []\n    for row in results:\n        out.append({\n            \"repo_path\": row.get(\"repo_path\", \"\"),\n            \"doc_title\": row.get(\"doc_title\", \"\""]
[386.884802, "i", "),\n            \"section_title\": row.get(\"section_title\", \"\"),\n            \"score\": float(row.get(\"_distance\", row.get(\"score\", 0.0))),\n        })\n    return out\n\n\nif __name__ == \"__main__\":\n    build_index()\n'''\nencoded = base64.b64encode(content.encode()).decode()\nprint(encoded)\nPYEOF\n"]
