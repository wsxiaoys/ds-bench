[360.983906, "i", "python3 << 'PYEOF'\ncontent = '''\"\"\"Markdown Docs Repo Indexer with LanceDB.\n\nWalks /app/docs/, splits each Markdown file into per-section chunks,\nembeds them with OpenAI\\'s text-embedding-3-small model, and persists the\nresults into a LanceDB table under /home/user/myproject/lancedb/.\n\nExposes `search(query, k)` for natural-language queries.\n\"\"\"\nfrom __future__ import annotations\n\nimport json\nimport os\nimport re\nimport time\nimport urllib.request\nfrom pathlib import Path\nfrom typing import Iterable\n\nimport lancedb\nimport pyarrow as pa\n\n\n# ---------------------------------------------------------------------------\n# Configuration\n# ---------------------------------------------------------------------------\nDOCS_ROOT = Path(\"/app/docs\")\nLANCEDB_DIR = Path(\"/home/user/myproject/lancedb\")\nRUN_ID_FILE = Path(\"/logs/artifacts/run-id\")\nEMBEDDING_MODEL = \"text-embedding-3-small\"\n\n\ndef _table_name() -> str:\n    \"\"\"Return a per-run-id table name so concurrent runs don\\'t collide.\"\"\"\n    if RUN_ID_FILE.exists():\n        run_id = RUN_ID_FILE.read_text().strip()\n    else:\n        run_id = os.environ.get(\"RUN_ID\", \"default\")\n    return f\"docs_sections_{run_id}\"\n\n\n# ---------------------------------------------------------------------------\n# OpenAI embeddings helper\n# ---------------------------------------------------------------------------\ndef _embed_batch(texts, type_=\"document\", max_retries=8):\n    \"\"\"Call the embeddings endpoint and return a list of vectors.\"\"\"\n    api_key = os.environ[\"OPENAI_API_KEY\"]\n    base_url = os.environ.get(\"OPENAI_BASE_URL\", \"REDACTED\")\n    url = f\"{base_url.rstrip(\\'/\\')}/embeddings\"\n\n    payload = {\"model\": EMBEDDING_MODEL, \"texts\": texts, \"type\": type_}\n    data = json.dumps(payload).encode()\n\n    last_err = None\n    for attempt in range(max_retries):\n        req = urllib.request.Request(\n            url,\n            data=data,\n            headers={\n                \"Content-Type\": \"application/json\",\n                \"Authorization\": f\"Bearer {api_key}\",\n            },\n        )\n        try:\n            with urllib.request.urlopen(req, timeout=60) as resp:\n                body = json.loads(resp.read().decode())\n            vectors = body.get(\"vectors\")\n            if vectors is None:\n                err = body.get(\"base_resp\", {}).get(\"status_msg\", \"unknown error\")\n                if \"rate limit\" in err.lower():\n                    wait = min(60, 5 * (attempt + 1))\n                    time.sleep(wait)\n                    continue\n                raise RuntimeError(f\"Embeddings API returned no vectors: {body}\")\n            return vectors\n        except urllib.error.HTTPError as e:\n            body = e.read().decode() if e.fp else \"\"\n            if e.code in (429, 500, 502, 503, 504):\n                time.sleep(min(60, 5 * (attempt + 1)))\n                continue\n            raise RuntimeError(f\"Embeddings API HTTP {e.code}: {body}\") from e\n        except Exception as e:\n            last_err = e\n            time.sleep(min(30, 2 * (attempt + 1)))\n            continue\n    raise RuntimeError(f\"Embeddings API failed after {max_retries} retries: {last_err}\")\n\n\ndef embed_texts(texts, type_=\"document\"):\n    \"\"\"Embed a list of texts, batching to keep payloads manageable.\"\"\"\n    all_vectors = []\n    batch_size = 16\n    for i in range(0, len(texts), batch_size):\n        batch = texts[i:i + batch_size]\n        vecs = _embed_batch(batch, type_=type_)\n        if len(vecs) != len(batch):\n            raise RuntimeError(\n                f\"Embeddings count mismatch: got {len(vecs)} for {len(batch)} inputs\"\n            )\n        all_vectors.extend(vecs)\n    return all_vectors\n\n\n# ---------------------------------------------------------------------------\n# Markdown parsing\n# ---------------------------------------------------------------------------\n_HEADER_RE = re.compile(r\"^(#{1,6})\\s+(.*?)\\s*$\")\n\n\ndef parse_markdown(path):\n    \"\"\"Return (doc_title, [(section_title, content), ...]).\"\"\"\n    text = path.read_text(encoding=\"utf-8\")\n    lines = text.splitlines()\n\n    doc_title = \"\"\n    sections = []\n    c"]
[360.984044, "i", "urrent_title = None\n    current_body = []\n\n    def flush():\n        if current_title is not None:\n            content = \"\\n\".join(current_body).strip(\"\\n\")\n            sections.append((current_title, content))\n\n    for line in lines:\n        m = _HEADER_RE.match(line)\n        if m:\n            level = len(m.group(1))\n            title = m.group(2).strip()\n            if level == 1 and not doc_title:\n                doc_title = title\n                continue\n            if level == 2:\n                flush()\n                current_title = title\n                current_body = []\n                continue\n        if current_title is not None:\n            current_body.append(line)\n\n    flush()\n    return doc_title, sections\n\n\ndef discover_markdown_files(root):\n    return sorted(p for p in root.rglob(\"*.md\") if p.is_file())\n\n\n# ---------------------------------------------------------------------------\n# LanceDB helpers\n# ---------------------------------------------------------------------------\ndef _connect():\n    LANCEDB_DIR.mkdir(parents=True, exist_ok=True)\n    return lancedb.connect(str(LANCEDB_DIR))\n\n\ndef _open_or_create_table(db, rows):\n    name = _table_name()\n    schema = pa.schema(\n        [\n            pa.field(\"repo_path\", pa.string()),\n            pa.field(\"doc_title\", pa.string()),\n            pa.field(\"section_title\", pa.string()),\n            pa.field(\"content\", pa.string()),\n            pa.field(\"embedding\", pa.list_(pa.float32())),\n        ]\n    )\n    if name in db.table_names():\n        table = db.open_table(name)\n        try:\n            table.delete(\"TRUE\")\n        except Exception:\n            pass\n        if rows:\n            table.add(rows)\n        return table\n    return db.create_table(name, data=rows, schema=schema, mode=\"create\")\n\n\n# ---------------------------------------------------------------------------\n# Public API\n# ---------------------------------------------------------------------------\ndef build_index():\n    \"\"\"Walk the docs repo and (re)build the LanceDB table.\"\"\"\n    files = list(discover_markdown_files(DOCS_ROOT))\n    if not files:\n        raise RuntimeError(f\"No .md files found under {DOCS_ROOT}\")\n\n    texts_to_embed = []\n    metas = []  # list of (rel_path, doc_title, section_title)\n\n    for path in files:\n        rel = path.relative_to(DOCS_ROOT).as_posix()\n        doc_title, sections = parse_markdown(path)\n        if not sections:\n            continue\n        for section_title, content in sections:\n            embed_text = f\"{section_title}\\n{content}\".strip()\n            texts_to_embed.append(embed_text)\n            metas.append((rel, doc_title, section_title, content))\n\n    print(f\"Embedding {len(texts_to_embed)} sections from {len(files)} files\")\n    vectors = embed_texts(texts_to_embed, type_=\"document\")\n    print(f\"Got {len(vectors)} vectors of dimension {len(vectors[0])}\")\n\n    rows = []\n    for meta, vector in zip(metas, vectors):\n        rel, doc_title, section_title, content = meta\n        rows.append({\n            \"repo_path\": rel,\n            \"doc_title\": doc_title,\n            \"section_title\": section_title,\n            \"content\": content,\n            \"embedding\": [float(x) for x in vector],\n        })\n\n    db = _connect()\n    table = _open_or_create_table(db, rows)\n    print(f\"Wrote {len(rows)} rows into LanceDB table \\'{_table_name()}\\' at {LANCEDB_DIR}\")\n    return len(rows)\n\n\ndef search(query, k=5):\n    \"\"\"Return the top-k most relevant sections for `query`.\"\"\"\n    if not query or not query.strip():\n        return []\n    db = _connect()\n    name = _table_name()\n    if name not in db.table_names():\n        raise RuntimeError(f\"Table {name!r} does not exist; run build_index() first\")\n    table = db.open_table(name)\n\n    query_vec = embed_texts([query], type_=\"query\")[0]\n    results = (\n        table.search([float(x) for x in query_vec])\n        .metric(\"cosine\")\n        .limit(k)\n        .to_list()\n    )\n\n    out = []\n    for row in results:\n        out.append({\n            \"repo_path\": row.get(\"repo_path\", \"\"),\n            \"doc_title\": row.get(\"doc_title\", \"\"),\n "]
[360.984076, "i", "           \"section_title\": row.get(\"section_title\", \"\"),\n            \"score\": float(row.get(\"_distance\", row.get(\"score\", 0.0))),\n        })\n    return out\n\n\nif __name__ == \"__main__\":\n    build_index()\n'''\nwith open('/home/user/myproject/indexer.py', 'w') as f:\n    f.write(content)\nprint('Wrote indexer.py, length:', len(content))\nPYEOF\n"]
[360.984276, "o", "python3 << 'PYEOF'\r\n\u001b[?2004l\r"]
[360.984354, "o", "\u001b[?2004h> "]
[360.984632, "o", "content = '''\"\"\"Markdown Docs Repo Indexer with LanceDB.\r\n\u001b[?2004l\r"]
[360.984666, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[360.9847, "o", "\u001b[?2004h> "]
[360.984965, "o", "Walks /app/docs/, splits each Markdown file into per-section chunks,\r\n\u001b[?2004l\r"]
[360.985035, "o", "\u001b[?2004h> "]
[360.98526, "o", "embeds them with OpenAI\\'s text-embedding-3-small model, and persists the\r\n\u001b[?2004l\r"]
[360.985325, "o", "\u001b[?2004h> "]
[360.985516, "o", "results into a LanceDB table under /home/user/myproject/lancedb/.\r\n\u001b[?2004l\r"]
[360.985549, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r "]
[360.985642, "o", "\u001b[?2004h> "]
[360.985776, "o", "Exposes `search(query, k)` for natural-language queries.\r\n\u001b[?2004l\r"]
[360.98585, "o", "\u001b[?2004h> "]
[360.98591, "o", "\"\"\"\r\n\u001b[?2004l\r\u001b[?2004h> "]
[360.985985, "o", "from __future__ import annotations\r\n\u001b[?2004l\r"]
[360.98605, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r "]
[360.986103, "o", "\u001b[?2004h> import json\r\n\u001b[?2004l\r"]
[360.986161, "o", "\u001b[?2004h> "]
[360.986193, "o", "import os\r\n\u001b[?2004l\r\u001b[?2004h> "]
[360.986253, "o", "import re\r\n\u001b[?2004l\r\u001b[?2004h> "]
[360.986334, "o", "import time\r\n\u001b[?2004l\r\u001b[?2004h> "]
[360.986408, "o", "import urllib.request\r\n\u001b[?2004l\r"]
[360.986469, "o", "\u001b[?2004h> "]
[360.986536, "o", "from pathlib import Path\r\n\u001b[?2004l\r"]
[360.986562, "o", "\u001b[?2004h> "]
[360.986668, "o", "from typing import Iterable\r\n\u001b[?2004l\r"]
[360.986691, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[360.986757, "o", "\u001b[?2004h> "]
[360.98685, "o", "import lancedb\r\n\u001b[?2004l\r\u001b[?2004h> "]
[360.986904, "o", "import pyarrow as pa\r\n\u001b[?2004l\r"]
[360.986959, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> \r\n"]
[360.98702, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[360.987267, "o", "# ---------------------------------------------------------------------------\r\n\u001b[?2004l\r"]
[360.987327, "o", "\u001b[?2004h> "]
[360.987375, "o", "# Configuration\r\n\u001b[?2004l\r"]
[360.987394, "o", "\u001b[?2004h> "]
[360.987663, "o", "# ---------------------------------------------------------------------------\r\n\u001b[?2004l\r"]
[360.987716, "o", "\u001b[?2004h> "]
[360.987814, "o", "DOCS_ROOT = Path(\"/app/docs\")\r\n\u001b[?2004l\r"]
[360.987846, "o", "\u001b[?2004h> "]
[360.988024, "o", "LANCEDB_DIR = Path(\"/home/user/myproject/lancedb\")\r\n\u001b[?2004l\r"]
[360.988066, "o", "\u001b[?2004h> "]
[360.988217, "o", "RUN_ID_FILE = Path(\"/logs/artifacts/run-id\")\r\n\u001b[?2004l\r"]
[360.98826, "o", "\u001b[?2004h> "]
[360.988403, "o", "EMBEDDING_MODEL = \"text-embedding-3-small\"\r\n\u001b[?2004l\r"]
[360.988459, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[360.98848, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[360.988591, "o", "def _table_name() -> str:\r\n\u001b[?2004l\r"]
[360.988648, "o", "\u001b[?2004h> "]
[360.988928, "o", "    \"\"\"Return a per-run-id table name so concurrent runs don\\'t collide.\"\"\"\r\n\u001b[?2004l\r"]
[360.988958, "o", "\u001b[?2004h> "]
[360.989059, "o", "    if RUN_ID_FILE.exists():\r\n\u001b[?2004l\r"]
[360.989081, "o", "\u001b[?2004h> "]
[360.989267, "o", "        run_id = RUN_ID_FILE.read_text().strip()\r\n\u001b[?2004l\r"]
[360.989331, "o", "\u001b[?2004h> "]
[360.989375, "o", "    else:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[360.989553, "o", "        run_id = os.environ.get(\"RUN_ID\", \"default\")\r\n\u001b[?2004l\r"]
[360.989597, "o", "\u001b[?2004h> "]
[360.989717, "o", "    return f\"docs_sections_{run_id}\"\r\n\u001b[?2004l\r"]
[360.989779, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[360.989838, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[360.990093, "o", "# ---------------------------------------------------------------------------\r\n\u001b[?2004l\r"]
[360.990169, "o", "\u001b[?2004h> "]
[360.990216, "o", "# OpenAI embeddings helper\r\n\u001b[?2004l\r"]
[360.990272, "o", "\u001b[?2004h> "]
[360.990524, "o", "# ---------------------------------------------------------------------------\r\n\u001b[?2004l\r"]
[360.990546, "o", "\u001b[?2004h> "]
[360.990758, "o", "def _embed_batch(texts, type_=\"document\", max_retries=8):\r\n\u001b[?2004l\r"]
[360.990828, "o", "\u001b[?2004h> "]
[360.991043, "o", "    \"\"\"Call the embeddings endpoint and return a list of vectors.\"\"\"\r\n\u001b[?2004l\r"]
[360.991092, "o", "\u001b[?2004h> "]
[360.991226, "o", "    api_key = os.environ[\"OPENAI_API_KEY\"]\r\n\u001b[?2004l\r"]
[360.991282, "o", "\u001b[?2004h> "]
[360.99154, "o", "    base_url = os.environ.get(\"OPENAI_BASE_URL\", \"REDACTED\")\r\n\u001b[?2004l\r"]
[360.991561, "o", "\u001b[?2004h> "]
[360.991757, "o", "    url = f\"{base_url.rstrip(\\'/\\')}/embeddings\"\r\n\u001b[?2004l\r"]
[360.991826, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[360.991881, "o", "\u001b[?2004h> "]
[360.992129, "o", "    payload = {\"model\": EMBEDDING_MODEL, \"texts\": texts, \"type\": type_}\r\n\u001b[?2004l\r"]
[360.992173, "o", "\u001b[?2004h"]
[360.992229, "o", "> "]
[360.992338, "o", "    data = json.dumps(payload).encode()\r\n\u001b[?2004l\r"]
[360.99239, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[360.992439, "o", "\u001b[?2004h> "]
[360.992499, "o", "    last_err = None\r\n\u001b[?2004l\r"]
[360.992543, "o", "\u001b[?2004h> "]
[360.992712, "o", "    for attempt in range(max_retries):\r\n\u001b[?2004l\r"]
[360.992736, "o", "\u001b[?2004h"]
[360.9928, "o", "> "]
[360.992903, "o", "        req = urllib.request.Request(\r\n\u001b[?2004l\r"]
[360.992941, "o", "\u001b[?2004h> "]
[360.993002, "o", "            url,\r\n\u001b[?2004l\r"]
[360.993045, "o", "\u001b[?2004h> "]
[360.993151, "o", "            data=data,\r\n\u001b[?2004l\r"]
[360.993181, "o", "\u001b[?2004h> "]
[360.993281, "o", "            headers={\r\n\u001b[?2004l\r"]
[360.993352, "o", "\u001b[?2004h> "]
[360.993522, "o", "                \"Content-Type\": \"application/json\",\r\n\u001b[?2004l\r"]
[360.993559, "o", "\u001b[?2004h> "]
[360.993816, "o", "                \"Authorization\": f\"Bearer {api_key}\",\r\n\u001b[?2004l\r\u001b[?2004h"]
[360.993858, "o", "> "]
[360.99396, "o", "            },\r\n\u001b[?2004l\r\u001b[?2004h>         )\r\n\u001b[?2004l\r"]
[360.993995, "o", "\u001b[?2004h> "]
[360.994065, "o", "        try:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[360.994375, "o", "            with urllib.request.urlopen(req, timeout=60) as resp:\r\n\u001b[?2004l\r\u001b[?2004h"]
[360.994416, "o", "> "]
[360.994667, "o", "                body = json.loads(resp.read().decode())\r\n\u001b[?2004l\r"]
[360.994787, "o", "\u001b[?2004h> "]
[360.994875, "o", "            vectors = body.get(\"vectors\")\r\n\u001b[?2004l\r\u001b[?2004h"]
[360.994944, "o", "> "]
[360.995048, "o", "            if vectors is None:\r\n\u001b[?2004l\r"]
[360.995112, "o", "\u001b[?2004h> "]
[360.995495, "o", "                err = body.get(\"base_resp\", {}).get(\"status_msg\", \"unknown error\")\r\n\u001b[?2004l\r"]
[360.995575, "o", "\u001b[?2004h> "]
[360.995871, "o", "                if \"rate limit\" in err.lower():\r\n\u001b[?2004l\r"]
[360.995951, "o", "\u001b[?2004h> "]
[360.996131, "o", "                    wait = min(60, 5 * (attempt + 1))\r\n\u001b[?2004l\r"]
[360.996204, "o", "\u001b[?2004h> "]
[360.996364, "o", "                    time.sleep(wait)\r\n\u001b[?2004l\r"]
[360.996446, "o", "\u001b[?2004h> "]
[360.996572, "o", "                    continue\r\n\u001b[?2004l\r"]
[360.996644, "o", "\u001b[?2004h> "]
[360.997043, "o", "                raise RuntimeError(f\"Embeddings API returned no vectors: {body}\")\r\n\u001b[?2004l\r"]
[360.997122, "o", "\u001b[?2004h> "]
[360.997215, "o", "            return vectors\r\n\u001b[?2004l\r"]
[360.997253, "o", "\u001b[?2004h> "]
[360.997484, "o", "        except urllib.error.HTTPError as e:\r\n\u001b[?2004l\r"]
[360.997521, "o", "\u001b[?2004h> "]
[360.997799, "o", "            body = e.read().decode() if e.fp else \"\"\r\n\u001b[?2004l\r"]
[360.99784, "o", "\u001b[?2004h> "]
[360.998086, "o", "            if e.code in (429, 500, 502, 503, 504):\r\n\u001b[?2004l\r"]
[360.998161, "o", "\u001b[?2004h> "]
[360.998407, "o", "                time.sleep(min(60, 5 * (attempt + 1)))\r\n\u001b[?2004l\r"]
[360.998476, "o", "\u001b[?2004h> "]
[360.998576, "o", "                continue\r\n\u001b[?2004l\r"]
[360.99864, "o", "\u001b[?2004h> "]
[360.99904, "o", "            raise RuntimeError(f\"Embeddings API HTTP {e.code}: {body}\") from e\r\n\u001b[?2004l\r"]
[360.999116, "o", "\u001b[?2004h> "]
[360.999249, "o", "        except Exception as e:\r\n\u001b[?2004l\r"]
[360.99931, "o", "\u001b[?2004h> "]
[360.999422, "o", "            last_err = e\r\n\u001b[?2004l\r"]
[360.999489, "o", "\u001b[?2004h> "]
[360.999715, "o", "            time.sleep(min(30, 2 * (attempt + 1)))\r\n\u001b[?2004l\r"]
[360.999794, "o", "\u001b[?2004h> "]
[360.999868, "o", "            continue\r\n\u001b[?2004l\r"]
[360.99993, "o", "\u001b[?2004h> "]
[361.000392, "o", "    raise RuntimeError(f\"Embeddings API failed after {max_retries} retries: {last_err}\")\r\n\u001b[?2004l\r"]
[361.000456, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[361.00049, "o", "\u001b[?2004h> \r\n\u001b[?2004l\re\u001b[?2004h> "]
[361.000675, "o", "def embed_texts(texts, type_=\"document\"):\r\n\u001b[?2004l\r"]
[361.000709, "o", "\u001b[?2004h> "]
[361.001078, "o", "    \"\"\"Embed a list of texts, batching to keep payloads manageable.\"\"\"\r\n\u001b[?2004l\r"]
[361.001107, "o", "\u001b[?2004h> "]
[361.001238, "o", "    all_vectors = []\r\n\u001b[?2004l\r"]
[361.001313, "o", "\u001b[?2004h> "]
[361.001373, "o", "    batch_size = 16\r\n\u001b[?2004l\r\u001b[?2004h"]
[361.001438, "o", "> "]
[361.001584, "o", "    for i in range(0, len(texts), batch_size):\r\n\u001b[?2004l\r"]
[361.00167, "o", "\u001b[?2004h> "]
[361.001866, "o", "        batch = texts[i:i + batch_size]\r\n\u001b[?2004l\r"]
[361.00189, "o", "\u001b[?2004h"]
[361.001939, "o", "> "]
[361.002148, "o", "        vecs = _embed_batch(batch, type_=type_)\r\n\u001b[?2004l\r"]
[361.002191, "o", "\u001b[?2004h"]
[361.002211, "o", "> "]
[361.002388, "o", "        if len(vecs) != len(batch):\r\n\u001b[?2004l\r"]
[361.00244, "o", "\u001b[?2004h> "]
[361.002592, "o", "            raise RuntimeError(\r\n\u001b[?2004l\r"]
[361.002644, "o", "\u001b[?2004h> "]
[361.003086, "o", "                f\"Embeddings count mismatch: got {len(vecs)} for {len(batch)} inputs\"\r\n\u001b[?2004l\r"]
[361.003138, "o", "\u001b[?2004h> "]
[361.003199, "o", "            )\r\n\u001b[?2004l\r"]
[361.00325, "o", "\u001b[?2004h> "]
[361.003415, "o", "        all_vectors.extend(vecs)\r\n\u001b[?2004l\r"]
[361.003473, "o", "\u001b[?2004h> "]
[361.003588, "o", "    return all_vectors\r\n\u001b[?2004l\r"]
[361.003621, "o", "\u001b[?2004h"]
[361.003639, "o", "> \r\n\u001b[?2004l\r"]
[361.003862, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[361.004136, "o", "# ---------------------------------------------------------------------------\r\n\u001b[?2004l\r"]
[361.004194, "o", "\u001b[?2004h> "]
[361.004284, "o", "# Markdown parsing\r\n\u001b[?2004l\r"]
[361.004336, "o", "\u001b[?2004h> "]
[361.00472, "o", "# ---------------------------------------------------------------------------\r\n\u001b[?2004l\r"]
[361.004775, "o", "\u001b[?2004h"]
[361.004835, "o", "> "]
[361.005031, "o", "_HEADER_RE = re.compile(r\"^(#{1,6})\\s+(.*?)\\s*$\")\r\n\u001b[?2004l\r"]
[361.005087, "o", "\u001b[?2004h"]
[361.005115, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[361.00519, "o", "\u001b[?2004h> "]
[361.005304, "o", "def parse_markdown(path):\r\n\u001b[?2004l\r"]
[361.005354, "o", "\u001b[?2004h> "]
[361.005699, "o", "    \"\"\"Return (doc_title, [(section_title, content), ...]).\"\"\"\r\n\u001b[?2004l\r"]
[361.005732, "o", "\u001b[?2004h> "]
[361.005986, "o", "    text = path.read_text(encoding=\"utf-8\")\r\n\u001b[?2004l\r"]
[361.006055, "o", "\u001b[?2004h> "]
[361.006195, "o", "    lines = text.splitlines()\r\n\u001b[?2004l\r"]
[361.006255, "o", "\u001b[?2004h"]
[361.006304, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[361.00636, "o", "    doc_title = \"\"\r\n\u001b[?2004l\r"]
[361.006424, "o", "\u001b[?2004h> "]
[361.006489, "o", "    sections = []\r\n\u001b[?2004l\r"]
[361.006539, "o", "\u001b[?2004h> "]
[361.006628, "o", "    current_title = None\r\n\u001b[?2004l\r"]
[361.006675, "o", "\u001b[?2004h"]
[361.006738, "o", "> "]
[361.006796, "o", "    current_body = []\r\n\u001b[?2004l\r"]
[361.006862, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[361.006925, "o", "\u001b[?2004h> "]
[361.006984, "o", "    def flush():\r\n\u001b[?2004l\r\u001b[?2004h"]
[361.007057, "o", "> "]
[361.007147, "o", "        if current_title is not None:\r\n\u001b[?2004l\r"]
[361.007199, "o", "\u001b[?2004h"]
[361.007222, "o", "> "]
[361.007469, "o", "            content = \"\\n\".join(current_body).strip(\"\\n\")\r\n\u001b[?2004l\r"]
[361.007527, "o", "\u001b[?2004h"]
[361.007585, "o", "> "]
[361.00777, "o", "            sections.append((current_title, content))\r\n\u001b[?2004l\r"]
[361.007846, "o", "\u001b[?2004h"]
[361.007871, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[361.007966, "o", "    for line in lines:\r\n\u001b[?2004l\r"]
[361.008026, "o", "\u001b[?2004h> "]
[361.008173, "o", "        m = _HEADER_RE.match(line)\r\n\u001b[?2004l\r"]
[361.00823, "o", "\u001b[?2004h"]
[361.008291, "o", ">         if m:\r\n\u001b[?2004l\r"]
[361.00832, "o", "\u001b[?2004h> "]
[361.00849, "o", "            level = len(m.group(1))\r\n\u001b[?2004l\r"]
[361.00855, "o", "\u001b[?2004h> "]
[361.008705, "o", "            title = m.group(2).strip()\r\n\u001b[?2004l\r"]
[361.008761, "o", "\u001b[?2004h> "]
[361.008949, "o", "            if level == 1 and not doc_title:\r\n\u001b[?2004l\r"]
[361.00901, "o", "\u001b[?2004h> "]
[361.00913, "o", "                doc_title = title\r\n\u001b[?2004l\r"]
[361.009186, "o", "\u001b[?2004h"]
[361.00924, "o", "> "]
[361.009292, "o", "                continue\r\n\u001b[?2004l\r"]
[361.009358, "o", "\u001b[?2004h> "]
[361.00944, "o", "            if level == 2:\r\n\u001b[?2004l\r"]
[361.00947, "o", "\u001b[?2004h> "]
[361.009603, "o", "                flush()\r\n\u001b[?2004l\r\u001b[?2004h"]
[361.009681, "o", "> "]
[361.009785, "o", "                current_title = title\r\n\u001b[?2004l\r"]
[361.009884, "o", "\u001b[?2004h"]
[361.009906, "o", "> "]
[361.010017, "o", "                current_body = []\r\n\u001b[?2004l\r"]
[361.010096, "o", "\u001b[?2004h> "]
[361.010163, "o", "                continue\r\n\u001b[?2004l\r"]
[361.010216, "o", "\u001b[?2004h> "]
[361.010324, "o", "        if current_title is not None:\r\n\u001b[?2004l\r"]
[361.010351, "o", "\u001b[?2004h"]
[361.010375, "o", "> "]
[361.010527, "o", "            current_body.append(line)\r\n\u001b[?2004l\r"]
[361.010557, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[361.010632, "o", "\u001b[?2004h> "]
[361.010696, "o", "    flush()\r\n\u001b[?2004l\r"]
[361.010722, "o", "\u001b[?2004h> "]
[361.010857, "o", "    return doc_title, sections\r\n\u001b[?2004l\r\u001b[?2004h"]
[361.01092, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h"]
[361.01098, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[361.01109, "o", "def discover_markdown_files(root):\r\n\u001b[?2004l\r"]
[361.011143, "o", "\u001b[?2004h"]
[361.011167, "o", "> "]
[361.011388, "o", "    return sorted(p for p in root.rglob(\"*.md\") if p.is_file())\r\n\u001b[?2004l\r"]
[361.011445, "o", "\u001b[?2004h> "]
[361.011467, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[361.011559, "o", "\u001b[?2004h> "]
[361.011844, "o", "# ---------------------------------------------------------------------------\r\n\u001b[?2004l\r\u001b[?2004h"]
[361.011872, "o", "> "]
[361.01195, "o", "# LanceDB helpers\r\n\u001b[?2004l\r\u001b[?2004h"]
[361.012011, "o", "> "]
[361.012295, "o", "# ---------------------------------------------------------------------------\r\n\u001b[?2004l\r"]
[361.012353, "o", "\u001b[?2004h> "]
[361.012423, "o", "def _connect():\r\n\u001b[?2004l\r\u001b[?2004h"]
[361.01247, "o", "> "]
[361.012625, "o", "    LANCEDB_DIR.mkdir(parents=True, exist_ok=True)\r\n\u001b[?2004l\r"]
[361.012676, "o", "\u001b[?2004h> "]
[361.012793, "o", "    return lancedb.connect(str(LANCEDB_DIR))\r\n\u001b[?2004l\r"]
[361.012822, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[361.012897, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[361.012962, "o", "\u001b[?2004h> "]
[361.013062, "o", "def _open_or_create_table(db, rows):\r\n\u001b[?2004l\r\u001b[?2004h"]
[361.013111, "o", "> "]
[361.013167, "o", "    name = _table_name()\r\n\u001b[?2004l\r"]
[361.013193, "o", "\u001b[?2004h"]
[361.013217, "o", "> "]
[361.013301, "o", "    schema = pa.schema(\r\n\u001b[?2004l\r"]
[361.013355, "o", "\u001b[?2004h> "]
[361.013408, "o", "        [\r\n\u001b[?2004l\r\u001b[?2004h> "]
[361.013617, "o", "            pa.field(\"repo_path\", pa.string()),\r\n\u001b[?2004l\r"]
[361.013668, "o", "\u001b[?2004h> "]
[361.013855, "o", "            pa.field(\"doc_title\", pa.string()),\r\n\u001b[?2004l\r"]
[361.013912, "o", "\u001b[?2004h"]
[361.013958, "o", "> "]
[361.014113, "o", "            pa.field(\"section_title\", pa.string()),\r\n\u001b[?2004l\r"]
[361.014139, "o", "\u001b[?2004h"]
[361.014211, "o", "> "]
[361.014351, "o", "            pa.field(\"content\", pa.string()),\r\n\u001b[?2004l\r"]
[361.014402, "o", "\u001b[?2004h> "]
[361.014638, "o", "            pa.field(\"embedding\", pa.list_(pa.float32())),\r\n\u001b[?2004l\r"]
[361.014706, "o", "\u001b[?2004h"]
[361.014776, "o", ">         ]\r\n\u001b[?2004l\r"]
[361.014839, "o", "\u001b[?2004h>     )\r\n\u001b[?2004l\r\u001b[?2004h> "]
[361.01498, "o", "    if name in db.table_names():\r\n\u001b[?2004l\r"]
[361.015031, "o", "\u001b[?2004h> "]
[361.015166, "o", "        table = db.open_table(name)\r\n\u001b[?2004l\r"]
[361.015236, "o", "\u001b[?2004h> "]
[361.015294, "o", "        try:\r\n\u001b[?2004l\r\u001b[?2004h"]
[361.015343, "o", "> "]
[361.015408, "o", "            table.delete(\"TRUE\")\r\n\u001b[?2004l\r"]
[361.015459, "o", "\u001b[?2004h> "]
[361.015517, "o", "        except Exception:\r\n\u001b[?2004l\r"]
[361.015541, "o", "\u001b[?2004h> "]
[361.01561, "o", "            pass\r\n\u001b[?2004l\r\u001b[?2004h"]
[361.015666, "o", "> "]
[361.015722, "o", "        if rows:\r\n\u001b[?2004l\r\u001b[?2004h"]
[361.015779, "o", "> "]
[361.01592, "o", "            table.add(rows)\r\n\u001b[?2004l\r\u001b[?2004h"]
[361.015969, "o", "> "]
[361.016031, "o", "        return table\r\n\u001b[?2004l\r\u001b[?2004h> "]
[361.016324, "o", "    return db.create_table(name, data=rows, schema=schema, mode=\"create\")\r\n\u001b[?2004l\r"]
[361.016352, "o", "\u001b[?2004h> "]
[361.016421, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[361.016477, "o", "> "]
[361.016763, "o", "# ---------------------------------------------------------------------------\r\n\u001b[?2004l\r"]
[361.016843, "o", "\u001b[?2004h> "]
[361.016901, "o", "# Public API\r\n\u001b[?2004l\r\u001b[?2004h"]
[361.016965, "o", "> "]
[361.017209, "o", "# ---------------------------------------------------------------------------\r\n\u001b[?2004l\r"]
[361.017237, "o", "\u001b[?2004h"]
[361.017261, "o", "> "]
[361.017366, "o", "def build_index():\r\n\u001b[?2004l\r"]
[361.01742, "o", "\u001b[?2004h> "]
[361.017632, "o", "    \"\"\"Walk the docs repo and (re)build the LanceDB table.\"\"\"\r\n\u001b[?2004l\r"]
[361.017657, "o", "\u001b[?2004h"]
[361.017732, "o", "> "]
[361.017895, "o", "    files = list(discover_markdown_files(DOCS_ROOT))\r\n\u001b[?2004l\r"]
[361.01792, "o", "\u001b[?2004h"]
[361.017981, "o", "> "]
[361.018043, "o", "    if not files:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[361.018332, "o", "        raise RuntimeError(f\"No .md files found under {DOCS_ROOT}\")\r\n\u001b[?2004l\r"]
[361.018364, "o", "\u001b[?2004h"]
[361.018386, "o", "> \r\n\u001b[?2004l\r"]
[361.018408, "o", "\u001b[?2004h"]
[361.01843, "o", "> "]
[361.061921, "o", "    texts_to_embed = []\r\n\u001b[?2004l\r\u001b[?2004h>     metas = []  # list of (rel_path, doc_title, section_title)\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h>     for path in files:\r\n\u001b[?2004l\r\u001b[?2004h>         rel = path.relative_to(DOCS_ROOT).as_posix()\r\n\u001b[?2004l\r\u001b[?2004h>         doc_title, sections = parse_markdown(path)\r\n\u001b[?2004l\r\u001b[?2004h>         if not sections:\r\n\u001b[?2004l\r\u001b[?2004h>             continue\r\n\u001b[?2004l\r\u001b[?2004h>         for section_title, content in sections:\r\n\u001b[?2004l\r\u001b[?2004h"]
[361.062017, "o", "> "]
[361.062095, "o", "            embed_text = f\"{section_title}\\n{content}\".strip()\r\n\u001b[?2004l\r\u001b[?2004h> "]
[361.06226, "o", "            texts_to_embed.append(embed_text)\r\n\u001b[?2004l\r\u001b[?2004h"]
[361.062334, "o", "> "]
[361.062496, "o", "            metas.append((rel, doc_title, section_title, content))\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[361.062572, "o", "\u001b[?2004h> "]
[361.062816, "o", "    print(f\"Embedding {len(texts_to_embed)} sections from {len(files)} files\")\r\n\u001b[?2004l\r\u001b[?2004h> "]
[361.063014, "o", "    vectors = embed_texts(texts_to_embed, type_=\"document\")\r\n\u001b[?2004l\r\u001b[?2004h> "]
[361.063261, "o", "    print(f\"Got {len(vectors)} vectors of dimension {len(vectors[0])}\")\r\n\u001b[?2004l\r\u001b[?2004h"]
[361.063333, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[361.063393, "o", "    rows = []\r\n\u001b[?2004l\r\u001b[?2004h> "]
[361.063519, "o", "    for meta, vector in zip(metas, vectors):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[361.06371, "o", "        rel, doc_title, section_title, content = meta\r\n\u001b[?2004l\r\u001b[?2004h"]
[361.063768, "o", "> "]
[361.063857, "o", "        rows.append({\r\n\u001b[?2004l\r\u001b[?2004h> "]
[361.063986, "o", "            \"repo_path\": rel,\r\n\u001b[?2004l\r\u001b[?2004h> "]
[361.064087, "o", "            \"doc_title\": doc_title,\r\n\u001b[?2004l\r\u001b[?2004h> "]
[361.064235, "o", "            \"section_title\": section_title,\r\n\u001b[?2004l\r\u001b[?2004h> "]
[361.064364, "o", "            \"content\": content,\r\n\u001b[?2004l\r\u001b[?2004h"]
[361.064414, "o", "> "]
[361.064585, "o", "            \"embedding\": [float(x) for x in vector],\r\n\u001b[?2004l\r\u001b[?2004h> "]
[361.064659, "o", "        })\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[361.06473, "o", "    db = _connect()\r\n\u001b[?2004l\r\u001b[?2004h"]
[361.06482, "o", "> "]
[361.064904, "o", "    table = _open_or_create_table(db, rows)\r\n\u001b[?2004l\r\u001b[?2004h"]
[361.064969, "o", "> "]
[361.065211, "o", "    print(f\"Wrote {len(rows)} rows into LanceDB table \\'{_table_name()}\\' at {LANCEDB_DIR}\")\r\n\u001b[?2004l\r\u001b[?2004h"]
[361.065273, "o", "> "]
[361.065349, "o", "    return len(rows)\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[361.065423, "o", "\u001b[?2004h> "]
[361.065497, "o", "def search(query, k=5):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[361.06569, "o", "    \"\"\"Return the top-k most relevant sections for `query`.\"\"\"\r\n\u001b[?2004l\r\u001b[?2004h"]
[361.065761, "o", "> "]
[361.065853, "o", "    if not query or not query.strip():\r\n\u001b[?2004l\r\u001b[?2004h> "]
[361.065923, "o", "        return []\r\n\u001b[?2004l\r\u001b[?2004h"]
[361.065996, "o", "> "]
[361.066061, "o", "    db = _connect()\r\n\u001b[?2004l\r\u001b[?2004h> "]
[361.066128, "o", "    name = _table_name()\r\n\u001b[?2004l\r\u001b[?2004h> "]
[361.066275, "o", "    if name not in db.table_names():\r\n\u001b[?2004l\r\u001b[?2004h> "]
[361.066557, "o", "        raise RuntimeError(f\"Table {name!r} does not exist; run build_index() first\")\r\n\u001b[?2004l\r\u001b[?2004h> "]
[361.066686, "o", "    table = db.open_table(name)\r\n\u001b[?2004l\r\u001b[?2004h"]
[361.066761, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[361.066913, "o", "    query_vec = embed_texts([query], type_=\"query\")[0]\r\n\u001b[?2004l\r\u001b[?2004h> "]
[361.066989, "o", "    results = (\r\n\u001b[?2004l\r\u001b[?2004h> "]
[361.067176, "o", "        table.search([float(x) for x in query_vec])\r\n\u001b[?2004l\r\u001b[?2004h> "]
[361.067283, "o", "        .metric(\"cosine\")\r\n\u001b[?2004l\r\u001b[?2004h> "]
[361.067368, "o", "        .limit(k)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[361.067457, "o", "        .to_list()\r\n\u001b[?2004l\r\u001b[?2004h> "]
[361.067528, "o", "    )\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[361.067592, "o", ">     out = []\r\n\u001b[?2004l\r\u001b[?2004h"]
[361.067662, "o", "> "]
[361.067744, "o", "    for row in results:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[361.067824, "o", "        out.append({\r\n\u001b[?2004l\r\u001b[?2004h> "]
[361.067986, "o", "            \"repo_path\": row.get(\"repo_path\", \"\"),\r\n\u001b[?2004l\r\u001b[?2004h> "]
[361.068169, "o", "            \"doc_title\": row.get(\"doc_title\", \"\"),\r\n\u001b[?2004l\r\u001b[?2004h"]
[361.068229, "o", "> "]
[361.068376, "o", "            \"section_title\": row.get(\"section_title\", \"\"),\r\n\u001b[?2004l\r\u001b[?2004h"]
[361.068439, "o", "> "]
[361.068623, "o", "            \"score\": float(row.get(\"_distance\", row.get(\"score\", 0.0))),\r\n\u001b[?2004l\r\u001b[?2004h"]
[361.068696, "o", ">         })\r\n\u001b[?2004l\r\u001b[?2004h"]
[361.068763, "o", ">     return out\r\n\u001b[?2004l\r"]
[361.068866, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[361.06895, "o", "if __name__ == \"__main__\":\r\n\u001b[?2004l\r\u001b[?2004h> "]
[361.069036, "o", "    build_index()\r\n\u001b[?2004l\r\u001b[?2004h> "]
[361.069111, "o", "'''\r\n\u001b[?2004l\r\u001b[?2004h> "]
[361.069272, "o", "with open('/home/user/myproject/indexer.py', 'w') as f:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[361.069364, "o", "    f.write(content)\r\n\u001b[?2004l\r\u001b[?2004h"]
[361.069435, "o", "> "]
[361.069549, "o", "print('Wrote indexer.py, length:', len(content))\r\n\u001b[?2004l\r\u001b[?2004h"]
[361.069618, "o", "> PYEOF\r\n\u001b[?2004l\r"]
