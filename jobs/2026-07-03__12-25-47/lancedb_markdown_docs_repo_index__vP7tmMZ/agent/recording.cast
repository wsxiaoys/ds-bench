[361.08069, "o", "\u001b[?2004hroot@690858b3-f28d-417e-8b7a-182ec9650498:~# "]
[365.19049, "i", "head -50 /home/user/myproject/indexer.py\n"]
[365.190814, "o", "head -50 /home/user/myproject/indexer.py\r\n\u001b[?2004l\r"]
[365.192506, "o", "\"\"\"Markdown Docs Repo Indexer with LanceDB.\r\n\r\nWalks /app/docs/, splits each Markdown file into per-section chunks,\r\nembeds them with OpenAI's text-embedding-3-small model, and persists the\r\nresults into a LanceDB table under /home/user/myproject/lancedb/.\r\n\r\nExposes `search(query, k)` for natural-language queries.\r\n\"\"\"\r\nfrom __future__ import annotations\r\n\r\nimport json\r\nimport os\r\nimport re\r\nimport time\r\nimport urllib.request\r\nfrom pathlib import Path\r\nfrom typing import Iterable\r\n\r\nimport lancedb\r\nimport pyarrow as pa\r\n\r\n\r\n# ---------------------------------------------------------------------------\r\n# Configuration\r\n# ---------------------------------------------------------------------------\r\nDOCS_ROOT = Path(\"/app/docs\")\r\nLANCEDB_DIR = Path(\"/home/user/myproject/lancedb\")\r\nRUN_ID_FILE = Path(\"/logs/artifacts/run-id\")\r\nEMBEDDING_MODEL = \"text-embedding-3-small\"\r\n\r\n\r\ndef _table_name() -> str:\r\n"]
[365.192547, "o", "    \"\"\"Return a per-run-id table name so concurrent runs don't collide.\"\"\"\r\n    if RUN_ID_FILE.exists():\r\n        run_id = RUN_ID_FILE.read_text().strip()\r\n    else:\r\n        run_id = os.environ.get(\"RUN_ID\", \"default\")\r\n    return f\"docs_sections_{run_id}\"\r\n\r\n\r\n"]
[365.192569, "o", "# ---------------------------------------------------------------------------\r\n# OpenAI embeddings helper\r\n# ---------------------------------------------------------------------------\r\ndef _embed_batch(texts, type_=\"document\", max_retries=8):\r\n    \"\"\"Call the embeddings endpoint and return a list of vectors.\"\"\"\r\n    api_key = os.environ[\"OPENAI_API_KEY\"]\r\n    base_url = os.environ.get(\"OPENAI_BASE_URL\", \"REDACTED\")\r\n"]
[365.19259, "o", "    url = f\"{base_url.rstrip('/')}/embeddings\"\r\n\r\n    payload = {\"model\": EMBEDDING_MODEL, \"texts\": texts, \"type\": type_}\r\n"]
[365.192928, "o", "\u001b[?2004hroot@690858b3-f28d-417e-8b7a-182ec9650498:~# "]
[365.681946, "i", "python3 -c \"import ast; ast.parse(open('/home/user/myproject/indexer.py').read()); print('Syntax OK')\"\n"]
[365.682444, "o", "python3 -c \"import ast; ast.parse(open('/home/user/myproject/indexer.py').read()); print('Syntax OK')\"\r\n\u001b[?2004l\r"]
