[451.841973, "o", "    last_err = None\r\n\u001b[?2004l\r\u001b[?2004h"]
[451.842015, "o", "> "]
[451.842145, "o", "    for attempt in range(max_retries):\r\n\u001b[?2004l\r"]
[451.842187, "o", "\u001b[?2004h> "]
[451.84231, "o", "        req = urllib.request.Request(\r\n\u001b[?2004l\r\u001b[?2004h"]
[451.842351, "o", "> "]
[451.842428, "o", "            url,\r\n\u001b[?2004l\r\u001b[?2004h> "]
[451.842505, "o", "            data=data,\r\n\u001b[?2004l\r\u001b[?2004h"]
[451.842549, "o", "> "]
[451.842621, "o", "            headers={\r\n\u001b[?2004l\r\u001b[?2004h"]
[451.842688, "o", "> "]
[451.842831, "o", "                \"Content-Type\": \"application/json\",\r\n\u001b[?2004l\r\u001b[?2004h"]
[451.842877, "o", "> "]
[451.843049, "o", "                \"Authorization\": f\"Bearer {api_key}\",\r\n\u001b[?2004l\r\u001b[?2004h"]
[451.84309, "o", "> "]
[451.843183, "o", "            },\r\n\u001b[?2004l\r\u001b[?2004h>         )\r\n\u001b[?2004l\r"]
[451.843224, "o", "\u001b[?2004h> "]
[451.843325, "o", "        try:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[451.843528, "o", "            with urllib.request.urlopen(req, timeout=60) as resp:\r\n\u001b[?2004l\r"]
[451.843572, "o", "\u001b[?2004h> "]
[451.843759, "o", "                body = json.loads(resp.read().decode())\r\n\u001b[?2004l\r\u001b[?2004h"]
[451.843819, "o", "> "]
[451.843935, "o", "            vectors = body.get(\"vectors\")\r\n\u001b[?2004l\r\u001b[?2004h"]
[451.844018, "o", "> "]
[451.844091, "o", "            if vectors is None:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[451.844384, "o", "                err = body.get(\"base_resp\", {}).get(\"status_msg\", \"unknown error\")\r\n\u001b[?2004l\r\u001b[?2004h"]
[451.844431, "o", "> "]
[451.844586, "o", "                if \"rate limit\" in err.lower():\r\n\u001b[?2004l\r\u001b[?2004h"]
[451.844632, "o", "> "]
[451.844831, "o", "                    wait = min(60, 5 * (attempt + 1))\r\n\u001b[?2004l\r"]
[451.844878, "o", "\u001b[?2004h> "]
[451.844989, "o", "                    time.sleep(wait)\r\n\u001b[?2004l\r\u001b[?2004h"]
[451.845031, "o", "> "]
[451.845123, "o", "                    continue\r\n\u001b[?2004l\r\u001b[?2004h"]
[451.845163, "o", "> "]
[451.845465, "o", "                raise RuntimeError(f\"Embeddings API returned no vectors: {body}\")\r\n\u001b[?2004l\r\u001b[?2004h"]
[451.845509, "o", "> "]
[451.845587, "o", "            return vectors\r\n\u001b[?2004l\r\u001b[?2004h"]
[451.845656, "o", "> "]
[451.845764, "o", "        except urllib.error.HTTPError as e:\r\n\u001b[?2004l\r\u001b[?2004h"]
[451.845818, "o", "> "]
[451.845987, "o", "            body = e.read().decode() if e.fp else \"\"\r\n\u001b[?2004l\r\u001b[?2004h"]
[451.846031, "o", "> "]
[451.846198, "o", "            if e.code in (429, 500, 502, 503, 504):\r\n\u001b[?2004l\r"]
[451.846252, "o", "\u001b[?2004h> "]
[451.846426, "o", "                time.sleep(min(60, 5 * (attempt + 1)))\r\n\u001b[?2004l\r\u001b[?2004h"]
[451.846506, "o", "> "]
[451.846572, "o", "                continue\r\n\u001b[?2004l\r\u001b[?2004h> "]
[451.846865, "o", "            raise RuntimeError(f\"Embeddings API HTTP {e.code}: {body}\") from e\r\n\u001b[?2004l\r\u001b[?2004h"]
[451.84691, "o", "> "]
[451.84701, "o", "        except Exception as e:\r\n\u001b[?2004l\r\u001b[?2004h"]
[451.847068, "o", "> "]
[451.847161, "o", "            last_err = e\r\n\u001b[?2004l\r\u001b[?2004h> "]
[451.847332, "o", "            time.sleep(min(30, 2 * (attempt + 1)))\r\n\u001b[?2004l\r\u001b[?2004h"]
[451.847385, "o", "> "]
[451.847467, "o", "            continue\r\n\u001b[?2004l\r\u001b[?2004h> "]
[451.847786, "o", "    raise RuntimeError(f\"Embeddings API failed after {max_retries} retries: {last_err}\")\r\n\u001b[?2004l\r\u001b[?2004h"]
[451.847918, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[451.848035, "o", "def embed_texts(texts, type_=\"document\"):\r\n\u001b[?2004l\r"]
[451.848083, "o", "\u001b[?2004h> "]
[451.848326, "o", "    \"\"\"Embed a list of texts, batching to keep payloads manageable.\"\"\"\r\n\u001b[?2004l\r\u001b[?2004h"]
[451.848381, "o", "> "]
[451.848467, "o", "    all_vectors = []\r\n\u001b[?2004l\r\u001b[?2004h> "]
[451.848536, "o", "    batch_size = 16\r\n\u001b[?2004l\r\u001b[?2004h> "]
[451.848711, "o", "    for i in range(0, len(texts), batch_size):\r\n\u001b[?2004l\r\u001b[?2004h"]
[451.848777, "o", "> "]
[451.848895, "o", "        batch = texts[i:i + batch_size]\r\n\u001b[?2004l\r\u001b[?2004h"]
[451.848949, "o", "> "]
[451.849092, "o", "        vecs = _embed_batch(batch, type_=type_)\r\n\u001b[?2004l\r\u001b[?2004h"]
[451.849135, "o", "> "]
[451.849242, "o", "        if len(vecs) != len(batch):\r\n\u001b[?2004l\r\u001b[?2004h"]
[451.849319, "o", "> "]
[451.849388, "o", "            raise RuntimeError(\r\n\u001b[?2004l\r\u001b[?2004h"]
[451.849452, "o", "> "]
[451.849724, "o", "                f\"Embeddings count mismatch: got {len(vecs)} for {len(batch)} inputs\"\r\n\u001b[?2004l\r\u001b[?2004h"]
[451.849777, "o", ">             )\r\n\u001b[?2004l\r"]
[451.849885, "o", "\u001b[?2004h> "]
[451.849963, "o", "        all_vectors.extend(vecs)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[451.850065, "o", "    return all_vectors\r\n\u001b[?2004l\r"]
[451.85012, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[451.850171, "o", "\u001b[?2004h> "]
[451.850455, "o", "# ---------------------------------------------------------------------------\r\n\u001b[?2004l\r\u001b[?2004h"]
[451.850506, "o", "> "]
[451.850596, "o", "# Markdown parsing\r\n\u001b[?2004l\r\u001b[?2004h> "]
[451.850874, "o", "# ---------------------------------------------------------------------------\r\n\u001b[?2004l\r\u001b[?2004h"]
[451.850915, "o", "> "]
[451.851081, "o", "_HEADER_RE = re.compile(r\"^(#{1,6})\\s+(.*?)\\s*$\")\r\n\u001b[?2004l\r\u001b[?2004h"]
[451.851121, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[451.851202, "o", "\u001b[?2004h> "]
[451.851268, "o", "def parse_markdown(path):\r\n\u001b[?2004l\r\u001b[?2004h"]
[451.851311, "o", "> "]
[451.851527, "o", "    \"\"\"Return (doc_title, [(section_title, content), ...]).\"\"\"\r\n\u001b[?2004l\r\u001b[?2004h"]
[451.851572, "o", "> "]
[451.851729, "o", "    text = path.read_text(encoding=\"utf-8\")\r\n\u001b[?2004l\r\u001b[?2004h"]
[451.851774, "o", "> "]
[451.851871, "o", "    lines = text.splitlines()\r\n\u001b[?2004l\r\u001b[?2004h"]
[451.851914, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[451.851997, "o", "    doc_title = \"\"\r\n\u001b[?2004l\r\u001b[?2004h"]
[451.85204, "o", "> "]
[451.852122, "o", "    sections = []\r\n\u001b[?2004l\r \u001b[?2004h> "]
[451.852204, "o", "    current_title = None\r\n\u001b[?2004l\r\u001b[?2004h"]
[451.852244, "o", "> "]
[451.852318, "o", "    current_body = []\r\n\u001b[?2004l\r\u001b[?2004h"]
[451.852379, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[451.852439, "o", "    def flush():\r\n\u001b[?2004l\r\u001b[?2004h"]
[451.852505, "o", "> "]
[451.852596, "o", "        if current_title is not None:\r\n\u001b[?2004l\r"]
[451.852684, "o", "\u001b[?2004h> "]
[451.852937, "o", "            content = \"\\n\".join(current_body).strip(\"\\n\")\r\n\u001b[?2004l\r\u001b[?2004h"]
[451.852991, "o", "> "]
[451.853164, "o", "            sections.append((current_title, content))\r\n\u001b[?2004l\r\u001b[?2004h"]
[451.853243, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[451.853304, "o", "    for line in lines:\r\n\u001b[?2004l\r"]
[451.85338, "o", "\u001b[?2004h> "]
[451.853457, "o", "        m = _HEADER_RE.match(line)\r\n\u001b[?2004l\r\u001b[?2004h"]
[451.853503, "o", "> "]
[451.853604, "o", "        if m:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[451.853682, "o", "            level = len(m.group(1))\r\n\u001b[?2004l\r\u001b[?2004h"]
[451.853723, "o", "> "]
[451.853839, "o", "            title = m.group(2).strip()\r\n\u001b[?2004l\r\u001b[?2004h"]
[451.853886, "o", "> "]
[451.854002, "o", "            if level == 1 and not doc_title:\r\n\u001b[?2004l\r\u001b[?2004h"]
[451.854047, "o", "> "]
[451.854143, "o", "                doc_title = title\r\n\u001b[?2004l\r\u001b[?2004h"]
[451.854187, "o", "> "]
[451.85429, "o", "                continue\r\n\u001b[?2004l\r\u001b[?2004h> "]
[451.854369, "o", "            if level == 2:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[451.854467, "o", "                flush()\r\n\u001b[?2004l\r\u001b[?2004h> "]
[451.854596, "o", "                current_title = title\r\n\u001b[?2004l\r\u001b[?2004h"]
[451.854653, "o", "> "]
[451.854769, "o", "                current_body = []\r\n\u001b[?2004l\r\u001b[?2004h> "]
[451.854853, "o", "                continue\r\n\u001b[?2004l\r\u001b[?2004h"]
[451.854933, "o", "> "]
[451.855064, "o", "        if current_title is not None:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[451.855164, "o", "            current_body.append(line)\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[451.855214, "o", "\u001b[?2004h> "]
[451.855328, "o", "    flush()\r\n\u001b[?2004l\r\u001b[?2004h> "]
[451.855371, "o", "    return doc_title, sections\r\n\u001b[?2004l\r\u001b[?2004h"]
[451.855454, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[451.855595, "o", "def discover_markdown_files(root):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[451.85592, "o", "    return sorted(p for p in root.rglob(\"*.md\") if p.is_file())\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[451.856006, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[451.856164, "o", "# ---------------------------------------------------------------------------\r\n\u001b[?2004l\r\u001b[?2004h"]
[451.85621, "o", "> "]
[451.856303, "o", "# LanceDB helpers\r\n\u001b[?2004l\r\u001b[?2004h> "]
[451.856527, "o", "# ---------------------------------------------------------------------------\r\n\u001b[?2004l\r"]
[451.856556, "o", "\u001b[?2004h> "]
[451.856627, "o", "def _connect():\r\n\u001b[?2004l\r\u001b[?2004h"]
[451.856656, "o", "> "]
[451.856826, "o", "    LANCEDB_DIR.mkdir(parents=True, exist_ok=True)\r\n\u001b[?2004l\r"]
[451.856858, "o", "\u001b[?2004h> "]
[451.85701, "o", "    return lancedb.connect(str(LANCEDB_DIR))\r\n\u001b[?2004l\r"]
[451.857037, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[451.857119, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[451.85715, "o", "\u001b[?2004h> "]
[451.857255, "o", "def _open_or_create_table(db, rows):\r\n\u001b[?2004l\r"]
[451.857282, "o", "\u001b[?2004h> "]
[451.857378, "o", "    name = _table_name()\r\n\u001b[?2004l\r"]
[451.857404, "o", "\u001b[?2004h> "]
[451.857497, "o", "    schema = pa.schema(\r\n\u001b[?2004l\r"]
[451.857547, "o", "\u001b[?2004h> "]
[451.857596, "o", "        [\r\n\u001b[?2004l\r\u001b[?2004h> "]
[451.857759, "o", "            pa.field(\"repo_path\", pa.string()),\r\n\u001b[?2004l\r"]
[451.85782, "o", "\u001b[?2004h> "]
[451.857951, "o", "            pa.field(\"doc_title\", pa.string()),\r\n\u001b[?2004l\r"]
[451.857981, "o", "\u001b[?2004h> "]
[451.858157, "o", "            pa.field(\"section_title\", pa.string()),\r\n\u001b[?2004l\r"]
[451.858208, "o", "\u001b[?2004h> "]
[451.858343, "o", "            pa.field(\"content\", pa.string()),\r\n\u001b[?2004l\r"]
[451.858394, "o", "\u001b[?2004h> "]
[451.858569, "o", "            pa.field(\"embedding\", pa.list_(pa.float32())),\r\n\u001b[?2004l\r"]
[451.858619, "o", "\u001b[?2004h> "]
[451.858652, "o", "        ]\r\n\u001b[?2004l\r\u001b[?2004h"]
[451.858721, "o", ">     )\r\n\u001b[?2004l\r\u001b[?2004h> "]
[451.858844, "o", "    if name in db.table_names():\r\n\u001b[?2004l\r"]
[451.858871, "o", "\u001b[?2004h> "]
[451.859001, "o", "        table = db.open_table(name)\r\n\u001b[?2004l\r"]
[451.859054, "o", "\u001b[?2004h> "]
[451.859081, "o", "        try:\r\n\u001b[?2004l\r"]
[451.85914, "o", "\u001b[?2004h> "]
[451.859232, "o", "            table.delete(\"TRUE\")\r\n\u001b[?2004l\r"]
[451.85926, "o", "\u001b[?2004h> "]
[451.859355, "o", "        except Exception:\r\n\u001b[?2004l\r"]
[451.859405, "o", "\u001b[?2004h> "]
[451.859452, "o", "            pass\r\n\u001b[?2004l\r\u001b[?2004h"]
[451.859502, "o", "> "]
[451.859531, "o", "        if rows:\r\n\u001b[?2004l\r"]
[451.859592, "o", "\u001b[?2004h> "]
[451.85967, "o", "            table.add(rows)\r\n\u001b[?2004l\r"]
[451.85972, "o", "\u001b[?2004h> "]
[451.859773, "o", "        return table\r\n\u001b[?2004l\r"]
[451.859827, "o", "\u001b[?2004h> "]
[451.860055, "o", "    return db.create_table(name, data=rows, schema=schema, mode=\"create\")\r\n\u001b[?2004l\r"]
[451.860085, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[451.860145, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[451.860401, "o", "# ---------------------------------------------------------------------------\r\n\u001b[?2004l\r"]
[451.860432, "o", "\u001b[?2004h> "]
[451.860533, "o", "# Public API\r\n\u001b[?2004l\r\u001b[?2004h> "]
[451.860771, "o", "# ---------------------------------------------------------------------------\r\n\u001b[?2004l\r"]
[451.86083, "o", "\u001b[?2004h> "]
[451.860858, "o", "def build_index():\r\n\u001b[?2004l\r"]
[451.860914, "o", "\u001b[?2004h> "]
[451.861126, "o", "    \"\"\"Walk the docs repo and (re)build the LanceDB table.\"\"\"\r\n\u001b[?2004l\r"]
[451.86118, "o", "\u001b[?2004h> "]
[451.861314, "o", "    files = list(discover_markdown_files(DOCS_ROOT))\r\n\u001b[?2004l\r"]
[451.861349, "o", "\u001b[?2004h> "]
[451.861398, "o", "    if not files:\r\n\u001b[?2004l\r"]
[451.861432, "o", "\u001b[?2004h> "]
[451.861633, "o", "        raise RuntimeError(f\"No .md files found under {DOCS_ROOT}\")\r\n\u001b[?2004l\r"]
[451.861669, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[451.861703, "o", "> "]
[451.861806, "o", "    texts_to_embed = []\r\n\u001b[?2004l\r"]
[451.861831, "o", "\u001b[?2004h> "]
[451.86191, "o", "    metas = []\r\n\u001b[?2004l\r"]
[451.861941, "o", "\u001b[?2004h> "]
[451.861995, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[451.86207, "o", "    for path in files:\r\n\u001b[?2004l\r"]
[451.862094, "o", "\u001b[?2004h> "]
[451.862281, "o", "        rel = path.relative_to(DOCS_ROOT).as_posix()\r\n\u001b[?2004l\r"]
[451.862305, "o", "\u001b[?2004h> "]
[451.862484, "o", "        doc_title, sections = parse_markdown(path)\r\n\u001b[?2004l\r"]
[451.86251, "o", "\u001b[?2004h> "]
[451.86261, "o", "        if not sections:\r\n\u001b[?2004l\r"]
[451.862634, "o", "\u001b[?2004h> "]
[451.862725, "o", "            continue\r\n\u001b[?2004l\r"]
[451.862749, "o", "\u001b[?2004h> "]
[451.862928, "o", "        for section_title, content in sections:\r\n\u001b[?2004l\r"]
[451.862956, "o", "\u001b[?2004h> "]
[451.863166, "o", "            embed_text = f\"{section_title}\\n{content}\".strip()\r\n\u001b[?2004l\r"]
[451.863191, "o", "\u001b[?2004h> "]
[451.863359, "o", "            texts_to_embed.append(embed_text)\r\n\u001b[?2004l\r"]
[451.863394, "o", "\u001b[?2004h> "]
[451.863611, "o", "            metas.append((rel, doc_title, section_title, content))\r\n\u001b[?2004l\r"]
[451.863637, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[451.863697, "o", "\u001b[?2004h> "]
[451.863944, "o", "    print(f\"Embedding {len(texts_to_embed)} sections from {len(files)} files\")\r\n\u001b[?2004l\r"]
[451.863968, "o", "\u001b[?2004h> "]
[451.86417, "o", "    vectors = embed_texts(texts_to_embed, type_=\"document\")\r\n\u001b[?2004l\r"]
[451.864194, "o", "\u001b[?2004h> "]
[451.864429, "o", "    print(f\"Got {len(vectors)} vectors of dimension {len(vectors[0])}\")\r\n\u001b[?2004l\r"]
[451.864453, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[451.864478, "o", "\u001b[?2004h> "]
[451.864537, "o", "    rows = []\r\n\u001b[?2004l\r"]
[451.864574, "o", "\u001b[?2004h> "]
[451.864725, "o", "    for meta, vector in zip(metas, vectors):\r\n\u001b[?2004l\r"]
[451.864748, "o", "\u001b[?2004h> "]
[451.864938, "o", "        rel, doc_title, section_title, content = meta\r\n\u001b[?2004l\r"]
[451.864964, "o", "\u001b[?2004h> "]
[451.865051, "o", "        rows.append({\r\n\u001b[?2004l\r"]
[451.865075, "o", "\u001b[?2004h> "]
[451.865185, "o", "            \"repo_path\": rel,\r\n\u001b[?2004l\r"]
[451.865253, "o", "\u001b[?2004h> "]
[451.865336, "o", "            \"doc_title\": doc_title,\r\n\u001b[?2004l\r"]
[451.865366, "o", "\u001b[?2004h> "]
[451.865513, "o", "            \"section_title\": section_title,\r\n\u001b[?2004l\r"]
[451.865541, "o", "\u001b[?2004h> "]
[451.865651, "o", "            \"content\": content,\r\n\u001b[?2004l\r"]
[451.865678, "o", "\u001b[?2004h> "]
[451.865861, "o", "            \"embedding\": [float(x) for x in vector],\r\n\u001b[?2004l\r"]
[451.865887, "o", "\u001b[?2004h> "]
[451.865957, "o", "        })\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[451.865982, "o", "\u001b[?2004h> "]
[451.866072, "o", "    db = _connect()\r\n\u001b[?2004l\r"]
[451.866108, "o", "\u001b[?2004h> "]
[451.866249, "o", "    table = _open_or_create_table(db, rows)\r\n\u001b[?2004l\r"]
[451.866274, "o", "\u001b[?2004h> "]
[451.866512, "o", "    print(f\"Wrote {len(rows)} rows into LanceDB table at {LANCEDB_DIR}\")\r\n\u001b[?2004l\r"]
[451.866536, "o", "\u001b[?2004h> "]
[451.866611, "o", "    return len(rows)\r\n\u001b[?2004l\r"]
[451.866635, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[451.866686, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[451.866721, "o", "> "]
[451.866813, "o", "def search(query, k=5):\r\n\u001b[?2004l\r"]
[451.866842, "o", "\u001b[?2004h> "]
[451.867036, "o", "    \"\"\"Return the top-k most relevant sections for query.\"\"\"\r\n\u001b[?2004l\r"]
[451.867061, "o", "\u001b[?2004h> "]
[451.867198, "o", "    if not query or not query.strip():\r\n\u001b[?2004l\r"]
[451.867222, "o", "\u001b[?2004h> "]
[451.867288, "o", "        return []\r\n\u001b[?2004l\r"]
[451.867312, "o", "\u001b[?2004h> "]
[451.867398, "o", "    db = _connect()\r\n\u001b[?2004l\r"]
[451.867422, "o", "\u001b[?2004h> "]
[451.867514, "o", "    name = _table_name()\r\n\u001b[?2004l\r"]
[451.867549, "o", "\u001b[?2004h> "]
[451.86767, "o", "    if name not in db.table_names():\r\n\u001b[?2004l\r"]
[451.867706, "o", "\u001b[?2004h> "]
[451.867984, "o", "        raise RuntimeError(f\"Table {name!r} does not exist; run build_index() first\")\r\n\u001b[?2004l\r"]
[451.86801, "o", "\u001b[?2004h> "]
[451.86813, "o", "    table = db.open_table(name)\r\n\u001b[?2004l\r"]
[451.868156, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[451.868221, "o", "\u001b[?2004h> "]
[451.86838, "o", "    query_vec = embed_texts([query], type_=\"query\")[0]\r\n\u001b[?2004l\r"]
[451.868406, "o", "\u001b[?2004h> "]
[451.868466, "o", "    results = (\r\n\u001b[?2004l\r"]
[451.868492, "o", "\u001b[?2004h> "]
[451.868704, "o", "        table.search([float(x) for x in query_vec])\r\n\u001b[?2004l\r"]
[451.868729, "o", "\u001b[?2004h> "]
[451.86884, "o", "        .metric(\"cosine\")\r\n\u001b[?2004l\r"]
[451.868867, "o", "\u001b[?2004h> "]
[451.868922, "o", "        .limit(k)\r\n\u001b[?2004l\r"]
[451.868958, "o", "\u001b[?2004h> "]
[451.869019, "o", "        .to_list()\r\n\u001b[?2004l\r"]
[451.869053, "o", "\u001b[?2004h> "]
[451.869089, "o", "    )\r\n\u001b[?2004l\r\u001b[?2004h"]
[451.869123, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[451.869177, "o", "    out = []\r\n\u001b[?2004l\r"]
[451.869202, "o", "\u001b[?2004h> "]
[451.869288, "o", "    for row in results:\r\n\u001b[?2004l\r"]
[451.869312, "o", "\u001b[?2004h> "]
[451.86939, "o", "        out.append({\r\n\u001b[?2004l\r"]
[451.869425, "o", "\u001b[?2004h> "]
[451.869573, "o", "            \"repo_path\": row.get(\"repo_path\", \"\"),\r\n\u001b[?2004l\r"]
[451.869597, "o", "\u001b[?2004h> "]
[451.86976, "o", "            \"doc_title\": row.get(\"doc_title\", \"\"),\r\n\u001b[?2004l\r"]
[451.869785, "o", "\u001b[?2004h> "]
[451.870019, "o", "            \"section_title\": row.get(\"section_title\", \"\"),\r\n\u001b[?2004l\r"]
[451.870056, "o", "\u001b[?2004h> "]
[451.870271, "o", "            \"score\": float(row.get(\"_distance\", row.get(\"score\", 0.0))),\r\n\u001b[?2004l\r"]
[451.870307, "o", "\u001b[?2004h> "]
[451.870341, "o", "        })\r\n\u001b[?2004l\r"]
[451.870381, "o", "\u001b[?2004h> "]
[451.87042, "o", "    return out\r\n\u001b[?2004l\r"]
[451.870458, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[451.870492, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[451.870529, "o", "\u001b[?2004h> "]
[451.870602, "o", "if __name__ == \"__main__\":\r\n\u001b[?2004l\r"]
[451.870626, "o", "\u001b[?2004h> "]
[451.870692, "o", "    build_index()\r\n\u001b[?2004l\r"]
[451.870726, "o", "\u001b[?2004h> "]
[451.87076, "o", "'''\r\n\u001b[?2004l\r\u001b[?2004h> "]
[451.870784, "o", "\r\n\u001b[?2004l\r\u001b[?2004h"]
[451.870811, "o", "> "]
[451.870992, "o", "with open('/home/user/myproject/indexer.py', 'w') as f:\r\n\u001b[?2004l\r"]
[451.871017, "o", "\u001b[?2004h> "]
[451.871118, "o", "    f.write(CONTENT)\r\n\u001b[?2004l\r"]
[451.871143, "o", "\u001b[?2004h"]
[451.871168, "o", "> "]
[451.871315, "o", "print(\"Wrote\", len(CONTENT), \"bytes\")\r\n\u001b[?2004l\r"]
[451.871339, "o", "\u001b[?2004h> "]
