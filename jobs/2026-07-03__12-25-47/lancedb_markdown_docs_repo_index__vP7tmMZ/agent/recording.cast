[386.899631, "o", "def embed_texts(texts, type_=\"document\"):\r\n\u001b[?2004l\r"]
[386.899652, "o", "\u001b[?2004h> "]
[386.899936, "o", "    \"\"\"Embed a list of texts, batching to keep payloads manageable.\"\"\"\r\n\u001b[?2004l\r"]
[386.899957, "o", "\u001b[?2004h> "]
[386.900047, "o", "    all_vectors = []\r\n\u001b[?2004l\r"]
[386.900071, "o", "\u001b[?2004h> "]
[386.900157, "o", "    batch_size = 16\r\n\u001b[?2004l\r"]
[386.900179, "o", "\u001b[?2004h> "]
[386.900363, "o", "    for i in range(0, len(texts), batch_size):\r\n\u001b[?2004l\r"]
[386.900399, "o", "\u001b[?2004h> "]
[386.900542, "o", "        batch = texts[i:i + batch_size]\r\n\u001b[?2004l\r"]
[386.900567, "o", "\u001b[?2004h> "]
[386.900752, "o", "        vecs = _embed_batch(batch, type_=type_)\r\n\u001b[?2004l\r"]
[386.900783, "o", "\u001b[?2004h> "]
[386.900925, "o", "        if len(vecs) != len(batch):\r\n\u001b[?2004l\r"]
[386.900962, "o", "\u001b[?2004h> "]
[386.901074, "o", "            raise RuntimeError(\r\n\u001b[?2004l\r"]
[386.901106, "o", "\u001b[?2004h> "]
[386.901419, "o", "                f\"Embeddings count mismatch: got {len(vecs)} for {len(batch)} inputs\"\r\n\u001b[?2004l\r"]
[386.901453, "o", "\u001b[?2004h> "]
[386.901502, "o", "            )\r\n\u001b[?2004l\r"]
[386.901522, "o", "\u001b[?2004h> "]
[386.90166, "o", "        all_vectors.extend(vecs)\r\n\u001b[?2004l\r"]
[386.901696, "o", "\u001b[?2004h> "]
[386.90178, "o", "    return all_vectors\r\n\u001b[?2004l\r"]
[386.901806, "o", "\u001b[?2004h> "]
[386.901853, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> \r\n"]
[386.901884, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[386.902175, "o", "# ---------------------------------------------------------------------------\r\n\u001b[?2004l\r"]
[386.902202, "o", "\u001b[?2004h> "]
[386.902281, "o", "# Markdown parsing\r\n\u001b[?2004l\r"]
[386.902313, "o", "\u001b[?2004h> "]
[386.902601, "o", "# ---------------------------------------------------------------------------\r\n\u001b[?2004l\r"]
[386.902639, "o", "\u001b[?2004h> "]
[386.902827, "o", "_HEADER_RE = re.compile(r\"^(#{1,6})\\s+(.*?)\\s*$\")\r\n\u001b[?2004l\r"]
[386.902861, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[386.902905, "o", "> \r\n\u001b[?2004l\r"]
[386.902927, "o", "\u001b[?2004h> "]
[386.903019, "o", "def parse_markdown(path):\r\n\u001b[?2004l\r"]
[386.903041, "o", "\u001b[?2004h> "]
[386.90328, "o", "    \"\"\"Return (doc_title, [(section_title, content), ...]).\"\"\"\r\n\u001b[?2004l\r"]
[386.903313, "o", "\u001b[?2004h> "]
[386.903468, "o", "    text = path.read_text(encoding=\"utf-8\")\r\n\u001b[?2004l\r"]
[386.90349, "o", "\u001b[?2004h> "]
[386.903609, "o", "    lines = text.splitlines()\r\n\u001b[?2004l\r"]
[386.90363, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[386.903669, "o", "\u001b[?2004h> "]
[386.903737, "o", "    doc_title = \"\"\r\n\u001b[?2004l\r"]
[386.903758, "o", "\u001b[?2004h> "]
[386.903869, "o", "    sections = []\r\n\u001b[?2004l\r\u001b[?2004h> "]
[386.903958, "o", "    current_title = None\r\n\u001b[?2004l\r"]
[386.90398, "o", "\u001b[?2004h> "]
[386.904067, "o", "    current_body = []\r\n\u001b[?2004l\r"]
[386.904089, "o", "\u001b[?2004h"]
[386.904127, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[386.904192, "o", "    def flush():\r\n\u001b[?2004l\r"]
[386.904213, "o", "\u001b[?2004h> "]
[386.904359, "o", "        if current_title is not None:\r\n\u001b[?2004l\r"]
[386.90438, "o", "\u001b[?2004h> "]
[386.904598, "o", "            content = \"\\n\".join(current_body).strip(\"\\n\")\r\n\u001b[?2004l\r"]
[386.904619, "o", "\u001b[?2004h> "]
[386.904846, "o", "            sections.append((current_title, content))\r\n\u001b[?2004l\r"]
[386.904871, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[386.904894, "o", "\u001b[?2004h> "]
[386.904999, "o", "    for line in lines:\r\n\u001b[?2004l\r"]
[386.905021, "o", "\u001b[?2004h> "]
[386.905161, "o", "        m = _HEADER_RE.match(line)\r\n\u001b[?2004l\r"]
[386.905183, "o", "\u001b[?2004h> "]
[386.905245, "o", "        if m:\r\n\u001b[?2004l\r"]
[386.905266, "o", "\u001b[?2004h> "]
[386.905389, "o", "            level = len(m.group(1))\r\n\u001b[?2004l\r"]
[386.90541, "o", "\u001b[?2004h> "]
[386.905542, "o", "            title = m.group(2).strip()\r\n\u001b[?2004l\r"]
[386.905563, "o", "\u001b[?2004h> "]
[386.905711, "o", "            if level == 1 and not doc_title:\r\n\u001b[?2004l\r"]
[386.905732, "o", "\u001b[?2004h> "]
[386.905858, "o", "                doc_title = title\r\n\u001b[?2004l\r"]
[386.905879, "o", "\u001b[?2004h> "]
[386.90597, "o", "                continue\r\n\u001b[?2004l\r"]
[386.906011, "o", "\u001b[?2004h> "]
[386.906087, "o", "            if level == 2:\r\n\u001b[?2004l\r"]
[386.906108, "o", "\u001b[?2004h> "]
[386.906216, "o", "                flush()\r\n\u001b[?2004l\r\u001b[?2004h"]
[386.906275, "o", "> "]
[386.906399, "o", "                current_title = title\r\n\u001b[?2004l\r"]
[386.90644, "o", "\u001b[?2004h> "]
[386.906572, "o", "                current_body = []\r\n\u001b[?2004l\r"]
[386.9066, "o", "\u001b[?2004h> "]
[386.906723, "o", "                continue\r\n\u001b[?2004l\r"]
[386.906755, "o", "\u001b[?2004h> "]
[386.906915, "o", "        if current_title is not None:\r\n\u001b[?2004l\r"]
[386.906946, "o", "\u001b[?2004h> "]
[386.907124, "o", "            current_body.append(line)\r\n\u001b[?2004l\r\u001b[?2004h"]
[386.907176, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[386.907231, "o", "    flush()\r\n\u001b[?2004l\r"]
[386.907261, "o", "\u001b[?2004h> "]
[386.907413, "o", "    return doc_title, sections\r\n\u001b[?2004l\r"]
[386.907449, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[386.907483, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[386.90751, "o", "\u001b[?2004h> "]
[386.907672, "o", "def discover_markdown_files(root):\r\n\u001b[?2004l\r"]
[386.907698, "o", "\u001b[?2004h> "]
[386.907965, "o", "    return sorted(p for p in root.rglob(\"*.md\") if p.is_file())\r\n\u001b[?2004l\r"]
[386.907987, "o", "\u001b[?2004h"]
[386.908028, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h"]
[386.908048, "o", "> \r\n\u001b[?2004l\r"]
[386.908086, "o", "\u001b[?2004h> "]
[386.908402, "o", "# ---------------------------------------------------------------------------\r\n\u001b[?2004l\r"]
[386.908424, "o", "\u001b[?2004h> "]
[386.908517, "o", "# LanceDB helpers\r\n\u001b[?2004l\r"]
[386.908539, "o", "\u001b[?2004h> "]
[386.908876, "o", "# ---------------------------------------------------------------------------\r\n\u001b[?2004l\r"]
[386.908899, "o", "\u001b[?2004h> "]
[386.908975, "o", "def _connect():\r\n\u001b[?2004l\r"]
[386.908997, "o", "\u001b[?2004h"]
[386.909037, "o", "> "]
[386.909224, "o", "    LANCEDB_DIR.mkdir(parents=True, exist_ok=True)\r\n\u001b[?2004l\r"]
[386.909247, "o", "\u001b[?2004h"]
[386.909268, "o", "> "]
[386.90945, "o", "    return lancedb.connect(str(LANCEDB_DIR))\r\n\u001b[?2004l\r"]
[386.909473, "o", "\u001b[?2004h"]
[386.909512, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h"]
[386.909543, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h"]
[386.909565, "o", "> "]
[386.909727, "o", "def _open_or_create_table(db, rows):\r\n\u001b[?2004l\r"]
[386.909757, "o", "\u001b[?2004h> "]
[386.909912, "o", "    name = _table_name()\r\n\u001b[?2004l\r\u001b[?2004h> "]
[386.910013, "o", "    schema = pa.schema(\r\n\u001b[?2004l\r"]
[386.910046, "o", "\u001b[?2004h> "]
[386.910085, "o", "        [\r\n\u001b[?2004l\r"]
[386.910107, "o", "\u001b[?2004h"]
[386.910153, "o", "> "]
[386.910342, "o", "            pa.field(\"repo_path\", pa.string()),\r\n\u001b[?2004l\r"]
[386.91037, "o", "\u001b[?2004h> "]
[386.910581, "o", "            pa.field(\"doc_title\", pa.string()),\r\n\u001b[?2004l\r"]
[386.910603, "o", "\u001b[?2004h"]
[386.910644, "o", "> "]
[386.910844, "o", "            pa.field(\"section_title\", pa.string()),\r\n\u001b[?2004l\r"]
[386.910867, "o", "\u001b[?2004h"]
[386.910908, "o", "> "]
[386.911147, "o", "            pa.field(\"content\", pa.string()),\r\n\u001b[?2004l\r\u001b[?2004h"]
[386.911236, "o", "> "]
[386.91162, "o", "            pa.field(\"embedding\", pa.list_(pa.float32())),\r\n\u001b[?2004l\r\u001b[?2004h"]
[386.911706, "o", ">         ]\r\n\u001b[?2004l\r\u001b[?2004h> "]
[386.911776, "o", "    )\r\n\u001b[?2004l\r\u001b[?2004h> "]
[386.911938, "o", "    if name in db.table_names():\r\n\u001b[?2004l\r\u001b[?2004h"]
[386.912009, "o", "> "]
[386.912115, "o", "        table = db.open_table(name)\r\n\u001b[?2004l\r\u001b[?2004h"]
[386.91218, "o", "> "]
[386.912251, "o", "        try:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[386.912381, "o", "            table.delete(\"TRUE\")\r\n\u001b[?2004l\r\u001b[?2004h"]
[386.912451, "o", "> "]
[386.912516, "o", "        except Exception:\r\n\u001b[?2004l\r"]
[386.912553, "o", "\u001b[?2004h> "]
[386.912607, "o", "            pass\r\n\u001b[?2004l\r"]
[386.912668, "o", "\u001b[?2004h> "]
[386.912722, "o", "        if rows:\r\n\u001b[?2004l\r"]
[386.912746, "o", "\u001b[?2004h> "]
[386.912878, "o", "            table.add(rows)\r\n\u001b[?2004l\r"]
[386.912903, "o", "\u001b[?2004h> "]
[386.913002, "o", "        return table\r\n\u001b[?2004l\r"]
[386.913043, "o", "\u001b[?2004h> "]
[386.913338, "o", "    return db.create_table(name, data=rows, schema=schema, mode=\"create\")\r\n\u001b[?2004l\r"]
[386.913362, "o", "\u001b[?2004h"]
[386.913411, "o", "> \r\n\u001b[?2004l\r"]
[386.913454, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[386.913779, "o", "# ---------------------------------------------------------------------------\r\n\u001b[?2004l\r"]
[386.913822, "o", "\u001b[?2004h"]
[386.913864, "o", "> "]
[386.913889, "o", "# Public API\r\n\u001b[?2004l\r\u001b[?2004h"]
[386.913911, "o", "> "]
[386.914245, "o", "# ---------------------------------------------------------------------------\r\n\u001b[?2004l\r"]
[386.914283, "o", "\u001b[?2004h> "]
[386.914354, "o", "def build_index():\r\n\u001b[?2004l\r"]
[386.914378, "o", "\u001b[?2004h> "]
[386.91465, "o", "    \"\"\"Walk the docs repo and (re)build the LanceDB table.\"\"\"\r\n\u001b[?2004l\r"]
[386.914676, "o", "\u001b[?2004h> "]
[386.914912, "o", "    files = list(discover_markdown_files(DOCS_ROOT))\r\n\u001b[?2004l\r"]
[386.914946, "o", "\u001b[?2004h> "]
[386.915021, "o", "    if not files:\r\n\u001b[?2004l\r"]
[386.915054, "o", "\u001b[?2004h> "]
[386.915343, "o", "        raise RuntimeError(f\"No .md files found under {DOCS_ROOT}\")\r\n\u001b[?2004l\r"]
[386.91538, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[386.915456, "o", "\u001b[?2004h> "]
[386.915514, "o", "    texts_to_embed = []\r\n\u001b[?2004l\r"]
[386.915537, "o", "\u001b[?2004h"]
[386.915562, "o", "> "]
[386.915856, "o", "    metas = []  # list of (rel_path, doc_title, section_title, content)\r\n\u001b[?2004l\r"]
[386.915881, "o", "\u001b[?2004h> "]
[386.915933, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[386.916028, "o", "    for path in files:\r\n\u001b[?2004l\r"]
[386.916066, "o", "\u001b[?2004h> "]
[386.916287, "o", "        rel = path.relative_to(DOCS_ROOT).as_posix()\r\n\u001b[?2004l\r"]
[386.916309, "o", "\u001b[?2004h"]
[386.916356, "o", "> "]
[386.916533, "o", "        doc_title, sections = parse_markdown(path)\r\n\u001b[?2004l\r"]
[386.916573, "o", "\u001b[?2004h> "]
[386.91668, "o", "        if not sections:\r\n\u001b[?2004l\r"]
[386.916702, "o", "\u001b[?2004h"]
[386.916749, "o", "> "]
[386.91683, "o", "            continue\r\n\u001b[?2004l\r"]
[386.916861, "o", "\u001b[?2004h> "]
[386.91705, "o", "        for section_title, content in sections:\r\n\u001b[?2004l\r"]
[386.917072, "o", "\u001b[?2004h> "]
[386.917346, "o", "            embed_text = f\"{section_title}\\n{content}\".strip()\r\n\u001b[?2004l\r"]
[386.917372, "o", "\u001b[?2004h> "]
[386.917575, "o", "            texts_to_embed.append(embed_text)\r\n\u001b[?2004l\r"]
[386.917597, "o", "\u001b[?2004h> "]
[386.917892, "o", "            metas.append((rel, doc_title, section_title, content))\r\n\u001b[?2004l\r"]
[386.917915, "o", "\u001b[?2004h> "]
[386.917975, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[386.918293, "o", "    print(f\"Embedding {len(texts_to_embed)} sections from {len(files)} files\")\r\n\u001b[?2004l\r"]
[386.918314, "o", "\u001b[?2004h> "]
[386.918578, "o", "    vectors = embed_texts(texts_to_embed, type_=\"document\")\r\n\u001b[?2004l\r"]
[386.918599, "o", "\u001b[?2004h"]
[386.918641, "o", "> "]
[386.918951, "o", "    print(f\"Got {len(vectors)} vectors of dimension {len(vectors[0])}\")\r\n\u001b[?2004l\r"]
[386.91898, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[386.919008, "o", "\u001b[?2004h> "]
[386.919075, "o", "    rows = []\r\n\u001b[?2004l\r"]
[386.919099, "o", "\u001b[?2004h"]
[386.919146, "o", "> "]
[386.919301, "o", "    for meta, vector in zip(metas, vectors):\r\n\u001b[?2004l\r"]
[386.919325, "o", "\u001b[?2004h> "]
[386.919567, "o", "        rel, doc_title, section_title, content = meta\r\n\u001b[?2004l\r"]
[386.919592, "o", "\u001b[?2004h> "]
[386.919696, "o", "        rows.append({\r\n\u001b[?2004l\r"]
[386.919747, "o", "\u001b[?2004h> "]
[386.919864, "o", "            \"repo_path\": rel,\r\n\u001b[?2004l\r"]
[386.91989, "o", "\u001b[?2004h> "]
[386.920053, "o", "            \"doc_title\": doc_title,\r\n\u001b[?2004l\r"]
[386.920082, "o", "\u001b[?2004h> "]
[386.920274, "o", "            \"section_title\": section_title,\r\n\u001b[?2004l\r"]
[386.920298, "o", "\u001b[?2004h> "]
[386.920439, "o", "            \"content\": content,\r\n\u001b[?2004l\r"]
[386.920462, "o", "\u001b[?2004h> "]
[386.920698, "o", "            \"embedding\": [float(x) for x in vector],\r\n\u001b[?2004l\r"]
[386.920719, "o", "\u001b[?2004h> "]
[386.920808, "o", "        })\r\n\u001b[?2004l\r\u001b[?2004h"]
[386.920851, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[386.920945, "o", "    db = _connect()\r\n\u001b[?2004l\r"]
[386.920974, "o", "\u001b[?2004h> "]
[386.921165, "o", "    table = _open_or_create_table(db, rows)\r\n\u001b[?2004l\r"]
[386.92123, "o", "\u001b[?2004h> "]
[386.9215, "o", "    print(f\"Wrote {len(rows)} rows into LanceDB table at {LANCEDB_DIR}\")\r\n\u001b[?2004l\r"]
[386.921523, "o", "\u001b[?2004h"]
[386.921546, "o", "> "]
[386.921625, "o", "    return len(rows)\r\n\u001b[?2004l\r"]
[386.921647, "o", "\u001b[?2004h"]
[386.921694, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[386.921715, "o", "\r\n\u001b[?2004l\r"]
[386.921757, "o", "\u001b[?2004h> "]
[386.921862, "o", "def search(query, k=5):\r\n\u001b[?2004l\r"]
[386.921886, "o", "\u001b[?2004h"]
[386.921928, "o", "> "]
[386.922162, "o", "    \"\"\"Return the top-k most relevant sections for `query`.\"\"\"\r\n\u001b[?2004l\r"]
[386.922182, "o", "\u001b[?2004h"]
[386.922205, "o", "> "]
[386.922361, "o", "    if not query or not query.strip():\r\n\u001b[?2004l\r"]
[386.922381, "o", "\u001b[?2004h"]
[386.922427, "o", "> "]
[386.922472, "o", "        return []\r\n\u001b[?2004l\r"]
[386.922494, "o", "\u001b[?2004h"]
[386.922538, "o", "> "]
[386.922592, "o", "    db = _connect()\r\n\u001b[?2004l\r"]
[386.922613, "o", "\u001b[?2004h"]
[386.922655, "o", "> "]
[386.922734, "o", "    name = _table_name()\r\n\u001b[?2004l\r"]
[386.922755, "o", "\u001b[?2004h"]
[386.92283, "o", "> "]
[386.92293, "o", "    if name not in db.table_names():\r\n\u001b[?2004l\r"]
[386.92295, "o", "\u001b[?2004h"]
[386.922968, "o", "> "]
[386.923326, "o", "        raise RuntimeError(f\"Table {name!r} does not exist; run build_index() first\")\r\n\u001b[?2004l\r"]
[386.923348, "o", "\u001b[?2004h> "]
[386.923493, "o", "    table = db.open_table(name)\r\n\u001b[?2004l\r"]
[386.923513, "o", "\u001b[?2004h"]
[386.923535, "o", "> \r\n\u001b[?2004l\r"]
[386.92359, "o", "\u001b[?2004h> "]
