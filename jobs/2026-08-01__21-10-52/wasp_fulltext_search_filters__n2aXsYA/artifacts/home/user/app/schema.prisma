datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["fullTextSearch"]
}

model Product {
  id          Int      @id @default(autoincrement())
  name        String
  description String
  category    String
  brand       String
  price       Float
  rating      Float
  inStock     Boolean
  createdAt   DateTime @default(now())
}
