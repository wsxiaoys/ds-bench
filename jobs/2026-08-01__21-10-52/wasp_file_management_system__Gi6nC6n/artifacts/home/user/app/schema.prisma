datasource db {
  provider = "sqlite"
  // Wasp requires that the url is set to the DATABASE_URL environment variable.
  url      = env("DATABASE_URL")
}

// Wasp requires the `prisma-client-js` generator to be present.
generator client {
  provider = "prisma-client-js"
}

model User {
  id      Int      @id @default(autoincrement())
  folders Folder[]
  files   File[]
}

model Folder {
  id         Int      @id @default(autoincrement())
  name       String
  parentId   Int?
  parent     Folder?  @relation("SubFolders", fields: [parentId], references: [id], onDelete: Cascade)
  subfolders Folder[] @relation("SubFolders")
  userId     Int
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  files      File[]
}

model File {
  id         Int         @id @default(autoincrement())
  name       String
  path       String      // The full path where file is saved, e.g. /home/user/app/uploads/filename
  size       Int
  mimeType   String
  folderId   Int?
  folder     Folder?     @relation(fields: [folderId], references: [id], onDelete: Cascade)
  userId     Int
  user       User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt  DateTime    @default(now())
  shareLinks ShareLink[]
}

model ShareLink {
  id         String      @id @default(uuid())
  fileId     Int
  file       File        @relation(fields: [fileId], references: [id], onDelete: Cascade)
  password   String?     // Optional password
  expiresAt  DateTime?   // Optional expiration time
  createdAt  DateTime    @default(now())
  accessLogs AccessLog[]
}

model AccessLog {
  id          Int       @id @default(autoincrement())
  shareLinkId String
  shareLink   ShareLink @relation(fields: [shareLinkId], references: [id], onDelete: Cascade)
  ipAddress   String
  userAgent   String
  accessedAt  DateTime  @default(now())
  fileName    String    // Store filename for easy reference
}
