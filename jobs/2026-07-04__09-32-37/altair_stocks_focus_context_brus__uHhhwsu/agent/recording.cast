[33.134984, "i", "head -c 2000 /home/user/myproject/chart.html\n"]
[33.135577, "o", "head -c 2000 /home/user/myproject/chart.html\r\n\u001b[?2004l\r"]
[33.136847, "o", "<!DOCTYPE html>\r\n<html>\r\n<head>\r\n  <meta charset=\"UTF-8\">\r\n  <style>\r\n    #vis.vega-embed {\r\n      width: 100%;\r\n      display: flex;\r\n    }\r\n\r\n    #vis.vega-embed details,\r\n    #vis.vega-embed details summary {\r\n      position: relative;\r\n    }\r\n  </style>\r\n  <script type=\"text/javascript\" src=\"https://cdn.jsdelivr.net/npm/vega@6\"></script>\r\n  <script type=\"text/javascript\" src=\"https://cdn.jsdelivr.net/npm/vega-lite@6.4.1\"></script>\r\n  <script type=\"text/javascript\" src=\"https://cdn.jsdelivr.net/npm/vega-embed@7\"></script>\r\n</head>\r\n<body>\r\n  <div id=\"vis\"></div>\r\n  <script>\r\n    (function(vegaEmbed) {\r\n      var spec = {\"config\": {\"view\": {\"continuousWidth\": 300, \"continuousHeight\": 300}}, \"vconcat\": [{\"mark\": {\"type\": \"area\"}, \"encoding\": {\"x\": {\"field\": \"date\", \"scale\": {\"domain\": {\"param\": \"param_c97a99acfc68b794\"}}, \"type\": \"temporal\"}, \"y\": {\"field\": \"price\", \"type\": \"quantitative\"}}, \"height\": 250, \"width\": 600}, {\"mark\": {\"type\": \"area\"}, \"encoding\": {\"x\": {\"field\": \"date\", \"type\": \"temporal\"}, \"y\": {\"field\": \"price\", \"type\": \"quantitative\"}}, \"height\": 70, \"name\": \"view_5f790be443c68175_1\", \"width\": 600}], \"data\": {\"url\": \"https://cdn.jsdelivr.net/npm/vega-datasets@v1.29.0/data/sp500.csv\"}, \"params\": [{\"name\": \"param_c97a99acfc68b794\", \"select\": {\"type\": \"interval\", \"encodings\": [\"x\"]}, \"views\": [\"view_5f790be443c68175_1\"]}], \"$schema\": \"https://vega.github.io/schema/vega-lite/v6.4.1.json\"};\r\n      var embedOpt = {\"mode\": \"vega-lite\"};\r\n\r\n      function showError(el, error){\r\n          el.innerHTML = ('<div style=\"color:red;\">'\r\n                          + '<p>JavaScript Error: ' + error.message + '</p>'\r\n                          + \"<p>This usually means there's a typo in your chart specification. \"\r\n                          + \"See the javascript console for the full traceback.</p>\"\r\n                          + '</div>');\r\n          throw error;\r\n      }\r\n      const el = document.getElementById('vis');\r\n      vegaEmbed(\"#vis\", spec, embedOpt)\r\n        .catch(error => showError(el, error)"]
