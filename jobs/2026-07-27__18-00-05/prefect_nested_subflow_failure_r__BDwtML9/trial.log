kill -TERM -- -$SETSID_PID 2>/dev/null || true
sleep 2
kill -9 -- -$SETSID_PID 2>/dev/null || true
fi
rm -f ~/.pochi/config.jsonc /tmp/pochi_cmd.sh /tmp/setsid_bash_pochi_cmd.pid
