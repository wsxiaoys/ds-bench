app bankapp {
  wasp: {
    version: "^0.16.0"
  },
  title: "bankapp",
  db: {
    seeds: [
      import { devSeed } from "@src/dbSeeds"
    ]
  }
}

route RootRoute { path: "/", to: MainPage }
page MainPage {
  component: import { MainPage } from "@src/MainPage"
}

action transferFunds {
  fn: import { transferFunds } from "@src/actions",
  entities: [Account, LedgerEntry]
}

query getAccounts {
  fn: import { getAccounts } from "@src/queries",
  entities: [Account]
}

query getLedger {
  fn: import { getLedger } from "@src/queries",
  entities: [LedgerEntry]
}
