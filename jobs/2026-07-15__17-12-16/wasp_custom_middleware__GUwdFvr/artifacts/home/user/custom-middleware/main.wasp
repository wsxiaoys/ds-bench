app customMiddleware {
  wasp: {
    version: "^0.21.1"
  },
  title: "custom-middleware",
  head: [
    "<link rel='icon' href='/favicon.ico' />",
  ],
  server: {
    middlewareConfigFn: import { serverMiddlewareFn } from "@src/server/middleware.js"
  }
}

route RootRoute { path: "/", to: MainPage }
page MainPage {
  component: import { MainPage } from "@src/MainPage"
}

apiNamespace apiNamespace {
  middlewareConfigFn: import { apiNamespaceMiddleware } from "@src/server/middleware.js",
  path: "/api"
}

api status {
  httpRoute: (GET, "/api/status"),
  fn: import { getStatus } from "@src/server/apis.js",
  auth: false
}

api echo {
  httpRoute: (POST, "/api/echo"),
  fn: import { echoHandler } from "@src/server/apis.js",
  middlewareConfigFn: import { echoMiddleware } from "@src/server/apis.js",
  auth: false
}
